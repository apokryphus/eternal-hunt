			, anchor1, "ACS_Dual_Wield_Toggle_Notification", Vector(0,0,0), 2);

			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Dual_Wield_Toggle_Notification", 100);

			GetACSStorage().acs_setScaleForOnelinerByTag("ACS_Dual_Wield_Toggle_Notification", 100, 100, 100);

			FactsRemove("ACS_Dual_Wield_Toggle_Enabled");


	private var acsarmorbreath : bool;

	public timer function ACSArmorBreathingTimer ( dt : float, id : int){ ACSArmorBreathing(); } 

	function ACSArmorBreathing()
	{
		if (!theGame.IsFading()
		&& !theGame.IsBlackscreen()
		&& thePlayer.GetVisibility()
		&& !theGame.IsDialogOrCutscenePlaying() 
		&& !thePlayer.IsInNonGameplayCutscene() 
		&& !thePlayer.IsInGameplayScene() 
		&& !theGame.GetPhotomodeEnabled() 
		&& !thePlayer.IsInCutsceneIntro() 
		&& !theGame.IsCurrentlyPlayingNonGameplayScene() 
		)
		{
			if (!acsarmorbreath)
			{
				thePlayer.SoundEvent("monster_caretaker_vo_breath_in", 'head' );

				acsarmorbreath = true;
			}
			else
			{
				thePlayer.SoundEvent("monster_caretaker_vo_breath_out", 'head' );

				acsarmorbreath = false;
			}
		}
	}

	public timer function ACS_Embers_Timer ( dt : float, id : int)
	{
		if (!thePlayer.HasTag('acs_in_wraith') 
		&& !thePlayer.HasTag('ACS_Camo_Active') 
		&& !thePlayer.IsEffectActive( 'invisible' )
		&& !theGame.IsFading()
		&& !theGame.IsBlackscreen()
		&& thePlayer.GetVisibility()
		&& FactsQuerySum("ACS_Azkar_Active") <= 0
		)
		{
			if (thePlayer.HasBuff(EET_BlackBlood) && thePlayer.HasTag('acs_vampire_claws_equipped'))
			{
				thePlayer.DestroyEffect('embers_indicator');
				thePlayer.DestroyEffect('ice_armor_no_smoke');
				thePlayer.DestroyEffect('rift_fx_special');

				if (ACSGetCEntity('acs_helm_1'))
				{
					ACSGetCEntity('acs_helm_1').DestroyEffect('ice_armor_no_smoke');
					ACSGetCEntity('acs_helm_1').DestroyEffect('embers_indicator');
				}

				if (ACSGetCEntity('acs_helm_2'))
				{
					ACSGetCEntity('acs_helm_2').DestroyEffect('ice_armor_no_smoke');
					ACSGetCEntity('acs_helm_2').DestroyEffect('embers_indicator');
				}

				if (ACSGetCEntity('acs_helm_3'))
				{
					ACSGetCEntity('acs_helm_3').DestroyEffect('ice_armor_no_smoke');
					ACSGetCEntity('acs_helm_3').DestroyEffect('embers_indicator');
				}

				if (ACSGetCEntity('acs_helm_4'))
				{
					ACSGetCEntity('acs_helm_4').DestroyEffect('ice_armor_no_smoke');
					ACSGetCEntity('acs_helm_4').DestroyEffect('embers_indicator');
				}
			}
			else
			{
				if (GetWitcherPlayer().IsAnyQuenActive())
				{
					thePlayer.DestroyEffect('embers_indicator');

					thePlayer.PlayEffectSingle('ice_armor_no_smoke');
					thePlayer.StopEffect('ice_armor_no_smoke');

					if (!thePlayer.IsEffectActive('rift_fx_special', false))
					{
						thePlayer.PlayEffectSingle('rift_fx_special');
					}

					if (ACSGetCEntity('acs_helm_1'))
					{
						ACSGetCEntity('acs_helm_1').DestroyEffect('embers_indicator');
						ACSGetCEntity('acs_helm_1').PlayEffectSingle('ice_armor_no_smoke');
						ACSGetCEntity('acs_helm_1').StopEffect('ice_armor_no_smoke');
					}

					if (ACSGetCEntity('acs_helm_2'))
					{
						ACSGetCEntity('acs_helm_2').DestroyEffect('embers_indicator');
						ACSGetCEntity('acs_helm_2').PlayEffectSingle('ice_armor_no_smoke');
						ACSGetCEntity('acs_helm_2').StopEffect('ice_armor_no_smoke');
					}

					if (ACSGetCEntity('acs_helm_3'))
					{
						ACSGetCEntity('acs_helm_3').DestroyEffect('embers_indicator');
						ACSGetCEntity('acs_helm_3').PlayEffectSingle('ice_armor_no_smoke');
						ACSGetCEntity('acs_helm_3').StopEffect('ice_armor_no_smoke');
					}

					if (ACSGetCEntity('acs_helm_4'))
					{
						ACSGetCEntity('acs_helm_4').DestroyEffect('embers_indicator');
						ACSGetCEntity('acs_helm_4').PlayEffectSingle('ice_armor_no_smoke');
						ACSGetCEntity('acs_helm_4').StopEffect('ice_armor_no_smoke');
					}
				}
				else
				{
					thePlayer.DestroyEffect('ice_armor_no_smoke');
					thePlayer.DestroyEffect('rift_fx_special');

					thePlayer.PlayEffectSingle('embers_indicator');
					thePlayer.StopEffect('embers_indicator');

					if (ACSGetCEntity('acs_helm_1'))
					{
						ACSGetCEntity('acs_helm_1').DestroyEffect('ice_armor_no_smoke');
						ACSGetCEntity('acs_helm_1').PlayEffectSingle('embers_indicator');
						ACSGetCEntity('acs_helm_1').StopEffect('embers_indicator');
					}

					if (ACSGetCEntity('acs_helm_2'))
					{
						ACSGetCEntity('acs_helm_2').DestroyEffect('ice_armor_no_smoke');
						ACSGetCEntity('acs_helm_2').PlayEffectSingle('embers_indicator');
						ACSGetCEntity('acs_helm_2').StopEffect('embers_indicator');
					}

					if (ACSGetCEntity('acs_helm_3'))
					{
						ACSGetCEntity('acs_helm_3').DestroyEffect('ice_armor_no_smoke');
						ACSGetCEntity('acs_helm_3').PlayEffectSingle('embers_indicator');
						ACSGetCEntity('acs_helm_3').StopEffect('embers_indicator');
					}

					if (ACSGetCEntity('acs_helm_4'))
					{
						ACSGetCEntity('acs_helm_4').DestroyEffect('ice_armor_no_smoke');
						ACSGetCEntity('acs_helm_4').PlayEffectSingle('embers_indicator');
						ACSGetCEntity('acs_helm_4').StopEffect('embers_indicator');
					}
				}
			}
		}
		else
		{
			thePlayer.DestroyEffect('embers_indicator');
			thePlayer.DestroyEffect('ice_armor_no_smoke');
			thePlayer.DestroyEffect('rift_fx_special');

			if (ACSGetCEntity('acs_helm_1'))
			{
				ACSGetCEntity('acs_helm_1').DestroyEffect('ice_armor_no_smoke');
				ACSGetCEntity('acs_helm_1').DestroyEffect('embers_indicator');
			}

			if (ACSGetCEntity('acs_helm_2'))
			{
				ACSGetCEntity('acs_helm_2').DestroyEffect('ice_armor_no_smoke');
				ACSGetCEntity('acs_helm_2').DestroyEffect('embers_indicator');
			}

			if (ACSGetCEntity('acs_helm_3'))
			{
				ACSGetCEntity('acs_helm_3').DestroyEffect('ice_armor_no_smoke');
				ACSGetCEntity('acs_helm_3').DestroyEffect('embers_indicator');
			}

			if (ACSGetCEntity('acs_helm_4'))
			{
				ACSGetCEntity('acs_helm_4').DestroyEffect('ice_armor_no_smoke');
				ACSGetCEntity('acs_helm_4').DestroyEffect('embers_indicator');
			}
		}
	}

	public timer function ACS_Ice_Armor_Timer ( dt : float, id : int)
	{
		if (!thePlayer.HasTag('acs_in_wraith') 
		&& !thePlayer.HasTag('ACS_Camo_Active') 
		&& !thePlayer.IsEffectActive( 'invisible' )
		&& !theGame.IsFading()
		&& !theGame.IsBlackscreen()
		&& thePlayer.GetVisibility()
		)
		{
			if (thePlayer.HasBuff(EET_BlackBlood) && thePlayer.HasTag('acs_vampire_claws_equipped'))
			{
				thePlayer.DestroyEffect('ice_armor_no_smoke');
				thePlayer.DestroyEffect('rift_fx_special');

				if (ACSGetCEntity('ACS_Imlerith_Skirt'))
				{
					ACSGetCEntity('ACS_Imlerith_Skirt').DestroyEffect('ice_armor_no_smoke');
				}

				if (ACSGetCEntity('ACS_Eredin_Cloak'))
				{
					ACSGetCEntity('ACS_Eredin_Cloak').DestroyEffect('ice_armor_no_smoke');
				}

				if (ACSGetCEntity('ACS_Eredin_Skirt'))
				{
					ACSGetCEntity('ACS_Eredin_Skirt').DestroyEffect('ice_armor_no_smoke');
				}
			}
			else
			{
				if (GetWitcherPlayer().IsAnyQuenActive())
				{
					thePlayer.PlayEffectSingle('ice_armor_no_smoke');
					thePlayer.StopEffect('ice_armor_no_smoke');

					if (!thePlayer.IsEffectActive('rift_fx_special', false))
					{
						thePlayer.PlayEffectSingle('rift_fx_special');
					}

					if (ACSGetCEntity('ACS_Imlerith_Skirt'))
					{
						ACSGetCEntity('ACS_Imlerith_Skirt').PlayEffectSingle('ice_armor_no_smoke');
						ACSGetCEntity('ACS_Imlerith_Skirt').StopEffect('ice_armor_no_smoke');
					}

					if (ACSGetCEntity('ACS_Eredin_Cloak'))
					{
						ACSGetCEntity('ACS_Eredin_Cloak').PlayEffectSingle('ice_armor_no_smoke');
						ACSGetCEntity('ACS_Eredin_Cloak').StopEffect('ice_armor_no_smoke');
					}

					if (ACSGetCEntity('ACS_Eredin_Skirt'))
					{
						ACSGetCEntity('ACS_Eredin_Skirt').PlayEffectSingle('ice_armor_no_smoke');
						ACSGetCEntity('ACS_Eredin_Skirt').StopEffect('ice_armor_no_smoke');
					}
				}
				else
				{
					thePlayer.DestroyEffect('ice_armor_no_smoke');
					thePlayer.DestroyEffect('rift_fx_special');

					if (ACSGetCEntity('ACS_Imlerith_Skirt'))
					{
						ACSGetCEntity('ACS_Imlerith_Skirt').DestroyEffect('ice_armor_no_smoke');
					}

					if (ACSGetCEntity('ACS_Eredin_Cloak'))
					{
						ACSGetCEntity('ACS_Eredin_Cloak').DestroyEffect('ice_armor_no_smoke');
					}

					if (ACSGetCEntity('ACS_Eredin_Skirt'))
					{
						ACSGetCEntity('ACS_Eredin_Skirt').DestroyEffect('ice_armor_no_smoke');
					}
				}
			}
		}
		else
		{
			thePlayer.DestroyEffect('ice_armor_no_smoke');
			thePlayer.DestroyEffect('rift_fx_special');

			if (ACSGetCEntity('ACS_Imlerith_Skirt'))
			{
				ACSGetCEntity('ACS_Imlerith_Skirt').DestroyEffect('ice_armor_no_smoke');
			}

			if (ACSGetCEntity('ACS_Eredin_Cloak'))
			{
				ACSGetCEntity('ACS_Eredin_Cloak').DestroyEffect('ice_armor_no_smoke');
			}

			if (ACSGetCEntity('ACS_Eredin_Skirt'))
			{
				ACSGetCEntity('ACS_Eredin_Skirt').DestroyEffect('ice_armor_no_smoke');
			}
		}
	}

	function IceGiantArmorIndicator()
	{
		if ( theGame.IsDialogOrCutscenePlaying() 
		|| thePlayer.IsPerformingFinisher()
		|| thePlayer.HasTag('ACS_IsPerformingFinisher')
		|| thePlayer.HasTag('ACS_IsPerformingCombatDismember')
		|| theGame.IsFading()
		|| theGame.IsBlackscreen()
		|| theGame.IsPaused() 
		|| theGame.GetPhotomodeEnabled() 
		|| thePlayer.IsInCutsceneIntro() 
		|| theGame.IsCurrentlyPlayingNonGameplayScene() 
		|| thePlayer.HasTag('acs_in_wraith') 
		|| thePlayer.HasTag('ACS_Camo_Active') 
		|| thePlayer.IsEffectActive( 'invisible' )
		|| !thePlayer.GetVisibility()
		|| (thePlayer.HasBuff(EET_BlackBlood) && thePlayer.HasTag('acs_vampire_claws_equipped'))
		)
		{
			thePlayer.DestroyEffect('ice_armor_no_smoke');
			thePlayer.DestroyEffect('rift_fx_special');

			if (ACSGetCEntity('ACS_Imlerith_Skirt'))
			{
				ACSGetCEntity('ACS_Imlerith_Skirt').DestroyEffect('ice_armor_no_smoke');
			}

			if (ACSGetCEntity('ACS_Eredin_Cloak'))
			{
				ACSGetCEntity('ACS_Eredin_Cloak').DestroyEffect('ice_armor_no_smoke');
			}

			if (ACSGetCEntity('ACS_Eredin_Skirt'))
			{
				ACSGetCEntity('ACS_Eredin_Skirt').DestroyEffect('ice_armor_no_smoke');
			}

			return;
		}

		thePlayer.PlayEffectSingle('ice_armor_no_smoke');
		thePlayer.StopEffect('ice_armor_no_smoke');

		if (!thePlayer.IsEffectActive('rift_fx_special', false))
		{
			thePlayer.PlayEffectSingle('rift_fx_special');
		}

		if (ACSGetCEntity('ACS_Imlerith_Skirt'))
		{
			ACSGetCEntity('ACS_Imlerith_Skirt').PlayEffectSingle('ice_armor_no_smoke');
			ACSGetCEntity('ACS_Imlerith_Skirt').StopEffect('ice_armor_no_smoke');
		}

		if (ACSGetCEntity('ACS_Eredin_Cloak'))
		{
			ACSGetCEntity('ACS_Eredin_Cloak').PlayEffectSingle('ice_armor_no_smoke');
			ACSGetCEntity('ACS_Eredin_Cloak').StopEffect('ice_armor_no_smoke');
		}

		if (ACSGetCEntity('ACS_Eredin_Skirt'))
		{
			ACSGetCEntity('ACS_Eredin_Skirt').PlayEffectSingle('ice_armor_no_smoke');
			ACSGetCEntity('ACS_Eredin_Skirt').StopEffect('ice_armor_no_smoke');
		}
	}

	function spawn_quen_light()
	{
		var ent         												: CEntity;
		var bone_rot                        						 	: EulerAngles;
		var bone_vec													: Vector;

		GetWitcherPlayer().GetBoneWorldPositionAndRotationByIndex( GetWitcherPlayer().GetBoneIndex( 'torso3' ), bone_vec, bone_rot );

		if (ACS_Is_DLC_Installed('dlcquen')
		|| ACS_Armor_Set_Check('acs_armor', false)
		|| ACS_Armor_Set_Check('wh_armor', false)
		|| ACS_Armor_Set_Check('eredin_armor', false)
		|| ACS_Armor_Set_Check('imlerith_armor', false)
		|| ACS_Armor_Set_Check('caranthir_armor', false)
		|| ACS_Armor_Set_Check('vgx_eredin_armor', false)
		)
		{
			ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

			"dlc\dlc_acs\data\entities\other\acs_quen_light_blue.w2ent"

			, true ), bone_vec, bone_rot );
		}
		else
		{
			ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

			"dlc\dlc_acs\data\entities\other\acs_quen_light_normal.w2ent"

			, true ), bone_vec, bone_rot );
		}

		ent.CreateAttachmentAtBoneWS( thePlayer, 'torso3', bone_vec, bone_rot );

		ent.AddTag('ACS_Quen_Light_Ent');
	}

	function QuenIndicator()
	{
		if (GetWitcherPlayer().IsAnyQuenActive())
		{
			if (thePlayer.HasTag('acs_vampire_claws_equipped')
			|| ACS_GetItem_Sword_IsEquipped('all_black_held', 'steel')
			)
			{
				if (!thePlayer.IsEffectActive('bat_circle', false))
				{
					thePlayer.PlayEffectSingle('bat_circle');
				}
			}

			if (!ACSGetCEntity('ACS_Quen_Light_Ent'))
			{
				spawn_quen_light();
			}

			if (ACS_Settings_Main_Bool('acs_signs_settings','acs_quen_body_electricity_enabled', true))
			{
				if (ACS_Is_DLC_Installed('dlcquen')
				|| ACS_Armor_Set_Check('acs_armor', false)
				|| ACS_Armor_Set_Check('wh_armor', false)
				|| ACS_Armor_Set_Check('eredin_armor', false)
				|| ACS_Armor_Set_Check('imlerith_armor', false)
				|| ACS_Armor_Set_Check('caranthir_armor', false)
				|| ACS_Armor_Set_Check('vgx_eredin_armor', false)
				)
				{
					if (!thePlayer.IsEffectActive('acs_quen_lightning_blue', false))
					{
						thePlayer.SoundEvent("magic_sorceress_vfx_lightning_bolt");

						thePlayer.PlayEffectSingle('acs_quen_lightning_blue');
					}
				}
				else
				{
					if (!thePlayer.IsEffectActive('acs_quen_lightning_normal', false))
					{
						thePlayer.SoundEvent("magic_sorceress_vfx_lightning_bolt");

						thePlayer.PlayEffectSingle('acs_quen_lightning_normal');
					}
				}
			}
		}
		else
		{
			if (ACSGetCEntity('ACS_Quen_Light_Ent'))
			{
				ACSGetCEntity('ACS_Quen_Light_Ent').Destroy();
			}

			if (thePlayer.IsEffectActive('acs_quen_lightning_blue', false))
			{
				thePlayer.SoundEvent("magic_sorceress_vfx_lightning_fx_loop_stop");

				thePlayer.StopEffect('acs_quen_lightning_blue');
			}

			if (thePlayer.IsEffectActive('acs_quen_lightning_normal', false))
			{
				thePlayer.SoundEvent("magic_sorceress_vfx_lightning_fx_loop_stop");

				thePlayer.StopEffect('acs_quen_lightning_normal');
			}

			if (thePlayer.IsEffectActive('bat_circle', false))
			{
				thePlayer.StopEffect('bat_circle');
			}
		}
	}

	function Sword_Hold_Forcer()
	{
		if (!thePlayer.HasTag('ACS_HideWeaponOnDodge')
		&& !thePlayer.HasTag('acs_in_wraith')
		&& !thePlayer.HasTag('ACS_Bruxa_Bite_Process'))
		{
			ACSSwordUpdateEnhancements('steelsword');
			ACSSwordUpdateEnhancements('silversword');
		}

		playerAnimcomp = thePlayer.GetComponentByClassName('CAnimatedComponent');
		playerMeshcomp = thePlayer.GetComponentByClassName('CMeshComponent');

		if ( !thePlayer.IsAnyWeaponHeld() 
		|| thePlayer.IsWeaponHeld('fist') )
		{
			
			ACS_QuenSwordDestroy(true);
		
			ACS_AxiiSwordDestroy(true);
		
			ACS_AardSwordDestroy(true);

			ACS_YrdenSwordDestroy(true);

			ACS_QuenSecondarySwordDestroy(true);

			ACS_AxiiSecondarySwordDestroy(true);

			ACS_AardSecondarySwordDestroy(true);

			ACS_YrdenSecondarySwordDestroy(true);

			ACS_BowDestroy();

			ACS_CrossbowDestroy();

			ACS_SwordTrailDestroy();
			
			if (ACSGetCEntity('ACS_Armor_Ether_Sword'))
			{
				ACSGetCEntity('ACS_Armor_Ether_Sword').Destroy();
			}

			if (thePlayer.HasTag('ACS_Holster_Sword_Effect'))
			{
				thePlayer.RemoveTag('ACS_Holster_Sword_Effect');
			}
		}
		else
		{
			if (!thePlayer.HasTag('ACS_HideWeaponOnDodge')
			&& !thePlayer.HasTag('acs_in_wraith')
			&& !thePlayer.HasTag('ACS_Bruxa_Bite_Process')
			&& !ACSGetCEntity('ACS_Armor_Ether_Sword')
			)
			{
				ACSSwordUpdateEnhancements('default_sword');
			}

			if (!thePlayer.HasTag('acs_quen_sword_equipped'))
			{
				ACS_QuenSwordDestroy(true);
			}
			
			if (!thePlayer.HasTag('acs_axii_sword_equipped'))
			{
				ACS_AxiiSwordDestroy(true);
			}
			
			if (!thePlayer.HasTag('acs_aard_sword_equipped'))
			{
				ACS_AardSwordDestroy(true);
			}
			
			if (!thePlayer.HasTag('acs_yrden_sword_equipped'))
			{
				ACS_YrdenSwordDestroy(true);
			}
			
			if (!thePlayer.HasTag('acs_quen_secondary_sword_equipped'))
			{
				ACS_QuenSecondarySwordDestroy(true);
			}
			
			if (!thePlayer.HasTag('acs_axii_secondary_sword_equipped'))
			{
				ACS_AxiiSecondarySwordDestroy(true);
			}
			
			if (!thePlayer.HasTag('acs_aard_secondary_sword_equipped'))
			{
				ACS_AardSecondarySwordDestroy(true);
			}
			
			if (!thePlayer.HasTag('acs_yrden_secondary_sword_equipped'))
			{
				ACS_YrdenSecondarySwordDestroy(true);
			}
			
			if (!thePlayer.HasTag('acs_vampire_claws_equipped'))
			{
				//ClawDestroy();
			}

			if (thePlayer.HasTag('ACS_Holster_Sword_Effect'))
			{
				thePlayer.RemoveTag('ACS_Holster_Sword_Effect');
			}
		}
	}

	var vBloodArmorStandalone : cBloodArmorStandalone;

	function Sword_Persistent_Effects()
	{
		/*
		if (ACSGetCEntity('acs_quen_sword_1').HasTag('acs_quen_sword_upgraded_2'))
		{
			if (!ACSGetCEntity('acs_quen_sword_1').IsEffectActive('special_attack_charged_no_overlay', false))
			{
				ACSGetCEntity('acs_quen_sword_1').PlayEffectSingle('special_attack_charged_no_overlay');
			}

			if (!ACSGetCEntity('acs_quen_sword_2').IsEffectActive('special_attack_charged_no_overlay', false))
			{
				ACSGetCEntity('acs_quen_sword_2').PlayEffectSingle('special_attack_charged_no_overlay');
			}

			if (!ACSGetCEntity('acs_quen_sword_3').IsEffectActive('special_attack_charged_no_overlay', false))
			{
				ACSGetCEntity('acs_quen_sword_3').PlayEffectSingle('special_attack_charged_no_overlay');
			}
		}
		else
		{
			ACSGetCEntity('acs_quen_sword_1').StopEffect('special_attack_charged_no_overlay');
			ACSGetCEntity('acs_quen_sword_2').StopEffect('special_attack_charged_no_overlay');
			ACSGetCEntity('acs_quen_sword_3').StopEffect('special_attack_charged_no_overlay');
		}
		*/

		if (thePlayer.GetInventory().ItemHasTag( thePlayer.GetInventory().GetCurrentlyHeldSword(), 'OlgierdSabre' ))
		{
			if (ACS_GetWeaponMode() == 0
			|| ACS_GetWeaponMode() == 1
			|| ACS_GetWeaponMode() == 2
			)
			{
				if ((thePlayer.HasTag('acs_igni_secondary_sword_equipped')
				|| thePlayer.HasTag('acs_igni_secondary_sword_equipped_TAG')
				|| thePlayer.HasTag('acs_igni_sword_equipped')
				|| thePlayer.HasTag('acs_igni_sword_equipped_TAG'))
				&& !ACS_Settings_Main_Bool('acs_player_equipment_visual_settings','acs_iconic_sword_vfx', false))
				{
					if (!ACSGetEquippedSword().IsEffectActive('special_attack_charged_no_overlay', false))
					{
						ACSGetEquippedSword().PlayEffectSingle('special_attack_charged_no_overlay');
					}
				}
				else
				{
					if (ACSGetEquippedSword().IsEffectActive('special_attack_charged_no_overlay', false))
					{
						ACSGetEquippedSword().StopEffect('special_attack_charged_no_overlay');
					}
				}
			}
			else if (ACS_GetWeaponMode() == 3
			)
			{
				if (thePlayer.HasTag('acs_quen_sword_equipped')
				&& !ACS_Settings_Main_Bool('acs_player_equipment_visual_settings','acs_iconic_sword_vfx', false))
				{
					if (!ACSGetEquippedSword().IsEffectActive('special_attack_charged_no_overlay', false))
					{
						ACSGetEquippedSword().PlayEffectSingle('special_attack_charged_no_overlay');
					}
				}
				else
				{
					if (ACSGetEquippedSword().IsEffectActive('special_attack_charged_no_overlay', false))
					{
						ACSGetEquippedSword().StopEffect('special_attack_charged_no_overlay');
					}
				}
			}

			if(thePlayer.GetCurrentHealth() < thePlayer.GetMaxHealth())
			{
				thePlayer.GainStat( BCS_Vitality, (thePlayer.GetMaxHealth() - thePlayer.GetCurrentHealth()) * 0.0005 );

				ShowHealFloatingValue((thePlayer.GetMaxHealth() - thePlayer.GetCurrentHealth()) * 0.0005, true);
			}
		}

		if (ACSGetCEntity('ACS_Sparagmos_Effect'))
		{
			ACSGetCEntity('ACS_Sparagmos_Effect').StopEffect('sword_slash_blue_large');
			ACSGetCEntity('ACS_Sparagmos_Effect').PlayEffectSingle('sword_slash_blue_large');
		}

		if (ACS_Vampire_Claws_Access())
		{
			if (!thePlayer.IsInCombat()
			&& !thePlayer.IsThreatened()
			&& !thePlayer.HasBuff(EET_BlackBlood)
			)
			{
				if(thePlayer.GetCurrentHealth() < thePlayer.GetMaxHealth())
				{
					thePlayer.GainStat( BCS_Vitality, (thePlayer.GetMaxHealth() - thePlayer.GetCurrentHealth()) * 0.0005 );

					ShowHealFloatingValue((thePlayer.GetMaxHealth() - thePlayer.GetCurrentHealth()) * 0.0005, true);
				}
			}
		}

		if (thePlayer.HasTag('acs_vampire_claws_equipped'))
		{
			if (thePlayer.IsUsingHorse()
			|| thePlayer.IsUsingVehicle()
			|| !ACS_Settings_Main_Bool('acs_main_settings','acs_mod_enabled', true)
			//|| !thePlayer.HasTag('ACS_ExplorationDelayTag')
			)
			{
				ClawDestroy();
			}

			theGame.GetBehTreeReactionManager().CreateReactionEventIfPossible( thePlayer, 'CastSignAction', -1, 10.0f, -1.f, -1, true );

			if (ACSGetCEntity('acs_vampire_back_claw'))
			{
				if (!ACS_Settings_Main_Bool('acs_dodge_settings','acs_dodge_effects', false))
				{
					ACSGetCEntity('acs_vampire_back_claw').Destroy();
				}
			}

			if (thePlayer.HasBuff(EET_BlackBlood))
			{
				thePlayer.StopEffect('blood_color');
				thePlayer.PlayEffectSingle('blood_color');

				if (ACSGetCEntity('acs_helm_1'))
				{
					ACSGetCEntity('acs_helm_1').PlayEffectSingle('blood_color');
					ACSGetCEntity('acs_helm_1').StopEffect('blood_color');
				}

				if (ACSGetCEntity('acs_helm_2'))
				{
					ACSGetCEntity('acs_helm_2').PlayEffectSingle('blood_color');
					ACSGetCEntity('acs_helm_2').StopEffect('blood_color');
				}

				if (ACSGetCEntity('acs_helm_3'))
				{
					ACSGetCEntity('acs_helm_3').PlayEffectSingle('blood_color');
					ACSGetCEntity('acs_helm_3').StopEffect('blood_color');
				}

				if (ACSGetCEntity('acs_helm_4'))
				{
					ACSGetCEntity('acs_helm_4').PlayEffectSingle('blood_color');
					ACSGetCEntity('acs_helm_4').StopEffect('blood_color');
				}

				if (ACSGetCEntity('ACS_Eredin_Skirt'))
				{
					ACSGetCEntity('ACS_Eredin_Skirt').PlayEffectSingle('blood_color');
					ACSGetCEntity('ACS_Eredin_Skirt').StopEffect('blood_color');
				}

				if (ACSGetCEntity('ACS_Eredin_Cloak'))
				{
					ACSGetCEntity('ACS_Eredin_Cloak').PlayEffectSingle('blood_color');
					ACSGetCEntity('ACS_Eredin_Cloak').StopEffect('blood_color');
				}

				if (ACSGetCEntity('ACS_VGX_Eredin_Cloak'))
				{
					ACSGetCEntity('ACS_VGX_Eredin_Cloak').PlayEffectSingle('blood_color');
					ACSGetCEntity('ACS_VGX_Eredin_Cloak').StopEffect('blood_color');
				}

				if (ACSGetCEntity('ACS_Imlerith_Skirt'))
				{
					ACSGetCEntity('ACS_Imlerith_Skirt').PlayEffectSingle('blood_color');
					ACSGetCEntity('ACS_Imlerith_Skirt').StopEffect('blood_color');
				}
				
				ACSGetCEntity('acs_vampire_head').PlayEffectSingle('blood_color');

				ACSGetCEntity('acs_vampire_head').StopEffect('blood_color');

				if (!thePlayer.HasTag('ACS_blood_armor'))
				{
					if (GetWitcherPlayer().HasTag('acs_vampire_claws_equipped'))
					{
						if (
						( ACS_GetWeaponMode() == 0 && ACS_Settings_Main_Int('acs_combat_main_settings','acs_fist_mode', 0) == 1 )
						|| ( ACS_GetWeaponMode() == 1 && ACS_Settings_Main_Int('acs_combat_main_settings','acs_fist_mode', 0) == 1 )
						|| ( ACS_GetWeaponMode() == 2 && ACS_Settings_Main_Int('acs_combat_main_settings','acs_fist_mode', 0) == 1 )
						|| ( ACS_GetWeaponMode() == 3 && (ACS_GetItem_VampClaw('shades') || ACS_GetItem_VampClaw('default') ) )
						)
						{
							vBloodArmorStandalone = new cBloodArmorStandalone in this;

							vBloodArmorStandalone.Blood_Armor_Standalone_Engage();	
						}
					}
				}
			}
			else
			{
				ACS_Blood_Armor_Destroy(false);
			}
		}
		else if (thePlayer.HasTag('acs_sorc_fists_equipped'))
		{
			if (thePlayer.IsUsingHorse()
			|| thePlayer.IsUsingVehicle()
			|| !ACS_Settings_Main_Bool('acs_main_settings','acs_mod_enabled', true)
			)
			{
				SorcFistDestroy();
			}
		}
		else if (thePlayer.HasTag('acs_aard_sword_equipped'))
		{
			ACSGetEquippedSword().StopAllEffects();
		}

		if (thePlayer.HasTag('ACS_Ice_Giant_Mode'))
		{
			if (thePlayer.IsAnyWeaponHeld() && !thePlayer.IsWeaponHeld('fist'))
			{
				if (!ACSGetCEntity('ACS_Frost_Sword_Ent'))
				{
					ACSCreateFrostSwordFX();
				}
				else
				{
					if (theGame.GetEngineTimeAsSeconds() - last_sword_fx_time > 0.5)
					{
						last_sword_fx_time = theGame.GetEngineTimeAsSeconds();

						ACSGetCEntity('ACS_Frost_Sword_Ent').StopEffect('frost_sword_1');
						ACSGetCEntity('ACS_Frost_Sword_Ent').PlayEffectSingle('frost_sword_1');

						ACSGetCEntity('ACS_Frost_Sword_Ent').StopEffect('frost_sword_1_1');
						ACSGetCEntity('ACS_Frost_Sword_Ent').PlayEffectSingle('frost_sword_1_1');
					}
				}
			}
			else
			{
				if (ACSGetCEntity('ACS_Frost_Sword_Ent'))
				{
					ACSGetCEntity('ACS_Frost_Sword_Ent').Destroy();
				}
			}
		}
		else
		{
			if (ACSGetCEntity('ACS_Frost_Sword_Ent'))
			{
				ACSGetCEntity('ACS_Frost_Sword_Ent').Destroy();
			}
		}

		if (thePlayer.HasTag('ACS_Flammable_Oil_Enabled')
		&& (thePlayer.HasTag('acs_igni_sword_equipped') 
		|| thePlayer.HasTag('acs_igni_sword_equipped_TAG') 
		|| thePlayer.HasTag('acs_igni_secondary_sword_equipped')
		|| thePlayer.HasTag('acs_igni_secondary_sword_equipped_TAG')
		)
		)
		{
			if (thePlayer.IsAnyWeaponHeld() 
			&& !thePlayer.IsWeaponHeld('fist')
			&& FactsQuerySum("ACS_Azkar_Active") <= 0
			&& FactsQuerySum("ACS_Slayer_Active") <= 0
			)
			{
				if (!ACSGetCEntity('ACS_Fire_Sword_Ent')
				&& !ACSGetCEntity('ACS_Fire_Sword_Ground_Fx_Ent'))
				{
					FlammableOilEvent();
				}

				if (theGame.GetEngineTimeAsSeconds() - last_sword_fx_time > 0.5)
				{
					last_sword_fx_time = theGame.GetEngineTimeAsSeconds();

					if (ACS_GetItem_SwordHeldSwitchBasedUponStat('frost_sword'))
					{
						ACSGetCEntity('ACS_Fire_Sword_Ent').StopEffect('frost_sword_1');
						ACSGetCEntity('ACS_Fire_Sword_Ent').PlayEffectSingle('frost_sword_1');

						ACSGetCEntity('ACS_Fire_Sword_Ent_Dual_Wield').StopEffect('frost_sword_1');
						ACSGetCEntity('ACS_Fire_Sword_Ent_Dual_Wield').PlayEffectSingle('frost_sword_1');
					}
					else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('poison_sword'))
					{
						ACSGetCEntity('ACS_Fire_Sword_Ent').StopEffect('poison_sword_1');
						ACSGetCEntity('ACS_Fire_Sword_Ent').PlayEffectSingle('poison_sword_1');

						ACSGetCEntity('ACS_Fire_Sword_Ent_Dual_Wield').StopEffect('poison_sword_1');
						ACSGetCEntity('ACS_Fire_Sword_Ent_Dual_Wield').PlayEffectSingle('poison_sword_1');
					}
					else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('bleed_sword'))
					{
						ACSGetCEntity('ACS_Fire_Sword_Ent').StopEffect('blood_sword_1');
						ACSGetCEntity('ACS_Fire_Sword_Ent').PlayEffectSingle('blood_sword_1');

						ACSGetCEntity('ACS_Fire_Sword_Ent_Dual_Wield').StopEffect('blood_sword_1');
						ACSGetCEntity('ACS_Fire_Sword_Ent_Dual_Wield').PlayEffectSingle('blood_sword_1');
					}
					else
					{
						ACSGetCEntity('ACS_Fire_Sword_Ent').StopEffect('fire_sword_1');
						ACSGetCEntity('ACS_Fire_Sword_Ent').PlayEffectSingle('fire_sword_1');

						ACSGetCEntity('ACS_Fire_Sword_Ent_Dual_Wield').StopEffect('fire_sword_1');
						ACSGetCEntity('ACS_Fire_Sword_Ent_Dual_Wield').PlayEffectSingle('fire_sword_1');
					}
				}
			}
			else
			{
				if (ACSGetCEntity('ACS_Fire_Sword_Ent'))
				{
					ACSGetCEntity('acs_sword_trail_1').StopEffect('sword_axii_trail');
					ACSGetCEntity('acs_sword_trail_1').StopEffect('sword_igni_trail');

					ACSGetCEntity('acs_sword_trail_2').StopEffect('sword_axii_trail');
					ACSGetCEntity('acs_sword_trail_2').StopEffect('sword_igni_trail');

					ACSGetCEntity('acs_sword_trail_3').StopEffect('sword_axii_trail');
					ACSGetCEntity('acs_sword_trail_3').StopEffect('sword_igni_trail');

					ACSGetCEntity('acs_sword_trail_1').StopEffect('frost_sword_trail');
					ACSGetCEntity('acs_sword_trail_1').StopEffect('fire_sword_trail');

					ACSGetCEntity('acs_sword_trail_2').StopEffect('frost_sword_trail');
					ACSGetCEntity('acs_sword_trail_2').StopEffect('fire_sword_trail');

					ACSGetCEntity('acs_sword_trail_3').StopEffect('frost_sword_trail');
					ACSGetCEntity('acs_sword_trail_3').StopEffect('fire_sword_trail');



					ACSGetCEntity('acs_sword_trail_1_dual_wield').StopEffect('sword_axii_trail');
					ACSGetCEntity('acs_sword_trail_1_dual_wield').StopEffect('sword_igni_trail');

					ACSGetCEntity('acs_sword_trail_2_dual_wield').StopEffect('sword_axii_trail');
					ACSGetCEntity('acs_sword_trail_2_dual_wield').StopEffect('sword_igni_trail');

					ACSGetCEntity('acs_sword_trail_3_dual_wield').StopEffect('sword_axii_trail');
					ACSGetCEntity('acs_sword_trail_3_dual_wield').StopEffect('sword_igni_trail');

					ACSGetCEntity('acs_sword_trail_1_dual_wield').StopEffect('frost_sword_trail');
					ACSGetCEntity('acs_sword_trail_1_dual_wield').StopEffect('fire_sword_trail');

					ACSGetCEntity('acs_sword_trail_2_dual_wield').StopEffect('frost_sword_trail');
					ACSGetCEntity('acs_sword_trail_2_dual_wield').StopEffect('fire_sword_trail');

					ACSGetCEntity('acs_sword_trail_3_dual_wield').StopEffect('frost_sword_trail');
					ACSGetCEntity('acs_sword_trail_3_dual_wield').StopEffect('fire_sword_trail');

					ACSGetCEntity('ACS_Fire_Sword_Ent').Destroy();

					ACSGetCEntity('ACS_Fire_Sword_Ent_Dual_Wield').Destroy();

					ACSGetCEntity('ACS_Fire_Sword_Ground_Fx_Ent').Destroy();
				}
				thePlayer.RemoveTag('ACS_Flammable_Oil_Enabled');
			}
		}
		else
		{
			if (ACSGetCEntity('ACS_Fire_Sword_Ent'))
			{
				ACSGetCEntity('acs_sword_trail_1').StopEffect('sword_axii_trail');
				ACSGetCEntity('acs_sword_trail_1').StopEffect('sword_igni_trail');

				ACSGetCEntity('acs_sword_trail_2').StopEffect('sword_axii_trail');
				ACSGetCEntity('acs_sword_trail_2').StopEffect('sword_igni_trail');

				ACSGetCEntity('acs_sword_trail_3').StopEffect('sword_axii_trail');
				ACSGetCEntity('acs_sword_trail_3').StopEffect('sword_igni_trail');

				ACSGetCEntity('acs_sword_trail_1').StopEffect('frost_sword_trail');
				ACSGetCEntity('acs_sword_trail_1').StopEffect('fire_sword_trail');

				ACSGetCEntity('acs_sword_trail_2').StopEffect('frost_sword_trail');
				ACSGetCEntity('acs_sword_trail_2').StopEffect('fire_sword_trail');

				ACSGetCEntity('acs_sword_trail_3').StopEffect('frost_sword_trail');
				ACSGetCEntity('acs_sword_trail_3').StopEffect('fire_sword_trail');



				ACSGetCEntity('acs_sword_trail_1_dual_wield').StopEffect('sword_axii_trail');
				ACSGetCEntity('acs_sword_trail_1_dual_wield').StopEffect('sword_igni_trail');

				ACSGetCEntity('acs_sword_trail_2_dual_wield').StopEffect('sword_axii_trail');
				ACSGetCEntity('acs_sword_trail_2_dual_wield').StopEffect('sword_igni_trail');

				ACSGetCEntity('acs_sword_trail_3_dual_wield').StopEffect('sword_axii_trail');
				ACSGetCEntity('acs_sword_trail_3_dual_wield').StopEffect('sword_igni_trail');

				ACSGetCEntity('acs_sword_trail_1_dual_wield').StopEffect('frost_sword_trail');
				ACSGetCEntity('acs_sword_trail_1_dual_wield').StopEffect('fire_sword_trail');

				ACSGetCEntity('acs_sword_trail_2_dual_wield').StopEffect('frost_sword_trail');
				ACSGetCEntity('acs_sword_trail_2_dual_wield').StopEffect('fire_sword_trail');

				ACSGetCEntity('acs_sword_trail_3_dual_wield').StopEffect('frost_sword_trail');
				ACSGetCEntity('acs_sword_trail_3_dual_wield').StopEffect('fire_sword_trail');
				
				ACSGetCEntity('ACS_Fire_Sword_Ent').Destroy();

				ACSGetCEntity('ACS_Fire_Sword_Ent_Dual_Wield').Destroy();

				ACSGetCEntity('ACS_Fire_Sword_Ground_Fx_Ent').Destroy();

				thePlayer.RemoveTag('ACS_Flammable_Oil_Enabled');
			}
		}

		/*
		else if (!thePlayer.HasTag('acs_vampire_claws_equipped'))
		{
			ClawDestroy_NOTAG();
		}
		*/
	}

	var last_sword_fx_time : float;

	function ACSOriannaBasePlayAnim(animation_name: name, blendIn, blendout : float)
	{
		var animatedComponentA			: CAnimatedComponent;

		animatedComponentA = (CAnimatedComponent)((CNewNPC)ACSGetCActor('acs_orianna_vampire_base')).GetComponentByClassName( 'CAnimatedComponent' );	

		animatedComponentA.PlaySlotAnimationAsync ( animation_name, 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(blendIn, blendout) );
	}

	timer function OriannaDeathDelay( time : float , id : int )
	{
		GetWitcherPlayer().DisplayHudMessage( GetLocStringById(2118449943) );

		ACS_VampireBatsSpawnEffect(ACSGetCActor('acs_orianna_vampire').GetWorldPosition());

		ACSGetCActor('acs_orianna_vampire').SetVisibility(false);
		
		ACSGetCActor('acs_orianna_vampire').DestroyAfter(7);
	}

	timer function EredinDeathPortalDelay( time : float , id : int )
	{
		var temp											: CEntityTemplate;
		var ent												: CEntity;
		var playerRot, rotationAdjusted 					: EulerAngles;

		temp = (CEntityTemplate)LoadResource( 

		"quests\part_1\quest_files\q203_him\entities\q203_ciri_portal.w2ent"
			
		, true );

		playerRot = thePlayer.GetWorldRotation();

		playerRot.Yaw += 180;

		rotationAdjusted = EulerAngles(0,0,0);

		rotationAdjusted.Yaw = playerRot.Yaw;

		ent = theGame.CreateEntity( temp, ACSGetCActor('ACS_Eredin').GetWorldPosition(), rotationAdjusted );

		ent.PlayEffectSingle('teleport_fx');

		ent.DestroyAfter(4.25);

		ACSGetCActor('ACS_Eredin').AddTag('acs_eredin_not_alive_state_play_loop_anim');

		ACSGetCActor('ACS_Eredin').StopAllEffects();
	}

	timer function EredinDeathEffectDelay( time : float , id : int )
	{
		ACSGetCActor('ACS_Eredin').StopAllEffects();

		ACSGetCActor('ACS_Eredin').PlayEffectSingle('disintegration2');

		ACSGetCActor('ACS_Eredin').PlayEffectSingle('rift_fx_special');

		ACSGetCActor('ACS_Eredin').PlayEffectSingle('disappear');
	}

	timer function CanarisDeathEffectDelay( time : float , id : int )
	{
		ACSGetCActor('ACS_Canaris').StopAllEffects();

		ACSGetCActor('ACS_Canaris').DestroyEffect('teleport_short');
		ACSGetCActor('ACS_Canaris').PlayEffectSingle('teleport_short');
		ACSGetCActor('ACS_Canaris').StopEffect('teleport_short');

		ACSGetCActor('ACS_Canaris').DestroyEffect('ice_armor');
		ACSGetCActor('ACS_Canaris').PlayEffectSingle('ice_armor');
	}


	timer function Unseen_Monster_Summon( time : float , id : int )
	{
		GetACSStorage().acs_Number_Of_Unseen_Blade_Slain_Manage(true);
		
		vACS_Unseen_Blade_Summon = new cACS_Unseen_Blade_Summon in this;

		vACS_Unseen_Blade_Summon.ACS_Unseen_Monster_Summon_Start_Engage();
	}

	var death_scene_start : bool;

	function DeathSceneEnabled( b : bool )
	{
		if (b == true)
		{
			theGame.CreateNoSaveLock( "ACS_Death_Scene_State", ACS_Death_Savelock_ID, false, false );
		}
		else
		{
			theGame.ReleaseNoSaveLock( ACS_Death_Savelock_ID );
		}

		death_scene_start = b;
	}

	function Critical_Low_Health_Fix()
	{
		if (thePlayer.IsEffectActive('critical_low_health', false))
		{
			thePlayer.DestroyEffect('critical_low_health');
		}

		if (death_scene_start
		|| ACS_Settings_Main_Bool('acs_visual_main_settings','acs_disable_critical_low_health', false)
		|| theGame.IsDialogOrCutscenePlaying() 
		|| !thePlayer.IsAlive()
		|| thePlayer.IsInCutsceneIntro()
		|| theGame.HasBlackscreenRequested()
		|| theGame.IsCurrentlyPlayingNonGameplayScene()
		|| theGame.GetGuiManager().IsAnyMenu()
		|| theGame.GetPhotomodeEnabled() 
		|| theGame.IsCurrentlyPlayingNonGameplayScene() 
		|| theGame.GetTutorialSystem().HasActiveTutorial()
		|| theGame.IsFading()
		|| theGame.IsBlackscreen()
		)
		{
			thePlayer.DestroyEffect('acs_half_health');
			thePlayer.DestroyEffect('acs_critical_half_health');
			thePlayer.DestroyEffect('acs_three_quarter_health');
			thePlayer.DestroyEffect('acs_critical_low_health');

			if (FactsQuerySum("ACS_Critical_Low_Health_Activate") > 0)
			{
				RemoveTimer('Critical_Low_Health_Flashing');
				FactsRemove("ACS_Critical_Low_Health_Activate");
			}

			return;
		}

		if (thePlayer.IsEffectActive('acs_half_health', false))
		{
			thePlayer.DestroyEffect('acs_half_health');
		}

		if (thePlayer.IsEffectActive('acs_critical_half_health', false))
		{
			thePlayer.DestroyEffect('acs_critical_half_health');
		}

		if (thePlayer.IsEffectActive('acs_three_quarter_health', false))
		{
			thePlayer.DestroyEffect('acs_three_quarter_health');
		}
		
		if( thePlayer.GetStat( BCS_Vitality ) <= thePlayer.GetStatMax( BCS_Vitality ) * 0.25 )
		{

			if ( FactsQuerySum("ACS_Critical_Low_Health_Activate") <= 0 )
			{
				thePlayer.DestroyEffect('acs_critical_low_health');
				thePlayer.PlayEffectSingle('acs_critical_low_health');
				thePlayer.StopEffect('acs_critical_low_health');

				FactsAdd("ACS_Critical_Low_Health_Activate", 1, -1);
			}
		}
		else
		{
			if (thePlayer.IsEffectActive('acs_critical_low_health', false))
			{
				thePlayer.DestroyEffect('acs_critical_low_health');
			}

			if (FactsQuerySum("ACS_Critical_Low_Health_Activate") > 0)
			{
				RemoveTimer('Critical_Low_Health_Flashing');
				FactsRemove("ACS_Critical_Low_Health_Activate");
			}
		}
		/*
		else
		{
			if( thePlayer.GetStat( BCS_Vitality ) == thePlayer.GetStatMax( BCS_Vitality ) )
			{
				thePlayer.StopEffect('acs_critical_low_health');
				thePlayer.StopEffect('acs_half_health');
				thePlayer.StopEffect('acs_critical_half_health');
				thePlayer.StopEffect('acs_three_quarter_health');
			}
			else if( thePlayer.GetStat( BCS_Vitality ) < thePlayer.GetStatMax( BCS_Vitality ) 
			&& thePlayer.GetStat( BCS_Vitality ) >= thePlayer.GetStatMax( BCS_Vitality ) * 0.75 
			)
			{
				thePlayer.StopEffect('acs_critical_low_health');
				thePlayer.StopEffect('acs_critical_half_health');
				thePlayer.StopEffect('acs_half_health');

				thePlayer.PlayEffectSingle('acs_three_quarter_health');
			}
			else if( thePlayer.GetStat( BCS_Vitality ) < thePlayer.GetStatMax( BCS_Vitality ) * 0.75 
			&& thePlayer.GetStat( BCS_Vitality ) >= thePlayer.GetStatMax( BCS_Vitality ) * 0.5 
			)
			{
				thePlayer.StopEffect('acs_critical_low_health');
				thePlayer.StopEffect('acs_critical_half_health');
				thePlayer.StopEffect('acs_three_quarter_health');

				thePlayer.PlayEffectSingle('acs_half_health');
			}
			else if( thePlayer.GetStat( BCS_Vitality ) < thePlayer.GetStatMax( BCS_Vitality ) * 0.5 
			&& thePlayer.GetStat( BCS_Vitality ) >= thePlayer.GetStatMax( BCS_Vitality ) * 0.25 )
			{
				thePlayer.StopEffect('acs_critical_low_health');
				thePlayer.StopEffect('acs_three_quarter_health');
				thePlayer.StopEffect('acs_half_health');

				thePlayer.PlayEffectSingle('acs_critical_half_health');
			}
			else if( thePlayer.GetStat( BCS_Vitality ) < thePlayer.GetStatMax( BCS_Vitality ) * 0.25 )
			{
				thePlayer.StopEffect('acs_half_health');
				thePlayer.StopEffect('acs_three_quarter_health');
				thePlayer.StopEffect('acs_critical_half_health');

				thePlayer.PlayEffectSingle('acs_critical_low_health');
			}
		}
		*/
	}

	function HudSettingsCheck(module : name) : bool 
	{
		var conf: CInGameConfigWrapper;
		var configValue :int;
		var configValueString : string;

		conf = (CInGameConfigWrapper)theGame.GetInGameConfigWrapper();
		
		switch(module)
		{
			case 'VisibilityAll':
			configValueString = conf.GetVarValue('Hud', 'HudVisibility');
			break;

			case 'BuffsModule':
			configValueString = conf.GetVarValue('Hud', 'BuffsModule');
			break;

			case 'WolfHeadModule':
			configValueString = conf.GetVarValue('Hud', 'WolfHeadModule');
			break;

			case 'ItemInfoModule':
			configValueString = conf.GetVarValue('Hud', 'ItemInfoModule');
			break;

			case 'Minimap2Module':
			configValueString = conf.GetVarValue('Hud', 'Minimap2Module');
			break;

			case 'QuestsModule':
			configValueString = conf.GetVarValue('Hud', 'QuestsModule');
			break;

			case 'ControlsFeedbackModule':
			configValueString = conf.GetVarValue('Hud', 'ControlsFeedbackModule');
			break;

			case 'EnemyFocusModule':
			configValueString = conf.GetVarValue('Hud', 'EnemyFocusModule');
			break;

			default:
			configValueString = conf.GetVarValue('Hud', 'WolfHeadModule');
			break;
		}

		configValue =(int) configValueString;

		if(configValueString=="" || configValue<0)
		{
			return true;
		}

		else return (bool)configValueString;
	}


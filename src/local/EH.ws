	}

	timer function Focus_Changed_Reset( time : float , id : int )
	{
		thePlayer.RemoveTag('ACS_Focus_Changed');
	}
	*/

	timer function Menu_Changed_Reset( time : float , id : int )
	{
		menuChanged = false;
	}

	var acs_clock_init_x, acs_clock_init_y : float;

	function HudModuleHideStartup()
	{
		var hud 																: CR4ScriptedHud;
		var hudWolfHeadModule 													: CR4HudModuleWolfHead;	
		var hudItemModule 														: CR4HudModuleItemInfo;	
		var minimapModule 														: CR4HudModuleMinimap2;	

		hud = (CR4ScriptedHud)theGame.GetHud();

		hudWolfHeadModule = (CR4HudModuleWolfHead)hud.GetHudModule( "WolfHeadModule" );

		hudItemModule = (CR4HudModuleItemInfo)hud.GetHudModule("ItemInfoModule");

		minimapModule = (CR4HudModuleMinimap2)hud.GetHudModule("Minimap2Module");

		acs_clock_init_x = minimapModule.GetModuleFlash().GetChildFlashSprite("mcWorldCondition").GetX();

		acs_clock_init_y = minimapModule.GetModuleFlash().GetChildFlashSprite("mcWorldCondition").GetY();

		if (FactsQuerySum("ACS_Minimap_Module_Hide") > 0)
		{
			FactsRemove("ACS_Minimap_Module_Hide");
		}

		if (FactsQuerySum("ACS_Quest_Module_Hide") > 0)
		{
			FactsRemove("ACS_Quest_Module_Hide");
		}

		if (FactsQuerySum("ACS_Control_Hint_Module_Hide") > 0)
		{
			FactsRemove("ACS_Control_Hint_Module_Hide");
		}

		if (FactsQuerySum("ACS_Buffs_Module_Hide") > 0)
		{
			FactsRemove("ACS_Buffs_Module_Hide");
		}

		if (FactsQuerySum("ACS_WolfHeadHud_Module_Hide") > 0)
		{
			FactsRemove("ACS_WolfHeadHud_Module_Hide");
		}

		if (FactsQuerySum("ACS_ItemHud_Module_Hide") > 0)
		{
			FactsRemove("ACS_ItemHud_Module_Hide");
		}

		if ( !HudSettingsCheck('Minimap2Module') && FactsQuerySum("ACS_Minimap_Module_Hide") <= 0 )
		{
			RemoveTimer('MinimapModuleDespawnDelay');
			AddTimer('MinimapModuleDespawnDelay', ACS_Settings_Main_Float('acs_hud_settings_main','acs_hud_elements_despawn_delay', 7) , false);

			FactsAdd("ACS_Minimap_Module_Hide", 1, -1);
		}

		if ( !HudSettingsCheck('QuestsModule') && FactsQuerySum("ACS_Quest_Module_Hide") <= 0 )
		{
			RemoveTimer('QuestModuleDespawnDelay');
			AddTimer('QuestModuleDespawnDelay', ACS_Settings_Main_Float('acs_hud_settings_main','acs_hud_elements_despawn_delay', 7) , false);

			FactsAdd("ACS_Quest_Module_Hide", 1, -1);
		}

		if ( HudSettingsCheck('ControlsFeedbackModule') && FactsQuerySum("ACS_Control_Hint_Module_Hide") <= 0 )
		{
			RemoveTimer('ControlHintModuleDespawnDelay');
			AddTimer('ControlHintModuleDespawnDelay', ACS_Settings_Main_Float('acs_hud_settings_main','acs_hud_elements_despawn_delay', 7) , false);

			FactsAdd("ACS_Control_Hint_Module_Hide", 1, -1);
		}

		if ( HudSettingsCheck('BuffsModule') && FactsQuerySum("ACS_Buffs_Module_Hide") <= 0 )
		{
			RemoveTimer('BuffsModuleDespawnDelay');
			AddTimer('BuffsModuleDespawnDelay', ACS_Settings_Main_Float('acs_hud_settings_main','acs_hud_elements_despawn_delay', 7) , false);

			FactsAdd("ACS_Buffs_Module_Hide", 1, -1);
		}

		if (HudSettingsCheck('WolfHeadModule') && hudWolfHeadModule.GetEnabled())
		{
			hudWolfHeadModule.SetEnabled(false);

			if (FactsQuerySum("ACS_WolfHeadHud_Module_Shown") > 0)
			{
				FactsRemove("ACS_WolfHeadHud_Module_Shown");
			}
		}

		if (HudSettingsCheck('ItemInfoModule') && hudItemModule.GetEnabled())
		{
			hudItemModule.SetEnabled(false);

			if (FactsQuerySum("ACS_ItemHud_Module_Shown") > 0)
			{
				FactsRemove("ACS_ItemHud_Module_Shown");
			}
		}

		hud.UpdateHUD();
	}

	////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	function HUDModuleUpdatePosition( hudModule : name )
	{
		var tempX, tempY, scale												: float;
		var hud 															: CR4ScriptedHud;
		var l_flashModule													: CScriptedFlashSprite;
		var baseHud 														: CR4HudModuleBase;
		var l_hudModuleAnchors												: CR4HudModuleAnchors;
		var l_mcAnchor														: CScriptedFlashSprite;
		var anchorX															: float;
		var anchorY															: float;
		var minimapModule 													: CR4HudModuleMinimap2;
		var objectiveModule													: CR4HudModuleQuests;
		var buffsModule 													: CR4HudModuleBuffs;
		var wolfsHeadModule 												: CR4HudModuleWolfHead;
		var itemInfoModule 													: CR4HudModuleItemInfo;
		var damagedItemsModule 												: CR4HudModuleDamagedItems;
		var controlsFeedbackModule 											: CR4HudModuleControlsFeedback;
		var consoleModule 													: CR4HudModuleConsole;
		var horseStaminaModule												: CR4HudModuleHorseStaminaBar;
		var horsePanicModule												: CR4HudModuleHorsePanicBar;
		var oxygenBarModule													: CR4HudModuleOxygenBar;
		var boatHealthModule												: CR4HudModuleBoatHealth;
		var bossBarModule													: CR4HudModuleBossFocus;
		var companionBarModule												: CR4HudModuleCompanion;
		var enemyHudModule													: CR4HudModuleEnemyFocus;
		var messageModule 													: CR4HudModuleMessage;
		var crosshairModule 												: CR4HudModuleCrosshair;
		var journalModule 													: CR4HudModuleJournalUpdate;
		var lootPopupModule													: CR4HudModuleLootPopup;
		var timelapseModule													: CR4HudModuleTimeLapse;
		var radialMenuModule												: CR4HudModuleRadialMenu;
		var areaInfoModule													: CR4HudModuleAreaInfo;

		var Cx, Cy, N														: float;

		hud = (CR4ScriptedHud)theGame.GetHud();

		l_hudModuleAnchors	= (CR4HudModuleAnchors) hud.GetHudModule( "AnchorsModule" );

		scale = theGame.GetUIScale() + theGame.GetUIGamepadScaleGain();

		N = 0.0025;

		switch(hudModule)
		{	
			case 'enemy':
			{
				baseHud = (CR4HudModuleBase)hud.GetHudModule("EnemyFocusModule");

				enemyHudModule = (CR4HudModuleEnemyFocus)hud.GetHudModule("EnemyFocusModule");

				l_flashModule = enemyHudModule.GetModuleFlash();

				if (ACS_Settings_Main_Bool('acs_hud_settings_positioning_all','acs_hud_positioning_enabled', false))
				{
					anchorX = ACS_Settings_Main_Float('acs_hud_settings_positioning_enemy','ACS_EnemyHorizontal', 0);
					anchorY = ACS_Settings_Main_Float('acs_hud_settings_positioning_enemy','ACS_EnemyVertical', 380);

					Cx = 0;   
					Cy = 0.045;   
				}
				else
				{
					l_mcAnchor 	= l_hudModuleAnchors.GetAnchorSprite( "ScaleOnly" );
				}
			}
			break;

			case 'areainfo':
			{
				baseHud = (CR4HudModuleBase)hud.GetHudModule("AreaInfoModule");

				areaInfoModule = (CR4HudModuleAreaInfo)hud.GetHudModule("AreaInfoModule");

				l_flashModule = areaInfoModule.GetModuleFlash();

				l_flashModule.SetXScale( 50 );
				l_flashModule.SetYScale( 50 );
				l_flashModule.SetZScale( 50 );

				if (ACS_Settings_Main_Bool('acs_hud_settings_positioning_all','acs_hud_positioning_enabled', false))
				{
					//l_flashModule.SetXScale( 50 );
					//l_flashModule.SetYScale( 50 );
					//l_flashModule.SetZScale( 50 );

					/*
					l_flashModule.SetPosition( 
					ACS_HUD_Adjustment('acs_hud_settings_positioning_wolf_medallion', 'ACS_WolfMedallionHorizontal', 'ACS_WolfMedallionVertical', 'X', -0.1, 0.05)
					, 
					ACS_HUD_Adjustment('acs_hud_settings_positioning_wolf_medallion', 'ACS_WolfMedallionHorizontal', 'ACS_WolfMedallionVertical', 'Y', -0.1, 0.05)
					);
					*/

					return;
				}
				else
				{
					l_mcAnchor 	= l_hudModuleAnchors.GetAnchorSprite( "mcAnchorAreaInfo" );
				}
			}	
			break;

			case 'radialMenu':
			{
				baseHud = (CR4HudModuleBase)hud.GetHudModule("RadialMenuModule");

				radialMenuModule = (CR4HudModuleRadialMenu)hud.GetHudModule("RadialMenuModule");

				l_flashModule = radialMenuModule.GetModuleFlash();

				l_flashModule.SetXScale( 50 );
				l_flashModule.SetYScale( 50 );
				l_flashModule.SetZScale( 50 );


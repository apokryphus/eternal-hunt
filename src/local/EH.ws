				ACSGetCActor('ACS_Transformation_Giant').PlayEffect('lightning_effect_normal');
			}

			if (ACSGetCActor('ACS_Transformation_Giant').HasTag('ACS_Transformation_Giant_Weapon_Mode'))
			{
				GetTransformationGiantClass().TransformationGiantLightningStrike_Engage();

				GetTransformationGiantClass().TransformationGiantBehSwitchReturn_Engage();
			}

			if (ACSGetCActor('ACS_Transformation_Giant').IsEffectActive('lightning_effect'))
			{

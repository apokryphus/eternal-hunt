	function AzkarBowCreateFake()
	{
		var sword1 : CEntity;
		var attach_rot : EulerAngles;
		var attach_vec : Vector;

		sword1 = (CEntity)theGame.CreateEntity((CEntityTemplate)LoadResource( 

		"dlc\dlc_acs\data\entities\ranged\bow_azkar.w2ent" 
			
		, true), GetWitcherPlayer().GetWorldPosition() );
			
		attach_rot.Roll = 0;
		attach_rot.Pitch = 0;
		attach_rot.Yaw = 0;
		attach_vec.X = 0;
		attach_vec.Y = -0.025;
		attach_vec.Z = -0.045;

		sword1.CreateAttachment( GetWitcherPlayer(), 'l_weapon', attach_vec, attach_rot );
		sword1.AddTag('acs_bow');
		sword1.PlayEffect('ghost_06');
	}

	function BowShowCrosshair( value : bool )
	{
		var hud : CR4ScriptedHud;
		var module : CR4HudModuleCrosshair;
		var moduleItemInfo : CR4HudModuleItemInfo;

		return;

		hud = (CR4ScriptedHud)theGame.GetHud();
		module = (CR4HudModuleCrosshair)hud.GetHudModule("CrosshairModule");
		moduleItemInfo = (CR4HudModuleItemInfo)hud.GetHudModule("ItemInfoModule");
		module.ShowElement( value, false );
		moduleItemInfo.ShowElementIgnoreState(value,false);
	}	

	timer function BowRotateTowardsCamera( deltaTime : float , id : int)
	{
		var movementAdjustor 														: CMovementAdjustor;
		var ticket	 																: SMovementAdjustmentRequestTicket;	
		
		movementAdjustor = thePlayer.GetMovingAgentComponent().GetMovementAdjustor();
		ticket = movementAdjustor.CreateNewRequest( 'ACS_Bow_Rotation');
		movementAdjustor.MaxRotationAdjustmentSpeed( ticket, 750 );
		movementAdjustor.MaxLocationAdjustmentSpeed( ticket, 750 );
		movementAdjustor.RotateTo( ticket, VecHeading( theCamera.GetCameraDirection() + theCamera.GetCameraRight() * 0.5 ) );

		CreateAimOneliner();
	}

	var bowAimedTarget : CActor;

	function CreateAimOneliner()
	{
		maxAdrenaline = thePlayer.GetStatMax(BCS_Focus);
		
		curAdrenaline = thePlayer.GetStat(BCS_Focus);
		
		if (!thePlayer.GetDisplayTarget()
		|| !((CActor)thePlayer.GetDisplayTarget()).IsAlive()
		|| ((CActor)thePlayer.GetDisplayTarget()).GetAttitude( thePlayer ) != AIA_Hostile
		|| ((CActor)thePlayer.GetDisplayTarget()).GetCurrentHealth() > ((CActor)thePlayer.GetDisplayTarget()).GetMaxHealth() * 0.25
		//|| !thePlayer.playerAiming.GetAimedTarget()
		|| FactsQuerySum("ACS_Azkar_Active") <= 0
		|| FactsQuerySum("ACS_Azkar_Aiming") <= 0
		|| curAdrenaline < maxAdrenaline/3
		)
		{
			GetACSStorage().acs_deleteOnelinerByTag("ACS_Bow_Aiming_Target");
			return;
		}

		//GetACSStorage().acs_deleteOnelinerByTag("ACS_Bow_Aiming_Target");

		ACS_Oneliner(
		(new ACS_Oneliner_TagBuilder in theGame)
		.tag("font")
		.attr("size", "26")
		.attr("color", "#f00000")
		.text(GetLocStringById(2118449918))
		, thePlayer.GetDisplayTarget(), "ACS_Bow_Aiming_Target", Vector(0,0,1.125) , 0.125);

		GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Bow_Aiming_Target", 100);

		GetACSStorage().acs_setScaleForOnelinerByTag("ACS_Bow_Aiming_Target", 100, 100, 100);
	}

	function AzkarArrowDetonate()
	{
		var arrows 											: array<CEntity>;
		var i												: int;

		maxAdrenaline = thePlayer.GetStatMax(BCS_Focus);
		
		curAdrenaline = thePlayer.GetStat(BCS_Focus);

		if (curAdrenaline >= maxAdrenaline/3)
		{
			arrows.Clear();

			theGame.GetEntitiesByTag( 'ACS_Azkar_Arrow', arrows );	

			if (arrows.Size()<=0)
			{
				return;
			}

			AzkarSpecialFXCreate();
			
			for( i = 0; i < arrows.Size(); i += 1 )
			{
				arrows[i].AddTag('ACS_Azkar_Arrow_Detonate');
			}

			if( curAdrenaline >= maxAdrenaline/3
			&& curAdrenaline < maxAdrenaline * 2/3 ) 
			{	
				thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) );
			}
			else if( curAdrenaline >= maxAdrenaline * 2/3
			&& curAdrenaline < maxAdrenaline) 
			{	
				thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) * 1/3 );
			}
			else if( curAdrenaline == maxAdrenaline) 
			{	
				thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) * 1/3 );
			}
		}
	}

	timer function ACS_Azkar_Shadow_Strike_Teleport_Start ( dt : float, id : int)
	{
		thePlayer.SetVisibility(false);

		if (!crossbow_hidden)
		{
			CrossbowHide(true);
			thePlayer.rangedWeapon.ClearDeployedEntity(true);

			crossbow_hidden = true;
		}

		if ( thePlayer.inv.IsItemCrossbow( thePlayer.inv.GetItemFromSlot( 'l_weapon' ) ) )
		{
			thePlayer.OnRangedForceHolster(false, true, false);
		}

		ACS_PhantomPerformFinisherAzkarAiming(azkarShadowStrikeTarget);

		RemoveTimer('ACS_Azkar_Shadow_Strike_Teleport_Delay');
		AddTimer('ACS_Azkar_Shadow_Strike_Teleport_Delay', 1   , false);
	}

	timer function ACS_Azkar_Shadow_Strike_Teleport_Delay ( dt : float, id : int)
	{
		ACS_ExplorationDelayHack(false, 3);
		
		AddTimer( 'shadow_strike_finisher_check', 0.00000000000000001, true );
	}

	timer function shadow_strike_finisher_check( time : float , id : int )
	{
		var targetDistance 										: float;
		var movementAdjustorFinisher							: CMovementAdjustor;
		var ticketFinisher 										: SMovementAdjustmentRequestTicket;

		if(!azkarShadowStrikeDuplicate)
		{
			ACS_ExplorationDelayHack(false, 3);

			thePlayer.EnableCollisions(true);
			if (!thePlayer.IsUsingHorse()&& !thePlayer.IsUsingVehicle()){thePlayer.EnableCharacterCollisions(true); }

			movementAdjustorFinisher = GetWitcherPlayer().GetMovingAgentComponent().GetMovementAdjustor();

			movementAdjustorFinisher.CancelAll();

			thePlayer.SetVisibility(true);

			if (crossbow_hidden)
			{
				CrossbowHide(false);

				crossbow_hidden = false;
			}

			thePlayer.BlockAllActions( 'ACS_Shadow_Strike_Action_Block', false );

			thePlayer.SetImmortalityMode( AIM_None, AIC_Default, true );

			//PlayerPlayAnimation( 'man_geralt_sword_attack_fast_right_1_lp_40ms_forward_ACS');

			azkarShadowStrikeTarget = NULL;

			//azkarShadowStrikeDuplicate = NULL;

			RemoveTimer('shadow_strike_finisher_check');
		}
		else
		{
			targetDistance = VecDistanceSquared2D( thePlayer.GetWorldPosition(), azkarShadowStrikeDuplicate.GetWorldPosition() );

			if (targetDistance <= 1)
			{
				ACS_ExplorationDelayHack(false, 3);

				thePlayer.EnableCollisions(true);
				thePlayer.EnableCharacterCollisions(false);
				movementAdjustorFinisher = GetWitcherPlayer().GetMovingAgentComponent().GetMovementAdjustor();

				movementAdjustorFinisher.CancelAll();
				
				ticketFinisher = movementAdjustorFinisher.CreateNewRequest( 'ACS_Shadow_Strike_Finisher_Rotate' );
					
				movementAdjustorFinisher.AdjustmentDuration( ticketFinisher, 0.125 );

				movementAdjustorFinisher.ShouldStartAt(ticketFinisher, GetWitcherPlayer().GetWorldPosition());
				movementAdjustorFinisher.MaxRotationAdjustmentSpeed( ticketFinisher, 5000000 );
				movementAdjustorFinisher.MaxLocationAdjustmentSpeed( ticketFinisher, 5000000 );

				movementAdjustorFinisher.SlideTowards( ticketFinisher, azkarShadowStrikeDuplicate);
				movementAdjustorFinisher.RotateTo( ticketFinisher, VecHeading(azkarShadowStrikeDuplicate.GetHeadingVector()) );
				movementAdjustorFinisher.Continuous(ticketFinisher);
				movementAdjustorFinisher.AdjustLocationVertically( ticketFinisher, true );
			}
			else
			{
				ACS_ExplorationDelayHack(false, 3);
				
				thePlayer.EnableCollisions(false);
				thePlayer.EnableCharacterCollisions(false);
				thePlayer.Teleport( LerpV(thePlayer.GetWorldPosition(), azkarShadowStrikeDuplicate.GetWorldPosition(), 0.5f) );
			}
		}
	}

	var azkarShadowStrikeTarget : CActor;

	var azkarShadowStrikeDuplicate : CActor;

	function ACS_PhantomPerformFinisherAzkarAiming(combatTarget : CActor)
	{
		var finisher_anim_names												: array< name >;
		var pos																: Vector;
		var rot																: EulerAngles;
		var ent, ent_2														: CEntity;

		if( 
		combatTarget 
		)
		{
			ACS_ExplorationDelayHack(false, 3);

			rot = thePlayer.GetWorldRotation();

			pos = combatTarget.GetWorldPosition();

			ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\entities\other\geralt_phantom_assassin.w2ent", true ), pos, rot );

			azkarShadowStrikeDuplicate = (CActor)ent;

			ent_2 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

			"dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent"

			, true ), ent.GetWorldPosition() );

			ent_2.PlayEffect('suck_out_wraith');

			ent_2.PlayEffect('smoke_explosion_wraith');

			azkarShadowStrikeTarget = combatTarget;

			finisher_anim_names.Clear();

			if (combatTarget.IsHuman())
			{
				finisher_anim_names.PushBack('man_finisher_04_lp');
				finisher_anim_names.PushBack('man_finisher_06_lp');
				finisher_anim_names.PushBack('man_finisher_03_rp');
				finisher_anim_names.PushBack('man_finisher_05_rp');
				finisher_anim_names.PushBack('man_finisher_02_lp');
				finisher_anim_names.PushBack('man_finisher_07_lp');
				finisher_anim_names.PushBack('man_finisher_08_lp');
				finisher_anim_names.PushBack('man_finisher_dlc_arm_lp');
				finisher_anim_names.PushBack('man_finisher_dlc_legs_lp');
				finisher_anim_names.PushBack('man_finisher_dlc_torso_lp');
				finisher_anim_names.PushBack('man_finisher_dlc_arm_rp');
				finisher_anim_names.PushBack('man_finisher_dlc_legs_rp');
				finisher_anim_names.PushBack('man_finisher_dlc_torso_rp');
				finisher_anim_names.PushBack('man_finisher_01_rp');
				finisher_anim_names.PushBack('man_finisher_dlc_head_rp');
				finisher_anim_names.PushBack('man_finisher_dlc_neck_rp');

				ACS_PhantomSetupSyncAnimInternalHuman(finisher_anim_names[RandRange(finisher_anim_names.Size())], ent, combatTarget );
			}
			else
			{
				finisher_anim_names.PushBack('monster_slice_finisher');

				ACS_PhantomSetupSyncAnimInternalMonster(finisher_anim_names[RandRange(finisher_anim_names.Size())], ent, combatTarget );
			}
		}
	}

	function AzkarShadowStrike()
	{
		var ent : CEntity;

		maxAdrenaline = thePlayer.GetStatMax(BCS_Focus);
		
		curAdrenaline = thePlayer.GetStat(BCS_Focus);

		if (!thePlayer.GetDisplayTarget()
		|| !((CActor)thePlayer.GetDisplayTarget()).IsAlive()
		|| ((CActor)thePlayer.GetDisplayTarget()).GetAttitude( thePlayer ) != AIA_Hostile
		|| ((CActor)thePlayer.GetDisplayTarget()).GetCurrentHealth() > ((CActor)thePlayer.GetDisplayTarget()).GetMaxHealth() * 0.25
		|| FactsQuerySum("ACS_Azkar_Active") <= 0
		|| FactsQuerySum("ACS_Azkar_Aiming") <= 0
		|| curAdrenaline < maxAdrenaline/3
		)
		{
			return;
		}

		//GetWitcherPlayer().PlayEffectSingle('teleport');
		//GetWitcherPlayer().StopEffect('teleport');

		azkarShadowStrikeTarget = ((CActor)thePlayer.GetDisplayTarget());

		if (FactsQuerySum("ACS_Azkar_Active") > 0)
		{
			FactsRemove("ACS_Azkar_Active");
		}

		thePlayer.DestroyEffect('shadowdash_shockwave');
		thePlayer.PlayEffectSingle('shadowdash_shockwave');
		thePlayer.StopEffect('shadowdash_shockwave');

		ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

		"dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent"

		, true ), thePlayer.GetWorldPosition() );

		ent.PlayEffect('suck_out_wraith');

		ent.PlayEffect('smoke_explosion_wraith');

		ent.PlayEffect('diagonal_up_left_wraith');
		ent.PlayEffect('diagonal_down_left_wraith');
		ent.PlayEffect('down_wraith');
		ent.PlayEffect('up_wraith');
		ent.PlayEffect('diagonal_up_right_wraith');
		ent.PlayEffect('diagonal_down_right_wraith');
		ent.PlayEffect('right_wraith');
		ent.PlayEffect('left_wraith');

		RemoveTimer('ACS_Azkar_Shadow_Strike_Teleport_Start');
		AddTimer('ACS_Azkar_Shadow_Strike_Teleport_Start', 0.5   , false);

		thePlayer.SetImmortalityMode( AIM_Invulnerable, AIC_Default, true ); 

		ACS_SlowMoAdjustable(0.5,3.5);

		thePlayer.BlockAllActions( 'ACS_Shadow_Strike_Action_Block', true );

		if( curAdrenaline >= maxAdrenaline/3
		&& curAdrenaline < maxAdrenaline * 2/3 ) 
		{	
			thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) );
		}
		else if( curAdrenaline >= maxAdrenaline * 2/3
		&& curAdrenaline < maxAdrenaline) 
		{	
			thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) * 1/3 );
		}
		else if( curAdrenaline == maxAdrenaline) 
		{	
			thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) * 1/3 );
		}
	}

	function AzkarSpecialFXCreate()
	{
		var vfxEnt1 		: CEntity;

		vfxEnt1 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

		"dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent"
		
		, true ), GetWitcherPlayer().GetWorldPosition() );

		vfxEnt1.CreateAttachment( GetWitcherPlayer(), 'r_weapon' );

		vfxEnt1.PlayEffect('diagonal_up_left_wraith');
		vfxEnt1.PlayEffect('diagonal_down_left_wraith');
		vfxEnt1.PlayEffect('down_wraith');
		vfxEnt1.PlayEffect('up_wraith');
		vfxEnt1.PlayEffect('diagonal_up_right_wraith');
		vfxEnt1.PlayEffect('diagonal_down_right_wraith');
		vfxEnt1.PlayEffect('right_wraith');
		vfxEnt1.PlayEffect('left_wraith');

		vfxEnt1.DestroyAfter(2);
	}

	
	
	// Crossbow Stuff

	public timer function ACS_ShootShotgunLight ( dt : float, id : int)
	{ 
		var ent_3 		: CEntity;

		var actors    																																						: array<CActor>;
		var i         																																						: int;
		var actortarget																																						: CActor;
		var dmg																																								: W3DamageAction;
		var coneAngle, damageMax, damage_mult, targetDistance																												: float;
		var sp 																																								: SAbilityAttributeValue;
		var witcher 																																						: W3PlayerWitcher;
		var signIconEnt																																						: CEntity;
		var torsoBoneIndex																																					: int;
		var pos, playerPos, actortargetPos																																	: Vector;

		MovementAdjust('default');

		if(thePlayer.HasTag('ACS_Manual_Combat_Control')){thePlayer.RemoveTag('ACS_Manual_Combat_Control');} RemoveTimer('Manual_Combat_Control_Remove');
		
		if( actor && ACS_AttitudeCheck ( actor, true ) && thePlayer.IsInCombat())
		{
			if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTowards( ticket, actor );}   
		}
		else
		{
			movementAdjustor.RotateTo( ticket, theCamera.GetCameraHeading() );
		}

		PlayerPlayAnimation( 'man_npc_crossbow_shoot_to_idle_lp_ACS', 0.25f, 0.25f);

		RemoveTimer('ACS_ShotgunReload');

		AddTimer('ACS_ShotgunReload',0.75, false);

		theSound.SoundEvent("doom_shotgun_fire_orig_acs");

		GCameraShake( 0.5, true, thePlayer.GetWorldPosition(), 30 );

		if (ACSGetCEntity('ACS_Shotgun_Flare'))
		{
			ACSGetCEntity('ACS_Shotgun_Flare').StopAllEffects();
			ACSGetCEntity('ACS_Shotgun_Flare').RemoveTag('ACS_Shotgun_Flare');
		}

		ent_3 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

		"dlc\dlc_acs\data\fx\shotgun_fx\pc_igni_mq1060.w2ent"

		, true ), thePlayer.GetWorldPosition() );

		ent_3.CreateAttachment( thePlayer, , Vector( 0, 1.75, 1.825 ), EulerAngles(0,90,0) );
		ent_3.BreakAttachment();

		ent_3.PlayEffectSingle('cone_1_alt');
		ent_3.PlayEffectSingle('cone_2_alt');
		ent_3.PlayEffectSingle('cone_melt_1_alt');
		ent_3.PlayEffectSingle('cone_melt_2_alt');
		ent_3.PlayEffectSingle('cone_power_2_alt');
		ent_3.PlayEffectSingle('cone_superpower_1_alt');

		ent_3.DestroyAfter(5);

		ent_3.AddTag('ACS_Shotgun_Flare');




		actors.Clear();

		actors = thePlayer.GetNPCsAndPlayersInCone(10, VecHeading(thePlayer.GetHeadingVector()), 30, 999, , FLAG_ExcludePlayer );

		if( actors.Size() > 0 )
		{
			for( i = 0; i < actors.Size(); i += 1 )
			{
				actortarget = (CActor)actors[i];

				actortargetPos = actortarget.GetWorldPosition();

				playerPos = thePlayer.GetWorldPosition();
				playerPos.Z += 0.8;

				if ( AbsF( actortargetPos.Z - playerPos.Z ) > 2.5 )
				{
					continue;
				}

				if (actortarget.IsAlive() && actortarget.GetAttitude( thePlayer ) == AIA_Hostile )
				{
					if (actortarget.IsUsingVehicle()
					&& !actortarget.HasTag('ACS_Dullahan')
					&& !actortarget.HasTag('ACS_Dullahan_Horse')
					) 
					{
						actortarget.SignalGameplayEventParamInt( 'RidingManagerDismountHorse', DT_shakeOff | DT_fromScript );
					}

					dmg = new W3DamageAction in theGame.damageMgr;
					
					dmg.Initialize(thePlayer, actortarget, thePlayer, thePlayer.GetName(), EHRT_Heavy, CPS_Undefined, false, false, true, false);
					
					dmg.SetProcessBuffsIfNoDamage(true);

				
					torsoBoneIndex = actortarget.GetTorsoBoneIndex();

					if ( torsoBoneIndex != -1 )
					{
						pos = MatrixGetTranslation( actortarget.GetBoneWorldMatrixByIndex( torsoBoneIndex ) );
					}
					else
					{
						pos = actortarget.GetWorldPosition() + Vector(0,0,1.5);
					}

					signIconEnt = theGame.CreateEntity( (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\fx\sign_icons.w2ent", true ), pos );
					signIconEnt.DestroyAfter(5);

					signIconEnt.PlayEffect('critical_igni');
					signIconEnt.PlayEffect('mutation_2_igni');

					if( GetWitcherPlayer().GetStat(BCS_Focus) >= GetWitcherPlayer().GetStatMax(BCS_Focus)/3
					&& GetWitcherPlayer().GetStat(BCS_Focus) < GetWitcherPlayer().GetStatMax(BCS_Focus) * 2/3)
					{
						damage_mult = 0.04125;
					}	
					else if( GetWitcherPlayer().GetStat(BCS_Focus) >= GetWitcherPlayer().GetStatMax(BCS_Focus) * 2/3
					&& GetWitcherPlayer().GetStat(BCS_Focus) < GetWitcherPlayer().GetStatMax(BCS_Focus))
					{
						damage_mult = 0.0825;
					}
					else if( GetWitcherPlayer().GetStat(BCS_Focus) == GetWitcherPlayer().GetStatMax(BCS_Focus))
					{
						damage_mult = 0.165;
					}

					if (((CMovingPhysicalAgentComponent)(actortarget.GetMovingAgentComponent())).GetCapsuleHeight() >= 2
					|| actortarget.GetRadius() >= 0.7
					|| actortarget.HasAbility('Boss')
					|| actortarget.HasTag('IsBoss')
					|| actortarget.HasTag('ACS_Big_Boi')
					)
					{
						damage_mult -= damage_mult * 0.5;
					}

					if (actortarget.GetCurrentHealth() >= actortarget.GetMaxHealth() * 0.5)
					{
						damageMax = actortarget.GetCurrentHealth() * damage_mult;
					}
					else if (actortarget.GetCurrentHealth() < actortarget.GetMaxHealth() * 0.5)
					{
						damageMax = (actortarget.GetMaxHealth() - actortarget.GetCurrentHealth()) * damage_mult;
					}

					if (actortarget.GetCurrentHealth() <= actortarget.GetMaxHealth() * 0.05)
					{
						damageMax += actortarget.GetMaxHealth();
					}

					((CNewNPC)actortarget).ACS_DealPostureDamage(25);

					damageMax += damageMax * ACS_SignIntensityPercentage('total') * 0.5;

					targetDistance = VecDistanceSquared2D( thePlayer.GetWorldPosition(), actortarget.GetWorldPosition() );

					if (targetDistance <= 5*5)
					{
						damageMax += damageMax * 0.5;
					}
					else if (targetDistance > 5*5)
					{
						damageMax -= damageMax * 0.5;
					}

					dmg.AddEffectInfo(EET_Burning, 0.5);

					dmg.SetCanPlayHitParticle(false);

					dmg.SetSuppressHitSounds(true);

					dmg.SetHitReactionType( EHRT_Heavy, true);

					dmg.AddDamage( theGame.params.DAMAGE_NAME_DIRECT, RandRangeF(3400,3000) + damageMax );

					dmg.SetForceExplosionDismemberment();
						
					dmg.SetCriticalHit(); 
					
					theGame.damageMgr.ProcessAction( dmg );
						
					delete dmg;	
				}
				else
				{
					if (!actortarget.IsAlive() )
					{
						actortarget.StopEffect('critical_burning');
						actortarget.PlayEffect('critical_burning');

						actortarget.AddTag('ACS_Killed_By_Fire');

						ACSCreateBurningFX(((CNewNPC)actortarget));

						((CNewNPC)actortarget).RemoveTimer('ACS_Critical_Burning_Remove_Delay');
						((CNewNPC)actortarget).AddTimer('ACS_Critical_Burning_Remove_Delay', 300 , false);
					}
				}
			}
		}

		GetWitcherPlayer().DrainFocus( GetWitcherPlayer().GetStatMax( BCS_Focus ) * 0.165 );
	} 

	public timer function ACS_ShootShotgunHeavy ( dt : float, id : int)
	{ 
		var ent_3 		: CEntity;

		var actors    																																						: array<CActor>;
		var i         																																						: int;
		var actortarget																																						: CActor;
		var dmg																																								: W3DamageAction;
		var coneAngle, damageMax, damage_mult, targetDistance																												: float;
		var sp 																																								: SAbilityAttributeValue;
		var witcher 																																						: W3PlayerWitcher;
		var signIconEnt																																						: CEntity;
		var torsoBoneIndex																																					: int;
		var pos, playerPos, actortargetPos																																	: Vector;


		MovementAdjust('default');

		if(thePlayer.HasTag('ACS_Manual_Combat_Control')){thePlayer.RemoveTag('ACS_Manual_Combat_Control');} RemoveTimer('Manual_Combat_Control_Remove');
		
		if( actor && ACS_AttitudeCheck ( actor, true ) && thePlayer.IsInCombat())
		{
			if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTowards( ticket, actor );}   
		}
		else

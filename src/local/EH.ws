					sneakingEnvID = ActivateEnvironmentDefinition( sneakingEnvironment, 1000, 0.125f, 0.75f );

					theGame.SetEnvironmentID(sneakingEnvID);
				}
				else
				{
					DeactivateEnvironment(sneakingEnvID, 0.75f);
				}
			break;

			case 'day_env' :
				if (activate)
				{
					if (!ACS_Settings_Main_Bool('acs_world_visual_settings','acs_spiral_sky_sun_enabled', true))
					{
						return;
					}


							&& thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus ) * 1/3 )
							{
								ACS_Tutorial_Display_Check('ACS_Weapon_Arts_Tutorial_Shown');

								RemoveTimer('RollDelay');

								Giant_Stomp();

								if( thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus )/3
								&& thePlayer.GetStat( BCS_Focus ) < thePlayer.GetStatMax( BCS_Focus ) * 2/3) 
								{	
									thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) );
								}
								else if( thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus ) * 2/3
								&& thePlayer.GetStat( BCS_Focus ) < thePlayer.GetStatMax( BCS_Focus ) * 0.9875 )  
								{	
									thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) * 1/3);
								}
								else if( thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus ) * 0.9875 ) 
								{
									thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) * 1/3);
								}
							}
							else
							{
								Attack_Process_25('geraltRandomGiantAttack');
							}
							
							RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5   , false);

							ACS_StaminaDrain(1);
						
					}
					break;

					case 'HybridModeGiantLightAttack':
					if (ACS_can_perform_light_attack())
					{
						
							ACS_refresh_light_attack_cooldown();
															
							thePlayer.BreakPheromoneEffect();
															
							SecondaryWeaponSwitch();
															
							Attack_Process_25('geraltRandomGiantAttack');

							RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5   , false);

							ACS_StaminaDrain(1);
						
					}
					break;

					case 'HybridModeGiantForwardLightAttack':
					if (ACS_can_perform_light_attack())
					{
						
							ACS_refresh_light_attack_cooldown();
															
							thePlayer.BreakPheromoneEffect();
															
							SecondaryWeaponSwitch();
																						
							Attack_Process_25('geraltRandomGiantAttackAlt');
			
							RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5   , false);

							ACS_StaminaDrain(1);
						
					}
					break;					

					
					default:
					break;
				}
				
			}
		}
	}

	function Attack_Setup_15( attack_name : name )
	{	
		ACS_ExplorationDelayHack(false, 3);

		finisherActorTarget = (CActor)( thePlayer.GetTarget() );	
		ccomp = finisherActorTarget.GetComponent("Finish");
		ccompEnabled = ccomp.IsEnabled();

		if (
		ccompEnabled
		&& ACS_AttitudeCheck (finisherActorTarget)
		&& VecDistanceSquared2D( thePlayer.GetWorldPosition(), finisherActorTarget.GetNearestPointInBothPersonalSpaces( thePlayer.GetWorldPosition() ) ) < 2.75f * 2.75f
		)
		{
			PrimarySecondaryWeaponSwitch ( attack_name );

			ACS_Setup_Light_Attack_Internal();
		}
		else
		{
			if ( ACS_Settings_Main_Bool('acs_stamina_settings','acs_stamina_block_action', false) 
			&& StaminaCheck('default')
			)
			{
				RemoveTimer('SwordTauntSwitch'); RemoveTimer('SwordTauntRunningSwitch');   if (thePlayer.HasTag('ACS_IsSwordWalking')){thePlayer.RemoveTag('ACS_IsSwordWalking');} if(thePlayer.IsInCombat()){if(thePlayer.GetCombatIdleStance() <= 0.f ){thePlayer.RaiseEvent('ACS_CombatTauntLeft');}else{thePlayer.RaiseEvent('ACS_CombatTauntRight');}} thePlayer.SoundEvent("gui_no_stamina");
			}
			else
			{
				switch ( attack_name )
				{
					case 'FocusModeAxeLightAttack':
					if (ACS_can_perform_light_attack())
					{
						
							ACS_refresh_light_attack_cooldown();
															
							thePlayer.BreakPheromoneEffect();
															
							SecondaryWeaponSwitch();

							if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	
									
							if (Attack_Directional_Press_Check())
							{
								if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier( 1.25  ); }
							
								RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5   , false);

								Attack_Process_27('geraltRandom2hAxeAttackAlt');
							}
							//else if (theInput.GetActionValue('GI_AxisLeftY') < -0.5
							else if (theInput.GetActionValue(DodgeOrRoll()) > 0.7
							&& thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus ) * 1/3 )
							{
								ACS_Tutorial_Display_Check('ACS_Weapon_Arts_Tutorial_Shown');

								RemoveTimer('RollDelay');

								Water_Aard();

								if( thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus )/3
								&& thePlayer.GetStat( BCS_Focus ) < thePlayer.GetStatMax( BCS_Focus ) * 2/3) 
								{	
									thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) );
								}
								else if( thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus ) * 2/3
								&& thePlayer.GetStat( BCS_Focus ) < thePlayer.GetStatMax( BCS_Focus ) * 0.9875 )  
								{	
									thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) * 1/3);
								}
								else if( thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus ) * 0.9875 ) 
								{
									thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) * 1/3);
								}
							}
							else
							{
								if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier( 1.25  ); }
							
								RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5   , false);

								Attack_Process_27('geraltRandom2hAxeAttack');
							}

							ACS_StaminaDrain(1);
						
					}
					break;

					case 'HybridModeAxeLightAttack':
					if (ACS_can_perform_light_attack())
					{
						
							ACS_refresh_light_attack_cooldown();
															
							thePlayer.BreakPheromoneEffect();
															
							SecondaryWeaponSwitch();
																							
							Attack_Process_27('geraltRandom2hAxeAttack');

							if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	

							if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier( 1.25  ); }
							
							RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5   , false);

							ACS_StaminaDrain(1);
						
					}
					break;

					case 'HybridModeAxeForwardLightAttack':
					if (ACS_can_perform_light_attack())
					{
						
							ACS_refresh_light_attack_cooldown();
															
							thePlayer.BreakPheromoneEffect();
															
							SecondaryWeaponSwitch();
																							
							Attack_Process_27('geraltRandom2hAxeAttackAlt');

							if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	

							if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier( 1.25  ); }
							
							RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5   , false);

							ACS_StaminaDrain(1);
						
					}
					break;

					case 'FocusModeGiantHeavyAttack':
					if ( ACS_can_perform_heavy_attack() )
					{
						
							ACS_refresh_heavy_attack_cooldown();
											
							thePlayer.BreakPheromoneEffect();
											
							SecondaryWeaponSwitch();
												
							if (Attack_Directional_Press_Check())
							{
								Attack_Process_25('geraltRandomGiantAttackAlt');

								if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	

								if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier(1.25  ); }
							}
							else
							{
								Attack_Process_25('geraltRandomGiantAttack');
							}
											
							RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5   , false);

							ACS_StaminaDrain(2);
						
					}
					break;

					case 'HybridModeGiantHeavyAttack':
					if ( ACS_can_perform_heavy_attack() )
					{
						
							ACS_refresh_heavy_attack_cooldown();
											
							thePlayer.BreakPheromoneEffect();
											
							SecondaryWeaponSwitch();

							Attack_Process_25('geraltRandomGiantAttack');
											
							RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5   , false);

							ACS_StaminaDrain(2);
						
					}
					break;

					case 'HybridModeGiantForwardHeavyAttack':
					if ( ACS_can_perform_heavy_attack() )
					{
						
							ACS_refresh_heavy_attack_cooldown();
											
							thePlayer.BreakPheromoneEffect();
											
							SecondaryWeaponSwitch();
											
							Attack_Process_25('geraltRandomGiantAttackAlt'); 	

							if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	
								
							if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier(1.25  ); }
											
							RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5   , false);

							ACS_StaminaDrain(2);
						
					}
					break;


					
					default:
					break;
				}
				
			}
		}
	}

	function Attack_Setup_16( attack_name : name )
	{	
		ACS_ExplorationDelayHack(false, 3);


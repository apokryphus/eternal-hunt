	function ACS_Event_Controller_Switch( eventName : name )
	{
		var currentGameTime : GameTime;
		var hours : int;

		if (theGame.IsDialogOrCutscenePlaying() 
		||thePlayer.IsInNonGameplayCutscene() 
		||thePlayer.IsInGameplayScene()
		||theGame.GetPhotomodeEnabled() 
		||thePlayer.IsInCutsceneIntro() 
		||theGame.IsCurrentlyPlayingNonGameplayScene() 
		||theGame.IsBlackscreen()
		||theGame.IsFading()
		||theGame.HasBlackscreenRequested()
		||theGame.IsCurrentlyPlayingNonGameplayScene()
		||theGame.GetGuiManager().IsAnyMenu()
		||theGame.GetTutorialSystem().HasActiveTutorial()
		||ACS_PlayerSettlementCheck(50)
		||ACS_GetHostilesCheck()
		||thePlayer.IsInInterior()
		||thePlayer.IsInAir()
		||!thePlayer.IsOnGround()
		||thePlayer.IsCiri()
		||thePlayer.GetIsHorseRacing()
		||ACS_Player_Near_Quest_Marker()
		)
		{
			return;
		}
		
		currentGameTime = theGame.CalculateTimePlayed();
		hours = GameTimeDays(currentGameTime) * 24 + GameTimeHours(currentGameTime);

		switch(eventName)
		{
			case 'forest_god':
			if (ACS_Settings_Main_Float('acs_events_settings','acs_shadows_spawn_chances_normal', 0.1) != 0
			&& hours >= 7
			)
			{
				if (
				thePlayer.inv.HasItem('mh204_leshy_trophy')
				|| thePlayer.inv.HasItem('mh302_leshy_trophy')
				|| thePlayer.inv.HasItem('Leshy resin')
				|| thePlayer.inv.HasItem('sq204_leshy_talisman')
				|| thePlayer.inv.HasItem('Ancient Leshy mutagen')
				|| thePlayer.inv.HasItem('Leshy mutagen')
				)
				{
					if( RandF() < ACS_Settings_Main_Float('acs_events_settings','acs_shadows_spawn_chances_normal', 0.1) * ACS_Settings_Main_Float('acs_events_settings','acs_shadows_spawn_chances_normal', 0.1) ) 
					{
						if( ACS_can_spawn_forest_god_shadows() ) 
						{
							ACS_refresh_forest_god_shadows_cooldown();

							if( RandF() < 0.5 ) 
							{
								GetWitcherPlayer().DisplayHudMessage( GetLocStringById(2118449970) );
							}
							else
							{
								GetWitcherPlayer().DisplayHudMessage( GetLocStringById(2118449971) );
							}

							vACS_Forest_God_Spawner = new cACS_Forest_God_Spawner in this;
		
							ACSGetCActorDestroyAll('ACS_Forest_God_Shadows');

							vACS_Forest_God_Spawner.ACS_Forest_God_Shadows_Spawner_Engage();
						}
					}
				}
				else
				{
					if( RandF() < ACS_Settings_Main_Float('acs_events_settings','acs_shadows_spawn_chances_normal', 0.1) ) 
					{
						if( ACS_can_spawn_forest_god_shadows() ) 
						{
							ACS_refresh_forest_god_shadows_cooldown();

							if( RandF() < 0.5 ) 
							{
								GetWitcherPlayer().DisplayHudMessage( GetLocStringById(2118449972) );
							}
							else
							{
								GetWitcherPlayer().DisplayHudMessage( GetLocStringById(2118449973) );
							}

							vACS_Forest_God_Spawner = new cACS_Forest_God_Spawner in this;
		
							ACSGetCActorDestroyAll('ACS_Forest_God_Shadows');

							vACS_Forest_God_Spawner.ACS_Forest_God_Shadows_Spawner_Engage();
						}
					}
				}
			}
			break;

			case 'wild_hunt':
			if( RandF() < ACS_Settings_Main_Float('acs_events_settings','acs_wild_hunt_spawn_chances_normal', 0.1) 
			&& FactsQuerySum("q002_met_emhyr") > 0
			&& ACS_can_spawn_wild_hunt_warriors()
			) 
			{
				ACS_refresh_wild_hunt_warriors_spawn_cooldown();

				vACS_Wild_Hunt_Riders = new cACS_Wild_Hunt_Riders in this;

				vACS_Wild_Hunt_Riders.ACS_Wh_Ship_Spawn_Engage();

				RemoveTimer('ACS_Wild_Hunt_Riders_Spawner_Delay_Timer');
				AddTimer('ACS_Wild_Hunt_Riders_Spawner_Delay_Timer',7 ,false);
			}
			break;

			case 'nightstalker':
			if( RandF() < ACS_Settings_Main_Float('acs_events_settings','acs_night_stalker_spawn_chances_normal', 0.1) 
			&& FactsQuerySum("ACS_Darkness_Upon_Us") > 0
			&& (theGame.GetCommonMapManager().GetCurrentArea() == AN_Skellige_ArdSkellig 
			|| theGame.GetCommonMapManager().GetCurrentArea() == AN_NMLandNovigrad
			|| theGame.GetCommonMapManager().GetCurrentArea() == AN_Velen
			|| theGame.GetCommonMapManager().GetCurrentArea() == AN_Kaer_Morhen
			|| theGame.GetCommonMapManager().GetCurrentArea() == AN_Dlc_Bob)
			&& hours >= 15
			&& ACS_can_spawn_nightstalker()
			)
			{
				ACS_refresh_nightstalker_spawn_cooldown();

				vACS_Night_Stalker = new cACS_Night_Stalker in this;

				vACS_Night_Stalker.ACS_Night_Stalker_Engage();
			}
			break;

			case 'elderblood_assassin':
			if( RandF() < ACS_Settings_Main_Float('acs_events_settings','acs_elderblood_assassin_spawn_chances_normal',0.1) 
			&& hours >= 10
			&& ACS_can_spawn_elderblood_assassin()
			)
			{
				ACS_refresh_elderblood_assassin_spawn_cooldown();

				vACS_Elderblood_Assassin = new cACS_Elderblood_Assassin in this;

				vACS_Elderblood_Assassin.ACS_Elderblood_Assassin_Engage();
			}
			break;
		}
	}

	public timer function AdditionalSpawnsDelay ( dt : float, id : int)
	{
		if ( theGame.IsDialogOrCutscenePlaying() 
		|| thePlayer.IsInNonGameplayCutscene() 
		|| thePlayer.IsInGameplayScene() 
		|| theGame.IsCurrentlyPlayingNonGameplayScene()
		|| theGame.GetPhotomodeEnabled() 
		|| thePlayer.IsInCutsceneIntro() 
		|| thePlayer.GetIsHorseRacing()
		)
		{
			return;
		}
		
		if (ACS_Settings_Main_Bool('acs_events_settings','acs_allow_simultaenous_events_spawning', false))
		{
			ACS_Event_Controller_Switch('wild_hunt');

			ACS_Event_Controller_Switch('forest_god');

			ACS_Event_Controller_Switch('nightstalker');

			ACS_Event_Controller_Switch('elderblood_assassin');
		}
		else
		{
			ACS_Event_Controller_Switch('wild_hunt');

			RemoveTimer('AdditionalSpawnsDelay_add1');
			RemoveTimer('AdditionalSpawnsDelay_add2');
			RemoveTimer('AdditionalSpawnsDelay_add3');

			AddTimer('AdditionalSpawnsDelay_add1', 1   , false);

			AddTimer('AdditionalSpawnsDelay_add2', 2   , false);

			AddTimer('AdditionalSpawnsDelay_add3', 3   , false);
		}
	}

	public timer function AdditionalSpawnsDelay_add1 ( dt : float, id : int)
	{
		if (!thePlayer.GetIsHorseRacing()
		&& !theGame.IsDialogOrCutscenePlaying() 
		&& !thePlayer.IsInNonGameplayCutscene() 
		&& !thePlayer.IsInGameplayScene() 
		&& !theGame.IsCurrentlyPlayingNonGameplayScene()
		&& !theGame.GetPhotomodeEnabled() 
		&& !thePlayer.IsInCutsceneIntro() 
		&& !ACSGetCEntity('ACS_Naglfar') 
		&& !ACSGetCActor('ACS_Forest_God_Shadows') 
		&& !ACSGetCActor('ACS_Night_Stalker')
		)
		{
			ACS_Event_Controller_Switch('forest_god');
		}
	}

	public timer function AdditionalSpawnsDelay_add2 ( dt : float, id : int)
	{
		if (!thePlayer.GetIsHorseRacing()
		&& !theGame.IsDialogOrCutscenePlaying() 
		&& !thePlayer.IsInNonGameplayCutscene() 
		&& !thePlayer.IsInGameplayScene() 
		&& !theGame.IsCurrentlyPlayingNonGameplayScene()
		&& !theGame.GetPhotomodeEnabled() 
		&& !thePlayer.IsInCutsceneIntro() 
		&& !ACSGetCEntity('ACS_Naglfar') 
		&& !ACSGetCActor('ACS_Forest_God_Shadows') 
		&& !ACSGetCActor('ACS_Night_Stalker')
		)
		{
			ACS_Event_Controller_Switch('nightstalker');
		}
	}

	public timer function AdditionalSpawnsDelay_add3 ( dt : float, id : int)
	{
		if (!thePlayer.GetIsHorseRacing()
		&& !theGame.IsDialogOrCutscenePlaying() 
		&& !thePlayer.IsInNonGameplayCutscene() 
		&& !thePlayer.IsInGameplayScene() 
		&& !theGame.IsCurrentlyPlayingNonGameplayScene()
		&& !theGame.GetPhotomodeEnabled() 
		&& !thePlayer.IsInCutsceneIntro() 
		&& !ACSGetCEntity('ACS_Naglfar') 
		&& !ACSGetCActor('ACS_Forest_God_Shadows') 
		&& !ACSGetCActor('ACS_Night_Stalker')
		)
		{
			ACS_Event_Controller_Switch('elderblood_assassin');
		}
	}

	function Wisp_Hit_Counter_Adjust( b : bool )
	{
		if (b)
		{
			wispHitCounter += 1;
		}
		else
		{
			wispHitCounter -= wispHitCounter;
		}
	}

	var vClawDestroy : cACSClawDestroy;

	function ClawDestroy()
	{
		if (thePlayer.GetPlayerCombatStance() != PCS_Normal)
		{
			thePlayer.SetPlayerCombatStance(PCS_Normal, true);
		}

		vClawDestroy = new cACSClawDestroy in this;
				
		vClawDestroy.ClawDestroy_Engage();

		if (thePlayer.GetPlayerCombatStance() != PCS_Normal)
		{
			thePlayer.SetPlayerCombatStance(PCS_Normal, true);
		}

		ACS_SwordTrailDestroy();
	}

	public timer function ClawDestroyDelay ( dt : float, id : int)
	{
		ClawDestroy();
	}


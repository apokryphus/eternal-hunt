					ReleaseStabHostage();

					RemoveTimer('ACS_Stab_Hostage_Process');
					
					return;
				}

				if( 
				StabHostageCheck()
				)
				{
					thePlayer.ACS_ClearAnimationSpeedMultipliers();

					thePlayer.RaiseEvent('ACS_StabHostageEnter03');
					
					return;
				}

				//ACS_Phantom_Combo_Mode_Reset();


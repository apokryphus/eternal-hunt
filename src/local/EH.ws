	public timer function ACS_Umbral_Slash_End_Damage ( dt : float, id : int) 
	{ 
		var dmg 																																							: W3DamageAction;
		var damageMax, maxTargetVitality, maxTargetEssence																													: float;
		var actortarget																																						: CActor;
		var actors    																																						: array<CActor>;
		var i         																																						: int;
		var marks																																							: array< CEntity >;
		var mark       																																						: CEntity;
		var attAction																																						: W3Action_Attack;


		vACS_Umbral_Slash_End = new cACS_Umbral_Slash_End in this;
			
		vACS_Umbral_Slash_End.ACS_Umbral_Slash_End_Engage();
		
		marks.Clear();
			
		theGame.GetEntitiesByTag( 'Umbral_Slash_End_Mark', marks );

		for( i=0; i<marks.Size(); i+=1 )
		{	
			mark = (CEntity)marks[i];	
			mark.Teleport( GetWitcherPlayer().GetWorldPosition() + Vector( 0, 0, -100) );
			mark.Destroy();
		}

		actors = GetWitcherPlayer().GetNPCsAndPlayersInRange( 50, 20, , FLAG_ExcludePlayer + FLAG_Attitude_Hostile + FLAG_OnlyAliveActors);
		for( i = 0; i < actors.Size(); i += 1 )
		{
			actortarget = (CActor)actors[i];
			/*
			dmg = new W3DamageAction in theGame.damageMgr;
			dmg.Initialize(GetWitcherPlayer(), actortarget, theGame, 'ACS_Umbral_Slash_End_Damage', EHRT_Heavy, CPS_Undefined, false, false, true, false);

			dmg.SetProcessBuffsIfNoDamage(true);
			dmg.SetCanPlayHitParticle(true);

			if (actortarget.UsesVitality()) 
			{ 
				damageMax = actortarget.GetStatMax( BCS_Vitality ) * 0.75; 
			} 
			else if (GetWitcherPlayer().GetDisplayTarget().UsesEssence()) 
			{ 
				damageMax = actortarget.GetStatMax( BCS_Essence ) * 0.75; 
			} 

			dmg.AddDamage( theGame.params.DAMAGE_NAME_DIRECT, damageMax );
						
			dmg.AddEffectInfo( EET_HeavyKnockdown, 1 );

			//dmg.SetForceExplosionDismemberment();
				
			dmg.SetCriticalHit(); theGame.damageMgr.ProcessAction( dmg );
									
			delete dmg;
			*/

			((CActor)actortarget).AddAbility( 'DisableFinishers', true );

			attAction = new W3Action_Attack in theGame.damageMgr;

			attAction.Init( GetWitcherPlayer(), actortarget, GetWitcherPlayer(), GetWitcherPlayer().GetInventory().GetItemFromSlot( 'r_weapon' ), 
			theGame.params.ATTACK_NAME_LIGHT, GetWitcherPlayer().GetName(), EHRT_None, true, true, theGame.params.ATTACK_NAME_LIGHT, AST_NotSet, ASD_NotSet, true, false, false, false, , , , , );
			attAction.SetHitReactionType(EHRT_Light);
			attAction.SetHitAnimationPlayType(EAHA_Default);

			if (actortarget.UsesVitality()) 
			{ 
				maxTargetVitality = actortarget.GetStatMax( BCS_Vitality ) - actortarget.GetStat( BCS_Vitality );

				damageMax = maxTargetVitality * 0.45; 
			} 
			else if (actortarget.UsesEssence()) 
			{ 
				maxTargetEssence = actortarget.GetStatMax( BCS_Essence ) - actortarget.GetStat( BCS_Essence );
				
				damageMax = maxTargetEssence * 0.45; 
			} 

			attAction.AddDamage( theGame.params.DAMAGE_NAME_DIRECT, 50 + damageMax );
			
			attAction.SetSoundAttackType( 'wpn_slice' );
			
			attAction.AddEffectInfo( EET_Stagger, 1 );
			
			theGame.damageMgr.ProcessAction( attAction );	

			attAction.SetCriticalHit();
			
			delete attAction;

			((CActor)actortarget).RemoveAbility( 'DisableFinishers' );
		}

		GetWitcherPlayer().StopEffect('olgierd_energy_blast');
		
		GetWitcherPlayer().PlayEffectSingle('olgierd_energy_blast');
		GetWitcherPlayer().PlayEffectSingle('olgierd_energy_blast');
		GetWitcherPlayer().PlayEffectSingle('olgierd_energy_blast');
		GetWitcherPlayer().PlayEffectSingle('olgierd_energy_blast');
		GetWitcherPlayer().PlayEffectSingle('olgierd_energy_blast');
		GetWitcherPlayer().StopEffect('olgierd_energy_blast');
		 
	} 
	
	public timer function ACS_Shout ( dt: float, id : int) { thePlayer.PlayEffectSingle('shout'); thePlayer.StopEffect('shout'); } 

	public timer function ACS_Shout_Stop ( dt: float, id : int) { thePlayer.StopEffect('shout'); } 

	public timer function ACS_portable_aard ( dt : float, id : int)
	{ 
		if (!thePlayer.IsAnyWeaponHeld() || thePlayer.IsWeaponHeld('fist'))
		{
			ACS_Aard();
		}
		else
		{
			vACS_Rend_Projectile = new cACS_Rend_Projectile in this;
			
			vACS_Rend_Projectile.ACS_Giant_Shockwave_Engage();
		}
	} 

	public timer function ACS_Manticore_Aard ( dt : float, id : int)
	{
		var entPhysics                  		: CEntity;
		var rot                        			: EulerAngles;
		var pos									: Vector;
		var player								: CR4Player;

		thePlayer.SoundEvent("fx_rune_activate_aard");

		thePlayer.SoundEvent("sign_aard_blast");

		rot = GetWitcherPlayer().GetWorldRotation();

		pos = GetWitcherPlayer().GetWorldPosition();

		pos.Z += 0.5;

		entPhysics = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

		"dlc\dlc_acs\data\fx\aard_cone_fix.w2ent"

		, true ), pos, rot );

		entPhysics.PlayEffectSingle('cone');

		entPhysics.DestroyAfter(3);

		AardDealDamage();
	} 
	
	public timer function ACS_ExplorationDelay(deltaTime : float , id : int)
	{
		thePlayer.RemoveTag('ACS_ExplorationDelayTag');

		if ( !theGame.IsDialogOrCutscenePlaying() 
		&& !theGame.IsFading()
		&& !theGame.IsBlackscreen()
		&& !theGame.IsPaused() 
		&& !theGame.GetPhotomodeEnabled() 
		&& !thePlayer.IsInCutsceneIntro() 
		&& !theGame.IsCurrentlyPlayingNonGameplayScene() 
		)
		{
			if (!thePlayer.IsInCombat())
			{
				if (thePlayer.HasTag('acs_vampire_claws_equipped'))
				{
					ClawDestroy();
				}
				else if (thePlayer.HasTag('acs_sorc_fists_equipped'))
				{
					SorcFistDestroy();
				}
			}
		}
	}

	public timer function DualWieldToggleInitDelay(deltaTime : float , id : int)
	{
		if (!thePlayer.HasTag('ACS_Dual_Wield_Active'))
		{
			thePlayer.AddTag('ACS_Dual_Wield_Active');
		}
	}

	public timer function SpearTransformToggleInitDelay(deltaTime : float , id : int)
	{
		if (!thePlayer.HasTag('ACS_Spear_Transform_Active'))
		{
			thePlayer.AddTag('ACS_Spear_Transform_Active');
		}
	}

	public timer function ACS_WeaponEquipDelay(deltaTime : float , id : int)
	{
		if ( ACS_Settings_Main_Bool('acs_main_settings','acs_mod_enabled', true) 
		&& !ACS_New_Replacers_Female_Active() 
		&& !theGame.IsDialogOrCutscenePlaying() 
		&& !theGame.IsFading()
		&& !theGame.IsBlackscreen()
		&& !theGame.IsPaused() 
		&& !theGame.GetPhotomodeEnabled() 
		&& !thePlayer.IsInCutsceneIntro() 
		&& !theGame.IsCurrentlyPlayingNonGameplayScene() 
		)
		{	
			if ( FactsQuerySum("ACS_Dual_Wield_Toggle_Enabled") > 0 
			&& thePlayer.IsAnyWeaponHeld()
			&& !thePlayer.IsWeaponHeld('fist')
			&& thePlayer.IsInCombat()
			)
			{
				RemoveTimer('DualWieldToggleInitDelay'); 
				AddTimer('DualWieldToggleInitDelay', 0.25f , false); 
			}

			if ( FactsQuerySum("ACS_Spear_Transform_Toggle_Enabled") > 0 
			&& thePlayer.IsAnyWeaponHeld()
			&& !thePlayer.IsWeaponHeld('fist')
			&& thePlayer.IsInCombat()
			)
			{
				RemoveTimer('SpearTransformToggleInitDelay'); 
				AddTimer('SpearTransformToggleInitDelay', 0.25f , false); 
			}

			if (ACS_Armor_Set_Check('acs_armor', false))
			{
				thePlayer.SoundEvent("monster_caretaker_vo_taunt_long");
			}
			
			ACS_ThingsThatShouldBeRemoved();

			if (!thePlayer.HasTag('ACS_Drawn_Weapon'))
			{
				thePlayer.AddTag('ACS_Drawn_Weapon');
			}

			RemoveTimer('Drawn_Weapon_Reset');
			AddTimer('Drawn_Weapon_Reset', ACS_Settings_Main_Float('acs_hud_settings_main','acs_hud_elements_despawn_delay', 7) , false);

			if (ACS_GetItem_Sword_IsEquipped('zireal_steel_held', 'steel') || ACS_GetItem_Sword_IsEquipped('zireal_silver_held', 'silver') && GetWitcherPlayer().IsDeadlySwordHeld())
			{
				GetWitcherPlayer().StopEffect('fury_ciri');
				GetWitcherPlayer().PlayEffectSingle('fury_ciri');

				GetWitcherPlayer().StopEffect('fury_403_ciri');
				GetWitcherPlayer().PlayEffectSingle('fury_403_ciri');
				
				GetWitcherPlayer().StopEffect('acs_fury_ciri');
				GetWitcherPlayer().PlayEffectSingle( 'acs_fury_ciri' );

				ACSGetCEntity('acs_sword_trail_2').StopEffect('fury_sword_fx');
				ACSGetCEntity('acs_sword_trail_2').PlayEffectSingle('fury_sword_fx');
			}
			
			switch(ACS_GetWeaponMode())
			{
				case 0:
				if (GetWitcherPlayer().IsWeaponHeld( 'silversword' ) || GetWitcherPlayer().IsWeaponHeld( 'steelsword' ) )
				{
					if ( 
					(GetWitcherPlayer().GetEquippedSign() == ST_Quen 
					&& ACS_Settings_Main_Int('acs_armiger_mode_settings','acs_armiger_quen_sign_weapon', 1) == 0)
					||
					(GetWitcherPlayer().GetEquippedSign() == ST_Aard 
					&& ACS_Settings_Main_Int('acs_armiger_mode_settings','acs_armiger_aard_sign_weapon', 3) == 0)
					||
					(GetWitcherPlayer().GetEquippedSign() == ST_Axii 
					&& ACS_Settings_Main_Int('acs_armiger_mode_settings','acs_armiger_axii_sign_weapon', 2) == 0)
					||
					(GetWitcherPlayer().GetEquippedSign() == ST_Yrden 
					&& ACS_Settings_Main_Int('acs_armiger_mode_settings','acs_armiger_yrden_sign_weapon', 4) == 0)
					||
					( GetWitcherPlayer().GetEquippedSign() == ST_Igni 
					&& ACS_Settings_Main_Int('acs_armiger_mode_settings','acs_armiger_igni_sign_weapon', 0) == 0)				
					)
					{
						if ( GetWitcherPlayer().HasTag('acs_vampire_claws_equipped') )
						{
							ClawDestroy_WITH_EFFECT();
						}
						else if ( GetWitcherPlayer().HasTag('acs_sorc_fists_equipped') )
						{
							SorcFistDestroy();
						}

						DefaultSwitch_2();

						GetWitcherPlayer().AddTag('acs_igni_sword_equipped');
						GetWitcherPlayer().AddTag('acs_igni_secondary_sword_equipped');	
						GetWitcherPlayer().AddTag('acs_igni_sword_effect_played');
						GetWitcherPlayer().AddTag('acs_igni_secondary_sword_effect_played');	
					}
					else
					{
						PrimaryWeaponSwitch();
					}	
				}
				else if 
				(
					GetWitcherPlayer().IsWeaponHeld( 'fist' )
				)
				{
					PrimaryWeaponSwitch();
				}
				break;

				case 1:
				if 
				(
					(ACS_Settings_Main_Int('acs_focus_mode_settings','acs_focus_mode_silver_weapon', 0) == 0 && GetWitcherPlayer().IsWeaponHeld( 'silversword' ) && !GetWitcherPlayer().HasTag('acs_igni_sword_equipped') )
					|| (ACS_Settings_Main_Int('acs_focus_mode_settings','acs_focus_mode_steel_weapon', 0) == 0 && GetWitcherPlayer().IsWeaponHeld( 'steelsword' ) && !GetWitcherPlayer().HasTag('acs_igni_sword_equipped'))
				)
				{
					if ( GetWitcherPlayer().HasTag('acs_vampire_claws_equipped') )
					{
						ClawDestroy_WITH_EFFECT();
					}
					else if ( GetWitcherPlayer().HasTag('acs_sorc_fists_equipped') )
					{
						SorcFistDestroy();
					}

					DefaultSwitch_2();

					GetWitcherPlayer().AddTag('acs_igni_sword_equipped');
					GetWitcherPlayer().AddTag('acs_igni_secondary_sword_equipped');	
					GetWitcherPlayer().AddTag('acs_igni_sword_effect_played');
					GetWitcherPlayer().AddTag('acs_igni_secondary_sword_effect_played');	
				}
				else if
				(
					(ACS_Settings_Main_Int('acs_focus_mode_settings','acs_focus_mode_silver_weapon', 0) == 3 && GetWitcherPlayer().IsWeaponHeld( 'silversword' ) && !GetWitcherPlayer().HasTag('acs_axii_sword_equipped') )
					|| (ACS_Settings_Main_Int('acs_focus_mode_settings','acs_focus_mode_steel_weapon', 0) == 3 && GetWitcherPlayer().IsWeaponHeld( 'steelsword' ) && !GetWitcherPlayer().HasTag('acs_axii_sword_equipped'))
					|| (ACS_Settings_Main_Int('acs_focus_mode_settings','acs_focus_mode_silver_weapon', 0) == 7 && GetWitcherPlayer().IsWeaponHeld( 'silversword' ) && !GetWitcherPlayer().HasTag('acs_aard_sword_equipped') )
					|| (ACS_Settings_Main_Int('acs_focus_mode_settings','acs_focus_mode_steel_weapon', 0) == 7 && GetWitcherPlayer().IsWeaponHeld( 'steelsword' ) && !GetWitcherPlayer().HasTag('acs_aard_sword_equipped'))
					|| (ACS_Settings_Main_Int('acs_focus_mode_settings','acs_focus_mode_silver_weapon', 0) == 5 && GetWitcherPlayer().IsWeaponHeld( 'silversword' ) && !GetWitcherPlayer().HasTag('acs_yrden_sword_equipped') )
					|| (ACS_Settings_Main_Int('acs_focus_mode_settings','acs_focus_mode_steel_weapon', 0) == 5 && GetWitcherPlayer().IsWeaponHeld( 'steelsword' ) && !GetWitcherPlayer().HasTag('acs_yrden_sword_equipped'))
					|| (ACS_Settings_Main_Int('acs_focus_mode_settings','acs_focus_mode_silver_weapon', 0) == 1 && GetWitcherPlayer().IsWeaponHeld( 'silversword' ) && !GetWitcherPlayer().HasTag('acs_quen_sword_equipped') )
					|| (ACS_Settings_Main_Int('acs_focus_mode_settings','acs_focus_mode_steel_weapon', 0) == 1 && GetWitcherPlayer().IsWeaponHeld( 'steelsword' ) && !GetWitcherPlayer().HasTag('acs_quen_sword_equipped'))
					|| (GetWitcherPlayer().IsWeaponHeld( 'fist' ) && !GetWitcherPlayer().HasTag('acs_vampire_claws_equipped') && !GetWitcherPlayer().HasTag('acs_sorc_fists_equipped') )
				)
				{
					PrimaryWeaponSwitch();
				}
				else if  
				(
					(ACS_Settings_Main_Int('acs_focus_mode_settings','acs_focus_mode_silver_weapon', 0) == 4 && GetWitcherPlayer().IsWeaponHeld( 'silversword' ) && !GetWitcherPlayer().HasTag('acs_axii_secondary_sword_equipped') )
					|| (ACS_Settings_Main_Int('acs_focus_mode_settings','acs_focus_mode_steel_weapon', 0) == 4 && GetWitcherPlayer().IsWeaponHeld( 'steelsword' ) && !GetWitcherPlayer().HasTag('acs_axii_secondary_sword_equipped'))
					|| (ACS_Settings_Main_Int('acs_focus_mode_settings','acs_focus_mode_silver_weapon', 0) == 8  && GetWitcherPlayer().IsWeaponHeld( 'silversword' ) && !GetWitcherPlayer().HasTag('acs_aard_secondary_sword_equipped') )
					|| (ACS_Settings_Main_Int('acs_focus_mode_settings','acs_focus_mode_steel_weapon', 0) == 8 && GetWitcherPlayer().IsWeaponHeld( 'steelsword' ) && !GetWitcherPlayer().HasTag('acs_aard_secondary_sword_equipped'))
					|| (ACS_Settings_Main_Int('acs_focus_mode_settings','acs_focus_mode_silver_weapon', 0) == 6  && GetWitcherPlayer().IsWeaponHeld( 'silversword' ) && !GetWitcherPlayer().HasTag('acs_yrden_secondary_sword_equipped') )
					|| (ACS_Settings_Main_Int('acs_focus_mode_settings','acs_focus_mode_steel_weapon', 0) == 6 && GetWitcherPlayer().IsWeaponHeld( 'steelsword' ) && !GetWitcherPlayer().HasTag('acs_yrden_secondary_sword_equipped'))
					|| (ACS_Settings_Main_Int('acs_focus_mode_settings','acs_focus_mode_silver_weapon', 0) == 2 && GetWitcherPlayer().IsWeaponHeld( 'silversword' ) && !GetWitcherPlayer().HasTag('acs_quen_secondary_sword_equipped') )
					|| (ACS_Settings_Main_Int('acs_focus_mode_settings','acs_focus_mode_steel_weapon', 0) == 2 && GetWitcherPlayer().IsWeaponHeld( 'steelsword' ) && !GetWitcherPlayer().HasTag('acs_quen_secondary_sword_equipped'))
				)
				{
					SecondaryWeaponSwitch();
				}
				break;

				case 2:
				if 
				(
					(ACS_Settings_Main_Int('acs_hybrid_mode_settings','acs_hybrid_light_attack', 0) == 0 && GetWitcherPlayer().IsWeaponHeld( 'silversword' ) && !GetWitcherPlayer().HasTag('acs_igni_sword_equipped') )
					|| (ACS_Settings_Main_Int('acs_hybrid_mode_settings','acs_hybrid_light_attack', 0) == 0 && GetWitcherPlayer().IsWeaponHeld( 'steelsword' ) && !GetWitcherPlayer().HasTag('acs_igni_sword_equipped'))
				)
				{
					ACS_WeaponDestroyInit();

					DefaultSwitch_2();
					
					GetWitcherPlayer().AddTag('acs_igni_sword_equipped');
					GetWitcherPlayer().AddTag('acs_igni_secondary_sword_equipped');	
					GetWitcherPlayer().AddTag('acs_igni_sword_effect_played');
					GetWitcherPlayer().AddTag('acs_igni_secondary_sword_effect_played');	
				}
				else if 
				(
					(ACS_Settings_Main_Int('acs_hybrid_mode_settings','acs_hybrid_light_attack', 0) == 2  && GetWitcherPlayer().IsWeaponHeld( 'silversword' ) && !GetWitcherPlayer().HasTag('acs_axii_sword_equipped') )
					|| (ACS_Settings_Main_Int('acs_hybrid_mode_settings','acs_hybrid_light_attack', 0) == 2 && GetWitcherPlayer().IsWeaponHeld( 'steelsword' ) && !GetWitcherPlayer().HasTag('acs_axii_sword_equipped'))
				)
				{
					GetWitcherPlayer().AddTag('ACSHybridEredinWeaponTicket');
					PrimaryWeaponSwitch();
				}
				else if 
				(
					(ACS_Settings_Main_Int('acs_hybrid_mode_settings','acs_hybrid_light_attack', 0) == 3  && GetWitcherPlayer().IsWeaponHeld( 'silversword' ) && !GetWitcherPlayer().HasTag('acs_aard_sword_equipped') )
					|| (ACS_Settings_Main_Int('acs_hybrid_mode_settings','acs_hybrid_light_attack', 0) == 3 && GetWitcherPlayer().IsWeaponHeld( 'steelsword' ) && !GetWitcherPlayer().HasTag('acs_aard_sword_equipped'))
				)
				{
					GetWitcherPlayer().AddTag('ACSHybridClawWeaponTicket');
					PrimaryWeaponSwitch();
				}
				else if 
				(
					(ACS_Settings_Main_Int('acs_hybrid_mode_settings','acs_hybrid_light_attack', 0) == 4 && GetWitcherPlayer().IsWeaponHeld( 'silversword' ) && !GetWitcherPlayer().HasTag('acs_yrden_sword_equipped') )
					|| (ACS_Settings_Main_Int('acs_hybrid_mode_settings','acs_hybrid_light_attack', 0) == 4 && GetWitcherPlayer().IsWeaponHeld( 'steelsword' ) && !GetWitcherPlayer().HasTag('acs_yrden_sword_equipped'))
				)
				{
					GetWitcherPlayer().AddTag('ACSHybridImlerithWeaponTicket');
					PrimaryWeaponSwitch();
				}
				else if 
				(
					(ACS_Settings_Main_Int('acs_hybrid_mode_settings','acs_hybrid_light_attack', 0) == 1 && GetWitcherPlayer().IsWeaponHeld( 'silversword' ) && !GetWitcherPlayer().HasTag('acs_quen_sword_equipped') )
					|| (ACS_Settings_Main_Int('acs_hybrid_mode_settings','acs_hybrid_light_attack', 0) == 1 && GetWitcherPlayer().IsWeaponHeld( 'steelsword' ) && !GetWitcherPlayer().HasTag('acs_quen_sword_equipped'))
				)
				{
					GetWitcherPlayer().AddTag('ACSHybridOlgierdWeaponTicket');
					PrimaryWeaponSwitch();
				}
				else if  
				(
					(ACS_Settings_Main_Int('acs_hybrid_mode_settings','acs_hybrid_light_attack', 0) == 6 && GetWitcherPlayer().IsWeaponHeld( 'silversword' ) && !GetWitcherPlayer().HasTag('acs_axii_secondary_sword_equipped') )
					|| (ACS_Settings_Main_Int('acs_hybrid_mode_settings','acs_hybrid_light_attack', 0) == 6 && GetWitcherPlayer().IsWeaponHeld( 'steelsword' ) && !GetWitcherPlayer().HasTag('acs_axii_secondary_sword_equipped'))
				)
				{
					GetWitcherPlayer().AddTag('ACSHybridGregWeaponTicket');
					SecondaryWeaponSwitch();
				}
				else if  
				(
					(ACS_Settings_Main_Int('acs_hybrid_mode_settings','acs_hybrid_light_attack', 0) == 7  && GetWitcherPlayer().IsWeaponHeld( 'silversword' ) && !GetWitcherPlayer().HasTag('acs_aard_secondary_sword_equipped') )
					|| (ACS_Settings_Main_Int('acs_hybrid_mode_settings','acs_hybrid_light_attack', 0) == 7 && GetWitcherPlayer().IsWeaponHeld( 'steelsword' ) && !GetWitcherPlayer().HasTag('acs_aard_secondary_sword_equipped'))
				)
				{
					GetWitcherPlayer().AddTag('ACSHybridAxeWeaponTicket');
					SecondaryWeaponSwitch();
				}
				else if  
				(
					(ACS_Settings_Main_Int('acs_hybrid_mode_settings','acs_hybrid_light_attack', 0) == 8  && GetWitcherPlayer().IsWeaponHeld( 'silversword' ) && !GetWitcherPlayer().HasTag('acs_yrden_secondary_sword_equipped') )
					|| (ACS_Settings_Main_Int('acs_hybrid_mode_settings','acs_hybrid_light_attack', 0) == 8 && GetWitcherPlayer().IsWeaponHeld( 'steelsword' ) && !GetWitcherPlayer().HasTag('acs_yrden_secondary_sword_equipped'))
				)
				{
					GetWitcherPlayer().AddTag('ACSHybridGiantWeaponTicket');
					SecondaryWeaponSwitch();
				}
				else if  
				(
					(ACS_Settings_Main_Int('acs_hybrid_mode_settings','acs_hybrid_light_attack', 0) == 5 && GetWitcherPlayer().IsWeaponHeld( 'silversword' ) && !GetWitcherPlayer().HasTag('acs_quen_secondary_sword_equipped') )
					|| (ACS_Settings_Main_Int('acs_hybrid_mode_settings','acs_hybrid_light_attack', 0) == 5 && GetWitcherPlayer().IsWeaponHeld( 'steelsword' ) && !GetWitcherPlayer().HasTag('acs_quen_secondary_sword_equipped'))
				)
				{
					GetWitcherPlayer().AddTag('ACSHybridSpearWeaponTicket');
					SecondaryWeaponSwitch();
				}
				else if 
				(
					GetWitcherPlayer().IsWeaponHeld( 'fist' )
				)
				{
					PrimaryWeaponSwitch();
				}
				break;

				case 3:
				if 
				(
					( ACS_GetItem_Sword_IsEquipped('shield_sword_silver', 'silver') && GetWitcherPlayer().IsWeaponHeld( 'silversword' ) && !GetWitcherPlayer().HasTag('acs_axii_sword_equipped') )
					|| ( ACS_GetItem_Sword_IsEquipped('shield_sword_steel', 'steel') && GetWitcherPlayer().IsWeaponHeld( 'steelsword' ) && !GetWitcherPlayer().HasTag('acs_axii_sword_equipped'))
					|| ( ACS_GetItem_Sword_IsEquipped('claws_silver', 'silver') && GetWitcherPlayer().IsWeaponHeld( 'silversword' ) && !GetWitcherPlayer().HasTag('acs_aard_sword_equipped') )
					|| ( ACS_GetItem_Sword_IsEquipped('claws_steel', 'steel') && GetWitcherPlayer().IsWeaponHeld( 'steelsword' ) && !GetWitcherPlayer().HasTag('acs_aard_sword_equipped'))
					|| ( ACS_GetItem_Sword_IsEquipped('imlerith_moveset_silver', 'silver') && GetWitcherPlayer().IsWeaponHeld( 'silversword' ) && !GetWitcherPlayer().HasTag('acs_yrden_sword_equipped') )
					|| ( ACS_GetItem_Sword_IsEquipped('imlerith_moveset_steel', 'steel') && GetWitcherPlayer().IsWeaponHeld( 'steelsword' ) && !GetWitcherPlayer().HasTag('acs_yrden_sword_equipped'))
					|| ( ACS_GetItem_Sword_IsEquipped('caretaker_shovel_steel', 'steel') && GetWitcherPlayer().IsWeaponHeld( 'steelsword' ) && !GetWitcherPlayer().HasTag('acs_yrden_sword_equipped'))
					|| ( ACS_GetItem_Sword_IsEquipped('imlerith_steel', 'steel') && GetWitcherPlayer().IsWeaponHeld( 'steelsword' ) && !GetWitcherPlayer().HasTag('acs_yrden_sword_equipped'))
					|| ( thePlayer.GetInventory().ItemHasTag( thePlayer.GetInventory().GetCurrentlyHeldSword(), 'acsmagestaff' ) && GetWitcherPlayer().IsWeaponHeld( 'steelsword' ) && !GetWitcherPlayer().HasTag('acs_yrden_sword_equipped') )
					|| ( ACS_GetItem_Sword_IsEquipped('olgierd_silver', 'silver') && GetWitcherPlayer().IsWeaponHeld( 'silversword' ) && !GetWitcherPlayer().HasTag('acs_quen_sword_equipped') )
					|| ( ACS_GetItem_Sword_IsEquipped('olgierd_steel', 'steel') && GetWitcherPlayer().IsWeaponHeld( 'steelsword' ) && !GetWitcherPlayer().HasTag('acs_quen_sword_equipped'))
					|| ( GetWitcherPlayer().IsWeaponHeld( 'fist' ) && !GetWitcherPlayer().HasTag('acs_vampire_claws_equipped') && !GetWitcherPlayer().HasTag('acs_sorc_fists_equipped') )
				)
				{
					PrimaryWeaponSwitch();
				}
				else if  
				(
					( ACS_GetItem_Sword_IsEquipped('greg_silver', 'silver') && GetWitcherPlayer().IsWeaponHeld( 'silversword' ) && !GetWitcherPlayer().HasTag('acs_axii_secondary_sword_equipped') )
					|| ( ACS_GetItem_Sword_IsEquipped('greg_steel', 'steel') && GetWitcherPlayer().IsWeaponHeld( 'steelsword' ) && !GetWitcherPlayer().HasTag('acs_axii_secondary_sword_equipped'))
					|| ( ACS_GetItem_Sword_IsEquipped('axe_silver', 'silver') && GetWitcherPlayer().IsWeaponHeld( 'silversword' ) && !GetWitcherPlayer().HasTag('acs_aard_secondary_sword_equipped') )
					|| ( ACS_GetItem_Sword_IsEquipped('axe_steel', 'steel') && GetWitcherPlayer().IsWeaponHeld( 'steelsword' ) && !GetWitcherPlayer().HasTag('acs_aard_secondary_sword_equipped'))
					|| ( ACS_GetItem_Sword_IsEquipped('nithral_steel', 'steel') && GetWitcherPlayer().IsWeaponHeld( 'steelsword' ) && !GetWitcherPlayer().HasTag('acs_aard_secondary_sword_equipped'))
					|| ( ACS_GetItem_Sword_IsEquipped('hammer_silver', 'silver') && GetWitcherPlayer().IsWeaponHeld( 'silversword' ) && !GetWitcherPlayer().HasTag('acs_yrden_secondary_sword_equipped') )
					|| ( ACS_GetItem_Sword_IsEquipped('hammer_steel', 'steel') && GetWitcherPlayer().IsWeaponHeld( 'steelsword' ) && !GetWitcherPlayer().HasTag('acs_yrden_secondary_sword_equipped'))
					|| ( ACS_GetItem_Sword_IsEquipped('spear_silver', 'silver') && GetWitcherPlayer().IsWeaponHeld( 'silversword' ) && !GetWitcherPlayer().HasTag('acs_quen_secondary_sword_equipped') )
					|| ( ACS_GetItem_Sword_IsEquipped('spear_steel', 'steel') && GetWitcherPlayer().IsWeaponHeld( 'steelsword' ) && !GetWitcherPlayer().HasTag('acs_quen_secondary_sword_equipped'))
					|| ( ACS_GetItem_Sword_IsEquipped('katana_silver', 'silver') && GetWitcherPlayer().IsWeaponHeld( 'silversword' ) && !GetWitcherPlayer().HasTag('acs_axii_secondary_sword_equipped') )
					|| ( ACS_GetItem_Sword_IsEquipped('katana_steel', 'steel') && GetWitcherPlayer().IsWeaponHeld( 'steelsword' ) && !GetWitcherPlayer().HasTag('acs_axii_secondary_sword_equipped') )
					|| ( ACS_GetItem_Sword_IsEquipped('jingubang_steel', 'steel') || ACS_GetItem_Sword_IsEquipped('jingubang_silver', 'silver') && GetWitcherPlayer().IsWeaponHeld( 'silversword' ) && !GetWitcherPlayer().HasTag('acs_quen_secondary_sword_equipped') )
					|| ( ACS_GetItem_Sword_IsEquipped('jingubang_steel', 'steel') || ACS_GetItem_Sword_IsEquipped('jingubang_silver', 'silver') && GetWitcherPlayer().IsWeaponHeld( 'steelsword' ) && !GetWitcherPlayer().HasTag('acs_quen_secondary_sword_equipped') )
				)
				{
					SecondaryWeaponSwitch();
				}
				else
				{
					DefaultSwitch();
				}
				break;

				default:
				if 
				(
					( ACS_GetItem_Sword_IsEquipped('shield_sword_silver', 'silver') && GetWitcherPlayer().IsWeaponHeld( 'silversword' ) && !GetWitcherPlayer().HasTag('acs_axii_sword_equipped') )
					|| ( ACS_GetItem_Sword_IsEquipped('shield_sword_steel', 'steel') && GetWitcherPlayer().IsWeaponHeld( 'steelsword' ) && !GetWitcherPlayer().HasTag('acs_axii_sword_equipped'))
					|| ( ACS_GetItem_Sword_IsEquipped('claws_silver', 'silver') && GetWitcherPlayer().IsWeaponHeld( 'silversword' ) && !GetWitcherPlayer().HasTag('acs_aard_sword_equipped') )
					|| ( ACS_GetItem_Sword_IsEquipped('claws_steel', 'steel') && GetWitcherPlayer().IsWeaponHeld( 'steelsword' ) && !GetWitcherPlayer().HasTag('acs_aard_sword_equipped'))
					|| ( ACS_GetItem_Sword_IsEquipped('imlerith_moveset_silver', 'silver') && GetWitcherPlayer().IsWeaponHeld( 'silversword' ) && !GetWitcherPlayer().HasTag('acs_yrden_sword_equipped') )
					|| ( ACS_GetItem_Sword_IsEquipped('imlerith_moveset_steel', 'steel') && GetWitcherPlayer().IsWeaponHeld( 'steelsword' ) && !GetWitcherPlayer().HasTag('acs_yrden_sword_equipped'))
					|| ( ACS_GetItem_Sword_IsEquipped('caretaker_shovel_steel', 'steel') && GetWitcherPlayer().IsWeaponHeld( 'steelsword' ) && !GetWitcherPlayer().HasTag('acs_yrden_sword_equipped'))
					|| ( ACS_GetItem_Sword_IsEquipped('imlerith_steel', 'steel') && GetWitcherPlayer().IsWeaponHeld( 'steelsword' ) && !GetWitcherPlayer().HasTag('acs_yrden_sword_equipped'))
					|| ( thePlayer.GetInventory().ItemHasTag( thePlayer.GetInventory().GetCurrentlyHeldSword(), 'acsmagestaff' ) && GetWitcherPlayer().IsWeaponHeld( 'steelsword' ) && !GetWitcherPlayer().HasTag('acs_yrden_sword_equipped') )

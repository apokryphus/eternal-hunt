	///////////////////////////////////////////////////////////////////////////////////

	event OnSpawned( spawnData : SEntitySpawnData )
	{
		var hud 															: CR4ScriptedHud;
		var onelinersModule 												: CR4HudModuleOneliners;
		var resource 														: CJournalResource;
		var entryBase 														: CJournalBase;
		var boneRotation, horse_rot											: EulerAngles;
		var bonePosition													: Vector;
		var inGameConfigWrapper												: CInGameConfigWrapper;
		var newValue 														: bool;

		if(FactsQuerySum("ACS_Eternal_Hunt_Active") <= 0)
		{
			FactsAdd("ACS_Eternal_Hunt_Active", 1, -1);
		}

		theSound.SoundEvent("music_clair_obscur_e33_stop_acs");

		theSound.SoundEvent("music_metal_mix_stop_acs_01");

		theSound.SoundEvent("music_witcher_1_stop_acs_01");

		theSound.SoundEvent("music_witcher_2_stop_acs_01");

		theSound.SoundEvent("music_witcher_3_stop_acs_01");

		theSound.SoundEvent("music_gwent_stop_acs");

		((CActor)thePlayer).SetBehaviorMimicVariable( 'gameplayMimicsMode', (float)(int)PGMM_Combat );

		GetACSStorage().ResetOnelinerIDs();

		//thePlayer.GetBoneWorldPositionAndRotationByIndex( thePlayer.GetBoneIndex( 'torso3' ), bonePosition, boneRotation );
		//this.CreateAttachmentAtBoneWS( thePlayer, 'torso3', bonePosition, boneRotation );

		thePlayer.ResumeStaminaRegen( 'SignCast' );

		GetWitcherPlayer().AddAndEquipInfiniteBolt(true);

		FactsAndTagsReset();

		AddTimer('ACS_Init_Delay', 0.1 , true);

		Custom_Env_Switch('dof', true);

		Custom_Env_Switch('flare', true);

		Custom_Env_Switch('red_water', true);

		Custom_Env_Switch('red_grass', true);

		AddTimer('ACS_Startup_Delay', 1 , false);
		
		vACS_Startup_Entity_Spawns = new cACS_Startup_Entity_Spawns in this;

		vACS_Startup_Entity_Spawns.Startup_Entities_Engage();

		register_extra_inputs();

		resource = (CJournalResource)LoadResource( 

		"dlc\dlc_acs\data\gameplay\journal\quests\acs_untracked_quest.journal"
		
		, true );

		if ( resource )
		{
			entryBase = resource.GetEntry();

			if ( entryBase )
			{
				theGame.GetJournalManager().ActivateEntry( entryBase, JS_Active, false );
				//theGame.GetJournalManager().SetTrackedQuest( entryBase );
			}
		}

		horse_rot = (thePlayer.GetHorseWithInventory()).GetWorldRotation();

		horse_rot.Pitch = 0;
		horse_rot.Roll = 0;

		(thePlayer.GetHorseWithInventory()).TeleportWithRotation((thePlayer.GetHorseWithInventory()).GetWorldPosition(), horse_rot);

		//ACS_MonsterHunt = new ACSMonsterHuntChallenge in this;

		//ACS_MonsterHunt.init();

		if (ACS_Settings_Main_Bool('acs_movement_main_settings','acs_walking_by_default_enabled', true))
		{
			currspeed = 0;
			thePlayer.SetWalkToggle( true );	
		}
		else
		{
			currspeed = 2;
			thePlayer.SetWalkToggle( false );
		}

		if (!theGame.IsUberMovementEnabled())
		{
			theGame.EnableUberMovement( true );
		}

		if (ACS_Settings_Main_Float('acs_hud_settings_main','acs_hud_elements_despawn_delay', 7) < 9000 )
		{
			theGame.GetInGameConfigWrapper().SetVarValue('Hud', 'Minimap2Module', "false");

			theGame.GetInGameConfigWrapper().SetVarValue('Hud', 'QuestsModule', "false");

			theGame.GetInGameConfigWrapper().SetVarValue('Hud', 'WolfMedalion', "false");
		}

		theGame.GetInGameConfigWrapper().SetVarValue('Gameplay', 'HudTutorialEnabled', "false");
		
		theGame.GetInGameConfigWrapper().SetVarValue('Hud', 'OnelinersModule', "true");

		hud = (CR4ScriptedHud)theGame.GetHud();

		inGameConfigWrapper = (CInGameConfigWrapper)theGame.GetInGameConfigWrapper();

		newValue = inGameConfigWrapper.GetVarValue( 'Hud', 'HudVisibility' );
	
		if ( hud && newValue)
		{
			hud.ForceShow( true, HVS_System );

			Enable_Hud_Exception_Flag(true);
		}

		if (hud)
		{
			onelinersModule = (CR4HudModuleOneliners)hud.GetHudModule( "OnelinersModule" );
	
			onelinersModule.SetEnabled(true);

			hud.UpdateHUD();
		}
	
		menuChanged = true;

		RemoveTimer('Menu_Changed_Reset');
		AddTimer('Menu_Changed_Reset', 1 , false);

		thePlayer.GetWeaponHolster().OnForcedHolsterWeapon();

		if (FactsQuerySum("ACS_TESTING") > 0)
		{
			this.PushState('ACS_Facts');
		}

		if( 
		FactsQuerySum("ACS_Global_Fast_Travel_Initiated") > 0
		)
		{
			Custom_Env_Switch('global_fast_travel', false);

			FactsRemove("ACS_Global_Fast_Travel_Initiated");
		}

		if (!thePlayer.inv.HasItem('ACS_Unequip_Dummy_Gloves'))
		{
			thePlayer.inv.AddAnItem('ACS_Unequip_Dummy_Gloves', 1);
		}

		if (!thePlayer.inv.HasItem('ACS_Unequip_Dummy_Pants'))
		{
			thePlayer.inv.AddAnItem('ACS_Unequip_Dummy_Pants', 1);
		}

		if (!thePlayer.inv.HasItem('ACS_Unequip_Dummy_Boots'))
		{
			thePlayer.inv.AddAnItem('ACS_Unequip_Dummy_Boots', 1);
		}

		if (!thePlayer.inv.HasItem('ACS_Unequip_Dummy_Armor'))
		{
			thePlayer.inv.AddAnItem('ACS_Unequip_Dummy_Armor', 1);
		}

		this.PushState('ACS_BARADDUR');
	}

	event OnDestroyed() 
	{
		var hud 															: CR4ScriptedHud;
		var moduleMinimap, moduleQuest 										: CR4HudModuleBase;
		var hudWolfHeadModule 												: CR4HudModuleWolfHead;	

		Remove3DHUDMarkers();

		if(FactsQuerySum("ACS_Eternal_Hunt_Active") > 0)
		{
			FactsRemove("ACS_Eternal_Hunt_Active");
		}

		theGame.GetInGameConfigWrapper().SetVarValue('Hud', 'Minimap2Module', "true");

		theGame.GetInGameConfigWrapper().SetVarValue('Hud', 'QuestsModule', "true");

		theGame.GetInGameConfigWrapper().SetVarValue('Hud', 'WolfMedalion', "true");

		hud = (CR4ScriptedHud)theGame.GetHud();

		moduleMinimap = (CR4HudModuleBase)hud.GetHudModule("Minimap2Module");

		moduleMinimap.SetEnabled(true);

		moduleQuest = (CR4HudModuleBase)hud.GetHudModule("QuestsModule");

		moduleQuest.SetEnabled(true);

		hudWolfHeadModule = (CR4HudModuleWolfHead)hud.GetHudModule("WolfHeadModule");

		hudWolfHeadModule.SetEnabled(true);

		hud.UpdateHUD();

		RemoveTimers();
	}

	var vACS_Monster_Spawner : cACS_Monster_Spawner;

	var vACS_IDD : cACS_IDD;

	public timer function ACS_Init_Delay ( dt : float, id : int)
	{
		var crossbowIDs 						: array<SItemUniqueId>;
		var crossbowID 							: SItemUniqueId;
		var hud 								: CR4ScriptedHud;
		var timeLapseModule 					: CR4HudModuleTimeLapse;

		if ( !theGame.IsPaused() 
		&& !theGame.IsDialogOrCutscenePlaying()
		&& !theGame.GetPhotomodeEnabled() 
		&& !thePlayer.IsInCutsceneIntro() 
		&& !theGame.IsCurrentlyPlayingNonGameplayScene()
		&& !theGame.IsFading()
		&& !theGame.IsBlackscreen()
		)
		{
			if (!ACS_Settings_Main_Bool('acs_main_settings','acs_init', false)) 
			{
				ACS_InitializeSettings();
				ACS_Tutorial_Popup_Display(2117035665, 2117035666);
			}
			else
			{
				theGame.GetInGameConfigWrapper().SetVarValue('acs_main_settings', 'acs_version_control', ACS_GetVersion());
			}

			MimicReset();

			if ( thePlayer.IsActionAllowed(EIAB_DrawWeapon) 
			&& thePlayer.GetBIsInputAllowed() 
			&& thePlayer.GetWeaponHolster().IsMeleeWeaponReady() 
			)
			{
				if ( thePlayer.IsWeaponHeld('steelsword') )
				{
					thePlayer.PushCombatActionOnBuffer( EBAT_Draw_Steel, BS_Pressed );

					if ( thePlayer.GetBIsCombatActionAllowed() )
					thePlayer.ProcessCombatActionBuffer();
				}
				else if ( thePlayer.IsWeaponHeld('silversword') )
				{
					thePlayer.PushCombatActionOnBuffer( EBAT_Draw_Silver, BS_Pressed );

					if ( thePlayer.GetBIsCombatActionAllowed() )
					thePlayer.ProcessCombatActionBuffer();
				}
			}

			if (!thePlayer.IsSwimming()
			&& !thePlayer.IsUsingHorse()
			&& !thePlayer.IsUsingVehicle()
			&& thePlayer.IsAlive()
			)
			{
				vBehSwitch = new cBehSwitch in this;

				vBehSwitch.BehSwitch_Engage_2();
			}

			vACS_Monster_Spawner = new cACS_Monster_Spawner in this;
			
			vACS_Monster_Spawner.ACS_Monster_Static_Spawner();

			if (ACS_Settings_Main_Bool('acs_visual_main_settings','acs_idd_enabled', false))
			{
				vACS_IDD = new cACS_IDD in this;

				vACS_IDD.IDD_Engage();
			}

			if (theGame.GetWorld().GetDepotPath() == "levels\wyzima_castle\wyzima_castle.w2w"
			&& FactsQuerySum("q002_met_emhyr") <= 0
			)
			{

			}
			else
			{
				if (!thePlayer.inv.HasItem('acs_wisp')
				&& !GetWitcherPlayer().GetHorseManager().GetInventoryComponent().HasItem( 'acs_wisp' )
				)
				{
					thePlayer.inv.AddAnItem('acs_wisp', 1);
				}

				if (!thePlayer.inv.HasItem('acs_trophy_item')
				&& !GetWitcherPlayer().GetHorseManager().GetInventoryComponent().HasItem( 'acs_trophy_item' )
				)
				{
					thePlayer.inv.AddAnItem('acs_trophy_item', 1);
				}

				if (!thePlayer.inv.HasItem('ACS_Wolf_Crossbow')
				&& !GetWitcherPlayer().GetHorseManager().GetInventoryComponent().HasItem( 'ACS_Wolf_Crossbow' )
				&& FactsQuerySum("q002_killed_griffin") > 0
				)
				{
					thePlayer.inv.AddAnItem('ACS_Wolf_Crossbow', 1);
				}

				if (!thePlayer.inv.HasItem('acs_killcount_book')
				&& !GetWitcherPlayer().GetHorseManager().GetInventoryComponent().HasItem( 'acs_killcount_book' )
				)
				{
					thePlayer.inv.AddAnItem('acs_killcount_book', 1);
				}

				if (!thePlayer.inv.HasItem('acs_wooden_flute_item')
				&& !GetWitcherPlayer().GetHorseManager().GetInventoryComponent().HasItem( 'acs_wooden_flute_item' )
				)
				{
					thePlayer.inv.AddAnItem('acs_wooden_flute_item', 1);
				}

				if (!thePlayer.inv.HasItem('acs_lute_item')
				&& !GetWitcherPlayer().GetHorseManager().GetInventoryComponent().HasItem( 'acs_lute_item' )
				)
				{
					thePlayer.inv.AddAnItem('acs_lute_item', 1);
				}

				if (!thePlayer.inv.HasItem('acs_pipe_item')
				&& !GetWitcherPlayer().GetHorseManager().GetInventoryComponent().HasItem( 'acs_pipe_item' )
				)
				{
					thePlayer.inv.AddAnItem('acs_pipe_item', 1);
				}

				if (!thePlayer.inv.HasItem('acs_shroud_item')
				&& !GetWitcherPlayer().GetHorseManager().GetInventoryComponent().HasItem( 'acs_shroud_item' )
				)
				{
					thePlayer.inv.AddAnItem('acs_shroud_item', 1);
				}

				if (!thePlayer.inv.HasItem('acs_hood_item')
				&& !GetWitcherPlayer().GetHorseManager().GetInventoryComponent().HasItem( 'acs_hood_item' )
				)
				{
					thePlayer.inv.AddAnItem('acs_hood_item', 1);
				}

				if (!thePlayer.inv.HasItem('acs_dual_wield_item')
				&& !GetWitcherPlayer().GetHorseManager().GetInventoryComponent().HasItem( 'acs_dual_wield_item' )
				)
				{
					thePlayer.inv.AddAnItem('acs_dual_wield_item', 1);
				}

				if (!thePlayer.inv.HasItem('acs_spear_transform_item')
				&& !GetWitcherPlayer().GetHorseManager().GetInventoryComponent().HasItem( 'acs_spear_transform_item' )
				)
				{
					thePlayer.inv.AddAnItem('acs_spear_transform_item', 1);
				}

				if (!thePlayer.inv.HasItem('acs_mask_item')
				&& !GetWitcherPlayer().GetHorseManager().GetInventoryComponent().HasItem( 'acs_mask_item' )
				)
				{
					thePlayer.inv.AddAnItem('acs_mask_item', 1);
				}

				if (!thePlayer.inv.HasItem('acs_cbs_item')
				&& !GetWitcherPlayer().GetHorseManager().GetInventoryComponent().HasItem( 'acs_cbs_item' )
				)
				{
					thePlayer.inv.AddAnItem('acs_cbs_item', 1);
				}

				if (!thePlayer.inv.HasItem('acs_knife_thrower_item')
				&& !GetWitcherPlayer().GetHorseManager().GetInventoryComponent().HasItem( 'acs_knife_thrower_item' )
				)
				{
					thePlayer.inv.AddAnItem('acs_knife_thrower_item', 1);
				}

				if (!thePlayer.inv.HasItem('acs_secondary_weapon_thrower_item')
				&& !GetWitcherPlayer().GetHorseManager().GetInventoryComponent().HasItem( 'acs_secondary_weapon_thrower_item' )
				)
				{
					thePlayer.inv.AddAnItem('acs_secondary_weapon_thrower_item', 1);
				}

				if (!thePlayer.inv.HasItem('ACS_Azkar')
				&& !GetWitcherPlayer().GetHorseManager().GetInventoryComponent().HasItem( 'ACS_Azkar' )
				)
				{
					thePlayer.inv.AddAnItem('ACS_Azkar', 1);
				}

				if (!thePlayer.inv.HasItem('acs_horse_oil_lamp')
				&& !GetWitcherPlayer().GetHorseManager().GetInventoryComponent().HasItem( 'acs_horse_oil_lamp' )
				)
				{
					thePlayer.inv.AddAnItem('acs_horse_oil_lamp', 1);
				}

				if (FactsQuerySum("q002_talked_to_yennefer") > 0 
				|| FactsQuerySum("wmh_scene_introduction") > 0
				)
				{
					if (!thePlayer.inv.HasItem('acs_horse_teleport_item')
					&& !GetWitcherPlayer().GetHorseManager().GetInventoryComponent().HasItem( 'acs_horse_teleport_item' )
					)
					{
						thePlayer.inv.AddAnItem('acs_horse_teleport_item', 1);
					}
				}


				if ( FactsQuerySum("q603_get_in_man_done") > 0 )
				{
					if (!thePlayer.inv.HasItem('acs_grapple_gun')
					&& !GetWitcherPlayer().GetHorseManager().GetInventoryComponent().HasItem( 'acs_grapple_gun' )
					)
					{
						thePlayer.inv.AddAnItem('acs_grapple_gun', 1);
					}

					if (!thePlayer.inv.HasItem('acs_grapple_bolt')
					&& !GetWitcherPlayer().GetHorseManager().GetInventoryComponent().HasItem( 'acs_grapple_gun' )
					)
					{
						thePlayer.inv.AddAnItem('acs_grapple_bolt', 1);
					}
				}

				if(FactsQuerySum("ACS_Shades_Keys_Added") <= 0)
				{
					ACS_Add_Shades_Keys();

					FactsAdd("ACS_Shades_Keys_Added", 1, -1);
				}

				if( thePlayer.inv.HasItem( 'ACS_Wolf_Crossbow' ))
				{
					crossbowIDs.Clear();
					crossbowIDs = thePlayer.inv.GetItemsIds('ACS_Wolf_Crossbow');
					crossbowID = crossbowIDs[0];
					thePlayer.GetInventory().RemoveItemTag( crossbowID, 'NoShow' );
				}

				if( thePlayer.inv.HasItem( 'ACS_Azkar' ))
				{
					crossbowIDs.Clear();
					crossbowIDs = thePlayer.inv.GetItemsIds('ACS_Azkar');
					crossbowID = crossbowIDs[0];
					thePlayer.GetInventory().RemoveItemTag( crossbowID, 'NoShow' );
				}

				if( thePlayer.inv.HasItem( 'acs_grapple_gun' ))
				{
					crossbowIDs.Clear();
					crossbowIDs = thePlayer.inv.GetItemsIds('acs_grapple_gun');
					crossbowID = crossbowIDs[0];
					thePlayer.GetInventory().RemoveItemTag( crossbowID, 'NoShow' );
				}
			}

			hud = (CR4ScriptedHud)theGame.GetHud();
			
			if( hud )
			{
				timeLapseModule = (CR4HudModuleTimeLapse)hud.GetHudModule("TimeLapseModule");

				if ( timeLapseModule )
				{
					timeLapseModule.SetTimeLapseMessageTest( GetLocStringById(2117035002), true );
				}
			}


			RemoveTimer('ACS_Init_Delay');
		}
	}


			thePlayer.SoundEvent(vamp_sound_names[RandRange(vamp_sound_names.Size())]);
		}
	}

	function VampVoiceEffects_Monster()
	{
		if (ACS_Armor_Set_Check('acs_armor', false))
		{
			return;
		}

		vamp_sound_names.Clear();
		vamp_sound_names.PushBack("monster_dettlaff_monster_voice_taunt_claws");
		vamp_sound_names.PushBack("monster_dettlaff_monster_voice_effort_big");
		vamp_sound_names.PushBack("monster_dettlaff_monster_voice_effort_big_short");
		vamp_sound_names.PushBack("monster_dettlaff_monster_voice_roar");
		vamp_sound_names.PushBack("monster_dettlaff_monster_voice_heavy_charge");

		if (RandF() < 0.5)
		{
			thePlayer.SoundEvent(vamp_sound_names[RandRange(vamp_sound_names.Size())]);
		}
	}
	
	
	
	function Remove_On_Hit_Tags()
	{
		var actors																: array<CActor>;
		var i, j 																: int;
		var marks 																: array< CEntity >;

		if(ACS_GetWeaponMode() != 0)
		{
			return;
		}

		actors.Clear();
		
		theGame.GetActorsByTag( 'acs_aard_light_attack_mark', actors );

		if (actors.Size() > 0)
		{
			if( actors.Size() > 0 )
			{
				for( i = 0; i < actors.Size(); i += 1 )
				{
					actors[i].RemoveTag('acs_aard_light_attack_mark');
				}
			}
		}

		////////////////////////////////////////////////////////////////////////////

		actors.Clear();
		
		theGame.GetActorsByTag( 'acs_aard_heavy_attack_mark', actors );

		if (actors.Size() > 0)
		{
			if( actors.Size() > 0 )
			{
				for( i = 0; i < actors.Size(); i += 1 )
				{
					actors[i].RemoveTag('acs_aard_heavy_attack_mark');
				}
			}
		}

		////////////////////////////////////////////////////////////////////////////

		actors.Clear();
		
		theGame.GetActorsByTag( 'acs_axii_light_attack_mark', actors );

		if (actors.Size() > 0)
		{
			if( actors.Size() > 0 )
			{
				for( i = 0; i < actors.Size(); i += 1 )
				{
					actors[i].RemoveTag('acs_axii_light_attack_mark');
				}
			}
		}

		////////////////////////////////////////////////////////////////////////////

		actors.Clear();
		
		theGame.GetActorsByTag( 'acs_axii_heavy_attack_mark', actors );

		if (actors.Size() > 0)
		{
			if( actors.Size() > 0 )
			{
				for( i = 0; i < actors.Size(); i += 1 )
				{
					actors[i].RemoveTag('acs_axii_heavy_attack_mark');
				}
			}
		}

		////////////////////////////////////////////////////////////////////////////

		actors.Clear();
		
		theGame.GetActorsByTag( 'acs_yrden_light_attack_mark', actors );

		if (actors.Size() > 0)
		{
			if( actors.Size() > 0 )
			{
				for( i = 0; i < actors.Size(); i += 1 )
				{
					actors[i].RemoveTag('acs_yrden_light_attack_mark');
				}
			}
		}

		////////////////////////////////////////////////////////////////////////////

		actors.Clear();
		
		theGame.GetActorsByTag( 'acs_yrden_heavy_attack_mark', actors );

		if (actors.Size() > 0)
		{
			if( actors.Size() > 0 )
			{
				for( i = 0; i < actors.Size(); i += 1 )
				{
					actors[i].RemoveTag('acs_yrden_heavy_attack_mark');
				}
			}
		}

		////////////////////////////////////////////////////////////////////////////

		actors.Clear();
		
		theGame.GetActorsByTag( 'acs_quen_light_attack_mark', actors );

		if (actors.Size() > 0)
		{
			if( actors.Size() > 0 )
			{
				for( i = 0; i < actors.Size(); i += 1 )
				{
					actors[i].RemoveTag('acs_quen_light_attack_mark');
				}
			}
		}

		////////////////////////////////////////////////////////////////////////////

		actors.Clear();
		
		theGame.GetActorsByTag( 'acs_quen_heavy_attack_mark', actors );

		if (actors.Size() > 0)
		{
			if( actors.Size() > 0 )
			{
				for( i = 0; i < actors.Size(); i += 1 )
				{
					actors[i].RemoveTag('acs_quen_heavy_attack_mark');
				}
			}
		}

		////////////////////////////////////////////////////////////////////////////

		actors.Clear();
		
		theGame.GetActorsByTag( 'acs_igni_light_attack_mark', actors );

		if (actors.Size() > 0)
		{
			if( actors.Size() > 0 )
			{
				for( i = 0; i < actors.Size(); i += 1 )
				{
					actors[i].RemoveTag('acs_igni_light_attack_mark');
				}
			}
		}

		////////////////////////////////////////////////////////////////////////////

		actors.Clear();
		
		theGame.GetActorsByTag( 'acs_igni_heavy_attack_mark', actors );

		if (actors.Size() > 0)
		{
			if( actors.Size() > 0 )
			{
				for( i = 0; i < actors.Size(); i += 1 )
				{
					actors[i].RemoveTag('acs_igni_heavy_attack_mark');
				}
			}
		}

		////////////////////////////////////////////////////////////////////////////
		

		marks.Clear();
			
		theGame.GetEntitiesByTag( 'ACS_Elemental_Combo_System_Mark', marks );

		if (marks.Size() <= 0)
		{
			return;
		}
	
		for( j=0; j<marks.Size(); j+=1 )
		{	
			mark = (CEntity)marks[j];	
			mark.BreakAttachment();
			mark.Destroy();
		}
	}


						if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	

						if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1.5  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier( 1.75 ); }		

						RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5  , false);	

						PlayerPlayAnimation( 'man_npc_sword_2hand_attack_l_up_1_dw_ACS');

						combo_counter_damage += 1;

						combo_counter_geralt_light_attack += 1;
						break;

						case 11:

						thePlayer.RaiseEvent('ACS_ForceHandClosedR');

						thePlayer.RaiseEvent('ACS_ForceHandVampireClawsL');

						PlayerPlayAnimation( 'man_npc_sword_2hand_attack_h_1_dw_ACS');

						combo_counter_damage += 1;

						combo_counter_geralt_light_attack += 1;
						break;

						case 12:

						thePlayer.RaiseEvent('ACS_ForceHandClosedR');

						thePlayer.RaiseEvent('ACS_ForceHandVampireClawsL');

						PlayerPlayAnimation( 'man_npc_sword_2hand_attack_h_2_dw_ACS');

						combo_counter_damage += 1;

						combo_counter_geralt_light_attack += 1;
						break;

						case 13:


	function Attack_Process_14_Secondary( attack_name : name ) 
	{
		switch ( attack_name )
		{
			case 'geraltRandomGeraltLightAttackForward_Ciri':

			thePlayer.DestroyEffect('dodge_ciri');
			thePlayer.PlayEffectSingle('dodge_ciri');

			vACS_Ciri_Special_Attack = new cACS_Ciri_Special_Attack in this;

			vACS_Ciri_Special_Attack.ACS_Ciri_Spectre_Attack_Engage();

			dodge_timer_attack_ciri_actual();

			movementAdjustor.SlideTo( ticket, TraceFloor(( GetWitcherPlayer().GetWorldPosition() ) + theCamera.GetCameraDirection() * 12) );
			
			
				RemoveTimer('ACS_Combo_Counter_Reset_Timer'); AddTimer('ACS_Combo_Counter_Reset_Timer', 4 , false);
				
				if (combo_counter_geralt_ciri_light_attack_forward == 0)
				{
					PlayerPlayAnimation( 'woman_ciri_sword_attack_fast_far_forward_1_rp_50ms_ACS');	

					combo_counter_damage -= combo_counter_damage;

					combo_counter_geralt_ciri_light_attack_forward += 1;
				}
				else if (combo_counter_geralt_ciri_light_attack_forward == 1)
				{
					PlayerPlayAnimation( 'woman_ciri_sword_attack_fast_far_forward_1_lp_50ms_ACS');	

					combo_counter_damage += 1;

					combo_counter_geralt_ciri_light_attack_forward += 1;
				}

				else if (combo_counter_geralt_ciri_light_attack_forward == 2)
				{
					PlayerPlayAnimation( 'woman_ciri_sword_attack_fast_far_back_1_rp_50ms_ACS');	

					combo_counter_damage += 1;

					combo_counter_geralt_ciri_light_attack_forward += 1;
				}

				else if (combo_counter_geralt_ciri_light_attack_forward == 3)
				{
					PlayerPlayAnimation( 'woman_ciri_sword_attack_fast_far_back_1_lp_50ms_ACS');	

					combo_counter_damage += 1;

					combo_counter_geralt_ciri_light_attack_forward += 1;
				}

				else if (combo_counter_geralt_ciri_light_attack_forward == 4)
				{
					PlayerPlayAnimation( 'woman_ciri_sword_attack_fast_far_left_1_rp_50ms_ACS');	

					combo_counter_damage += 1;

					combo_counter_geralt_ciri_light_attack_forward += 1;
				}

				else if (combo_counter_geralt_ciri_light_attack_forward == 5)
				{
					PlayerPlayAnimation( 'woman_ciri_sword_attack_fast_far_left_1_lp_50ms_ACS');	

					combo_counter_damage += 1;

					combo_counter_geralt_ciri_light_attack_forward += 1;
				}

				else if (combo_counter_geralt_ciri_light_attack_forward == 6)
				{
					PlayerPlayAnimation( 'woman_ciri_sword_attack_fast_far_right_1_rp_50ms_ACS');	

					combo_counter_damage += 1;

					combo_counter_geralt_ciri_light_attack_forward += 1;
				}

				else if (combo_counter_geralt_ciri_light_attack_forward == 7)
				{
					PlayerPlayAnimation( 'woman_ciri_sword_attack_fast_far_right_1_lp_50ms_ACS');	

					combo_counter_damage += 1;

					combo_counter_geralt_ciri_light_attack_forward -= combo_counter_geralt_ciri_light_attack_forward;
				}
			
			break;

			case 'geraltRandomGeraltLightAttack_Ciri':
			
				RemoveTimer('ACS_Combo_Counter_Reset_Timer'); AddTimer('ACS_Combo_Counter_Reset_Timer', 4 , false);
				
				switch ( combo_counter_geralt_ciri_light_attack )
				{
					default:

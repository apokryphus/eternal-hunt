					combo_counter_damage -= combo_counter_damage;

					combo_counter_punch += 1;
					break;

					case 1:
					PlayerPlayAnimation( 'combat_locomotion_sucker_punch_40ms_close');	

					combo_counter_damage += 1;

					combo_counter_punch -= combo_counter_punch;

		actors.Clear();
		
		theGame.GetActorsByTag( 'acs_yrden_heavy_attack_mark', actors );

		if (actors.Size() <= 0)
		{
			return;
		}

		if( actors.Size() > 0 )
		{
			for( i = 0; i < actors.Size(); i += 1 )
			{
				actors[i].RemoveTag('acs_yrden_heavy_attack_mark');
			}
		}
	}


				ACS_Oneliner(FormatCompassBarPathAlpha("icons/inventory/acs_compass_bar.xbm"), ACSGetCEntity('ACS_Compass_Bar_Cardinal_West_Entity'), "ACS_Compass_Bar_Cardinal_West_Bar_Alpha");
				GetACSStorage().acs_deleteOnelinerByTag("ACS_Compass_Bar_Cardinal_West_Bar_Omega");
				ACS_Oneliner(FormatCompassBarPathOmega("icons/inventory/acs_compass_bar.xbm"), ACSGetCEntity('ACS_Compass_Bar_Cardinal_West_Entity'), "ACS_Compass_Bar_Cardinal_West_Bar_Omega");
				*/

				GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Compass_Bar_Cardinal_West", 100);

				GetACSStorage().acs_setScaleForOnelinerByTag("ACS_Compass_Bar_Cardinal_West", 100, 100, 100);
			}
			else

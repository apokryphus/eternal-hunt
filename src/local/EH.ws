	function AardLightIconHands()
	{
		var ent_1, ent_2, ent_3, ent_4		: CEntity;
		var bone_vec						: Vector;
		var bone_rot						: EulerAngles;

		ent_1 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
		"dlc\dlc_acs\data\fx\sign_icons.w2ent"
		, true ), GetWitcherPlayer().GetWorldPosition(), GetWitcherPlayer().GetWorldRotation() );

		ent_2 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
		"dlc\dlc_acs\data\fx\sign_icons.w2ent"
		, true ), GetWitcherPlayer().GetWorldPosition(), GetWitcherPlayer().GetWorldRotation() );

		GetWitcherPlayer().GetBoneWorldPositionAndRotationByIndex( GetWitcherPlayer().GetBoneIndex( 'r_hand' ), bone_vec, bone_rot );

		ent_1.CreateAttachmentAtBoneWS( GetWitcherPlayer(), 'r_hand', bone_vec, bone_rot );

		attach_rot.Roll = 0;
		attach_rot.Pitch = 0;
		attach_rot.Yaw = 0;
		attach_vec.X = 0;
		attach_vec.Y = 0;
		attach_vec.Z = 0.0;

		ent_2.CreateAttachment( ent_1,, attach_vec,attach_rot );

		if (ACS_Armor_Set_Check('acs_armor', false)
		|| thePlayer.HasTag('acs_vampire_claws_equipped')
		|| ACS_Vampire_Claws_Access()
		)
		{
			ent_2.PlayEffectSingle('aard_icon_red');
		}
		else
		{
			ent_2.PlayEffectSingle('aard_icon');

			ent_2.PlayEffectSingle('critical_aard');
		}

		ent_2.DestroyAfter(0.5);

		ent_1.DestroyAfter(0.75);







		ent_3 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
		"dlc\dlc_acs\data\fx\sign_icons.w2ent"
		, true ), GetWitcherPlayer().GetWorldPosition(), GetWitcherPlayer().GetWorldRotation() );

		ent_4 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
		"dlc\dlc_acs\data\fx\sign_icons.w2ent"
		, true ), GetWitcherPlayer().GetWorldPosition(), GetWitcherPlayer().GetWorldRotation() );

		GetWitcherPlayer().GetBoneWorldPositionAndRotationByIndex( GetWitcherPlayer().GetBoneIndex( 'l_hand' ), bone_vec, bone_rot );

		ent_3.CreateAttachmentAtBoneWS( GetWitcherPlayer(), 'l_hand', bone_vec, bone_rot );

		attach_rot.Roll = 0;
		attach_rot.Pitch = 0;
		attach_rot.Yaw = 0;
		attach_vec.X = 0;
		attach_vec.Y = 0;
		attach_vec.Z = 0.0;

		ent_4.CreateAttachment( ent_3 ,, attach_vec,attach_rot );

		if (ACS_Armor_Set_Check('acs_armor', false)
		|| thePlayer.HasTag('acs_vampire_claws_equipped')
		|| ACS_Vampire_Claws_Access()
		)
		{
			ent_4.PlayEffectSingle('aard_icon_red');
		}
		else
		{
			ent_4.PlayEffectSingle('aard_icon');

			ent_4.PlayEffectSingle('critical_aard');
		}

		ent_4.DestroyAfter(0.5);

		ent_3.DestroyAfter(0.75);
	}

	function AardLightIconFeet()
	{

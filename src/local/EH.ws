						RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.75   , false);	
						
						PlayerPlayAnimation( 'man_npc_sword_2hand_attack_l_left_1_dw_ACS');

						combo_counter_damage += 1;

						combo_counter_geralt_light_attack -= combo_counter_geralt_light_attack;
						break;
					}
				}
				else
				{
					dodge_timer_actual();

					RemoveTimer('ACS_Combo_Counter_Reset_Timer'); AddTimer('ACS_Combo_Counter_Reset_Timer', 4 , false);


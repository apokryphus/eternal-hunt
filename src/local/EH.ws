		if(ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker'))
		{
			GetACSStorage().acs_deleteOnelinerByTag("ACS_Enemy_GUI_Marker");

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Enemy_Distance_GUI_Marker");

			if (ACS_Guiding_Light_Enemy_Marker_Distance_Available)
			{
				ACS_Guiding_Light_Enemy_Marker_Distance_Available = false;
			}

			ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').Destroy();
		}

		if(ACSGetCEntity('ACS_Guiding_Light_Merchant_Marker'))
		{
			GetACSStorage().acs_deleteOnelinerByTag("ACS_Merchant_GUI_Marker");

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Merchant_Distance_GUI_Marker");

			if (ACS_Guiding_Light_Merchant_Marker_Distance_Available)
			{
				ACS_Guiding_Light_Merchant_Marker_Distance_Available = false;
			}

			ACSGetCEntity('ACS_Guiding_Light_Merchant_Marker').Destroy();
		}

		if (ACS_Guiding_Light_Untracked_Quest_Marker_Distance_Available)
		{
			GetACSStorage().acs_deleteOnelinerByTag("ACS_Untracked_Quest_Distance_GUI_Marker");

			ACS_Guiding_Light_Untracked_Quest_Marker_Distance_Available = false;
		}

		if (ACS_Guiding_Light_Quest_Marker_Distance_Available)
		{
			GetACSStorage().acs_deleteOnelinerByTag("ACS_Quest_Distance_GUI_Marker");

			ACS_Guiding_Light_Quest_Marker_Distance_Available = false;
		}

		if (ACS_Guiding_Light_Horse_Marker_Distance_Available)
		{
			GetACSStorage().acs_deleteOnelinerByTag("ACS_Horse_Distance_GUI_Marker");

			ACS_Guiding_Light_Horse_Marker_Distance_Available = false;
		}

		if (ACS_Guiding_Light_POI_Marker_Distance_Available)
		{
			GetACSStorage().acs_deleteOnelinerByTag("ACS_POI_Distance_GUI_Marker");

			ACS_Guiding_Light_POI_Marker_Distance_Available = false;
		}

		if (ACS_Guiding_Light_Available_Quest_Marker_Distance_Available)
		{
			GetACSStorage().acs_deleteOnelinerByTag("ACS_Available_Quest_Distance_GUI_Marker");

			ACS_Guiding_Light_Available_Quest_Marker_Distance_Available = false;
		}

		if (ACS_Guiding_Light_User_Marker_Distance_Available)
		{
			GetACSStorage().acs_deleteOnelinerByTag("ACS_User_Distance_GUI_Marker");

			ACS_Guiding_Light_User_Marker_Distance_Available = false;
		}

		if (ACS_Guiding_Light_Enemy_Marker_Distance_Available)
		{
			GetACSStorage().acs_deleteOnelinerByTag("ACS_Enemy_Distance_GUI_Marker");

			ACS_Guiding_Light_Enemy_Marker_Distance_Available = false;
		}

		if (ACS_Guiding_Light_Merchant_Marker_Distance_Available)
		{
			GetACSStorage().acs_deleteOnelinerByTag("ACS_Merchant_Distance_GUI_Marker");

			ACS_Guiding_Light_Merchant_Marker_Distance_Available = false;
		}
	}

	var last_swimming_aard_time : float;

	var last_swimming_melee_time : float;

	timer function SwimmingAard360DealDamage( dt : float, id : int )
	{
		var actors    							: array<CActor>;
		var i         							: int;
		var actortarget							: CActor;
		var dmg									: W3DamageAction;
		var damageMax, range					: float;
		var sp 									: SAbilityAttributeValue;
		var witcher 							: W3PlayerWitcher;
		var component 							: CInteractionComponent;
		var ent, ent_bubbles       				: CEntity;
		var ent_1, ent_2, ent_3, ent_4 			: CEntity;
		var bone_vec, attach_vec, pPos			: Vector;
		var bone_rot, attach_rot				: EulerAngles;
		var animatedComponentA					: CAnimatedComponent;

		if (ACS_Armor_Set_Check('forgotten_wolf', false) 
		|| ACS_Armor_Set_Check('acs_armor', false)
		|| ACS_Armor_Set_Check('volhikar', false)
		|| ACS_Vampire_Claws_Access()
		)
		{
			thePlayer.DrainStamina( ESAT_FixedValue, thePlayer.GetStatMax( BCS_Stamina ) * 0.25, 3.25 );

			range = 12;
		}
		else
		{
			thePlayer.DrainStamina( ESAT_FixedValue, thePlayer.GetStatMax( BCS_Stamina ) * 0.5, 3.25 );

			range = 8;
		}

		ACSGetCEntity('ACS_Quen_Bubble').Destroy();

		ACSGetCEntity('ACS_Quen_Fx').Destroy();

		ACSGetCEntity('ACS_Sign_Icon').Destroy();

		ACSGetCEntity('ACS_Sign_Icon_Anchor').Destroy();

		ent_1 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
		"dlc\dlc_acs\data\fx\sign_icons.w2ent"
		, true ), GetWitcherPlayer().GetWorldPosition(), GetWitcherPlayer().GetWorldRotation() );

		ent_2 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
		"dlc\dlc_acs\data\fx\sign_icons.w2ent"
		, true ), GetWitcherPlayer().GetWorldPosition(), GetWitcherPlayer().GetWorldRotation() );

		GetWitcherPlayer().GetBoneWorldPositionAndRotationByIndex( GetWitcherPlayer().GetBoneIndex( 'l_handRoll' ), bone_vec, bone_rot );

		attach_rot.Roll = 0;
		attach_rot.Pitch = 0;
		attach_rot.Yaw = 0;
		attach_vec.X = 0.4;
		attach_vec.Y = 0;
		attach_vec.Z = -0.025;

		ent_1.CreateAttachmentAtBoneWS( GetWitcherPlayer(), 'l_handRoll', bone_vec, bone_rot );

		ent_2.CreateAttachment( ent_1, , attach_vec, attach_rot );
		
		if (ACS_Armor_Set_Check('forgotten_wolf', false) 
		|| ACS_Armor_Set_Check('acs_armor', false)
		|| ACS_Armor_Set_Check('volhikar', false)
		|| thePlayer.HasTag('acs_vampire_claws_equipped')
		|| ACS_Vampire_Claws_Access()
		)
		{
			ent_2.PlayEffectSingle('aard_icon_red');
		}
		else
		{
			ent_2.PlayEffectSingle('aard_icon');
		}

		ent_2.PlayEffectSingle('critical_aard');

		ent_1.DestroyAfter(0.5);
		ent_2.DestroyAfter(0.5);

		ent_1.AddTag('ACS_Sign_Icon_Anchor');

		ent_2.AddTag('ACS_Sign_Icon');
	
		actors.Clear();

		actors = thePlayer.GetNPCsAndPlayersInCone(range, VecHeading(thePlayer.GetHeadingVector()), 360, 50, , FLAG_ExcludePlayer );

		if( actors.Size() > 0 )
		{
			for( i = 0; i < actors.Size(); i += 1 )
			{
				actortarget = (CActor)actors[i];

				if (actortarget.IsAlive() && actortarget.GetAttitude( thePlayer ) == AIA_Hostile )
				{
					dmg = new W3DamageAction in theGame.damageMgr;
					
					dmg.Initialize(thePlayer, actortarget, thePlayer, thePlayer.GetName(), EHRT_Heavy, CPS_Undefined, false, false, true, false);
					
					dmg.SetProcessBuffsIfNoDamage(true);

					

					if(actortarget.IsSwimming() || actortarget.IsDiving())
					{
						damageMax = actortarget.GetMaxHealth() * 0.5;
					}
					else
					{
						damageMax = actortarget.GetMaxHealth() * 0.25;
					}
					
					dmg.SetCanPlayHitParticle(false);
					
					dmg.SetSuppressHitSounds(true);

					dmg.SetHitReactionType( EHRT_Heavy, true);

					dmg.SetHitAnimationPlayType(EAHA_ForceYes);

					dmg.AddDamage( theGame.params.DAMAGE_NAME_PHYSICAL, 50 + damageMax );

					dmg.AddDamage( theGame.params.DAMAGE_NAME_SILVER, 50 + damageMax );

					dmg.SetForceExplosionDismemberment();
						
					dmg.SetCriticalHit(); theGame.damageMgr.ProcessAction( dmg );
						
					delete dmg;	

					animatedComponentA = (CAnimatedComponent)actortarget.GetComponentByClassName( 'CAnimatedComponent' );

					animatedComponentA.UnfreezePose();

					animatedComponentA.FreezePose();

					animatedComponentA.UnfreezePoseFadeOut(0.75f);
				}
				else
				{
					if (!actortarget.IsAlive() )
					{
						((CNewNPC)actortarget).SetKinematic(false);

						ACSGetCEntityDestroyAll('ACS_Killed_By_Fire_Burning_FX_Ground_Fire');
						
						actortarget.StopEffect('critical_burning');
	
						actortarget.RemoveTag('ACS_Killed_By_Fire');

						((CNewNPC)actortarget).RemoveTimer('ACS_Critical_Burning_Remove_Delay');
						((CNewNPC)actortarget).RemoveTimer('ACS_Critical_Burning_Delay');
					}
				}
			}
		}

		if (ACS_Armor_Set_Check('forgotten_wolf', false) 
		|| ACS_Armor_Set_Check('acs_armor', false)
		|| ACS_Armor_Set_Check('volhikar', false)
		|| thePlayer.HasTag('acs_vampire_claws_equipped')
		|| ACS_Vampire_Claws_Access()
		)
		{
			ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

			"dlc\dlc_acs\data\fx\pc_aard.w2ent"

			, true ), (GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetWorldForward() * 2) + Vector(0,0,1.5), GetWitcherPlayer().GetWorldRotation() );
		}
		else
		{
			ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

			"gameplay\templates\signs\pc_aard.w2ent"

			, true ), (GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetWorldForward() * 2) + Vector(0,0,1.5), GetWitcherPlayer().GetWorldRotation() );
		}

		ent.PlayEffectSingle('blast_cutscene');

		ent.PlayEffectSingle('blast');

		ent.PlayEffectSingle('blast_water');

		ent.PlayEffectSingle('blast_ground');

		ent.PlayEffectSingle('blast_lv0');

		ent.PlayEffectSingle('blast_lv0_power');

		ent.PlayEffectSingle('blast_lv1_power');

		ent.PlayEffectSingle('blast_lv2_power');

		ent.PlayEffectSingle('blast_lv3_power');

		ent.PlayEffectSingle('blast_lv3_damage');

		ent.PlayEffectSingle('blast_lv1');

		ent.PlayEffectSingle('blast_lv2');

		ent.PlayEffectSingle('cone_water');

		if (ACS_Armor_Set_Check('forgotten_wolf', false) 
		|| ACS_Armor_Set_Check('acs_armor', false)
		|| ACS_Armor_Set_Check('volhikar', false)
		|| thePlayer.HasTag('acs_vampire_claws_equipped')
		|| ACS_Vampire_Claws_Access()
		)
		{
			ent.PlayEffectSingle('blast_lv3_red');
		}
		else
		{
			ent.PlayEffectSingle('blast_lv3');
		}

		ent.DestroyAfter(7);

		ACSGetCEntityDestroyAll('ACS_UnderWater_Bubbles');

		if(thePlayer.IsDiving())
		{
			ent_bubbles = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

			"dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent"

			, true ), (GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetWorldForward()) + Vector(0,0,1), GetWitcherPlayer().GetWorldRotation() );

			if(RandF() < 0.75)
			{
				ent_bubbles.PlayEffect('underwater_bubbles_02');
			}
			else
			{
				ent_bubbles.PlayEffect('underwater_bubbles_01');
			}

			ent_bubbles.DestroyAfter(10);

			ent_bubbles.AddTag('ACS_Underwater_Bubbles');
		}
		
		theGame.GetBehTreeReactionManager().CreateReactionEventIfPossible( thePlayer, 'CastSignAction', -1, 20.0f, -1.f, -1, true );

		if (swimmingAardCheck)
		{
			swimmingAardCheck = false;
		}
	}

	function SwimmingMeleeDealDamage( is_heavy : bool )
	{
		var actors    														: array<CActor>;
		var i, j       														: int;
		var actortarget														: CActor;
		var dmg																: W3DamageAction;
		var damageMax														: float;
		var pos, targetPos													: Vector;
		var targetPosition, pPos											: Vector;
		var vfxEnt															: CEntity;
		var rot																: EulerAngles;
		var animatedComponentA												: CAnimatedComponent;
		var attach_vec														: Vector;
		var movementAdjustor												: CMovementAdjustor;
		var ticket 															: SMovementAdjustmentRequestTicket;
		var targetDistance, dist, targetDist								: float;
		var item 															: array<CEntity>;

		item.Clear();

		theGame.GetEntitiesByTag( 'ACS_Bubble_Trail' , item );	
		
		for( j = 0; j < item.Size(); j += 1 )
		{
			item[j].PlayEffect('underwater_dodge');
			item[j].StopEffect('underwater_dodge');
		}

		if (!swimmingMeleeCheck)
		{
			swimmingMeleeCheck = true;
		}

		movementAdjustor = thePlayer.GetMovingAgentComponent().GetMovementAdjustor();
		movementAdjustor.CancelAll();
		ticket = movementAdjustor.CreateNewRequest( 'ACS_Swimming_Movement_Adjustor' );
		
		movementAdjustor.AdjustmentDuration( ticket, 0.25 );
		movementAdjustor.MaxRotationAdjustmentSpeed( ticket, 50000 );
		movementAdjustor.MaxLocationAdjustmentSpeed( ticket, 50000 );
		movementAdjustor.AdjustLocationVertically( ticket, true );

		if( thePlayer.GetDisplayTarget() 
		&& ACS_AttitudeCheck ( (CActor)( thePlayer.GetDisplayTarget() ) ) 
		//&& thePlayer.IsInCombat()
		)
		{
			movementAdjustor.RotateTowards( ticket, (CActor)( thePlayer.GetDisplayTarget() ) );

			targetDistance = VecDistanceSquared2D( thePlayer.GetWorldPosition(), ((CActor)( thePlayer.GetDisplayTarget() )).GetWorldPosition() ) ;

			if (targetDistance > 4 * 4)
			{
				thePlayer.StopEffect('acs_fast_sprint_trail');
				thePlayer.PlayEffectSingle('acs_fast_sprint_trail');
				thePlayer.StopEffect('acs_fast_sprint_trail');
			}

			if (theInput.GetActionValue('Sprint') > 0.1)
			{
				targetDist = 8;
			}
			else
			{
				targetDist = 4;
			}

			if (targetDistance <= targetDist * targetDist)
			{
				dist = (((CMovingPhysicalAgentComponent)((CActor)( thePlayer.GetDisplayTarget() )).GetMovingAgentComponent()).GetCapsuleRadius() 
				+ ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent()).GetCapsuleRadius()) * 0.5;
				
				movementAdjustor.SlideTowards(ticket, (CActor)( thePlayer.GetDisplayTarget() ), dist, dist);
			}
		}

		if (theInput.GetActionValue('Sprint') > 0.1)
		{
			thePlayer.DrainStamina( ESAT_FixedValue, thePlayer.GetStatMax( BCS_Stamina ) * 0.25, 2 );
		}
		else
		{
			thePlayer.DrainStamina( ESAT_FixedValue, thePlayer.GetStatMax( BCS_Stamina ) * 0.125, 2 );
		}

		thePlayer.SoundEvent("monster_dettlaff_vampire_movement_whoosh_small");

		actors.Clear();

		actors = thePlayer.GetNPCsAndPlayersInCone(2.5, VecHeading(thePlayer.GetHeadingVector()), 90, 50, , FLAG_ExcludePlayer + FLAG_OnlyAliveActors + FLAG_Attitude_Hostile);

		pos = thePlayer.GetWorldPosition();
		pos.Z += 0.8;

		pPos = thePlayer.GetWorldPosition();

		if( actors.Size() > 0 )
		{
			ACS_SlowMoAdjustable(0.3, 0.05);

			ACSGetCEntity('acs_swimming_dagger').DestroyEffect('fast_trail_blood_fx');
			ACSGetCEntity('acs_swimming_dagger').PlayEffectSingle('fast_trail_blood_fx');

			for( i = 0; i < actors.Size(); i += 1 )
			{
				actortarget = (CActor)actors[i];

				targetPos = actortarget.GetWorldPosition();

				if ( AbsF( targetPos.Z - pos.Z ) > 2 )
				{
					actors.EraseFast(i);
				}
				else
				{
					dmg = new W3DamageAction in theGame.damageMgr;
					
					dmg.Initialize(thePlayer, actortarget, thePlayer, thePlayer.GetName(), EHRT_Heavy, CPS_Undefined, false, false, true, false);
					
					dmg.SetProcessBuffsIfNoDamage(true);

					

					if (theInput.GetActionValue('Sprint') > 0.1)
					{
						if (is_heavy)
						{
							damageMax = actortarget.GetMaxHealth() * 0.125;
						}
						else
						{
							damageMax = actortarget.GetMaxHealth() * 0.0625;
						}
					}
					else
					{
						if (is_heavy)
						{
							damageMax = actortarget.GetMaxHealth() * 0.25;
						}
						else
						{
							damageMax = actortarget.GetMaxHealth() * 0.125;
						}
					}

					dmg.SetCanPlayHitParticle(false);
					
					dmg.SetHitReactionType( EHRT_Heavy, true);

					dmg.SetHitAnimationPlayType(EAHA_ForceYes);

					dmg.AddDamage( theGame.params.DAMAGE_NAME_PHYSICAL, 50 + damageMax );

					dmg.AddDamage( theGame.params.DAMAGE_NAME_SILVER, 50 + damageMax );

					dmg.AddEffectInfo( EET_Bleeding, 3 );

					dmg.SetForceExplosionDismemberment();
						
					dmg.SetCriticalHit(); theGame.damageMgr.ProcessAction( dmg );
						
					delete dmg;	

					if (ACS_Settings_Main_Bool('acs_visual_main_settings','acs_directional_slash_effects_enabled', true))
					{
						rot = thePlayer.GetWorldRotation();

						rot.Roll += RandRangeF(90, 45);

						vfxEnt = theGame.CreateEntity( (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\fx\acs_sword_slashes.w2ent", true ), targetPos + Vector(0,0,0.8), rot );

						vfxEnt.PlayEffectSingle('sword_slash_hit_eff_heavy');

						vfxEnt.DestroyAfter(0.5);
					}
					
					actortarget.DestroyEffect('heavy_hit');
					actortarget.PlayEffectSingle('heavy_hit');
					
					actortarget.SoundEvent("cmb_play_dismemberment_gore");

					actortarget.SoundEvent("monster_dettlaff_monster_vein_hit_blood");

					thePlayer.SoundEvent("cmb_play_dismemberment_gore");

					thePlayer.SoundEvent("monster_dettlaff_monster_vein_hit_blood");
				}
			}
		}
	}

	var sLean : EulerAngles;
	var swimmingLeanCheck : bool;

	var swimmingAardCheck, swimmingMeleeCheck, swimmingDodgeCheck : bool;

	function SwimmingCombat()
	{
		var anim_names														: array< name >;
		var chosen_anim_name												: name;
		var movementAdjustor												: CMovementAdjustor;
		var ticket 															: SMovementAdjustmentRequestTicket;
		var targetDistance, dist											: float;

		if (thePlayer.GetStat(BCS_Stamina) > thePlayer.GetStatMax(BCS_Stamina) * 0.01
		)
		{
			if (theInput.GetActionValue('Focus') > 0.5
			)
			{
				if (theGame.GetEngineTimeAsSeconds() - last_swimming_aard_time > 3)
				{
					last_swimming_aard_time = theGame.GetEngineTimeAsSeconds();

					if ( !swimmingAardCheck )
					{
						swimmingAardCheck = true;
					}

					if (medallion_hold_anim_active)
					{
						thePlayer.RaiseEvent('ACS_MedallionHoldReset');

						medallion_hold_anim_active = false;
					}

					if (theInput.GetActionValue('GI_AxisLeftX') != 0 
					|| theInput.GetActionValue('GI_AxisLeftY') != 0)
					{
						if (thePlayer.IsDiving())
						{
							thePlayer.RaiseEvent( 'ACS_CastAardIdle' );
						}
						else
						{
							thePlayer.RaiseEvent( 'ACS_CastAardLocomotion' );
						}
					}
					else
					{
						thePlayer.RaiseEvent( 'ACS_CastAardLocomotion' );
					}

					movementAdjustor = thePlayer.GetMovingAgentComponent().GetMovementAdjustor();
					movementAdjustor.CancelAll();
					ticket = movementAdjustor.CreateNewRequest( 'ACS_Swimming_Movement_Adjustor' );

					movementAdjustor.AdjustmentDuration( ticket, 0.25 );
					movementAdjustor.MaxRotationAdjustmentSpeed( ticket, 50000 );
					movementAdjustor.MaxLocationAdjustmentSpeed( ticket, 50000 );

					movementAdjustor.RotateTo( ticket, VecHeading( theCamera.GetCameraDirection() ) );
					
					RemoveTimer('SwimmingAard360DealDamage');

					AddTimer('SwimmingAard360DealDamage', 0.5 , false);
				}
				else
				{
					if ( swimmingAardCheck )
					{
						swimmingAardCheck = false;
					}
				}
			}
			else
			{
				if (theGame.GetEngineTimeAsSeconds() - last_swimming_melee_time > 1.5)
				{
					last_swimming_melee_time = theGame.GetEngineTimeAsSeconds();

					if (swimmingAardCheck)
					{
						RemoveTimer('SwimmingAard360DealDamage');

						swimmingAardCheck = false;
					}

					if (!swimmingMeleeCheck)
					{
						swimmingMeleeCheck = true;
					}

					if (!ACSGetCEntity('acs_swimming_dagger'))
					{
						vACS_Dagger_Summon = new cACS_Dagger_Summon in this;
					
						vACS_Dagger_Summon.ACS_Swimming_Dagger_Summon_Engage();

						thePlayer.RaiseEvent('ACS_ForceHandClosedR');
					}

					RemoveTimer('SwimmingDaggerDestroyProcess');
					AddTimer('SwimmingDaggerDestroyProcess', 3.5 , false);

					anim_names.Clear();

					if (theInput.GetActionValue('Sprint') > 0.1)
					{
						if (Attack_Directional_Press_Check())
						{
							anim_names.PushBack('ACS_SwordAttackStandaloneSwimAttack13');
							anim_names.PushBack('ACS_SwordAttackStandaloneSwimAttack14');
							anim_names.PushBack('ACS_SwordAttackStandaloneSwimAttack15');
							anim_names.PushBack('ACS_SwordAttackStandaloneSwimAttack16');
						}
						else
						{
							anim_names.PushBack('ACS_SwordAttackStandaloneSwimAttack10');
							anim_names.PushBack('ACS_SwordAttackStandaloneSwimAttack11');
							anim_names.PushBack('ACS_SwordAttackStandaloneSwimAttack12');
						}
					}
					else
					{
						if (Attack_Directional_Press_Check())
						{
							anim_names.PushBack('ACS_SwordAttackStandaloneSwimAttack03');
							anim_names.PushBack('ACS_SwordAttackStandaloneSwimAttack04');
							anim_names.PushBack('ACS_SwordAttackStandaloneSwimAttack06');
							anim_names.PushBack('ACS_SwordAttackStandaloneSwimAttack07');
						}
						else
						{
							anim_names.PushBack('ACS_SwordAttackStandaloneSwimAttack02');
							anim_names.PushBack('ACS_SwordAttackStandaloneSwimAttack08');
							anim_names.PushBack('ACS_SwordAttackStandaloneSwimAttack09');
						}
					}

					chosen_anim_name = anim_names[RandRange(anim_names.Size())];

					thePlayer.RaiseEvent(chosen_anim_name);
				}
			}
		}
		else
		{
			if (swimmingAardCheck)
			{
				RemoveTimer('SwimmingAard360DealDamage');

				swimmingAardCheck = false;
			}
		}
	}

	timer function SwimmingDaggerDestroyProcess( dt : float, id : int )
	{
		if (swimmingMeleeCheck)
		{
			swimmingMeleeCheck = false;
		}

		ACSGetCEntity('acs_swimming_dagger').BreakAttachment();
		ACSGetCEntity('acs_swimming_dagger').Teleport(thePlayer.GetWorldPosition() + Vector(0,0,-200));
		ACSGetCEntity('acs_swimming_dagger').DestroyAfter(0.125);
		ACSGetCEntity('acs_swimming_dagger').RemoveTag('acs_swimming_dagger');

		if ( !theSound.SoundIsBankLoaded("qu_nml_105.bnk") )
		{
			theSound.SoundLoadBank( "qu_nml_105.bnk", false );
		}

		GetWitcherPlayer().SoundEvent("qu_nml_105_geralt_sheats_dagger");

		thePlayer.RaiseEvent('ACS_HolsterDagger');

		thePlayer.RaiseEvent('LootHerb');

		thePlayer.RaiseEvent('ACS_ForceHandClosedREnd');
	}

	///////////////////////////////////////////////////////////////////////

	var horse_convo_lock							: bool;

	var horse_line_number 							: int;

	var horse_line_dummycomp						: CEntity;

	function HorseSpeakController(line : name, optional override_horse_convo_lock : bool)
	{
		var horse 							: CNewNPC;

		horse = thePlayer.GetHorseWithInventory();

		if (thePlayer.IsSpeaking())
		{
			return;
		}

		if (horse.IsSpeaking())
		{
			return;
		}

		if (horse_convo_lock && !override_horse_convo_lock)
		{
			return;
		}

		if (thePlayer.HasBuff(EET_Drunkenness) 
		|| thePlayer.HasTag('ACS_TalkingAnimalsEnabled')
		|| pipe_smoke_effect_enabled
		)
		{
			horse_line_dummycomp.Destroy();

			switch(line)
			{
				case 'joke_01':

					horse_convo_lock = true;

					horse_line_number = 1126642;
					
				break;

				case 'joke_02':

					horse_line_number = 1126644;
					
				break;


				case 'hocus_pocus':

					horse_line_number = 1192852;
					
				break;

				case 'slowing_down':

					horse_line_number = 1165132;
					
				break;

				case 'watch_out':

					horse_line_number = 1123314;
					
				break;

				case 'save_my_strength':

					horse_line_number = 1165130;
					
				break;

				case 'sorry':

					horse_line_number = 1195065;
					
				break;

				case 'riding_skills':

					horse_line_number = 1170575;
					
				break;

				case 'surer_hand':

					horse_line_number = 1170577;
					
				break;

				case 'twerk':

					horse_convo_lock = true;

					horse_line_number = 1170579;
					
				break;


				/////////////////////////////////////////


				case 'what_the_fuck':

					horse_line_number = 1170594;
					
				break;

				case 'dont_recall':

					horse_line_number = 1170620;
					
				break;

				case 'youre_my_human':

					horse_line_number = 1126488;
					
				break;

				case 'everyones_got_limits':

					horse_line_number = 1142911;
					
				break;

				default:

				break;
			}

			horse.PlayLine( horse_line_number, false);


			RemoveTimer('HorseSpeakMessageDelay');
			AddTimer('HorseSpeakMessageDelay', 0.125, false);
		}
		else
		{
			horse_line_number = 0;

			horse_convo_lock = false;
		}
	}

	timer function HorseSpeakMessageDelay( dt : float, id : int )
	{
		var bone_vec						: Vector;
		var bone_rot						: EulerAngles;
		var horse 							: CNewNPC;

		horse = thePlayer.GetHorseWithInventory();

		horse_line_dummycomp.Destroy();

		horse.GetBoneWorldPositionAndRotationByIndex( horse.GetBoneIndex( 'head' ), bone_vec, bone_rot );

		horse_line_dummycomp = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource( 

		"dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent"

		,true ), horse.GetWorldPosition()-100 );

		horse_line_dummycomp.CreateAttachmentAtBoneWS(horse, 'head', bone_vec, bone_rot );

		GetACSStorage().acs_deleteOnelinerByTag("ACS_HorseSpeakMessage");

		ACS_Oneliner(
		(new ACS_Oneliner_TagBuilder in theGame)
		.tag("font")
		.attr("size", "20")
		.attr("color", "#ffffff")
		.text(GetLocStringById(horse_line_number))
		, horse_line_dummycomp, "ACS_HorseSpeakMessage", Vector(0,0,0.5), 30);

		GetACSStorage().acs_setScaleForOnelinerByTag("ACS_HorseSpeakMessage", 100, 100, 100);

		GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_HorseSpeakMessage", 100);

		RemoveTimer('HorseSpeakMessageRemove');
		AddTimer('HorseSpeakMessageRemove', 0.0001, true);
	}

	timer function HorseSpeakMessageRemove( dt : float, id : int )
	{
		var horse 							: CNewNPC;

		horse = thePlayer.GetHorseWithInventory();

		if (!horse.IsSpeaking(horse_line_number))
		{
			horse.EndLine();

			horse_line_dummycomp.Destroy();

			GetACSStorage().acs_deleteOnelinerByTag("ACS_HorseSpeakMessage");

			if (!thePlayer.IsSpeaking())
			{
				if (horse_line_number == 1170579)
				{
					PlayerSpeakController('respond_to_my_commands', true);

					horse_line_number = 0;
				}
				else if (horse_line_number == 1170620)
				{
					PlayerSpeakController('of_course_you_dont', true);

					horse_line_number = 0;
				}
				else if (horse_line_number == 1126488)
				{
					PlayerSpeakController('kinda_strange', true);
				}
			}

			if (horse_line_number == 1126642)
			{
				HorseSpeakController('joke_02', true);
			}

			if (horse_line_number == 1142911
			|| horse_line_number == 1126644
			|| horse_line_number == 1170594
			)
			{
				horse_convo_lock = false;
			}

			RemoveTimer('HorseSpeakMessageRemove');
		}
	}

	var player_line_number 							: int;

	var player_line_dummycomp						: CEntity;

	function PlayerSpeakController(line : name, optional override_horse_convo_lock : bool)
	{
		var horse 							: CNewNPC;

		horse = thePlayer.GetHorseWithInventory();

		if (thePlayer.IsSpeaking())
		{
			return;
		}

		if (horse.IsSpeaking())
		{
			return;
		}

		if (horse_convo_lock && !override_horse_convo_lock)
		{
			return;
		}

		if (thePlayer.HasBuff(EET_Drunkenness) 
		|| thePlayer.HasTag('ACS_TalkingAnimalsEnabled')
		|| pipe_smoke_effect_enabled
		)
		{

			player_line_dummycomp.Destroy();

			GetACSStorage().acs_deleteOnelinerByTag("ACS_PlayerSpeakMessage");

			switch(line)
			{
				case 'show_up_when_whistle':

					horse_convo_lock = true;

					player_line_number = 1117442;
					
				break;

				case 'run_roach':

					horse_convo_lock = true;

					player_line_number = 1170592;
					
				break;

				case 'candid':

					horse_convo_lock = true;

					player_line_number = 1170608;
					
				break;

				////////////////////////////////////////////////////////

				case 'kinda_strange':

					player_line_number = 1142909;
					
				break;

				case 'respond_to_my_commands':

					player_line_number = 1170588;
					
				break;

				case 'of_course_you_dont':

					player_line_number = 1170622;
					
				break;






				

				default:

				break;
			}

			thePlayer.PlayLine( player_line_number, false);


			RemoveTimer('PlayerSpeakMessageDelay');
			AddTimer('PlayerSpeakMessageDelay', 0.125, false);
		}
		else
		{
			player_line_number = 0;

			horse_convo_lock = false;
		}
	}

	timer function PlayerSpeakMessageDelay( dt : float, id : int )
	{
		var bone_vec						: Vector;
		var bone_rot						: EulerAngles;

		player_line_dummycomp.Destroy();

		thePlayer.GetBoneWorldPositionAndRotationByIndex( thePlayer.GetBoneIndex( 'head' ), bone_vec, bone_rot );

		player_line_dummycomp = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource( 

		"dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent"


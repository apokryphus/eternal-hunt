	event OnDiveUp( action : SInputAction )
	{
		if ( IsReleased(action) )
		{
			thePlayer.SetBehaviorVariable( 'divePitch',0.0);
			thePlayer.OnDiveInput(0.f);
		}

		if ( IsPressed(action) )
		{
			if (!thePlayer.IsActionAllowed(EIAB_Dive) 
			&& !thePlayer.IsDiving()
			&& !thePlayer.IsSwimming()
			)
			{
				thePlayer.DisplayActionDisallowedHudMessage(EIAB_Dive);

				return false;
			}

			if ( thePlayer.IsDiving() || thePlayer.IsSwimming() )
			{
				if ( thePlayer.bLAxisReleased )
				{
					thePlayer.SetBehaviorVariable( 'divePitch',1.0);
				}
				else
				{
					thePlayer.SetBehaviorVariable( 'divePitch', 0.9);
				}
					
				if ( thePlayer.rangedWeapon.GetCurrentStateName() != 'State_WeaponWait' )
				{
					thePlayer.OnRangedForceHolster( true, false );
					thePlayer.OnFullyBlendedIdle();
				}
					
				thePlayer.OnDiveInput(1.f);
			}
		}
	}

	event OnDiveDown( action : SInputAction )
	{
		if ( IsReleased(action) )
		{
			thePlayer.SetBehaviorVariable( 'divePitch',0.0);
			thePlayer.OnDiveInput(0.f);
		}

		if ( IsPressed(action) )
		{
			if (!thePlayer.IsActionAllowed(EIAB_Dive) 
			&& !thePlayer.IsDiving()
			&& !thePlayer.IsSwimming()
			)
			{
				thePlayer.DisplayActionDisallowedHudMessage(EIAB_Dive);

				return false;
			}

			if ( thePlayer.IsDiving() || thePlayer.IsSwimming() )
			{
				thePlayer.OnDive();

				if ( thePlayer.bLAxisReleased )
				{
					thePlayer.SetBehaviorVariable( 'divePitch',-1.0);
				}
				else
				{
					thePlayer.SetBehaviorVariable( 'divePitch', -0.9);
				}
					
				thePlayer.OnDiveInput(-1.f);
				
				if ( thePlayer.rangedWeapon.GetCurrentStateName() != 'State_WeaponWait' )
				{
					thePlayer.OnRangedForceHolster( true, false );
					thePlayer.OnFullyBlendedIdle();
				}
			}
		}
	}
	
	event OnDivingDodge( action : SInputAction )
	{
		var isDodgeAllowed : bool;
		
		if( IsPressed(action) )
		{
			isDodgeAllowed = thePlayer.IsActionAllowed(EIAB_Dodge);

			if( isDodgeAllowed && thePlayer.IsActionAllowed(EIAB_Dive) )
			{
				if ( thePlayer.OnCheckDiving() && thePlayer.GetBIsInputAllowed() )
				{
					thePlayer.PushCombatActionOnBuffer( EBAT_Dodge, BS_Pressed );

					if ( thePlayer.GetBIsCombatActionAllowed() )
					{
						thePlayer.ProcessCombatActionBuffer();
					}
				}
			}
			else
			{
				if(!isDodgeAllowed)
				{
					thePlayer.DisplayActionDisallowedHudMessage(EIAB_Dodge);
				}
				else
				{
					thePlayer.DisplayActionDisallowedHudMessage(EIAB_Dive);
				}
			}
		}
	}

	event OnApplyOil( action : SInputAction )
	{
		var moduleRadial													: CR4HudModuleRadialMenu;
		var duringCastSign 													: bool;
		var ent            													: CEntity; 
		var hud 															: CR4ScriptedHud;
		var controlsFeedbackModule 											: CR4HudModuleControlsFeedback;	

		if(RadialMenuCheck())
		{
			if( IsPressed(action) )
			{
				if( thePlayer.IsWeaponHeld( 'steelsword' )
				|| thePlayer.IsWeaponHeld( 'silversword' )
				)
				{
					hud = (CR4ScriptedHud)theGame.GetHud();
					moduleRadial = (CR4HudModuleRadialMenu)hud.GetHudModule("RadialMenuModule");

					if (moduleRadial.ACS_RadialMenuCurrentSelection() == "Aard"
					|| moduleRadial.ACS_RadialMenuCurrentSelection() == "Igni"
					|| moduleRadial.ACS_RadialMenuCurrentSelection() == "Yrden"
					|| moduleRadial.ACS_RadialMenuCurrentSelection() == "Axii"
					|| moduleRadial.ACS_RadialMenuCurrentSelection() == "Quen")
					{
						ACS_Tutorial_Display_Check('ACS_Stance_Switching_Tutorial_Shown');

						GetACSStorage().acs_deleteOnelinerByTag("ACS_Sword_Stance_Notification");

						ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

						"dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent"

						, true ), thePlayer.GetWorldPosition() );

						ent.CreateAttachment(thePlayer,'blood_point', Vector(0,0,0));

						ent.DestroyAfter(2);

						vACS_Stance_Switch = new cACS_Stance_Switch in this;
						
						switch( action.aName )
						{
							case 'OilSteel' :
							case 'OilSteelKB' :
								thePlayer.SoundEvent('sprj_katana_iai_00_bb_acs');
								if( thePlayer.IsWeaponHeld( 'steelsword' )
								)
								{
									switch(ACS_Settings_Main_Int('acs_combat_main_settings','acs_steel_silver_moveset_switch', 0))
									{
										case 1:
										case 3:
											if (!silver_strong_stance 
											&& !silver_group_stance
											&& !silver_fast_stance
											)
											{
												ShowSwordStanceNotification(ent,  GetLocStringById(2116581193));

												silver_fast_stance = true;

												vACS_Stance_Switch.ACS_Silver_Fast_Switch_Activate_Engage();
											}
											else if ( !silver_strong_stance 
											&& !silver_group_stance
											&& silver_fast_stance
											)
											{
												ShowSwordStanceNotification(ent,  GetLocStringById(2116581194));

												silver_fast_stance = false;

												silver_group_stance = true;

												vACS_Stance_Switch.ACS_Silver_Group_Switch_Activate_Engage();
											}
											else if ( 
											silver_group_stance 
											&& !silver_strong_stance 
											&& !silver_fast_stance
											)
											{
												ShowSwordStanceNotification(ent,  GetLocStringById(2116581195));

												silver_group_stance = false;

												silver_strong_stance = true;

												vACS_Stance_Switch.ACS_Silver_Strong_Switch_Activate_Engage();

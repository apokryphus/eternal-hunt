	function StaminaCheck( checkType : name ) : bool
	{
		if (thePlayer.HasTag('ACS_Ghost_Stance_Active'))
		{
			return false;
		}

		switch( checkType )
		{
			case 'fist':
				if ( thePlayer.GetStat( BCS_Stamina ) <= thePlayer.GetStatMax( BCS_Stamina ) * 0.05 )
				{
					return true;
				}
			break;

			case 'default':
				if ( thePlayer.GetStat( BCS_Stamina ) <= thePlayer.GetStatMax( BCS_Stamina ) * 0.15 )
				{
					return true;
				}
			break;

			default:
				return false;
			break;
		}

		return false;
	}


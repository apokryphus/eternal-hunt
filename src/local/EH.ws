	public timer function ACS_Gliding(deltaTime : float , id : int)
	{
		var cam_directionX, cam_directionY, camAngleZ					: float;
		var cameraAngle 												: Vector;

		cameraAngle = theCamera.GetCameraDirection();

		camAngleZ = cameraAngle.Z;

		camera.StopAnimation('camera_shake_loop_lvl1_1');

		theGame.GetGameCamera().StopAnimation( 'camera_shake_loop_lvl1_1' );

		camera.StopAnimation('camera_shake_loop_lvl1_5');

		theGame.GetGameCamera().StopAnimation( 'camera_shake_loop_lvl1_5' );

		thePlayer.EnableCharacterCollisions( false );

		MovementAdjust('wraith');
		
		movementAdjustor.ScaleAnimation( ticket, true, false, true );

		if ( theInput.LastUsedPCInput() )
		{
			cam_directionX = theInput.GetActionValue( 'GI_MouseDampX' );
			cam_directionY = theInput.GetActionValue( 'GI_MouseDampY' );
		}
		else if (theInput.LastUsedGamepad())
		{
			cam_directionX = theInput.GetActionValue( 'GI_AxisRightX' );
			cam_directionY = theInput.GetActionValue( 'GI_AxisRightY' );
		}

		if (cam_directionX != 0
		|| cam_directionY != 0
		)
		{
			if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTo( ticket, VecHeading( theCamera.GetCameraDirection() ) );}

			dest1 = thePlayer.GetWorldPosition() + thePlayer.GetWorldUp() * camAngleZ + thePlayer.GetWorldForward() * 2 + theCamera.GetCameraDirection() * 2;
		}
		else
		{
		
			dest1 = thePlayer.GetWorldPosition() + thePlayer.GetWorldUp() * camAngleZ + thePlayer.GetWorldForward() * 2 + thePlayer.GetHeadingVector() * 2;
		}
		
		//if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTo( ticket, VecHeading( theCamera.GetCameraDirection() ) );}
				
		movementAdjustor.SlideTo( ticket, dest1 );
	}

	function Umbral_Slash_Single()
	{
		if (!thePlayer.IsActionAllowed(EIAB_Signs))
		{
			return;
		}

		ACS_Tutorial_Display_Check('ACS_Umbral_Slash_Tutorial_Shown');

		//thePlayer.PlayBattleCry( 'BattleCryAttack', 1, true, false );
		thePlayer.PlayEffectSingle('special_attack_break'); thePlayer.StopEffect('special_attack_break');

		ACSSwordPlayEffects('quen_glow');

		ACS_Attack_Trail('fast_attack_buff');

		ACS_Attack_Trail('fast_attack_buff_hit');

		MovementAdjust('default');

		if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	

		thePlayer.ACS_SetAnimationSpeedMultiplier( 2  );

		RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5   , false);

		if( actor && ACS_AttitudeCheck ( actor ) && thePlayer.IsInCombat())
		{
			if ( ACS_Settings_Main_Int('acs_target_settings','acs_target_mode', 0) == 0 || ACS_Settings_Main_Int('acs_target_settings','acs_target_mode', 0) == 1 )
			{
				if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTowards( ticket, actor );}  
			}
			else if ( ACS_Settings_Main_Int('acs_target_settings','acs_target_mode', 0) == 2 )
			{
				if (thePlayer.IsHardLockEnabled())
				{
					if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTowards( ticket, actor );}  
				}
				else
				{
					if(!thePlayer.HasTag('ACS_Manual_Combat_Control')){thePlayer.AddTag('ACS_Manual_Combat_Control');} RemoveTimer('Manual_Combat_Control_Remove'); AddTimer('Manual_Combat_Control_Remove', 2 , false);//if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTo( ticket, VecHeading( theCamera.GetCameraDirection() ) );}
				}	
			}
		}
		else
		{
			Attack_Process_Direction();
		}

		umbral_slash_index = RandDifferent(this.previous_umbral_slash_index, 2);

		switch (umbral_slash_index) 
		{	
			case 1:
			PlayerPlayAnimation( 'man_geralt_sword_attack_fast_right_1_lp_40ms_forward_ACS');
			break;

			default:
			PlayerPlayAnimation( 'man_geralt_sword_attack_fast_left_1_rp_40ms_forward_ACS');
			break;
		}	

		this.previous_umbral_slash_index = umbral_slash_index;

		//thePlayer.SoundEvent("monster_dettlaff_monster_combat_geralt_deathblow_01");

		//thePlayer.SoundEvent("monster_dettlaff_monster_combat_geralt_deathblow_02");

		vACS_Umbral_Slash_Single = new cACS_Umbral_Slash_Single in this;
				
		vACS_Umbral_Slash_Single.ACS_Umbral_Slash_Single_Engage();
	}

	var vACS_Umbral_Slash_Single : cACS_Umbral_Slash_Single;

	function Sparagmos()
	{
		if (!thePlayer.IsActionAllowed(EIAB_Signs))
		{
			return;
		}

		ACS_Tutorial_Display_Check('ACS_Sparagmos_Tutorial_Shown');

		//thePlayer.PlayBattleCry( 'BattleCryAttack', 1, true, false );
		thePlayer.PlayEffectSingle('special_attack_break'); thePlayer.StopEffect('special_attack_break');

		RemoveTimer('Sparagmos_Deactivate');

		thePlayer.PlayEffectSingle('hit_lightning');
		thePlayer.StopEffect('hit_lightning');

		ACS_Attack_Trail('fast_attack_buff');

		ACS_Attack_Trail('fast_attack_buff_hit');

		MovementAdjust('default');

		if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	

		thePlayer.ACS_SetAnimationSpeedMultiplier( 0.25 );

		AddTimer('ACS_ResetAnimation', 1    , false);

		if( actor && ACS_AttitudeCheck ( actor ) && thePlayer.IsInCombat())
		{
			if ( ACS_Settings_Main_Int('acs_target_settings','acs_target_mode', 0) == 0 || ACS_Settings_Main_Int('acs_target_settings','acs_target_mode', 0) == 1 )
			{
				if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTowards( ticket, actor );}  
			}
			else if ( ACS_Settings_Main_Int('acs_target_settings','acs_target_mode', 0) == 2 )
			{
				if (thePlayer.IsHardLockEnabled())
				{
					if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTowards( ticket, actor );}  
				}
				else
				{
					if(!thePlayer.HasTag('ACS_Manual_Combat_Control')){thePlayer.AddTag('ACS_Manual_Combat_Control');} RemoveTimer('Manual_Combat_Control_Remove'); AddTimer('Manual_Combat_Control_Remove', 2 , false);//if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTo( ticket, VecHeading( theCamera.GetCameraDirection() ) );}
				}	
			}
		}
		else
		{
			Attack_Process_Direction();
		}

		sparagmos_index = RandDifferent(this.previous_sparagmos_index, 9);

		switch (sparagmos_index) 
		{
			case 8:
			PlayerPlayAnimation( 'man_npc_sword_2hand_attack_l_left_1_ACS');
			break;

			case 7:
			PlayerPlayAnimation( 'man_npc_sword_2hand_attack_h_up_1_ACS');
			break;

			case 6:
			PlayerPlayAnimation( 'man_npc_sword_2hand_attack_h_left_1_ACS');
			break;

			case 5:
			PlayerPlayAnimation( 'man_npc_sword_2hand_attack_l_2_ACS');
			break;

			case 4:
			PlayerPlayAnimation( 'man_npc_sword_2hand_attack_l_1_ACS');
			break;

			case 3:
			PlayerPlayAnimation( 'man_npc_sword_2hand_attack_h_1_ACS');
			break;

			case 2:
			PlayerPlayAnimation( 'man_npc_sword_2hand_attack_h_2_ACS');
			break;

			case 1:
			PlayerPlayAnimation( 'man_npc_sword_2hand_attack_l_up_1_ACS');
			break;

			default:
			PlayerPlayAnimation( 'man_npc_sword_2hand_attack_combo_stop_lll_1_ACS');
			break;
		}	

		this.previous_sparagmos_index = sparagmos_index;

		//thePlayer.SoundEvent("monster_dettlaff_monster_combat_geralt_deathblow_01");

		//thePlayer.SoundEvent("monster_dettlaff_monster_combat_geralt_deathblow_02");

		vACS_Sparagmos = new cACS_Sparagmos in this;
			
		vACS_Sparagmos.ACS_Sparagmos_Engage();

		ACS_Attack_Trail('light_trail_extended_fx');

		//AddTimer('ACS_Sparagmos_Electric_Effect', 0.1 , true);

		//AddTimer('ACS_Sparagmos_Damage_Delay', 0.2   , false);

		thePlayer.AddTag('ACS_Sparagmos_Active');

		AddTimer('Sparagmos_Deactivate', 2   , false);
	}

	var vACS_Sparagmos : cACS_Sparagmos;

	timer function ACS_Sparagmos_Electric_Effect(deltaTime : float , id : int)
	{
		eff_names.Clear();

		eff_names.PushBack('diagonal_up_left');
		eff_names.PushBack('diagonal_down_left');
		eff_names.PushBack('down');
		eff_names.PushBack('up');
		eff_names.PushBack('diagonal_up_right');
		eff_names.PushBack('diagonal_down_right');
		eff_names.PushBack('right');
		eff_names.PushBack('left');

		if (ACSGetCEntity('ACS_Sparagmos_Effect')
		&& ACSGetCEntity('ACS_Sparagmos_Effect_1')
		&& ACSGetCEntity('ACS_Sparagmos_Effect_2')
		&& ACSGetCEntity('ACS_Sparagmos_Effect_3')
		&& ACSGetCEntity('ACS_Sparagmos_Effect_4')
		&& ACSGetCEntity('ACS_Sparagmos_Effect_5')
		)
		{
			//ACSGetCEntity('ACS_Sparagmos_Effect').StopEffect('sword_slash_blue_large');
			//ACSGetCEntity('ACS_Sparagmos_Effect').PlayEffectSingle('sword_slash_blue_large');

			ACSGetCEntity('ACS_Sparagmos_Effect_2').PlayEffectSingle(eff_names[RandRange(eff_names.Size())]);
			ACSGetCEntity('ACS_Sparagmos_Effect_2').PlayEffectSingle(eff_names[RandRange(eff_names.Size())]);
			ACSGetCEntity('ACS_Sparagmos_Effect_2').PlayEffectSingle(eff_names[RandRange(eff_names.Size())]);

			ACSGetCEntity('ACS_Sparagmos_Effect_2').StopAllEffects();

			ACSGetCEntity('ACS_Sparagmos_Effect_3').PlayEffectSingle(eff_names[RandRange(eff_names.Size())]);
			ACSGetCEntity('ACS_Sparagmos_Effect_3').PlayEffectSingle(eff_names[RandRange(eff_names.Size())]);
			ACSGetCEntity('ACS_Sparagmos_Effect_3').PlayEffectSingle(eff_names[RandRange(eff_names.Size())]);

			ACSGetCEntity('ACS_Sparagmos_Effect_3').StopAllEffects();

			ACSGetCEntity('ACS_Sparagmos_Effect_4').PlayEffectSingle(eff_names[RandRange(eff_names.Size())]);
			ACSGetCEntity('ACS_Sparagmos_Effect_4').PlayEffectSingle(eff_names[RandRange(eff_names.Size())]);
			ACSGetCEntity('ACS_Sparagmos_Effect_4').PlayEffectSingle(eff_names[RandRange(eff_names.Size())]);

			ACSGetCEntity('ACS_Sparagmos_Effect_4').StopAllEffects();

			ACSGetCEntity('ACS_Sparagmos_Effect_5').PlayEffectSingle(eff_names[RandRange(eff_names.Size())]);
			ACSGetCEntity('ACS_Sparagmos_Effect_5').PlayEffectSingle(eff_names[RandRange(eff_names.Size())]);
			ACSGetCEntity('ACS_Sparagmos_Effect_5').PlayEffectSingle(eff_names[RandRange(eff_names.Size())]);

			ACSGetCEntity('ACS_Sparagmos_Effect_5').StopAllEffects();
		}
		else 
		{
			ACSGetCEntity('ACS_Sparagmos_Effect').Destroy();

			ACSGetCEntity('ACS_Sparagmos_Effect_1').Destroy();

			ACSGetCEntity('ACS_Sparagmos_Effect_2').Destroy();

			ACSGetCEntity('ACS_Sparagmos_Effect_3').Destroy();

			ACSGetCEntity('ACS_Sparagmos_Effect_4').Destroy();

			ACSGetCEntity('ACS_Sparagmos_Effect_5').Destroy();

			thePlayer.RemoveTag('ACS_Sparagmos_Active');

			RemoveTimer('ACS_Sparagmos_Electric_Effect');
		}

		if (!thePlayer.HasTag('acs_axii_sword_equipped'))
		{
			ACSGetCEntity('ACS_Sparagmos_Effect').Destroy();

			ACSGetCEntity('ACS_Sparagmos_Effect_1').Destroy();

			ACSGetCEntity('ACS_Sparagmos_Effect_2').Destroy();

			ACSGetCEntity('ACS_Sparagmos_Effect_3').Destroy();

			ACSGetCEntity('ACS_Sparagmos_Effect_4').Destroy();

			ACSGetCEntity('ACS_Sparagmos_Effect_5').Destroy();

			thePlayer.RemoveTag('ACS_Sparagmos_Active');

			RemoveTimer('ACS_Sparagmos_Electric_Effect');
		}
	}

	timer function Sparagmos_Deactivate (deltaTime : float , id : int)
	{
		thePlayer.RemoveTag('ACS_Sparagmos_Active');

		ACSGetCEntity('ACS_Sparagmos_Effect').Destroy();

		ACSGetCEntity('ACS_Sparagmos_Effect_1').Destroy();

		ACSGetCEntity('ACS_Sparagmos_Effect_2').Destroy();

		ACSGetCEntity('ACS_Sparagmos_Effect_3').Destroy();

		ACSGetCEntity('ACS_Sparagmos_Effect_4').Destroy();

		ACSGetCEntity('ACS_Sparagmos_Effect_5').Destroy();

		RemoveTimer('ACS_Sparagmos_Electric_Effect');
	}

	timer function ACS_Sparagmos_Damage_Delay (deltaTime : float , id : int)
	{
		vACS_Sparagmos = new cACS_Sparagmos in this;
			
		vACS_Sparagmos.ACS_Sparagmos_Damage_Engage();
	}

	function Bruxa_Scream()
	{
		if (!thePlayer.IsActionAllowed(EIAB_Signs))
		{
			return;
		}

		MovementAdjust('default');

		if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	

		if( actor && ACS_AttitudeCheck ( actor ) && thePlayer.IsInCombat())
		{
			if ( ACS_Settings_Main_Int('acs_target_settings','acs_target_mode', 0) == 0 || ACS_Settings_Main_Int('acs_target_settings','acs_target_mode', 0) == 1 )
			{
				if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTowards( ticket, actor );}  
			}
			else if ( ACS_Settings_Main_Int('acs_target_settings','acs_target_mode', 0) == 2 )
			{
				if (thePlayer.IsHardLockEnabled())
				{
					if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTowards( ticket, actor );}  
				}
				else
				{
					if(!thePlayer.HasTag('ACS_Manual_Combat_Control')){thePlayer.AddTag('ACS_Manual_Combat_Control');} RemoveTimer('Manual_Combat_Control_Remove'); AddTimer('Manual_Combat_Control_Remove', 2 , false);//if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTo( ticket, VecHeading( theCamera.GetCameraDirection() ) );}
				}	
			}
		}
		else
		{
			Attack_Process_Direction();
		}

		if (thePlayer.HasTag('acs_vampire_claws_equipped'))
		{
			ACS_Tutorial_Display_Check('ACS_Sonic_Scream_Tutorial_Shown');

			if ( thePlayer.HasBuff(EET_BlackBlood) )
			{
				thePlayer.PlayEffectSingle('special_attack_break'); thePlayer.StopEffect('special_attack_break');
				PlayerPlayAnimation ( 'bruxa_taunt_02_ACS');
			}
			else	
			{
				PlayerPlayAnimation ( 'bruxa_taunt_01_ACS');
			}

			vACS_Bruxa_Scream = new cACS_Bruxa_Scream in this;
			
			vACS_Bruxa_Scream.ACS_Bruxa_Scream_Engage();
		}
		else if (thePlayer.HasTag('acs_aard_sword_equipped'))
		{
			ACS_Tutorial_Display_Check('ACS_Vampire_Bat_Swarm_Tutorial_Shown');

			thePlayer.PlayEffectSingle('special_attack_break'); thePlayer.StopEffect('special_attack_break');

			PlayerPlayAnimation ( 'attack_special_strong_uppercut_ACS');

			RemoveTimer('BloodSpikesDelay');
			AddTimer('BloodSpikesDelay', 1   , false);
		}
	}

	var vACS_Bruxa_Scream : cACS_Bruxa_Scream;


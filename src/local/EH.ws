					thePlayer.RaiseEvent( 'spursKick' );
				}
				else
				{
					thePlayer.RaiseEvent( 'spursKickHard' );
				}

				horseMotionLeaningActiveReset = false;
			}

			if(!(thePlayer.GetHorseCurrentlyMounted()).IsOnGround()
			&& (thePlayer.GetHorseCurrentlyMounted().GetHorseComponent()).IsFullyMounted())
			{
				horseTicket = horseMovementAdjust.GetRequest( 'ACS_Horse_Increase_Speed');
				horseMovementAdjust.CancelByName( 'ACS_Horse_Increase_Speed' );
				horseMovementAdjust.CancelAll();

				if (cam_direction != 0
				)
				{
					horseTicket = horseMovementAdjust.CreateNewRequest( 'ACS_Horse_Increase_Speed' );
					horseMovementAdjust.AdjustmentDuration( horseTicket, 0.1 );
					horseMovementAdjust.MaxRotationAdjustmentSpeed( horseTicket, 50000000 );

					horseMovementAdjust.RotateTo( horseTicket, VecHeading( theCamera.GetCameraDirection() ) );
				}
			}

			if(hLean.Roll < 0)
			{
				hLean.Roll += 0.25;
			}
			else if(hLean.Roll > 0)
			{
				hLean.Roll -= 0.25;
			}
			else
			{
				hLean.Roll = 0;
			}

			((CMovingPhysicalAgentComponent)((thePlayer.GetHorseCurrentlyMounted()).GetMovingAgentComponent())).SetRotation(hLean);

			((CMovingPhysicalAgentComponent)(thePlayer.GetMovingAgentComponent())).SetRotation(hLean);

			return;
		}

		if (ACS_Settings_Main_Bool('acs_horse_settings','acs_horse_motion_leaning_enabled', true))
		{
			if (
			(thePlayer.GetHorseCurrentlyMounted().GetHorseComponent()).inCanter)
			{
				if (!horseMotionLeaningActive
				)
				{
					horseMotionLeaningActive = true;
				}

				if( cam_direction < 0 )
				{
					if (horseMotionLeaningActiveReset)
					{
						if (RandF() < 0.5)
						{
							thePlayer.RaiseEvent( 'spursKick' );
						}
						else
						{
							thePlayer.RaiseEvent( 'spursKickHard' );
						}
						
						horseMotionLeaningActiveReset = false;
					}
					
					hLean.Roll -= lean_roll_modifier;

					if(hLean.Roll < -10)
					{
						hLean.Roll = -10;
					}

					((CMovingPhysicalAgentComponent)((thePlayer.GetHorseCurrentlyMounted()).GetMovingAgentComponent())).SetRotation(hLean);

					((CMovingPhysicalAgentComponent)(thePlayer.GetMovingAgentComponent())).SetRotation(hLean);
				}
				else if(theInput.GetActionValue('GI_AxisLeftX') > 0
				)

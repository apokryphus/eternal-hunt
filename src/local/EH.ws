				if (HudSettingsCheck('WolfHeadModule'))
				{
					hudWolfHeadModule.SetAlwaysDisplayed(true);
					hudWolfHeadModule.SetEnabled(true);

					if (FactsQuerySum("ACS_WolfHeadHud_Module_Hide") > 0)
					{
						RemoveTimer('WolfHeadHudModuleDespawnDelay');

						RemoveTimer('WolfHeadHudModuleFadeFlashObjectOut');

						wolfsHeadHudAlpha = 100;

						if (ACS_Settings_Main_Bool('acs_hud_settings_main','acs_hud_animation_enabled', true) 
						&& !ACS_Settings_Main_Bool('acs_hud_settings_positioning_all','acs_hud_positioning_enabled', false)
						&& StringToInt(theGame.GetInGameConfigWrapper().GetVarValue('Hud', 'HudSize'), 0) == 0
						&& !wolfsHeadHudAlphaMinProcess)
						{
							hudWolfHeadModule.GetModuleFlash().SetAlpha( 0 );
							RemoveTimer('WolfHeadHudModuleFadeFlashObjectIn');
							AddTimer('WolfHeadHudModuleFadeFlashObjectIn', 0.01 , true);
						}
						else
						{
							hudWolfHeadModule.GetModuleFlash().SetAlpha( 100 );
						}

						if (FactsQuerySum("ACS_WolfHeadHud_Module_Shown") > 0)
						{
							FactsRemove("ACS_WolfHeadHud_Module_Shown");
						}

						if (FactsQuerySum("ACS_WolfHeadHud_Module_Fading") > 0)
						{
							FactsRemove("ACS_WolfHeadHud_Module_Fading");
						}

						FactsRemove("ACS_WolfHeadHud_Module_Hide");
					}
					else if (FactsQuerySum("ACS_WolfHeadHud_Module_Hide") <= 0)
					{
						if (!hudWolfHeadModule.GetEnabled())
						{
							FactsAdd("ACS_WolfHeadHud_Module_Hide", 1, -1);
						}
					}
				}
				
				if (HudSettingsCheck('ItemInfoModule'))
				{
					hudItemModule.SetAlwaysDisplayed(true);
					hudItemModule.SetEnabled(true);

					if (FactsQuerySum("ACS_ItemHud_Module_Hide") > 0)
					{
						RemoveTimer('ItemHudModuleDespawnDelay');

						RemoveTimer('ItemHudModuleFadeFlashObjectOut');

						itemsHudAlpha = 100;

						if (ACS_Settings_Main_Bool('acs_hud_settings_main','acs_hud_animation_enabled', true) 
						&& !ACS_Settings_Main_Bool('acs_hud_settings_positioning_all','acs_hud_positioning_enabled', false)
						&& StringToInt(theGame.GetInGameConfigWrapper().GetVarValue('Hud', 'HudSize'), 0) == 0
						&& !itemsHudAlphaMinProcess)
						{
							hudItemModule.GetModuleFlash().SetAlpha( 0 );
							RemoveTimer('ItemHudModuleFadeFlashObjectIn');
							AddTimer('ItemHudModuleFadeFlashObjectIn', 0.01 , true);
						}
						else
						{
							hudItemModule.GetModuleFlash().SetAlpha( 100 );
						}

						if (FactsQuerySum("ACS_ItemHud_Module_Shown") > 0)
						{
							FactsRemove("ACS_ItemHud_Module_Shown");
						}

						if (FactsQuerySum("ACS_ItemHud_Module_Fading") > 0)
						{
							FactsRemove("ACS_ItemHud_Module_Fading");
						}

						FactsRemove("ACS_ItemHud_Module_Hide");
					}
					else if (FactsQuerySum("ACS_ItemHud_Module_Hide") <= 0)
					{
						if (!hudItemModule.GetEnabled())
						{
							FactsAdd("ACS_ItemHud_Module_Hide", 1, -1);
						}
					}
				}
			}
			else
			{
				if ( FactsQuerySum("ACS_Minimap_Module_Hide") <= 0 )
				{
					RemoveTimer('MinimapModuleDespawnDelay');
					AddTimer('MinimapModuleDespawnDelay', ACS_Settings_Main_Float('acs_hud_settings_main','acs_hud_elements_despawn_delay', 7) , false);

					FactsAdd("ACS_Minimap_Module_Hide", 1, -1);
				}

				if ( FactsQuerySum("ACS_Quest_Module_Hide") <= 0 )
				{
					RemoveTimer('QuestModuleDespawnDelay');
					AddTimer('QuestModuleDespawnDelay', ACS_Settings_Main_Float('acs_hud_settings_main','acs_hud_elements_despawn_delay', 7) , false);

					FactsAdd("ACS_Quest_Module_Hide", 1, -1);
				}

				if ( FactsQuerySum("ACS_Control_Hint_Module_Hide") <= 0 )
				{
					RemoveTimer('ControlHintModuleDespawnDelay');
					AddTimer('ControlHintModuleDespawnDelay', ACS_Settings_Main_Float('acs_hud_settings_main','acs_hud_elements_despawn_delay', 7) , false);

					FactsAdd("ACS_Control_Hint_Module_Hide", 1, -1);
				}

				if ( FactsQuerySum("ACS_Buffs_Module_Hide") <= 0 )
				{
					RemoveTimer('BuffsModuleDespawnDelay');
					AddTimer('BuffsModuleDespawnDelay', ACS_Settings_Main_Float('acs_hud_settings_main','acs_hud_elements_despawn_delay', 7) , false);

					FactsAdd("ACS_Buffs_Module_Hide", 1, -1);
				}

				if ( FactsQuerySum("ACS_WolfHeadHud_Module_Hide") <= 0 )
				{
					RemoveTimer('WolfHeadHudModuleDespawnDelay');

					if (FactsQuerySum("ACS_WolfHeadHud_Module_Shown") <= 0)
					{
						FactsAdd("ACS_WolfHeadHud_Module_Shown", 1, -1);
					}

					if (FactsQuerySum("ACS_WolfHeadHud_Module_Fading") > 0)
					{
						FactsRemove("ACS_WolfHeadHud_Module_Fading");
					}

					AddTimer('WolfHeadHudModuleDespawnDelay', ACS_Settings_Main_Float('acs_hud_settings_main','acs_hud_elements_despawn_delay', 7) , false);

					FactsAdd("ACS_WolfHeadHud_Module_Hide", 1, -1);
				}

				if 
				(HudSettingsCheck('WolfHeadModule') && FactsQuerySum("ACS_WolfHeadHud_Module_Shown") > 0 
				)
				{
					hudWolfHeadModule.SetAlwaysDisplayed(true);
					hudWolfHeadModule.SetEnabled(true);
				}

				if ( FactsQuerySum("ACS_ItemHud_Module_Hide") <= 0 )
				{
					RemoveTimer('ItemHudModuleDespawnDelay');

					if (FactsQuerySum("ACS_ItemHud_Module_Shown") <= 0)
					{
						FactsAdd("ACS_ItemHud_Module_Shown", 1, -1);
					}

					if (FactsQuerySum("ACS_ItemHud_Module_Fading") > 0)
					{
						FactsRemove("ACS_ItemHud_Module_Fading");
					}

					AddTimer('ItemHudModuleDespawnDelay', ACS_Settings_Main_Float('acs_hud_settings_main','acs_hud_elements_despawn_delay', 7) , false);

					FactsAdd("ACS_ItemHud_Module_Hide", 1, -1);
				}

				if 
				(HudSettingsCheck('ItemInfoModule') && FactsQuerySum("ACS_ItemHud_Module_Shown") > 0 
				)
				{
					hudItemModule.SetAlwaysDisplayed(true);
					hudItemModule.SetEnabled(true);
				}
			}
		}

		hud.UpdateHUD();
	}

	var steel_sword_hidden : bool;
	var silver_sword_hidden : bool;

	var crossbow_hidden : bool;

	var steel_scabbard_hidden : bool;
	var silver_scabbard_hidden : bool;

	var alternate_steel_scabbard_enabled : bool;
	var alternate_silver_scabbard_enabled : bool;
	

	timer function SetScabbardFlag( time : float , id : int )
	{
		steel_scabbard_hidden = false;

		silver_scabbard_hidden = false;

		steel_sword_hidden = false;

		silver_sword_hidden = false;

		crossbow_hidden = false;

		alternate_steel_scabbard_enabled = false;

		AlternateSteelScabbardManage(false);

		alternate_silver_scabbard_enabled = false;

		AlternateSilverScabbardManage(false);
	}

	function SteelSwordHide( b : bool )
	{
		var steelID																		: SItemUniqueId;
		var steelswordentity 															: CEntity;
		var steelsword																	: CDrawableComponent;

		GetWitcherPlayer().GetItemEquippedOnSlot(EES_SteelSword, steelID);

		steelsword = (CDrawableComponent)((GetWitcherPlayer().GetInventory().GetItemEntityUnsafe(steelID)).GetMeshComponent());

		steelswordentity = thePlayer.GetInventory().GetItemEntityUnsafe(steelID);

		if (!GetWitcherPlayer().IsAnyItemEquippedOnSlot(EES_SteelSword)
		)
		{
			steelswordentity.SetHideInGame(true); 
			steelsword.SetVisible(false);
		}
		else
		{
			steelswordentity.SetHideInGame(b); 
			steelsword.SetVisible(!b);
		}
	}

	function SteelSwordScabbardSetVisible( b : bool )
	{
		var scabbard_steel																: CDrawableComponent;
		var scabbards_steel 															: array<SItemUniqueId>;
		var i																			: int;
	
		scabbards_steel = thePlayer.GetInventory().GetItemsByCategory('steel_scabbards');

		for ( i=0; i < scabbards_steel.Size() ; i+=1 )
		{
			scabbard_steel = (CDrawableComponent)((thePlayer.GetInventory().GetItemEntityUnsafe(scabbards_steel[i])).GetMeshComponent());

			if (!GetWitcherPlayer().IsAnyItemEquippedOnSlot(EES_SteelSword))
			{
				scabbard_steel.SetVisible(false);
			}
			else
			{
				scabbard_steel.SetVisible(b);
			}
		}
	}

	function SilverSwordHide( b : bool )
	{
		var silverID																		: SItemUniqueId;
		var silverswordentity 																: CEntity;
		var silversword																		: CDrawableComponent;

		GetWitcherPlayer().GetItemEquippedOnSlot(EES_SilverSword, silverID);

		silversword = (CDrawableComponent)((GetWitcherPlayer().GetInventory().GetItemEntityUnsafe(silverID)).GetMeshComponent());

		silverswordentity = thePlayer.GetInventory().GetItemEntityUnsafe(silverID);

		if (!GetWitcherPlayer().IsAnyItemEquippedOnSlot(EES_SilverSword))
		{
			silverswordentity.SetHideInGame(true); 
			silversword.SetVisible(false);
		}
		else
		{
			silverswordentity.SetHideInGame(b); 
			silversword.SetVisible(!b);
		}
	}

	function SilverSwordScabbardSetVisible( b : bool )
	{
		var scabbard_silver																: CDrawableComponent;
		var scabbards_silver 															: array<SItemUniqueId>;
		var i																			: int;

		scabbards_silver = thePlayer.GetInventory().GetItemsByCategory('silver_scabbards');

		for ( i=0; i < scabbards_silver.Size() ; i+=1 )
		{
			scabbard_silver = (CDrawableComponent)((thePlayer.GetInventory().GetItemEntityUnsafe(scabbards_silver[i])).GetMeshComponent());

			if (!GetWitcherPlayer().IsAnyItemEquippedOnSlot(EES_SilverSword))
			{
				scabbard_silver.SetVisible(false);
			}
			else
			{
				scabbard_silver.SetVisible(b);
			}
		}
	}

	function CrossbowHide( b : bool )
	{
		var rangedID 				: SItemUniqueId;
		var crossbowentity			: CEntity;

		GetWitcherPlayer().GetItemEquippedOnSlot(EES_RangedWeapon, rangedID);

		crossbowentity = thePlayer.GetInventory().GetItemEntityUnsafe(rangedID);

		if (!GetWitcherPlayer().IsAnyItemEquippedOnSlot(EES_RangedWeapon))
		{
			crossbowentity.SetHideInGame(true);
		}
		else
		{
			if (b)
			{
				thePlayer.rangedWeapon.ClearDeployedEntity(true);
			}

			crossbowentity.SetHideInGame(b);
		}
			
	}

	function AlternateSteelScabbardManage(load: bool)
	{
		var p_comp				: CComponent;
		var temp 				: CEntityTemplate;
		var temp_path			: String;
		var temp_path_array		: array<String>;
		var i 					: int;

		p_comp = thePlayer.GetComponentByClassName( 'CAppearanceComponent' );

		if (load)
		{
			switch(ACS_Settings_Main_Int('acs_player_equipment_visual_settings','acs_alternate_scabbard_steel_style', 0))
			{
				default:
				case 0:
					if (ACS_Armor_Set_Check('wolf', false))
					{
						temp_path = "dlc\dlc10\data\items\weapons\swords\witcher_steel_swords\witcher_steel_wolf_scabbard.w2ent";
					}
					else if (ACS_Armor_Set_Check('bear', false))
					{
						temp_path = "items\weapons\swords\witcher_steel_scabbards\witcher_steel_bear_scabbard.w2ent";
					}
					else if (ACS_Armor_Set_Check('cat', false))
					{
						temp_path = "items\weapons\swords\witcher_steel_scabbards\witcher_steel_lynx_scabbard.w2ent";
					}
					else if (ACS_Armor_Set_Check('griffin', false))
					{
						temp_path = "items\weapons\swords\witcher_steel_scabbards\witcher_steel_gryphon_scabbard.w2ent";
					}
					else if (ACS_Armor_Set_Check('manticore', false))
					{
						temp_path = "dlc\dlc10\data\items\weapons\swords\witcher_steel_swords\witcher_steel_wolf_scabbard.w2ent";
					}
					else if (ACS_Armor_Set_Check('forgotten_wolf', false))
					{
						temp_path = "items\weapons\swords\witcher_steel_scabbards\witcher_steel_netflix_scabbard.w2ent";
					}
					else if (ACS_Armor_Set_Check('viper', false))
					{
						temp_path = "items\weapons\swords\witcher_steel_scabbards\witcher_steel_bear_scabbard.w2ent";
					}
					else
					{
						temp_path = "items\bodyparts\geralt_items\scabbards\steel_scabbards\scabbard_steel_3_07.w2ent";
					}
				break;

				case 1:
					temp_path = "dlc\dlc10\data\items\weapons\swords\witcher_steel_swords\witcher_steel_wolf_scabbard.w2ent";
				break;

				case 2:
					temp_path = "items\weapons\swords\witcher_steel_scabbards\witcher_steel_bear_scabbard.w2ent";
				break;

				case 3:
					temp_path = "items\weapons\swords\witcher_steel_scabbards\witcher_steel_lynx_scabbard.w2ent";
				break;

				case 4:
					temp_path = "items\weapons\swords\witcher_steel_scabbards\witcher_steel_gryphon_scabbard.w2ent";
				break;

				case 5:
					temp_path = "dlc\dlc10\data\items\weapons\swords\witcher_steel_swords\witcher_steel_wolf_scabbard.w2ent";
				break;

				case 6:
					temp_path = "items\weapons\swords\witcher_steel_scabbards\witcher_steel_netflix_scabbard.w2ent";
				break;

				case 7:
					temp_path = "items\weapons\swords\witcher_steel_scabbards\witcher_steel_bear_scabbard.w2ent";
				break;

				case 8:
					temp_path = "items\bodyparts\geralt_items\scabbards\steel_scabbards\scabbard_steel_3_07.w2ent";
				break;
			}

			temp = (CEntityTemplate)LoadResource(

			temp_path
			
			, true);
			
			((CAppearanceComponent)p_comp).IncludeAppearanceTemplate(temp);

			return;
		}

		if (!load)
		{
			temp_path_array.Clear();
			temp_path_array.PushBack("dlc\dlc10\data\items\weapons\swords\witcher_steel_swords\witcher_steel_wolf_scabbard.w2ent");
			temp_path_array.PushBack("items\weapons\swords\witcher_steel_scabbards\witcher_steel_bear_scabbard.w2ent");
			temp_path_array.PushBack("items\weapons\swords\witcher_steel_scabbards\witcher_steel_lynx_scabbard.w2ent");
			temp_path_array.PushBack("items\weapons\swords\witcher_steel_scabbards\witcher_steel_gryphon_scabbard.w2ent");
			temp_path_array.PushBack("items\weapons\swords\witcher_steel_scabbards\witcher_steel_netflix_scabbard.w2ent");
			temp_path_array.PushBack("items\bodyparts\geralt_items\scabbards\steel_scabbards\scabbard_steel_3_07.w2ent");

			for (i = 0; i<temp_path_array.Size(); i += 1) 
			{
				temp = (CEntityTemplate)LoadResource(

				temp_path_array[i]
				
				, true);

				((CAppearanceComponent)p_comp).ExcludeAppearanceTemplate(temp);
			}
		}
	}

	function AlternateSilverScabbardManage(load: bool)
	{
		var p_comp				: CComponent;
		var temp 				: CEntityTemplate;
		var temp_path			: String;
		var temp_path_array		: array<String>;
		var i 					: int;

		p_comp = thePlayer.GetComponentByClassName( 'CAppearanceComponent' );

		if (load)
		{	
			switch(ACS_Settings_Main_Int('acs_player_equipment_visual_settings','acs_alternate_scabbard_silver_style', 0))
			{
				default:
				case 0:
					if (ACS_Armor_Set_Check('wolf', false))
					{
						temp_path = "dlc\dlc10\data\items\weapons\swords\witcher_silver_swords\witcher_silver_wolf_scabbard.w2ent";
					}
					else if (ACS_Armor_Set_Check('bear', false))
					{
						temp_path = "items\weapons\swords\witcher_silver_scabbards\witcher_silver_bear_scabbard.w2ent";
					}
					else if (ACS_Armor_Set_Check('cat', false))
					{
						temp_path = "items\weapons\swords\witcher_silver_scabbards\witcher_silver_lynx_scabbard.w2ent";
					}
					else if (ACS_Armor_Set_Check('griffin', false))
					{
						temp_path = "items\weapons\swords\witcher_silver_scabbards\witcher_silver_gryphon_scabbard.w2ent";
					}
					else if (ACS_Armor_Set_Check('manticore', false))
					{
						temp_path = "dlc\dlc10\data\items\weapons\swords\witcher_silver_swords\witcher_silver_wolf_scabbard.w2ent";
					}
					else if (ACS_Armor_Set_Check('forgotten_wolf', false))
					{
						temp_path = "items\weapons\swords\witcher_silver_scabbards\witcher_silver_netflix_scabbard.w2ent";
					}
					else if (ACS_Armor_Set_Check('viper', false))
					{
						temp_path = "items\weapons\swords\witcher_silver_scabbards\witcher_silver_bear_scabbard.w2ent";
					}
					else
					{
						temp_path = "items\bodyparts\geralt_items\scabbards\silver_scabbards\scabbard_silver_3_07.w2ent";
					}
				break;

				case 1:
					temp_path = "dlc\dlc10\data\items\weapons\swords\witcher_silver_swords\witcher_silver_wolf_scabbard.w2ent";
				break;

				case 2:
					temp_path = "items\weapons\swords\witcher_silver_scabbards\witcher_silver_bear_scabbard.w2ent";
				break;

				case 3:
					temp_path = "items\weapons\swords\witcher_silver_scabbards\witcher_silver_lynx_scabbard.w2ent";
				break;

				case 4:
					temp_path = "items\weapons\swords\witcher_silver_scabbards\witcher_silver_gryphon_scabbard.w2ent";
				break;

				case 5:
					temp_path = "dlc\dlc10\data\items\weapons\swords\witcher_silver_swords\witcher_silver_wolf_scabbard.w2ent";
				break;

				case 6:
					temp_path = "items\weapons\swords\witcher_silver_scabbards\witcher_silver_netflix_scabbard.w2ent";
				break;

				case 7:
					temp_path = "items\weapons\swords\witcher_silver_scabbards\witcher_silver_bear_scabbard.w2ent";
				break;

				case 8:
					temp_path = "items\bodyparts\geralt_items\scabbards\silver_scabbards\scabbard_silver_3_07.w2ent";
				break;
			}

			temp = (CEntityTemplate)LoadResource(

			temp_path
			
			, true);

			((CAppearanceComponent)p_comp).IncludeAppearanceTemplate(temp);

			return;
		}

		if (!load)
		{
			temp_path_array.Clear();
			temp_path_array.PushBack("dlc\dlc10\data\items\weapons\swords\witcher_silver_swords\witcher_silver_wolf_scabbard.w2ent");
			temp_path_array.PushBack("items\weapons\swords\witcher_silver_scabbards\witcher_silver_bear_scabbard.w2ent");
			temp_path_array.PushBack("items\weapons\swords\witcher_silver_scabbards\witcher_silver_lynx_scabbard.w2ent");
			temp_path_array.PushBack("items\weapons\swords\witcher_silver_scabbards\witcher_silver_gryphon_scabbard.w2ent");
			temp_path_array.PushBack("items\weapons\swords\witcher_silver_scabbards\witcher_silver_netflix_scabbard.w2ent");
			temp_path_array.PushBack("items\bodyparts\geralt_items\scabbards\silver_scabbards\scabbard_silver_3_07.w2ent");

			for (i = 0; i<temp_path_array.Size(); i += 1) 
			{
				temp = (CEntityTemplate)LoadResource(

				temp_path_array[i]
				
				, true);

				((CAppearanceComponent)p_comp).ExcludeAppearanceTemplate(temp);
			}
		}
	}

	function BowQuiverLoad()
	{
		var boneIndex 										: int;
		var boneName 										: name;
		var boneRotation									: EulerAngles;
		var bonePosition									: Vector;
		var anchor, quiver, vfxEnt2							: CEntity;
		var eff_names										: array<CName>;

		if (!ACSGetCEntity('ACS_Bow_Quiver_Anchor'))
		{
			anchor = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource("dlc\dlc_acs\data\entities\other\fx_ent.w2ent", true), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );
			anchor.AddTag('ACS_Bow_Quiver_Anchor');

			boneIndex = thePlayer.GetBoneIndex( 'torso3' );	
			thePlayer.GetBoneWorldPositionAndRotationByIndex( boneIndex, bonePosition, boneRotation );
			anchor.CreateAttachmentAtBoneWS(thePlayer, 'torso3', bonePosition, boneRotation );
		}

		if (!ACSGetCEntity('ACS_Bow_Quiver') && ACSGetCEntity('ACS_Bow_Quiver_Anchor') )
		{
			quiver = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource("dlc\dlc_acs\data\models\bow_quiver\acs_bow_quiver.w2ent", true), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );
			quiver.AddTag('ACS_Bow_Quiver');
			quiver.CreateAttachment(ACSGetCEntity('ACS_Bow_Quiver_Anchor'), , Vector( -1.4, 0, -0.05 ), EulerAngles(0,0,90));
			quiver.PlayEffect('ghost_06');

			vfxEnt2 = theGame.CreateEntity( (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent", true ), GetWitcherPlayer().GetWorldPosition() );

			vfxEnt2.CreateAttachment( quiver );

			eff_names.Clear();

			eff_names.PushBack('diagonal_up_left_wraith');
			eff_names.PushBack('diagonal_down_left_wraith');
			eff_names.PushBack('down_wraith');
			eff_names.PushBack('up_wraith');
			eff_names.PushBack('diagonal_up_right_wraith');
			eff_names.PushBack('diagonal_down_right_wraith');
			eff_names.PushBack('right_wraith');
			eff_names.PushBack('left_wraith');
			
			vfxEnt2.PlayEffectSingle(eff_names[RandRange(eff_names.Size())]);

			vfxEnt2.DestroyAfter(2);
		}
	}

	function BowQuiverUnload()
	{
		var steelID																			: SItemUniqueId;
		var steelswordentity 																: CEntity;
		var silverID																		: SItemUniqueId;
		var silverswordentity 																: CEntity;
		var steelsword, silversword															: CDrawableComponent;
		var vfxEnt2																			: CEntity;
		var eff_names																		: array<CName>;

		if (ACSGetCEntity('ACS_Bow_Quiver_Anchor'))
		{
			ACSGetCEntity('ACS_Bow_Quiver_Anchor').BreakAttachment();
			ACSGetCEntity('ACS_Bow_Quiver_Anchor').Teleport(thePlayer.GetWorldPosition() + Vector(0,0,-200));
			ACSGetCEntity('ACS_Bow_Quiver_Anchor').DestroyAfter(0.125);
			ACSGetCEntity('ACS_Bow_Quiver_Anchor').RemoveTag('ACS_Bow_Quiver_Anchor');
		}

		if (ACSGetCEntity('ACS_Bow_Quiver'))
		{
			ACSGetCEntity('ACS_Bow_Quiver').BreakAttachment();
			ACSGetCEntity('ACS_Bow_Quiver').Teleport(thePlayer.GetWorldPosition() + Vector(0,0,-200));
			ACSGetCEntity('ACS_Bow_Quiver').DestroyAfter(0.125);
			ACSGetCEntity('ACS_Bow_Quiver').RemoveTag('ACS_Bow_Quiver');

			GetWitcherPlayer().GetItemEquippedOnSlot(EES_SilverSword, silverID);

			GetWitcherPlayer().GetItemEquippedOnSlot(EES_SteelSword, steelID);

			steelsword = (CDrawableComponent)((GetWitcherPlayer().GetInventory().GetItemEntityUnsafe(steelID)).GetMeshComponent());
			silversword = (CDrawableComponent)((GetWitcherPlayer().GetInventory().GetItemEntityUnsafe(silverID)).GetMeshComponent());

			steelswordentity = thePlayer.GetInventory().GetItemEntityUnsafe(steelID);

			silverswordentity = thePlayer.GetInventory().GetItemEntityUnsafe(silverID);

			steelswordentity.SetHideInGame(false); 

			silverswordentity.SetHideInGame(false);

			steelsword.SetVisible(true);

			silversword.SetVisible(true);

			vfxEnt2 = theGame.CreateEntity( (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent", true ), GetWitcherPlayer().GetWorldPosition() );

			vfxEnt2.CreateAttachment( thePlayer, 'blood_point' );

			eff_names.Clear();

			eff_names.PushBack('diagonal_up_left_wraith');
			eff_names.PushBack('diagonal_down_left_wraith');
			eff_names.PushBack('down_wraith');
			eff_names.PushBack('up_wraith');
			eff_names.PushBack('diagonal_up_right_wraith');
			eff_names.PushBack('diagonal_down_right_wraith');
			eff_names.PushBack('right_wraith');
			eff_names.PushBack('left_wraith');
			
			vfxEnt2.PlayEffectSingle(eff_names[RandRange(eff_names.Size())]);

			vfxEnt2.DestroyAfter(2);
		}
	}

	function Scabbard_Thing()
	{
		var steelID, silverID									: SItemUniqueId;

		GetWitcherPlayer().GetItemEquippedOnSlot(EES_SteelSword, steelID);

		GetWitcherPlayer().GetItemEquippedOnSlot(EES_SilverSword, silverID);

		if ( 
		ACS_GetWeaponMode() == 0
		|| ACS_GetWeaponMode() == 1
		|| ACS_GetWeaponMode() == 2
		)
		{
			if (
			thePlayer.HasTag('acs_axii_sword_equipped')	
			|| thePlayer.HasTag('acs_aard_sword_equipped')	
			|| thePlayer.HasTag('acs_yrden_sword_equipped')	
			|| thePlayer.HasTag('acs_quen_sword_equipped')
			|| thePlayer.HasTag('acs_axii_secondary_sword_equipped')
			|| thePlayer.HasTag('acs_aard_secondary_sword_equipped')
			|| thePlayer.HasTag('acs_yrden_secondary_sword_equipped')
			|| thePlayer.HasTag('acs_quen_secondary_sword_equipped')
			|| ACSGetCEntity('ACS_Armor_Ether_Sword') 
			)	
			{
				if ( thePlayer.GetInventory().IsItemHeld(steelID) )
				{
					if (!steel_sword_hidden)
					{
						SteelSwordHide(true);

						steel_sword_hidden = true;
					}
				}
				else if( !thePlayer.GetInventory().IsItemHeld(steelID) )
				{
					if (
					ACS_CloakEquippedCheck() 
					|| ACS_CheckWeaponShouldExistOnHip('both')
					|| ACS_Settings_Main_Bool('acs_player_equipment_visual_settings','acs_hide_sword_sheathes', false)
					|| FactsQuerySum("ACS_Cloak_Equipped") > 0
					|| (FactsQuerySum("ACS_In_Meditation") > 0 
					&& (!thePlayer.IsAnyWeaponHeld() || thePlayer.IsWeaponHeld('fist'))
					&& ACS_Settings_Main_Bool('acs_meditation_settings','acs_meditation_items_enabled', true)
					&& ACS_Settings_Main_Bool('acs_meditation_settings','acs_meditation_weapons_on_ground_enabled', true)
					&& !thePlayer.IsInInterior()
					)
					)
					{

					}
					else
					{
						if (steel_sword_hidden)
						{
							SteelSwordHide(false);

							steel_sword_hidden = false;
						}
					}
				}

				if( thePlayer.GetInventory().IsItemHeld(silverID) )
				{
					if (!silver_sword_hidden)
					{
						SilverSwordHide(true);

						silver_sword_hidden = true;
					}
				}
				else if( !thePlayer.GetInventory().IsItemHeld(silverID) )
				{
					if (
					ACS_CloakEquippedCheck()
					|| ACS_CheckWeaponShouldExistOnHip('both')
					|| ACS_Settings_Main_Bool('acs_player_equipment_visual_settings','acs_hide_sword_sheathes', false)
					|| FactsQuerySum("ACS_Cloak_Equipped") > 0
					|| (FactsQuerySum("ACS_In_Meditation") > 0 
					&& (!thePlayer.IsAnyWeaponHeld() || thePlayer.IsWeaponHeld('fist'))
					&& ACS_Settings_Main_Bool('acs_meditation_settings','acs_meditation_items_enabled', true)
					&& ACS_Settings_Main_Bool('acs_meditation_settings','acs_meditation_weapons_on_ground_enabled', true)
					&& !thePlayer.IsInInterior()
					)
					)
					{

					}
					else
					{
						if (silver_sword_hidden)
						{
							SilverSwordHide(false);

							silver_sword_hidden = false;
						}
					}
				}

				ACSGetEquippedSword().StopAllEffects();
			}
			else
			{
				if (
				thePlayer.HasTag('acs_igni_sword_equipped')	
				|| thePlayer.HasTag('acs_igni_secondary_sword_equipped'))
				{
					if ( thePlayer.GetInventory().IsItemHeld(steelID) )
					{
						if (steel_sword_hidden)
						{
							SteelSwordHide(false);

							steel_sword_hidden = false;
						}
					}
					else if( !thePlayer.GetInventory().IsItemHeld(steelID) )
					{
						if (
						ACS_CloakEquippedCheck()
						|| ACS_CheckWeaponShouldExistOnHip('both')
						|| ACS_Settings_Main_Bool('acs_player_equipment_visual_settings','acs_hide_sword_sheathes', false)
						|| FactsQuerySum("ACS_Cloak_Equipped") > 0
						|| (FactsQuerySum("ACS_In_Meditation") > 0 
						&& (!thePlayer.IsAnyWeaponHeld() || thePlayer.IsWeaponHeld('fist'))
						&& ACS_Settings_Main_Bool('acs_meditation_settings','acs_meditation_items_enabled', true)
						&& ACS_Settings_Main_Bool('acs_meditation_settings','acs_meditation_weapons_on_ground_enabled', true)
						&& !thePlayer.IsInInterior())
						)
						{

						}
						else
						{
							if (steel_sword_hidden)
							{
								SteelSwordHide(false);

								steel_sword_hidden = false;
							}
						}
					}

					if( thePlayer.GetInventory().IsItemHeld(silverID) )
					{
						if (silver_sword_hidden)
						{
							SilverSwordHide(false);

							silver_sword_hidden = false;
						}
					}
					else if( !thePlayer.GetInventory().IsItemHeld(silverID) )
					{
						if (
						ACS_CloakEquippedCheck()
						|| ACS_CheckWeaponShouldExistOnHip('both')
						|| ACS_Settings_Main_Bool('acs_player_equipment_visual_settings','acs_hide_sword_sheathes', false)
						|| FactsQuerySum("ACS_Cloak_Equipped") > 0
						|| (FactsQuerySum("ACS_In_Meditation") > 0 
						&& (!thePlayer.IsAnyWeaponHeld() || thePlayer.IsWeaponHeld('fist'))
						&& ACS_Settings_Main_Bool('acs_meditation_settings','acs_meditation_items_enabled', true)
						&& ACS_Settings_Main_Bool('acs_meditation_settings','acs_meditation_weapons_on_ground_enabled', true)
						&& !thePlayer.IsInInterior()
						)
						)
						{

						}
						else
						{
							if (silver_sword_hidden)
							{
								SilverSwordHide(false);

								silver_sword_hidden = false;
							}
						}
					}
				}
			}

			if (FactsQuerySum("ACS_Azkar_Active") > 0
			|| FactsQuerySum("ACS_Slayer_Active") > 0
			)
			{
				if (!steel_sword_hidden)
				{
					SteelSwordHide(true);

					steel_sword_hidden = true;
				}

				if (!silver_sword_hidden)
				{
					SilverSwordHide(true);

					silver_sword_hidden = true;
				}

				if ( alternate_steel_scabbard_enabled )
				{
					AlternateSteelScabbardManage(false);

					alternate_steel_scabbard_enabled = false;
				}

				if ( alternate_silver_scabbard_enabled )
				{
					AlternateSilverScabbardManage(false);

					alternate_silver_scabbard_enabled = false;
				}

				if (!steel_scabbard_hidden)
				{
					SteelSwordScabbardSetVisible(false);

					steel_scabbard_hidden = true;
				}
				
				if (!silver_scabbard_hidden)
				{
					SilverSwordScabbardSetVisible(false);

					silver_scabbard_hidden = true;
				}
			}
			else if (
			ACS_CloakEquippedCheck()
			|| ACS_Settings_Main_Bool('acs_player_equipment_visual_settings','acs_hide_sword_sheathes', false)
			|| FactsQuerySum("ACS_Cloak_Equipped") > 0
			|| (FactsQuerySum("ACS_In_Meditation") > 0 
			&& (!thePlayer.IsAnyWeaponHeld() || thePlayer.IsWeaponHeld('fist'))
			&& ACS_Settings_Main_Bool('acs_meditation_settings','acs_meditation_items_enabled', true)
			&& ACS_Settings_Main_Bool('acs_meditation_settings','acs_meditation_weapons_on_ground_enabled', true)
			&& !thePlayer.IsInInterior()
			)
			)
			{
				if (!thePlayer.GetInventory().IsItemHeld(steelID))
				{
					if (!steel_sword_hidden)
					{
						//SteelSwordHide(true);

						steel_sword_hidden = true;
					}

					SteelSwordHide(true);
				}

				if (!thePlayer.GetInventory().IsItemHeld(silverID))
				{
					if (!silver_sword_hidden)
					{
						//SilverSwordHide(true);

						silver_sword_hidden = true;
					}

					SilverSwordHide(true);
				}

				if ( alternate_steel_scabbard_enabled )
				{
					AlternateSteelScabbardManage(false);

					alternate_steel_scabbard_enabled = false;
				}

				if ( alternate_silver_scabbard_enabled )
				{
					AlternateSilverScabbardManage(false);

					alternate_silver_scabbard_enabled = false;
				}
				
				if (ACS_CloakEquippedCheck()
				|| FactsQuerySum("ACS_Cloak_Equipped") > 0 
				|| ACS_CheckWeaponShouldExistOnHip('both')
				)
				{
					CreateDummySwords();
				}

				if (!steel_scabbard_hidden)
				{
					//SteelSwordScabbardSetVisible(false);

					steel_scabbard_hidden = true;
				}

				SteelSwordScabbardSetVisible(false);

				if (!silver_scabbard_hidden)
				{
					//SilverSwordScabbardSetVisible(false);

					silver_scabbard_hidden = true;
				}

				SilverSwordScabbardSetVisible(false);
			}
			else
			{
				if ( !thePlayer.GetInventory().IsItemHeld(steelID) )
				{
					if (ACS_ShouldHideWeaponCheck('steel')
					)
					{
						if (alternate_steel_scabbard_enabled)
						{
							AlternateSteelScabbardManage(false);

							alternate_steel_scabbard_enabled = false;
						}

						if (!steel_scabbard_hidden)
						{
							SteelSwordScabbardSetVisible(false);

							steel_scabbard_hidden = true;
						}

						if (!steel_sword_hidden)
						{
							SteelSwordHide(true);

							steel_sword_hidden = true;
						}
					}
					else
					{
						if (steel_sword_hidden)
						{
							SteelSwordHide(false);

							steel_sword_hidden = false;
						}
					}
				}

				if ( !thePlayer.GetInventory().IsItemHeld(silverID) )
				{
					if (ACS_ShouldHideWeaponCheck('silver'))
					{
						if (alternate_silver_scabbard_enabled)
						{
							AlternateSilverScabbardManage(false);

							alternate_silver_scabbard_enabled = false;
						}

						if (!silver_scabbard_hidden)
						{
							SilverSwordScabbardSetVisible(false);

							silver_scabbard_hidden = true;
						}

						if (!silver_sword_hidden)
						{
							SilverSwordHide(true);

							silver_sword_hidden = true;
						}
					}
					else
					{
						if (silver_sword_hidden)
						{
							SilverSwordHide(false);

							silver_sword_hidden = false;
						}
					}
				}

				if (!ACS_ShouldHideWeaponCheck('steel')
				&& !ACS_DontReplaceScabbard('steel')
				&& GetWitcherPlayer().GetInventory().IsIdValid( steelID )
				)
				{
					if (ACS_Settings_Main_Bool('acs_player_equipment_visual_settings','acs_alternate_scabbard_steel_enabled', false) 
					)
					{
						if ( !alternate_steel_scabbard_enabled )
						{
							AlternateSteelScabbardManage(true);

							alternate_steel_scabbard_enabled = true;
						}

						if (!steel_scabbard_hidden)
						{
							SteelSwordScabbardSetVisible(false);

							steel_scabbard_hidden = true;
						}
					}
					else 
					{
						if (alternate_steel_scabbard_enabled)
						{
							AlternateSteelScabbardManage(false);

							alternate_steel_scabbard_enabled = false;
						}

						if (steel_scabbard_hidden)
						{
							SteelSwordScabbardSetVisible(true);

							steel_scabbard_hidden = false;
						}
					}
				}
				
				if (!ACS_ShouldHideWeaponCheck('silver')
				&& !ACS_DontReplaceScabbard('silver')
				&& GetWitcherPlayer().GetInventory().IsIdValid( silverID )
				)
				{
					if (ACS_Settings_Main_Bool('acs_player_equipment_visual_settings','acs_alternate_scabbard_silver_enabled', false) 
					)
					{
						if ( !alternate_silver_scabbard_enabled )
						{
							AlternateSilverScabbardManage(true);

							alternate_silver_scabbard_enabled = true;
						}

						if (!silver_scabbard_hidden)
						{
							SilverSwordScabbardSetVisible(false);

							silver_scabbard_hidden = true;
						}
					}
					else
					{
						if (alternate_silver_scabbard_enabled)
						{
							AlternateSilverScabbardManage(false);

							alternate_silver_scabbard_enabled = false;
						}

						if (silver_scabbard_hidden)
						{
							SilverSwordScabbardSetVisible(true);

							silver_scabbard_hidden = false;
						}
					}
				}

				if (!ACS_CheckWeaponShouldExistOnHip('both'))
				{
					if ( FactsQuerySum("ACS_Dummy_Swords_Enabled") > 0 )
					{
						if( !thePlayer.GetInventory().IsItemHeld(steelID) )
						{
							thePlayer.GetInventory().MountItem( steelID, false );  
						}

						if( !thePlayer.GetInventory().IsItemHeld(silverID) )
						{
							thePlayer.GetInventory().MountItem( silverID, false );  
						}

						FactsRemove("ACS_Dummy_Swords_Enabled");
					}
				
					if (ACSGetCEntity('ACS_SwordOnHip_Dummy_Attachment'))
					{
						ACSGetCEntity('ACS_SwordOnHip_Dummy_Attachment').Destroy();
					}

					if (ACSGetCEntity('ACS_SwordOnHip_Steel_Sword_Dummy'))
					{
						ACSGetCEntity('ACS_SwordOnHip_Steel_Sword_Dummy').Destroy();
					}

					if (ACSGetCEntity('ACS_SwordOnHip_SilverScabbardDummy_Attachment'))
					{
						ACSGetCEntity('ACS_SwordOnHip_SilverScabbardDummy_Attachment').Destroy();
					}

					if (ACSGetCEntity('ACS_SwordOnHip_SteelScabbardDummy_Attachment'))
					{
						ACSGetCEntity('ACS_SwordOnHip_SteelScabbardDummy_Attachment').Destroy();
					}
					
					if (ACSGetCEntity('ACS_SwordOnHip_Steel_Scabbard_Dummy'))
					{
						ACSGetCEntity('ACS_SwordOnHip_Steel_Scabbard_Dummy').Destroy();
					}

					if (ACSGetCEntity('ACS_SwordOnHip_Silver_Sword_Dummy'))
					{
						ACSGetCEntity('ACS_SwordOnHip_Silver_Sword_Dummy').Destroy();
					}
					
					if (ACSGetCEntity('ACS_SwordOnHip_Silver_Scabbard_Dummy'))
					{
						ACSGetCEntity('ACS_SwordOnHip_Silver_Scabbard_Dummy').Destroy();
					}
				}

				if (crossbow_hidden)
				{
					CrossbowHide(false);

					crossbow_hidden = false;
				}
			}
		}
		else
		{
			if (FactsQuerySum("ACS_Azkar_Active") > 0
			|| FactsQuerySum("ACS_Slayer_Active") > 0
			|| thePlayer.HasTag('acs_aard_sword_equipped')	
			)
			{
				if (!steel_sword_hidden)
				{
					SteelSwordHide(true);

					steel_sword_hidden = true;
				}

				if (!silver_sword_hidden)
				{
					SilverSwordHide(true);

					silver_sword_hidden = true;
				}

				if ( alternate_steel_scabbard_enabled )
				{
					AlternateSteelScabbardManage(false);

					alternate_steel_scabbard_enabled = false;
				}

				if ( alternate_silver_scabbard_enabled )
				{
					AlternateSilverScabbardManage(false);

					alternate_silver_scabbard_enabled = false;
				}
				
				if (!steel_scabbard_hidden)
				{
					SteelSwordScabbardSetVisible(false);

					steel_scabbard_hidden = true;
				}

				if (!silver_scabbard_hidden)
				{
					SilverSwordScabbardSetVisible(false);

					silver_scabbard_hidden = true;
				}
			}
			else if(
			ACS_CloakEquippedCheck()
			|| ACS_Settings_Main_Bool('acs_player_equipment_visual_settings','acs_hide_sword_sheathes', false)
			|| FactsQuerySum("ACS_Cloak_Equipped") > 0
			|| (FactsQuerySum("ACS_In_Meditation") > 0 
			&& (!thePlayer.IsAnyWeaponHeld() || thePlayer.IsWeaponHeld('fist'))
			&& ACS_Settings_Main_Bool('acs_meditation_settings','acs_meditation_items_enabled', true)
			&& ACS_Settings_Main_Bool('acs_meditation_settings','acs_meditation_weapons_on_ground_enabled', true)
			&& !thePlayer.IsInInterior()
			)
			)
			{
				if (ACSGetCEntity('ACS_Armor_Ether_Sword') )
				{
					if (!steel_sword_hidden)
					{
						SteelSwordHide(true);

						steel_sword_hidden = true;
					}

					if (!silver_sword_hidden)
					{
						SilverSwordHide(true);

						silver_sword_hidden = true;
					}
				}
				else
				{
					if (thePlayer.GetInventory().IsItemHeld(steelID))
					{
						if (steel_sword_hidden)
						{
							//SteelSwordHide(false);

							steel_sword_hidden = false;
						}

						SteelSwordHide(false);
					}
					else if (!thePlayer.GetInventory().IsItemHeld(steelID))
					{
						if (!steel_sword_hidden)
						{
							//SteelSwordHide(true);

							steel_sword_hidden = true;
						}

						SteelSwordHide(true);
					}

					if (thePlayer.GetInventory().IsItemHeld(silverID))
					{
						if (silver_sword_hidden)
						{
							//SilverSwordHide(false);

							silver_sword_hidden = false;
						}

						SilverSwordHide(false);
					}
					else if (!thePlayer.GetInventory().IsItemHeld(silverID))
					{
						if (!silver_sword_hidden)
						{
							//SilverSwordHide(true);

							silver_sword_hidden = true;
						}

						SilverSwordHide(true);
					}
				}

				if ( alternate_steel_scabbard_enabled )
				{
					AlternateSteelScabbardManage(false);

					alternate_steel_scabbard_enabled = false;
				}

				if ( alternate_silver_scabbard_enabled )
				{
					AlternateSilverScabbardManage(false);

					alternate_silver_scabbard_enabled = false;
				}

				if (ACS_CloakEquippedCheck()
				|| FactsQuerySum("ACS_Cloak_Equipped") > 0 
				|| ACS_CheckWeaponShouldExistOnHip('both')
				)
				{
					CreateDummySwords();
				}
				
				if (!steel_scabbard_hidden)
				{
					//SteelSwordScabbardSetVisible(false);

					steel_scabbard_hidden = true;
				}

				SteelSwordScabbardSetVisible(false);

				if (!silver_scabbard_hidden)
				{
					//SilverSwordScabbardSetVisible(false);

					silver_scabbard_hidden = true;
				}

				SilverSwordScabbardSetVisible(false);
			}
			else
			{
				if (crossbow_hidden)
				{
					CrossbowHide(false);

					crossbow_hidden = false;
				}

				if (ACSGetCEntity('ACS_Armor_Ether_Sword') )
				{
					if (!steel_sword_hidden)
					{
						SteelSwordHide(true);

						steel_sword_hidden = true;
					}

					if (!silver_sword_hidden)
					{
						SilverSwordHide(true);

						silver_sword_hidden = true;
					}
				}
				else
				{
					if (thePlayer.GetInventory().IsItemHeld(steelID))
					{
						if (steel_sword_hidden)
						{
							SteelSwordHide(false);

							steel_sword_hidden = false;
						}
					}
					else if (!thePlayer.GetInventory().IsItemHeld(steelID)
					&& ACS_ShouldHideWeaponCheck('steel')
					)
					{
						if (!steel_scabbard_hidden)
						{
							SteelSwordScabbardSetVisible(false);

							steel_scabbard_hidden = true;
						}

						if (!steel_sword_hidden)
						{
							SteelSwordHide(true);

							steel_sword_hidden = true;
						}
					}
					else 
					{
						if (steel_sword_hidden)
						{
							SteelSwordHide(false);

							steel_sword_hidden = false;
						}
					}

					if (thePlayer.GetInventory().IsItemHeld(silverID))
					{
						if (silver_sword_hidden)
						{
							SilverSwordHide(false);

							silver_sword_hidden = false;
						}
					}
					else if (!thePlayer.GetInventory().IsItemHeld(silverID)
					&& ACS_ShouldHideWeaponCheck('silver')
					)
					{
						if (!silver_scabbard_hidden)
						{
							SilverSwordScabbardSetVisible(false);

							silver_scabbard_hidden = true;
						}

						if (!silver_sword_hidden)
						{
							SilverSwordHide(true);

							silver_sword_hidden = true;
						}
					}
					else
					{
						if (silver_sword_hidden)
						{
							SilverSwordHide(false);

							silver_sword_hidden = false;
						}
					}
				}

				if (!ACS_ShouldHideWeaponCheck('steel')
				&& GetWitcherPlayer().GetInventory().IsIdValid( steelID )
				)
				{
					if (ACS_Settings_Main_Bool('acs_player_equipment_visual_settings','acs_alternate_scabbard_steel_enabled', false) 
					&& !ACS_DontReplaceScabbard('steel')
					)
					{
						if ( !alternate_steel_scabbard_enabled )
						{
							AlternateSteelScabbardManage(true);

							alternate_steel_scabbard_enabled = true;
						}

						if (!steel_scabbard_hidden)
						{
							SteelSwordScabbardSetVisible(false);

							steel_scabbard_hidden = true;
						}
					}
					else 
					{
						if (alternate_steel_scabbard_enabled)
						{
							AlternateSteelScabbardManage(false);

							alternate_steel_scabbard_enabled = false;
						}

						if (steel_scabbard_hidden)
						{
							SteelSwordScabbardSetVisible(true);

							steel_scabbard_hidden = false;
						}
					}
				}
				
				if (!ACS_ShouldHideWeaponCheck('silver')
				&& GetWitcherPlayer().GetInventory().IsIdValid( silverID )
				)
				{
					if (ACS_Settings_Main_Bool('acs_player_equipment_visual_settings','acs_alternate_scabbard_silver_enabled', false) 
					&& !ACS_DontReplaceScabbard('silver')
					)
					{
						if ( !alternate_silver_scabbard_enabled )
						{
							AlternateSilverScabbardManage(true);

							alternate_silver_scabbard_enabled = true;
						}

						if (!silver_scabbard_hidden)
						{
							SilverSwordScabbardSetVisible(false);

							silver_scabbard_hidden = true;
						}
					}
					else
					{
						if (alternate_silver_scabbard_enabled)
						{
							AlternateSilverScabbardManage(false);

							alternate_silver_scabbard_enabled = false;
						}

						if (silver_scabbard_hidden)
						{
							SilverSwordScabbardSetVisible(true);

							silver_scabbard_hidden = false;
						}
					}
				}
			}
		}

		if (
		ACS_Settings_Main_Bool('acs_player_equipment_visual_settings','acs_hide_crossbow', false)
		|| (FactsQuerySum("ACS_Cloak_Equipped") > 0 && FactsQuerySum("ACS_Force_Weapons_On_Hips") <= 0)
		|| FactsQuerySum("ACS_Azkar_Active") > 0
		|| FactsQuerySum("ACS_Slayer_Active") > 0
		|| ACS_CloakEquippedCheck()
		|| 
		(FactsQuerySum("ACS_In_Meditation") > 0 
		&& (!thePlayer.IsAnyWeaponHeld() || thePlayer.IsWeaponHeld('fist'))
		&& ACS_Settings_Main_Bool('acs_meditation_settings','acs_meditation_items_enabled', true)
		&& ACS_Settings_Main_Bool('acs_meditation_settings','acs_meditation_weapons_on_ground_enabled', true)
		&& !thePlayer.IsInInterior())
		)
		{
			if (!thePlayer.IsCrossbowHeld())
			{
				if (!crossbow_hidden)
				{
					CrossbowHide(true);

					crossbow_hidden = true;
				}
				thePlayer.rangedWeapon.ClearDeployedEntity(true);
			}
			else if (thePlayer.IsCrossbowHeld())
			{
				if (crossbow_hidden)
				{
					CrossbowHide(false);

					crossbow_hidden = false;
				}
			} 
		}
		else
		{
			if (FactsQuerySum("ACS_Cloak_Equipped") > 0)
			{
				if (!thePlayer.IsCrossbowHeld())
				{
					if (!crossbow_hidden)
					{
						CrossbowHide(true);

						crossbow_hidden = true;
					}
					thePlayer.rangedWeapon.ClearDeployedEntity(true);
				}
				else if (thePlayer.IsCrossbowHeld())
				{
					if (crossbow_hidden)
					{
						CrossbowHide(false);

						crossbow_hidden = false;
					}
				} 
			}
			else
			{
				if (crossbow_hidden)
				{
					CrossbowHide(false);

					crossbow_hidden = false;
				}
			}
			
		}

		if(!GetWitcherPlayer().IsAnyItemEquippedOnSlot(EES_SteelSword) )
		{
			if (alternate_steel_scabbard_enabled)
			{
				AlternateSteelScabbardManage(false);

				alternate_steel_scabbard_enabled = false;
			}
		}

		if(!GetWitcherPlayer().IsAnyItemEquippedOnSlot(EES_SilverSword) )
		{
			if (alternate_silver_scabbard_enabled)
			{
				AlternateSilverScabbardManage(false);

				alternate_silver_scabbard_enabled = false;
			}
		}

		if (
		(FactsQuerySum("ACS_In_Meditation") > 0 
		&& ACS_Settings_Main_Bool('acs_meditation_settings','acs_meditation_weapons_on_ground_enabled', true)
		&& (!thePlayer.IsAnyWeaponHeld() || thePlayer.IsWeaponHeld('fist'))
		|| !ACS_CloakEquippedCheck()
		)
		)
		{
			if ( FactsQuerySum("ACS_Dummy_Swords_Enabled") > 0 )
			{
				if( !thePlayer.GetInventory().IsItemHeld(steelID) )
				{
					thePlayer.GetInventory().MountItem( steelID, false );  
				}

				if( !thePlayer.GetInventory().IsItemHeld(silverID) )
				{
					thePlayer.GetInventory().MountItem( silverID, false );  
				}
				
				FactsRemove("ACS_Dummy_Swords_Enabled");
			}

			if (ACSGetCEntity('ACS_SwordOnHip_Dummy_Attachment'))
			{
				ACSGetCEntity('ACS_SwordOnHip_Dummy_Attachment').Destroy();
			}

			if (ACSGetCEntity('ACS_SwordOnHip_Steel_Sword_Dummy'))
			{
				ACSGetCEntity('ACS_SwordOnHip_Steel_Sword_Dummy').Destroy();
			}

			if (ACSGetCEntity('ACS_SwordOnHip_SilverScabbardDummy_Attachment'))
			{
				ACSGetCEntity('ACS_SwordOnHip_SilverScabbardDummy_Attachment').Destroy();
			}

			if (ACSGetCEntity('ACS_SwordOnHip_SteelScabbardDummy_Attachment'))
			{
				ACSGetCEntity('ACS_SwordOnHip_SteelScabbardDummy_Attachment').Destroy();
			}
			
			if (ACSGetCEntity('ACS_SwordOnHip_Steel_Scabbard_Dummy'))
			{
				ACSGetCEntity('ACS_SwordOnHip_Steel_Scabbard_Dummy').Destroy();
			}

			if (ACSGetCEntity('ACS_SwordOnHip_Silver_Sword_Dummy'))
			{
				ACSGetCEntity('ACS_SwordOnHip_Silver_Sword_Dummy').Destroy();
			}
			
			if (ACSGetCEntity('ACS_SwordOnHip_Silver_Scabbard_Dummy'))
			{
				ACSGetCEntity('ACS_SwordOnHip_Silver_Scabbard_Dummy').Destroy();
			}
		}

		if (thePlayer.HasTag('acs_aard_sword_equipped')
		|| thePlayer.HasTag('ACS_Spear_Transform_Active')
		)
		{
			if (thePlayer.IsWeaponHeld('steelsword'))
			{
				if (!steel_sword_hidden)
				{
					SteelSwordHide(true);

					steel_sword_hidden = true;
				}
			}
			
			if (thePlayer.IsWeaponHeld('silversword'))
			{
				if (!silver_sword_hidden)
				{
					SilverSwordHide(true);

					silver_sword_hidden = true;
				}
			}
		}

		if( 
		theGame.IsDialogOrCutscenePlaying() 
		|| !thePlayer.IsAlive()
		|| thePlayer.IsInCutsceneIntro()
		|| theGame.HasBlackscreenRequested()
		|| theGame.IsCurrentlyPlayingNonGameplayScene()
		|| theGame.GetGuiManager().IsAnyMenu()
		)
		{
			if (horse_sword_positioning_enabled)
			{
				thePlayer.RaiseEvent('ACS_HorseSwordPositioningFixReset');

				RemoveTimer('HorseSwordPositioningReset');

				horse_sword_positioning_enabled = false;
			}
			
			if (horse_steel_spear_activate)
			{
				thePlayer.RaiseEvent('ACS_SwordWalkAdditiveEnd');

				vACS_Stance_Switch = new cACS_Stance_Switch in this;

				vACS_Stance_Switch.ACS_Horse_Spear_Transform_Switch_Deactivate_Engage();

				horse_steel_spear_activate = false;
			}

			if (horse_silver_spear_activate)
			{
				thePlayer.RaiseEvent('ACS_SwordWalkAdditiveEnd');

				vACS_Stance_Switch = new cACS_Stance_Switch in this;

				vACS_Stance_Switch.ACS_Horse_Spear_Transform_Switch_Deactivate_Engage();

				horse_silver_spear_activate = false;
			}
		}
		else
		{
			if (thePlayer.IsUsingHorse()
			&& FactsQuerySum("ACS_Mounted_Attack_Attachment_Active") <= 0
			&& (thePlayer.GetHorseCurrentlyMounted().GetHorseComponent()).IsFullyMounted()
			)
			{
				if (thePlayer.IsWeaponHeld('steelsword'))
				{
					if (!steel_sword_hidden)
					{
						SteelSwordHide(true);

						steel_sword_hidden = true;
					}

					if (!horse_steel_spear_activate)
					{
						vACS_Stance_Switch = new cACS_Stance_Switch in this;
		
						vACS_Stance_Switch.ACS_Horse_Spear_Transform_Switch_Activate_Engage();

						horse_steel_spear_activate = true;
					}
				}
				else
				{
					if (horse_steel_spear_activate)
					{
						thePlayer.RaiseEvent('ACS_SwordWalkAdditiveEnd');

						vACS_Stance_Switch = new cACS_Stance_Switch in this;
		
						vACS_Stance_Switch.ACS_Horse_Spear_Transform_Switch_Deactivate_Engage();

						horse_steel_spear_activate = false;
					}
				}
				
				if (thePlayer.IsWeaponHeld('silversword'))
				{
					if (!silver_sword_hidden)
					{
						SilverSwordHide(true);

						silver_sword_hidden = true;
					}

					if (!horse_silver_spear_activate)
					{
						vACS_Stance_Switch = new cACS_Stance_Switch in this;
		
						vACS_Stance_Switch.ACS_Horse_Spear_Transform_Switch_Activate_Engage();

						horse_silver_spear_activate = true;
					}
				}
				else
				{
					if (horse_silver_spear_activate)
					{
						thePlayer.RaiseEvent('ACS_SwordWalkAdditiveEnd');

						vACS_Stance_Switch = new cACS_Stance_Switch in this;
		
						vACS_Stance_Switch.ACS_Horse_Spear_Transform_Switch_Deactivate_Engage();

						horse_silver_spear_activate = false;
					}
				}

				if (thePlayer.IsAnyWeaponHeld() && !thePlayer.IsWeaponHeld('fist'))
				{
					if (theInput.GetActionValue('HorseJump') > 0
					&& theInput.GetActionValue('VehicleAttack') > 0
					&& thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus ) * 1/3 
					&& !thePlayer.HasTag('ACS_Flammable_Oil_Enabled')
					)
					{
						ACS_Tutorial_Display_Check('ACS_Weapon_Arts_Tutorial_Shown');

						FlammableOilEvent();

						thePlayer.DrainFocus(thePlayer.GetStatMax( BCS_Focus ) * 1/3 );
					}

					if (theInput.GetActionValue('VehicleAttack') > 0
					|| theInput.GetActionValue( 'VehicleCastSign' ) > 0
					|| theInput.GetActionValue( 'Interaction' ) > 0
					|| thePlayer.GetUsedHorseComponent().OnCheckHorseJump()
					|| theInput.GetActionValue( 'Gallop' ) > 0
					|| theInput.GetActionValue( 'Canter' ) > 0
					|| theInput.GetActionValue( 'WalkToggle' ) > 0
					//|| (theInput.GetActionValue('GI_AxisLeftY') == 0 && theInput.GetActionValue('GI_AxisLeftX') == 0)
					|| !AnimProgressCheck()
					|| ACSGetCEntity('ACS_Sign_Icon')
					|| FactsQuerySum("ACS_Is_Casting_Horse_Sign") > 0
					)
					{
						if (horse_sword_positioning_enabled)
						{
							thePlayer.RaiseEvent('ACS_HorseSwordPositioningFixReset');

							thePlayer.RaiseEvent('ACS_SwordWalkAdditiveEnd');

							RemoveTimer('HorseSwordPositioningReset');
							
							horse_sword_positioning_enabled = false;
						}
					}
					else 
					{
						if (!horse_sword_positioning_enabled)
						{
							RemoveTimer('HorseSwordPositioningReset');
							AddTimer('HorseSwordPositioningReset', 0.75, false);

							horse_sword_positioning_enabled = true;
						}
					}
				}
				else
				{
					if (horse_sword_positioning_enabled)
					{
						thePlayer.RaiseEvent('ACS_HorseSwordPositioningFixReset');

						thePlayer.RaiseEvent('ACS_SwordWalkAdditiveEnd');

						RemoveTimer('HorseSwordPositioningReset');
						
						horse_sword_positioning_enabled = false;
					}
				}
			}
			else
			{
				if (horse_sword_positioning_enabled)
				{
					thePlayer.RaiseEvent('ACS_HorseSwordPositioningFixReset');

					RemoveTimer('HorseSwordPositioningReset');

					horse_sword_positioning_enabled = false;
				}
				
				if (horse_steel_spear_activate)
				{
					thePlayer.RaiseEvent('ACS_SwordWalkAdditiveEnd');

					vACS_Stance_Switch = new cACS_Stance_Switch in this;

					vACS_Stance_Switch.ACS_Horse_Spear_Transform_Switch_Deactivate_Engage();

					horse_steel_spear_activate = false;
				}

				if (horse_silver_spear_activate)
				{
					thePlayer.RaiseEvent('ACS_SwordWalkAdditiveEnd');

					vACS_Stance_Switch = new cACS_Stance_Switch in this;

					vACS_Stance_Switch.ACS_Horse_Spear_Transform_Switch_Deactivate_Engage();

					horse_silver_spear_activate = false;
				}
			}
		}

		if (thePlayer.HasTag('ACS_HideWeaponOnDodge')
		|| thePlayer.HasTag('acs_in_wraith')
		|| thePlayer.HasTag('ACS_Bruxa_Bite_Process')
		|| ACSGetCEntity('ACS_Armor_Ether_Sword')
		|| thePlayer.HasTag('acs_aard_sword_equipped')
		|| thePlayer.HasTag('ACS_Spear_Transform_Active')
		|| ACSGetCEntity('ACS_Horse_Spear_Transform_Sword_Steel') 
		|| ACSGetCEntity('ACS_Horse_Spear_Transform_Sword_Silver')
		)
		{
			ACSGetEquippedSword().StopAllEffects();
		}
	}

	timer function HorseSwordPositioningReset( time : float , id : int )
	{
		var velocity : float;

		thePlayer.RaiseEvent('ACS_HorseSwordPositioningFix');

		velocity = (thePlayer.GetHorseCurrentlyMounted().GetHorseComponent()).GetHorseVelocitySpeed();

		if (velocity < 1 || (theInput.GetActionValue('GI_AxisLeftY') == 0 && theInput.GetActionValue('GI_AxisLeftX') == 0))
		{
			thePlayer.RaiseEvent('ACS_SwordWalkAlt01Additive');
		}
		else if (velocity >= 1)
		{
			if (velocity > 1 && velocity <= 1.5)
			{
				if (RandF() < 0.5)
				{
					thePlayer.RaiseEvent('ACS_SwordWalkAlt01Additive');
				}
				else
				{
					thePlayer.RaiseEvent('ACS_SwordWalkAlt02Additive');
				}
			}
			else if (velocity > 1.5 && velocity <= 5)
			{
				if (RandF() < 0.5)
				{
					thePlayer.RaiseEvent('ACS_SwordWalkAlt04Additive');
				}
				else
				{
					thePlayer.RaiseEvent('ACS_SwordWalkAlt02Additive');
				}
			}
			else if (velocity > 5)
			{
				thePlayer.RaiseEvent('ACS_SwordWalkAlt05Additive');
			}
		}
	}

	private var horse_steel_spear_activate : bool;
	default horse_steel_spear_activate = false;

	private var horse_silver_spear_activate : bool;
	default horse_silver_spear_activate = false;

	private var horse_sword_positioning_enabled : bool;
	default horse_sword_positioning_enabled = false;

	private var cloakHidden : bool;
	default cloakHidden = false;

	function CloakUnequip()
	{
		if (ACS_Settings_Main_Bool('acs_player_equipment_visual_settings','acs_unequip_cloak_while_in_combat', false))
		{
			if(!cloakHidden)
			{
				ACS_UnequipCloak();

				if (FactsQuerySum("ACS_Cloak_Equipped") > 0)
				{
					if (thePlayer.HasTag('ACS_IsSwordWalking'))
					{
						thePlayer.RemoveTag('ACS_IsSwordWalking');
					}

					RemoveTimer('SwordTauntSwitch'); 
					RemoveTimer('SwordTauntRunningSwitch'); 
					 
					 

					if ( thePlayer.IsHoldingItemInLHand() ) 
					{
						thePlayer.OnUseSelectedItem( true );
					}

					if ( thePlayer.IsCrossbowHeld() ) 
					{
						thePlayer.OnRangedForceHolster( false, true );
					}

					cloakaniminprogress = true;

					RemoveTimer('CloakAnimProgressSet');
					AddTimer('CloakAnimProgressSet', 2 , false);

					thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');

					thePlayer.RaiseEvent('ACS_CloakEnabled');
					RemoveTimer('CloakToggleDelay');
					AddTimer('CloakToggleDelay', 0.5 , false);

					FactsAdd("ACS_Virtual_Cloak_Temporarily_Unequipped", 1, -1);
				}

				cloakHidden = true;
			}
		}
	}

	var vACS_Arrow_Create : cACS_Arrow_Create;

	timer function CrowSwarmsReset( time : float , id : int )
	{
		var item 											: array<CEntity>;
		var i												: int;
		
		item.Clear();

		theGame.GetEntitiesByTag( 'ACS_Crow_Ent_Lasting', item );	

		if (item.Size()<=0)
		{
			return;
		}
		
		for( i = 0; i < item.Size(); i += 1 )
		{
			item[i].BreakAttachment();
			item[i].Teleport(thePlayer.GetWorldPosition() + Vector (0,0, -200));
			item[i].DestroyAfter(0.01);
			item[i].RemoveTag('ACS_Crow_Ent_Lasting');
		}
	}


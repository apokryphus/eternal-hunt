					&& StringToInt(theGame.GetInGameConfigWrapper().GetVarValue('Hud', 'HudSize'), 0) == 0
					&& !buffsAlphaMinProcess)
					{
						moduleBuffs.GetModuleFlash().SetAlpha( 0 );
						RemoveTimer('BuffsModuleFadeFlashObjectIn');

		ACSGetCEntity('acs_yrden_sidearm_1').PlayEffectSingle('fire_sparks_trail');
		ACSGetCEntity('acs_yrden_sidearm_1').PlayEffectSingle('runeword1_fire_trail');
		ACSGetCEntity('acs_yrden_sidearm_1').PlayEffectSingle('fast_attack_buff_hit');

		ACSGetCEntity('acs_yrden_sidearm_2').PlayEffectSingle('fire_sparks_trail');
		ACSGetCEntity('acs_yrden_sidearm_2').PlayEffectSingle('runeword1_fire_trail');
		ACSGetCEntity('acs_yrden_sidearm_2').PlayEffectSingle('fast_attack_buff_hit');

		ACSGetCEntity('acs_yrden_sidearm_3').PlayEffectSingle('fire_sparks_trail');
		ACSGetCEntity('acs_yrden_sidearm_3').PlayEffectSingle('runeword1_fire_trail');
		ACSGetCEntity('acs_yrden_sidearm_3').PlayEffectSingle('fast_attack_buff_hit');

		ACSGetCEntity('acs_yrden_sidearm_1').StopEffect('fire_sparks_trail');
		ACSGetCEntity('acs_yrden_sidearm_1').StopEffect('runeword1_fire_trail');
		ACSGetCEntity('acs_yrden_sidearm_1').StopEffect('fast_attack_buff_hit');

		ACSGetCEntity('acs_yrden_sidearm_2').StopEffect('fire_sparks_trail');
		ACSGetCEntity('acs_yrden_sidearm_2').StopEffect('runeword1_fire_trail');
		ACSGetCEntity('acs_yrden_sidearm_2').StopEffect('fast_attack_buff_hit');

		ACSGetCEntity('acs_yrden_sidearm_3').StopEffect('fire_sparks_trail');
		ACSGetCEntity('acs_yrden_sidearm_3').StopEffect('runeword1_fire_trail');
		ACSGetCEntity('acs_yrden_sidearm_3').StopEffect('fast_attack_buff_hit');

		ACS_Yrden_Sidearm_UpdateEnhancements();
	}

	function Weapon_Summon_Effect_Delay()
	{
		if (!thePlayer.HasTag('ACS_Bruxa_Bite_Process') )
		{
			thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( '', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(1.f, 1.f) );
		}

		if(thePlayer.IsInCombat())
		{
			RemoveTimer('ACS_Weapon_Summon_Delay');
			AddTimer('ACS_Weapon_Summon_Delay', 0.25 , false);
		}
		else
		{
			RemoveTimer('ACS_Weapon_Summon_Delay');
			AddTimer('ACS_Weapon_Summon_Delay', 0.75 , false);
		}
	}

	function ACS_Set_Player_Scale()
	{
		var size : float;
	
		playerAnimcomp = thePlayer.GetComponentByClassName('CAnimatedComponent');
		//playerMeshcomp = thePlayer.GetComponentByClassName('CMeshComponent');

		if (
		theGame.IsDialogOrCutscenePlaying() 
		|| thePlayer.IsUsingHorse() 
		|| thePlayer.IsUsingVehicle()
		//|| thePlayer.IsPerformingFinisher()
		//|| thePlayer.HasTag('ACS_IsPerformingFinisher')
		//|| thePlayer.HasTag('ACS_IsPerformingCombatDismember')
		|| thePlayer.GetPlayerAction() != PEA_None
		//|| theGame.GetPhotomodeEnabled() 
		|| thePlayer.IsInCutsceneIntro() 
		)
		{
			//playerMeshcomp.SetScale(Vector(1,1,1,0));
			playerAnimcomp.SetScale(Vector(1,1,1,0));

			return;
		}

		if (thePlayer.HasTag('acs_in_wraith'))
		{
			size = 1;
		}
		else
		{
			size = ACS_Settings_Main_Float('acs_visual_main_settings','acs_player_scale', 1);
		}

		//playerMeshcomp.SetScale(Vector(size,size,size,0));
		playerAnimcomp.SetScale(Vector(size,size,size,0));
	}
	

	timer function RemoveSignComboStuff( time : float , id : int )
	{
		var signSkill 				: ESkill;

		signSkill = SignEnumToSkillEnum( thePlayer.GetEquippedSign() );

		if( signSkill != S_SUndefined )
		{
			if( thePlayer.HasStaminaToUseSkill( signSkill ) )
			{
				ACSGetCEntityDestroyAll('ACS_Sign_Combo_Icon');

				ACSSignComboSystemRemoveTags();

				RemoveTimer('RemoveSignComboStuffRepeating');
			}
			else
			{
				RemoveTimer('RemoveSignComboStuffRepeating');
				AddTimer('RemoveSignComboStuffRepeating', 20 , true);
			}
		}
	}

	timer function RemoveSignComboStuffRepeating( time : float , id : int )
	{
		var signSkill 				: ESkill;

		signSkill = SignEnumToSkillEnum( thePlayer.GetEquippedSign() );

		if( signSkill != S_SUndefined )
		{
			if( thePlayer.HasStaminaToUseSkill( signSkill ) )
			{
				ACSGetCEntityDestroyAll('ACS_Sign_Combo_Icon');

				ACSSignComboSystemRemoveTags();
			}
		}
	}


	


		if ( GetWitcherPlayer().IsItemEquippedByName('acs_wraith_mode_item') 
		&& thePlayer.GetInventory().GetItemName( itemId ) == 'acs_wraith_mode_item' 
		&& !thePlayer.IsUsingHorse()
		&& !thePlayer.IsUsingVehicle())
		{
			if( IsPressed(action) )

	event OnCommDrinkPotion1( action : SInputAction )
	{
		if(theGame.GetFocusModeController().CanUseFocusMode()
		&& theInput.GetActionValue('Focus') > 0.5
		&& !thePlayer.IsInCombat()
		&& IsReleased( action )
		)
		{
			ACS_Tutorial_Display_Check('ACS_QuestTrackingSwap_Tutorial_Shown');

			ACS_TrackQuestSwitch( -1 );

			RemoveTimer('ACSTrackedQuestsEntsDestroyDelay');

			if (ACS_Settings_Main_Float('acs_hud_settings_markers','acs_untracked_quest_marker_despawn_delay', 7) != 0
			&& theGame.GetJournalManager().GetTrackedQuest().baseName != "ACS Exploration"
			)
			{
				GuidingEntities();
			}

			return false;
		}

		if( !thePlayer.IsActionAllowed( EIAB_QuickSlots ) )
		{
			thePlayer.DisplayActionDisallowedHudMessage(EIAB_QuickSlots);
			return false;
		}

		if (!AnimProgressCheck())
		{
			return false;
		}

		if (FactsQuerySum("acs_transformation_activated") > 0)
		{
			return false;
		}

		if( RadialMenuCheck() && GetWitcherPlayer().GetRadialPopupShown() )
		{
			return false;
		}	
	
		if ( theInput.LastUsedGamepad() )
		{
			return DrinkPotion(action, true);
		}
		else
		if ( IsReleased(action) )
		{
			RemoveTimer('Potion1DelaySwitch');

			if ( thePlayer.IsHoldingItemInLHand() || thePlayer.IsCrossbowHeld() ) 
			{
				if ( thePlayer.IsHoldingItemInLHand() ) 
				{
					thePlayer.OnUseSelectedItem( true );
					AddTimer('Potion1DelaySwitch', 0.5 , false);
				}

				if ( thePlayer.IsCrossbowHeld() ) 
				{
					thePlayer.OnRangedForceHolster( true, false );
					AddTimer('Potion1DelaySwitch',0.51 , false);
				}
			}
			else
			{
				PotionOrFoodSwitch(EES_Potion1);
			}

			return true;
		}
		
		return false;
	}

	public timer function Potion1DelaySwitch(deltaTime : float , id : int)
	{
		if ( !thePlayer.IsHoldingItemInLHand() && !thePlayer.IsCrossbowHeld() ) 
		{
			PotionOrFoodSwitch(EES_Potion1);
		}
	}

	public timer function Potion1Delay(deltaTime : float , id : int)
	{
		GetWitcherPlayer().OnPotionDrinkKeyboardsInput(EES_Potion1);

		RemoveTimer('SetPotionsAnimProgressDelay');
		AddTimer('SetPotionsAnimProgressDelay', 3 , false);
	}

	private var hoodDoubleTapCallTime																											: float;
	private var hoodDoubleTap 																											: bool;

	event OnCommDrinkPotion2( action : SInputAction )
	{
		var witcher : W3PlayerWitcher;

		if(theGame.GetFocusModeController().CanUseFocusMode()
		&& theInput.GetActionValue('Focus') > 0.5
		&& !thePlayer.IsInCombat()
		&& IsReleased( action )
		)
		{
			ACS_Tutorial_Display_Check('ACS_QuestTrackingSwap_Tutorial_Shown');

			ACS_TrackQuestSwitch( 1 );

			RemoveTimer('ACSTrackedQuestsEntsDestroyDelay');

			if (ACS_Settings_Main_Float('acs_hud_settings_markers','acs_untracked_quest_marker_despawn_delay', 7) != 0
			&& theGame.GetJournalManager().GetTrackedQuest().baseName != "ACS Exploration"
			)
			{
				GuidingEntities();
			}

			return false;
		}
		
		if( !thePlayer.IsActionAllowed( EIAB_QuickSlots ) )
		{
			thePlayer.DisplayActionDisallowedHudMessage(EIAB_QuickSlots);
			return false;
		}

		if (!AnimProgressCheck())
		{
			return false;
		}

		if (FactsQuerySum("acs_transformation_activated") > 0)
		{
			return false;
		}

		if( RadialMenuCheck() && GetWitcherPlayer().GetRadialPopupShown() )
		{
			return false;
		}	

		if ( theInput.LastUsedGamepad() )
		{
			return DrinkPotion(action, false);
		}
		else
		if ( IsReleased(action) )
		{
			RemoveTimer('Potion2DelaySwitch');

			if ( thePlayer.IsHoldingItemInLHand() || thePlayer.IsCrossbowHeld() ) 
			{
				if ( thePlayer.IsHoldingItemInLHand() ) 
				{
					thePlayer.OnUseSelectedItem( true );
					AddTimer('Potion2DelaySwitch', 0.5 , false);
				}

				if ( thePlayer.IsCrossbowHeld() ) 
				{
					thePlayer.OnRangedForceHolster( true, false );
					AddTimer('Potion2DelaySwitch', 0.5 , false);
				}
			}
			else
			{
				PotionOrFoodSwitch(EES_Potion2);
			}

			return true;
		}
		
		return false;
	}

	public timer function Potion2DelaySwitch(deltaTime : float , id : int)
	{
		if ( !thePlayer.IsHoldingItemInLHand() && !thePlayer.IsCrossbowHeld() ) 
		{
			PotionOrFoodSwitch(EES_Potion2);
		}
	}
	
	public timer function Potion2Delay(deltaTime : float , id : int)
	{
		GetWitcherPlayer().OnPotionDrinkKeyboardsInput(EES_Potion2);

		RemoveTimer('SetPotionsAnimProgressDelay');
		AddTimer('SetPotionsAnimProgressDelay', 3 , false);
	}

	function SetLastMeditationPressedTime()
	{
		last_meditation_pressed_time = theGame.GetEngineTimeAsSeconds();
	}
	
	event OnCommDrinkPotion3( action : SInputAction )
	{
		if( !thePlayer.IsActionAllowed( EIAB_QuickSlots ) )
		{
			thePlayer.DisplayActionDisallowedHudMessage(EIAB_QuickSlots);
			return false;
		}

		if (!AnimProgressCheck())
		{
			return false;
		}

		if (FactsQuerySum("acs_transformation_activated") > 0)
		{
			return false;
		}

		if( RadialMenuCheck() && GetWitcherPlayer().GetRadialPopupShown() )
		{
			return false;
		}	

		if( IsPressed(action) )
		{
			if(theGame.GetFocusModeController().CanUseFocusMode()
			&& theInput.GetActionValue('Focus') > 0.1f
			&& !thePlayer.IsInCombat()
			&& !thePlayer.IsThreatened()
			&& GetWitcherPlayer().CanMeditate()
			&& GetWitcherPlayer().CanMeditateHere()
			&& !ACS_Settings_Main_Bool('acs_meditation_settings','acs_override_meditation_button_enabled', true)
			&& !thePlayer.GetWeaponHolster().IsOnTheMiddleOfHolstering()
			)
			{
				MeditateStart();

				return false;
			}
		}

		if ( IsReleased(action) )
		{
			RemoveTimer('Potion3DelaySwitch');

			if ( thePlayer.IsHoldingItemInLHand() || thePlayer.IsCrossbowHeld() ) 
			{
				if ( thePlayer.IsHoldingItemInLHand() ) 
				{
					thePlayer.OnUseSelectedItem( true );
					AddTimer('Potion3DelaySwitch', 0.5 , false);
				}

				if ( thePlayer.IsCrossbowHeld() ) 
				{
					thePlayer.OnRangedForceHolster( true, false );
					AddTimer('Potion3DelaySwitch', 0.5 , false);
				}
			}
			else
			{
				PotionOrFoodSwitch(EES_Potion3);
			}

			return true;
		}
		
		return false;
	}

	public timer function Potion3DelaySwitch(deltaTime : float , id : int)
	{
		if ( !thePlayer.IsHoldingItemInLHand() && !thePlayer.IsCrossbowHeld() ) 
		{
			PotionOrFoodSwitch(EES_Potion3);
		}
	}

	public timer function Potion3Delay(deltaTime : float , id : int)
	{
		GetWitcherPlayer().OnPotionDrinkKeyboardsInput(EES_Potion3);

		RemoveTimer('SetPotionsAnimProgressDelay');
		AddTimer('SetPotionsAnimProgressDelay', 3 , false);
	}

	event OnCommDrinkPotion4( action : SInputAction )
	{
		var witcher : W3PlayerWitcher;
		
		if( !thePlayer.IsActionAllowed( EIAB_QuickSlots ) )
		{
			thePlayer.DisplayActionDisallowedHudMessage(EIAB_QuickSlots);
			return false;
		}

		if (!AnimProgressCheck())
		{
			return false;
		}

		if (FactsQuerySum("acs_transformation_activated") > 0)
		{
			return false;
		}

		if( RadialMenuCheck() && GetWitcherPlayer().GetRadialPopupShown() )
		{
			return false;
		}	

		if ( IsReleased(action) )
		{
			RemoveTimer('Potion4DelaySwitch');

			if ( thePlayer.IsHoldingItemInLHand() || thePlayer.IsCrossbowHeld() ) 
			{
				if ( thePlayer.IsHoldingItemInLHand() ) 
				{
					thePlayer.OnUseSelectedItem( true );
					AddTimer('Potion4DelaySwitch', 0.5 , false);
				}

				if ( thePlayer.IsCrossbowHeld() ) 
				{
					thePlayer.OnRangedForceHolster( true, false );
					AddTimer('Potion4DelaySwitch', 0.5 , false);
				}
			}
			else
			{
				PotionOrFoodSwitch(EES_Potion4);
			}

			return true;
		}
		
		return false;
	}

	public timer function Potion4DelaySwitch(deltaTime : float , id : int)
	{
		if ( !thePlayer.IsHoldingItemInLHand() && !thePlayer.IsCrossbowHeld() ) 
		{
			PotionOrFoodSwitch(EES_Potion4);
		}
	}

	public timer function Potion4Delay(deltaTime : float , id : int)
	{
		GetWitcherPlayer().OnPotionDrinkKeyboardsInput(EES_Potion4);

		RemoveTimer('SetPotionsAnimProgressDelay');
		AddTimer('SetPotionsAnimProgressDelay', 3 , false);
	}

	var last_meditation_pressed_time, last_meditation_campfire_pressed_time : float;

	event OnCommPanelMeditation( action : SInputAction )
	{
		if(theGame.GetFocusModeController().CanUseFocusMode()
		&& !thePlayer.IsInCombat()
		&& !thePlayer.IsThreatened()
		&& GetWitcherPlayer().CanMeditate()
		&& GetWitcherPlayer().CanMeditateHere()
		&& FactsQuerySum("acs_transformation_activated") <= 0
		&& !thePlayer.GetWeaponHolster().IsOnTheMiddleOfHolstering()
		)
		{
			if( IsPressed(action) )
			{
				MeditateStart();
			}
			
			if ( IsReleased( action ) )
			{
				
			}
		}
	}

	function CampfireExtinguish()
	{
		var gameplayLightComp, pointLightComp : CComponent;

		gameplayLightComp = ACSGetCEntity('ACS_Meditation_Campfire').GetComponentByClassName('CGameplayLightComponent');

		pointLightComp = ACSGetCEntity('ACS_Meditation_Campfire').GetComponentByClassName('CPointLightComponent');

		if (((CGameplayLightComponent)gameplayLightComp).IsLightOn())
		{
			((CGameplayLightComponent)gameplayLightComp).SetFadeLight(false);
		}

		if (pointLightComp)
		{
			if (ACSGetCEntity('ACS_Meditation_Campfire').IsEffectActive('fire', false))
			{
				ACSGetCEntity('ACS_Meditation_Campfire').StopEffect('fire');
			}

			if (ACSGetCEntity('ACS_Meditation_Campfire').IsEffectActive('light_on', false))
			{
				ACSGetCEntity('ACS_Meditation_Campfire').StopEffect('light_on');
			}

			if (ACSGetCEntity('ACS_Meditation_Campfire').IsEffectActive('light_on_bob', false))
			{
				ACSGetCEntity('ACS_Meditation_Campfire').StopEffect('light_on_bob');
			}

			((CPointLightComponent)pointLightComp).SetEnabled(false);
		}

		ACSGetCEntity('ACS_Meditation_Campfire').DestroyAfter(30);

		ACSGetCEntity('ACS_Meditation_Campfire').RemoveTag('ACS_Meditation_Campfire');
	}

	private var storedHoursPerMinute 					: float;	

	private var meditationPushups, meditationSquat, meditationSleep, meditationNormal 						: bool;

	var last_meditation_anim_time : float;

	public timer function ACS_Meditation_Start_Delay(deltaTime : float , id : int)
	{
		var fastForward 		: CGameFastForwardSystem;
		var comp 				: CComponent;

		if (thePlayer.HasTag('ACS_IsSwordWalking'))
		{
			thePlayer.RemoveTag('ACS_IsSwordWalking');
		}

		thePlayer.RaiseEvent('ACS_SwordWalkAdditiveEnd');thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');RemoveTimer('CombatTauntDelay');thePlayer.RaiseEvent('ACS_SwordTauntEnd');

		if (thePlayer.IsAnyWeaponHeld() && !thePlayer.IsWeaponHeld('fist'))
		{
			thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( 'man_knight_kneeling_with_sword_loop_01_ACS', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0.125, 0) );
		}
		else
		{
			if(meditationNormal)
			{
				if (RandF() < 0.5)
				{
					PlayerPlayAnimation('meditation_idle01');
				}
				else
				{
					PlayerPlayAnimation('meditation_idle_2');
				}
			}

			if(meditationSquat)
			{
				PlayerPlayAnimation('man_work_sit_squat_01');
			}

			if(meditationSleep)
			{
				PlayerPlayAnimation('man_work_sleep_ground_loop_1');
			}

			if(meditationPushups)
			{
				PlayerPlayAnimation('work_push_ups_02_ACS');
			}
		}

		RemoveTimer('ACS_Meditate_Loop');
		AddTimer('ACS_Meditate_Loop', 0.001 , true);

		fastForward = theGame.GetFastForwardSystem();
		fastForward.BeginFastForward(true, false);

		if (!ACSGetCEntity('ACS_Meditation_Campfire'))
		{
			theGame.SetHoursPerMinute( storedHoursPerMinute * (180 * ACS_Settings_Main_Float('acs_meditation_settings','acs_meditation_time_flow_multiplier', 0.5)) );
		}
		else
		{
			theGame.SetHoursPerMinute( storedHoursPerMinute * (120 * ACS_Settings_Main_Float('acs_meditation_settings','acs_meditation_time_flow_multiplier', 0.5)) );
		}

		if (thePlayer.IsThreatened()
		|| thePlayer.IsInCombat()
		|| theGame.IsDialogOrCutscenePlaying() 
		//|| theGame.IsFading()
		//|| theGame.IsBlackscreen()
		//|| theGame.GetPhotomodeEnabled() 
		|| thePlayer.IsInCutsceneIntro() 
		|| theGame.IsCurrentlyPlayingNonGameplayScene() 
		|| theInput.GetActionValue('Jump') > 0.5
		)
		{
			if (thePlayer.IsThreatened()
			|| thePlayer.IsInCombat())
			{
				thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( '', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(1.f, 1.f) );
			}
			else
			{
				if (thePlayer.IsAnyWeaponHeld() && !thePlayer.IsWeaponHeld('fist'))
				{
					PlayerPlayAnimation('man_knight_kneeling_with_sword_stop_ACS');
				}
				else
				{
					if(meditationNormal)
					{
						if (!ACSGetCEntity('ACS_Meditation_Campfire'))
						{
							PlayerPlayAnimation('meditation_stop_long');
						}
						else
						{
							PlayerPlayAnimation('meditation_stop_long_2');
						}
					}

					if(meditationSquat)
					{
						PlayerPlayAnimation('man_work_sit_squat_stop');
					}

					if(meditationSleep)
					{
						PlayerPlayAnimation('man_work_sleep_ground_stop');
					}

					if(meditationPushups)
					{
						PlayerPlayAnimation('work_push_ups_stop_ACS');
					}
				}
			}

			if (thePlayer.GetInventory().ItemHasTag( thePlayer.GetInventory().GetCurrentlyHeldSword(), 'Aerondight' ))
			{
				aerondight_sword_trail();
			}

			if (FactsQuerySum("ACS_Meditation_Has_Refilled_Ammo") > 0)
			{
				FactsRemove("ACS_Meditation_Has_Refilled_Ammo");
			}

			thePlayer.UnblockAction( EIAB_Crossbow, 			'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_CallHorse,			'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_Signs, 				'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_DrawWeapon, 			'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_FastTravel, 			'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_Fists, 				'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_InteractionAction, 	'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_UsableItem,			'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_ThrowBomb,			'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_SwordAttack,			'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_LightAttacks,			'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_HeavyAttacks,			'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_SpecialAttackLight,	'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_SpecialAttackHeavy,	'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_Dodge,				'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_Roll,					'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_Parry,				'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_MeditationWaiting,	'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_OpenMeditation,		'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_RadialMenu,			'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_Movement,				'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_Interactions, 		'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_Jump, 				'ACS_Meditation');
			//thePlayer.UnblockAction( EIAB_QuickSlots, 			'ACS_Meditation');

			thePlayer.UnblockAction( EIAB_OpenFastMenu, 		'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_OpenInventory,		'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_OpenPreparation, 		'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_OpenMap, 				'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_OpenCharacterPanel, 	'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_OpenJournal, 			'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_OpenAlchemy, 			'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_OpenGlossary,			'ACS_Meditation');

			fastForward = theGame.GetFastForwardSystem();
			fastForward.AllowFastForwardSelfCompletion();

			theGame.SetHoursPerMinute( storedHoursPerMinute );

			theGame.ReleaseNoSaveLock( ACS_Meditation_Savelock_ID );

			if (ACSGetCEntity('ACS_Meditation_Campfire'))
			{
				RemoveTimer('AardLightIconSmall');
				AddTimer('AardLightIconSmall', 0.5 , false);

				thePlayer.RaiseEvent('ACS_AardLight');

				CampfireExtinguish();
			}

			if(meditationNormal)
			{
				meditationNormal = false;
			}

			if(meditationSquat)
			{
				meditationSquat = false;
			}

			if(meditationSleep)
			{
				meditationSleep = false;
			}

			if(meditationPushups)
			{
				meditationPushups = false;
			}

			if(showMeditationControls)
			{
				showMeditationControls = false;
			}

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Meditation_Controls_Display");
			
			MimicReset();

			RemoveTimer('CreateMeditationBase');

			RemoveTimer('CreateMeditationItemsActionDelay');

			RemoveTimer('CreateMeditationWeapons');

			if (meditationWeaponsOnGround)
			{
				if (ACS_CloakEquippedCheck() && (ACS_Settings_Main_Int ('acs_player_equipment_visual_settings','acs_swords_positioning_when_cloaked', 0, true) == 1 || FactsQuerySum("ACS_Force_Weapons_On_Hips") > 0))
				{
					thePlayer.RaiseEvent('ACS_HolsterSwordHip');
				}
				else if (ACS_Settings_Main_Int ('acs_player_equipment_visual_settings','acs_swords_positioning_when_cloaked', 0, true) == 0)
				{
					thePlayer.RaiseEvent('ACS_HolsterSwordAlt');
				}

				meditationWeaponsOnGround = false;
			}

			ACSGetCEntityDestroyAll('ACS_Meditation_Item');

			RemoveTimer('ACS_Meditate_Loop');
			RemoveTimer('ACS_Meditation_Start_Delay');

			ResetInteractionPriority();

			if(!meditation_block)
			{
				meditation_block = true;
			}

			RemoveTimer('RemoveMeditationBlock');
			AddTimer('RemoveMeditationBlock', 0.5 , false);

			IdleAdditiveBlockTemp();

			if (FactsQuerySum("ACS_Meditation_Allow_Alchemy") > 0)
			{
				FactsRemove("ACS_Meditation_Allow_Alchemy");
			}

			FactsRemove("ACS_In_Meditation");

			RemoveTimer('SetScabbardFlag');
			AddTimer('SetScabbardFlag', 0.125 , false );
		}
	}

	function ACS_RemovePotionEffects()
	{
		var i : int;
		var buffs : array< CBaseGameplayEffect >;
		
		thePlayer.RemoveAllPotionEffects();
		
		thePlayer.DrainToxicity(thePlayer.GetStatMax( BCS_Toxicity ));

		buffs.Clear();
		buffs = thePlayer.GetBuffs( EET_WellFed );
		for( i=buffs.Size()-1; i>=0; i-=1 )
		{
			thePlayer.RemoveEffect( buffs[i] );
		}
		
		
		buffs.Clear();
		buffs = thePlayer.GetBuffs( EET_WellHydrated );
		for( i=buffs.Size()-1; i>=0; i-=1 )
		{
			thePlayer.RemoveEffect( buffs[i] );
		}
	}

	//var last_meditation_food_consume_time : float;

	//var meditation_food_consume_cooldown : float;

	//default meditation_food_consume_cooldown = 6;

	function MeditationConsumeEdible() : bool
	{
		var itemIds 																									: array<SItemUniqueId>;

		itemIds = thePlayer.GetInventory().GetItemsByTag( 'Edibles' );

		if (itemIds.Size() > 0)
		{
			/*
			if (theGame.GetEngineTimeAsSeconds() - last_meditation_food_consume_time > meditation_food_consume_cooldown)
			{
				last_meditation_food_consume_time = theGame.GetEngineTimeAsSeconds();

				if (!thePlayer.GetInventory().ItemHasTag(itemIds[0],'Drinks') )
				{
					//thePlayer.RaiseEvent('ACS_EatEdible');

					//thePlayer.ConsumeItem(itemIds[0]);
				}
			}*/

			return true;
		}
		
		return false;
	}

	var showMeditationControls : bool;

	var last_meditation_campfire_spawn_time : float;

	public timer function ACS_Meditate_Loop(deltaTime : float , id : int)
	{
		var fastForward 			: CGameFastForwardSystem;
		var comp 					: CComponent;
		var headcComponent 	: array< CComponent >;
			
		headcComponent.Clear();

		headcComponent = thePlayer.GetComponentsByClassName( 'CHeadManagerComponent' );

		( ( CHeadManagerComponent ) headcComponent[0] ).MimicTest( 'constant_closed_eyes_face' );

		if (thePlayer.HasTag('ACS_IsSwordWalking'))
		{
			thePlayer.RaiseEvent('ACS_SwordWalkAdditiveEnd');thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');RemoveTimer('CombatTauntDelay');thePlayer.RaiseEvent('ACS_SwordTauntEnd');

			thePlayer.RemoveTag('ACS_IsSwordWalking');
		}

		if( GetRainStrength() > 0 
		&& !thePlayer.IsInInterior()
		&& !RoofCheck()
		) 
		{
			if (meditationPushups)
			{
				meditationPushups = false;

				meditationSquat = true;
			}

			if (meditationSleep)
			{
				meditationSleep = false;

				meditationNormal = true;
			}
		}

		if (thePlayer.IsAnyWeaponHeld() && !thePlayer.IsWeaponHeld('fist'))
		{
			thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( 'man_knight_kneeling_with_sword_loop_01_ACS', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0.125, 0) );
		}
		else
		{
			if(meditationPushups)
			{
				if (theGame.GetEngineTimeAsSeconds() - last_meditation_anim_time > 5)
				{
					last_meditation_anim_time = theGame.GetEngineTimeAsSeconds();

					thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( 'work_push_ups_02_ACS', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(1, 0) );
				}
			}
			else
			{
				if (theGame.GetEngineTimeAsSeconds() - last_meditation_anim_time > 4.5)
				{
					last_meditation_anim_time = theGame.GetEngineTimeAsSeconds();
					
					if(meditationNormal)
					{
						if (RandF() < 0.5)
						{
							thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( 'meditation_idle01', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(1, 0) );
						}
						else
						{
							thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( 'meditation_idle_2', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(1, 0) );
						}
					}

					if(meditationSquat)
					{
						thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( 'man_work_sit_squat_01', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(1, 0) );
					}

					if(meditationSleep)
					{
						thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( 'man_work_sleep_ground_loop_1', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(1, 0) );
					}
				}
			}
			
		}
		
		if (ACSGetCEntity('ACS_Meditation_Campfire'))
		{
			if (FactsQuerySum("ACS_Meditation_Has_Refilled_Ammo") <= 0)
			{
				thePlayer.inv.SingletonItemsRefillAmmoNoAlco(false);

				FactsAdd("ACS_Meditation_Has_Refilled_Ammo", 1, -1);
			}

			if(thePlayer.GetCurrentHealth() < thePlayer.GetMaxHealth() * 0.75
			&& MeditationConsumeEdible()
			)
			{
				thePlayer.GainStat( BCS_Vitality, (thePlayer.GetMaxHealth() - thePlayer.GetCurrentHealth()) * 0.00025 );

				ShowHealFloatingValue((thePlayer.GetMaxHealth() - thePlayer.GetCurrentHealth()) * 0.00025, true);
			}
		}

		if (theInput.GetActionValue('Sprint') > 0.5)
		{
			if (!ACSGetCEntity('ACS_Meditation_Campfire'))
			{
				theGame.SetHoursPerMinute( storedHoursPerMinute * (450 * ACS_Settings_Main_Float('acs_meditation_settings','acs_meditation_time_flow_multiplier', 0.5)) );
			}
			else
			{
				theGame.SetHoursPerMinute( storedHoursPerMinute * (300 * ACS_Settings_Main_Float('acs_meditation_settings','acs_meditation_time_flow_multiplier', 0.5)) );
			}
		}
		else
		{
			if (!ACSGetCEntity('ACS_Meditation_Campfire'))
			{
				theGame.SetHoursPerMinute( storedHoursPerMinute * (180 * ACS_Settings_Main_Float('acs_meditation_settings','acs_meditation_time_flow_multiplier', 0.5)) );
			}
			else
			{
				theGame.SetHoursPerMinute( storedHoursPerMinute * (120 * ACS_Settings_Main_Float('acs_meditation_settings','acs_meditation_time_flow_multiplier', 0.5)) );
			}
		}

		if (thePlayer.GetStat(BCS_Toxicity) > 0)
		{
			thePlayer.DrainToxicity(thePlayer.GetStatMax(BCS_Toxicity) * 0.00025);
		}

		if (theInput.GetActionValue('CastSign') > 0.5
		&& FactsQuerySum("ACS_Meditation_Allow_Alchemy") <= 0
		)
		{
			if (theGame.GetEngineTimeAsSeconds() - last_meditation_campfire_spawn_time > 3)
			{
				last_meditation_campfire_spawn_time = theGame.GetEngineTimeAsSeconds();

				if (!ACSGetCEntity('ACS_Meditation_Campfire'))
				{
					if (ACS_Is_DLC_Installed('dlc_spectre'))
					{
						if (UseKindling())
						{
							SpawnCampFire();

							RemoveTimer('LightCampFire');
							AddTimer('LightCampFire', 0.5 , false);
						}
						else
						{
							theGame.GetGuiManager().ShowNotification(GetLocStringByKey("spectre_fire_nomaterials") );
						}
					} 
					else
					{
						SpawnCampFire();

						RemoveTimer('LightCampFire');
						AddTimer('LightCampFire', 0.5 , false);
					}
				}
				else if (ACSGetCEntity('ACS_Meditation_Campfire'))
				{
					RemoveTimer('AardLightIconSmall');
					AddTimer('AardLightIconSmall', 0.5 , false);

					thePlayer.RaiseEvent('ACS_AardLight');

					CampfireExtinguish();
				}
			}
		}

		if (thePlayer.GetInventory().ItemHasTag( thePlayer.GetInventory().GetCurrentlyHeldSword(), 'Aerondight' )
		&& !ACS_Settings_Main_Bool('acs_player_equipment_visual_settings','acs_iconic_sword_vfx', false)
		)
		{
			if (
			thePlayer.HasTag('acs_igni_secondary_sword_equipped')
			|| thePlayer.HasTag('acs_igni_sword_equipped'))
			{
				if (ACS_GetItem_Sword_IsEquipped('aerondight_steel_held', 'steel'))
				{
					if (!ACSGetCEntity('acs_sword_trail_1').IsEffectActive('aerondight_glow_sword_steel', false))
					{
						ACSGetCEntity('acs_sword_trail_1').PlayEffectSingle('aerondight_glow_sword_steel');
					}

					if (!ACSGetCEntity('acs_sword_trail_1_dual_wield').IsEffectActive('aerondight_glow_sword_steel', false))
					{
						ACSGetCEntity('acs_sword_trail_1_dual_wield').PlayEffectSingle('aerondight_glow_sword_steel');
					}
				}
				else if (ACS_GetItem_Sword_IsEquipped('aerondight_silver_held', 'silver'))
				{
					if (!ACSGetCEntity('acs_sword_trail_1').IsEffectActive('aerondight_glow_sword', false))
					{
						ACSGetCEntity('acs_sword_trail_1').PlayEffectSingle('aerondight_glow_sword');
					}

					if (!ACSGetCEntity('acs_sword_trail_1_dual_wield').IsEffectActive('aerondight_glow_sword', false))
					{
						ACSGetCEntity('acs_sword_trail_1_dual_wield').PlayEffectSingle('aerondight_glow_sword');
					}
				}
				
				if (!ACSGetCEntity('acs_sword_trail_2').IsEffectActive('charge_10', false))
				{
					ACSGetCEntity('acs_sword_trail_2').PlayEffectSingle('charge_10');
				}

				if (!ACSGetCEntity('acs_sword_trail_2').IsEffectActive('aerondight_special_trail', false))
				{
					ACSGetCEntity('acs_sword_trail_2').PlayEffectSingle('aerondight_special_trail');
				}
			}
		}

		if (HudExceptionCheck())
		{
			if(!showMeditationControls)
			{
				GetACSStorage().acs_deleteOnelinerByTag("ACS_Meditation_Controls_Display");

				if (ACSGetCEntity('ACS_Meditation_Base'))
				{
					ACS_Oneliner(
					(new ACS_Oneliner_TagBuilder in theGame)
					.tag("font")
					.attr("size", "18")
					.attr("color", "#ffffff")
					.text(GetLocStringById(2118449905))
					, ACSGetCEntity('ACS_Meditation_Base'), "ACS_Meditation_Controls_Display", Vector(0,0,0.25), 10);
				}
				else
				{
					ACS_Oneliner(
					(new ACS_Oneliner_TagBuilder in theGame)
					.tag("font")
					.attr("size", "18")
					.attr("color", "#ffffff")
					.text(GetLocStringById(2118449905))
					, thePlayer, "ACS_Meditation_Controls_Display", Vector(0,0,0), 10);
				}

				GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Meditation_Controls_Display", 100);

				GetACSStorage().acs_setScaleForOnelinerByTag("ACS_Meditation_Controls_Display", 100, 100, 100);
				
				showMeditationControls = true;
			}
		}
		else
		{
			if(showMeditationControls)
			{
				GetACSStorage().acs_deleteOnelinerByTag("ACS_Meditation_Controls_Display");

				showMeditationControls = false;
			}
		}
		
		//ACS_RemovePotionEffects();

		//thePlayer.DrainToxicity(thePlayer.GetStatMax( BCS_Toxicity ));

		if (thePlayer.IsThreatened()
		|| thePlayer.IsInCombat()
		|| theGame.IsDialogOrCutscenePlaying() 
		//|| theGame.IsFading()
		//|| theGame.IsBlackscreen()
		//|| theGame.GetPhotomodeEnabled() 
		|| thePlayer.IsInCutsceneIntro() 
		|| theGame.IsCurrentlyPlayingNonGameplayScene() 
		|| theInput.GetActionValue('Jump') > 0.5
		)
		{
			if (thePlayer.IsThreatened()
			|| thePlayer.IsInCombat())
			{
				thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( '', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(1.f, 1.f) );
			}
			else
			{
				if (thePlayer.IsAnyWeaponHeld() && !thePlayer.IsWeaponHeld('fist'))
				{
					PlayerPlayAnimation('man_knight_kneeling_with_sword_stop_ACS');
				}
				else
				{
					if(meditationNormal)
					{
						if (!ACSGetCEntity('ACS_Meditation_Campfire'))
						{
							PlayerPlayAnimation('meditation_stop_long');
						}
						else
						{
							PlayerPlayAnimation('meditation_stop_long_2');
						}
					}

					if(meditationSquat)
					{
						PlayerPlayAnimation('man_work_sit_squat_stop');
					}

					if(meditationSleep)
					{
						PlayerPlayAnimation('man_work_sleep_ground_stop');
					}

					if(meditationPushups)
					{
						PlayerPlayAnimation('work_push_ups_stop_ACS');
					}
				}
			}

			if (thePlayer.GetInventory().ItemHasTag( thePlayer.GetInventory().GetCurrentlyHeldSword(), 'Aerondight' ))
			{
				aerondight_sword_trail();
			}

			if (FactsQuerySum("ACS_Meditation_Has_Refilled_Ammo") > 0)
			{
				FactsRemove("ACS_Meditation_Has_Refilled_Ammo");
			}

			thePlayer.UnblockAction( EIAB_Crossbow, 			'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_CallHorse,			'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_Signs, 				'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_DrawWeapon, 			'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_FastTravel, 			'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_Fists, 				'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_InteractionAction, 	'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_UsableItem,			'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_ThrowBomb,			'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_SwordAttack,			'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_LightAttacks,			'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_HeavyAttacks,			'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_SpecialAttackLight,	'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_SpecialAttackHeavy,	'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_Dodge,				'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_Roll,					'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_Parry,				'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_MeditationWaiting,	'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_OpenMeditation,		'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_RadialMenu,			'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_Movement,				'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_Interactions, 		'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_Jump, 				'ACS_Meditation');
			//thePlayer.UnblockAction( EIAB_QuickSlots, 			'ACS_Meditation');

			thePlayer.UnblockAction( EIAB_OpenFastMenu, 		'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_OpenInventory,		'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_OpenPreparation, 		'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_OpenMap, 				'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_OpenCharacterPanel, 	'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_OpenJournal, 			'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_OpenAlchemy, 			'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_OpenGlossary,			'ACS_Meditation');

			fastForward = theGame.GetFastForwardSystem();
			fastForward.AllowFastForwardSelfCompletion();

			theGame.SetHoursPerMinute( storedHoursPerMinute );

			theGame.ReleaseNoSaveLock( ACS_Meditation_Savelock_ID );

			if (ACSGetCEntity('ACS_Meditation_Campfire'))
			{
				RemoveTimer('AardLightIconSmall');
				AddTimer('AardLightIconSmall', 0.5 , false);

				thePlayer.RaiseEvent('ACS_AardLight');

				CampfireExtinguish();
			}

			if(meditationNormal)
			{
				meditationNormal = false;
			}

			if(meditationSquat)
			{
				meditationSquat = false;
			}

			if(meditationSleep)
			{
				meditationSleep = false;
			}

			if(meditationPushups)
			{
				meditationPushups = false;
			}

			if(showMeditationControls)
			{
				showMeditationControls = false;
			}

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Meditation_Controls_Display");

			MimicReset();

			RemoveTimer('CreateMeditationBase');

			RemoveTimer('CreateMeditationItemsActionDelay');

			RemoveTimer('CreateMeditationWeapons');

			if (meditationWeaponsOnGround)
			{
				if (ACS_CloakEquippedCheck() && (ACS_Settings_Main_Int ('acs_player_equipment_visual_settings','acs_swords_positioning_when_cloaked', 0, true) == 1 || FactsQuerySum("ACS_Force_Weapons_On_Hips") > 0))
				{
					thePlayer.RaiseEvent('ACS_HolsterSwordHip');
				}
				else if (ACS_Settings_Main_Int ('acs_player_equipment_visual_settings','acs_swords_positioning_when_cloaked', 0, true) == 0)
				{
					thePlayer.RaiseEvent('ACS_HolsterSwordAlt');
				}
				
				meditationWeaponsOnGround = false;
			}

			ACSGetCEntityDestroyAll('ACS_Meditation_Item');

			ResetInteractionPriority();

			if(!meditation_block)
			{
				meditation_block = true;
			}

			RemoveTimer('RemoveMeditationBlock');
			AddTimer('RemoveMeditationBlock', 0.5 , false);

			IdleAdditiveBlockTemp();

			RemoveTimer('ACS_Meditate_Loop');

			if (FactsQuerySum("ACS_Meditation_Allow_Alchemy") > 0)
			{
				FactsRemove("ACS_Meditation_Allow_Alchemy");
			}

			FactsRemove("ACS_In_Meditation");

			RemoveTimer('SetScabbardFlag');
			AddTimer('SetScabbardFlag', 0.125 , false );
		}
	}

	private final function CacheHudModuleHealFloater(heal : float)
	{
		cachedHeal += heal;
		
		if(!hudModuleHealScheduledUpdate)
		{
			hudModuleHealScheduledUpdate = true;
			AddTimer('HudModuleHealUpdate', ACS_Settings_Main_Float('acs_hud_settings_main','acs_heal_floating_markers_refresh_rate_per_second', 1));
		}
	}
	var cachedHeal : float;
	var hudModuleHealScheduledUpdate : bool;
	
	timer function HudModuleHealUpdate(dt : float, id : int)
	{
		if(cachedHeal >= 1.0f)
		{
			ShowHealFloatingValue(cachedHeal, false);
			cachedHeal = 0.f;
		}	
		
		hudModuleHealScheduledUpdate = false;
	}

	public function ShowHealFloatingValue(value : float, cache : bool)
	{
		if ( !((CR4ScriptedHud)theGame.GetHud()).AreEnabledEnemyHitEffects() )
		{
			return;
		}

		if (!ACS_Settings_Main_Bool('acs_hud_settings_main','acs_player_floating_markers_enabled', true))
		{
			return;
		}

		if (ACS_Settings_Main_Bool('acs_hud_settings_main','acs_floating_markers_only_show_buffs_enabled', false))
		{
			return;
		}

		if(cache)
		{
			CacheHudModuleHealFloater(value);
		}
		else
		{
			ACS_Oneliner(
			(new ACS_Oneliner_TagBuilder in theGame)
			.tag("font")
			.attr("size", "22")
			.attr("color", "#00FF00")
			.text(FloatToStringPrec(value, 0))
			, thePlayer, "ACS_Damage_Value", Vector(RandRangeF(0.625, -0.625),RandRangeF(0.625, -0.625),RandRangeF(1.75, 1.25)), 3).run_indicator('popup');
		}
	}

	function SpawnCampFire()
	{
		var template : CEntityTemplate;
		var pos : Vector;
		var z : float;
		var rot : EulerAngles;
		var campfire : W3Campfire;
		var comp : CComponent;

		var i : int;
		var ents : array<CGameplayEntity>;
		var gameplayLightComp, pointLightComp : CComponent;

		ents.Clear();
		
		FindGameplayEntitiesInRange(ents,thePlayer,10,999,,FLAG_ExcludePlayer,, );
		
		for ( i = 0; i < ents.Size(); i+=1 )
		{
			if ( ((W3Campfire)(ents[i])))
			{
				((W3Campfire)(ents[i])).Destroy();
			}
		}
		
		template = (CEntityTemplate)LoadResource( "environment\decorations\light_sources\campfire\campfire_01.w2ent", true);

		if (thePlayer.IsAnyWeaponHeld() && !thePlayer.IsWeaponHeld('fist'))
		{
			pos = thePlayer.GetWorldPosition() + thePlayer.GetWorldForward() * 1.5;
		}
		else
		{
			if (meditationSleep 
			|| meditationPushups)
			{
				pos = thePlayer.GetWorldPosition() + thePlayer.GetWorldForward() * 2.125;
			}
			else
			{
				pos = thePlayer.GetWorldPosition() + VecFromHeading( thePlayer.GetHeading() ) * Vector(0.8, 0.8, 0);
			}
		}
		
		rot = thePlayer.GetWorldRotation();

		campfire = (W3Campfire)theGame.CreateEntity(template, pos, rot);

		campfire.Teleport( TraceFloor(campfire.GetWorldPosition()) );

		comp = campfire.GetComponentByClassName('CGameplayLightComponent');

		((CGameplayLightComponent)comp).SetInteractive(false);

		thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');

		AddTimer('IgniLightIconSmall', 0.5 , false);

		thePlayer.RaiseEvent('ACS_IgniLight');

		campfire.AddTag('ACS_Meditation_Campfire');
	}

	public timer function LightCampFire(deltaTime : float , id : int)
	{
		var comp 							: CComponent;
		var ent, ent_2 						: CEntity;
		var bone_vec, attach_vec			: Vector;
		var bone_rot, attach_rot			: EulerAngles;

		thePlayer.UnblockAction( EIAB_OpenFastMenu, 					'ACS_Meditation');
		thePlayer.UnblockAction( EIAB_OpenInventory,					'ACS_Meditation');
		thePlayer.UnblockAction( EIAB_OpenPreparation, 					'ACS_Meditation');
		thePlayer.UnblockAction( EIAB_OpenMap, 							'ACS_Meditation');
		thePlayer.UnblockAction( EIAB_OpenCharacterPanel, 				'ACS_Meditation');
		thePlayer.UnblockAction( EIAB_OpenJournal, 						'ACS_Meditation');
		thePlayer.UnblockAction( EIAB_OpenAlchemy, 						'ACS_Meditation');
		thePlayer.UnblockAction( EIAB_OpenGlossary,						'ACS_Meditation');

		comp = ACSGetCEntity('ACS_Meditation_Campfire').GetComponentByClassName('CGameplayLightComponent');

		((CGameplayLightComponent)comp).SetFadeLight(true);


		ACSGetCEntity('ACS_Quen_Bubble').Destroy();
			
		ACSGetCEntity('ACS_Quen_Fx').Destroy();

		ACSGetCEntity('ACS_Sign_Icon').Destroy();

		ACSGetCEntity('ACS_Sign_Icon_Anchor').Destroy();

		ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
		"dlc\dlc_acs\data\fx\sign_icons.w2ent"
		, true ), GetWitcherPlayer().GetWorldPosition(), GetWitcherPlayer().GetWorldRotation() );

		ent_2 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
		"dlc\dlc_acs\data\fx\sign_icons.w2ent"
		, true ), GetWitcherPlayer().GetWorldPosition(), GetWitcherPlayer().GetWorldRotation() );

		GetWitcherPlayer().GetBoneWorldPositionAndRotationByIndex( GetWitcherPlayer().GetBoneIndex( 'l_handRoll' ), bone_vec, bone_rot );

		attach_rot.Roll = 0;
		attach_rot.Pitch = 0;
		attach_rot.Yaw = 0;
		attach_vec.X = 0.375;
		attach_vec.Y = 0.05;
		attach_vec.Z = 0.05;

		ent.CreateAttachmentAtBoneWS( GetWitcherPlayer(), 'l_handRoll', bone_vec, bone_rot );

		ent_2.CreateAttachment( ent, , attach_vec, attach_rot );

		ent_2.PlayEffectSingle('igni_icon_small');

		//ent_2.PlayEffectSingle('critical_igni');

		ent_2.DestroyAfter(0.5);

		ent.AddTag('ACS_Sign_Icon_Anchor');

		ent_2.AddTag('ACS_Sign_Icon');
	}

	function CamerasDestroy()
	{
		ACSGetCEntityDestroyAll('ACS_Focus_Mode_Custom_Camera');

		ACSGetCEntityDestroyAll('ACS_Transformation_Custom_Camera');

		ACSGetCEntityDestroyAll('ACS_Kestral_Custom_Camera');

		ACSGetCEntityDestroyAll('ACS_Player_Custom_Camera');

		ACSGetCEntityDestroyAll('ACS_Free_Camera');

		ACSGetCEntityDestroyAll('ACS_Fast_Travel_Camera');
	}

	private var meditation_index_1																										: int;
	default meditation_index_1 																											= -1;

	private var previous_meditation_index_1																								: int;
	default previous_meditation_index_1 																								= -1;

	var meditationWeaponsOnGround : bool;

	timer function CreateMeditationItemsActionDelay( deltaTime : float , id : int)	
	{
		thePlayer.RaiseEvent('ACS_GiveItem');

		RemoveTimer('CreateMeditationBase');
		AddTimer('CreateMeditationBase', 1 , false);

		if (ACS_Settings_Main_Bool('acs_meditation_settings','acs_meditation_weapons_on_ground_enabled', true))
		{
			if(GetWitcherPlayer().IsAnyItemEquippedOnSlot(EES_SilverSword) 
			|| GetWitcherPlayer().IsAnyItemEquippedOnSlot(EES_SteelSword))
			{
				if((!GetWitcherPlayer().IsAnyWeaponHeld() || GetWitcherPlayer().IsWeaponHeld('fist')))
				{
					RemoveTimer('CreateMeditationWeapons');
					AddTimer('CreateMeditationWeapons', 1 , false);

					meditationWeaponsOnGround = true;
				}
			}
		}
	}

	timer function CreateMeditationBase( deltaTime : float , id : int)	
	{
		var base, book, herb01, herb02, herb03, bolt, boltRow01, boltRow02, boltRow03, bottle1 			: CEntity;
		var bomb11, bomb22																				: CEntity;
		var row01i, row02i, row03i																		: Int;
		var quantity,row1,row2,row3 																	: Int;
		var boltid,bomb1id,bomb2id,potid																: SItemUniqueId;
		var deployedEnt																					: W3BoltProjectile;
		var bomb1, bomb2																				: W3Petard;
		var vial1, vial2, vial3, vial4																	: CEntity;

		var base_roll, base_pitch, base_yaw 															: Float; 
		var base_pos_x,base_pos_y,base_pos_z   															: Float;
		var meditation_base_position																	: Vector;
		var meditation_base_rotation							 										: EulerAngles;
		var meshComponent 																				: CMeshComponent;

		if ( !theGame.GetEntityByTag('ACS_Meditation_Base') )
		{
			base = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource(

			"items\work\folded_sail_01\folded_sail_01.w2ent"

			,true ), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation()  );

			switch(ACS_Settings_Main_Int('acs_meditation_settings','acs_meditation_base_positioning', 0))
			{
				case 8:
				base_pos_x = -0.03;
				base_pos_y = 1.45;
				base_pos_z = 0.08;

				base_roll = 180;
				base_pitch = 0;
				base_yaw = 0;
				break;

				case 7:
				base_pos_x = -0.03;
				base_pos_y = 1.13;
				base_pos_z = 0.08;

				base_roll = 180;
				base_pitch = 0;
				base_yaw = 0;
				break;

				case 6:
				base_pos_x = -0.03;
				base_pos_y = 0.85;
				base_pos_z = 0.08;

				base_roll = 180;
				base_pitch = 0;
				base_yaw = 0;
				break;

				case 5:
				base_pos_x = 0.35;
				base_pos_y = 0.75;
				base_pos_z = 0.08;

				base_roll = 180;
				base_pitch = 0;
				base_yaw = -30;
				break;

				case 4:
				base_pos_x = -0.5;
				base_pos_y = 0.75;
				base_pos_z = 0.08;

				base_roll = 180;
				base_pitch = 0;
				base_yaw = 40;
				break;

				case 3:
				base_pos_x = 0.65;
				base_pos_y = 0.80;
				base_pos_z = 0.08;

				base_roll = 180;
				base_pitch = 0;
				base_yaw = -90;
				break;

				case 2:
				base_pos_x = -0.65;
				base_pos_y = 0.70;
				base_pos_z = 0.08;

				base_roll = 180;
				base_pitch = 0;
				base_yaw = 90;
				break;

				case 1:
				base_pos_x = 1;
				base_pos_y = 0.9;
				base_pos_z = 0.08;

				base_roll = 180;
				base_pitch = 0;
				base_yaw = -45;
				break;

				case 0:
				base_pos_x = -1;
				base_pos_y = 0.9;
				base_pos_z = 0.08;

				base_roll = 180;
				base_pitch = 0;
				base_yaw = 45;
				break;
				
				default:
				base_pos_x = -1;
				base_pos_y = 0.9;
				base_pos_z = 0.08;

				base_roll = 180;
				base_pitch = 0;
				base_yaw = 45;
				break;
			}

			base.BreakAttachment();
			
			meditation_base_position.X = 0;             
			meditation_base_position.Y = 0;
			meditation_base_position.Z = 0;

			meditation_base_rotation.Roll = 0;
			meditation_base_rotation.Pitch = 0;
			meditation_base_rotation.Yaw = 0;
			
			meditation_base_position.X += base_pos_x;            
			meditation_base_position.Y += base_pos_y;
			meditation_base_position.Z += base_pos_z;

			meditation_base_rotation.Roll += base_roll;
			meditation_base_rotation.Pitch += base_pitch;
			meditation_base_rotation.Yaw += base_yaw;
			
			base.CreateAttachment( thePlayer,,meditation_base_position, meditation_base_rotation );

			base.BreakAttachment();
			meditation_base_position = TraceFloor(base.GetWorldPosition());
			meditation_base_position.Z += base_pos_z;
			base.Teleport( meditation_base_position );

			base.AddTag('ACS_Meditation_Item');

			base.AddTag('ACS_Meditation_Base');
		}

		if (ACS_Settings_Main_Bool('acs_meditation_settings','acs_meditation_book_on_ground_enabled', true))
		{
			if ( !theGame.GetEntityByTag('ACS_Meditation_Book') )
			{
				if ( ( GetRainStrength()+GetSnowStrength() ) > 0 )
				{
					book = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource(

					"dlc\bob\data\items\quest_items\q705\q705_gmpl_yens_book.w2ent"

					,true ),thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation()  );

					book.AddTag('ACS_Meditation_Book_Closed');
				}

				if ( ( GetRainStrength()+GetSnowStrength() ) <= 0 )
				{
					book = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource(

					"dlc\bob\data\items\work\book\gen_open_book_a.w2ent"

					,true ), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation()  );

					book.AddTag('ACS_Meditation_Book_Open');
				}

				book.BreakAttachment();
				
				meditation_base_position.X = 0;    
				meditation_base_position.Y = 0; 
				meditation_base_position.Z = 0; 

				meditation_base_rotation.Roll = 0;
				meditation_base_rotation.Pitch = 0;
				meditation_base_rotation.Yaw = 0;
				
				meditation_base_position.X -= 0.125;            
				meditation_base_position.Y += -0.14;
				meditation_base_position.Z -= 0.08;

				meditation_base_rotation.Roll += -110;
				meditation_base_rotation.Pitch += 0;
				meditation_base_rotation.Yaw += 90;
				
				if ( book.HasTag('ACS_Meditation_Book_Open') )
				{
					meditation_base_rotation.Roll = 0;
					meditation_base_rotation.Pitch = 105;
					meditation_base_rotation.Yaw = 0;
				}
				
				book.CreateAttachment( theGame.GetEntityByTag('ACS_Meditation_Base'),,meditation_base_position, meditation_base_rotation );
			
				book.BreakAttachment();

				meditation_base_position = TraceFloor(book.GetWorldPosition());

				meditation_base_position.Z += base_pos_z;

				book.Teleport( meditation_base_position );

				book.AddTag('ACS_Meditation_Item');

				book.AddTag('ACS_Meditation_Book');	
			}
		}

		if (ACS_Settings_Main_Bool('acs_meditation_settings','acs_meditation_herbs_on_ground_enabled', true))
		{
			if ( !theGame.GetEntityByTag('ACS_Meditation_Herbs_01'))
			{
				herb01 = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource(

				"dlc\bob\data\environment\decorations\gameplay\generic\decoration_set\herbs\deco_gen_herb_f.w2ent"
				
				,true ), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation()  );

				herb01.BreakAttachment();
				
				meditation_base_position.X = 0;             
				meditation_base_position.Y = 0; 
				meditation_base_position.Z = 0; 

				meditation_base_rotation.Roll = 0;
				meditation_base_rotation.Pitch = 0;
				meditation_base_rotation.Yaw = 0;
				
				meditation_base_position.X -= 0.105;            
				meditation_base_position.Y += -0.02; 
				meditation_base_position.Z -= -0.03;

				meditation_base_rotation.Roll += 0;
				meditation_base_rotation.Pitch += 180;
				meditation_base_rotation.Yaw += 120;
				
				herb01.CreateAttachment( theGame.GetEntityByTag('ACS_Meditation_Base'),,meditation_base_position, meditation_base_rotation );
				
				herb01.AddTag('ACS_Meditation_Item');	
				herb01.AddTag('ACS_Meditation_Herbs_01');	
			}

			if ( !theGame.GetEntityByTag('ACS_Meditation_Herbs_02'))
			{
				herb02 = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource(

				"items\work\herbs\tool_herb_a.w2ent"
				
				,true ), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation()  );

				herb02.BreakAttachment();
				
				meditation_base_position.X = 0;             
				meditation_base_position.Y = 0; 
				meditation_base_position.Z = 0; 

				meditation_base_rotation.Roll = 0;
				meditation_base_rotation.Pitch = 0;

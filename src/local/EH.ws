	function RadialMenuCheck() : bool
	{
		var hud 															: CR4ScriptedHud;
		var moduleRadial													: CR4HudModuleRadialMenu;

		hud = (CR4ScriptedHud)theGame.GetHud();

		moduleRadial = (CR4HudModuleRadialMenu)hud.GetHudModule("RadialMenuModule");

		if( (moduleRadial && moduleRadial.IsRadialMenuOpened())
		)
		{
			return true;
		}

		return false;
	}

	function HudExceptionInputHandle() : bool
	{
		if( 
		FactsQuerySum("q001_nightmare_ended") <= 0
		)
		{
			if( theInput.GetActionValue(TargetLockOrSpawnHorse()) > 0.1f
			|| theInput.GetActionValue('CameraLockOrSpawnHorse') > 0.1f
			|| theInput.GetActionValue('SpawnHorse') > 0.1f
			|| theInput.GetActionValue('CastSign') > 0.1f
			|| theInput.GetActionValue('Focus') > 0.1f
			|| theInput.GetActionValue('HighlightObjective') > 0.1f
			|| theInput.GetActionValue('DrinkPotionUpperHold') > 0.1f
			|| theInput.GetActionValue('DrinkPotionLowerHold') > 0.1f
			|| theInput.GetActionValue('DrinkPotion1') > 0.1f
			|| theInput.GetActionValue('DrinkPotion2') > 0.1f
			|| theInput.GetActionValue('DrinkPotion3') > 0.1f
			|| theInput.GetActionValue('DrinkPotion4') > 0.1f
			|| theInput.GetActionValue('ToggleSigns') != 0
			|| theInput.GetActionValue('ThrowItem') > 0.1f
			|| theInput.GetActionValue('ThrowItemHold') > 0.1f
			|| theInput.GetActionValue('ThrowCastAbort') > 0.1f
			|| theInput.GetActionValue('CbtRoll') > 0.1f
			|| theInput.GetActionValue(DodgeOrRoll()) > 0.1f
			|| theInput.GetActionValue('LockAndGuard') > 0.1f
			|| theInput.GetActionValue('GPadLockandGuard') > 0.1f
			|| theInput.GetActionValue('AltQuenCasting') > 0.1f
			//|| theInput.GetActionValue('HighlightObjective') > 0.1f
			|| theInput.GetActionValue('VehicleCastSign') > 0.1f
			|| theInput.GetActionValue('VehicleAttack') > 0.1f
			|| theInput.GetActionValue('Finish') > 0.1
			|| theInput.GetActionValue('Finisher') > 0.1
			|| menuChanged
			|| thePlayer.HasTag('ACS_Drawn_Weapon')
			|| thePlayer.HasTag('ACS_Player_Casted_Sign')
			|| !ACS_CombatToExplorationCheck()
			|| thePlayer.IsInCombat()
			|| thePlayer.IsInCombatState()
			|| theGame.IsFocusModeActive()
			|| thePlayer.IsThreatened()
			//|| thePlayer.IsDeadlySwordHeld()
			)
			{
				hud_exception_flag = true;
		
				RemoveTimer('Hud_Exception_Input_Reset');
				AddTimer('Hud_Exception_Input_Reset', 3, false);

				return true;
			}

			return false;
		}

		if( theInput.GetActionValue(TargetLockOrSpawnHorse()) > 0.1f
		|| theInput.GetActionValue('CameraLockOrSpawnHorse') > 0.1f
		|| theInput.GetActionValue('SpawnHorse') > 0.1f
		|| theInput.GetActionValue('CastSign') > 0.1f
		|| theInput.GetActionValue('Focus') > 0.1f
		|| theInput.GetActionValue('HighlightObjective') > 0.1f
		|| theInput.GetActionValue('DrinkPotionUpperHold') > 0.1f
		|| theInput.GetActionValue('DrinkPotionLowerHold') > 0.1f
		|| theInput.GetActionValue('DrinkPotion1') > 0.1f
		|| theInput.GetActionValue('DrinkPotion2') > 0.1f
		|| theInput.GetActionValue('DrinkPotion3') > 0.1f
		|| theInput.GetActionValue('DrinkPotion4') > 0.1f
		|| theInput.GetActionValue('ToggleSigns') != 0
		|| theInput.GetActionValue('ThrowItem') > 0.1f
		|| theInput.GetActionValue('ThrowItemHold') > 0.1f
		|| theInput.GetActionValue('ThrowCastAbort') > 0.1f
		|| theInput.GetActionValue('CbtRoll') > 0.1f
		|| theInput.GetActionValue(DodgeOrRoll()) > 0.1f
		|| theInput.GetActionValue('LockAndGuard') > 0.1f
		|| theInput.GetActionValue('GPadLockandGuard') > 0.1f
		|| theInput.GetActionValue('AltQuenCasting') > 0.1f
		//|| theInput.GetActionValue('HighlightObjective') > 0.1f
		|| theInput.GetActionValue('VehicleCastSign') > 0.1f
		|| theInput.GetActionValue('VehicleAttack') > 0.1f
		|| theInput.GetActionValue('Finish') > 0.1
		|| theInput.GetActionValue('Finisher') > 0.1
		|| menuChanged
		|| thePlayer.HasTag('ACS_Drawn_Weapon')
		|| thePlayer.HasTag('ACS_Player_Casted_Sign')
		|| !ACS_CombatToExplorationCheck()
		|| thePlayer.IsInCombat()
		|| thePlayer.IsInCombatState()
		|| theGame.IsFocusModeActive()
		|| thePlayer.IsThreatened()
		//|| ACS_MagicDetected()
		//|| ACS_PlaceOfPowerDetected()
		//|| thePlayer.IsDeadlySwordHeld()
		)
		{
			hud_exception_flag = true;
		
			RemoveTimer('Hud_Exception_Input_Reset');
			AddTimer('Hud_Exception_Input_Reset', 3, false);

			return true;
		}

		return false;
	}

	function HudExceptionCheck() : bool
	{
		if( HudExceptionInputHandle()
		|| hud_exception_flag
		)
		{
			return true;
		}

		return false;
	}

	var hud_exception_flag : bool;

	function Enable_Hud_Exception_Flag( b : bool )
	{
		hud_exception_flag = b;

		if(b)
		{
			RemoveTimer('Hud_Exception_Input_Reset');
			AddTimer('Hud_Exception_Input_Reset', 3, false);
		}
	}

	timer function Hud_Exception_Input_Reset( time : float , id : int )
	{
		hud_exception_flag = false;
	}

	timer function Player_Casted_Sign_Reset( time : float , id : int )
	{
		thePlayer.RemoveTag('ACS_Player_Casted_Sign');
	}

	timer function Drawn_Weapon_Reset( time : float , id : int )
	{
		thePlayer.RemoveTag('ACS_Drawn_Weapon');
	}


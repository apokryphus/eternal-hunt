					case 6: 
					if (RandF() < 0.5)
					{
						PlayerPlayAnimation( 'woman_sorceress_attack_rock_lhand_lp_ACS');	

						sorcfxspawn('ACS_Sorc_Fire_Line_Left');
					}
					else
					{
						PlayerPlayAnimation( 'woman_sorceress_attack_rock_lhand_rp_ACS');	

						sorcfxspawn('ACS_Sorc_Frost_Line_Left');
					}

					combo_counter_damage -= combo_counter_damage;

					combo_counter_sorc_attack_heavy += 1;
					break;

					case 7:
					if (RandF() < 0.5)
					{
						PlayerPlayAnimation( 'woman_sorceress_attack_rock_bhand_rp_ACS');	

						sorcfxspawn('ACS_Sorc_Fire_Double_Line');
					}
					else
					{
						PlayerPlayAnimation( 'woman_sorceress_attack_rock_bhand_lp_ACS');	

						sorcfxspawn('ACS_Sorc_Frost_Double_Line');
					}

					combo_counter_damage += 1;

					combo_counter_sorc_attack_heavy -= combo_counter_sorc_attack_heavy;
					break;
				}
			break;

			case 'geraltRandomKick':
				RemoveTimer('ACS_Combo_Counter_Reset_Timer'); AddTimer('ACS_Combo_Counter_Reset_Timer', 4 , false);

				switch ( combo_counter_kick )
				{
					default:
					PlayerPlayAnimation( 'man_geralt_sword_repel_lp_kick_ACS');	

					combo_counter_damage -= combo_counter_damage;

					combo_counter_kick += 1;
					break;

					case 0: 
					PlayerPlayAnimation( 'man_geralt_sword_repel_lp_kick_ACS');	

					combo_counter_damage -= combo_counter_damage;

					combo_counter_kick += 1;
					break;

					case 1:
					PlayerPlayAnimation( 'man_geralt_sword_repel_rp_kick_ACS');	

					combo_counter_damage += 1;

					combo_counter_kick -= combo_counter_kick;
					break;
				}
			break;

			case 'geraltRandomPush':
				RemoveTimer('ACS_Combo_Counter_Reset_Timer'); AddTimer('ACS_Combo_Counter_Reset_Timer', 4 , false);

				switch ( combo_counter_push )
				{
					default:
					PlayerPlayAnimation( 'man_geralt_sword_repel_rp_bash_ACS');


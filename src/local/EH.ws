						ACSGetCEntity('ACS_Shield').StopEffect('destroy');
						ACSGetCEntity('ACS_Shield').PlayEffectSingle('destroy_shield_fx');
						ACSGetCEntity('ACS_Shield').StopEffect('destroy_shield_fx');
						ACSGetCEntity('ACS_Shield').PlayEffectSingle('igni_cone_hit');
						ACSGetCEntity('ACS_Shield').StopEffect('igni_cone_hit');


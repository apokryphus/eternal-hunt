	private var freeCamera 						: ACSFreeCamera;

	public function SetFreeCamera( a : ACSFreeCamera )
	{
		this.freeCamera = a;
	}

	public function GetFreeCamera() : ACSFreeCamera
	{
		return this.freeCamera;
	}

	var m_lastActiveCam : CCustomCamera;

	function FreeCamera()
	{
		var template	: CEntityTemplate;
		var ent			: CEntity;

		CamerasDestroy();

		template = (CEntityTemplate)LoadResource("dlc\dlc_acs\data\entities\other\acs_free_camera.w2ent", true);

		ent = (CStaticCamera)theGame.CreateEntity(template, theCamera.GetCameraPosition(), theCamera.GetCameraRotation());	

		ent.AddTag('ACS_Free_Camera');
	}

	function FreeCameraDestroy()
	{
		GetFreeCamera().Stop();

		GetFreeCamera().DestroyAfter(1.1);
	}

	timer function FreeCameraDestroyDelay( deltaTime : float , id : int)
	{	
		GetFreeCamera().Stop();

		GetFreeCamera().DestroyAfter(1.1);
	}


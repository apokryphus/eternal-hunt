		+ "<br/>" 
		
		+ GetLocStringById(2117035586) + GetACSStorage().acs_GetKillCountString('hybrid')

		+ "<br/>" 
		
		+ GetLocStringById(2117035587) + GetACSStorage().acs_GetKillCountString('insectoid')

		+ "<br/>" 
		
		+ GetLocStringById(2117035588) + GetACSStorage().acs_GetKillCountString('necrophage')

		+ "<br/>" 
		
		+ GetLocStringById(2117035589) + GetACSStorage().acs_GetKillCountString('ogroid')

		+ "<br/>" 
		
		+ GetLocStringById(2117035590) + GetACSStorage().acs_GetKillCountString('relict')

		+ "<br/>" 
		
		+ GetLocStringById(2117035591) + GetACSStorage().acs_GetKillCountString('spectre')

		+ "<br/>" 
		
		+ GetLocStringById(2117035592) + GetACSStorage().acs_GetKillCountString('vampire')

		+ "<br/>" 
		
		+ GetLocStringById(2117035593) + GetACSStorage().acs_GetKillCountString('other')
		
		;

		msg = new W3TutorialPopupData in thePlayer;

		msg.managerRef = theGame.GetTutorialSystem();

		msg.messageTitle = Title;

		msg.imagePath = "";

		msg.messageText = Message;

		msg.enableGlossoryLink = true;

		msg.autosize = true;

		msg.blockInput = true;

		msg.pauseGame = true;

		msg.fullscreen = true;

		msg.canBeShownInMenus = true;

		msg.fadeBackground = true;

		msg.duration = -1;

		msg.posX = 0;

		msg.posY = 0;

		msg.enableAcceptButton = true;

		theGame.GetTutorialSystem().ShowTutorialHint(msg);
	}


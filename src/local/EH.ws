	{
		var targetDistance						: float;

		targetDistance = VecDistanceSquared2D( GetWitcherPlayer().GetWorldPosition(), ACSGetCEntity('ACS_Guiding_Light_POI_Marker').GetWorldPosition() ) ;

		if (ACS_Settings_Main_Bool('acs_hud_settings_markers','acs_marker_bubble_enabled', false))
		{

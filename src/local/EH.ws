		this.previous_transformation_giant_light_attack_index_2 = transformation_giant_light_attack_index_2;
	}

	public timer function Transformation_Giant_Secondary_Attack ( dt : float, id : int) 
	{
		TransformationGiantAnchorSwitch(true, false, 0.1);

		transformation_giant_light_attack_index_3 = RandDifferent(this.previous_transformation_giant_light_attack_index_3 , 8);

		switch (transformation_giant_light_attack_index_3) 
		{
			case 7:
			ACSTransformationGiantPlayAnim( 'giant_combat_anchor_attack_far_fr_acs_ice_giant', 0.25f, 0.325f);
			break;

			case 6:
			ACSTransformationGiantPlayAnim( 'giant_combat_anchor_attack_far_fl_acs_ice_giant', 0.25f, 0.325f);
			break;

			case 5:
			ACSTransformationGiantPlayAnim( 'giant_combat_anchor_attack_far_r_acs_ice_giant', 0.25f, 0.325f);
			break;

			case 4:
			ACSTransformationGiantPlayAnim( 'giant_combat_anchor_attack_far_l_acs_ice_giant', 0.25f, 0.325f);
			break;

			case 3:
			ACSTransformationGiantPlayAnim( 'giant_combat_anchor_attack_far_bl_acs_ice_giant', 0.25f, 0.325f);
			break;

			case 2:
			ACSTransformationGiantPlayAnim( 'giant_combat_anchor_attack_far_br_acs_ice_giant', 0.25f, 0.325f);
			break;

			case 1:
			ACSTransformationGiantPlayAnim( 'giant_combat_anchor_attack_far_b_acs_ice_giant', 0.25f, 0.325f);
			break;

			default:
			ACSTransformationGiantPlayAnim( 'giant_combat_anchor_attack_far_f_acs_ice_giant', 0.25f, 0.325f);
			break;
		}

		this.previous_transformation_giant_light_attack_index_3 = transformation_giant_light_attack_index_3;
	}

	function ACS_Transformation_Giant_Heavy_Attacks()
	{
		if (theGame.GetEngineTimeAsSeconds() - last_transformation_heavy_attack_time > transformation_heavy_attack_cooldown)
		{
			last_transformation_heavy_attack_time = theGame.GetEngineTimeAsSeconds();

			ACSTransformationGiantRemoveMoveTimers();

			if (thePlayer.IsInCombat())
			{
				ACSTransformationGiantMovementAdjust('rotatetoenemy', true);
			}
			else
			{
				ACSTransformationGiantMovementAdjust('forward', true);
			}

			if (!ACSGetCActor('ACS_Transformation_Giant').HasTag('ACS_Transformation_Giant_Weapon_Mode'))
			{
				transformation_giant_heavy_attack_index_1 = RandDifferent(this.previous_transformation_giant_heavy_attack_index_1 , 2);

				switch (transformation_giant_heavy_attack_index_1) 
				{	
					case 1:
					ACSTransformationGiantPlayAnim( 'giant_combat_attack_ground_2_acs_ice_giant', 0.25f, 0.325f);
					break;

					default:
					ACSTransformationGiantPlayAnim( 'giant_combat_attack_ground_1_acs_ice_giant', 0.25f, 0.325f);
					break;
				}
		
				this.previous_transformation_giant_heavy_attack_index_1 = transformation_giant_heavy_attack_index_1;
			}
			else
			{
				transformation_giant_heavy_attack_index_2 = RandDifferent(this.previous_transformation_giant_heavy_attack_index_2 , 3);

				switch (transformation_giant_heavy_attack_index_2) 
				{	
					case 2:
					TransformationGiantAnchorSwitch(false, false, 0);
					RemoveTimer('Transformation_Giant_Secondary_Attack');
					AddTimer('Transformation_Giant_Secondary_Attack', 4   , false);
					ACSTransformationGiantPlayAnim( 'giant_combat_anchor_attack_distance', 0.25f, 0.325f);
					break;

					case 1:
					TransformationGiantAnchorSwitch(false, false, 0);
					RemoveTimer('Transformation_Giant_Secondary_Attack');
					AddTimer('Transformation_Giant_Secondary_Attack', 5   , false);
					ACSTransformationGiantPlayAnim( 'giant_heavy_stomp', 0.25f, 0.325f);
					break;

					default:
					TransformationGiantAnchorSwitch(true, false, 0.1);
					ACSTransformationGiantPlayAnim( 'giant_combat_anchor_attack_distance_acs_ice_giant', 0.25f, 0.325f);
					break;
				}
		
				this.previous_transformation_giant_heavy_attack_index_2 = transformation_giant_heavy_attack_index_2;
			}
			
			ACS_StaminaDrain(5, true);
		}
	}

	function ACS_Transformation_Giant_Special_Attacks()
	{
		if (theGame.GetEngineTimeAsSeconds() - last_transformation_special_attack_time > transformation_special_attack_cooldown)
		{
			last_transformation_special_attack_time = theGame.GetEngineTimeAsSeconds();

			ACSTransformationGiantRemoveMoveTimers();

			if (thePlayer.IsInCombat())
			{
				ACSTransformationGiantMovementAdjust('rotatetoenemy', true);
			}
			else
			{
				ACSTransformationGiantMovementAdjust('forward', true);
			}

			if (!ACSGetCActor('ACS_Transformation_Giant').HasTag('ACS_Transformation_Giant_Weapon_Mode'))
			{
				//ACSGetCActor('ACS_Transformation_Giant').PlayEffectSingle('ground_drag_stone_wheel_r');

				//ACSGetCActor('ACS_Transformation_Giant').PlayEffectSingle('trail_stone_wheel_r');

				//ACSGetCActor('ACS_Transformation_Giant').PlayEffectSingle('trail_360_stone_wheel_r');

				//ACSGetCActor('ACS_Transformation_Giant').PlayEffectSingle('ground_drag_stone_wheel_l');

				//ACSGetCActor('ACS_Transformation_Giant').PlayEffectSingle('trail_stone_wheel_l');

				//ACSGetCActor('ACS_Transformation_Giant').PlayEffectSingle('trail_360_stone_wheel_l');
				
				transformation_giant_special_attack_index_1 = RandDifferent(this.previous_transformation_giant_special_attack_index_1 , 2);

				switch (transformation_giant_special_attack_index_1) 
				{	
					case 1:
					ACSTransformationGiantPlayAnim( 'giant_combat_attack_charge_acs_ice_giant', 0.25f, 0.325f);
					break;

					default:
					ACSTransformationGiantPlayAnim( 'giant_combat_attack_charge_acs_ice_giant', 0.25f, 0.325f);
					break;
				}
		
				this.previous_transformation_giant_special_attack_index_1 = transformation_giant_special_attack_index_1;
			}
			else
			{
				transformation_giant_special_attack_index_2 = RandDifferent(this.previous_transformation_giant_special_attack_index_2 , 2);

				switch (transformation_giant_special_attack_index_2) 
				{	
					case 1:
					TransformationGiantAnchorSwitch(false, true, 5.5);
					ACSTransformationGiantPlayAnim( 'giant_whirlwind_attack_long', 0.25f, 0.325f);
					break;

					default:
					TransformationGiantAnchorSwitch(false, true, 4);
					ACSTransformationGiantPlayAnim( 'giant_whirlwind_attack', 0.25f, 0.325f);
					break;
				}
		
				this.previous_transformation_giant_special_attack_index_2 = transformation_giant_special_attack_index_2;
			}
			
			ACS_StaminaDrain(5, true);
		}
	}

	function ACS_Transformation_Giant_Dodge()
	{
		if (theGame.GetEngineTimeAsSeconds() - last_transformation_dodge_time > transformation_dodge_cooldown)
		{
			last_transformation_dodge_time = theGame.GetEngineTimeAsSeconds();

			ACSTransformationGiantRemoveMoveTimers();

			ACSGetCActor('ACS_Transformation_Giant').AddTag('ACS_Transformation_Giant_Block_All_Actions');

			thePlayer.SetImmortalityMode( AIM_Invulnerable, AIC_Default, true ); 

			thePlayer.SetIsCurrentlyDodging(true);

			ACSGetCActor('ACS_Transformation_Giant').EnableCharacterCollisions(false);

			RemoveTimer('ACS_transformation_giant_dodge_slide');

			AddTimer('ACS_transformation_giant_dodge_slide', 1     , false);

			RemoveTimer('ACS_transformation_giant_dodge_timer_end');

			AddTimer('ACS_transformation_giant_dodge_timer_end', 1.75     , false);

			if (thePlayer.IsInCombat())
			{
				ACSTransformationGiantMovementAdjust('rotatetoenemy', true);
			}
			else
			{
				ACSTransformationGiantMovementAdjust('forward', true);
			}

			ACSTransformationGiantPlayAnim( 'giant_digging_down', 0.125f, 0.325f);

			if (!ACSGetCActor('ACS_Transformation_Giant').HasTag('ACS_Transformation_Giant_Weapon_Mode'))
			{
				//((CNewNPC)ACSGetCActor('ACS_Transformation_Giant')).SetBehaviorVariable( 'targetAngleDiff', RandRange(1,9), true );
				
				((CAnimatedComponent)((CNewNPC)ACSGetCActor('ACS_Transformation_Giant')).GetComponentByClassName( 'CAnimatedComponent' )).RaiseBehaviorForceEvent('AttackOverride');
			}
			else
			{
				TransformationGiantAnchorSwitch(false, true, 3);
			}

			ACS_StaminaDrain(5, true);
		}
	}

	public timer function ACS_transformation_giant_dodge_slide ( dt : float, id : int) 
	{
		 ACSTransformationGiantMovementAdjust('rotatetoenemyandslide', true);
	}

	public timer function ACS_transformation_giant_dodge_timer_end ( dt : float, id : int) 
	{ 
		ACSTransformationGiantMovementAdjust('rotatetoenemyandslide', true);

		if (ACSGetCActor('ACS_Transformation_Giant').HasTag('ACS_Transformation_Giant_Weapon_Mode'))
		{
			TransformationGiantAnchorSwitch(false, true, 4);
			ACSTransformationGiantPlayAnim( 'giant_digging_up_attack', 0.25f, 0.325f);
		}
		else
		{
			ACSTransformationGiantPlayAnim( 'giant_digging_up', 0.25f, 0.325f);
			//((CNewNPC)ACSGetCActor('ACS_Transformation_Giant')).SetBehaviorVariable( 'targetAngleDiff', RandRange(1,9), true );
			
			((CAnimatedComponent)((CNewNPC)ACSGetCActor('ACS_Transformation_Giant')).GetComponentByClassName( 'CAnimatedComponent' )).RaiseBehaviorForceEvent('AttackOverride');
		}

		RemoveTimer('ACS_transformation_giant_remove_action_block');

		AddTimer('ACS_transformation_giant_remove_action_block', 1.5     , false);

		thePlayer.SetImmortalityMode( AIM_None, AIC_Default, true ); 

		thePlayer.SetIsCurrentlyDodging(false);

		ACSGetCActor('ACS_Transformation_Giant').EnableCharacterCollisions(true);
	} 

	public timer function ACS_transformation_giant_remove_action_block ( dt : float, id : int) 
	{
		ACSGetCActor('ACS_Transformation_Giant').StopEffect('ground_drag_stone_wheel');

		ACSGetCActor('ACS_Transformation_Giant').RemoveTag('ACS_Transformation_Giant_Block_All_Actions');
	}

	function TransformationGiantAnchorSwitch( b, restore : bool, restore_time: float)
	{
		var l_comp 															: array< CComponent >;
		var size, j 														: int;
		
		l_comp = ((CActor)ACSGetCActor('ACS_Transformation_Giant')).GetComponentsByClassName( 'CMorphedMeshManagerComponent' );
		size = l_comp.Size();

		if (b)
		{
			for ( j=0; j<size; j+= 1 )
			{
				((CMorphedMeshManagerComponent)l_comp[ j ]).SetMorphBlend( 1, 0.001 );
			}

			RemoveTimer('ACS_transformation_giant_restore_anchor');
		}
		else
		{
			for ( j=0; j<size; j+= 1 )
			{
				((CMorphedMeshManagerComponent)l_comp[ j ]).SetMorphBlend( 0, 0.001 );
			}

			RemoveTimer('ACS_transformation_giant_restore_anchor');

			if (restore)
			{
				AddTimer('ACS_transformation_giant_restore_anchor', restore_time , false);
			}
		}
	}


	public timer function ACS_transformation_giant_restore_anchor ( dt : float, id : int) 
	{
		var l_comp 															: array< CComponent >;
		var size, j 														: int;
		
		l_comp = ((CActor)ACSGetCActor('ACS_Transformation_Giant')).GetComponentsByClassName( 'CMorphedMeshManagerComponent' );
		size = l_comp.Size();

		for ( j=0; j<size; j+= 1 )
		{
			((CMorphedMeshManagerComponent)l_comp[ j ]).SetMorphBlend( 1, 0.001 );
		}
	}

	var last_transformation_giant_taunt_time : float;

	function Refresh_Transformation_Giant_Taunt_Cooldown() 
	{
		last_transformation_giant_taunt_time = theGame.GetEngineTimeAsSeconds();
	}

	var last_transformation_giant_get_position_time : float;

	var transformation_giant_position : Vector;

	function Transformation_Giant_Sprint_Modifier()
	{
		if (ACSGetCActor('ACS_Transformation_Giant').HasTag('ACS_Transformation_Giant_Performed_Action')
		|| ACSGetCActor('ACS_Transformation_Giant').HasTag('ACS_Transformation_Giant_Is_Parrying')
		)
		{
			return;
		}

		if (theGame.GetEngineTimeAsSeconds() - last_transformation_giant_get_position_time > 0.125)
		{
			last_transformation_giant_get_position_time = theGame.GetEngineTimeAsSeconds();

			transformation_giant_position = ACSGetCActor('ACS_Transformation_Giant').GetWorldPosition();
		}

		if (
		theInput.IsActionPressed('Sprint')
		&& transformation_giant_position != ACSGetCActor('ACS_Transformation_Giant').GetWorldPosition()
		)
		{
			ACSGetCActor('ACS_Transformation_Giant').GetMovingAgentComponent().ACS_SetAnimationSpeedMultiplier(1.5); 
		}
		else
		{
			ACSGetCActor('ACS_Transformation_Giant').GetMovingAgentComponent().ACS_SetAnimationSpeedMultiplier(1); 
		}
	}

	function ACS_Transformation_Giant_Move_Controls()
	{
		var event_names	: array<name>;
		var lookatPos : Vector;
		if (thePlayer.IsInCombat())
		{
			if (ACSGetCActor('ACS_Transformation_Giant').HasTag('ACS_Transformation_Giant_Weapon_Mode'))
			{
				if (thePlayer.GetStat(BCS_Toxicity) < thePlayer.GetStatMax(BCS_Toxicity))
				{
					thePlayer.GainStat(BCS_Toxicity, (thePlayer.GetStatMax(BCS_Toxicity) - thePlayer.GetStat(BCS_Toxicity)) * 0.00049);
				}
				
				thePlayer.DrainVitality(thePlayer.GetStat(BCS_Vitality) * 0.000245);
			}
			else
			{
				if (thePlayer.GetStat(BCS_Toxicity) < thePlayer.GetStatMax(BCS_Toxicity))
				{
					thePlayer.GainStat(BCS_Toxicity, (thePlayer.GetStatMax(BCS_Toxicity) - thePlayer.GetStat(BCS_Toxicity)) * 0.00006125);
				}
				
				thePlayer.DrainVitality(thePlayer.GetStat(BCS_Vitality) * 0.000030625);
			}
		}
		else
		{
			if (thePlayer.GetStat(BCS_Toxicity) < thePlayer.GetStatMax(BCS_Toxicity))
			{
				thePlayer.GainStat(BCS_Toxicity, (thePlayer.GetStatMax(BCS_Toxicity) - thePlayer.GetStat(BCS_Toxicity)) * 0.000030625);
			}
			
			thePlayer.DrainVitality(thePlayer.GetStat(BCS_Vitality) * 0.0000153125);
		}

		if (thePlayer.GetStat(BCS_Focus) >= thePlayer.GetStatMax( BCS_Focus ) * 0.9875)
		{
			if (!ACSGetCActor('ACS_Transformation_Giant').IsEffectActive('lightning_effect'))
			{
				RemoveTimer('ShrinkTransformationGiantTimer');
				RemoveTimer('GrowTransformationGiantTimer');
				AddTimer('GrowTransformationGiantTimer', 0.01 , true);

				ACSGetCActor('ACS_Transformation_Giant').PlayEffect('lightning_effect');
			}

			if (ACSGetCActor('ACS_Transformation_Giant').IsEffectActive('lightning_effect_normal'))
			{
				ACSGetCActor('ACS_Transformation_Giant').StopEffect('lightning_effect_normal');
			}

			if (ACSGetCEntity('ACS_Transformation_Giant_Back_Weapons').IsEffectActive('lightning_hit'))

	public timer function WerewolfHeavyAttackDamage(deltaTime : float , id : int)
	{
		var attackRange, attackAngle 	: float;

		if (ACSGetCActor('ACS_Transformation_Werewolf').HasTag('ACS_Werewolf_Berserk_Mode'))
		{
			attackRange = 3;

			attackAngle = 60;
		}

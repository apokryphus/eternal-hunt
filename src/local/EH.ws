	function NormalFistLightAttack()
	{
		if (!ACS_DefaultMovesetCombatAnimationOverrideMode_Enabled())
		{
			ACS_Setup_Light_Attack_Internal();	

			return;
		}

		ACS_ExplorationDelayHack(false, 3);

		if (
		ACS_Settings_Main_Bool('acs_stamina_settings','acs_stamina_block_action', false) 
		&& 
		StaminaCheck('fist')
		)
		{ 
			RemoveTimer('SwordTauntSwitch'); RemoveTimer('SwordTauntRunningSwitch');   if (thePlayer.HasTag('ACS_IsSwordWalking')){thePlayer.RemoveTag('ACS_IsSwordWalking');} if(thePlayer.IsInCombat()){if(thePlayer.GetCombatIdleStance() <= 0.f ){thePlayer.RaiseEvent('ACS_CombatTauntLeft');}else{thePlayer.RaiseEvent('ACS_CombatTauntRight');}} thePlayer.SoundEvent("gui_no_stamina");
		}
		else
		{
			if (ACS_can_perform_light_attack())
			{
				ACS_refresh_light_attack_cooldown();

				if ( !thePlayer.HasTag('acs_axii_sword_equipped') && FactsQuerySum("ACS_Azkar_Aiming") <= 0)
				{
					thePlayer.SetGuarded(false);
					thePlayer.OnGuardedReleased();
				}

				thePlayer.BreakPheromoneEffect();
																		
				if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	

				if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier( 1.25 ); }	

				RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.25   , false);

				if (Attack_Directional_Press_Check())
				{
					Attack_Process_02('geraltRandomLightFistAttackForward');
				}
				else
				{
					Attack_Process_02('geraltRandomLightFistAttack');
				}

				ACS_StaminaDrain(2);
			}
		}
	}


	public timer function RemoveACSSlowmo ( dt : float, id : int)
	{ 
		theGame.RemoveTimeScale( theGame.GetTimescaleSource(ETS_InstantKill) );
	} 

	var slow_mo_cooldown			: float;

	function ACS_SlowMoAdjustable( slowMoSpeed : float, slowMoRevert : float, optional disabled : bool )
	{
		theGame.RemoveTimeScale( theGame.GetTimescaleSource(ETS_InstantKill) );

		if (thePlayer.HasBuff(EET_Blizzard)
		|| disabled
		)
		{
			return;
		}

		if (theGame.GetEngineTimeAsSeconds() - slow_mo_cooldown > 0.125)
		{
			slow_mo_cooldown = theGame.GetEngineTimeAsSeconds();

			theGame.SetTimeScale( slowMoSpeed, theGame.GetTimescaleSource( ETS_InstantKill ), theGame.GetTimescalePriority( ETS_InstantKill ), false, true );

			RemoveTimer('RemoveACSSlowmo');

			AddTimer('RemoveACSSlowmo', slowMoRevert   , false);
		}
	}


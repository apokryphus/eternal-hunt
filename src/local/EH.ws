			break;
			
			default:
			PlayerPlayAnimation( 'man_npc_2haxe_taunt_01_lp_ACS');
			break;
		}	

		this.previous_axe_attack_alt_index_1 = axe_attack_alt_index_1;	
		
		AddTimer('ACS_Water_Aard_Release_Repeat', 0.3 , true);

		AddTimer('ACS_Water_Aard_Release_Stop', 1   , false);
	}


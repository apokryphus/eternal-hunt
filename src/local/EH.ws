	private var merchantMarkerFadeOut : float;
	default merchantMarkerFadeOut = 100;

	timer function merchantMarkerFadeOut(dt : float , id : int)
	{	
		GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Merchant_GUI_Marker", merchantMarkerFadeOut);

		if (merchantMarkerFadeOut <= 0)
		{

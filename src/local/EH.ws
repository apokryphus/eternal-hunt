	var vACS_Rage_Marker : cACS_Rage_Marker;

	var last_rage_marker_spawn_time : float;

	function SetRageProcess( flag : bool )
	{
		ACS_Rage_Process = flag;
	}

	timer function ACS_Rage_Delay(deltaTime : float , id : int)
	{
		vACS_Rage_Marker = new cACS_Rage_Marker in this;

		vACS_Rage_Marker.ACS_Rage_Marker_Engage();
	}

	timer function ACS_Rage_Remove(deltaTime : float , id : int)
	{
		Rage_Remove_Actual();
	}

	function Rage_Remove_Actual()
	{
		var npc 									: CNewNPC;
		var actors_in_rage							: array<CActor>;

		actors_in_rage.Clear();

		theGame.GetActorsByTag( 'ACS_In_Rage', actors_in_rage );	

		for( i = 0; i < actors_in_rage.Size(); i += 1 )
		{
			npc = (CNewNPC)actors_in_rage[i];

			npc.ACS_ClearAnimationSpeedMultipliers();

			npc.RemoveBuffImmunity_AllNegative('ACS_Rage');

			npc.RemoveBuffImmunity_AllCritical('ACS_Rage');

			npc.SetCanPlayHitAnim(true); 

			actors_in_rage[i].ACS_ClearAnimationSpeedMultipliers();

			actors_in_rage[i].RemoveBuffImmunity_AllNegative('ACS_Rage');

			actors_in_rage[i].RemoveBuffImmunity_AllCritical('ACS_Rage');

			actors_in_rage[i].SetCanPlayHitAnim(true); 

			actors_in_rage[i].RemoveTag('ACS_Pre_Rage');

			actors_in_rage[i].RemoveTag('ACS_In_Rage');

			if (GetAttitudeBetween( thePlayer, npc ) != AIA_Hostile)
			{
				npc.SetAttitude(GetWitcherPlayer(), AIA_Hostile);
			}
		}

		ACSGetCEntityDestroyAll('ACS_Rage_Marker_1');

		ACSGetCEntityDestroyAll('ACS_Rage_Marker_2');

		ACSGetCEntityDestroyAll('ACS_Rage_Marker_Player_1');

		SetRageProcess(false);
	}

	timer function rage_counter_reset(deltaTime : float , id : int)
	{
		rage_counter -= rage_counter;
	}

	function Rage_Counter_Manager( i : int )
	{
		rage_counter += 1;

		RemoveTimer('rage_counter_reset');

		AddTimer('rage_counter_reset', 3 , false);

		if( rage_counter == i ) 
		{
			RemoveTimer('rage_counter_reset');

			if ((theGame.GetEngineTimeAsSeconds() - last_rage_marker_spawn_time > ACS_RageMechanicCooldown())
			&& ACS_RageMechanic_Enabled())
			{
				last_rage_marker_spawn_time = theGame.GetEngineTimeAsSeconds();

				RemoveTimer('RemoveSignComboStuffRepeating');
				RemoveTimer('RemoveSignComboStuff');
				ACSGetCEntityDestroyAll('ACS_Sign_Combo_Icon');
				ACSSignComboSystemRemoveTags();

				Remove_On_Hit_Tags();

				ACSGetCEntityDestroyAll('ACS_Rage_Marker_1');

				ACSGetCEntityDestroyAll('ACS_Rage_Marker_2');

				ACSGetCEntityDestroyAll('ACS_Rage_Marker_Player_1');

				vACS_Rage_Marker = new cACS_Rage_Marker in this;

				vACS_Rage_Marker.ACS_Rage_Marker_Player_Pre_Engage();

				RemoveTimer('ACS_Rage_Delay');

				AddTimer('ACS_Rage_Delay', 1 , false);
			}

			rage_counter -= rage_counter;
		}
	}
	

	
	
	timer function ACS_Necrofiend_Tentacle_Damage_Delay(deltaTime : float , id : int)
	{
		var npc, actortarget				: CActor;
		var victims			 				: array<CActor>;
		var dmg								: W3DamageAction;
		var i								: int;
		var movementAdjustor				: CMovementAdjustor;
		var ticket 							: SMovementAdjustmentRequestTicket;
		var AnimatedComponent 				: CAnimatedComponent;
		var params 							: SCustomEffectParams;
		
		npc = (CActor)theGame.GetEntityByTag( 'ACS_Necrofiend_Tentacle_Init' );
		
		if ( npc.GetCurrentHealth() <= 0 
		|| !npc.IsAlive())
		{
			ACSGetCEntity('acs_necrofiend_tentacle_anchor').BreakAttachment(); 
			ACSGetCEntity('acs_necrofiend_tentacle_anchor').Teleport( thePlayer.GetWorldPosition() + Vector( 0, 0, -200 ) );
			ACSGetCEntity('acs_necrofiend_tentacle_anchor').DestroyAfter(0.0125);

			ACSGetCActor('ACS_Necrofiend_Tentacle_1').BreakAttachment(); 
			ACSGetCActor('ACS_Necrofiend_Tentacle_1').Teleport( thePlayer.GetWorldPosition() + Vector( 0, 0, -200 ) );
			ACSGetCActor('ACS_Necrofiend_Tentacle_1').DestroyAfter(0.0125);

			ACSGetCActor('ACS_Necrofiend_Tentacle_2').BreakAttachment(); 
			ACSGetCActor('ACS_Necrofiend_Tentacle_2').Teleport( thePlayer.GetWorldPosition() + Vector( 0, 0, -200 ) );
			ACSGetCActor('ACS_Necrofiend_Tentacle_2').DestroyAfter(0.0125);

			ACSGetCActor('ACS_Necrofiend_Tentacle_3').BreakAttachment(); 
			ACSGetCActor('ACS_Necrofiend_Tentacle_3').Teleport( thePlayer.GetWorldPosition() + Vector( 0, 0, -200 ) );
			ACSGetCActor('ACS_Necrofiend_Tentacle_3').DestroyAfter(0.0125);

			ACSGetCActor('ACS_Necrofiend_Tentacle_4').BreakAttachment(); 
			ACSGetCActor('ACS_Necrofiend_Tentacle_4').Teleport( thePlayer.GetWorldPosition() + Vector( 0, 0, -200 ) );
			ACSGetCActor('ACS_Necrofiend_Tentacle_4').DestroyAfter(0.0125);

			ACSGetCActor('ACS_Necrofiend_Tentacle_5').BreakAttachment(); 
			ACSGetCActor('ACS_Necrofiend_Tentacle_5').Teleport( thePlayer.GetWorldPosition() + Vector( 0, 0, -200 ) );
			ACSGetCActor('ACS_Necrofiend_Tentacle_5').DestroyAfter(0.0125);

			ACSGetCActor('ACS_Necrofiend_Tentacle_6').BreakAttachment(); 
			ACSGetCActor('ACS_Necrofiend_Tentacle_6').Teleport( thePlayer.GetWorldPosition() + Vector( 0, 0, -200 ) );
			ACSGetCActor('ACS_Necrofiend_Tentacle_6').DestroyAfter(0.0125);

			npc.RemoveTag('ACS_Necrofiend_Tentacle_Init');

			npc.EnableCharacterCollisions(true);

			return;
		}

		vACS_Necrofiend = new cACS_Necrofiend in this;

		vACS_Necrofiend.ACS_Necrofiend_Proj_Engage();

		//RemoveTimer('ACS_Necrofiend_Tentacle_Remove');
		//AddTimer('ACS_Necrofiend_Tentacle_Remove', 1 , false);

		victims.Clear();

		victims = npc.GetNPCsAndPlayersInCone(4, VecHeading(npc.GetHeadingVector()), 15, 20, , FLAG_OnlyAliveActors );

		if( victims.Size() > 0)
		{
			for( i = 0; i < victims.Size(); i += 1 )
			{
				actortarget = (CActor)victims[i];

				if (actortarget != npc
				&& actortarget != ACSGetCActor('ACS_Necrofiend_Tentacle_1')
				&& actortarget != ACSGetCActor('ACS_Necrofiend_Tentacle_2')
				&& actortarget != ACSGetCActor('ACS_Necrofiend_Tentacle_3')
				&& actortarget != ACSGetCActor('ACS_Necrofiend_Tentacle_4')
				&& actortarget != ACSGetCActor('ACS_Necrofiend_Tentacle_5')
				&& actortarget != ACSGetCActor('ACS_Necrofiend_Tentacle_6')
				&& actortarget != ACSGetCEntity('acs_necrofiend_tentacle_anchor')
				)
				{
					if (actortarget == GetWitcherPlayer())
					{
						if 
						(
							GetWitcherPlayer().IsInGuardedState()
							|| GetWitcherPlayer().IsGuarded()
						)
						{
							thePlayer.SetBehaviorVariable( 'parryType', RandRange(9) );
							thePlayer.RaiseForceEvent( 'PerformParry' );
						}
						else if 
						(
							GetWitcherPlayer().IsAnyQuenActive()
						)
						{
							GetWitcherPlayer().PlayEffectSingle('quen_lasting_shield_hit');
							GetWitcherPlayer().StopEffect('quen_lasting_shield_hit');
							GetWitcherPlayer().PlayEffectSingle('lasting_shield_discharge');
							GetWitcherPlayer().StopEffect('lasting_shield_discharge');
						}
						else if 
						(
							GetWitcherPlayer().IsCurrentlyDodging()
						)
						{
							GetWitcherPlayer().StopEffect('quen_lasting_shield_hit');
							GetWitcherPlayer().StopEffect('lasting_shield_discharge');
						}
						else
						{
							if(!actortarget.IsUsingHorse() 
							&& !actortarget.IsUsingVehicle() 
							)
							{
								movementAdjustor = actortarget.GetMovingAgentComponent().GetMovementAdjustor();

								ticket = movementAdjustor.GetRequest( 'ACS_Tentacle_Hit_Rotate');
								movementAdjustor.CancelByName( 'ACS_Tentacle_Hit_Rotate' );
								movementAdjustor.CancelAll();

								ticket = movementAdjustor.CreateNewRequest( 'ACS_Tentacle_Hit_Rotate' );
								movementAdjustor.AdjustmentDuration( ticket, 0.1 );
								movementAdjustor.MaxRotationAdjustmentSpeed( ticket, 50000 );

								movementAdjustor.RotateTowards( ticket, npc );
							}

							actortarget.SoundEvent("cmb_play_hit_heavy");

							if (actortarget == GetWitcherPlayer())
							{
								AnimatedComponent = (CAnimatedComponent)actortarget.GetComponentByClassName( 'CAnimatedComponent' );	

								AnimatedComponent.PlaySlotAnimationAsync ( '', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0, 0));

								GetWitcherPlayer().ACS_ClearAnimationSpeedMultipliers();	
							}

							params.effectType = EET_Knockdown;
							params.creator = npc;
							params.sourceName = "ACS_Necrofiend_Tentacle_Knockdown";
							params.duration = 1;

							actortarget.AddEffectCustom( params );	
						}
					}
				}
			}
		}

		npc.RemoveTag('ACS_Necrofiend_Tentacle_Init');

		npc.EnableCharacterCollisions(true);
	}

	timer function ACS_Necrofiend_Tentacle_Remove(deltaTime : float , id : int)
	{
		ACSGetCEntity('acs_necrofiend_tentacle_anchor').BreakAttachment(); 
		ACSGetCEntity('acs_necrofiend_tentacle_anchor').Teleport( thePlayer.GetWorldPosition() + Vector( 0, 0, -200 ) );
		ACSGetCEntity('acs_necrofiend_tentacle_anchor').DestroyAfter(0.0125);

		ACSGetCActor('ACS_Necrofiend_Tentacle_1').BreakAttachment(); 
		ACSGetCActor('ACS_Necrofiend_Tentacle_1').Teleport( thePlayer.GetWorldPosition() + Vector( 0, 0, -200 ) );
		ACSGetCActor('ACS_Necrofiend_Tentacle_1').DestroyAfter(0.0125);

		ACSGetCActor('ACS_Necrofiend_Tentacle_2').BreakAttachment(); 
		ACSGetCActor('ACS_Necrofiend_Tentacle_2').Teleport( thePlayer.GetWorldPosition() + Vector( 0, 0, -200 ) );
		ACSGetCActor('ACS_Necrofiend_Tentacle_2').DestroyAfter(0.0125);

		ACSGetCActor('ACS_Necrofiend_Tentacle_3').BreakAttachment(); 
		ACSGetCActor('ACS_Necrofiend_Tentacle_3').Teleport( thePlayer.GetWorldPosition() + Vector( 0, 0, -200 ) );
		ACSGetCActor('ACS_Necrofiend_Tentacle_3').DestroyAfter(0.0125);

		ACSGetCActor('ACS_Necrofiend_Tentacle_4').BreakAttachment(); 
		ACSGetCActor('ACS_Necrofiend_Tentacle_4').Teleport( thePlayer.GetWorldPosition() + Vector( 0, 0, -200 ) );
		ACSGetCActor('ACS_Necrofiend_Tentacle_4').DestroyAfter(0.0125);

		ACSGetCActor('ACS_Necrofiend_Tentacle_5').BreakAttachment(); 
		ACSGetCActor('ACS_Necrofiend_Tentacle_5').Teleport( thePlayer.GetWorldPosition() + Vector( 0, 0, -200 ) );
		ACSGetCActor('ACS_Necrofiend_Tentacle_5').DestroyAfter(0.0125);

		ACSGetCActor('ACS_Necrofiend_Tentacle_6').BreakAttachment(); 
		ACSGetCActor('ACS_Necrofiend_Tentacle_6').Teleport( thePlayer.GetWorldPosition() + Vector( 0, 0, -200 ) );
		ACSGetCActor('ACS_Necrofiend_Tentacle_6').DestroyAfter(0.0125);
	}

	
	

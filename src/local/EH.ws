	private var horse_walk_toggle : bool;
	
	event OnCommWalkToggle( action : SInputAction )
	{	
		var horse : CNewNPC;
		var horseWalkState : int;
		
		horse = thePlayer.GetHorseCurrentlyMounted();

		/*
		if(horse)
		{
			horseWalkState = horse.GetHorseComponent().GetHorseWalkState();

			if( IsPressed(action) )
			{
				holdTimer = theGame.GetEngineTimeAsSeconds();
			}
			else if( IsReleased(action) )
			{
				if(theGame.GetEngineTimeAsSeconds() - holdTimer > 0.2)
				{
					horse.GetHorseComponent().SetHorseWalkState(0); 
				}
				else
				{	
					if(horseWalkState == 0)
						horse.GetHorseComponent().SetHorseWalkState(1);	
					else if(horseWalkState == 1)
						horse.GetHorseComponent().SetHorseWalkState(2);	
					else 
						horse.GetHorseComponent().SetHorseWalkState(0);	
				}
			}			

			return false;
		}
		*/

		if(horse)
		{
			if( IsPressed(action) )
			{
				if (!horse_walk_toggle)
				{
					horse.GetHorseComponent().SetHorseWalkState(1);	

					horse_walk_toggle = true;
				}
				else
				{
					horse.GetHorseComponent().SetHorseWalkState(0);	

					horse_walk_toggle = false;
				}
			}		

			return false;
		}
	
		if( IsPressed(action) 
		&& !thePlayer.GetIsSprinting() 
		&& !thePlayer.modifyPlayerSpeed 
		)
		{
			switch(currspeed)
			{
				case 4:
					if (currspeed_was_walking)
					{
						currspeed_was_walking = false;
					}

					if (currspeed_was_jogging)
					{
						currspeed_was_jogging = false;
					}

					if (currspeed_was_slowjogging)
					{
						currspeed_was_slowjogging = false;
					}

					if (currspeed_was_slowwalking)
					{
						currspeed_was_slowwalking = false;
					}

					currspeed = 0;
				break;

				case 3:
					if (currspeed_was_walking)
					{
						currspeed_was_walking = false;
					}

					if (currspeed_was_jogging)
					{
						currspeed_was_jogging = true;
					}

					if (currspeed_was_slowjogging)
					{
						currspeed_was_slowjogging = false;
					}

					if (currspeed_was_slowwalking)
					{
						currspeed_was_slowwalking = false;
					}

					currspeed = 0;
				break;

				case 2:
					if (currspeed_was_walking)
					{
						currspeed_was_walking = false;
					}

					if (currspeed_was_jogging)
					{
						currspeed_was_jogging = false;
					}

					if (currspeed_was_slowjogging)
					{
						currspeed_was_slowjogging = true;
					}

					if (currspeed_was_slowwalking)
					{
						currspeed_was_slowwalking = false;
					}

					currspeed = 0;
				break;

				case 1:
					if (currspeed_was_walking)
					{
						currspeed_was_walking = true;
					}

					if (currspeed_was_jogging)
					{
						currspeed_was_jogging = false;
					}

					if (currspeed_was_slowjogging)
					{
						currspeed_was_slowjogging = false;
					}

					if (currspeed_was_slowwalking)
					{
						currspeed_was_slowwalking = false;
					}

					currspeed = 2;
				break;

				case 0:
					if (currspeed_was_walking)
					{
						currspeed_was_walking = false;
					}

					if (currspeed_was_jogging)
					{
						currspeed_was_jogging = false;
					}

					if (currspeed_was_slowjogging)
					{
						currspeed_was_slowjogging = false;
					}

					if (!currspeed_was_slowwalking)
					{
						currspeed_was_slowwalking = true;
					}

					currspeed = 1;
				break;

				default:
					if (currspeed_was_walking)
					{
						currspeed_was_walking = false;
					}

					if (currspeed_was_jogging)
					{
						currspeed_was_jogging = false;
					}

					if (currspeed_was_slowjogging)
					{
						currspeed_was_slowjogging = false;
					}

					if (!currspeed_was_slowwalking)
					{
						currspeed_was_slowwalking = true;
					}

					currspeed = 1;
				break;
			}

			if ( thePlayer.GetIsWalkToggled() )
				thePlayer.SetWalkToggle( false );
			else
				thePlayer.SetWalkToggle( true );
		}
	}	

	function PreventSneaking() : bool
	{
		var actor							: CActor; 
		var actors		    				: array<CActor>;
		var i								: int;
		var npc								: CNewNPC;

		if (FactsQuerySum("ACS_Bloodsmoke_Active") > 0)
		{
			return false;
		}

		if (ACS_Rage_Process
		|| ACSGetCEntity('ACS_Counter_Wound')
		)
		{
			return true;
		}

		actors.Clear();

		actors = thePlayer.GetNPCsAndPlayersInRange( 20, 50, , FLAG_OnlyAliveActors + FLAG_Attitude_Hostile + FLAG_ExcludePlayer);

		if( actors.Size() > 0 )
		{
			for( i = 0; i < actors.Size(); i += 1 )
			{
				if (actors[i].HasTag( 'ACS_In_Rage' )
				|| actors[i].HasTag( 'ACS_Pre_Rage' )
				|| actors[i].HasTag( 'ACS_Final_Fear_Stack' )
				)
				{
					return true;
				}

				if (actors[i].HasBuff( EET_Hypnotized )
				|| actors[i].HasBuff( EET_WitchHypnotized )
				|| actors[i].HasBuff( EET_Blindness )
				|| actors[i].HasBuff( EET_WraithBlindness )
				|| actors[i].HasBuff( EET_Paralyzed )
				|| actors[i].HasBuff( EET_Confusion )
				|| actors[i].HasBuff( EET_Choking )
				|| actors[i].HasBuff( EET_Immobilized )
				|| actors[i].HasBuff( EET_AxiiGuardMe )
				|| actors[i].HasBuff( EET_Weaken )
				)
				{
					return false;
				}
			}
		}

		return true;
	}

	var sneaking_initiated_in_combat : bool;

	default sneaking_initiated_in_combat = false;

	function DodgeSneaking()
	{
		if (!thePlayer.IsInCombat()
		)
		{
			if (ACS_HoldToRoll_Enabled())
			{
				RemoveTimer('RollDelay');
				AddTimer('RollDelay', 0.75f , false);
			}
			else
			{
				if ((thePlayer.HasTag('ACS_Is_Sneaking')
				&& ACS_IS_SNEAKING)
				|| PreventSneaking()
				)
				{
					
				}
				else
				{
					

					RemoveTimer('SneakingInitiate');RemoveTimer('SneakingCombatInitiate');
					AddTimer('SneakingCombatInitiate', 0.25f , false);
				}
				
			}
		}
		else
		{
			if (ACS_HoldToRoll_Enabled())
			{
				RemoveTimer('RollDelay');
				AddTimer('RollDelay', 0.75f , false);
			}
			
			if ((thePlayer.HasTag('ACS_Is_Sneaking')
			&& ACS_IS_SNEAKING)
			|| PreventSneaking()
			)
			{

			}
			else
			{
				

				RemoveTimer('SneakingInitiate');RemoveTimer('SneakingCombatInitiate');
				AddTimer('SneakingCombatInitiate', 0.25f , false);
			}
		}
	}

	event OnShowDeveloperMode( action : SInputAction )
	{
		var targetDistance : float;

		if (!ACS_Settings_Main_Bool('acs_dodge_settings','acs_exploration_dodge_enabled', true))
		{
			return false;
		}

		if (FactsQuerySum("acs_transformation_activated") > 0)
		{
			ACS_ExplorationDelayHack(false, 3);

			if( thePlayer.IsActionAllowed(EIAB_Dodge)  )
			{
				if (thePlayer.GetBIsInputAllowed())
				{
					if (FactsQuerySum("acs_wolven_curse_activated") > 0)
					{
						if ( IsPressed(action) )
						{
							ACS_Transformation_Werewolf_Dodge();
						}
					}

					if (FactsQuerySum("acs_vampireess_transformation_activated") > 0)
					{
						if ( IsPressed(action) )
						{
							if (!ACSGetCActor('ACS_Transformation_Vampiress').HasTag('ACS_Vampiress_Sorceress_Mode'))
							{
								ACS_Transformation_Vampiress_Dodge_Melee();
							}
							else
							{
								ACS_Transformation_Vampiress_Dodge_Ranged();
							}
						}
					}

					if (FactsQuerySum("acs_vampire_monster_transformation_activated") > 0)
					{
						if ( IsPressed(action) )
						{
							if (ACSGetCActor('ACS_Transformation_Vampire_Monster').HasTag('ACS_Vampire_Monster_Ground_Mode'))
							{
								ACS_Transformation_Vampire_Monster_Teleport_Dodge();
							}
						}
					}

					if (FactsQuerySum("acs_red_miasmal_curse_activated") > 0)
					{
						if ( IsPressed(action) )
						{
							if (!thePlayer.IsInInterior())
							{
								ACS_Transformation_Red_Miasmal_Dodge();
							}
						}
					}

					if (FactsQuerySum("acs_sharley_curse_activated") > 0)
					{
						if ( IsPressed(action) )
						{
							ACS_Transformation_Sharley_Dodge();
						}
					}

					if (FactsQuerySum("acs_black_wolf_curse_activated") > 0)
					{
						if ( IsPressed(action) )
						{
							ACS_Transformation_Black_Wolf_Dodge();
						}
					}

					if (FactsQuerySum("acs_giant_curse_activated") > 0&& !ACSGetCActor('ACS_Transformation_Giant').HasTag('ACS_Transformation_Giant_Block_All_Actions'))
					{
						if ( IsPressed(action) )
						{
							ACS_Transformation_Giant_Dodge();
						}
					}
				}
			}

			return false;
		}

		if(theGame.GetInGameConfigWrapper().GetVarValue('Gameplay', 'EnableAlternateSignCasting') == "1")
		{
			altSignCasting = true;
		}	
		else
		{
			altSignCasting = false;
		}

		if(altSignCasting
		&& !theInput.LastUsedPCInput() && !thePlayer.IsCastingSign() && theInput.GetActionValue('CastSign') > 0.1f && !GetWitcherPlayer().IsCurrentSignChanneled())
		{
			return false;
		}

		if( !thePlayer.IsActionAllowed(EIAB_Dodge)) 
		{
			return false;
		}

		if(thePlayer.HasTag('ACS_Manual_Combat_Control')){thePlayer.RemoveTag('ACS_Manual_Combat_Control');} RemoveTimer('Manual_Combat_Control_Remove');

		if (thePlayer.HasTag('ACS_IsSwordWalking'))
		{
			thePlayer.RemoveTag('ACS_IsSwordWalking');
		}

		SwordWalkAdditiveEnd(action);
		
		if ( theInput.LastUsedPCInput() )
		{		
			if ( IsPressed(action) )
			{
				Rage_Counter_Manager(3);

				ACSGetCEntity('ACS_Quen_Bubble').Destroy();
		
				ACSGetCEntity('ACS_Quen_Fx').Destroy();

				ACSGetCEntity('ACS_Sign_Icon').Destroy();

				ACSGetCEntity('ACS_Sign_Icon_Anchor').Destroy();

				if ( ACS_Settings_Main_Bool('acs_main_settings','acs_mod_enabled', true) ) 
				{
					if( BruxaDashCallTime + DOUBLE_TAP_WINDOW_DODGE >= theGame.GetEngineTimeAsSeconds() )
					{
						BruxaDashDoubleTap = true;
					}
					else
					{
						BruxaDashDoubleTap = false;	
					}

					if
					(theInput.IsActionPressed('Sprint') )
					{
						if( Flying_Target_Check()
						&& !thePlayer.HasTag('ACS_Air_Time')
						&& ACS_Settings_Main_Bool('acs_combat_main_settings','acs_air_time', true)
						&& !getIsInCombatSlide
						)
						{
							RemoveTimer('Air_Time_Trigger_Delay');
							AddTimer('Air_Time_Trigger_Delay', 0.5 , false);
						}
						else
						{
							RemoveTimer('Air_Time_Trigger_Delay');

							if (thePlayer.HasTag('ACS_Air_Time'))
							{
								RemoveTimer('Air_Time_Movement_Adjust_Delay');

								thePlayer.BlockAllActions( 'ACS_Air_Time_Init', false );

								thePlayer.EnableCollisions(true);

								thePlayer.RaiseEvent('ACS_FeetAdditiveEnd');

								thePlayer.UnblockAction( EIAB_CallHorse,			'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_DrawWeapon, 		'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_FastTravel, 		'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_InteractionAction, 	'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_UsableItem,			'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_MeditationWaiting,	'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_OpenMeditation,		'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_RadialMenu,			'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_Movement,			'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_QuickSlots, 		'ACS_Air_Time');

								thePlayer.RemoveTag('ACS_Air_Time');
							}
						}
					}

					if (BruxaDashDoubleTap)
					{
						if (Attack_Directional_Press_Check())
						{
							if (ACS_Settings_Main_Bool('acs_dodge_settings','acs_bruxa_leap_attack', false) && thePlayer.IsInCombat())
							{
								JumpAttackCombat();
							}
							else if ( ACS_Settings_Main_Bool('acs_bruxa_dash_settings','acs_bruxa_dash', false) )
							{
								BruxaDash_Combat();
							}
							else
							{
								if (thePlayer.HasTag('ACS_Bruxa_Bite_Process'))
								{
									bruxa_blood_suck_end_actual();
								}

								ACS_BruxaDodgeSlideBackInit();

								DodgeSneaking();
							}
						}
						else
						{
							if ( ACS_Settings_Main_Bool('acs_bruxa_dash_settings','acs_bruxa_dash', false) )
							{
								BruxaDash_Combat();
							}
							else
							{
								if (thePlayer.HasTag('ACS_Bruxa_Bite_Process'))
								{
									bruxa_blood_suck_end_actual();
								}
								
								ACS_BruxaDodgeSlideBackInit();

								DodgeSneaking();
							}
						}
					}
					else
					{
						if (thePlayer.HasTag('ACS_Bruxa_Bite_Process'))
						{
							bruxa_blood_suck_end_actual();
						}

						if (ACS_CombatSlide_Enabled()
						&& !getIsInCombatSlide
						)
						{
							if (thePlayer.GetIsSprinting()
							&& (thePlayer.IsActionAllowed( EIAB_RunAndSprint ) || thePlayer.IsActionAllowed( EIAB_Sprint ))
							&& thePlayer.GetSprintingTime() > 0.25
							&& thePlayer.substateManager.GetStateTimeF() > 0.25
							&& thePlayer.GetMovingAgentComponent().GetSpeed() >= 3 
							&& !thePlayer.IsCurrentlyDodging()
							&& !thePlayer.HasTag('ACS_Is_Currently_Dodging')
							&& !thePlayer.HasTag('ACS_Player_Is_Attacking')
							&& !thePlayer.IsInHitAnim()
							&& !thePlayer.HasTag('ACS_IsPerformingFinisher')
							&& !thePlayer.HasTag('ACS_IsPerformingCombatDismember')
							&& !thePlayer.IsCrossbowHeld()
							&& ACS_BuffCheck()
							&& thePlayer.IsActionAllowed(EIAB_Movement)
							&& thePlayer.GetStat( BCS_Stamina ) > 0
							&& !thePlayer.IsSwimming()
							&& !thePlayer.IsDiving()
							)
							{
								vACS_CombatSlide = new cACS_CombatSlide in this;

								vACS_CombatSlide.Combat_Slide_Engage();
							}
							else
							{
								ACS_BruxaDodgeSlideBackInit();

								DodgeSneaking();
							}
						}
						else
						{
							ACS_BruxaDodgeSlideBackInit();

							DodgeSneaking();
						}
					}
				
					BruxaDashCallTime = theGame.GetEngineTimeAsSeconds();

					return true;
				}
				else
				{
					thePlayer.EvadePressed(EBAT_Dodge);
				}
			}

			if (IsReleased( action ))
			{
				RemoveTimer('Air_Time_Trigger_Delay');

				RemoveTimer('RollDelay');
			}
		}
		else if ( !theInput.LastUsedPCInput() )
		{
			if(altSignCasting && (thePlayer.IsCastingSign() || theInput.GetActionValue('CastSign') > 0.1f))
			{
				return false;
			}

			if (ACS_Cast_Sign_Process)
			{
				return false;
			}

			if ( IsPressed(action) )
			{
				if(altSignCasting && !theInput.LastUsedPCInput() && theInput.GetActionValue('CastSign') > 0.1f)
				{
					
					
				}			
				else
				{
					Rage_Counter_Manager(3);

					ACSGetCEntity('ACS_Quen_Bubble').Destroy();
		
					ACSGetCEntity('ACS_Quen_Fx').Destroy();

					ACSGetCEntity('ACS_Sign_Icon').Destroy();

					ACSGetCEntity('ACS_Sign_Icon_Anchor').Destroy();

					if
					(theInput.IsActionPressed('Sprint') )
					{
						if( Flying_Target_Check()
						&& !thePlayer.HasTag('ACS_Air_Time')
						&& ACS_Settings_Main_Bool('acs_combat_main_settings','acs_air_time', true)
						&& !getIsInCombatSlide
						)
						{

							RemoveTimer('Air_Time_Trigger_Delay');
							AddTimer('Air_Time_Trigger_Delay', 0.5 , false);
						}
						else
						{
							RemoveTimer('Air_Time_Trigger_Delay');

							if (thePlayer.HasTag('ACS_Air_Time'))
							{
								RemoveTimer('Air_Time_Movement_Adjust_Delay');

								thePlayer.BlockAllActions( 'ACS_Air_Time_Init', false );

								thePlayer.EnableCollisions(true);

								thePlayer.RaiseEvent('ACS_FeetAdditiveEnd');

								thePlayer.UnblockAction( EIAB_CallHorse,			'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_DrawWeapon, 		'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_FastTravel, 		'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_InteractionAction, 	'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_UsableItem,			'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_MeditationWaiting,	'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_OpenMeditation,		'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_RadialMenu,			'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_Movement,			'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_QuickSlots, 		'ACS_Air_Time');

								thePlayer.RemoveTag('ACS_Air_Time');
							}
						}
					}

					if ( ACS_Settings_Main_Bool('acs_main_settings','acs_mod_enabled', true) ) 
					{
						if (thePlayer.HasTag('ACS_Bruxa_Bite_Process'))
						{
							bruxa_blood_suck_end_actual();
						}

						if( BruxaDashCallTime + DOUBLE_TAP_WINDOW_DODGE >= theGame.GetEngineTimeAsSeconds() )
						{
							BruxaDashDoubleTap = true;
						}
						else
						{
							BruxaDashDoubleTap = false;	
						}

						if (BruxaDashDoubleTap)
						{
							if (Attack_Directional_Press_Check())
							{
								if (ACS_Settings_Main_Bool('acs_dodge_settings','acs_bruxa_leap_attack', false) && thePlayer.IsInCombat())
								{
									JumpAttackCombat();
								}
								else if ( ACS_Settings_Main_Bool('acs_bruxa_dash_settings','acs_bruxa_dash', false) )
								{
									BruxaDash_Combat();
								}
								else
								{
									ACS_BruxaDodgeSlideBackInit();
								}
							}
							else
							{
								if ( ACS_Settings_Main_Bool('acs_bruxa_dash_settings','acs_bruxa_dash', false) )
								{
									BruxaDash_Combat();
								}
								else
								{
									ACS_BruxaDodgeSlideBackInit();
								}
							}
						}
						else
						{
							ACS_BruxaDodgeSlideBackInit();
						}
						
						BruxaDashCallTime = theGame.GetEngineTimeAsSeconds();

						return true;
					}
					else
					{
						thePlayer.EvadePressed(EBAT_Dodge);
					}
				}
			}

			
			if (IsReleased( action ))
			{
				RemoveTimer('Air_Time_Trigger_Delay');
			}
		}
	}


	function Attack_Setup_08( attack_name : name )
	{	
		ACS_ExplorationDelayHack(false, 3);

		finisherActorTarget = (CActor)( thePlayer.GetTarget() );	
		ccomp = finisherActorTarget.GetComponent("Finish");
		ccompEnabled = ccomp.IsEnabled();

		if (
		ccompEnabled
		&& ACS_AttitudeCheck (finisherActorTarget)
		&& VecDistanceSquared2D( thePlayer.GetWorldPosition(), finisherActorTarget.GetNearestPointInBothPersonalSpaces( thePlayer.GetWorldPosition() ) ) < 2.75f * 2.75f
		)
		{
			PrimarySecondaryWeaponSwitch ( attack_name );

			ACS_Setup_Light_Attack_Internal();
		}
		else
		{
			if ( ACS_Settings_Main_Bool('acs_stamina_settings','acs_stamina_block_action', false) 
			&& StaminaCheck('default')
			)
			{
				RemoveTimer('SwordTauntSwitch'); RemoveTimer('SwordTauntRunningSwitch');   if (thePlayer.HasTag('ACS_IsSwordWalking')){thePlayer.RemoveTag('ACS_IsSwordWalking');} if(thePlayer.IsInCombat()){if(thePlayer.GetCombatIdleStance() <= 0.f ){thePlayer.RaiseEvent('ACS_CombatTauntLeft');}else{thePlayer.RaiseEvent('ACS_CombatTauntRight');}} thePlayer.SoundEvent("gui_no_stamina");
			}
			else
			{
				switch ( attack_name )
				{
					case 'GeraltCiriLightAttack':
					if (ACS_can_perform_light_attack())
					{
						
							ACS_refresh_light_attack_cooldown();

							if (!thePlayer.IsEffectActive('fury_403_ciri', false))
							{
								thePlayer.PlayEffectSingle( 'fury_403_ciri' );
							}

							if (!thePlayer.IsEffectActive('fury_ciri', false))
							{
								thePlayer.PlayEffectSingle( 'fury_ciri' );
							}

							if (!thePlayer.IsEffectActive('acs_fury_effect', false))
							{
								thePlayer.PlayEffectSingle( 'acs_fury_effect' );
							}
																
							thePlayer.BreakPheromoneEffect();
																			
							PrimaryWeaponSwitch();

							if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	

							if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier( 1.5 ); }	

							RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5   , false);

							if (Attack_Directional_Press_Check())
							{
								Attack_Process_14('geraltRandomGeraltLightAttackForward_Ciri');
							}
							else
							{
								Attack_Process_14('geraltRandomGeraltLightAttack_Ciri');
							}

							ACS_StaminaDrain(1);
						
					}
					break;

					case 'GeraltCiriHeavyAttack':
					if (ACS_can_perform_heavy_attack())
					{
						
							ACS_refresh_heavy_attack_cooldown();
																
							thePlayer.BreakPheromoneEffect();

							if (!thePlayer.IsEffectActive('fury_403_ciri', false))
							{
								thePlayer.PlayEffectSingle( 'fury_403_ciri' );
							}

							if (!thePlayer.IsEffectActive('fury_ciri', false))
							{
								thePlayer.PlayEffectSingle( 'fury_ciri' );
							}

							if (!thePlayer.IsEffectActive('acs_fury_effect', false))
							{
								thePlayer.PlayEffectSingle( 'acs_fury_effect' );
							}
																			
							PrimaryWeaponSwitch();

							if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	

							if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier( 1.5 ); }	

							RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5   , false);

							if (Attack_Directional_Press_Check())
							{
								Attack_Process_14('geraltRandomGeraltHeavyAttackForward_Ciri');
							}
							else
							{
								Attack_Process_11('geraltRandomGeraltHeavyAttack_Wolf');
							}

							ACS_StaminaDrain(2);
						
					}
					break;

					case 'GeraltCiriSpecialLightAttack':
					if ( ACS_can_perform_special_attack() )
					{
						
							ACS_refresh_special_attack_cooldown();
								
							thePlayer.BreakPheromoneEffect();	


				&& RandF() < 0.75
				)
				{
					Player_Blood_Covered_Effect(actortarget);
				}
			}
		}

		if (ACSGetCActor('ACS_Transformation_Vampire_Monster').HasTag('ACS_Vampire_Monster_Flight_Mode'))
		{
			ACSGetCActor('ACS_Transformation_Vampire_Monster').DestroyEffect('lightning');
			ACSGetCActor('ACS_Transformation_Vampire_Monster').PlayEffectSingle('lightning');

			ACSGetCActor('ACS_Transformation_Vampire_Monster').DestroyEffect('start_effect');
			ACSGetCActor('ACS_Transformation_Vampire_Monster').PlayEffectSingle('start_effect');

			ACSGetCActor('ACS_Transformation_Vampire_Monster').DestroyEffect('wing_trail');
			ACSGetCActor('ACS_Transformation_Vampire_Monster').PlayEffectSingle('wing_trail');
			ACSGetCActor('ACS_Transformation_Vampire_Monster').StopEffect('wing_trail');
		}
	}


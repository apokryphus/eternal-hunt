							&& thePlayer.GetStat( BCS_Stamina ) > thePlayer.GetStatMax( BCS_Stamina ) * 0)
							{
								if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	

								RemoveTimer('ACS_ResetAnimation');

								Attack_Process_24('geraltMageSpecialAttack');
							}
							else
							{
										
								if (Attack_Directional_Press_Check())
								{
									Attack_Process_22('geraltRandomSpearSpecialAttackAlt');

									if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	
											
									if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier(1.75  ); }	
										
									RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5   , false);
								}
								else
								{
									Attack_Process_22('geraltRandomSpearSpecialAttack');

									if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	
									
									if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier(1.75  ); }	
										
									RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5   , false);
								}
							}

							ACS_StaminaDrain(3);
						
					}
					break;

					case 'FocusModeGregSpecialAttack':
					if ( ACS_can_perform_special_attack() )
					{
						
							ACS_refresh_special_attack_cooldown();
									
							thePlayer.BreakPheromoneEffect();	

							SecondaryWeaponSwitch(); 	
									
							if (Attack_Directional_Press_Check())
							{
								Attack_Process_28('geraltRandomGregSpecialAttackAlt');
							}
							else
							{
								Attack_Process_28('geraltRandomGregSpecialAttack');
							}

							ACS_StaminaDrain(3);
						
					}
					break;

					case 'HybridModeGregSpecialAttack':
					if ( ACS_can_perform_special_attack() )
					{
						
							ACS_refresh_special_attack_cooldown();
									
							thePlayer.BreakPheromoneEffect();	
									
							SecondaryWeaponSwitch();		

							Attack_Process_28('geraltRandomGregSpecialAttack');
						
							ACS_StaminaDrain(3);
					}
					break;

					case 'HybridModeGregForwardSpecialAttack':
					if ( ACS_can_perform_special_attack() )
					{
						
							ACS_refresh_special_attack_cooldown();
									
							thePlayer.BreakPheromoneEffect();	
									
							SecondaryWeaponSwitch();
									
							Attack_Process_28('geraltRandomGregSpecialAttackAlt');	

							ACS_StaminaDrain(3);	
						
					}
					break;


					
					default:
					break;
				}
				
			}
		}
	}

	function Attack_Setup_24( attack_name : name )
	{	
		ACS_ExplorationDelayHack(false, 3);

		finisherActorTarget = (CActor)( thePlayer.GetTarget() );	
		ccomp = finisherActorTarget.GetComponent("Finish");
		ccompEnabled = ccomp.IsEnabled();

		if (
		ccompEnabled
		&& ACS_AttitudeCheck (finisherActorTarget)
		&& VecDistanceSquared2D( thePlayer.GetWorldPosition(), finisherActorTarget.GetNearestPointInBothPersonalSpaces( thePlayer.GetWorldPosition() ) ) < 2.75f * 2.75f
		)
		{
			PrimarySecondaryWeaponSwitch ( attack_name );

			ACS_Setup_Light_Attack_Internal();
		}
		else
		{
			if ( ACS_Settings_Main_Bool('acs_stamina_settings','acs_stamina_block_action', false) 
			&& StaminaCheck('default')
			)
			{
				RemoveTimer('SwordTauntSwitch'); RemoveTimer('SwordTauntRunningSwitch');   if (thePlayer.HasTag('ACS_IsSwordWalking')){thePlayer.RemoveTag('ACS_IsSwordWalking');} if(thePlayer.IsInCombat()){if(thePlayer.GetCombatIdleStance() <= 0.f ){thePlayer.RaiseEvent('ACS_CombatTauntLeft');}else{thePlayer.RaiseEvent('ACS_CombatTauntRight');}} thePlayer.SoundEvent("gui_no_stamina");
			}
			else
			{
				switch ( attack_name )
				{
					case 'FocusModeGiantSpecialAttack':
					if ( ACS_can_perform_special_attack() )
					{
						
							ACS_refresh_special_attack_cooldown();
									
							thePlayer.BreakPheromoneEffect();	
									
							SecondaryWeaponSwitch(); 	
									
							if (Attack_Directional_Press_Check())
							{
								Attack_Process_25('geraltRandomGiantSpecialAttackAlt');
							}
							else
							{
								Attack_Process_25('geraltRandomGiantSpecialAttack');
							}

							ACS_StaminaDrain(3);
						
					}
					break;

					case 'HybridModeGiantSpecialAttack':
					if ( ACS_can_perform_special_attack() )
					{
						
							ACS_refresh_special_attack_cooldown();
									
							thePlayer.BreakPheromoneEffect();		

							SecondaryWeaponSwitch();		

							Attack_Process_25('geraltRandomGiantSpecialAttack');

							ACS_StaminaDrain(3);
						
					}
					break;

					case 'HybridModeGiantForwardSpecialAttack':
					if ( ACS_can_perform_special_attack() )
					{
						
							ACS_refresh_special_attack_cooldown();
									
							thePlayer.BreakPheromoneEffect();	

							SecondaryWeaponSwitch();
									
							Attack_Process_25('geraltRandomGiantSpecialAttackAlt');

							ACS_StaminaDrain(3);
						
					}
					break;
					
					case 'FocusModeAxeSpecialAttack':
					if ( ACS_can_perform_special_attack() )
					{
						
							ACS_refresh_special_attack_cooldown();
									
							thePlayer.BreakPheromoneEffect();	
									
							SecondaryWeaponSwitch(); 	
									
							if (Attack_Directional_Press_Check())
							{
								Attack_Process_27('geraltRandomAxeSpecialAttackAlt');
							}
							else
							{
								Attack_Process_27('geraltRandomAxeSpecialAttack');
							}

							ACS_StaminaDrain(3);
						
					}
					break;

					case 'HybridModeAxeSpecialAttack':
					if ( ACS_can_perform_special_attack() )
					{
						
							ACS_refresh_special_attack_cooldown();
									
							thePlayer.BreakPheromoneEffect();		

							SecondaryWeaponSwitch();
									
							Attack_Process_27('geraltRandomAxeSpecialAttack');

							ACS_StaminaDrain(3);
						
					}
					break;

					case 'HybridModeAxeForwardSpecialAttack':
					if ( ACS_can_perform_special_attack() )
					{
						
							ACS_refresh_special_attack_cooldown();
									
							thePlayer.BreakPheromoneEffect();	
									
							SecondaryWeaponSwitch();
									
							Attack_Process_27('geraltRandomAxeSpecialAttackAlt');

							ACS_StaminaDrain(3);
						
					}
					break;

					default:
					break;
				}
				
			}
		}
	}

	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	function Attack_Directional_Press_Check() : bool
	{
		if (theInput.GetActionValue('GI_AxisLeftY') < -0.1 && theInput.GetActionValue('GI_AxisLeftX') == 0  )
		{
			return true;
		}

		if (theInput.GetActionValue('GI_AxisLeftY') > 0.1 && theInput.GetActionValue('GI_AxisLeftX') == 0)
		{
			return true;
		}

		if (theInput.GetActionValue('GI_AxisLeftX') > 0.1 && theInput.GetActionValue('GI_AxisLeftY') == 0 )
		{
			return true;
		}

		if (theInput.GetActionValue('GI_AxisLeftX') < -0.1 && theInput.GetActionValue('GI_AxisLeftY') == 0) 
		{
			return true;
		}

		if (theInput.GetActionValue('GI_AxisLeftY') > 0.1 && theInput.GetActionValue('GI_AxisLeftX') > 0.1 )
		{
			return true;
		}

		if (theInput.GetActionValue('GI_AxisLeftY') > 0.1 && theInput.GetActionValue('GI_AxisLeftX') < -0.1 )
		{
			return true;
		}

		if (theInput.GetActionValue('GI_AxisLeftY') < -0.1 && theInput.GetActionValue('GI_AxisLeftX') > 0.1 )
		{
			return true;
		}

		if (theInput.GetActionValue('GI_AxisLeftX') < -0.1 && theInput.GetActionValue('GI_AxisLeftY') < -0.1 )
		{
			return true;
		}

		return false;
	}

	function Attack_Process_Direction()
	{
		if (theInput.GetActionValue('GI_AxisLeftY') < -0.1 && theInput.GetActionValue('GI_AxisLeftX') == 0  )
		{
			if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTo( ticket, VecHeading( theCamera.GetCameraDirection() ) - 180 );}
		}
		else if (theInput.GetActionValue('GI_AxisLeftY') > 0.1 && theInput.GetActionValue('GI_AxisLeftX') == 0)
		{
			if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTo( ticket, VecHeading( theCamera.GetCameraDirection() ) );}
		}
		else if (theInput.GetActionValue('GI_AxisLeftX') > 0.1 && theInput.GetActionValue('GI_AxisLeftY') == 0 )
		{
			if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTo( ticket, VecHeading( theCamera.GetCameraDirection() ) - 90 );}
		}
		else if (theInput.GetActionValue('GI_AxisLeftX') < -0.1 && theInput.GetActionValue('GI_AxisLeftY') == 0) 
		{
			if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTo( ticket, VecHeading( theCamera.GetCameraDirection() ) + 90 );}
		}
		else if (theInput.GetActionValue('GI_AxisLeftY') > 0.1 && theInput.GetActionValue('GI_AxisLeftX') > 0.1 )
		{
			if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTo( ticket, VecHeading( theCamera.GetCameraDirection() ) - 45 );}
		}
		else if (theInput.GetActionValue('GI_AxisLeftY') > 0.1 && theInput.GetActionValue('GI_AxisLeftX') < -0.1 )
		{
			if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTo( ticket, VecHeading( theCamera.GetCameraDirection() ) + 45 );}
		}
		else if (theInput.GetActionValue('GI_AxisLeftY') < -0.1 && theInput.GetActionValue('GI_AxisLeftX') > 0.1 )
		{
			if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTo( ticket, VecHeading( theCamera.GetCameraDirection() ) - 135 );}
		}
		else if (theInput.GetActionValue('GI_AxisLeftX') < -0.1 && theInput.GetActionValue('GI_AxisLeftY') < -0.1 )
		{
			if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTo( ticket, VecHeading( theCamera.GetCameraDirection() ) + 135 );}
		}
		else
		{
			if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTo( ticket, VecHeading( thePlayer.GetHeadingVector()) );}
		}
	}

	function Attack_Process_01( attack_name : name ) 
	{
		MovementAdjust('default');
		
		if( actor && ACS_AttitudeCheck ( actor ) && thePlayer.IsInCombat() )
		{	
			if ( ACS_Settings_Main_Int('acs_target_settings','acs_target_mode', 0) == 0 || ACS_Settings_Main_Int('acs_target_settings','acs_target_mode', 0) == 1 )
			{
				if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTowards( ticket, actor );}  
			}
			else if ( ACS_Settings_Main_Int('acs_target_settings','acs_target_mode', 0) == 2 )
			{
				if (thePlayer.IsHardLockEnabled())
				{
					if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTowards( ticket, actor );}  
				}
				else
				{
					if(!thePlayer.HasTag('ACS_Manual_Combat_Control')){thePlayer.AddTag('ACS_Manual_Combat_Control');} RemoveTimer('Manual_Combat_Control_Remove'); AddTimer('Manual_Combat_Control_Remove', 2   , false);//if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTo( ticket, VecHeading( theCamera.GetCameraDirection() ) );}
				}	
			}

			Attack_Process_01_Primary( attack_name );

			return;
		}

		Attack_Process_Direction();

		Attack_Process_01_Secondary( attack_name );
	}

	function Attack_Process_01_Primary( attack_name : name ) 
	{
		switch ( attack_name )
		{
			case 'geraltRandomGeraltDualWieldLightAttack':
			
				RemoveTimer('ACS_Combo_Counter_Reset_Timer'); AddTimer('ACS_Combo_Counter_Reset_Timer', 4   , false);;

				thePlayer.RaiseEvent('ACS_DualWieldSword_ShortAttack');

				thePlayer.RaiseEvent('ACS_TW1AnimsReset');

				switch ( combo_counter_geralt_dual_wield_light_attack )
				{
					default:
					if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	

					if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1.5  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier( 1.75 ); }		

					RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5  , false);	
					PlayerPlayAnimation( 'man_npc_sword_2hand_attack_l_left_1_dw_ACS');	


		Lightning_Strike_No_Condition_Mult();
				
		vACS_MelusineSpawner.ACS_MelusineSpawner_Engage();
	}

	public timer function RemoveFlammableOilTag( time : float , id : int )
	{
		ACSGetCEntity('acs_sword_trail_1').StopEffect('sword_axii_trail');
		ACSGetCEntity('acs_sword_trail_1').StopEffect('sword_igni_trail');

		ACSGetCEntity('acs_sword_trail_2').StopEffect('sword_axii_trail');
		ACSGetCEntity('acs_sword_trail_2').StopEffect('sword_igni_trail');

		ACSGetCEntity('acs_sword_trail_3').StopEffect('sword_axii_trail');
		ACSGetCEntity('acs_sword_trail_3').StopEffect('sword_igni_trail');

		ACSGetCEntity('acs_sword_trail_1').StopEffect('frost_sword_trail');
		ACSGetCEntity('acs_sword_trail_1').StopEffect('fire_sword_trail');

		ACSGetCEntity('acs_sword_trail_2').StopEffect('frost_sword_trail');
		ACSGetCEntity('acs_sword_trail_2').StopEffect('fire_sword_trail');

		ACSGetCEntity('acs_sword_trail_3').StopEffect('frost_sword_trail');
		ACSGetCEntity('acs_sword_trail_3').StopEffect('fire_sword_trail');



		ACSGetCEntity('acs_sword_trail_1_dual_wield').StopEffect('sword_axii_trail');
		ACSGetCEntity('acs_sword_trail_1_dual_wield').StopEffect('sword_igni_trail');

		ACSGetCEntity('acs_sword_trail_2_dual_wield').StopEffect('sword_axii_trail');
		ACSGetCEntity('acs_sword_trail_2_dual_wield').StopEffect('sword_igni_trail');

		ACSGetCEntity('acs_sword_trail_3_dual_wield').StopEffect('sword_axii_trail');
		ACSGetCEntity('acs_sword_trail_3_dual_wield').StopEffect('sword_igni_trail');

		ACSGetCEntity('acs_sword_trail_1_dual_wield').StopEffect('frost_sword_trail');
		ACSGetCEntity('acs_sword_trail_1_dual_wield').StopEffect('fire_sword_trail');

		ACSGetCEntity('acs_sword_trail_2_dual_wield').StopEffect('frost_sword_trail');
		ACSGetCEntity('acs_sword_trail_2_dual_wield').StopEffect('fire_sword_trail');

		ACSGetCEntity('acs_sword_trail_3_dual_wield').StopEffect('frost_sword_trail');
		ACSGetCEntity('acs_sword_trail_3_dual_wield').StopEffect('fire_sword_trail');
		
		thePlayer.RemoveTag('ACS_Flammable_Oil_Enabled');
	}

	function FlammableOilEvent()
	{
		var ent, ent_2 						: CEntity;
		var bone_vec, attach_vec			: Vector;
		var bone_rot, attach_rot			: EulerAngles;

		ACSGetCEntity('ACS_Quen_Bubble').Destroy();
			
		ACSGetCEntity('ACS_Quen_Fx').Destroy();

		ACSGetCEntity('ACS_Sign_Icon').Destroy();

		ACSGetCEntity('ACS_Sign_Icon_Anchor').Destroy();

		ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
		"dlc\dlc_acs\data\fx\sign_icons.w2ent"
		, true ), GetWitcherPlayer().GetWorldPosition(), GetWitcherPlayer().GetWorldRotation() );

		ent_2 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
		"dlc\dlc_acs\data\fx\sign_icons.w2ent"
		, true ), GetWitcherPlayer().GetWorldPosition(), GetWitcherPlayer().GetWorldRotation() );

		GetWitcherPlayer().GetBoneWorldPositionAndRotationByIndex( GetWitcherPlayer().GetBoneIndex( 'l_handRoll' ), bone_vec, bone_rot );

		attach_rot.Roll = 0;
		attach_rot.Pitch = 0;
		attach_rot.Yaw = 0;
		attach_vec.X = 0.375;
		attach_vec.Y = 0.05;
		attach_vec.Z = 0.05;

		ent.CreateAttachmentAtBoneWS( GetWitcherPlayer(), 'l_handRoll', bone_vec, bone_rot );

		ent_2.CreateAttachment( ent, , attach_vec, attach_rot );

		if (ACS_GetItem_SwordHeldSwitchBasedUponStat('frost_sword'))
		{
			ent_2.PlayEffectSingle('ep2_mutations_06_frosty_aard');

			ent_2.PlayEffectSingle('igni_icon_blue');
		}
		else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('poison_sword'))
		{
			if ( !theSound.SoundIsBankLoaded("ep2_mutations_04.bnk") )
			{
				theSound.SoundLoadBank( "ep2_mutations_04.bnk", false );
			}

			ent_2.SoundEvent("ep2_mutations_04_poison_blood_spray_enemy");

			ent_2.PlayEffectSingle('igni_icon_green');
		}
		else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('bleed_sword'))
		{
			if ( !theSound.SoundIsBankLoaded("monster_barghest.bnk") )
			{
				theSound.SoundLoadBank( "monster_barghest.bnk", false );
			}

			ent_2.SoundEvent("monster_barghest_combat_blood_flames");

			ent_2.PlayEffectSingle('igni_icon_red');
		}
		else
		{
			if (ACS_Armor_Set_Check('forgotten_wolf', false) 
			|| ACS_Armor_Set_Check('acs_armor', false)
			|| ACS_Armor_Set_Check('volhikar', false)
			|| thePlayer.HasTag('acs_vampire_claws_equipped')
			|| ACS_Vampire_Claws_Access()
			)
			{
				ent_2.PlayEffectSingle('igni_icon_red');
			}
			else
			{
				ent_2.PlayEffectSingle('igni_icon');
			}

			ent_2.PlayEffectSingle('critical_igni');
		}

		ent.AddTag('ACS_Sign_Icon_Anchor');

		ent_2.AddTag('ACS_Sign_Icon');

		ent.DestroyAfter(1);

		ent_2.DestroyAfter(1);

		thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');

		if (thePlayer.IsAnyWeaponHeld() && !thePlayer.IsWeaponHeld('fist'))
		{
			thePlayer.RaiseEvent('ACS_CombatExtraReset');

			if (RandF() < 0.5)
			{
				thePlayer.RaiseEvent('ACS_SwordRepair');
			}
			else
			{
				thePlayer.RaiseEvent('ACS_SwordBuff');
			}

			IdleAdditiveBlockTemp();

			thePlayer.AddTag('ACS_SwordBuffAnimationPlayed');
		}

		RemoveTimer('FlammableOilActual');
		AddTimer('FlammableOilActual', 0.25  , false);
	}

	public timer function FlammableOilActual( time : float , id : int )
	{
		var ent, ent_dual_wield, ent_flame_fx, ent_ground_fx				: CEntity;
		var rot                        						 				: EulerAngles;
		var pos																: Vector;
		var duration  														: float;
		var sp 																: SAbilityAttributeValue;
		var item_steel, item_silver											: SItemUniqueId;

		ACSGetCEntity('acs_sword_trail_1').StopEffect('sword_axii_trail');
		ACSGetCEntity('acs_sword_trail_1').StopEffect('sword_igni_trail');

		ACSGetCEntity('acs_sword_trail_2').StopEffect('sword_axii_trail');
		ACSGetCEntity('acs_sword_trail_2').StopEffect('sword_igni_trail');

		ACSGetCEntity('acs_sword_trail_3').StopEffect('sword_axii_trail');
		ACSGetCEntity('acs_sword_trail_3').StopEffect('sword_igni_trail');

		ACSGetCEntity('acs_sword_trail_1').StopEffect('frost_sword_trail');
		ACSGetCEntity('acs_sword_trail_1').StopEffect('fire_sword_trail');

		ACSGetCEntity('acs_sword_trail_2').StopEffect('frost_sword_trail');
		ACSGetCEntity('acs_sword_trail_2').StopEffect('fire_sword_trail');

		ACSGetCEntity('acs_sword_trail_3').StopEffect('frost_sword_trail');
		ACSGetCEntity('acs_sword_trail_3').StopEffect('fire_sword_trail');



		ACSGetCEntity('acs_sword_trail_1_dual_wield').StopEffect('sword_axii_trail');
		ACSGetCEntity('acs_sword_trail_1_dual_wield').StopEffect('sword_igni_trail');

		ACSGetCEntity('acs_sword_trail_2_dual_wield').StopEffect('sword_axii_trail');
		ACSGetCEntity('acs_sword_trail_2_dual_wield').StopEffect('sword_igni_trail');

		ACSGetCEntity('acs_sword_trail_3_dual_wield').StopEffect('sword_axii_trail');
		ACSGetCEntity('acs_sword_trail_3_dual_wield').StopEffect('sword_igni_trail');

		ACSGetCEntity('acs_sword_trail_1_dual_wield').StopEffect('frost_sword_trail');
		ACSGetCEntity('acs_sword_trail_1_dual_wield').StopEffect('fire_sword_trail');

		ACSGetCEntity('acs_sword_trail_2_dual_wield').StopEffect('frost_sword_trail');
		ACSGetCEntity('acs_sword_trail_2_dual_wield').StopEffect('fire_sword_trail');

		ACSGetCEntity('acs_sword_trail_3_dual_wield').StopEffect('frost_sword_trail');
		ACSGetCEntity('acs_sword_trail_3_dual_wield').StopEffect('fire_sword_trail');

		if (ACSGetCEntity('ACS_Frost_Sword_Ent'))
		{
			ACSGetCEntity('ACS_Frost_Sword_Ent').Destroy();
		}

		if (ACSGetCEntity('ACS_Fire_Sword_Ent'))
		{
			ACSGetCEntity('ACS_Fire_Sword_Ent').Destroy();

			ACSGetCEntity('ACS_Fire_Sword_Ground_Fx_Ent').Destroy();
		}

		if (ACSGetCEntity('ACS_Frost_Sword_Ent_Dual_Wield'))
		{
			ACSGetCEntity('ACS_Frost_Sword_Ent_Dual_Wield').Destroy();
		}

		if (ACSGetCEntity('ACS_Fire_Sword_Ent_Dual_Wield'))
		{
			ACSGetCEntity('ACS_Fire_Sword_Ent_Dual_Wield').Destroy();
		}

		rot = thePlayer.GetWorldRotation();

		pos = thePlayer.GetWorldPosition();

		ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

		"dlc\dlc_acs\data\fx\acs_sword_trail.w2ent"

		, true ), pos, rot );

		ent.AddTag('ACS_Fire_Sword_Ent');

		if (thePlayer.HasTag('ACS_Dual_Wield_Active'))
		{
			ent_dual_wield = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

			"dlc\dlc_acs\data\fx\acs_sword_trail.w2ent"

			, true ), pos, rot );

			ent_dual_wield.AddTag('ACS_Fire_Sword_Ent_Dual_Wield');
		}

		if (ACS_GetItem_SwordHeldSwitchBasedUponStat('frost_sword'))
		{
			ent.CreateAttachment( thePlayer, 'r_weapon', Vector( 0, 0, 0.125 ), EulerAngles(0,0,0) );

			ent.PlayEffectSingle('frost_sword_1');

			ent.PlayEffectSingle('ice_fire_sparks_trail');

			ent.PlayEffectSingle('runeword1_ice_trail_large');

			ent.PlayEffectSingle('runeword_ice_large');

			if (ent_dual_wield)
			{
				ent_dual_wield.CreateAttachment( thePlayer, 'l_weapon', Vector( 0, 0, 0.125 ), EulerAngles(0,0,0) );

				ent_dual_wield.PlayEffectSingle('frost_sword_1');

				ent_dual_wield.PlayEffectSingle('ice_fire_sparks_trail');

				ent_dual_wield.PlayEffectSingle('runeword1_ice_trail_large');

				ent_dual_wield.PlayEffectSingle('runeword_ice_large');
			}
			
	
			ACSGetCEntity('acs_sword_trail_3').PlayEffectSingle('sword_axii_trail');

			ACSGetCEntity('acs_sword_trail_3').PlayEffectSingle('frost_sword_trail');

			ACSGetCEntity('acs_sword_trail_3_dual_wield').PlayEffectSingle('sword_axii_trail');

			ACSGetCEntity('acs_sword_trail_3_dual_wield').PlayEffectSingle('frost_sword_trail');

			ent.SoundEvent("magic_caranthil_vfx_icespear_explo");

			ent.SoundEvent("magic_caranthil_vfx_icespear_firefx_loop_start");

			ent.SoundEvent("magic_caranthil_vfx_icespear_firefx_loop_stop");
		}
		else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('poison_sword'))
		{
			ent.CreateAttachment( thePlayer, 'r_weapon', Vector( 0, 0, 0 ), EulerAngles(0,0,0) );

			ent.PlayEffectSingle('poison_sword_1');

			ent.PlayEffectSingle('poison_sword_1_1_1');

			if (ent_dual_wield)
			{
				ent_dual_wield.CreateAttachment( thePlayer, 'l_weapon', Vector( 0, 0, 0 ), EulerAngles(0,0,0) );

				ent_dual_wield.PlayEffectSingle('poison_sword_1');

				ent_dual_wield.PlayEffectSingle('poison_sword_1_1_1');
			}

			ACSGetCEntity('acs_sword_trail_1').PlayEffectSingle('poison_sword_trail');

			ACSGetCEntity('acs_sword_trail_1_dual_wield').PlayEffectSingle('poison_sword_trail');

			ACSGetCEntity('acs_sword_trail_2').PlayEffectSingle('poison_sword_trail');

			ACSGetCEntity('acs_sword_trail_2_dual_wield').PlayEffectSingle('poison_sword_trail');
			
			ACSGetCEntity('acs_sword_trail_3').PlayEffectSingle('poison_sword_trail');

			ACSGetCEntity('acs_sword_trail_3_dual_wield').PlayEffectSingle('poison_sword_trail');


			if ( !theSound.SoundIsBankLoaded("monster_kikimora.bnk") )
			{
				theSound.SoundLoadBank( "monster_kikimora.bnk", false );
			}
			
			ent.SoundEvent("monster_kikimora_cmb_attack_poison_cloud");
		}
		else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('bleed_sword'))
		{
			ent.CreateAttachment( thePlayer, 'r_weapon', Vector( 0, 0, 0 ), EulerAngles(0,0,0) );

			ent.PlayEffectSingle('blood_sword_1');

			ent.PlayEffectSingle('blood_sword_1_1_1');

			if (ent_dual_wield)
			{
				ent_dual_wield.CreateAttachment( thePlayer, 'l_weapon', Vector( 0, 0, 0 ), EulerAngles(0,0,0) );

				ent_dual_wield.PlayEffectSingle('blood_sword_1');

				ent_dual_wield.PlayEffectSingle('blood_sword_1_1_1');
			}

			ACSGetCEntity('acs_sword_trail_1').PlayEffectSingle('blood_sword_trail');

			ACSGetCEntity('acs_sword_trail_1_dual_wield').PlayEffectSingle('blood_sword_trail');

			ACSGetCEntity('acs_sword_trail_2').PlayEffectSingle('blood_sword_trail');

			ACSGetCEntity('acs_sword_trail_2_dual_wield').PlayEffectSingle('blood_sword_trail');
			
			ACSGetCEntity('acs_sword_trail_3').PlayEffectSingle('blood_sword_trail');

			ACSGetCEntity('acs_sword_trail_3_dual_wield').PlayEffectSingle('blood_sword_trail');


			if ( !theSound.SoundIsBankLoaded("fx_blood.bnk") )
			{
				theSound.SoundLoadBank( "fx_blood.bnk", false );
			}

			ent.SoundEvent("dialog_fx_blood_short");

			ent.SoundEvent("fx_blood_outflow_medium_loop");
			ent.SoundEvent("fx_blood_outflow_medium_loop_end");
		}
		else
		{
			ent.CreateAttachment( thePlayer, 'r_weapon', Vector( 0, 0, 0.125 ), EulerAngles(0,0,0) );

			ent.PlayEffectSingle('fire_sword_1');

			ent.PlayEffectSingle('fire_sparks_trail');

			ent.PlayEffectSingle('runeword1_fire_trail_large');

			ent.PlayEffectSingle('runeword_igni_large');

			if (ent_dual_wield)
			{
				ent_dual_wield.CreateAttachment( thePlayer, 'l_weapon', Vector( 0, 0, 0.125 ), EulerAngles(0,0,0) );

				ent_dual_wield.PlayEffectSingle('fire_sword_1');

				ent_dual_wield.PlayEffectSingle('fire_sparks_trail');

				ent_dual_wield.PlayEffectSingle('runeword1_fire_trail_large');

				ent_dual_wield.PlayEffectSingle('runeword_igni_large');
			}

			ACSGetCEntity('acs_sword_trail_3').PlayEffectSingle('sword_igni_trail');

			ACSGetCEntity('acs_sword_trail_3').PlayEffectSingle('fire_sword_trail');

			ACSGetCEntity('acs_sword_trail_3_dual_wield').PlayEffectSingle('sword_igni_trail');

			ACSGetCEntity('acs_sword_trail_3_dual_wield').PlayEffectSingle('fire_sword_trail');

			ent.SoundEvent("fx_fire_geralt_fire_hit");

			ent.SoundEvent("fx_fire_burning_body_strong_loop");

			ent.SoundEvent("fx_fire_burning_strong_end");
		}

		if (thePlayer.HasTag('ACS_Spear_Transform_Active')
		|| thePlayer.IsUsingHorse()
		)
		{
			ent.BreakAttachment();

			if (ACS_GetItem_SwordHeldSwitchBasedUponStat('poison_sword')
			|| ACS_GetItem_SwordHeldSwitchBasedUponStat('bleed_sword')
			)
			{
				ent.CreateAttachment( thePlayer, 'r_weapon', Vector( 0, 0, 1.25 ), EulerAngles(0,0,0) );
			}
			else
			{
				ent.CreateAttachment( thePlayer, 'r_weapon', Vector( 0, 0, 1.375 ), EulerAngles(0,0,0) );
			}
		}

		thePlayer.AddTag('ACS_Flammable_Oil_Enabled');

		RemoveTimer('RemoveFlammableOilTag');
		AddTimer('RemoveFlammableOilTag', 10 + (10 * ACS_SignIntensityPercentage('total') * 0.5) , false);


		ent_flame_fx = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

		"dlc\dlc_acs\data\entities\other\fx_dummy_entity_ifrit.w2ent"

		, true ), ent.GetWorldPosition(), ent.GetWorldRotation() );

		ent_flame_fx.CreateAttachment( thePlayer, 'r_weapon', Vector( 0, 0, 0.125 ), EulerAngles(0,0,0) );

		if (ACS_GetItem_SwordHeldSwitchBasedUponStat('frost_sword'))
		{
			ent_flame_fx.PlayEffectSingle('hit_ice_fire');
		}
		else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('poison_sword'))
		{
			ent_flame_fx.PlayEffectSingle('hit_poison');
		}
		else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('bleed_sword'))
		{
			ent_flame_fx.PlayEffectSingle('shadowdash_ground_blood_construct');
		}
		else
		{
			ent_flame_fx.PlayEffectSingle('hit_fire');
		}

		ent_flame_fx.DestroyAfter(5);

		ent_ground_fx = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

		"dlc\dlc_acs\data\fx\acs_sword_trail.w2ent"

		, true ), pos, rot );

		ent_ground_fx.AddTag('ACS_Fire_Sword_Ground_Fx_Ent');

		ent_ground_fx.CreateAttachment( thePlayer, , Vector( 1.5, 0, 0 ), EulerAngles(0,0,0) );

		if (ACS_GetItem_SwordHeldSwitchBasedUponStat('frost_sword'))
		{
			ent_ground_fx.PlayEffectSingle('golem_ground_ice_fire_fx');
		}
		else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('poison_sword'))
		{
			ent_ground_fx.PlayEffectSingle('golem_ground_poison_fx');
		}
		else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('bleed_sword'))
		{
			ent_ground_fx.PlayEffectSingle('golem_ground_blood_fx');
		}
		else
		{
			ent_ground_fx.PlayEffectSingle('golem_ground_fire_fx');
		}

		if ( !theSound.SoundIsBankLoaded("mq_nml_1035.bnk") )
		{
			theSound.SoundLoadBank( "mq_nml_1035.bnk", false );
		}

		ACS_Tutorial_Display_Check('ACS_Way_Of_The_Flame_Tutorial_Shown');

		GetWitcherPlayer().SoundEvent("scene_weapon_sword_unsheat_fast");
		GetWitcherPlayer().SoundEvent("scene_weapon_sword_unsheat_fast");
		GetWitcherPlayer().SoundEvent("scene_weapon_sword_unsheat_fast");
		GetWitcherPlayer().SoundEvent("scene_weapon_sword_unsheat_fast");
		GetWitcherPlayer().SoundEvent("scene_weapon_sword_unsheat_fast");

		RemoveTimer('FlammableOilBurnDelay');
		AddTimer('FlammableOilBurnDelay', 1 , false);

		if (GetWitcherPlayer().IsWeaponHeld('steelsword'))
		{
			GetWitcherPlayer().GetInventory().GetItemEquippedOnSlot(EES_SteelSword, item_steel);

			GetWitcherPlayer().GetInventory().SetItemDurabilityScript(item_steel, (GetWitcherPlayer().GetInventory().GetItemDurability(item_steel) - (GetWitcherPlayer().GetInventory().GetItemDurability(item_steel) * 0.05)) );
		}
		else if (GetWitcherPlayer().IsWeaponHeld('silversword'))
		{
			GetWitcherPlayer().GetInventory().GetItemEquippedOnSlot(EES_SilverSword, item_silver);

			GetWitcherPlayer().GetInventory().SetItemDurabilityScript(item_silver, (GetWitcherPlayer().GetInventory().GetItemDurability(item_silver) - (GetWitcherPlayer().GetInventory().GetItemDurability(item_silver) * 0.05)) );
		}

		if (!thePlayer.IsUsingHorse())
		{
			if (ACS_GetItem_SwordHeldSwitchBasedUponStat('frost_sword'))
			{
				ACS_Frost_Cone();
			}
			else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('poison_sword'))
			{
				ACS_Poison_Cloud();
			}
			else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('bleed_sword'))
			{
				ACS_Blood_Arc();
			}
			else
			{
				ACS_Igni();
			}
		}
	}

	public timer function FlammableOilBurnDelay( time : float , id : int )
	{
		var params 															: SCustomEffectParams;

		if (ACS_GetItem_SwordHeldSwitchBasedUponStat('frost_sword'))
		{
			params.effectType = EET_SlowdownFrost;
		}
		else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('poison_sword'))
		{
			params.effectType = EET_Poison;
		}
		else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('bleed_sword'))
		{
			params.effectType = EET_Bleeding;
		}
		else
		{
			params.effectType = EET_Burning;
		}

		params.creator = thePlayer;
		params.sourceName = "ACS_Flammable_Oil_Burn";
		params.duration = 1;

		thePlayer.AddEffectCustom( params );
	}

	public timer function IgniLightIcon( time : float , id : int )
	{
		var ent, ent_2 						: CEntity;
		var bone_vec, attach_vec			: Vector;
		var bone_rot, attach_rot			: EulerAngles;

		ACSGetCEntity('ACS_Quen_Bubble').Destroy();
			
		ACSGetCEntity('ACS_Quen_Fx').Destroy();

		ACSGetCEntity('ACS_Sign_Icon').Destroy();

		ACSGetCEntity('ACS_Sign_Icon_Anchor').Destroy();

		ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
		"dlc\dlc_acs\data\fx\sign_icons.w2ent"
		, true ), GetWitcherPlayer().GetWorldPosition(), GetWitcherPlayer().GetWorldRotation() );

		ent_2 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
		"dlc\dlc_acs\data\fx\sign_icons.w2ent"
		, true ), GetWitcherPlayer().GetWorldPosition(), GetWitcherPlayer().GetWorldRotation() );

		GetWitcherPlayer().GetBoneWorldPositionAndRotationByIndex( GetWitcherPlayer().GetBoneIndex( 'l_handRoll' ), bone_vec, bone_rot );

		attach_rot.Roll = 0;
		attach_rot.Pitch = 0;
		attach_rot.Yaw = 0;
		attach_vec.X = 0.375;
		attach_vec.Y = 0.05;
		attach_vec.Z = 0.05;

		ent.CreateAttachmentAtBoneWS( GetWitcherPlayer(), 'l_handRoll', bone_vec, bone_rot );

		ent_2.CreateAttachment( ent, , attach_vec, attach_rot );

		if (ACS_Armor_Set_Check('forgotten_wolf', false) 
		|| ACS_Armor_Set_Check('acs_armor', false)
		|| ACS_Armor_Set_Check('volhikar', false)
		|| thePlayer.HasTag('acs_vampire_claws_equipped')
		|| ACS_Vampire_Claws_Access()
		)
		{
			ent_2.PlayEffectSingle('igni_icon_red');
		}
		else
		{
			ent_2.PlayEffectSingle('igni_icon');
		}

		ent_2.PlayEffectSingle('critical_igni');

		ent_2.DestroyAfter(0.5);

		ent.AddTag('ACS_Sign_Icon_Anchor');

		ent_2.AddTag('ACS_Sign_Icon');

		ACSGetCEntity('ACS_Pipe').PlayEffectSingle('fire_interaction');
	}


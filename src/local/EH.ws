				ACS_Oneliner(FormatCompassBarPathOmega("icons/inventory/acs_compass_bar.xbm"), ACSGetCEntity('ACS_Compass_Bar_Cardinal_NorthEast_Entity'), "ACS_Compass_Bar_Cardinal_NorthEast_Bar_Omega");

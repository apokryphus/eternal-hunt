							{
								damageMax = (actortarget.GetMaxHealth() - actortarget.GetCurrentHealth()) * ACS_Settings_Main_Float('acs_sign_combo_system_settings','acs_sign_combo_system_missing_max_health_damage_when_below_half_health', 0.125);
							}
						}
						else if (actortarget.UsesEssence())
						{
							if (actortarget.GetCurrentHealth() >= actortarget.GetMaxHealth() * 0.5)
							{
								if (((CMovingPhysicalAgentComponent)(actortarget.GetMovingAgentComponent())).GetCapsuleHeight() >= 2
								|| actortarget.GetRadius() >= 0.7
								|| actortarget.HasAbility('Boss')
								|| actortarget.HasTag('IsBoss')
								|| actortarget.HasTag('ACS_Big_Boi')
								)
								{
									damageMax = actortarget.GetMaxHealth() * ACS_Settings_Main_Float('acs_sign_combo_system_settings','acs_sign_combo_system_max_health_damage_when_above_half_health', 0.125)/2;
								}
								else
								{
									damageMax = actortarget.GetMaxHealth() * ACS_Settings_Main_Float('acs_sign_combo_system_settings','acs_sign_combo_system_max_health_damage_when_above_half_health', 0.125);
								}
							}
							else if (actortarget.GetCurrentHealth() < actortarget.GetMaxHealth() * 0.5)
							{
								if (((CMovingPhysicalAgentComponent)(actortarget.GetMovingAgentComponent())).GetCapsuleHeight() >= 2
								|| actortarget.GetRadius() >= 0.7
								|| actortarget.HasAbility('Boss')
								|| actortarget.HasTag('IsBoss')
								|| actortarget.HasTag('ACS_Big_Boi')
								)
								{
									damageMax = (actortarget.GetMaxHealth() - actortarget.GetCurrentHealth()) * ACS_Settings_Main_Float('acs_sign_combo_system_settings','acs_sign_combo_system_missing_max_health_damage_when_below_half_health', 0.125)/2;
								}
								else
								{
									damageMax = (actortarget.GetMaxHealth() - actortarget.GetCurrentHealth()) * ACS_Settings_Main_Float('acs_sign_combo_system_settings','acs_sign_combo_system_missing_max_health_damage_when_below_half_health', 0.125);
								}
							}
						}

						damageMax += damageMax * ACS_SignIntensityPercentage('total') * 0.5;

						dmg.AddEffectInfo(EET_Stagger, 1);

						((CNewNPC)actortarget).ACS_DealPostureDamage(20);

						ACSGetCEntityDestroyAll('ACS_Sign_Combo_Icon');

						thePlayer.GainStat( BCS_Stamina, thePlayer.GetStatMax( BCS_Stamina) * 0.125 );

						RemoveTimer('RemoveSignComboStuffRepeating');
						RemoveTimer('RemoveSignComboStuff');

						actortarget.RemoveTag('ACS_Sign_Combo_Attack_1');
						actortarget.RemoveTag('ACS_Sign_Combo_Attack_2');
						actortarget.RemoveTag('ACS_Sign_Combo_Aard_Ready');
						actortarget.RemoveTag('ACS_Sign_Combo_Icon_Ready_To_Activate_NPC_Aard');

						ACSSignComboSystemRemoveTags();
					}
					else
					{
						if (ACS_Armor_Set_Check('forgotten_wolf', false) 
						|| ACS_Armor_Set_Check('acs_armor', false)
						|| ACS_Armor_Set_Check('volhikar', false)
						|| thePlayer.HasTag('acs_vampire_claws_equipped')
						|| ACS_Vampire_Claws_Access()
						)
						{
							dmg.AddEffectInfo(EET_Knockdown, 1);
							dmg.AddEffectInfo(EET_Stagger, 1);

							if (actortarget.UsesVitality())
							{
								damageMax = actortarget.GetMaxHealth() * 0.0625;
							}
							else if (actortarget.UsesEssence())
							{
								if (((CMovingPhysicalAgentComponent)(actortarget.GetMovingAgentComponent())).GetCapsuleHeight() >= 2
								|| actortarget.GetRadius() >= 0.7
								|| actortarget.HasAbility('Boss')
								|| actortarget.HasTag('IsBoss')
								|| actortarget.HasTag('ACS_Big_Boi')
								)
								{
									damageMax = actortarget.GetMaxHealth() * 0.03125;
								}
								else
								{
									damageMax = actortarget.GetMaxHealth() * 0.0625;
								}
							}
						}
						else
						{
							damageMax = 10;
						}

						((CNewNPC)actortarget).ACS_DealPostureDamage(10);
					}

					dmg.SetCanPlayHitParticle(false);
					
					dmg.SetSuppressHitSounds(true);

					dmg.SetHitReactionType( EHRT_Heavy, true);

					dmg.SetHitAnimationPlayType(EAHA_ForceYes);
					
					dmg.AddDamage( theGame.params.DAMAGE_NAME_PHYSICAL, 50 + damageMax );

					dmg.AddDamage( theGame.params.DAMAGE_NAME_SILVER, 50 + damageMax );

					if ( 
					ACS_GetItem_Sword_IsEquipped('eredin_steel', 'steel')
					|| ACS_GetItem_Sword_IsEquipped('imlerith_steel', 'steel')
					|| ACS_GetItem_Sword_IsEquipped('nithral_steel', 'steel')
					)
					{
						dmg.AddEffectInfo(EET_SlowdownFrost, 3);

						if ( 
						ACS_GetItem_Sword_IsEquipped('imlerith_steel', 'steel')
						)
						{
							if (RandF() < 0.5)
							{
								dmg.AddEffectInfo(EET_Stagger, 1);
							}
						}
					}

					if 
					(
						GetWitcherPlayer().IsAnyQuenActive()
					)
					{
						dmg.AddDamage( theGame.params.DAMAGE_NAME_SHOCK, 50 + damageMax );

						dmg.AddEffectInfo(EET_Paralyzed, 3);
					}

					dmg.SetForceExplosionDismemberment();
						
					dmg.SetCriticalHit(); theGame.damageMgr.ProcessAction( dmg );
						
					delete dmg;	
				}
				else
				{
					if (!actortarget.IsAlive() )
					{
						((CNewNPC)actortarget).SetKinematic(false);

						ACSGetCEntityDestroyAll('ACS_Killed_By_Fire_Burning_FX_Ground_Fire');

						actortarget.StopEffect('critical_burning');
	
						actortarget.RemoveTag('ACS_Killed_By_Fire');

						((CNewNPC)actortarget).RemoveTimer('ACS_Critical_Burning_Remove_Delay');
						((CNewNPC)actortarget).RemoveTimer('ACS_Critical_Burning_Delay');
					}
				}
			}
		}
	}

	function Aard360DealDamage()
	{
		var actors    																																						: array<CActor>;
		var i         																																						: int;
		var actortarget																																						: CActor;
		var dmg																																								: W3DamageAction;
		var damageMax																																						: float;
		var sp 																																								: SAbilityAttributeValue;
		var witcher 																																						: W3PlayerWitcher;
		var movementAdjustor																																				: CMovementAdjustor;
		var ticket 																																							: SMovementAdjustmentRequestTicket;
		var signIconEnt																																						: CEntity;
		var torsoBoneIndex																																					: int;
		var pos 																																							: Vector;

		actors.Clear();

		actors = thePlayer.GetNPCsAndPlayersInCone(8, VecHeading(thePlayer.GetHeadingVector()), 360, 50, , FLAG_ExcludePlayer );

		if( actors.Size() > 0 )
		{
			for( i = 0; i < actors.Size(); i += 1 )
			{
				actortarget = (CActor)actors[i];

				if (actortarget.IsAlive() && actortarget.GetAttitude( thePlayer ) == AIA_Hostile )
				{
					if (actortarget.IsUsingVehicle()
					&& !actortarget.HasTag('ACS_Dullahan')
					&& !actortarget.HasTag('ACS_Dullahan_Horse')
					) 
					{
						actortarget.SignalGameplayEventParamInt( 'RidingManagerDismountHorse', DT_shakeOff | DT_fromScript );
					}

					dmg = new W3DamageAction in theGame.damageMgr;
					
					dmg.Initialize(thePlayer, actortarget, thePlayer, thePlayer.GetName(), EHRT_Heavy, CPS_Undefined, false, false, true, false);
					
					dmg.SetProcessBuffsIfNoDamage(true);

					if (actortarget.HasTag('ACS_Sign_Combo_Icon_Ready_To_Activate_NPC_Aard'))
					{
						torsoBoneIndex = actortarget.GetTorsoBoneIndex();

						if ( torsoBoneIndex != -1 )
						{
							pos = MatrixGetTranslation( actortarget.GetBoneWorldMatrixByIndex( torsoBoneIndex ) );
						}
						else
						{
							pos = actortarget.GetWorldPosition() + Vector(0,0,1.5);
						}

						actortarget.SoundEvent("sign_aard_blast");

						signIconEnt = theGame.CreateEntity( (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\fx\sign_icons.w2ent", true ), pos );
						signIconEnt.DestroyAfter(5);

						signIconEnt.PlayEffect('critical_aard');
						signIconEnt.PlayEffect('mutation_2_aard');
						signIconEnt.PlayEffect('mutation_2_aard_b');

						if (actortarget.UsesVitality())
						{
							if (actortarget.GetCurrentHealth() >= actortarget.GetMaxHealth() * 0.5)
							{
								damageMax = actortarget.GetMaxHealth() * ACS_Settings_Main_Float('acs_sign_combo_system_settings','acs_sign_combo_system_max_health_damage_when_above_half_health', 0.125);
							}
							else if (actortarget.GetCurrentHealth() < actortarget.GetMaxHealth() * 0.5)
							{
								damageMax = (actortarget.GetMaxHealth() - actortarget.GetCurrentHealth()) * ACS_Settings_Main_Float('acs_sign_combo_system_settings','acs_sign_combo_system_missing_max_health_damage_when_below_half_health', 0.125);
							}
						}
						else if (actortarget.UsesEssence())
						{
							if (actortarget.GetCurrentHealth() >= actortarget.GetMaxHealth() * 0.5)
							{
								if (((CMovingPhysicalAgentComponent)(actortarget.GetMovingAgentComponent())).GetCapsuleHeight() >= 2
								|| actortarget.GetRadius() >= 0.7
								|| actortarget.HasAbility('Boss')
								|| actortarget.HasTag('IsBoss')
								|| actortarget.HasTag('ACS_Big_Boi')
								)
								{
									damageMax = actortarget.GetMaxHealth() * ACS_Settings_Main_Float('acs_sign_combo_system_settings','acs_sign_combo_system_max_health_damage_when_above_half_health', 0.125)/2;
								}
								else
								{
									damageMax = actortarget.GetMaxHealth() * ACS_Settings_Main_Float('acs_sign_combo_system_settings','acs_sign_combo_system_max_health_damage_when_above_half_health', 0.125);
								}
							}
							else if (actortarget.GetCurrentHealth() < actortarget.GetMaxHealth() * 0.5)
							{
								if (((CMovingPhysicalAgentComponent)(actortarget.GetMovingAgentComponent())).GetCapsuleHeight() >= 2
								|| actortarget.GetRadius() >= 0.7
								|| actortarget.HasAbility('Boss')
								|| actortarget.HasTag('IsBoss')
								|| actortarget.HasTag('ACS_Big_Boi')
								)
								{
									damageMax = (actortarget.GetMaxHealth() - actortarget.GetCurrentHealth()) * ACS_Settings_Main_Float('acs_sign_combo_system_settings','acs_sign_combo_system_missing_max_health_damage_when_below_half_health', 0.125)/2;
								}
								else
								{
									damageMax = (actortarget.GetMaxHealth() - actortarget.GetCurrentHealth()) * ACS_Settings_Main_Float('acs_sign_combo_system_settings','acs_sign_combo_system_missing_max_health_damage_when_below_half_health', 0.125);
								}
							}
						}

						damageMax += damageMax * ACS_SignIntensityPercentage('total') * 0.5;

						dmg.AddEffectInfo(EET_Stagger, 1);

						((CNewNPC)actortarget).ACS_DealPostureDamage(20);

						ACSGetCEntityDestroyAll('ACS_Sign_Combo_Icon');

						thePlayer.GainStat( BCS_Stamina, thePlayer.GetStatMax( BCS_Stamina) * 0.125 );

						RemoveTimer('RemoveSignComboStuffRepeating');
						RemoveTimer('RemoveSignComboStuff');

						actortarget.RemoveTag('ACS_Sign_Combo_Attack_1');
						actortarget.RemoveTag('ACS_Sign_Combo_Attack_2');
						actortarget.RemoveTag('ACS_Sign_Combo_Aard_Ready');
						actortarget.RemoveTag('ACS_Sign_Combo_Icon_Ready_To_Activate_NPC_Aard');

						ACSSignComboSystemRemoveTags();
					}
					else
					{
						if (ACS_Armor_Set_Check('forgotten_wolf', false) 
						|| ACS_Armor_Set_Check('acs_armor', false)
						|| ACS_Armor_Set_Check('volhikar', false)
						|| thePlayer.HasTag('acs_vampire_claws_equipped')
						|| ACS_Vampire_Claws_Access()
						)
						{
							((CNewNPC)actortarget).ACS_DealPostureDamage(10);

							dmg.AddEffectInfo(EET_Knockdown, 1);
							dmg.AddEffectInfo(EET_Stagger, 1);

							if (actortarget.UsesVitality())
							{
								damageMax = actortarget.GetMaxHealth() * 0.0625;
							}
							else if (actortarget.UsesEssence())
							{
								if (((CMovingPhysicalAgentComponent)(actortarget.GetMovingAgentComponent())).GetCapsuleHeight() >= 2
								|| actortarget.GetRadius() >= 0.7
								|| actortarget.HasAbility('Boss')
								|| actortarget.HasTag('IsBoss')
								|| actortarget.HasTag('ACS_Big_Boi')
								)
								{
									damageMax = actortarget.GetMaxHealth() * 0.03125;
								}
								else
								{
									damageMax = actortarget.GetMaxHealth() * 0.0625;
								}
							}
						}
						else
						{
							damageMax = 10;
						}
					}

					dmg.SetCanPlayHitParticle(false);
					
					dmg.SetSuppressHitSounds(true);

					dmg.SetHitReactionType( EHRT_Heavy, true);

					dmg.SetHitAnimationPlayType(EAHA_ForceYes);

					dmg.AddDamage( theGame.params.DAMAGE_NAME_PHYSICAL, 50 + damageMax );

					dmg.AddDamage( theGame.params.DAMAGE_NAME_SILVER, 50 + damageMax );

					if 
					(
						GetWitcherPlayer().IsAnyQuenActive()
					)
					{
						dmg.AddDamage( theGame.params.DAMAGE_NAME_SHOCK, 50 + damageMax );

						dmg.AddEffectInfo(EET_Paralyzed, 3);
					}

					dmg.SetForceExplosionDismemberment();
						
					dmg.SetCriticalHit(); theGame.damageMgr.ProcessAction( dmg );
						
					delete dmg;	
				}
				else
				{
					if (!actortarget.IsAlive() )
					{
						((CNewNPC)actortarget).SetKinematic(false);

						ACSGetCEntityDestroyAll('ACS_Killed_By_Fire_Burning_FX_Ground_Fire');
						
						actortarget.StopEffect('critical_burning');
	
						actortarget.RemoveTag('ACS_Killed_By_Fire');

						((CNewNPC)actortarget).RemoveTimer('ACS_Critical_Burning_Remove_Delay');
						((CNewNPC)actortarget).RemoveTimer('ACS_Critical_Burning_Delay');
					}
				}
			}
		}
	}


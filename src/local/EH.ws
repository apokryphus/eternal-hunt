								else
								{
									thePlayer.RaiseEvent( 'spursKickHard' );
								}

								horseMotionLeaningActiveReset = true;
							}
						}

						((CMovingPhysicalAgentComponent)((thePlayer.GetHorseCurrentlyMounted()).GetMovingAgentComponent())).SetRotation(hLean);

						((CMovingPhysicalAgentComponent)(thePlayer.GetMovingAgentComponent())).SetRotation(hLean);
					}
				}

				if( cam_direction > 0)
				{
					if (horseMotionLeaningActiveReset)
					{
						if (RandF() < 0.5)
						{
							thePlayer.RaiseEvent( 'spursKick' );
						}
						else
						{
							thePlayer.RaiseEvent( 'spursKickHard' );
						}
						
						horseMotionLeaningActiveReset = false;
					}

					hLean.Roll += lean_roll_modifier;

					if(hLean.Roll > 10)
					{
						hLean.Roll = 10;
					}

					((CMovingPhysicalAgentComponent)((thePlayer.GetHorseCurrentlyMounted()).GetMovingAgentComponent())).SetRotation(hLean);

					((CMovingPhysicalAgentComponent)(thePlayer.GetMovingAgentComponent())).SetRotation(hLean);
				}
				else if(theInput.GetActionValue('GI_AxisLeftX') < 0
				)
				{
					if(horseMotionLeaningActiveReset
					)
					{
						if(hLean.Roll < 0)
						{
							hLean.Roll += lean_roll_modifier;
						}
						
						if(hLean.Roll > 0)
						{
							hLean.Roll -= lean_roll_modifier;
						}

						((CMovingPhysicalAgentComponent)((thePlayer.GetHorseCurrentlyMounted()).GetMovingAgentComponent())).SetRotation(hLean);

						((CMovingPhysicalAgentComponent)(thePlayer.GetMovingAgentComponent())).SetRotation(hLean);
					}
					else
					{
						hLean.Roll -= lean_roll_modifier;

						if(hLean.Roll < -10)
						{
							hLean.Roll = -10;

							if (!horseMotionLeaningActiveReset)
							{
								if (RandF() < 0.5)
								{
									thePlayer.RaiseEvent( 'spursKick' );
								}
								else
								{
									thePlayer.RaiseEvent( 'spursKickHard' );
								}
								
								horseMotionLeaningActiveReset = true;
							}
						}

						((CMovingPhysicalAgentComponent)((thePlayer.GetHorseCurrentlyMounted()).GetMovingAgentComponent())).SetRotation(hLean);

						((CMovingPhysicalAgentComponent)(thePlayer.GetMovingAgentComponent())).SetRotation(hLean);
					}
				}

				if(theInput.GetActionValue('GI_AxisLeftX') == 0
				&& cam_direction == 0
				)
				{
					if (horseMotionLeaningActiveReset)
					{
						if (RandF() < 0.5)
						{
							thePlayer.RaiseEvent( 'spursKick' );
						}
						else
						{
							thePlayer.RaiseEvent( 'spursKickHard' );
						}

						horseMotionLeaningActiveReset = false;
					}

					if(hLean.Roll < 0)
					{
						hLean.Roll += lean_roll_modifier;
					}
					
					if(hLean.Roll > 0)
					{
						hLean.Roll -= lean_roll_modifier;
					}

					((CMovingPhysicalAgentComponent)((thePlayer.GetHorseCurrentlyMounted()).GetMovingAgentComponent())).SetRotation(hLean);

					((CMovingPhysicalAgentComponent)(thePlayer.GetMovingAgentComponent())).SetRotation(hLean);
				}
			}
			else if ((thePlayer.GetHorseCurrentlyMounted().GetHorseComponent()).inGallop)
			{
				if (!horseMotionLeaningActive
				)
				{
					horseMotionLeaningActive = true;
				}

				if( cam_direction < 0 )
				{
					if (horseMotionLeaningActiveReset)
					{
						if (RandF() < 0.5)
						{
							thePlayer.RaiseEvent( 'spursKick' );
						}
						else
						{
							thePlayer.RaiseEvent( 'spursKickHard' );
						}
						
						horseMotionLeaningActiveReset = false;
					}
					
					hLean.Roll -= lean_roll_modifier;

					if(hLean.Roll < -5)
					{

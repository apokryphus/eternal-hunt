	var originalVolume : string;
    var wasSpeaking : bool;
    var wantMute : bool;
    default wasSpeaking = false;
    default wantMute = false;

	function MutePlayerControl()
    {
		if (ACS_Settings_Main_Bool('acs_player_misc_settings','acs_mute_player_enabled', false)
		|| ACS_IS_SNEAKING
		|| thePlayer.HasTag('ACS_Is_Sneaking')
		)
		{
			if (FactsQuerySum("ACS_Geralt_Muted_Enabled") <= 0)
			{
				FactsAdd("ACS_Geralt_Muted_Enabled", 1, -1);
			}

			if (FactsQuerySum("block_geralts_battlecries") <= 0)
			{
				FactsAdd("block_geralts_battlecries", 1, -1);
			}

			wantMute = true;
		
			if(GetWitcherPlayer().IsSpeaking() && !wasSpeaking && wantMute)
			{
				originalVolume = theGame.GetInGameConfigWrapper().GetVarValue( 'Audio', 'VoiceoversVolume');
				theGame.GetInGameConfigWrapper().SetVarValue( 'Audio', 'VoiceoversVolume', "0" );
				theGame.SaveUserSettings();
				wasSpeaking = true;
			}
			else if(!GetWitcherPlayer().IsSpeaking() && wasSpeaking)
			{
				theGame.GetInGameConfigWrapper().SetVarValue( 'Audio', 'VoiceoversVolume', originalVolume );
				theGame.SaveUserSettings();
				wasSpeaking = false;
				wantMute = false;
			}
		}
		else
		{
			if (FactsQuerySum("ACS_Geralt_Muted_Enabled") > 0)
			{
				if (FactsQuerySum("block_geralts_battlecries") > 0)
				{
					FactsRemove("block_geralts_battlecries");
				}

				theGame.GetInGameConfigWrapper().SetVarValue( 'Audio', 'VoiceoversVolume', originalVolume );
				theGame.SaveUserSettings();
				wasSpeaking = false;
				wantMute = false;

				FactsRemove("ACS_Geralt_Muted_Enabled");
			}
		}
    }

	function AltBurnStopFailsafe()
	{
		if ( !thePlayer.IsCastingSign() )
		{
			if(ACSGetCEntity('ACS_Sign_Icon'))
			{
				ACSGetCEntity('ACS_Sign_Icon').StopAllEffects();
			}

			return;
		}
		 
		if (GetWitcherPlayer().GetEquippedSign() == ST_Igni)
		{
			if (GetWitcherPlayer().IsCurrentSignChanneled())
			{
				if ((ACS_Armor_Set_Check('forgotten_wolf', false) 
				|| ACS_Armor_Set_Check('acs_armor', false)
				|| ACS_Armor_Set_Check('volhikar', false)
				|| thePlayer.HasTag('acs_vampire_claws_equipped')
				|| ACS_Vampire_Claws_Access())
				&& ACS_Settings_Main_Bool('acs_signs_settings','acs_enhanced_igni_enabled', true)
				)
				{
					ACSGetCEntity('ACS_Sign_Icon').PlayEffectSingle('burn_red');
					ACSGetCEntity('ACS_Sign_Icon').PlayEffectSingle('burn_1_red');
					ACSGetCEntity('ACS_Sign_Icon').PlayEffectSingle('burn_upgrade_1_red');
				}
				else
				{
					ACSGetCEntity('ACS_Sign_Icon').PlayEffectSingle('burn');
					ACSGetCEntity('ACS_Sign_Icon').PlayEffectSingle('burn_1');
					ACSGetCEntity('ACS_Sign_Icon').PlayEffectSingle('burn_upgrade_1');
				}
				
				if 
				(
					GetWitcherPlayer().IsAnyQuenActive()
					&& ACS_Settings_Main_Bool('acs_signs_settings','acs_quen_extra_effects_enabled', true)
				)
				{
					if ( !theSound.SoundIsBankLoaded("amb_dyn_bob_electric_cage.bnk") )
					{
						theSound.SoundLoadBank( "amb_dyn_bob_electric_cage.bnk", false );
					}

					if (ACS_Is_DLC_Installed('dlcquen')
					|| ACS_Armor_Set_Check('acs_armor', false)
					|| ACS_Armor_Set_Check('wh_armor', false)
					|| ACS_Armor_Set_Check('eredin_armor', false)
					|| ACS_Armor_Set_Check('imlerith_armor', false)
					|| ACS_Armor_Set_Check('caranthir_armor', false)
					|| ACS_Armor_Set_Check('vgx_eredin_armor', false)
					)
					{
						if (!ACSGetCEntity('ACS_Sign_Icon').IsEffectActive('electric_stream_blue', false))
						{
							ACSGetCEntity('ACS_Sign_Icon').SoundEvent("magic_sorceress_vfx_lightning_bolt");

							ACSGetCEntity('ACS_Sign_Icon').SoundEvent("amb_dyn_bob_electric_cage_fx_start");

							ACSGetCEntity('ACS_Sign_Icon').PlayEffectSingle('electric_stream_blue');
						}
					}
					else
					{
						if (!ACSGetCEntity('ACS_Sign_Icon').IsEffectActive('electric_stream_normal', false))
						{
							ACSGetCEntity('ACS_Sign_Icon').SoundEvent("magic_sorceress_vfx_lightning_bolt");

							ACSGetCEntity('ACS_Sign_Icon').SoundEvent("amb_dyn_bob_electric_cage_fx_start");

							ACSGetCEntity('ACS_Sign_Icon').PlayEffectSingle('electric_stream_normal');
						}
					}
				}
				else
				{
					if (ACSGetCEntity('ACS_Sign_Icon').IsEffectActive('electric_stream_normal', false))
					{
						ACSGetCEntity('ACS_Sign_Icon').SoundEvent("magic_sorceress_vfx_lightning_fx_loop_stop");

						ACSGetCEntity('ACS_Sign_Icon').SoundEvent("amb_dyn_bob_electric_cage_fx_stop");

						ACSGetCEntity('ACS_Sign_Icon').StopEffect('electric_stream_normal');
					}

					if (ACSGetCEntity('ACS_Sign_Icon').IsEffectActive('electric_stream_blue', false))
					{
						ACSGetCEntity('ACS_Sign_Icon').SoundEvent("magic_sorceress_vfx_lightning_fx_loop_stop");

						ACSGetCEntity('ACS_Sign_Icon').SoundEvent("amb_dyn_bob_electric_cage_fx_stop");

						ACSGetCEntity('ACS_Sign_Icon').StopEffect('electric_stream_blue');
					}
				}

				return;
			}
			else
			{
				if (ACSGetCEntity('ACS_Sign_Icon'))
				{
					ACSGetCEntity('ACS_Sign_Icon').StopEffect('burn');
					ACSGetCEntity('ACS_Sign_Icon').StopEffect('burn_upgrade');
					ACSGetCEntity('ACS_Sign_Icon').StopEffect('burn_1');
					ACSGetCEntity('ACS_Sign_Icon').StopEffect('burn_upgrade_1');

					ACSGetCEntity('ACS_Sign_Icon').StopEffect('burn_red');
					ACSGetCEntity('ACS_Sign_Icon').StopEffect('burn_upgrade_red');
					ACSGetCEntity('ACS_Sign_Icon').StopEffect('burn_1_red');
					ACSGetCEntity('ACS_Sign_Icon').StopEffect('burn_upgrade_1_red');

					if (ACSGetCEntity('ACS_Sign_Icon').IsEffectActive('electric_stream_normal', false))
					{
						ACSGetCEntity('ACS_Sign_Icon').SoundEvent("magic_sorceress_vfx_lightning_fx_loop_stop");

						ACSGetCEntity('ACS_Sign_Icon').SoundEvent("amb_dyn_bob_electric_cage_fx_stop");

						ACSGetCEntity('ACS_Sign_Icon').StopEffect('electric_stream_normal');
					}

					if (ACSGetCEntity('ACS_Sign_Icon').IsEffectActive('electric_stream_blue', false))
					{
						ACSGetCEntity('ACS_Sign_Icon').SoundEvent("magic_sorceress_vfx_lightning_fx_loop_stop");

						ACSGetCEntity('ACS_Sign_Icon').SoundEvent("amb_dyn_bob_electric_cage_fx_stop");

						ACSGetCEntity('ACS_Sign_Icon').StopEffect('electric_stream_blue');
					}
				}
			}
		}
	}

	function AzkarBowCreate()
	{
		var sword1 : CEntity;
		var attach_rot : EulerAngles;
		var attach_vec : Vector;

		ACS_WeaponDestroyInit();

		sword1 = (CEntity)theGame.CreateEntity((CEntityTemplate)LoadResource( 

		"dlc\dlc_acs\data\entities\ranged\bow_azkar.w2ent" 
			
		, true), GetWitcherPlayer().GetWorldPosition() );
			
		attach_rot.Roll = 0;
		attach_rot.Pitch = 0;
		attach_rot.Yaw = 30;
		attach_vec.X = 0;
		attach_vec.Y = -0.025;
		attach_vec.Z = -0.045;

		sword1.CreateAttachment( GetWitcherPlayer(), 'r_weapon', attach_vec, attach_rot );
		sword1.AddTag('acs_bow');
		sword1.PlayEffect('ghost_06');

		AzkarFXCreate();
	}

	function AzkarFXCreate()
	{
		var vfxEnt1 		: CEntity;
		var attach_rot 		: EulerAngles;
		var attach_vec 		: Vector;
		var eff_names		: array<CName>;

		vfxEnt1 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

		"dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent"
		
		, true ), GetWitcherPlayer().GetWorldPosition() );

		vfxEnt1.CreateAttachment( GetWitcherPlayer(), 'r_weapon' );

		eff_names.Clear();

		eff_names.PushBack('diagonal_up_left_wraith');
		eff_names.PushBack('diagonal_down_left_wraith');
		eff_names.PushBack('down_wraith');
		eff_names.PushBack('up_wraith');
		eff_names.PushBack('diagonal_up_right_wraith');
		eff_names.PushBack('diagonal_down_right_wraith');
		eff_names.PushBack('right_wraith');
		eff_names.PushBack('left_wraith');
		
		vfxEnt1.PlayEffectSingle(eff_names[RandRange(eff_names.Size())]);

		vfxEnt1.DestroyAfter(2);
	}

	function SlayerShotgunCreate()
	{
		var sword1 : CEntity;
		var attach_rot : EulerAngles;
		var attach_vec : Vector;

		ACS_WeaponDestroyInit();

		sword1 = (CEntity)theGame.CreateEntity((CEntityTemplate)LoadResource( 
		
		//"dlc\dlc_acs\data\entities\ranged\acs_wolf_crossbow_fake.w2ent"

		"dlc\dlc_acs\data\entities\ranged\shotgun_1.w2ent" 
			
		, true), GetWitcherPlayer().GetWorldPosition() );
			
		attach_rot.Roll = 0;
		attach_rot.Pitch = 0;
		attach_rot.Yaw = 180;
		attach_vec.X = -0.15; // + forward - backward
		attach_vec.Y = 0; // + left - right
		attach_vec.Z = 0; // + up - down

		theSound.SoundEvent("doom_shotgun_load_orig_acs");

		thePlayer.RaiseEvent('ACS_ShotgunDraw_01');

		GetWitcherPlayer().AddAndEquipInfiniteBolt(true);
		GetWitcherPlayer().ClearPreviouslyUsedBolt();	
				

		sword1.CreateAttachment( GetWitcherPlayer(), 'r_weapon', attach_vec, attach_rot );
		sword1.AddTag('acs_crossbow');
	}

	function ShotgunPositioningSwitch( shotgun_state_check : name )
	{
		var attach_rot 						: EulerAngles;
		var attach_vec 						: Vector;

		if (ACSGetCEntity('acs_crossbow'))
		{
			if (shotgun_state_check == 'in_combat')
			{
				if (shotgun_combat_inactive)
				{
					attach_rot.Roll = 0;
					attach_rot.Pitch = 0;
					attach_rot.Yaw = 180;
					attach_vec.X = -0.15; // + forward - backward
					attach_vec.Y = 0; // + left - right
					attach_vec.Z = 0; // + up - down

					ACSGetCEntity('acs_crossbow').BreakAttachment();
						
					ACSGetCEntity('acs_crossbow').CreateAttachment( GetWitcherPlayer(), 'r_weapon', attach_vec, attach_rot );

					shotgun_combat_inactive = false;
				}
			}
			else if (shotgun_state_check == 'out_of_combat')
			{
				if (!shotgun_combat_inactive)
				{
					thePlayer.RaiseEvent('ACS_ShotgunAnimReset');

					attach_rot.Roll = 90;
					attach_rot.Pitch = 0;
					attach_rot.Yaw = 180;
					attach_vec.X = 0; // + forward - backward
					attach_vec.Y = 0; // + left - right
					attach_vec.Z = -0.1; // + up - down

					ACSGetCEntity('acs_crossbow').BreakAttachment();
						
					ACSGetCEntity('acs_crossbow').CreateAttachment( GetWitcherPlayer(), 'r_weapon', attach_vec, attach_rot );

					shotgun_combat_inactive = true;
				}
			}
		}
	}

	var shotgun_combat_inactive : bool;

	function BowAndCrossbowCheck()
	{
		var itemId							: SItemUniqueId;	
		var bolt 							: W3BoltProjectile;

		itemId = thePlayer.GetSelectedItemId();

		if ( GetWitcherPlayer().IsItemEquippedByName('ACS_Azkar')
		&& thePlayer.GetInventory().GetItemName( itemId ) == 'ACS_Azkar' 
		)
		{
			if (FactsQuerySum("ACS_Azkar_Active") > 0)
			{
				if (!ACSGetCEntity('acs_bow')
				&& thePlayer.IsAnyWeaponHeld()
				&& !thePlayer.IsWeaponHeld('fist')
				)
				{
					AzkarBowCreate();
				}

				if ( FactsQuerySum("ACS_Bow_Quiver_Loaded") <= 0 )
				{
					BowQuiverLoad();

					FactsAdd("ACS_Bow_Quiver_Loaded", 1, -1);
				}

				if ( 
				(GetWitcherPlayer().IsInGuardedState()
				|| GetWitcherPlayer().IsGuarded())
				)
				{
					if ( 
					!thePlayer.IsCastingSign()
					&& !ACS_Cast_Sign_Process
					&& !thePlayer.GetIsSprinting()
					&& !thePlayer.GetIsRunning()
					&& thePlayer.IsActionAllowed(EIAB_Parry)
					&& FactsQuerySum("ACS_Azkar_Aiming") <= 0
					)
					{
						thePlayer.SetSprintActionPressed( false );
						thePlayer.SetSprintToggle( false );
						thePlayer.SetWalkToggle( true );

						ACS_RangedWeaponSwitch();

						ACS_BowHandSwitch(false);
						
						thePlayer.SetGuarded(true);
						thePlayer.OnPerformGuard();

						bolt = (W3BoltProjectile)theGame.GetEntityByTag( 'ACS_Bow_Arrow' );

						thePlayer.playerAiming.StartAiming( bolt );


						BowShowCrosshair(true);

						AddTimer('BowRotateTowardsCamera', 0.0001f , true );

						vACS_Arrow_Create = new cACS_Arrow_Create in this; 

						vACS_Arrow_Create.ACS_Arrow_Create_Engage(); 

						thePlayer.BlockAction( EIAB_Crossbow, 			'acs_azkar_aiming');
						thePlayer.BlockAction( EIAB_CallHorse,			'acs_azkar_aiming');
						thePlayer.BlockAction( EIAB_Signs, 				'acs_azkar_aiming');
						thePlayer.BlockAction( EIAB_DrawWeapon, 			'acs_azkar_aiming');
						thePlayer.BlockAction( EIAB_FastTravel, 			'acs_azkar_aiming');
						thePlayer.BlockAction( EIAB_Fists, 				'acs_azkar_aiming');
						thePlayer.BlockAction( EIAB_InteractionAction, 	'acs_azkar_aiming');
						thePlayer.BlockAction( EIAB_UsableItem,			'acs_azkar_aiming');
						thePlayer.BlockAction( EIAB_ThrowBomb,			'acs_azkar_aiming');
						//thePlayer.BlockAction( EIAB_SwordAttack,			'acs_azkar_aiming');
						//thePlayer.BlockAction( EIAB_LightAttacks,			'acs_azkar_aiming');
						//thePlayer.BlockAction( EIAB_HeavyAttacks,			'acs_azkar_aiming');
						thePlayer.BlockAction( EIAB_SpecialAttackLight,	'acs_azkar_aiming');
						thePlayer.BlockAction( EIAB_SpecialAttackHeavy,	'acs_azkar_aiming');
						thePlayer.BlockAction( EIAB_Dodge,				'acs_azkar_aiming');
						thePlayer.BlockAction( EIAB_Roll,					'acs_azkar_aiming');
						//thePlayer.BlockAction( EIAB_Parry,				'acs_azkar_aiming');
						thePlayer.BlockAction( EIAB_MeditationWaiting,	'acs_azkar_aiming');
						thePlayer.BlockAction( EIAB_OpenMeditation,		'acs_azkar_aiming');
						thePlayer.BlockAction( EIAB_RadialMenu,			'acs_azkar_aiming');
						//thePlayer.BlockAction( EIAB_Movement,				'acs_azkar_aiming');
						thePlayer.BlockAction( EIAB_Interactions, 		'acs_azkar_aiming');
						thePlayer.BlockAction( EIAB_Jump, 				'acs_azkar_aiming');
						thePlayer.BlockAction( EIAB_QuickSlots, 			'acs_azkar_aiming');
						thePlayer.BlockAction( EIAB_OpenFastMenu, 		'acs_azkar_aiming');
						thePlayer.BlockAction( EIAB_OpenInventory,		'acs_azkar_aiming');
						thePlayer.BlockAction( EIAB_OpenPreparation, 		'acs_azkar_aiming');
						thePlayer.BlockAction( EIAB_OpenMap, 				'acs_azkar_aiming');
						thePlayer.BlockAction( EIAB_OpenCharacterPanel, 	'acs_azkar_aiming');
						thePlayer.BlockAction( EIAB_OpenJournal, 			'acs_azkar_aiming');
						thePlayer.BlockAction( EIAB_OpenAlchemy, 			'acs_azkar_aiming');
						thePlayer.BlockAction( EIAB_OpenGlossary,			'acs_azkar_aiming');

						FactsAdd("ACS_Azkar_Aiming", 1, -1);
					}
				}
				else
				{
					if (FactsQuerySum("ACS_Azkar_Aiming") > 0)
					{
						thePlayer.SetGuarded(false);

						thePlayer.playerAiming.StopAiming();

						BowShowCrosshair(false);

						RemoveTimer('BowRotateTowardsCamera');

						GetACSStorage().acs_deleteOnelinerByTag("ACS_Bow_Aiming_Target");

						ACSGetCEntity('acs_bow').GetRootAnimatedComponent().PlaySkeletalAnimationAsync( 'man_npc_bow_switch_bow_to_sword' );

						thePlayer.UnblockAction( EIAB_Crossbow, 			'acs_azkar_aiming');
						thePlayer.UnblockAction( EIAB_CallHorse,			'acs_azkar_aiming');
						thePlayer.UnblockAction( EIAB_Signs, 				'acs_azkar_aiming');
						thePlayer.UnblockAction( EIAB_DrawWeapon, 			'acs_azkar_aiming');
						thePlayer.UnblockAction( EIAB_FastTravel, 			'acs_azkar_aiming');
						thePlayer.UnblockAction( EIAB_Fists, 				'acs_azkar_aiming');
						thePlayer.UnblockAction( EIAB_InteractionAction, 	'acs_azkar_aiming');
						thePlayer.UnblockAction( EIAB_UsableItem,			'acs_azkar_aiming');
						thePlayer.UnblockAction( EIAB_ThrowBomb,			'acs_azkar_aiming');
						thePlayer.UnblockAction( EIAB_SwordAttack,			'acs_azkar_aiming');
						thePlayer.UnblockAction( EIAB_LightAttacks,			'acs_azkar_aiming');
						thePlayer.UnblockAction( EIAB_HeavyAttacks,			'acs_azkar_aiming');
						thePlayer.UnblockAction( EIAB_SpecialAttackLight,	'acs_azkar_aiming');
						thePlayer.UnblockAction( EIAB_SpecialAttackHeavy,	'acs_azkar_aiming');
						thePlayer.UnblockAction( EIAB_Dodge,				'acs_azkar_aiming');
						thePlayer.UnblockAction( EIAB_Roll,					'acs_azkar_aiming');
						thePlayer.UnblockAction( EIAB_Parry,				'acs_azkar_aiming');
						thePlayer.UnblockAction( EIAB_MeditationWaiting,	'acs_azkar_aiming');
						thePlayer.UnblockAction( EIAB_OpenMeditation,		'acs_azkar_aiming');
						thePlayer.UnblockAction( EIAB_RadialMenu,			'acs_azkar_aiming');
						thePlayer.UnblockAction( EIAB_Movement,				'acs_azkar_aiming');
						thePlayer.UnblockAction( EIAB_Interactions, 		'acs_azkar_aiming');
						thePlayer.UnblockAction( EIAB_Jump, 				'acs_azkar_aiming');
						thePlayer.UnblockAction( EIAB_QuickSlots, 			'acs_azkar_aiming');
						thePlayer.UnblockAction( EIAB_OpenFastMenu, 		'acs_azkar_aiming');
						thePlayer.UnblockAction( EIAB_OpenInventory,		'acs_azkar_aiming');
						thePlayer.UnblockAction( EIAB_OpenPreparation, 		'acs_azkar_aiming');
						thePlayer.UnblockAction( EIAB_OpenMap, 				'acs_azkar_aiming');
						thePlayer.UnblockAction( EIAB_OpenCharacterPanel, 	'acs_azkar_aiming');
						thePlayer.UnblockAction( EIAB_OpenJournal, 			'acs_azkar_aiming');
						thePlayer.UnblockAction( EIAB_OpenAlchemy, 			'acs_azkar_aiming');
						thePlayer.UnblockAction( EIAB_OpenGlossary,			'acs_azkar_aiming');

						FactsRemove("ACS_Azkar_Aiming");
					}
				}

				if (!ACS_CombatToExplorationCheck()
				|| thePlayer.IsInCombat()
				|| thePlayer.IsThreatened()
				)
				{
					if (thePlayer.IsCurrentlyDodging()
					|| thePlayer.HasTag('ACS_Is_Currently_Dodging')
					|| thePlayer.IsCastingSign()
					|| ACS_Cast_Sign_Process
					|| thePlayer.GetIsSprinting()
					|| thePlayer.GetIsRunning()
					)
					{
						if ( FactsQuerySum("ACS_Bow_Hide_And_Switch") <= 0 )
						{
							ACS_BowHandSwitch(true);

							ACS_BowArrowDestroy();

							FactsAdd("ACS_Bow_Hide_And_Switch", 1, -1);
						}
					}
					else
					{
						if ( FactsQuerySum("ACS_Bow_Hide_And_Switch") > 0 )
						{
							if (thePlayer.GetPlayerCombatStance() != PCS_Normal)
							{
								ACS_BowHandSwitch(false);
							}

							FactsRemove("ACS_Bow_Hide_And_Switch");
						}
					}
				}
				else
				{
					if ( FactsQuerySum("ACS_Bow_Hide_And_Switch") <= 0 )
					{
						ACS_BowHandSwitch(true);

						ACS_BowArrowDestroy();

						FactsAdd("ACS_Bow_Hide_And_Switch", 1, -1);
					}
				}
			}
			else
			{
				if ( FactsQuerySum("ACS_Bow_Hide_And_Switch") > 0 )
				{
					FactsRemove("ACS_Bow_Hide_And_Switch");
				}

				if ( FactsQuerySum("ACS_Bow_Quiver_Loaded") > 0 )
				{
					BowQuiverUnload();

					FactsRemove("ACS_Bow_Quiver_Loaded");
				}

				if (ACSGetCEntity('acs_bow'))
				{
					AzkarFXCreate();

					ACSGetCEntity('acs_bow').BreakAttachment(); 
					ACSGetCEntity('acs_bow').Teleport( GetWitcherPlayer().GetWorldPosition() + Vector( 0, 0, -200 ) );
					ACSGetCEntity('acs_bow').DestroyAfter(0.00125);
					ACSGetCEntity('acs_bow').RemoveTag('acs_bow');

					DefaultSwitch();
				}

				ACS_BowArrowDestroy();

				if (FactsQuerySum("ACS_Azkar_Aiming") > 0)
				{

	////////////////////////////////////////////////////////////////////////////////////////

	private var fastTravelCamera 						: ACSFastTravelCamera;

	public function SetFastTravelCamera( a : ACSFastTravelCamera )
	{
		this.fastTravelCamera = a;
	}

	public function GetFastTravelCamera() : ACSFastTravelCamera
	{
		return this.fastTravelCamera;
	}

	public var fastTravelPinTag : name;
	public var fastTravelposition : Vector;
	public var fastTravelrotation : EulerAngles;

	public var fast_travel_is_local : bool;

	function FastTravelCameraStart(destinationPinTag : name, position : Vector, rotation : EulerAngles)
	{
		var hud : CR4ScriptedHud;
		var inGameConfigWrapper	: CInGameConfigWrapper;
		var newValue : bool;
	
		hud = (CR4ScriptedHud)theGame.GetHud();

		if (FactsQuerySum("ACS_Fast_Travel_Initiated") <= 0)
		{
			FactsAdd("ACS_Fast_Travel_Initiated", 1, -1);
		}

		fast_travel_is_local = true;

		fastTravelPinTag = destinationPinTag;

		fastTravelposition = position;

		fastTravelrotation = rotation;

		inGameConfigWrapper = (CInGameConfigWrapper)theGame.GetInGameConfigWrapper();

		newValue = inGameConfigWrapper.GetVarValue( 'Hud', 'HudVisibility' );
	
		if ( hud && newValue)
		{
			hud.ForceShow( false, HVS_System );
		}
	}

	public var globalFastTravelWorldPath : string;
	public var globalFastTravelposition : Vector;
	public var globalFastTravelrotation : EulerAngles;
	public var globalFastTravelPinName : name;
	public var globalGetTravelPointPosition : bool;

	function GlobalFastTravelCameraStart(worldPath : string, optional position : Vector, optional rotation : EulerAngles, optional mapPinName : name, optional get_travel_point_position : bool )
	{
		var hud : CR4ScriptedHud;
		var inGameConfigWrapper	: CInGameConfigWrapper;
		var newValue : bool;
	
		hud = (CR4ScriptedHud)theGame.GetHud();

		if (FactsQuerySum("ACS_Fast_Travel_Initiated") <= 0)
		{
			FactsAdd("ACS_Fast_Travel_Initiated", 1, -1);
		}

		fast_travel_is_local = false;

		globalFastTravelWorldPath = worldPath;

		globalFastTravelposition = position;

		globalFastTravelrotation = rotation;

		globalFastTravelPinName = mapPinName;

		globalGetTravelPointPosition = get_travel_point_position;

		inGameConfigWrapper = (CInGameConfigWrapper)theGame.GetInGameConfigWrapper();

		newValue = inGameConfigWrapper.GetVarValue( 'Hud', 'HudVisibility' );
	
		if ( hud && newValue)
		{
			hud.ForceShow( false, HVS_System );
		}
	}

	function FastTravelCameraStartDelay()
	{
		var template	: CEntityTemplate;
		var ent			: CEntity;

		if( 
		!theGame.IsDialogOrCutscenePlaying() 
		&& thePlayer.IsAlive()
		&& !thePlayer.IsInCutsceneIntro()
		&& !theGame.HasBlackscreenRequested()
		&& !theGame.IsCurrentlyPlayingNonGameplayScene()
		&& !theGame.GetGuiManager().IsAnyMenu()
		&& !theGame.GetTutorialSystem().HasActiveTutorial()
		&& !theGame.GetPhotomodeEnabled() 
		&& !theGame.IsFading()
		&& !theGame.IsBlackscreen()
		&& FactsQuerySum("ACS_Fast_Travel_Initiated") > 0
		)
		{
			if (!ACSGetCEntity('ACS_Fast_Travel_Camera'))
			{
				CamerasDestroy();

				template = (CEntityTemplate)LoadResource("dlc\dlc_acs\data\entities\other\acs_fast_travel_camera.w2ent", true);

				ent = (CStaticCamera)theGame.CreateEntity(template, theCamera.GetCameraPosition(), theCamera.GetCameraRotation());	

				ent.AddTag('ACS_Fast_Travel_Camera');
			}

			theGame.GetGameCamera().EnableManualControl( false );

			FactsRemove("ACS_Fast_Travel_Initiated");
		}
	}


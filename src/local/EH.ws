				switch ( combo_counter_sorc_attack_heavy )
				{
					default:
					if (RandF() < 0.5)
					{
						PlayerPlayAnimation( 'woman_sorceress_attack_rock_rhand_rp_ACS');

						sorcfxspawn('ACS_Sorc_Fire_Line_Right');
					}
					else
					{
						PlayerPlayAnimation( 'woman_sorceress_attack_rock_rhand_lp_ACS');

						sorcfxspawn('ACS_Sorc_Frost_Line_Right');
					}

					combo_counter_damage -= combo_counter_damage;

					combo_counter_sorc_attack_heavy += 1;
					break;

					case 0:
					PlayerPlayAnimation( 'woman_sorceress_special_attack_fireball_rp_ACS');	

					sorcfxspawn('ACS_Sorc_Fire_Blast');

					combo_counter_damage += 1;

					combo_counter_sorc_attack_heavy += 1;
					break;

					case 1:
					PlayerPlayAnimation( 'woman_sorceress_special_attack_electricity_rp_ACS');	

					sorcfxspawn('ACS_Sorc_Lightning_Chain');

					combo_counter_damage += 1;

					combo_counter_sorc_attack_heavy += 1;
					break;

					case 2:
					PlayerPlayAnimation( 'woman_sorceress_special_attack_fireball_lp_ACS');	

					sorcfxspawn('ACS_Sorc_Lightning_Strike');

					combo_counter_damage += 1;

					combo_counter_sorc_attack_heavy += 1;
					break;

					case 3:
					PlayerPlayAnimation( 'woman_sorceress_special_attack_electricity_lp_ACS');	

					sorcfxspawn('ACS_Sorc_Lightning_Strike_Mult');

					combo_counter_damage += 1;

					combo_counter_sorc_attack_heavy += 1;
					break;

					case 4:
					if (RandF() < 0.5)
					{
						PlayerPlayAnimation( 'woman_sorceress_rip_apart_kill_rp_ACS');	
					}
					else
					{
						PlayerPlayAnimation( 'woman_sorceress_rip_apart_kill_lp_ACS');	
					}

					sorcfxspawn('ACS_Sorc_Lightning_Storm');

					combo_counter_damage += 1;

					combo_counter_sorc_attack_heavy += 1;
					break;


					case 5: 
					if (RandF() < 0.5)
					{
						PlayerPlayAnimation( 'woman_sorceress_attack_rock_rhand_rp_ACS');

						sorcfxspawn('ACS_Sorc_Fire_Line_Right');
					}
					else
					{
						PlayerPlayAnimation( 'woman_sorceress_attack_rock_rhand_lp_ACS');

						sorcfxspawn('ACS_Sorc_Frost_Line_Right');
					}

					combo_counter_damage -= combo_counter_damage;

					combo_counter_sorc_attack_heavy += 1;

	timer function GetACSGuidingLightPOIMarker_EffectStopDelay( time : float , id : int )
	{
		RemoveTimer('GetACSGuidingLightPOIMarker_EffectStoppingDelay');

		ACSGetCEntity('ACS_Guiding_Light_POI_Marker').StopEffect('poi_marker_smaller');
		ACSGetCEntity('ACS_Guiding_Light_POI_Marker').StopEffect('poi_marker_small');
		ACSGetCEntity('ACS_Guiding_Light_POI_Marker').StopEffect('poi_marker');
		ACSGetCEntity('ACS_Guiding_Light_POI_Marker').StopEffect('poi_marker_bigger');
		ACSGetCEntity('ACS_Guiding_Light_POI_Marker').StopEffect('poi_marker_biggest');
		ACSGetCEntity('ACS_Guiding_Light_POI_Marker').StopEffect('poi_marker_biggest_x2');
		ACSGetCEntity('ACS_Guiding_Light_POI_Marker').StopEffect('poi_marker_biggest_x4');

		poiMarkerFadeOut = 100;
		RemoveTimer('poiMarkerFadeOut');
		AddTimer('poiMarkerFadeOut', 0.01 , true);
	
		GetACSStorage().acs_deleteOnelinerByTag("ACS_POI_Distance_GUI_Marker");

		if (ACS_Guiding_Light_POI_Marker_Distance_Available)
		{
			ACS_Guiding_Light_POI_Marker_Distance_Available = false;
		}

		if (ACS_Guiding_Light_POI_Marker_Stopped)
		{
			ACS_Guiding_Light_POI_Marker_Stopped = false;
		}
	}

	////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	function ACS_Guiding_Light_Available_Quest_Marker_Distance_Actual()
	{
		var iconPath, zPositioning				: string;
		var playerPosition, markerPosition 		: Vector;
		var distance 							: float;

		GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Available_Quest_Distance_GUI_Marker", 100);

		GetACSStorage().acs_deleteOnelinerByTag("ACS_Available_Quest_Distance_GUI_Marker");

		if (!ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker'))
		{
			return;
		}

		playerPosition = thePlayer.GetWorldPosition();

		markerPosition = ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').GetWorldPosition();

		distance = VecDistance(playerPosition, markerPosition);

		if ((AbsF(playerPosition.Z - markerPosition.Z) <= 4)
		|| distance >= 50
		)
		{
			zPositioning = "";
		}
		else
		{
			if (playerPosition.Z > markerPosition.Z)
			{
				zPositioning = " - " + "[" + GetLocStringByKeyExt("fake_key_z98k3yl8") + "]";
			}
			else if (playerPosition.Z < markerPosition.Z)
			{
				zPositioning = " - " + "[" + GetLocStringByKeyExt("fake_key_dk0zqae") + "]";
			}
			else
			{
				zPositioning = "";
			}
		}

		if (distance <= 4.5 )
		{
			iconPath = "<br/><br/>" + "<font size = '16' color = '#91823f'>" + "[" + GetLocStringByKeyExt("fake_key_1h78y_j") + "]" + zPositioning + "</font>";
		}
		else
		{
			iconPath = "<br/><br/>" + "<font size = '16' color = '#91823f'>" + "[" + FloatToStringPrec(distance, 0) + "m" + "]" + zPositioning + "</font>";
		}

		ACS_Oneliner(iconPath, ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker'), "ACS_Available_Quest_Distance_GUI_Marker");

		GetACSStorage().acs_setScaleForOnelinerByTag("ACS_Available_Quest_Distance_GUI_Marker", 100, 100, 100);

		GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Available_Quest_Distance_GUI_Marker", 100);
	}

	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	private var availableQuestMarkerFadeOut : float;
	default availableQuestMarkerFadeOut = 100;

	timer function availableQuestMarkerFadeOut(dt : float , id : int)
	{	
		GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Available_Quest_GUI_Marker", availableQuestMarkerFadeOut);

		if (availableQuestMarkerFadeOut <= 0)
		{
			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Available_Quest_GUI_Marker", 100);

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Available_Quest_GUI_Marker");

			if (ACS_Guiding_Light_Available_Quest_Marker_Distance_Available)
			{
				ACS_Guiding_Light_Available_Quest_Marker_Distance_Available = false;
			}

			ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').Destroy();

			availableQuestMarkerFadeOut = 100;

			RemoveTimer('availableQuestMarkerFadeOut');
		}
		else
		{
			availableQuestMarkerFadeOut -= 1;
		}
	}

	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	var ACS_Guiding_Light_Available_Quest_Marker_Stopping : bool;

	var ACS_Guiding_Light_Available_Quest_Marker_Stopped : bool;

	var guiding_light_available_quest_position			: Vector;

	function Guiding_Light_Available_Quest_Scan()
	{
		var position							: Vector;
		var rot, newRot          				: EulerAngles;
		var ent									: CEntity;
		var temp								: CEntityTemplate;
		var targetDistance						: float;
		var mappins								: array<SCommonMapPinInstance>;
		var size 								: int;
		var compass_check 						: bool;

		if ( theGame.IsDialogOrCutscenePlaying() 
		|| theGame.IsFading()
		|| theGame.IsBlackscreen()
		|| theGame.IsPaused() 
		|| theGame.GetPhotomodeEnabled() 
		|| thePlayer.IsInCutsceneIntro() 
		|| !ACS_GetClosestAvailableQuestPointPosition(guiding_light_available_quest_position)
		|| ACS_Settings_Main_Float('acs_hud_settings_markers','acs_untracked_quest_marker_despawn_delay', 7) == 0
		|| theGame.GetJournalManager().GetTrackedQuest().baseName == "ACS Exploration"
		)
		{
			if(ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker'))
			{
				if (ACS_Guiding_Light_Available_Quest_Marker_Stopping)
				{
					ACS_Guiding_Light_Available_Quest_Marker_Stopping = false;
				}

				if (ACS_Guiding_Light_Available_Quest_Marker_Stopped)
				{
					ACS_Guiding_Light_Available_Quest_Marker_Stopped = false;
				}

				RemoveTimer('GetACSGuidingLightAvailableQuestMarker_EffectStoppingDelay');

				RemoveTimer('GetACSGuidingLightAvailableQuestMarker_EffectStopDelay');

				availableQuestMarkerFadeOut = 100;
				RemoveTimer('availableQuestMarkerFadeOut');

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Available_Quest_GUI_Marker");

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Available_Quest_Distance_GUI_Marker");

				if (ACS_Guiding_Light_Available_Quest_Marker_Distance_Available)
				{
					ACS_Guiding_Light_Available_Quest_Marker_Distance_Available = false;
				}

				ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').Destroy();
			}

			return;
		}

		targetDistance = VecDistanceSquared2D( GetWitcherPlayer().GetWorldPosition(), ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').GetWorldPosition() ) ;

		rot = thePlayer.GetWorldRotation();

		rot.Pitch += 180;

		rot.Yaw += 180;

		if(!ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker'))
		{
			temp = (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\fx\guiding_light_marker_old.w2ent", true );

			ent = (CEntity)theGame.CreateEntity( temp, guiding_light_available_quest_position, rot );

			ent.AddTag('ACS_Guiding_Light_Available_Quest_Marker');

			ent.AddTag('ACS_HUD_Marker_Entity');

			ent.AddTag('ACS_POI_Trigger_Entity');
		}
		else
		{
			if(RadialMenuCheck()
			|| HudExceptionCheck() 
			|| ACS_GetNearbyEnemyLocation() != Vector(0,0,-200)
			|| ACS_MapPinsCheck()
			|| thePlayer.IsAnyWeaponHeld()
			)
			{
				
					if (ACS_Guiding_Light_Available_Quest_Marker_Stopping)
					{
						ACS_Guiding_Light_Available_Quest_Marker_Stopping = false;
					}

					if (ACS_Guiding_Light_Available_Quest_Marker_Stopped)
					{
						ACS_Guiding_Light_Available_Quest_Marker_Stopped = false;
					}

					ACS_Guiding_Light_Available_Quest_Marker_Distance_Available = true;

					RemoveTimer('GetACSGuidingLightAvailableQuestMarker_EffectStoppingDelay');

					RemoveTimer('GetACSGuidingLightAvailableQuestMarker_EffectStopDelay');

					GetACSStorage().acs_deleteOnelinerByTag("ACS_Available_Quest_GUI_Marker");

					ACS_Oneliner(FormatIconPath("icons/inventory/acs_marker_quest_untracked.xbm"), ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker'), "ACS_Available_Quest_GUI_Marker");

					GetACSStorage().acs_setScaleForOnelinerByTag("ACS_Available_Quest_GUI_Marker", 100, 100, 100);

					GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Available_Quest_GUI_Marker", 100);

					if (ACS_Settings_Main_Bool('acs_hud_settings_markers','acs_marker_bubble_enabled', false))
					{
						if (targetDistance <= 5 * 5)
						{
							ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker_smaller');
							ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker_small');
							ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker');
							ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker_bigger');
							ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker_biggest');
							ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker_biggest_x2');
							ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker_biggest_x4');
						}
						else if (targetDistance > 5 * 5 && targetDistance <= 10 * 10)
						{
							ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker_small');
							ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker');
							ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker_bigger');
							ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker_biggest');
							ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker_biggest_x2');
							ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker_biggest_x4');

							if (!ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').IsEffectActive('secondary_quest_marker_smaller', false))
							{
								ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').PlayEffectSingle('secondary_quest_marker_smaller');
							}
						}
						else if (targetDistance > 10 * 10 && targetDistance <= 25 * 25)
						{
							ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker_smaller');
							ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker');
							ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker_bigger');
							ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker_biggest');
							ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker_biggest_x2');
							ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker_biggest_x4');

							if (!ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').IsEffectActive('secondary_quest_marker_small', false))
							{
								ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').PlayEffectSingle('secondary_quest_marker_small');
							}
						}
						else if (targetDistance > 25 * 25 && targetDistance <= 50 * 50)
						{
							ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker_smaller');
							ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker_small');
							ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker_bigger');
							ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker_biggest');
							ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker_biggest_x2');
							ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker_biggest_x4');

							if (!ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').IsEffectActive('secondary_quest_marker', false))
							{
								ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').PlayEffectSingle('secondary_quest_marker');
							}
						}
						else if (targetDistance > 50 * 50 && targetDistance <= 100 * 100)
						{
							ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker_smaller');
							ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker_small');
							ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker');
							ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker_biggest');
							ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker_biggest_x2');
							ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker_biggest_x4');

							if (!ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').IsEffectActive('secondary_quest_marker_bigger', false))
							{
								ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').PlayEffectSingle('secondary_quest_marker_bigger');
							}
						}
						else if (targetDistance > 100 * 100 )
						{
							ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker_smaller');
							ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker_small');
							ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker');
							ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker_bigger');
							ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker_biggest_x2');
							ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker_biggest_x4');

							if (!ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').IsEffectActive('secondary_quest_marker_biggest', false))
							{
								ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').PlayEffectSingle('secondary_quest_marker_biggest');
							}
						}
					}
				
			}
			else
			{
				if ( !ACS_Guiding_Light_Available_Quest_Marker_Stopping )
				{
					if ( !ACS_Guiding_Light_Available_Quest_Marker_Stopped )
					{
						AddTimer('GetACSGuidingLightAvailableQuestMarker_EffectStoppingDelay', 0.00000000000000000001 , true);

						AddTimer('GetACSGuidingLightAvailableQuestMarker_EffectStopDelay', ACS_Settings_Main_Float('acs_hud_settings_markers','acs_untracked_quest_marker_despawn_delay', 7) , false);

						ACS_Guiding_Light_Available_Quest_Marker_Stopped = true;
					}

					ACS_Guiding_Light_Available_Quest_Marker_Stopping = true;
				}
			}
		}
	}


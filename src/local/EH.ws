						}

						actortarget.SoundEvent("sign_aard_blast");

						signIconEnt = theGame.CreateEntity( (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\fx\sign_icons.w2ent", true ), pos );
						signIconEnt.DestroyAfter(5);

						signIconEnt.PlayEffect('critical_aard');
						signIconEnt.PlayEffect('mutation_2_aard');
						signIconEnt.PlayEffect('mutation_2_aard_b');

						if (actortarget.UsesVitality())
						{

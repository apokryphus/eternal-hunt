	public timer function SmokePipeDelay( time : float , id : int )
	{
		var anim_names						: array<name>;
		var headcComponent 					: array< CComponent >;
			
		headcComponent.Clear();

		headcComponent = thePlayer.GetComponentsByClassName( 'CHeadManagerComponent' );

		anim_names.Clear();

		anim_names.PushBack('geralt_neutral_gesture_whew_face');
		anim_names.PushBack('geralt_neutral_gesture_sniffle_face');
		anim_names.PushBack('geralt_reaction_confidence_face');
		anim_names.PushBack('geralt_neutral_gesture_vodka_face');
		anim_names.PushBack('geralt_neutral_gesture_squint_face');
		anim_names.PushBack('bob_ending_face');

		( ( CHeadManagerComponent ) headcComponent[0] ).MimicTest( anim_names[RandRange(anim_names.Size())] );

		vACS_Create_Instrument = new cACS_Create_Instrument in this;

		vACS_Create_Instrument.Create_Pipe_Engage();

		RemoveTimer('ACS_Pipe_Disappear');
	}


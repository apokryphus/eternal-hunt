				{
					ACSGetCActor('ACS_Transformation_Giant').DestroyEffect('him_smoke');
				}

				if (ACSGetCActor('ACS_Transformation_Giant').IsEffectActive('him_smoke_l'))
				{
					ACSGetCActor('ACS_Transformation_Giant').DestroyEffect('him_smoke_l');

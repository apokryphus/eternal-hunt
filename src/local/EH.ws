				}
				else
				{
					iconPath = "<font size = '16' color = '#b9b9b9'>" + "[" + merchant_name + "]" + "<br/><br/><br/><br/>" + "[" + FloatToStringPrec(distance, 0) + "m" + "]" + zPositioning + "</font>";
				}
			}
			else
			{
				if (distance <= 4.5 )
				{
					iconPath = "<br/><br/>" + "<font size = '16' color = '#b9b9b9'>" + "[" + GetLocStringByKeyExt("fake_key_1h78y_j") + "]" + zPositioning + "</font>";
				}

						ACSTransformationGiantPlayAnim( 'giant_combat_anchor_attack_close_f_2_acs_ice_giant', 0.25f, 0.325f);
						//l_attack
						break;

						case 8:
						ACSTransformationGiantPlayAnim( 'giant_combat_anchor_attack_close_f_1_acs_ice_giant', 0.25f, 0.325f);
						//l_attack
						break;

						case 7:
						ACSTransformationGiantPlayAnim( 'giant_combat_anchor_attack_close_fl_2_acs_ice_giant', 0.25f, 0.325f);
						//kick/stomp
						break;

						case 6:
						ACSTransformationGiantPlayAnim( 'giant_combat_anchor_attack_close_l_2_acs_ice_giant', 0.25f, 0.325f);
						//kick/stomp
						break;

						case 5:
						ACSTransformationGiantPlayAnim( 'giant_combat_anchor_attack_close_bl_2_acs_ice_giant', 0.25f, 0.325f);

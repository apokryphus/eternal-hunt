											)
											{
												ShowSwordStanceNotification(ent,  GetLocStringById(2116581193));

												silver_fast_stance = true;

												vACS_Stance_Switch.ACS_Silver_Fast_Switch_Activate_Engage();
											}
											else if ( !silver_strong_stance 

			case 'dark_clouds_heavy_rain' :
				if (activate)
				{
					DeactivateEnvironment(env2ID, 0);

					env2 = ( CEnvironmentDefinition )LoadResource( 

					"dlc\dlc_acs\data\env\env_dark_clouds_heavy_rain_color.env"
					

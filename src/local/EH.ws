	timer function Storm_Spear_Check (deltaTime : float , id : int)
	{
		if (!thePlayer.HasTag('acs_quen_secondary_sword_equipped'))
		{
			thePlayer.RemoveTag('ACS_Storm_Spear_Active');

			ACSGetCEntityDestroyAll('ACS_Tornado_Effect');

			GetWitcherPlayer().SoundEvent("magic_man_tornado_loop_stop");

			RemoveTimer('Storm_Spear_Check');
		}
	}


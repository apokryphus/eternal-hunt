		ent.AddTag('ACS_Useable_Item');

		AddTimer('UseableItemTeleportDestroy', timeToDestroy , false);
	}

	public timer function UseableItemTeleportDestroy(deltaTime : float , id : int)
	{
		ACSGetCEntity('ACS_Useable_Item').BreakAttachment(); 
		ACSGetCEntity('ACS_Useable_Item').Teleport( GetWitcherPlayer().GetWorldPosition() + Vector( 0, 0, -200 ) );
		ACSGetCEntity('ACS_Useable_Item').DestroyAfter(0.00125);
		ACSGetCEntity('ACS_Useable_Item').RemoveTag('ACS_Useable_Item');
	}

	function PotionOrFoodSwitch(slot : EEquipmentSlots)
	{
		var item 			: SItemUniqueId;
		var headcComponent 	: array< CComponent >;

		GetWitcherPlayer().GetItemEquippedOnSlot( slot, item );

		if (GetWitcherPlayer().inv.IsIdValid(item))
		{
			headcComponent.Clear();

			headcComponent = thePlayer.GetComponentsByClassName( 'CHeadManagerComponent' );

			if (
			(GetWitcherPlayer().inv.GetItemCategory(item) == 'potion' && GetWitcherPlayer().inv.ItemHasTag(item, 'Potion'))
			|| (GetWitcherPlayer().inv.ItemHasTag(item, 'Edibles') && GetWitcherPlayer().inv.ItemHasTag(item, 'Drinks'))
			|| (GetWitcherPlayer().inv.GetItemCategory(item) == 'alchemy_ingredient' && GetWitcherPlayer().inv.ItemHasTag(item, 'StrongAlcohol'))
			)
			{
				( ( CHeadManagerComponent ) headcComponent[0] ).MimicTest( 'geralt_neutral_gesture_chewing_face' );
			}
			else if (
			(GetWitcherPlayer().inv.ItemHasTag(item, 'Edibles') && !GetWitcherPlayer().inv.ItemHasTag(item, 'Drinks'))
			)
			{
				( ( CHeadManagerComponent ) headcComponent[0] ).MimicTest( 'geralt_neutral_gesture_eating_apple_face' );
			}

			if ( !thePlayer.IsHoldingItemInLHand() && !thePlayer.IsCrossbowHeld() ) 
			{
				ResetFastWalk();

				AttachUseableItem(slot);

				if (
				(GetWitcherPlayer().inv.GetItemCategory(item) == 'potion' && GetWitcherPlayer().inv.ItemHasTag(item, 'Potion'))
				|| (GetWitcherPlayer().inv.ItemHasTag(item, 'Edibles') && GetWitcherPlayer().inv.ItemHasTag(item, 'Drinks'))
				|| (GetWitcherPlayer().inv.GetItemCategory(item) == 'alchemy_ingredient' && GetWitcherPlayer().inv.ItemHasTag(item, 'StrongAlcohol'))
				)
				{
					//thePlayer.SetBehaviorVariable( 'SelectedItemL', (int)UI_Horn, true );	

					if (thePlayer.HasTag('ACS_IsSwordWalking'))
					{
						thePlayer.RemoveTag('ACS_IsSwordWalking');
					}

					thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');

					RemoveTimer('CombatTauntDelay');
						
					thePlayer.RaiseEvent('ACS_DrinkPotion');

					if (slot == EES_Potion1)
					{
						AddTimer('Potion1Delay', 1.5 , false);
					}
					else if (slot == EES_Potion2)
					{
						AddTimer('Potion2Delay', 1.5 , false);
					}
					else if (slot == EES_Potion3)
					{
						AddTimer('Potion3Delay', 1.5 , false);
					}
					else if (slot == EES_Potion4)
					{
						AddTimer('Potion4Delay', 1.5 , false);
					}
				}
				else if (
				(GetWitcherPlayer().inv.ItemHasTag(item, 'Edibles') && !GetWitcherPlayer().inv.ItemHasTag(item, 'Drinks'))
				)
				{
					if (thePlayer.HasTag('ACS_IsSwordWalking'))
					{
						thePlayer.RemoveTag('ACS_IsSwordWalking');
					}

					thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');

					RemoveTimer('CombatTauntDelay');
					
					thePlayer.RaiseEvent('ACS_EatEdible');

					if (slot == EES_Potion1)
					{
						AddTimer('Potion1Delay', 1 , false);
					}
					else if (slot == EES_Potion2)
					{
						AddTimer('Potion2Delay', 1 , false);
					}
					else if (slot == EES_Potion3)
					{
						AddTimer('Potion3Delay', 1 , false);
					}
					else if (slot == EES_Potion4)
					{
						AddTimer('Potion4Delay', 1 , false);
					}
				}

				thePlayer.BlockAction( EIAB_UsableItem,				'ACS_Item_Anim_Hack');
				thePlayer.BlockAction( EIAB_Crossbow,				'ACS_Item_Anim_Hack');
				thePlayer.BlockAction( EIAB_CallHorse,				'ACS_Item_Anim_Hack');
				thePlayer.BlockAction( EIAB_InteractionAction, 		'ACS_Item_Anim_Hack');
				thePlayer.BlockAction( EIAB_Interactions, 			'ACS_Item_Anim_Hack');
				thePlayer.BlockAction( EIAB_InteractionContainers,  'ACS_Item_Anim_Hack');

				potionaniminprogress = true;
			}
		}
	}

	function PotionOrFoodSwitchController(slot : EEquipmentSlots)
	{
		var item 			: SItemUniqueId;
		var headcComponent 	: array< CComponent >;

		GetWitcherPlayer().GetItemEquippedOnSlot( slot, item );

		if (GetWitcherPlayer().inv.IsIdValid(item))
		{
			headcComponent.Clear();

			headcComponent = thePlayer.GetComponentsByClassName( 'CHeadManagerComponent' );

			if (
			(GetWitcherPlayer().inv.GetItemCategory(item) == 'potion' && GetWitcherPlayer().inv.ItemHasTag(item, 'Potion'))
			|| (GetWitcherPlayer().inv.ItemHasTag(item, 'Edibles') && GetWitcherPlayer().inv.ItemHasTag(item, 'Drinks'))
			|| (GetWitcherPlayer().inv.GetItemCategory(item) == 'alchemy_ingredient' && GetWitcherPlayer().inv.ItemHasTag(item, 'StrongAlcohol'))
			)
			{
				( ( CHeadManagerComponent ) headcComponent[0] ).MimicTest( 'geralt_neutral_gesture_chewing_face' );
			}
			else if (
			(GetWitcherPlayer().inv.ItemHasTag(item, 'Edibles') && !GetWitcherPlayer().inv.ItemHasTag(item, 'Drinks'))
			)
			{
				( ( CHeadManagerComponent ) headcComponent[0] ).MimicTest( 'geralt_neutral_gesture_eating_apple_face' );
			}

			if ( !thePlayer.IsHoldingItemInLHand() && !thePlayer.IsCrossbowHeld() ) 
			{
				ResetFastWalk();
				
				AttachUseableItem(slot);

				if (
				(GetWitcherPlayer().inv.GetItemCategory(item) == 'potion' && GetWitcherPlayer().inv.ItemHasTag(item, 'Potion'))
				|| (GetWitcherPlayer().inv.ItemHasTag(item, 'Edibles') && GetWitcherPlayer().inv.ItemHasTag(item, 'Drinks'))
				|| (GetWitcherPlayer().inv.GetItemCategory(item) == 'alchemy_ingredient' && GetWitcherPlayer().inv.ItemHasTag(item, 'StrongAlcohol'))
				)
				{
					//thePlayer.SetBehaviorVariable( 'SelectedItemL', (int)UI_Horn, true );	

					if (thePlayer.HasTag('ACS_IsSwordWalking'))
					{
						thePlayer.RemoveTag('ACS_IsSwordWalking');
					}

					thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');

					RemoveTimer('CombatTauntDelay');
					
					thePlayer.RaiseEvent('ACS_DrinkPotion');

					if (slot == GetWitcherPlayer().GetSelectedPotionSlotUpper())
					{
						AddTimer('PotionSlotUpperDelay', 1.5 , false);
					}
					else if (slot == GetWitcherPlayer().GetSelectedPotionSlotLower())
					{
						AddTimer('PotionSlotLowerDelay', 1.5 , false);
					}
				}
				else if (
				(GetWitcherPlayer().inv.ItemHasTag(item, 'Edibles') && !GetWitcherPlayer().inv.ItemHasTag(item, 'Drinks'))
				)
				{
					if (thePlayer.HasTag('ACS_IsSwordWalking'))
					{
						thePlayer.RemoveTag('ACS_IsSwordWalking');
					}

					thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');

					RemoveTimer('CombatTauntDelay');
					
					thePlayer.RaiseEvent('ACS_EatEdible');

					if (slot == GetWitcherPlayer().GetSelectedPotionSlotUpper())
					{
						AddTimer('PotionSlotUpperDelay', 1 , false);
					}
					else if (slot == GetWitcherPlayer().GetSelectedPotionSlotLower())
					{
						AddTimer('PotionSlotLowerDelay', 1 , false);
					}
				}

				thePlayer.BlockAction( EIAB_UsableItem,				'ACS_Item_Anim_Hack');
				thePlayer.BlockAction( EIAB_Crossbow,				'ACS_Item_Anim_Hack');
				thePlayer.BlockAction( EIAB_CallHorse,				'ACS_Item_Anim_Hack');
				thePlayer.BlockAction( EIAB_InteractionAction, 		'ACS_Item_Anim_Hack');
				thePlayer.BlockAction( EIAB_Interactions, 			'ACS_Item_Anim_Hack');
				thePlayer.BlockAction( EIAB_InteractionContainers,  'ACS_Item_Anim_Hack');

				potionaniminprogress = true;
			}
		}
	}

	public timer function SetPotionsAnimProgressDelay(deltaTime : float , id : int)
	{
		thePlayer.UnblockAction( EIAB_UsableItem,				'ACS_Item_Anim_Hack');
		thePlayer.UnblockAction( EIAB_Crossbow,					'ACS_Item_Anim_Hack');
		thePlayer.UnblockAction( EIAB_CallHorse,				'ACS_Item_Anim_Hack');
		thePlayer.UnblockAction( EIAB_InteractionAction, 		'ACS_Item_Anim_Hack');
		thePlayer.UnblockAction( EIAB_Interactions, 			'ACS_Item_Anim_Hack');
		thePlayer.UnblockAction( EIAB_InteractionContainers,  	'ACS_Item_Anim_Hack');

		potionaniminprogress = false;
	}

	private var faceMaskDoubleTapCallTime																											: float;
	private var faceMaskDoubleTap 																											: bool;

	var guiding_wind_cooldown : float;

	event OnHighlightNextObjective( action : SInputAction )
	{
		var journalModule 	 														: CR4HudModuleJournalUpdate;
		var walkToggleAction 														: SInputAction;
		var inputHandled    														: bool = false;
		var m_hud 			 														: CR4ScriptedHud;
		var guidingWindEnt                  										: CACSGuidingWindEnt;

		if ( thePlayer.IsCameraLockedToTarget() && 
		( thePlayer.GetCurrentStateName() == 'Exploration' || thePlayer.GetCurrentStateName() == 'TraverseExploration' ) )
		{
			thePlayer.HardLockToTarget( false );
			inputHandled = true;
		}

		if( IsPressed(action) 
		&& (theInput.GetActionValue('Sprint') > 0.1
		|| theInput.GetActionValue('Gallop') > 0.1
		|| theInput.GetActionValue('Canter') > 0.1
		)
		&& theGame.GetEngineTimeAsSeconds() - guiding_wind_cooldown > 3
		&& ACS_Settings_Main_Bool('acs_hud_settings_main','acs_guiding_wind_enabled', true)
		)
		{
			guiding_wind_cooldown = theGame.GetEngineTimeAsSeconds();

			thePlayer.PlayLine( 1054181, false);

			ACS_Tutorial_Display_Check('ACS_Guiding_Wind_Tutorial_Shown');

			if (ACSGetGuidingWindEnt('ACS_Guiding_Wind_Ent'))
			{
				ACSGetGuidingWindEnt('ACS_Guiding_Wind_Ent').RemoveTimer('guiding_wind_reset_timer');

				ACSGetGuidingWindEnt('ACS_Guiding_Wind_Ent').guiding_wind_reset();
			}

			guidingWindEnt = (CACSGuidingWindEnt)theGame.CreateEntity( (CEntityTemplate)LoadResource( 

			"dlc\dlc_acs\data\entities\other\guiding_wind_ent.w2ent"

			, true ), GetWitcherPlayer().GetWorldPosition(), GetWitcherPlayer().GetWorldRotation() );

			guidingWindEnt.AddTag('ACS_Guiding_Wind_Ent');
		

			return false;
		}

		m_hud = (CR4ScriptedHud)theGame.GetHud(); 
		
		if( !inputHandled && m_hud )
		{
			journalModule = (CR4HudModuleJournalUpdate) m_hud.GetHudModule( "JournalUpdateModule");
			
			if ( journalModule )
			{
				inputHandled = journalModule.isBookInfoShown();
			}
		}
		
		if ( !inputHandled && thePlayer.IsActionAllowed( EIAB_HighlightObjective ) )
		{
			walkToggleAction = theInput.GetAction('WalkToggle');
			if ( IsReleased(action) && walkToggleAction.lastFrameValue < 0.7 && walkToggleAction.value < 0.7 )
			{
				if(ShouldProcessTutorial('TutorialObjectiveSwitching'))
				{
					FactsSet( "tut_switched_objective", 1 );
				}
				theGame.GetJournalManager().SetPrevNextHighlightedObjective( true );
			}
		}

		if( !thePlayer.IsActionAllowed( EIAB_QuickSlots ) )
		{
			return false;
		}

		if( !thePlayer.IsActionAllowed( EIAB_OpenInventory ) )
		{
			return false;
		}

		if (FactsQuerySum("acs_transformation_activated") > 0)
		{
			return false;
		}

		if( IsPressed(action) && ACS_Settings_Main_Bool('acs_item_management_settings','acs_quick_items_menu_enabled', true))
		{	
			ACS_Tutorial_Display_Check('ACS_Quick_Inventory_Tutorial_Shown');

			thePlayer.RemoveTimer('ACS_QuickItemPopupModuleDelay');
			thePlayer.AddTimer('ACS_QuickItemPopupModuleDelay', 0.5 , false);

			/*
			GetACSStorage().acs_deleteOnelinerByTag("ACS_ItemPopUpOneliner");

			ACSGetCEntity('ACS_ItemPopupAttachmentDummy').Destroy();

			RemoveTimer('ItemPopupInputCountStart');
			AddTimer('ItemPopupInputCountStart', 1, true);

			itemPopupInputHeldDownCount += 1;
			*/
		}

		if( IsReleased(action) && ACS_Settings_Main_Bool('acs_item_management_settings','acs_quick_items_menu_enabled', true))
		{
			thePlayer.RemoveTimer('ACS_QuickItemPopupModuleDelay');

			/*
			GetACSStorage().acs_deleteOnelinerByTag("ACS_ItemPopUpOneliner");

			ACSGetCEntity('ACS_ItemPopupAttachmentDummy').Destroy();

			RemoveTimer('ItemPopupInputCountStart');

			if(ACS_Is_DLC_Installed('dlcvhud'))
			{
				thePlayer.RemoveTimer('Vlad_ItemPopupModuleDelay');
			}	
			else
			{
				thePlayer.RemoveTimer('ACS_ItemPopupModuleDelay');
			}

			if ( 
			itemPopupInputHeldDownCount >= 2
			&& thePlayer.IsActorLockedToTarget() 
			&& !theInput.LastUsedPCInput() )
			{
				thePlayer.HardLockToTarget( false );	
			}

			if (itemPopupInputHeldDownCount >= 2 )
			{
				thePlayer.AddTimer('ACS_QuickItemPopupModuleDelay', 0.01 , false);
			}

			itemPopupInputHeldDownCount = 0;
			*/
		}
	}


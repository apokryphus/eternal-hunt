	function GeraltSpecialLightAttack()
	{
		if (thePlayer.HasTag('acs_igni_secondary_sword_equipped_TAG'))
		{
			thePlayer.RemoveTag('acs_igni_secondary_sword_equipped_TAG');	
		}
		
		if (!thePlayer.HasTag('acs_igni_sword_equipped_TAG'))
		{
			thePlayer.AddTag('acs_igni_sword_equipped_TAG');	
		}
				
		

		if (thePlayer.HasTag('ACS_Dual_Wield_Active')
		)
		{
			Attack_Setup_04('GeraltDualWieldSpecialLightAttack');
			
			return;
		}

		if (thePlayer.HasTag('ACS_Spear_Transform_Active')
		)
		{
			Attack_Setup_22('FocusModeJinguBangSpecialAttack');

			return;
		}

		if (ACS_GetItem_Sword_IsEquipped('zireal_steel_held', 'steel') || ACS_GetItem_Sword_IsEquipped('zireal_silver_held', 'silver'))
		{
			Attack_Setup_08('GeraltCiriSpecialLightAttack');
		}
		else
		{
			if (Attack_Directional_Press_Check())
			{
				if (ACS_Armor_Set_Check('wolf', true)
				|| ACS_Armor_Set_Check('forgotten_wolf', true)
				|| ACS_Armor_Set_Check('acs_armor', false))
				{
					if(thePlayer.GetStat(BCS_Stamina) > 0)
					{
						action_interrupt();
					}

					thePlayer.SetBehaviorVariable( 'combatActionType', (int)CAT_SpecialAttack );
					thePlayer.SetBehaviorVariable( 'playerAttackType', 0 );
					thePlayer.RaiseForceEvent	 	( 'CombatAction' );
					
					thePlayer.PrepareToAttack();
					thePlayer.SetPlayedSpecialAttackMissingResourceSound(false);
					thePlayer.AddTimer( 'IsSpecialLightAttackInputHeld', 0.00001 , true );
				}
				else if (ACS_Armor_Set_Check('bear', true))
				{
					Attack_Setup_04('GeraltBearSpecialLightAttack');
				}
				else if (ACS_Armor_Set_Check('cat', true))
				{
					Attack_Setup_05('GeraltCatSpecialLightAttack');
				}
				else if (ACS_Armor_Set_Check('griffin', true))
				{
					Attack_Setup_05('GeraltGriffinSpecialLightAttack');
				}
				else if (ACS_Armor_Set_Check('manticore', true))
				{
					Attack_Setup_06('GeraltManticoreSpecialLightAttack');
				}
				else if (ACS_Armor_Set_Check('viper', true))
				{
					Attack_Setup_06('GeraltViperSpecialLightAttack');
				}
				else
				{
					if(thePlayer.GetStat(BCS_Stamina) > 0)
					{
						action_interrupt();
					}

					thePlayer.SetBehaviorVariable( 'combatActionType', (int)CAT_SpecialAttack );
					thePlayer.SetBehaviorVariable( 'playerAttackType', 0 );
					thePlayer.RaiseForceEvent	 	( 'CombatAction' );
					
					thePlayer.PrepareToAttack();
					thePlayer.SetPlayedSpecialAttackMissingResourceSound(false);
					thePlayer.AddTimer( 'IsSpecialLightAttackInputHeld', 0.00001 , true );
				}
			}
			else
			{
				if(thePlayer.GetStat(BCS_Stamina) > 0)
				{
					action_interrupt();
				}

				thePlayer.SetBehaviorVariable( 'combatActionType', (int)CAT_SpecialAttack );
				thePlayer.SetBehaviorVariable( 'playerAttackType', 0 );
				thePlayer.RaiseForceEvent	 	( 'CombatAction' );
				
				thePlayer.PrepareToAttack();
				thePlayer.SetPlayedSpecialAttackMissingResourceSound(false);
				thePlayer.AddTimer( 'IsSpecialLightAttackInputHeld', 0.00001 , true );
			}
		}
	}

	var l_hand_closed : bool;

	function DualWieldDaggerStrike( optional backhand : bool )
	{
		var event_names 																								: array< name >;
		var steelcopy																									: CEntity;

		if(!ACSGetCEntity('ACS_Viper_Dagger_L'))
		{
			steelcopy = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource(

			"dlc\dlc_acs\data\entities\swords\vesemir_dagger.w2ent" 

			,true ), thePlayer.GetWorldPosition() -100, thePlayer.GetWorldRotation());

			steelcopy.AddTag('ACS_Viper_Dagger_L');

			//steelcopy.CreateAttachment(thePlayer, 'l_weapon', Vector(0,0.0125,-0.0125), EulerAngles(0,180,180));

			steelcopy.CreateAttachment(thePlayer, 'l_weapon', Vector(0,0,0.025), EulerAngles(0,0,0));

			if (FactsQuerySum("ACS_Viper_Style_Activate") > 0)
			{
				//steelcopy.CreateAttachment(thePlayer, 'l_weapon', Vector(0,0,-0.0125), EulerAngles(0,180,180));
			}
			else
			{
				//steelcopy.CreateAttachment(thePlayer, 'l_weapon', Vector(0,0,0.025), EulerAngles(0,0,0));
			}

			

			steelcopy.PlayEffectSingle('fast_attack_buff_hit');

			GetWitcherPlayer().SoundEvent("scene_weapon_sword_unsheat_fast");

			thePlayer.RaiseEvent('ACS_ForceHandClosedL');
		}

		if (backhand)
		{
			if (!backhandSwordWield)
			{
				thePlayer.RaiseEvent('ACS_ForceHandClosedRBackhand');

				backhandSwordWield = true;
			}
		}

		if(ACSGetCEntity('ACS_Viper_Dagger_L')
		
		)
		{
			event_names.Clear();

			//event_names.PushBack('ACS_LHandAttack01');
			//event_names.PushBack('ACS_LHandAttack02');
			//event_names.PushBack('ACS_LHandAttack03');
			//event_names.PushBack('ACS_LHandAttack04');
			//event_names.PushBack('ACS_LHandAttack05');
			//event_names.PushBack('ACS_LHandAttack06');
			//event_names.PushBack('ACS_LHandAttack07');
			//event_names.PushBack('ACS_LHandAttack08');
			//event_names.PushBack('ACS_LHandAttack09');
			event_names.PushBack('ACS_LHandAttack10');
			
			thePlayer.RaiseEvent(event_names[RandRange(event_names.Size())]);
		}

		if (FactsQuerySum("ACS_Viper_Style_Activate") > 0)
		{
			RemoveTimer('ACS_LHandAttackReset'); 
			AddTimer('ACS_LHandAttackReset', 0.75 , false); 
		}

		RemoveTimer('CombatTauntDelay');
		RemoveTimer('SwordTauntRunningSwitchSecondary'); 
		AddTimer('SwordTauntRunningSwitchSecondary', 2.25 , false); 

		if (thePlayer.HasTag('ACS_Sword_Hit_Blood_Trigger'))
		{
			RemoveTimer('SwordTauntRunningSwitchSecondaryWeaponBlood'); 
			AddTimer('SwordTauntRunningSwitchSecondaryWeaponBlood', 3.25 , false); 

			thePlayer.RemoveTag('ACS_Sword_Hit_Blood_Trigger');
		}

		RemoveTimer('ACS_ForceHandClosedREnd');
		AddTimer('ACS_ForceHandClosedREnd', 3 , false);

		RemoveTimer('ViperDaggerDestroyDelay');
		AddTimer('ViperDaggerDestroyDelay', 5 , false);
	}

	timer function ACS_LHandAttackReset( dt : float, id : int )
	{
		thePlayer.RaiseEvent('ACS_LHandAttack01');
	}

	timer function ACS_ForceHandClosedREnd( dt : float, id : int )
	{
		if (backhandSwordWield)
		{
			thePlayer.RaiseEvent('ACS_ForceHandClosedREnd');

			backhandSwordWield = false;
		}
	}

	timer function ViperDaggerDestroyDelay( dt : float, id : int )
	{
		if ( !theSound.SoundIsBankLoaded("qu_nml_105.bnk") )
		{
			theSound.SoundLoadBank( "qu_nml_105.bnk", false );
		}

		GetWitcherPlayer().SoundEvent("qu_nml_105_geralt_sheats_dagger");

		ACSGetCEntity('ACS_Viper_Dagger_L').BreakAttachment(); 
		ACSGetCEntity('ACS_Viper_Dagger_L').Teleport( GetWitcherPlayer().GetWorldPosition() + Vector( 0, 0, -200 ) );
		ACSGetCEntity('ACS_Viper_Dagger_L').DestroyAfter(0.00125);
		ACSGetCEntity('ACS_Viper_Dagger_L').RemoveTag('ACS_Viper_Dagger_L');

		thePlayer.RaiseEvent('ACS_StowLWeapon');

		if (!thePlayer.HasTag('ACS_Dual_Wield_Active')){thePlayer.RaiseEvent('ACS_ForceHandClosedLEnd');}
	}

	////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	// Heavenly Strike

	function ACSHeavenlyStrike()
	{
		thePlayer.GetMovingAgentComponent().GetMovementAdjustor().CancelAll();

		thePlayer.SoundEvent('sprj_onosao_sousyoku_00_bb_acs');

		CreateFastSprintTrail('red');

		thePlayer.AddTag('ACS_In_Heavenly_Strike');

		RemoveTimer('CloseRangeAimAssist');

		ACS_ExplorationDelayHack(false, 3);

		if( thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus )/3
		&& thePlayer.GetStat( BCS_Focus ) < thePlayer.GetStatMax( BCS_Focus ) * 2/3) 
		{	
			thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) * 1/3 );
		}
		else if( thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus ) * 2/3
		&& thePlayer.GetStat( BCS_Focus ) < thePlayer.GetStatMax( BCS_Focus ) * 0.9875 )  
		{	
			thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) * 1/3);
		}
		else if( thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus ) * 0.9875 ) 
		{
			thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) * 1/3);
		}

		thePlayer.SetImmortalityMode( AIM_Invulnerable, AIC_Default, true ); 
		thePlayer.SetCanPlayHitAnim(false); 
		thePlayer.EnableCharacterCollisions(false); 
		thePlayer.AddBuffImmunity_AllNegative('acs_heavenly_strike', true); 
		thePlayer.SetIsCurrentlyDodging(true);

		GetWitcherPlayer().BlockAction( EIAB_Crossbow, 			'acs_heavenly_strike');
		GetWitcherPlayer().BlockAction( EIAB_CallHorse,			'acs_heavenly_strike');
		GetWitcherPlayer().BlockAction( EIAB_Signs, 				'acs_heavenly_strike');
		GetWitcherPlayer().BlockAction( EIAB_DrawWeapon, 			'acs_heavenly_strike'); 
		GetWitcherPlayer().BlockAction( EIAB_FastTravel, 			'acs_heavenly_strike');
		GetWitcherPlayer().BlockAction( EIAB_Fists, 				'acs_heavenly_strike');
		GetWitcherPlayer().BlockAction( EIAB_InteractionAction, 	'acs_heavenly_strike');
		GetWitcherPlayer().BlockAction( EIAB_UsableItem,			'acs_heavenly_strike');
		GetWitcherPlayer().BlockAction( EIAB_ThrowBomb,			'acs_heavenly_strike');
		GetWitcherPlayer().BlockAction( EIAB_SwordAttack,			'acs_heavenly_strike');
		GetWitcherPlayer().BlockAction( EIAB_Jump,				'acs_heavenly_strike');
		GetWitcherPlayer().BlockAction( EIAB_LightAttacks,		'acs_heavenly_strike');
		GetWitcherPlayer().BlockAction( EIAB_HeavyAttacks,		'acs_heavenly_strike');
		GetWitcherPlayer().BlockAction( EIAB_SpecialAttackLight,	'acs_heavenly_strike');
		GetWitcherPlayer().BlockAction( EIAB_SpecialAttackHeavy,	'acs_heavenly_strike');
		GetWitcherPlayer().BlockAction( EIAB_Dodge,				'acs_heavenly_strike');
		GetWitcherPlayer().BlockAction( EIAB_Roll,				'acs_heavenly_strike');
		GetWitcherPlayer().BlockAction( EIAB_Parry,				'acs_heavenly_strike');
		GetWitcherPlayer().BlockAction( EIAB_MeditationWaiting,	'acs_heavenly_strike');
		GetWitcherPlayer().BlockAction( EIAB_OpenMeditation,		'acs_heavenly_strike');
		GetWitcherPlayer().BlockAction( EIAB_RadialMenu,			'acs_heavenly_strike');
		GetWitcherPlayer().BlockAction( EIAB_Interactions, 		'acs_heavenly_strike');

		theGame.CreateNoSaveLock( "ACS_Heavenly_Strike_State", ACS_Heavenly_Strike_Savelock_ID, false, false );

		ACS_Tutorial_Display_Check('ACS_Heavenly_Strike_Tutorial_Shown');

		RemoveTimer('RemoveContinuousTicket');

		MovementAdjust('dash_attack');

		if( actor && ACS_AttitudeCheck ( actor ) && thePlayer.IsInCombat())
		{
			if ( ACS_Settings_Main_Int('acs_target_settings','acs_target_mode', 0) == 0 || ACS_Settings_Main_Int('acs_target_settings','acs_target_mode', 0) == 1 )
			{
				if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTowards( ticket, actor );}
			}
			else if ( ACS_Settings_Main_Int('acs_target_settings','acs_target_mode', 0) == 2 )
			{
				if (thePlayer.IsHardLockEnabled())
				{
					if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTowards( ticket, actor );}
				}
				else
				{
					if(!thePlayer.HasTag('ACS_Manual_Combat_Control')){thePlayer.AddTag('ACS_Manual_Combat_Control');} RemoveTimer('Manual_Combat_Control_Remove'); AddTimer('Manual_Combat_Control_Remove', 2 , false);//if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTo( ticket, VecHeading( theCamera.GetCameraDirection() ) );}
				}	
			}
		}

		ACS_Attack_Trail('fast_attack_buff');

		ACS_Attack_Trail('fast_attack_buff_hit');

		thePlayer.ACS_ClearAnimationSpeedMultipliers();

		thePlayer.DestroyEffect('dodge_acs_armor');
		thePlayer.PlayEffectSingle('dodge_acs_armor');

		if (thePlayer.HasTag('ACS_Dual_Wield_Active'))
		{
			if(RandF() < 0.5)
			{
				PlayerPlayAnimation( 'woman_ciri_sword_special_heavy_attack_taunt_start_lp_ACS');	
			}
			else
			{
				PlayerPlayAnimation( 'woman_ciri_sword_special_heavy_attack_taunt_start_rp_ACS');	
			}
		}
		else
		{
			if (FactsQuerySum("ACS_Heavenly_Strike_Anim_Switch") <= 0 )
			{
				if(RandF() < 0.5)
				{
					PlayerPlayAnimation( 'B_AtkSenkou02_ACS');	
				}
				else
				{
					PlayerPlayAnimation( 'tw2_npc_sword1h_28_ACS');	
				}

				FactsAdd("ACS_Heavenly_Strike_Anim_Switch", 1, -1);
			}
			else if (FactsQuerySum("ACS_Heavenly_Strike_Anim_Switch") > 0 )
			{
				if(RandF() < 0.5)
				{
					if(RandF() < 0.5)
					{
						PlayerPlayAnimation( 'woman_ciri_sword_special_heavy_attack_taunt_start_lp_ACS');	
					}
					else
					{
						PlayerPlayAnimation( 'woman_ciri_sword_special_heavy_attack_charge_start_lp_ACS');	
					}
				}
				else
				{
					if(RandF() < 0.5)
					{
						PlayerPlayAnimation( 'woman_ciri_sword_special_heavy_attack_taunt_start_rp_ACS');	
					}
					else
					{
						PlayerPlayAnimation( 'woman_ciri_sword_special_heavy_attack_charge_start_rp_ACS');	
					}
				}

				FactsRemove("ACS_Heavenly_Strike_Anim_Switch");
			}
		}
			

		thePlayer.RaiseEvent('ACS_ForceHandClosedR');

		ACSGetCEntity('acs_sword_trail_1').PlayEffectSingle('red_charge_10');
		ACSGetCEntity('acs_sword_trail_1').StopEffect('red_charge_10');

		ACSGetCEntity('acs_sword_trail_1').PlayEffectSingle('red_aerondight_special_trail');
		ACSGetCEntity('acs_sword_trail_1').StopEffect('red_charge_10');

		ACSGetCEntity('acs_sword_trail_2').PlayEffectSingle('red_charge_10');
		ACSGetCEntity('acs_sword_trail_2').StopEffect('red_charge_10');

		ACSGetCEntity('acs_sword_trail_2').PlayEffectSingle('red_aerondight_special_trail');
		ACSGetCEntity('acs_sword_trail_2').StopEffect('red_charge_10');

		ACSGetCEntity('acs_sword_trail_1').PlayEffectSingle('electric_sword_trail_red');

		ACSGetCEntity('acs_sword_trail_2').PlayEffectSingle('electric_sword_trail_red');

		ACSGetCEntity('acs_sword_trail_3').PlayEffectSingle('electric_sword_trail_red');




		ACSGetCEntity('acs_sword_trail_1_dual_wield').PlayEffectSingle('red_charge_10');
		ACSGetCEntity('acs_sword_trail_1_dual_wield').StopEffect('red_charge_10');

		ACSGetCEntity('acs_sword_trail_1_dual_wield').PlayEffectSingle('red_aerondight_special_trail');
		ACSGetCEntity('acs_sword_trail_1_dual_wield').StopEffect('red_charge_10');

		ACSGetCEntity('acs_sword_trail_2_dual_wield').PlayEffectSingle('red_charge_10');
		ACSGetCEntity('acs_sword_trail_2_dual_wield').StopEffect('red_charge_10');

		ACSGetCEntity('acs_sword_trail_2_dual_wield').PlayEffectSingle('red_aerondight_special_trail');
		ACSGetCEntity('acs_sword_trail_2_dual_wield').StopEffect('red_charge_10');

		ACSGetCEntity('acs_sword_trail_1_dual_wield').PlayEffectSingle('electric_sword_trail_red');

		ACSGetCEntity('acs_sword_trail_2_dual_wield').PlayEffectSingle('electric_sword_trail_red');

		ACSGetCEntity('acs_sword_trail_3_dual_wield').PlayEffectSingle('electric_sword_trail_red');

		ACS_SlowMoAdjustable(0.3, 0.375f);

		RemoveTimer('HeavenlyStrikeActionActivateTimer');
		AddTimer( 'HeavenlyStrikeActionActivateTimer', 0.375f, false );

		if (FactsQuerySum("ACS_HeavenlyStrikeLightningAttract") <= 0 )
		{
			if (ACS_Armor_Set_Check('acs_armor', false))
			{
				FactsAdd("ACS_HeavenlyStrikeLightningAttract", 1, -1);
			}
			else
			{
				if 
				(
				GetWeatherConditionName() == 'WT_Blizzard' 
				|| GetWeatherConditionName() == 'WT_Rain_Storm' 
				|| GetWeatherConditionName() == 'WT_Battle' 
				|| GetWeatherConditionName() == 'WT_Battle_Forest' 
				|| GetWeatherConditionName() == 'WT_Wild_Hunt' 
				|| GetWeatherConditionName() == 'WT_q501_Blizzard' 
				|| GetWeatherConditionName() == 'WT_q501_Storm' 
				|| GetWeatherConditionName() == 'WT_q501_Blizzard2' 
				|| GetWeatherConditionName() == 'WT_q501_fight_ship_18_00' 
				|| GetWeatherConditionName() == 'WT_q501_storm_arena' 
				|| GetWeatherConditionName() == 'Spiral_Eternal_Cold' 
				|| GetWeatherConditionName() == 'Spiral_Dark_Valley'
				|| GetWeatherConditionName() == 'WT_Rain_Heavy' 
				|| GetWeatherConditionName() == 'WT_Rain_Dark' 
				)
				{
					if( thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus ) * 2/3
					&& thePlayer.GetStat( BCS_Focus ) < thePlayer.GetStatMax( BCS_Focus ) * 0.9875 )  
					{	
						if (RandF() < 0.66)
						{
							FactsAdd("ACS_HeavenlyStrikeLightningAttract", 1, -1);
						}
					}
					else if( thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus )/3
					&& thePlayer.GetStat( BCS_Focus ) < thePlayer.GetStatMax( BCS_Focus ) * 2/3) 
					{	
						if (RandF() < 0.495)
						{
							FactsAdd("ACS_HeavenlyStrikeLightningAttract", 1, -1);
						}
					}
					else if( thePlayer.GetStat( BCS_Focus ) < thePlayer.GetStatMax( BCS_Focus )/3)
					{
						if (RandF() < 0.33)
						{
							FactsAdd("ACS_HeavenlyStrikeLightningAttract", 1, -1);
						}
					}
				}
				else
				{
					if( thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus ) * 2/3
					&& thePlayer.GetStat( BCS_Focus ) < thePlayer.GetStatMax( BCS_Focus ) * 0.9875 )  
					{	
						if (RandF() < 0.33)
						{
							FactsAdd("ACS_HeavenlyStrikeLightningAttract", 1, -1);
						}
					}
					else if( thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus )/3
					&& thePlayer.GetStat( BCS_Focus ) < thePlayer.GetStatMax( BCS_Focus ) * 2/3) 
					{	
						if (RandF() < 0.2475)
						{
							FactsAdd("ACS_HeavenlyStrikeLightningAttract", 1, -1);
						}
					}
					else if( thePlayer.GetStat( BCS_Focus ) < thePlayer.GetStatMax( BCS_Focus )/3)
					{
						if (RandF() < 0.165)
						{
							FactsAdd("ACS_HeavenlyStrikeLightningAttract", 1, -1);
						}
					}
				}
			}
		}

		RemoveTimer('HeavenlyStrikeLightningTimer');

		if (FactsQuerySum("ACS_HeavenlyStrikeLightningAttract") > 0 )
		{
			AddTimer( 'HeavenlyStrikeLightningTimer', 0.4f, false );
		}

		RemoveTimer('HeavenlyStrikeActivateTimer');
	}

	timer function HeavenlyStrikeLightningTimer(dt : float, id : int)
	{
		RemoveTimer('CloseRangeAimAssist');

		ACSGetCEntity('acs_sword_trail_1').PlayEffectSingle('lightning_charge_red');
		ACSGetCEntity('acs_sword_trail_1').StopEffect('lightning_charge_red');

		ACSGetCEntity('acs_sword_trail_2').PlayEffectSingle('lightning_charge_red');
		ACSGetCEntity('acs_sword_trail_2').StopEffect('lightning_charge_red');

		ACSGetCEntity('acs_sword_trail_3').PlayEffectSingle('lightning_charge_red');
		ACSGetCEntity('acs_sword_trail_3').StopEffect('lightning_charge_red');

		ACSGetCEntity('acs_sword_trail_1').PlayEffectSingle('electric_sword_red_1');

		ACSGetCEntity('acs_sword_trail_2').PlayEffectSingle('electric_sword_red_1');

		ACSGetCEntity('acs_sword_trail_3').PlayEffectSingle('electric_sword_red_1');

		ACSGetCEntity('acs_sword_trail_1').PlayEffectSingle('electric_sword_red_1_1');

		ACSGetCEntity('acs_sword_trail_2').PlayEffectSingle('electric_sword_red_1_1');

		ACSGetCEntity('acs_sword_trail_3').PlayEffectSingle('electric_sword_red_1_1');




		ACSGetCEntity('acs_sword_trail_1_dual_wield').PlayEffectSingle('lightning_charge_red');
		ACSGetCEntity('acs_sword_trail_1_dual_wield').StopEffect('lightning_charge_red');

		ACSGetCEntity('acs_sword_trail_2_dual_wield').PlayEffectSingle('lightning_charge_red');
		ACSGetCEntity('acs_sword_trail_2_dual_wield').StopEffect('lightning_charge_red');

		ACSGetCEntity('acs_sword_trail_3_dual_wield').PlayEffectSingle('lightning_charge_red');
		ACSGetCEntity('acs_sword_trail_3_dual_wield').StopEffect('lightning_charge_red');

		ACSGetCEntity('acs_sword_trail_1_dual_wield').PlayEffectSingle('electric_sword_red_1');

		ACSGetCEntity('acs_sword_trail_2_dual_wield').PlayEffectSingle('electric_sword_red_1');

		ACSGetCEntity('acs_sword_trail_3_dual_wield').PlayEffectSingle('electric_sword_red_1');

		ACSGetCEntity('acs_sword_trail_1_dual_wield').PlayEffectSingle('electric_sword_red_1_1');

		ACSGetCEntity('acs_sword_trail_2_dual_wield').PlayEffectSingle('electric_sword_red_1_1');

		ACSGetCEntity('acs_sword_trail_3_dual_wield').PlayEffectSingle('electric_sword_red_1_1');

		thePlayer.SoundEvent( "magic_sorceress_vfx_hit_electric" );

		thePlayer.SoundEvent( "magic_sorceress_vfx_lightning_bolt" );
	}

	timer function HeavenlyStrikeActionActivateTimer(dt : float, id : int)
	{
		RemoveTimer('CloseRangeAimAssist');

		ACS_ExplorationDelayHack(false, 3);

		thePlayer.RaiseEvent('ACS_ForceHandClosedREnd');

		RemoveTimer('RemoveContinuousTicket');

		MovementAdjust('dash_attack');

		if( actor && ACS_AttitudeCheck ( actor ) && thePlayer.IsInCombat())
		{
			if ( ACS_Settings_Main_Int('acs_target_settings','acs_target_mode', 0) == 0 || ACS_Settings_Main_Int('acs_target_settings','acs_target_mode', 0) == 1 )
			{
				if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTowards( ticket, actor );}  
			}
			else if ( ACS_Settings_Main_Int('acs_target_settings','acs_target_mode', 0) == 2 )
			{
				if (thePlayer.IsHardLockEnabled())
				{
					if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTowards( ticket, actor );}  
				}
				else
				{
					if(!thePlayer.HasTag('ACS_Manual_Combat_Control')){thePlayer.AddTag('ACS_Manual_Combat_Control');} RemoveTimer('Manual_Combat_Control_Remove'); AddTimer('Manual_Combat_Control_Remove', 2 , false);//if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTo( ticket, VecHeading( theCamera.GetCameraDirection() ) );}
				}	
			}
		}

		if (FactsQuerySum("ACS_Heavenly_Strike_Anim_Switch") <= 0 )
		{
			if(RandF() < 0.5)
			{
				PlayerPlayAnimation( 'woman_ciri_sword_special_heavy_attack_short_lp_ACS');	
			}
			else
			{
				PlayerPlayAnimation( 'woman_ciri_sword_special_heavy_attack_short_rp_ACS');	
			}
		}
		else if (FactsQuerySum("ACS_Heavenly_Strike_Anim_Switch") > 0 )
		{
			PlayerPlayAnimation( 'man_geralt_sword_attack_fast_right_1_lp_40ms_forward_ACS');
		}

		ACSGetCEntity('acs_sword_trail_1').PlayEffectSingle('red_charge_10');
		ACSGetCEntity('acs_sword_trail_1').StopEffect('red_charge_10');

		ACSGetCEntity('acs_sword_trail_1').PlayEffectSingle('red_aerondight_special_trail');
		ACSGetCEntity('acs_sword_trail_1').StopEffect('red_charge_10');

		ACSGetCEntity('acs_sword_trail_2').PlayEffectSingle('red_charge_10');
		ACSGetCEntity('acs_sword_trail_2').StopEffect('red_charge_10');

		ACSGetCEntity('acs_sword_trail_2').PlayEffectSingle('red_aerondight_special_trail');
		ACSGetCEntity('acs_sword_trail_2').StopEffect('red_charge_10');



		ACSGetCEntity('acs_sword_trail_1_dual_wield').PlayEffectSingle('red_charge_10');
		ACSGetCEntity('acs_sword_trail_1_dual_wield').StopEffect('red_charge_10');

		ACSGetCEntity('acs_sword_trail_1_dual_wield').PlayEffectSingle('red_aerondight_special_trail');
		ACSGetCEntity('acs_sword_trail_1_dual_wield').StopEffect('red_charge_10');

		ACSGetCEntity('acs_sword_trail_2_dual_wield').PlayEffectSingle('red_charge_10');
		ACSGetCEntity('acs_sword_trail_2_dual_wield').StopEffect('red_charge_10');

		ACSGetCEntity('acs_sword_trail_2_dual_wield').PlayEffectSingle('red_aerondight_special_trail');
		ACSGetCEntity('acs_sword_trail_2_dual_wield').StopEffect('red_charge_10');

		RemoveTimer('HeavenlyStrikeActivateTimer');
		AddTimer( 'HeavenlyStrikeActivateTimer', 0.25f, false );
	}

	timer function HeavenlyStrikeActivateTimer(dt : float, id : int)
	{
		var actorPos, newActorPos			: Vector;
		var proj_1							: W3ACSFireLine;

		RemoveTimer('CloseRangeAimAssist');

		ACS_ExplorationDelayHack(false, 3);

		ACSGetCEntity('acs_sword_trail_1').PlayEffectSingle('electric_sword_trail_red');
		ACSGetCEntity('acs_sword_trail_1').StopEffect('electric_sword_trail_red');

		ACSGetCEntity('acs_sword_trail_2').PlayEffectSingle('electric_sword_trail_red');
		ACSGetCEntity('acs_sword_trail_2').StopEffect('electric_sword_trail_red');

		ACSGetCEntity('acs_sword_trail_3').PlayEffectSingle('electric_sword_trail_red');
		ACSGetCEntity('acs_sword_trail_3').StopEffect('electric_sword_trail_red');


		ACSGetCEntity('acs_sword_trail_1_dual_wield').PlayEffectSingle('electric_sword_trail_red');
		ACSGetCEntity('acs_sword_trail_1_dual_wield').StopEffect('electric_sword_trail_red');

		ACSGetCEntity('acs_sword_trail_2_dual_wield').PlayEffectSingle('electric_sword_trail_red');
		ACSGetCEntity('acs_sword_trail_2_dual_wield').StopEffect('electric_sword_trail_red');

		ACSGetCEntity('acs_sword_trail_3_dual_wield').PlayEffectSingle('electric_sword_trail_red');
		ACSGetCEntity('acs_sword_trail_3_dual_wield').StopEffect('electric_sword_trail_red');

		thePlayer.SetImmortalityMode( AIM_None, AIC_Default, true ); 
		thePlayer.SetCanPlayHitAnim(true); 
		if (!thePlayer.IsUsingHorse()&& !thePlayer.IsUsingVehicle()){thePlayer.EnableCharacterCollisions(true); } 
		thePlayer.RemoveBuffImmunity_AllNegative('acs_heavenly_strike'); 
		thePlayer.SetIsCurrentlyDodging(false);

		theGame.ReleaseNoSaveLock( ACS_Heavenly_Strike_Savelock_ID );

		GetWitcherPlayer().UnblockAction( EIAB_Crossbow, 			'acs_heavenly_strike');
		GetWitcherPlayer().UnblockAction( EIAB_CallHorse,			'acs_heavenly_strike');
		GetWitcherPlayer().UnblockAction( EIAB_Signs, 				'acs_heavenly_strike');
		GetWitcherPlayer().UnblockAction( EIAB_DrawWeapon, 			'acs_heavenly_strike'); 
		GetWitcherPlayer().UnblockAction( EIAB_FastTravel, 			'acs_heavenly_strike');
		GetWitcherPlayer().UnblockAction( EIAB_Fists, 				'acs_heavenly_strike');
		GetWitcherPlayer().UnblockAction( EIAB_InteractionAction, 	'acs_heavenly_strike');
		GetWitcherPlayer().UnblockAction( EIAB_UsableItem,			'acs_heavenly_strike');
		GetWitcherPlayer().UnblockAction( EIAB_ThrowBomb,			'acs_heavenly_strike');
		GetWitcherPlayer().UnblockAction( EIAB_SwordAttack,			'acs_heavenly_strike');
		GetWitcherPlayer().UnblockAction( EIAB_Jump,				'acs_heavenly_strike');
		GetWitcherPlayer().UnblockAction( EIAB_LightAttacks,		'acs_heavenly_strike');
		GetWitcherPlayer().UnblockAction( EIAB_HeavyAttacks,		'acs_heavenly_strike');
		GetWitcherPlayer().UnblockAction( EIAB_SpecialAttackLight,	'acs_heavenly_strike');
		GetWitcherPlayer().UnblockAction( EIAB_SpecialAttackHeavy,	'acs_heavenly_strike');
		GetWitcherPlayer().UnblockAction( EIAB_Dodge,				'acs_heavenly_strike');
		GetWitcherPlayer().UnblockAction( EIAB_Roll,				'acs_heavenly_strike');
		GetWitcherPlayer().UnblockAction( EIAB_Parry,				'acs_heavenly_strike');
		GetWitcherPlayer().UnblockAction( EIAB_MeditationWaiting,	'acs_heavenly_strike');
		GetWitcherPlayer().UnblockAction( EIAB_OpenMeditation,		'acs_heavenly_strike');
		GetWitcherPlayer().UnblockAction( EIAB_RadialMenu,			'acs_heavenly_strike');
		GetWitcherPlayer().UnblockAction( EIAB_Interactions, 		'acs_heavenly_strike');

		thePlayer.DestroyEffect('dodge_acs_armor');
		thePlayer.PlayEffectSingle('dodge_acs_armor');

		ACSGetCEntity('acs_sword_trail_1').PlayEffectSingle('red_charge_10');
		ACSGetCEntity('acs_sword_trail_1').StopEffect('red_charge_10');

		ACSGetCEntity('acs_sword_trail_1').PlayEffectSingle('red_aerondight_special_trail');
		ACSGetCEntity('acs_sword_trail_1').StopEffect('red_charge_10');

		ACSGetCEntity('acs_sword_trail_2').PlayEffectSingle('red_charge_10');
		ACSGetCEntity('acs_sword_trail_2').StopEffect('red_charge_10');

		ACSGetCEntity('acs_sword_trail_2').PlayEffectSingle('red_aerondight_special_trail');
		ACSGetCEntity('acs_sword_trail_2').StopEffect('red_charge_10');

		ACSGetCEntity('acs_sword_trail_1').PlayEffectSingle('electric_sword_trail_red');
		ACSGetCEntity('acs_sword_trail_1').StopEffect('electric_sword_trail_red');

		ACSGetCEntity('acs_sword_trail_2').PlayEffectSingle('electric_sword_trail_red');
		ACSGetCEntity('acs_sword_trail_2').StopEffect('electric_sword_trail_red');

		ACSGetCEntity('acs_sword_trail_3').PlayEffectSingle('electric_sword_trail_red');
		ACSGetCEntity('acs_sword_trail_3').StopEffect('electric_sword_trail_red');

		ACSGetCEntity('acs_sword_trail_1').StopEffect('electric_sword_red_1');

		ACSGetCEntity('acs_sword_trail_2').StopEffect('electric_sword_red_1');

		ACSGetCEntity('acs_sword_trail_3').StopEffect('electric_sword_red_1');

		ACSGetCEntity('acs_sword_trail_1').StopEffect('electric_sword_red_1_1');

		ACSGetCEntity('acs_sword_trail_2').StopEffect('electric_sword_red_1_1');

		ACSGetCEntity('acs_sword_trail_3').StopEffect('electric_sword_red_1_1');




		ACSGetCEntity('acs_sword_trail_1_dual_wield').PlayEffectSingle('red_charge_10');
		ACSGetCEntity('acs_sword_trail_1_dual_wield').StopEffect('red_charge_10');

		ACSGetCEntity('acs_sword_trail_1_dual_wield').PlayEffectSingle('red_aerondight_special_trail');
		ACSGetCEntity('acs_sword_trail_1_dual_wield').StopEffect('red_charge_10');

		ACSGetCEntity('acs_sword_trail_2_dual_wield').PlayEffectSingle('red_charge_10');
		ACSGetCEntity('acs_sword_trail_2_dual_wield').StopEffect('red_charge_10');

		ACSGetCEntity('acs_sword_trail_2_dual_wield').PlayEffectSingle('red_aerondight_special_trail');
		ACSGetCEntity('acs_sword_trail_2_dual_wield').StopEffect('red_charge_10');

		ACSGetCEntity('acs_sword_trail_1_dual_wield').PlayEffectSingle('electric_sword_trail_red');
		ACSGetCEntity('acs_sword_trail_1_dual_wield').StopEffect('electric_sword_trail_red');

		ACSGetCEntity('acs_sword_trail_2_dual_wield').PlayEffectSingle('electric_sword_trail_red');
		ACSGetCEntity('acs_sword_trail_2_dual_wield').StopEffect('electric_sword_trail_red');

		ACSGetCEntity('acs_sword_trail_3_dual_wield').PlayEffectSingle('electric_sword_trail_red');
		ACSGetCEntity('acs_sword_trail_3_dual_wield').StopEffect('electric_sword_trail_red');

		ACSGetCEntity('acs_sword_trail_1_dual_wield').StopEffect('electric_sword_red_1');

		ACSGetCEntity('acs_sword_trail_2_dual_wield').StopEffect('electric_sword_red_1');

		ACSGetCEntity('acs_sword_trail_3_dual_wield').StopEffect('electric_sword_red_1');

		ACSGetCEntity('acs_sword_trail_1_dual_wield').StopEffect('electric_sword_red_1_1');

		ACSGetCEntity('acs_sword_trail_2_dual_wield').StopEffect('electric_sword_red_1_1');

		ACSGetCEntity('acs_sword_trail_3_dual_wield').StopEffect('electric_sword_red_1_1');

		RemoveTimer('RemoveContinuousTicket');

		MovementAdjust('dash_attack');

		if( actor && ACS_AttitudeCheck ( actor ) && thePlayer.IsInCombat())
		{

			if (FactsQuerySum("ACS_HeavenlyStrikeLightningAttract") > 0 )
			{
				vACS_Ice_Spikes = new cACS_Ice_Spikes in this;
					
				vACS_Ice_Spikes.ACS_Red_Lightning_Single_Target_Engage();

				FactsRemove("ACS_HeavenlyStrikeLightningAttract");
			}

			if(RandF() < 0.5)
			{
				thePlayer.SoundEvent("monster_dettlaff_monster_combat_geralt_deathblow_01");
			}
			else
			{
				thePlayer.SoundEvent("monster_dettlaff_monster_combat_geralt_deathblow_02");
			}

			if ( ACS_Settings_Main_Int('acs_target_settings','acs_target_mode', 0) == 0 || ACS_Settings_Main_Int('acs_target_settings','acs_target_mode', 0) == 1 )
			{
				if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTowards( ticket, actor );}  
			}
			else if ( ACS_Settings_Main_Int('acs_target_settings','acs_target_mode', 0) == 2 )
			{
				if (thePlayer.IsHardLockEnabled())
				{
					if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTowards( ticket, actor );}  
				}
				else
				{
					if(!thePlayer.HasTag('ACS_Manual_Combat_Control')){thePlayer.AddTag('ACS_Manual_Combat_Control');} RemoveTimer('Manual_Combat_Control_Remove'); AddTimer('Manual_Combat_Control_Remove', 2 , false);//if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTo( ticket, VecHeading( theCamera.GetCameraDirection() ) );}
				}	
			}

			actorPos = ACSFixZAxis(actor.PredictWorldPosition(0.25)) + VecFromHeading( AngleNormalize180( thePlayer.GetHeading() - dist ) ) * 2;

			if( !theGame.GetWorld().NavigationFindSafeSpot( actorPos, 0.3, 0.3 , newActorPos ) )
			{
				theGame.GetWorld().NavigationFindSafeSpot( actorPos, 0.3, 2 , newActorPos );
				actorPos = newActorPos;
			}

			HeavenlyStrikeDamage();

			special_dash_close_dodge_timer_actual();

			movementAdjustor.AdjustmentDuration( ticket, 0.125 );

			movementAdjustor.SlideTo( ticket, ACSFixZAxis(actorPos) );

			if (ACS_Armor_Set_Check('acs_armor', false))
			{
				if ( !theSound.SoundIsBankLoaded("monster_golem_ifryt.bnk") )
				{
					theSound.SoundLoadBank( "monster_golem_ifryt.bnk", false );
				}

				GetWitcherPlayer().SoundEvent("monster_golem_dao_cmb_swoosh_light");	  

				proj_1 = (W3ACSFireLine)theGame.CreateEntity( (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\entities\projectiles\acs_armor_fire_line_proj.w2ent", true ), GetWitcherPlayer().GetWorldPosition() );
				proj_1.Init(GetWitcherPlayer());
				proj_1.PlayEffectSingle('fire_line');
				proj_1.ShootProjectileAtPosition(0,	30, actorPos, 10 );
				proj_1.DestroyAfter(10);
			}
			else
			{
				if (thePlayer.HasTag('ACS_Flammable_Oil_Enabled')
				)
				{
					if (ACS_GetItem_SwordHeldSwitchBasedUponStat('frost_sword'))
					{
						ACS_Frost_Cone();
						vACS_Rend_Projectile.ACS_Eredin_Frost_Projectile_Engage();
					}
					else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('poison_sword'))
					{
						ACS_Poison_Cloud();
					}
					else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('bleed_sword'))
					{
						ACS_Blood_Arc();
					}
					else
					{
						if ( !theSound.SoundIsBankLoaded("monster_golem_ifryt.bnk") )
						{
							theSound.SoundLoadBank( "monster_golem_ifryt.bnk", false );
						}
						
						GetWitcherPlayer().SoundEvent("monster_golem_dao_cmb_swoosh_light");	  
						
						proj_1 = (W3ACSFireLine)theGame.CreateEntity( (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\entities\projectiles\elemental_ifryt_proj.w2ent", true ),  GetWitcherPlayer().GetWorldPosition() );
						proj_1.Init(GetWitcherPlayer());
						proj_1.PlayEffectSingle('fire_line');
						proj_1.ShootProjectileAtPosition(0,	30, actorPos, 10 );
						proj_1.DestroyAfter(10);
					}
				}
			}

			thePlayer.StopEffect('shadowdash_shockwave');

			thePlayer.PlayEffectSingle('shadowdash_shockwave');

			thePlayer.StopEffect('shadowdash_shockwave');
		}
		else
		{
			if (FactsQuerySum("ACS_HeavenlyStrikeLightningAttract") > 0 )
			{
				FactsRemove("ACS_HeavenlyStrikeLightningAttract");
			}
		}

		ACSGetCEntityDestroyAll('ACS_Player_Fast_Sprint_Trail');

		thePlayer.RemoveTag('ACS_In_Heavenly_Strike');
	}

	function HeavenlyStrikeDamage()
	{
		var actors	    																																						: array<CActor>;
		var i 																																									: int;
		var dmg																																									: W3DamageAction;
		var actortarget	    																																					: CActor;
		var curTargetVitality, maxTargetVitality, curTargetEssence, maxTargetEssence, finisherDist, vampireDmgValSteel, vampireDmgValSilver										: float;
		var item_steel, item_silver																																				: SItemUniqueId;
		var ent_1                      																																			: CEntity;
		var rot_1         																																						: EulerAngles;
		var pos_1																																								: Vector;
		
		RemoveTimer('CloseRangeAimAssist');

		thePlayer.GetInventory().GetItemEquippedOnSlot(EES_SteelSword, item_steel);

		thePlayer.GetInventory().GetItemEquippedOnSlot(EES_SilverSword, item_silver);

		actors.Clear();

		actors = thePlayer.GetNPCsAndPlayersInCone(15, 

		VecHeading(thePlayer.GetHeadingVector()

		)
		
		, 30, 3, , FLAG_ExcludePlayer + FLAG_Attitude_Hostile + FLAG_OnlyAliveActors );

		if( actors.Size() > 0 )
		{
			for( i = 0; i < actors.Size(); i += 1 )
			{
				actortarget = (CActor)actors[i];

				pos_1 = actortarget.GetWorldPosition();

				pos_1.Z += 1.5;

				rot_1 = actortarget.GetWorldRotation();

				rot_1.Yaw = RandRangeF(360,1);

				rot_1.Pitch = RandRangeF(45,-45);

				rot_1.Roll = RandRange( 360, 0 );

				ent_1 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

				"dlc\dlc_acs\data\fx\acs_sword_slashes.w2ent"

				, true ), pos_1, rot_1 );

				ent_1.PlayEffectSingle('sword_slash');

				ent_1.PlayEffectSingle('sword_slash_red');

				ent_1.PlayEffectSingle('sword_slash_red_large');

				ent_1.PlayEffectSingle('sword_slash_finisher_large');

				ent_1.DestroyAfter(2.5);

				actortarget.IsAttacked();

				((CNewNPC)actortarget).ACS_DealPostureDamage(30);

				actortarget.SignalGameplayEventParamInt('Time2Dodge', (int)EDT_Attack_Light );

				movementAdjustorNPC = actortarget.GetMovingAgentComponent().GetMovementAdjustor();

				ticketNPC = movementAdjustorNPC.GetRequest( 'ACS_NPC_Special_Dash_Attacked_Rotate');
				movementAdjustorNPC.CancelByName( 'ACS_NPC_Special_Dash_Attacked_Rotate' );
				movementAdjustorNPC.CancelAll();

				ticketNPC = movementAdjustorNPC.CreateNewRequest( 'ACS_NPC_Special_Dash_Attacked_Rotate' );
				movementAdjustorNPC.AdjustmentDuration( ticketNPC, 0.5 );
				movementAdjustorNPC.MaxRotationAdjustmentSpeed( ticketNPC, 50000 );

				dmg = new W3DamageAction in theGame.damageMgr;
				
				dmg.Initialize(thePlayer, actortarget, NULL, thePlayer.GetName(), EHRT_Heavy, CPS_Undefined, false, false, true, false);
				
				dmg.SetProcessBuffsIfNoDamage(true);
				
				dmg.SetIgnoreImmortalityMode(false);

				dmg.SetHitAnimationPlayType(EAHA_ForceYes);
	
				if (actortarget.UsesVitality()) 
				{
					vampireDmgValSteel = thePlayer.GetTotalWeaponDamage(item_steel, theGame.params.DAMAGE_NAME_SLASHING, GetInvalidUniqueId()) 
					+ thePlayer.GetTotalWeaponDamage(item_steel, theGame.params.DAMAGE_NAME_PIERCING, GetInvalidUniqueId())
					+ thePlayer.GetTotalWeaponDamage(item_steel, theGame.params.DAMAGE_NAME_BLUDGEONING, GetInvalidUniqueId());

					dmg.AddDamage( theGame.params.DAMAGE_NAME_PHYSICAL, 50 + vampireDmgValSteel );

					dmg.AddDamage( theGame.params.DAMAGE_NAME_PHYSICAL, 50 + ((actortarget.GetMaxHealth() - actortarget.GetCurrentHealth()) * 0.33) );
				} 
				else if (actortarget.UsesEssence()) 
				{
					vampireDmgValSilver = thePlayer.GetTotalWeaponDamage(item_silver, theGame.params.DAMAGE_NAME_SILVER, GetInvalidUniqueId()); 

					dmg.AddDamage( theGame.params.DAMAGE_NAME_SILVER, 50 + vampireDmgValSilver );

					dmg.AddDamage( theGame.params.DAMAGE_NAME_SILVER, 50 + ((actortarget.GetMaxHealth() - actortarget.GetCurrentHealth()) * 0.33) );
				}

				dmg.SetHitReactionType( EHRT_Heavy );

				dmg.SetForceExplosionDismemberment();

				//dmg.AddEffectInfo( EET_Stagger, 0.5 );

				GetWitcherPlayer().SoundEvent("monster_dettlaff_monster_vein_hit_blood");

				GetWitcherPlayer().SoundEvent("proc_slash_wf_acs");

				actortarget.PlayEffectSingle('blood');
				actortarget.StopEffect('blood');

				actortarget.PlayEffectSingle('death_blood');
				actortarget.StopEffect('death_blood');

				actortarget.PlayEffectSingle('heavy_hit');
				actortarget.StopEffect('heavy_hit');

				actortarget.PlayEffectSingle('light_hit');
				actortarget.StopEffect('light_hit');

				actortarget.PlayEffectSingle('blood_spill');
				actortarget.StopEffect('blood_spill');

				Player_Blood_Covered_Effect(actortarget);
	
				dmg.SetCriticalHit(); theGame.damageMgr.ProcessAction( dmg );
					
				delete dmg;	
			}
		}
	}

	////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	// Dance of Wrath

	private var vACS_Dance_Of_Wrath 	: cACS_Dance_Of_Wrath;

	function ACSDanceOfWrath()
	{
		ACS_SlowMoAdjustable(0.3, 0.375f);

		ACS_ExplorationDelayHack(false, 3);

		ACS_Tutorial_Display_Check('ACS_Dance_Of_Wrath_Tutorial_Shown');

		RemoveTimer('RemoveContinuousTicket');

		MovementAdjust('dash_attack');

		CreateFastSprintTrail('red');

		if( actor && ACS_AttitudeCheck ( actor ) && thePlayer.IsInCombat())
		{
			if ( ACS_Settings_Main_Int('acs_target_settings','acs_target_mode', 0) == 0 || ACS_Settings_Main_Int('acs_target_settings','acs_target_mode', 0) == 1 )
			{
				if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTowards( ticket, actor );}  
			}
			else if ( ACS_Settings_Main_Int('acs_target_settings','acs_target_mode', 0) == 2 )
			{
				if (thePlayer.IsHardLockEnabled())
				{
					if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTowards( ticket, actor );}  
				}
				else
				{
					if(!thePlayer.HasTag('ACS_Manual_Combat_Control')){thePlayer.AddTag('ACS_Manual_Combat_Control');} RemoveTimer('Manual_Combat_Control_Remove'); AddTimer('Manual_Combat_Control_Remove', 2 , false);//if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTo( ticket, VecHeading( theCamera.GetCameraDirection() ) );}
				}	
			}
		}

		thePlayer.ACS_ClearAnimationSpeedMultipliers();

		if (thePlayer.HasTag('ACS_Dual_Wield_Active'))
		{
			if(RandF() < 0.5)
			{
				PlayerPlayAnimation( 'woman_ciri_sword_special_heavy_attack_charge_start_rp_ACS');	
			}
			else
			{
				PlayerPlayAnimation( 'woman_ciri_sword_special_heavy_attack_charge_start_lp_ACS');	
			}
		}
		else
		{
			if(RandF() < 0.5)
			{
				PlayerPlayAnimation( 'woman_ciri_sword_special_blink_attack_start_rp_ACS');	
			}
			else
			{
				PlayerPlayAnimation( 'woman_ciri_sword_special_blink_attack_start_lp_ACS');	
			}
		}
		

		thePlayer.RaiseEvent('ACS_ForceHandClosedR');

		ACS_Attack_Trail('fast_attack_buff');

		ACS_Attack_Trail('fast_attack_buff_hit');

		if( thePlayer.GetTarget() 
		&& GetAttitudeBetween( ((CNewNPC)(thePlayer.GetTarget())), GetWitcherPlayer() ) == AIA_Hostile
		&& ((CNewNPC)(thePlayer.GetTarget())).IsAlive()
		&& thePlayer.IsInCombat()
		)
		{
			GetWitcherPlayer().AddTag('ACS_In_Dance_Of_Wrath');

			thePlayer.SetImmortalityMode( AIM_Invulnerable, AIC_Default, true ); 
			thePlayer.SetCanPlayHitAnim(false); 
			thePlayer.EnableCharacterCollisions(false); 
			thePlayer.AddBuffImmunity_AllNegative('acs_dance_of_wrath', true); 
			thePlayer.SetIsCurrentlyDodging(true);

			GetWitcherPlayer().BlockAction( EIAB_Crossbow, 			'acs_dance_of_wrath');
			GetWitcherPlayer().BlockAction( EIAB_CallHorse,			'acs_dance_of_wrath');
			GetWitcherPlayer().BlockAction( EIAB_Signs, 			'acs_dance_of_wrath');
			GetWitcherPlayer().BlockAction( EIAB_DrawWeapon, 		'acs_dance_of_wrath'); 
			GetWitcherPlayer().BlockAction( EIAB_FastTravel, 		'acs_dance_of_wrath');
			GetWitcherPlayer().BlockAction( EIAB_Fists, 			'acs_dance_of_wrath');
			GetWitcherPlayer().BlockAction( EIAB_InteractionAction, 'acs_dance_of_wrath');
			GetWitcherPlayer().BlockAction( EIAB_UsableItem,		'acs_dance_of_wrath');
			GetWitcherPlayer().BlockAction( EIAB_ThrowBomb,			'acs_dance_of_wrath');
			GetWitcherPlayer().BlockAction( EIAB_SwordAttack,		'acs_dance_of_wrath');
			GetWitcherPlayer().BlockAction( EIAB_Jump,				'acs_dance_of_wrath');
			GetWitcherPlayer().BlockAction( EIAB_LightAttacks,		'acs_dance_of_wrath');
			GetWitcherPlayer().BlockAction( EIAB_HeavyAttacks,		'acs_dance_of_wrath');
			GetWitcherPlayer().BlockAction( EIAB_SpecialAttackLight,'acs_dance_of_wrath');
			GetWitcherPlayer().BlockAction( EIAB_SpecialAttackHeavy,'acs_dance_of_wrath');
			GetWitcherPlayer().BlockAction( EIAB_Dodge,				'acs_dance_of_wrath');
			GetWitcherPlayer().BlockAction( EIAB_Roll,				'acs_dance_of_wrath');
			GetWitcherPlayer().BlockAction( EIAB_Parry,				'acs_dance_of_wrath');
			GetWitcherPlayer().BlockAction( EIAB_MeditationWaiting,	'acs_dance_of_wrath');
			GetWitcherPlayer().BlockAction( EIAB_OpenMeditation,	'acs_dance_of_wrath');
			GetWitcherPlayer().BlockAction( EIAB_RadialMenu,		'acs_dance_of_wrath');
			GetWitcherPlayer().BlockAction( EIAB_Interactions, 		'acs_dance_of_wrath');

			RemoveTimer('HeavenlyStrikeLightningTimer');
			AddTimer( 'HeavenlyStrikeLightningTimer', 0.25, false );

			RemoveTimer('DanceOfWrathActivateTimer');
			AddTimer( 'DanceOfWrathActivateTimer', 0.75, false );

			RemoveTimer('DanceOfWrathFailsafeReleaseTimer');
			AddTimer( 'DanceOfWrathFailsafeReleaseTimer', 3, false );

			theGame.CreateNoSaveLock( "ACS_Dance_Of_Wrath_State", ACS_Dance_Of_Wrath_Savelock_ID, false, false );
		}
		else
		{
			thePlayer.RaiseEvent('ACS_ForceHandClosedREnd');
		}
	}

	function ReleaseDanceOfWrathSavelock()
	{
		ACSGetCEntityDestroyAll('ACS_Player_Fast_Sprint_Trail');

		theGame.ReleaseNoSaveLock( ACS_Dance_Of_Wrath_Savelock_ID );
	}

	timer function DanceOfWrathActivateTimer(dt : float, id : int)
	{
		ACS_ExplorationDelayHack(false, 3);

		thePlayer.RaiseEvent('ACS_ForceHandClosedREnd');

		vACS_Dance_Of_Wrath = new cACS_Dance_Of_Wrath in this;
	
		vACS_Dance_Of_Wrath.ACS_Dance_Of_Wrath_Engage();
	}

	timer function DanceOfWrathFailsafeReleaseTimer(dt : float, id : int)
	{
		if(GetWitcherPlayer().HasTag('ACS_In_Dance_Of_Wrath'))
		{
			ReleaseDanceOfWrathSavelock();

			GetWitcherPlayer().DestroyEffect('dodge_acs_armor');

			GetWitcherPlayer().StopEffect('bruxa_dash_trails');
			
			if( GetWitcherPlayer().IsAlive()) {GetWitcherPlayer().ACS_ClearAnimationSpeedMultipliers();}

			GetWitcherPlayer().EnableCharacterCollisions(true);
			GetWitcherPlayer().SetImmortalityMode( AIM_None, AIC_Default, true );
			GetWitcherPlayer().SetCanPlayHitAnim(true);
			GetWitcherPlayer().RemoveBuffImmunity_AllNegative('acs_dance_of_wrath');

			GetWitcherPlayer().UnblockAction( EIAB_Crossbow, 			'acs_dance_of_wrath');
			GetWitcherPlayer().UnblockAction( EIAB_CallHorse,			'acs_dance_of_wrath');
			GetWitcherPlayer().UnblockAction( EIAB_Signs, 				'acs_dance_of_wrath');
			GetWitcherPlayer().UnblockAction( EIAB_DrawWeapon, 			'acs_dance_of_wrath'); 
			GetWitcherPlayer().UnblockAction( EIAB_FastTravel, 			'acs_dance_of_wrath');
			GetWitcherPlayer().UnblockAction( EIAB_Fists, 				'acs_dance_of_wrath');
			GetWitcherPlayer().UnblockAction( EIAB_InteractionAction, 	'acs_dance_of_wrath');
			GetWitcherPlayer().UnblockAction( EIAB_UsableItem,			'acs_dance_of_wrath');
			GetWitcherPlayer().UnblockAction( EIAB_ThrowBomb,			'acs_dance_of_wrath');
			GetWitcherPlayer().UnblockAction( EIAB_SwordAttack,			'acs_dance_of_wrath');
			GetWitcherPlayer().UnblockAction( EIAB_Jump,				'acs_dance_of_wrath');
			GetWitcherPlayer().UnblockAction( EIAB_LightAttacks,		'acs_dance_of_wrath');
			GetWitcherPlayer().UnblockAction( EIAB_HeavyAttacks,		'acs_dance_of_wrath');
			GetWitcherPlayer().UnblockAction( EIAB_SpecialAttackLight,	'acs_dance_of_wrath');
			GetWitcherPlayer().UnblockAction( EIAB_SpecialAttackHeavy,	'acs_dance_of_wrath');
			GetWitcherPlayer().UnblockAction( EIAB_Dodge,				'acs_dance_of_wrath');
			GetWitcherPlayer().UnblockAction( EIAB_Roll,				'acs_dance_of_wrath');
			GetWitcherPlayer().UnblockAction( EIAB_Parry,				'acs_dance_of_wrath');
			GetWitcherPlayer().UnblockAction( EIAB_MeditationWaiting,	'acs_dance_of_wrath');
			GetWitcherPlayer().UnblockAction( EIAB_OpenMeditation,		'acs_dance_of_wrath');
			GetWitcherPlayer().UnblockAction( EIAB_RadialMenu,			'acs_dance_of_wrath');
			GetWitcherPlayer().UnblockAction( EIAB_Interactions, 		'acs_dance_of_wrath');

			GetWitcherPlayer().RemoveTag('ACS_In_Dance_Of_Wrath');
		}
	}

	////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	// Attack Setup

	function PrimarySecondaryWeaponSwitch(attack_name : name)
	{
		switch ( attack_name )
		{
			case 'DualWieldLightAttack':
			case 'DualWieldHeavyAttack':
			break;
			
			case 'ArmigerModeSpearHeavyAttack':
			case 'ArmigerModeAxeHeavyAttack':
			case 'ArmigerModeGregHeavyAttack':
			case 'ArmigerModeHammerHeavyAttack':
			case 'FocusModeSpearLightAttack':
			case 'FocusModeJinguBangLightAttack':
			case 'HybridModeSpearLightAttack':
			case 'HybridModeSpearForwardLightAttack':
			case 'FocusModeGregLightAttack':
			case 'HybridModeGregLightAttack':
			case 'HybridModeGregForwardLightAttack':
			case 'FocusModeGiantLightAttack':
			case 'HybridModeGiantLightAttack':
			case 'HybridModeGiantForwardLightAttack':
			case 'FocusModeAxeLightAttack':
			case 'HybridModeAxeLightAttack':
			case 'HybridModeAxeForwardLightAttack':
			case 'FocusModeGiantHeavyAttack':
			case 'HybridModeGiantHeavyAttack':
			case 'HybridModeGiantForwardHeavyAttack':
			case 'FocusModeAxeHeavyAttack':
			case 'HybridModeAxeHeavyAttack':
			case 'HybridModeAxeForwardHeavyAttack':
			case 'FocusModeSpearHeavyAttack':
			case 'FocusModeJinguBangHeavyAttack':
			case 'HybridModeSpearHeavyAttack':
			case 'HybridModeSpearForwardHeavyAttack':
			case 'FocusModeGregHeavyAttack':
			case 'HybridModeGregHeavyAttack':
			case 'HybridModeGregForwardHeavyAttack':
			case 'FocusModeSpearSpecialAttack':
			case 'FocusModeJinguBangSpecialAttack':
			case 'HybridModeSpearSpecialAttack':
			case 'HybridModeSpearForwardSpecialAttack':
			case 'FocusModeGregSpecialAttack':
			case 'HybridModeGregSpecialAttack':
			case 'HybridModeGregForwardSpecialAttack':
			case 'FocusModeGiantSpecialAttack':
			case 'HybridModeGiantSpecialAttack':
			case 'HybridModeGiantForwardSpecialAttack':
			case 'FocusModeAxeSpecialAttack':
			case 'HybridModeAxeSpecialAttack':
			case 'HybridModeAxeForwardSpecialAttack':
			case 'HybridModeGregCounterActual':
			case 'HybridModeAxeCounterActual':
			case 'HybridModeImlerithCounterActual':
			case 'HybridModeGiantCounterActual':
			SecondaryWeaponSwitch();
			break;

			case 'HybridModeSpearCounterActual':
			case 'HybridModeOlgierdCounterActual':
			case 'HybridModeClawCounterActual':
			case 'HybridModeEredinShieldCounterActual':
			case 'GeraltDualWieldSpecialLightAttack':
			case 'GeraltWolfLightAttack':
			case 'GeraltWolfHeavyAttack':
			case 'GeraltBearLightAttack':
			case 'GeraltBearHeavyAttack':
			case 'GeraltBearSpecialLightAttack':
			case 'GeraltCatLightAttack':
			case 'GeraltCatHeavyAttack':
			case 'GeraltCatSpecialLightAttack':
			case 'GeraltGriffinLightAttack':
			case 'GeraltGriffinHeavyAttack':
			case 'GeraltGriffinSpecialLightAttack':
			case 'GeraltManticoreLightAttack':
			case 'GeraltManticoreHeavyAttack':
			case 'GeraltManticoreSpecialLightAttack':
			case 'GeraltViperLightAttack':
			case 'GeraltViperHeavyAttack':
			case 'GeraltViperSpecialLightAttack':
			case 'GeraltForgottenWolfLightAttack':
			case 'GeraltForgottenWolfHeavyAttack':
			case 'GeraltACSArmorAlphaLightAttack':
			case 'GeraltACSArmorOmegaLightAttack':
			case 'GeraltACSArmorAlphaHeavyAttack':
			case 'GeraltACSArmorOmegaHeavyAttack':
			case 'GeraltCiriLightAttack':
			case 'GeraltCiriHeavyAttack':
			case 'GeraltCiriSpecialLightAttack':
			case 'GeraltDefaultModeLightAttack':
			case 'GeraltDefaultModeHeavyAttack':
			case 'GeraltOverrideModeLightAttack':
			case 'GeraltOverrideModeHeavyAttack':
			case 'GeraltVampireClawSwordHybridLightAttack':
			case 'GeraltVampireClawSwordHybridHeavyAttack':
			case 'GeraltVampireClawSwordHybridSpecialAttack':
			case 'ArmigerModeOlgierdLightAttack':
			case 'ArmigerModeClawLightAttack':
			case 'ArmigerModeEredinLightAttack':
			case 'ArmigerModeImlerithLightAttack':
			case 'FocusModeOlgierdLightAttack':
			case 'EquipmentModeOlgierdLightAttack':
			case 'HybridModeOlgierdLightAttack':
			case 'HybridModeOlgierdForwardLightAttack':
			case 'FocusModeClawLightAttack':
			case 'HybridModeClawLightAttack':
			case 'HybridModeClawForwardLightAttack':
			case 'FocusModeEredinShieldLightAttack':
			case 'HybridModeEredinShieldLightAttack':
			case 'HybridModeEredinShieldForwardLightAttack':
			case 'FocusModeImlerithLightAttack':
			case 'HybridModeImlerithLightAttack':
			case 'HybridModeImlerithForwardLightAttack':
			case 'FocusModeMageLightAttack':
			case 'FocusModeMageHeavyAttack':
			case 'FocusModeOlgierdHeavyAttack':
			case 'HybridModeOlgierdHeavyAttack':
			case 'HybridModeOlgierdForwardHeavyAttack':
			case 'FocusModeEredinShieldHeavyAttack':
			case 'HybridModeEredinShieldHeavyAttack':
			case 'HybridModeEredinShieldForwardHeavyAttack':
			case 'FocusModeImlerithHeavyAttack':
			case 'HybridModeImlerithHeavyAttack':
			case 'HybridModeImlerithForwardHeavyAttack':
			case 'FocusModeClawHeavyAttack':
			case 'HybridModeClawHeavyAttack':
			case 'HybridModeClawForwardHeavyAttack':
			case 'ArmigerModeEredinShieldSpecialAttack':
			case 'ArmigerModeOlgierdSpecialAttack':
			case 'ArmigerModeClawSpecialAttack':
			case 'ArmigerModeImlerithSpecialAttack':
			case 'FocusModeEredinShieldSpecialAttack':
			case 'HybridModeEredinShieldSpecialAttack':
			case 'HybridModeEredinShieldForwardSpecialAttack':
			case 'FocusModeOlgierdSpecialAttack':
			case 'EquipmentModeOlgierdSpecialAttack':
			case 'HybridModeOlgierdSpecialAttack':
			case 'HybridModeOlgierdForwardSpecialAttack':
			case 'FocusModeClawSpecialAttack':
			case 'HybridModeClawSpecialAttack':
			case 'HybridModeClawForwardSpecialAttack':
			case 'FocusModeImlerithSpecialAttack':
			case 'HybridModeImlerithSpecialAttack':
			case 'HybridModeImlerithForwardSpecialAttack':
			case 'FocusModeMageSpecialAttack':
			PrimaryWeaponSwitch();
			break;

			default:
			break;
		}
	}

	function Attack_Setup_01( attack_name : name )
	{	
		ACS_ExplorationDelayHack(false, 3);

		finisherActorTarget = (CActor)( thePlayer.GetTarget() );	
		ccomp = finisherActorTarget.GetComponent("Finish");
		ccompEnabled = ccomp.IsEnabled();

		if (
		ccompEnabled
		&& ACS_AttitudeCheck (finisherActorTarget)
		&& VecDistanceSquared2D( thePlayer.GetWorldPosition(), finisherActorTarget.GetNearestPointInBothPersonalSpaces( thePlayer.GetWorldPosition() ) ) < 2.75f * 2.75f
		)
		{
			PrimarySecondaryWeaponSwitch ( attack_name );

			ACS_Setup_Light_Attack_Internal();
		}
		else
		{
			if ( ACS_Settings_Main_Bool('acs_stamina_settings','acs_stamina_block_action', false) 
			&& StaminaCheck('default')
			)
			{
				RemoveTimer('SwordTauntSwitch'); RemoveTimer('SwordTauntRunningSwitch');   if (thePlayer.HasTag('ACS_IsSwordWalking')){thePlayer.RemoveTag('ACS_IsSwordWalking');} if(thePlayer.IsInCombat()){if(thePlayer.GetCombatIdleStance() <= 0.f ){thePlayer.RaiseEvent('ACS_CombatTauntLeft');}else{thePlayer.RaiseEvent('ACS_CombatTauntRight');}} thePlayer.SoundEvent("gui_no_stamina");
			}
			else
			{
				switch ( attack_name )
				{
					case 'HybridModeGiantCounterActual':
					if (ACS_can_perform_guard_attack())
					{
						ACS_refresh_guard_attack_cooldown();

						SecondaryWeaponSwitch();

						Attack_Process_06('geraltRandomGiantCounter');

						ACS_StaminaDrain(1);
					}
					break;

					case 'HybridModeImlerithCounterActual':
					if (ACS_can_perform_guard_attack())
					{
						ACS_refresh_guard_attack_cooldown();
						
						PrimaryWeaponSwitch();
																
						Attack_Process_03('geraltRandomYrdenCounter');	

						ACS_StaminaDrain(1);
					}
					break;

					case 'JinguBangCounter':
					if (ACS_can_perform_guard_attack())
					{
						ACS_refresh_guard_attack_cooldown();

						Attack_Process_06('geraltRandomGiantCounter');

						ACS_StaminaDrain(1);
					}
					break;

					case 'YrdenCounterActual':
					if (ACS_can_perform_guard_attack())
					{
						ACS_refresh_guard_attack_cooldown();

						if (thePlayer.HasTag('acs_yrden_sword_equipped'))
						{									
							Attack_Process_03('geraltRandomYrdenCounter');	
						}
						else if (thePlayer.HasTag('acs_yrden_secondary_sword_equipped'))
						{
							

							Attack_Process_06('geraltRandomGiantCounter');
						}

						ACS_StaminaDrain(1);
					}
					break;

					case 'MageCounterActual':
					if (ACS_can_perform_guard_attack())
					{
						ACS_refresh_guard_attack_cooldown();

						if (thePlayer.GetStat( BCS_Focus ) > thePlayer.GetStatMax( BCS_Focus ) * 0
						&& thePlayer.GetStat( BCS_Stamina ) > thePlayer.GetStatMax( BCS_Stamina ) * 0)
						{
							if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	

							RemoveTimer('ACS_ResetAnimation');

							Attack_Process_03('geraltRandomMageCounter');
						}
						else
						{
							if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	

							RemoveTimer('ACS_ResetAnimation');
							
							Attack_Process_03('geraltRandomYrdenCounter');	
						}

						ACS_StaminaDrain(1);
					}	
					break;

					case 'HybridModeSpearCounterActual':
					if (ACS_can_perform_guard_attack())
					{
						ACS_refresh_guard_attack_cooldown();

						SecondaryWeaponSwitch();
						
						Attack_Process_04('geraltRandomSpearCounter');

						thePlayer.ACS_SetAnimationSpeedMultiplier(1.5  );

						RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5   , false);

						ACS_StaminaDrain(1);
					}
					break;


					
					default:
					break;
				}
				
			}
		}
	}

	function Attack_Setup_02( attack_name : name )
	{	
		ACS_ExplorationDelayHack(false, 3);

		finisherActorTarget = (CActor)( thePlayer.GetTarget() );	
		ccomp = finisherActorTarget.GetComponent("Finish");
		ccompEnabled = ccomp.IsEnabled();

		if (
		ccompEnabled
		&& ACS_AttitudeCheck (finisherActorTarget)
		&& VecDistanceSquared2D( thePlayer.GetWorldPosition(), finisherActorTarget.GetNearestPointInBothPersonalSpaces( thePlayer.GetWorldPosition() ) ) < 2.75f * 2.75f
		)
		{
			PrimarySecondaryWeaponSwitch ( attack_name );

			ACS_Setup_Light_Attack_Internal();
		}
		else
		{
			if ( ACS_Settings_Main_Bool('acs_stamina_settings','acs_stamina_block_action', false) 
			&& StaminaCheck('default')
			)

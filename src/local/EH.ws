		if ( IsPressed(action) )
		{
			if( !processedSwordHold )
			{
				if ( thePlayer.IsActionAllowed(EIAB_DrawWeapon) 
				&& thePlayer.GetBIsInputAllowed() 
				&& thePlayer.GetWeaponHolster().IsMeleeWeaponReady() )
				{
					thePlayer.PushCombatActionOnBuffer( EBAT_Draw_Steel, BS_Pressed );

					if ( thePlayer.GetBIsCombatActionAllowed() )
					{
						thePlayer.ProcessCombatActionBuffer();

						if (silver_group_stance
						|| silver_strong_stance
						|| silver_fast_stance
						|| steel_group_stance
						|| steel_strong_stance
						|| steel_fast_stance
						)
						{
							steel_fast_stance = false;

							steel_group_stance = false;

							steel_strong_stance = false;

							silver_fast_stance = false;

							silver_group_stance = false;

							silver_strong_stance = false;

							vACS_Stance_Switch = new cACS_Stance_Switch in this;
							
							vACS_Stance_Switch.ACS_Stance_Switch_Deactivate_Engage();
						}
					}	
				}

				processedSwordHold = true;
			}
		}

		if( IsReleased(action))
		{
			RemoveTimer('DrawSteelSword');
			RemoveTimer('DrawSilverSword');
			thePlayer.RemoveTimer('ACS_SteelSwordPopupModuleDelay');
		}
	}

	public timer function DrawSteelSword( time : float , id : int )
	{
		var duringCastSign : bool;

		if( !processedSwordHold )
		{
			if ( thePlayer.IsActionAllowed(EIAB_DrawWeapon) && thePlayer.GetBIsInputAllowed() && thePlayer.GetWeaponHolster().IsMeleeWeaponReady() )
			{
				thePlayer.PushCombatActionOnBuffer( EBAT_Draw_Steel, BS_Pressed );

				if ( thePlayer.GetBIsCombatActionAllowed() || duringCastSign )
				{
					thePlayer.ProcessCombatActionBuffer();
				}
			}

			if (silver_group_stance
			|| silver_strong_stance
			|| silver_fast_stance
			|| steel_group_stance
			|| steel_strong_stance
			|| steel_fast_stance
			)
			{
				steel_fast_stance = false;

				steel_group_stance = false;

				steel_strong_stance = false;

				silver_fast_stance = false;

				silver_group_stance = false;

				silver_strong_stance = false;

				vACS_Stance_Switch = new cACS_Stance_Switch in this;
				
				vACS_Stance_Switch.ACS_Stance_Switch_Deactivate_Engage();
			}

			processedSwordHold = true;
		}
	}
	
	event OnCommSilverSword( action : SInputAction )
	{
		var duringCastSign 																	: bool;
		var ent           																	: CEntity; 
		var hud 																			: CR4ScriptedHud;
		var controlsFeedbackModule 															: CR4HudModuleControlsFeedback;	

		if (FactsQuerySum("acs_transformation_activated") > 0)
		{
			if(IsPressed(action))
			{
				ACS_ExplorationDelayHack(false, 3);

				if (FactsQuerySum("acs_giant_curse_activated") > 0&& !ACSGetCActor('ACS_Transformation_Giant').HasTag('ACS_Transformation_Giant_Block_All_Actions'))
				{
					if (thePlayer.GetStat(BCS_Focus) >= thePlayer.GetStatMax( BCS_Focus ) * 0.9875)
					{
						GetTransformationGiantClass().TransformationGiantBehSwitch_Engage();

						GetTransformationGiantClass().TransformationGiantLightningStrike_Engage();
					}
				}

				if (FactsQuerySum("acs_vampire_monster_transformation_activated") > 0)
				{
					if(theGame.GetEngineTimeAsSeconds() - last_transformation_special_attack_time > transformation_special_attack_cooldown)
					{
						last_transformation_special_attack_time = theGame.GetEngineTimeAsSeconds();

						ACS_VampireMonsterArmorSwitch();
					}
				}
			}

			return false;
		}

		if ( theInput.LastUsedGamepad() && (theInput.IsActionPressed('Alternate') || theInput.GetActionValue('ACSToggleWearablesMode') > 0.5) )
		{
			return false;
		}


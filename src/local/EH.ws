							}
						break;

						case 1:
						case 2:
							if (!steel_strong_stance 
							&& !steel_group_stance
							&& !steel_fast_stance
							)
							{
								ShowSwordStanceNotification(ent,  GetLocStringById(2116581193));

								steel_fast_stance = true;
							}
							else if ( !steel_strong_stance 
							&& !steel_group_stance
							&& steel_fast_stance
							)
							{

								{
									Attack_Process_19('geraltRandomEredinSpecialAttackAlt');

									if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	
										
									if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier(1.5  ); }
									
									RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.75   , false);
										
									AddTimer('ACS_portable_aard', 1.75 , false );
								}
								else
								{
									Attack_Process_19('geraltRandomEredinSpecialAttack');

									if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	
										
									if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier(1.75  ); }
									
									RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5   , false);
								}
							}

							ACS_StaminaDrain(3);
						
					}
					break;

					case 'HybridModeEredinShieldSpecialAttack':
					if ( ACS_can_perform_special_attack() )
					{
						
							ACS_refresh_special_attack_cooldown();

							thePlayer.BreakPheromoneEffect();	

							PrimaryWeaponSwitch();
									
							if (thePlayer.IsGuarded() && thePlayer.HasTag('acs_axii_sword_equipped'))
							{
								Attack_Process_18('geraltRandomShieldSpecialAttack');
									
								AddTimer('ACS_portable_aard', 0.5   , false);
							}
							else
							{
								Attack_Process_19('geraltRandomEredinSpecialAttack');

								if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	
										
								if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier(1.75  ); }
									
								RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5   , false);
							}

							ACS_StaminaDrain(3);
						
					}
					break;

					case 'HybridModeEredinShieldForwardSpecialAttack':
					if ( ACS_can_perform_special_attack() )
					{
						
							ACS_refresh_special_attack_cooldown();

							thePlayer.BreakPheromoneEffect();	

							PrimaryWeaponSwitch();
									
							if (thePlayer.IsGuarded() && thePlayer.HasTag('acs_axii_sword_equipped'))
							{
								Attack_Process_18('geraltRandomShieldSpecialAttackAlt');
							}
							else
							{
								Attack_Process_19('geraltRandomEredinSpecialAttackAlt');

								if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	
										
								if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier(1.5  ); }
									
								RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.75   , false);
										
								AddTimer('ACS_portable_aard', 1.75 , false );			
							}

							ACS_StaminaDrain(3);
						
					}
					break;


					
					default:
					break;
				}
				
			}
		}
	}
	
	function Attack_Setup_21( attack_name : name )
	{	
		ACS_ExplorationDelayHack(false, 3);

		finisherActorTarget = (CActor)( thePlayer.GetTarget() );	
		ccomp = finisherActorTarget.GetComponent("Finish");
		ccompEnabled = ccomp.IsEnabled();

		if (
		ccompEnabled
		&& ACS_AttitudeCheck (finisherActorTarget)
		&& VecDistanceSquared2D( thePlayer.GetWorldPosition(), finisherActorTarget.GetNearestPointInBothPersonalSpaces( thePlayer.GetWorldPosition() ) ) < 2.75f * 2.75f
		)
		{
			PrimarySecondaryWeaponSwitch ( attack_name );

			ACS_Setup_Light_Attack_Internal();
		}
		else
		{
			if ( ACS_Settings_Main_Bool('acs_stamina_settings','acs_stamina_block_action', false) 
			&& StaminaCheck('default')
			)
			{
				RemoveTimer('SwordTauntSwitch'); RemoveTimer('SwordTauntRunningSwitch');   if (thePlayer.HasTag('ACS_IsSwordWalking')){thePlayer.RemoveTag('ACS_IsSwordWalking');} if(thePlayer.IsInCombat()){if(thePlayer.GetCombatIdleStance() <= 0.f ){thePlayer.RaiseEvent('ACS_CombatTauntLeft');}else{thePlayer.RaiseEvent('ACS_CombatTauntRight');}} thePlayer.SoundEvent("gui_no_stamina");
			}
			else
			{
				switch ( attack_name )
				{
					case 'FocusModeOlgierdSpecialAttack':
					if ( ACS_can_perform_special_attack() )
					{
						
							ACS_refresh_special_attack_cooldown();
								
							thePlayer.BreakPheromoneEffect();	

							PrimaryWeaponSwitch(); 
									
							if (Attack_Directional_Press_Check())
							{
								if (thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus ) * 0.9875
								//&& thePlayer.GetStat( BCS_Stamina ) == thePlayer.GetStatMax( BCS_Stamina )
								&& theInput.GetActionValue(DodgeOrRoll()) > 0.7)
								{
									ACS_Tutorial_Display_Check('ACS_Weapon_Arts_Tutorial_Shown');

									RemoveTimer('RollDelay');

									Umbral_Slash_End();

									thePlayer.DrainStamina( ESAT_FixedValue, thePlayer.GetStatMax( BCS_Stamina ) );

									thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) );
								}
								else
								{
									Attack_Process_16('geraltRandomOlgierdSpecialAttackAlt');
								}
							}
							else
							{
								Attack_Process_16('geraltRandomOlgierdSpecialAttack');

								if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	

								if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier( 2 ); }	
								
								AddTimer('ACS_ResetAnimation', 0.4     , false);
							}

							ACS_StaminaDrain(3);
						
					}
					break;

					case 'EquipmentModeOlgierdSpecialAttack':
					if ( ACS_can_perform_special_attack() )
					{
						
							ACS_refresh_special_attack_cooldown();
								
							thePlayer.BreakPheromoneEffect();	

							PrimaryWeaponSwitch(); 
									
							if (Attack_Directional_Press_Check()
							&& thePlayer.GetInventory().ItemHasTag( thePlayer.GetInventory().GetCurrentlyHeldSword(), 'OlgierdSabre' ))
							{
								if (thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus ) * 0.9875
								//&& thePlayer.GetStat( BCS_Stamina ) == thePlayer.GetStatMax( BCS_Stamina )
								&& theInput.GetActionValue(DodgeOrRoll()) > 0.7)
								{
									ACS_Tutorial_Display_Check('ACS_Weapon_Arts_Tutorial_Shown');

									RemoveTimer('RollDelay');

									Umbral_Slash_End();

									thePlayer.DrainStamina( ESAT_FixedValue, thePlayer.GetStatMax( BCS_Stamina ) );

									thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) );
								}
								else
								{
									Attack_Process_16('geraltRandomOlgierdSpecialAttackAlt');
								}
							}
							else
							{
								Attack_Process_16('geraltRandomOlgierdSpecialAttack');

								if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	

								if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier( 2 ); }	
								
								AddTimer('ACS_ResetAnimation', 0.4     , false);
							}

							ACS_StaminaDrain(3);
						
					}
					break;

					case 'HybridModeOlgierdSpecialAttack':
					if ( ACS_can_perform_special_attack() )
					{
						
							ACS_refresh_special_attack_cooldown();
								
							thePlayer.BreakPheromoneEffect();	

							PrimaryWeaponSwitch();	

							Attack_Process_16('geraltRandomOlgierdSpecialAttack'); 				

							if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}				

							if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier( 2 ); }	
								
							AddTimer('ACS_ResetAnimation', 0.4     , false);

							ACS_StaminaDrain(3);
						
					}
					break;

					case 'HybridModeOlgierdForwardSpecialAttack':
					if ( ACS_can_perform_special_attack() )
					{
						
							ACS_refresh_special_attack_cooldown();
								
							thePlayer.BreakPheromoneEffect();	
								
							PrimaryWeaponSwitch();
								
							if (thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus ) * 0.9875
							//&& thePlayer.GetStat( BCS_Stamina ) == thePlayer.GetStatMax( BCS_Stamina )
							&& theInput.GetActionValue(DodgeOrRoll()) > 0.7)
							{
								ACS_Tutorial_Display_Check('ACS_Weapon_Arts_Tutorial_Shown');

								RemoveTimer('RollDelay');

								Umbral_Slash_End();

								thePlayer.DrainStamina( ESAT_FixedValue, thePlayer.GetStatMax( BCS_Stamina ) );

								thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) );
							}
							else
							{
								Attack_Process_16('geraltRandomOlgierdSpecialAttackAlt');
							}

							//if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	
												
							//if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier(1.75  ); }	
								
							//RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.75   , false);	

							ACS_StaminaDrain(3);
						
					}
					break;

					case 'FocusModeClawSpecialAttack':
					if ( ACS_can_perform_special_attack() )
					{
						
							ACS_refresh_special_attack_cooldown();
								
							thePlayer.BreakPheromoneEffect();	

							PrimaryWeaponSwitch(); 
									
							if (Attack_Directional_Press_Check())
							{
								Attack_Process_07('geraltRandomClawSpecialAttackAlt');

								//if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	
									
								//if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier(1.75  ); }	
								
								//RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.75   , false);
							}
							else
							{
								Attack_Process_07('geraltRandomClawSpecialAttack');
							}

							ACS_StaminaDrain(3);
						
					}
					break;

					case 'HybridModeClawSpecialAttack':
					if ( ACS_can_perform_special_attack() )
					{
						
							ACS_refresh_special_attack_cooldown();
								
							thePlayer.BreakPheromoneEffect();	

							PrimaryWeaponSwitch();

							Attack_Process_07('geraltRandomClawSpecialAttack');

							ACS_StaminaDrain(3);
						
					}
					break;


					
					default:
					break;
				}
				
			}
		}
	}


	var bigShipAnimProcess : bool;

	timer function BigShipAnimProcessReset ( dt : float, id : int)
	{
		bigShipAnimProcess = false;
	}

	var bigShipforwardAnim, bigShipbackwardAnim, bigShipleftAnim, bigShiprighAnim, bigShipforwardRighAnim, bigShipforwardLeftAnim, bigShipbackwardRighAnim, bigShipbackwardLeftAnim, bigShipstationaryAnim, bigShipAccelerateAnim : bool;

	function ShipControls()
	{
		var vehicle							: CEntity;
		var accelerate 						: float;
		var pos 							: Vector;
		var rot, camRot						: EulerAngles;
		var z 								: float;
		var ent					            : CEntity;

		if (!thePlayer.IsUsingVehicle())
		{
			if (bigShipforwardAnim)
			{
				bigShipforwardAnim = false;
			}

			if (bigShipbackwardAnim)
			{
				bigShipbackwardAnim = false;
			}

			if (bigShipleftAnim)
			{
				bigShipleftAnim = false;
			}

			if (bigShiprighAnim)
			{
				bigShiprighAnim = false;
			}

			if (bigShipforwardRighAnim)
			{
				bigShipforwardRighAnim = false;
			}

			if (bigShipforwardLeftAnim)
			{
				bigShipforwardLeftAnim = false;
			}

			if (bigShipbackwardRighAnim)
			{
				bigShipbackwardRighAnim = false;
			}

			if (bigShipbackwardLeftAnim)
			{
				bigShipbackwardLeftAnim = false;
			}
			
			if (bigShipstationaryAnim)
			{
				bigShipstationaryAnim = false;
			}

			return;
		}

		if (thePlayer.IsUsingVehicle())
		{
			vehicle = thePlayer.GetUsedVehicle();

			if (vehicle.HasTag('ACS_Player_Merchant_Ship') || vehicle.HasTag('ACS_Player_Ghost_Ship'))
			{
				accelerate = theInput.GetActionValue( 'GI_Accelerate' );

				if (!bigShipAnimProcess)
				{
					if (theInput.GetActionValue('GI_Accelerate') != 0)
					{
						if (!bigShipAccelerateAnim)
						{
							thePlayer.RaiseEvent('ACS_BigShipAnimYou');

							bigShipAccelerateAnim = true;
						}
					}
					else
					{
						if (bigShipAccelerateAnim)
						{
							thePlayer.RaiseEvent('ACS_BigShipAnimHandwave');

							bigShipAccelerateAnim = false;
						}
					}

					if(FactsQuerySum("ACS_AutoSail_Active") > 0)
					{
						if(FactsQuerySum("ACS_Ship_Crew_Sing") > 0)
						{
							BigShipSing();
						}
					}

					if (theInput.GetActionValue('GI_AxisLeftY') > 0.1 && theInput.GetActionValue('GI_AxisLeftX') == 0)
					{
						if (bigShipbackwardAnim)
						{
							bigShipbackwardAnim = false;
						}

						if (bigShipleftAnim)
						{
							bigShipleftAnim = false;
						}

						if (bigShiprighAnim)
						{
							bigShiprighAnim = false;
						}

						if (bigShipforwardRighAnim)
						{
							bigShipforwardRighAnim = false;
						}

						if (bigShipforwardLeftAnim)
						{
							bigShipforwardLeftAnim = false;
						}

						if (bigShipbackwardRighAnim)
						{
							bigShipbackwardRighAnim = false;
						}

						if (bigShipbackwardLeftAnim)
						{
							bigShipbackwardLeftAnim = false;
						}
						
						if (bigShipstationaryAnim)
						{
							bigShipstationaryAnim = false;
						}
						
						if (!bigShipforwardAnim)
						{
							thePlayer.RaiseEvent('ACS_BigShipAnimPointForward');

							bigShipforwardAnim = true;
						}
					}
					else if (theInput.GetActionValue('GI_AxisLeftY') < -0.1 && theInput.GetActionValue('GI_AxisLeftX') == 0)
					{
						if (bigShipforwardAnim)
						{
							bigShipforwardAnim = false;
						}

						if (bigShipleftAnim)
						{
							bigShipleftAnim = false;
						}

						if (bigShiprighAnim)
						{
							bigShiprighAnim = false;
						}

						if (bigShipforwardRighAnim)
						{
							bigShipforwardRighAnim = false;
						}

						if (bigShipforwardLeftAnim)
						{
							bigShipforwardLeftAnim = false;
						}

						if (bigShipbackwardRighAnim)
						{
							bigShipbackwardRighAnim = false;
						}

						if (bigShipbackwardLeftAnim)
						{
							bigShipbackwardLeftAnim = false;
						}
						
						if (bigShipstationaryAnim)
						{
							bigShipstationaryAnim = false;
						}
						
						if (!bigShipbackwardAnim)
						{
							thePlayer.RaiseEvent('ACS_BigShipAnimHandwave');

							bigShipbackwardAnim = true;
						}
					}
					else if (theInput.GetActionValue('GI_AxisLeftX') > 0.1 && theInput.GetActionValue('GI_AxisLeftY') == 0)
					{
						if (bigShipforwardAnim)
						{
							bigShipforwardAnim = false;
						}

						if (bigShipbackwardAnim)
						{
							bigShipbackwardAnim = false;
						}

						if (bigShipleftAnim)
						{
							bigShipleftAnim = false;
						}

						if (bigShipforwardRighAnim)
						{
							bigShipforwardRighAnim = false;
						}

						if (bigShipforwardLeftAnim)
						{
							bigShipforwardLeftAnim = false;
						}

						if (bigShipbackwardRighAnim)
						{
							bigShipbackwardRighAnim = false;
						}

						if (bigShipbackwardLeftAnim)
						{
							bigShipbackwardLeftAnim = false;
						}
						
						if (bigShipstationaryAnim)
						{
							bigShipstationaryAnim = false;
						}
						
						if (!bigShiprighAnim)
						{
							thePlayer.RaiseEvent('ACS_BigShipAnimLeanLeft');
						
							bigShiprighAnim = true;
						}
					}
					else if (theInput.GetActionValue('GI_AxisLeftX') < -0.1 && theInput.GetActionValue('GI_AxisLeftY') == 0)
					{
						if (bigShipforwardAnim)
						{
							bigShipforwardAnim = false;
						}

						if (bigShipbackwardAnim)
						{
							bigShipbackwardAnim = false;
						}

						if (bigShiprighAnim)
						{
							bigShiprighAnim = false;
						}

						if (bigShipforwardRighAnim)
						{
							bigShipforwardRighAnim = false;
						}

						if (bigShipforwardLeftAnim)
						{
							bigShipforwardLeftAnim = false;
						}

						if (bigShipbackwardRighAnim)
						{
							bigShipbackwardRighAnim = false;
						}

						if (bigShipbackwardLeftAnim)
						{
							bigShipbackwardLeftAnim = false;
						}

						if (bigShipstationaryAnim)
						{
							bigShipstationaryAnim = false;
						}
						
						if (!bigShipleftAnim)
						{
							thePlayer.RaiseEvent('ACS_BigShipAnimLeanRight');

							bigShipleftAnim = true;
						}
					}
					else if (theInput.GetActionValue('GI_AxisLeftX') > 0.1 && theInput.GetActionValue('GI_AxisLeftY') > 0.1)
					{
						if (bigShipforwardAnim)
						{
							bigShipforwardAnim = false;
						}

						if (bigShipbackwardAnim)
						{
							bigShipbackwardAnim = false;
						}

						if (bigShiprighAnim)
						{
							bigShiprighAnim = false;
						}

						if (bigShipleftAnim)
						{
							bigShipleftAnim = false;
						}

						if (bigShipforwardLeftAnim)
						{
							bigShipforwardLeftAnim = false;
						}

						if (bigShipbackwardRighAnim)
						{
							bigShipbackwardRighAnim = false;
						}

						if (bigShipbackwardLeftAnim)
						{
							bigShipbackwardLeftAnim = false;
						}

						if (bigShipstationaryAnim)
						{
							bigShipstationaryAnim = false;
						}

						if (!bigShipforwardRighAnim)
						{
							thePlayer.RaiseEvent('ACS_BigShipAnimLeanLeft');
						
							bigShipforwardRighAnim = true;
						}
					}
					else if (theInput.GetActionValue('GI_AxisLeftX') < -0.1 && theInput.GetActionValue('GI_AxisLeftY') > 0.1)
					{
						if (bigShipforwardAnim)
						{
							bigShipforwardAnim = false;
						}

						if (bigShipbackwardAnim)
						{
							bigShipbackwardAnim = false;
						}

						if (bigShiprighAnim)
						{
							bigShiprighAnim = false;
						}

						if (bigShipleftAnim)
						{
							bigShipleftAnim = false;
						}

						if (bigShipforwardRighAnim)
						{
							bigShipforwardRighAnim = false;
						}

						if (bigShipbackwardRighAnim)
						{
							bigShipbackwardRighAnim = false;
						}

						if (bigShipbackwardLeftAnim)
						{
							bigShipbackwardLeftAnim = false;
						}

						if (bigShipstationaryAnim)
						{
							bigShipstationaryAnim = false;
						}
						
						if (!bigShipforwardLeftAnim)
						{
							thePlayer.RaiseEvent('ACS_BigShipAnimLeanRight');

							bigShipforwardLeftAnim = true;
						}
					}
					else if (theInput.GetActionValue('GI_AxisLeftX') > 0.1 && theInput.GetActionValue('GI_AxisLeftY') < -0.1)
					{
						if (bigShipforwardAnim)
						{
							bigShipforwardAnim = false;
						}

						if (bigShipbackwardAnim)
						{
							bigShipbackwardAnim = false;
						}

						if (bigShiprighAnim)
						{
							bigShiprighAnim = false;
						}

						if (bigShipleftAnim)
						{
							bigShipleftAnim = false;
						}

						if (bigShipforwardRighAnim)
						{
							bigShipforwardRighAnim = false;
						}

						if (bigShipforwardLeftAnim)
						{
							bigShipforwardLeftAnim = false;
						}

						if (bigShipbackwardLeftAnim)
						{
							bigShipbackwardLeftAnim = false;
						}

						if (bigShipstationaryAnim)
						{
							bigShipstationaryAnim = false;
						}
						
						if (!bigShipbackwardRighAnim)
						{
							thePlayer.RaiseEvent('ACS_BigShipAnimLeanLeft');
						
							bigShipbackwardRighAnim = true;
						}
					}
					else if (theInput.GetActionValue('GI_AxisLeftX') < -0.1 && theInput.GetActionValue('GI_AxisLeftY') <- 0.1)
					{
						if (bigShipforwardAnim)
						{
							bigShipforwardAnim = false;
						}

						if (bigShipbackwardAnim)
						{
							bigShipbackwardAnim = false;
						}

						if (bigShiprighAnim)
						{
							bigShiprighAnim = false;
						}

						if (bigShipleftAnim)
						{
							bigShipleftAnim = false;
						}

						if (bigShipforwardRighAnim)
						{
							bigShipforwardRighAnim = false;
						}

						if (bigShipforwardLeftAnim)
						{
							bigShipforwardLeftAnim = false;
						}

						if (bigShipbackwardRighAnim)
						{
							bigShipbackwardRighAnim = false;
						}

						if (bigShipstationaryAnim)
						{
							bigShipstationaryAnim = false;
						}
						
						if (!bigShipbackwardLeftAnim)
						{
							thePlayer.RaiseEvent('ACS_BigShipAnimLeanRight');

							bigShipbackwardLeftAnim = true;
						}
					}
					else
					{
						if (bigShipforwardAnim)
						{
							bigShipforwardAnim = false;
						}

						if (bigShipbackwardAnim)
						{
							bigShipbackwardAnim = false;
						}

						if (bigShipleftAnim)
						{
							bigShipleftAnim = false;
						}

						if (bigShiprighAnim)
						{
							bigShiprighAnim = false;
						}

						if (bigShipforwardRighAnim)
						{
							bigShipforwardRighAnim = false;
						}

						if (bigShipforwardLeftAnim)
						{
							bigShipforwardLeftAnim = false;
						}

						if (bigShipbackwardRighAnim)
						{
							bigShipbackwardRighAnim = false;
						}

						if (bigShipbackwardLeftAnim)
						{
							bigShipbackwardLeftAnim = false;
						}

						if (!bigShipstationaryAnim)
						{
							thePlayer.RaiseEvent('ACS_BigShipAnimPointDown');

							bigShipstationaryAnim = true;
						}
					}
				}
				else
				{
					if (bigShipforwardAnim)
					{
						bigShipforwardAnim = false;
					}

					if (bigShipbackwardAnim)
					{
						bigShipbackwardAnim = false;
					}

					if (bigShipleftAnim)
					{
						bigShipleftAnim = false;
					}

					if (bigShiprighAnim)
					{
						bigShiprighAnim = false;
					}

					if (bigShipforwardRighAnim)
					{
						bigShipforwardRighAnim = false;
					}

					if (bigShipforwardLeftAnim)
					{
						bigShipforwardLeftAnim = false;
					}

					if (bigShipbackwardRighAnim)
					{
						bigShipbackwardRighAnim = false;
					}

					if (bigShipbackwardLeftAnim)
					{
						bigShipbackwardLeftAnim = false;
					}
					
					if (bigShipstationaryAnim)
					{
						bigShipstationaryAnim = false;
					}
				}
			}
		}
	}

	var troll_line_01, troll_line_02, troll_line_03, troll_line_04, troll_line_05, troll_line_06, troll_line_07, troll_line_08 : bool;

	default troll_line_01 = false;
	default troll_line_02 = false;
	default troll_line_03 = false;
	default troll_line_04 = false;
	default troll_line_05 = false;
	default troll_line_06 = false;
	default troll_line_07 = false;
	default troll_line_08 = false;

	var troll_sing_cooldown, troll_sing_cooldown_refresh : float;

	default troll_sing_cooldown_refresh = 9;

	function BigShipSing()
	{
		var actors 											: array<CActor>;
		var i												: int;

		if (thePlayer.IsInCombat())
		{
			return;
		}

		if (theGame.GetEngineTimeAsSeconds() - troll_sing_cooldown > troll_sing_cooldown_refresh)
		{
			troll_sing_cooldown = theGame.GetEngineTimeAsSeconds();
		
			actors.Clear();

			theGame.GetActorsByTag( 'ACS_BigShipTrollCrew' , actors );	

			if (actors.Size() <= 0)
			{
				return;
			}
			
			for( i = 0; i < actors.Size(); i += 1 )
			{
				((ACSBigShipTrollCrew)actors[i]).RemoveTimer( 'troll_play_line');
				((ACSBigShipTrollCrew)actors[i]).AddTimer( 'troll_play_line', RandRangeF(0.75, 0.5) , false);
			}

			if (!troll_line_01
			&& !troll_line_02
			&& !troll_line_03
			&& !troll_line_04
			&& !troll_line_05
			&& !troll_line_06
			&& !troll_line_07
			)
			{
				//last
				troll_sing_cooldown_refresh = 30;

				troll_line_01 = true;
			}
			else if (troll_line_01
			&& !troll_line_02
			&& !troll_line_03
			&& !troll_line_04
			&& !troll_line_05
			&& !troll_line_06
			&& !troll_line_07
			)
			{
				//second
				troll_sing_cooldown_refresh = 8.5;

				troll_line_01 = false;
				troll_line_02 = true;
			}
			else if (!troll_line_01
			&& troll_line_02
			&& !troll_line_03
			&& !troll_line_04
			&& !troll_line_05
			&& !troll_line_06
			&& !troll_line_07)
			{
				//third
				troll_sing_cooldown_refresh = 9;

				troll_line_02 = false;
				troll_line_03 = true;
			}
			else if (!troll_line_01
			&& !troll_line_02
			&& troll_line_03
			&& !troll_line_04
			&& !troll_line_05
			&& !troll_line_06
			&& !troll_line_07)
			{
				//fourth
				troll_sing_cooldown_refresh = 30;

				troll_line_03 = false;
				troll_line_04 = true;
			}
			else if (!troll_line_01
			&& !troll_line_02
			&& !troll_line_03
			&& troll_line_04
			&& !troll_line_05
			&& !troll_line_06
			&& !troll_line_07)
			{
				troll_sing_cooldown_refresh = 6;

				troll_line_04 = false;
				troll_line_05 = true;
			}
			else if (!troll_line_01
			&& !troll_line_02
			&& !troll_line_03
			&& !troll_line_04
			&& troll_line_05
			&& !troll_line_06
			&& !troll_line_07)
			{
				troll_sing_cooldown_refresh = 6;

				troll_line_05 = false;
				troll_line_06 = true;
			}
			else if (!troll_line_01
			&& !troll_line_02
			&& !troll_line_03
			&& !troll_line_04
			&& !troll_line_05
			&& troll_line_06
			&& !troll_line_07)
			{
				troll_sing_cooldown_refresh = 5;

				troll_line_06 = false;
				troll_line_07 = true;
			}
			else if (!troll_line_01
			&& !troll_line_02
			&& !troll_line_03
			&& !troll_line_04
			&& !troll_line_05
			&& !troll_line_06
			&& troll_line_07)
			{
				//first
				troll_sing_cooldown_refresh = 6;

				troll_line_07 = false;
			}
		}
	}

	function BigShipLaunchProjectile()
	{
		var actors 											: array<CActor>;
		var i												: int;
		
		actors.Clear();

		theGame.GetActorsByTag( 'ACS_BigShipTrollCrew' , actors );	

		if (actors.Size() <= 0)
		{
			return;
		}
		
		for( i = 0; i < actors.Size(); i += 1 )
		{
			((ACSBigShipTrollCrew)actors[i]).ThrowProjectileStart();
		}
	}

	function ForceSheathWeaponNoAnim()
	{
		var steelid, silverid 																			: SItemUniqueId;

		GetWitcherPlayer().GetItemEquippedOnSlot(EES_SilverSword, silverid);

		GetWitcherPlayer().GetItemEquippedOnSlot(EES_SteelSword, steelid);

		if ( thePlayer.GetInventory().IsItemHeld(silverid) )
		{
			thePlayer.GetInventory().UnmountItem( silverid, true );

			thePlayer.GetInventory().MountItem( silverid , false );
		}

		if ( thePlayer.GetInventory().IsItemHeld(steelid) )
		{
			thePlayer.GetInventory().UnmountItem( steelid, true );

			thePlayer.GetInventory().MountItem( steelid, false );
		}
	}

	var trophy_slap_cooldown : float;

	var use_horse_trophy : bool;

	function SetUseHorseTrophy(b : bool)
	{
		use_horse_trophy = b;
	}

	var trophy_name_to_use : string;

	function SetTrophyNameToUse(trophy_name : string)
	{
		trophy_name_to_use = trophy_name;
	}

	timer function DelayTrophyEquipStart ( dt : float, id : int)
	{
		RemoveTimer('DelayTrophyEquip');
		AddTimer('DelayTrophyEquip', 0.0001, true);
	}

	timer function DelayTrophyEquip ( dt : float, id : int)
	{
		var itemId							: SItemUniqueId;	
		
		if(
		!theGame.IsDialogOrCutscenePlaying() 
		&& !thePlayer.IsInNonGameplayCutscene() 
		&& !thePlayer.IsInGameplayScene()
		&& !theGame.GetPhotomodeEnabled() 
		&& !thePlayer.IsInCutsceneIntro() 
		&& !theGame.IsCurrentlyPlayingNonGameplayScene() 
		&& !theGame.IsFading()
		&& !theGame.IsBlackscreen()
		)
		{
			thePlayer.EquipItem( thePlayer.inv.GetItemId('acs_trophy_item'));
			GetWitcherPlayer().SelectQuickslotItem( EES_Quickslot1 );

			itemId = thePlayer.GetSelectedItemId();

			if(GetWitcherPlayer().IsItemEquippedByName('acs_trophy_item') 
			&& thePlayer.GetInventory().GetItemName( itemId ) == 'acs_trophy_item' )
			{
				GetACSWatcher().SetUseHorseTrophy(false);
				thePlayer.SetPlayerActionToRestore ( PATR_Default );
				thePlayer.OnUseSelectedItem();
			}

			RemoveTimer('DelayTrophyEquip');
		}
	}

	event OnCbtThrowItem( action : SInputAction )
	{			
		var isUsableItem, isCrossbow, isBomb, ret : bool;
		var itemId							: SItemUniqueId;		
		var movementAdjustor1				: CMovementAdjustor;
		var ticket1							: SMovementAdjustmentRequestTicket;
		var entity                          : CEntity;
		var temp1, temp2                  	: CEntityTemplate;
		var path1, path2                   	: String;
		var component 						: CInteractionComponent;
		var horseComponent					: W3HorseComponent;
		var horseEntity						: CEntity;
		var boatEntity						: W3Boat;
		var vehicle							: CEntity;
		var horse 							: CNewNPC;
		var distance_from_horse				: float;

		horse = thePlayer.GetHorseWithInventory();

		if (thePlayer.IsUsingVehicle())
		{
			vehicle = thePlayer.GetUsedVehicle();

			if (vehicle.HasTag('ACS_Player_Merchant_Ship') || vehicle.HasTag('ACS_Player_Ghost_Ship'))
			{
				if( IsPressed(action) && !bigShipAnimProcess)
				{
					RemoveTimer('BigShipAnimProcessReset');
					AddTimer('BigShipAnimProcessReset', 3 , false);

					BigShipLaunchProjectile();

					thePlayer.RaiseEvent('ACS_BigShipAnimQuestion');

					bigShipAnimProcess = true;
				}

				return false;
			}
		}

		itemId = thePlayer.GetSelectedItemId();

		if (thePlayer.HasTag('ACS_IsSwordWalking'))
		{
			thePlayer.RemoveTag('ACS_IsSwordWalking');
		}
		
		if (IsPressed(action))
		{
			thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');RemoveTimer('CombatTauntDelay');

			ResetFastWalk();

			thePlayer.RaiseEvent('ACS_IdleAdditiveReset');

			if (idleAdditiveExtraActive)
			{
				SetIdleAdditiveExtraStatus(false);
			}
		}

		//SwordWalkAdditiveEnd(action);

		thePlayer.UnblockAction( EIAB_Crossbow, 			'BombThrow');
		thePlayer.UnblockAction( EIAB_ThrowBomb, 			'BombThrow');

		if ( GetWitcherPlayer().IsItemEquippedByName('acs_trophy_item') 
		&& thePlayer.GetInventory().GetItemName( itemId ) == 'acs_trophy_item' 
		)
		{
			if( IsPressed(action))
			{
				use_horse_trophy = true;

				horse = thePlayer.GetHorseWithInventory();

				distance_from_horse = VecDistanceSquared2D( thePlayer.GetWorldPosition(), horse.GetWorldPosition() );

				if (
				distance_from_horse > 5 * 5
				|| GetWitcherPlayer().GetHorseManager().GetItemInSlot(EES_HorseTrophy) == GetInvalidUniqueId()
				)
				{
					if (theGame.GetEngineTimeAsSeconds() - trophy_slap_cooldown > 1)
					{
						trophy_slap_cooldown = theGame.GetEngineTimeAsSeconds();

						thePlayer.RaiseEvent('ACS_ThrowDagger');

						RemoveTimer('ACS_HeadbuttDamage');	
						AddTimer('ACS_HeadbuttDamage', 0.3   , false);	
					}

					return false;
				}
			}
		}

		if ( GetWitcherPlayer().IsItemEquippedByName('ACS_Azkar') 
		&& thePlayer.GetInventory().GetItemName( itemId ) == 'ACS_Azkar' 
		)
		{
			if( IsPressed(action))
			{
				if (FactsQuerySum("ACS_Azkar_Active") <= 0 )
				{
					if (thePlayer.HasTag('ACS_Flammable_Oil_Enabled')
					|| thePlayer.GetBehaviorVariable('alternateWalk') != 0
					|| thePlayer.GetBehaviorVariable('proudWalk') != 0
					|| ACSGetCActor('ACS_Gravehag_Tongue_Weapon_R')
					|| ACS_GetItem_Sword_IsEquipped('knife_steel', 'steel')
					|| ACS_Vampire_Claws_Access()
					|| ACS_IS_SNEAKING
					|| thePlayer.HasTag('ACS_Is_Sneaking'))
					{
						return false;
					}

					ACS_Tutorial_Display_Check('ACS_Azkar_Tutorial_Shown');

					FactsAdd("ACS_Azkar_Active", 1, -1);
				}
				else if (FactsQuerySum("ACS_Azkar_Active") > 0)
				{


					FactsRemove("ACS_Azkar_Active");
				}
			}

			return false;
		}

		if ( GetWitcherPlayer().IsItemEquippedByName('ACS_Slayer') 
		&& thePlayer.GetInventory().GetItemName( itemId ) == 'ACS_Slayer' 
		)
		{
			if( IsPressed(action))
			{
				if (FactsQuerySum("ACS_Slayer_Active") <= 0 )
				{
					if (thePlayer.HasTag('ACS_Flammable_Oil_Enabled')
					|| thePlayer.GetBehaviorVariable('alternateWalk') != 0
					|| thePlayer.GetBehaviorVariable('proudWalk') != 0
					|| ACSGetCActor('ACS_Gravehag_Tongue_Weapon_R')
					|| ACS_GetItem_Sword_IsEquipped('knife_steel', 'steel')
					|| ACS_Vampire_Claws_Access()
					|| ACS_IS_SNEAKING
					|| thePlayer.HasTag('ACS_Is_Sneaking'))
					{
						return false;
					}

					ACS_Tutorial_Display_Check('ACS_Slayer_Tutorial_Shown');

					FactsAdd("ACS_Slayer_Active", 1, -1);
				}
				else if (FactsQuerySum("ACS_Slayer_Active") > 0)
				{


					FactsRemove("ACS_Slayer_Active");
				}
			}

			return false;
		}

		if (FactsQuerySum("acs_transformation_activated") > 0)
		{
			ACS_ExplorationDelayHack(false, 3);

			if (FactsQuerySum("acs_vampireess_transformation_activated") > 0)
			{
				if (ACSGetCActor('ACS_Transformation_Vampiress').HasTag('ACS_Vampiress_Sorceress_Mode'))
				{
					if( IsPressed(action))
					{
						if( theInput.GetActionValue('Sprint') > 0.1f )
						{
							ACS_Transformation_Vampiress_Toggle_Next_Special();
						}
						else
						{

							ACS_Transformation_Vampiress_Toggle_Previous_Special();
						}

						ACS_Transformation_Vampiress_Hand_FX_Refresh();
					}
				}

				if (ACSGetCActor('ACS_Transformation_Vampiress').HasTag('ACS_Transformation_Bruxa'))
				{
					if( IsPressed(action))
					{
						ACS_Transformation_Vampiress_Bruxa_Scream();
					}
				}
			}

			if (FactsQuerySum("acs_vampire_monster_transformation_activated") > 0)
			{
				if(theInput.GetActionValue('Sprint'))
				{
					return false;
				}

				if( IsPressed(action))
				{
					if (!ACSGetCActor('ACS_Transformation_Vampire_Monster').HasTag('ACS_Transformation_Vampire_Monster_Camo_Active'))
					{
						ACSGetCActor('ACS_Transformation_Vampire_Monster').DestroyEffect('disappear_');
						ACSGetCActor('ACS_Transformation_Vampire_Monster').PlayEffectSingle('disappear_');

						ACSGetCActor('ACS_Transformation_Vampire_Monster').AddTag('ACS_Transformation_Vampire_Monster_Camo_Active');
					}
				}

				if( IsReleased(action))
				{
					if (ACSGetCActor('ACS_Transformation_Vampire_Monster').HasTag('ACS_Transformation_Vampire_Monster_Camo_Active'))
					{
						ACSGetCActor('ACS_Transformation_Vampire_Monster').DestroyEffect('disappear_');

						ACSGetCActor('ACS_Transformation_Vampire_Monster').RemoveTag('ACS_Transformation_Vampire_Monster_Camo_Active');
					}
				}
			}

			return false;
		}

		if (FactsQuerySum("ACS_Leviathan_Axe_Thrown") > 0)
		{
			if (FactsQuerySum("ACS_Leviathan_Axe_Returning") <= 0)
			{
				movementAdjustor1 = GetWitcherPlayer().GetMovingAgentComponent().GetMovementAdjustor();
				movementAdjustor1.CancelByName( 'ACS_Leviathan_Throw_Movement_Adjust' );
				ticket1 = movementAdjustor1.CreateNewRequest( 'ACS_Leviathan_Throw_Movement_Adjust' );
				movementAdjustor1.AdjustmentDuration( ticket1, 0.25 );
					
				if (!GetWitcherPlayer().IsUsingHorse() && !GetWitcherPlayer().IsUsingVehicle()) 
				{
					movementAdjustor1.RotateTowards( ticket1, GetACSLeviathan() );
				}  

				if (RandF() < 0.5)
				{
					PlayerPlayAnimation('man_ger_sword_axii_release_rp');
				}
				else
				{
					PlayerPlayAnimation('man_ger_sword_axii_release_lp');
				}

				if (thePlayer.HasTag('ACS_IsSwordWalking'))
				{
					thePlayer.RemoveTag('ACS_IsSwordWalking');
				}

				RemoveTimer('SwordTauntSwitch'); 
				RemoveTimer('SwordTauntRunningSwitch'); 
				 
				thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');

				thePlayer.RaiseEvent('LootHerb');

				lootherbanimprogress = true;

				RemoveTimer('LootHerbAnimProgressComplete');
				AddTimer('LootHerbAnimProgressComplete', 1 , false);
				
				RemoveTimer('LeviathanAxeReturn');
				AddTimer('LeviathanAxeReturn', 0.5 , false);

				FactsAdd("ACS_Leviathan_Axe_Returning", 1, -1);
			}

			return false;
		}

		if ( GetWitcherPlayer().IsItemEquippedByName('acs_cbs_item') 
		&& thePlayer.GetInventory().GetItemName( itemId ) == 'acs_cbs_item' )
		{
			if (IsPressed(action))
			{
				if (!AnimProgressCheck())
				{
					return false;
				}

				thePlayer.SoundEvent("monster_dettlaff_monster_movement_wing_flap_short_soft");

				thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');

				thePlayer.RaiseEvent('ACS_CloakEnabled');

				if ( thePlayer.IsHoldingItemInLHand() ) 
				{
					thePlayer.OnUseSelectedItem( true );
				}

				if ( thePlayer.IsCrossbowHeld() ) 
				{
					thePlayer.OnRangedForceHolster( false, true );
				}

				cloakaniminprogress = true;

				RemoveTimer('CloakAnimProgressSet');
				AddTimer('CloakAnimProgressSet', 2 , false);

				if (theInput.GetActionValue('Sprint') > 0.1f
				)
				{
					switch(GetWitcherPlayer().GetEquippedSign())
					{
						case ST_Aard:
						ACS_SaveAppearance(4);
						break;

						case ST_Axii:
						ACS_SaveAppearance(3);
						break;

						case ST_Igni:
						ACS_SaveAppearance(2);
						break;

						case ST_Quen:
						ACS_SaveAppearance(1);
						break;

						case ST_Yrden:
						ACS_SaveAppearance(0);
						break;

						default:
						ACS_SaveAppearance(0);
						break;
					}
				}
				else
				{
					switch(GetWitcherPlayer().GetEquippedSign())
					{
						case ST_Aard:
						ACS_LoadAppearance(4);
						break;

						case ST_Axii:
						ACS_LoadAppearance(3);
						break;

						case ST_Igni:
						ACS_LoadAppearance(2);
						break;

						case ST_Quen:
						ACS_LoadAppearance(1);
						break;

						case ST_Yrden:
						ACS_LoadAppearance(0);
						break;

						default:
						ACS_LoadAppearance(0);
						break;
					}
				}
			}

			return false;
		}

		if ( GetWitcherPlayer().IsItemEquippedByName('acs_dual_wield_item') 
		&& thePlayer.GetInventory().GetItemName( itemId ) == 'acs_dual_wield_item' )
		{
			if (IsPressed(action))
			{
				if( 
				!DualWieldRequirements()
				) 
				{
					return false;
				}

				if ( FactsQuerySum("ACS_Dual_Wield_Toggle_Enabled") > 0 )
				{
					if (!thePlayer.HasTag('ACS_Dual_Wield_Active'))
					{
						thePlayer.AddTag('ACS_Dual_Wield_Active');
					}
				}
				else
				{
					vACS_Stance_Switch = new cACS_Stance_Switch in this;

					vACS_Stance_Switch.ACS_Dual_Wield_Switch_Deactivate_Engage();

					if (!ACSGetCEntity('ACS_Viper_Dagger_L')){thePlayer.RaiseEvent('ACS_ForceHandClosedLEnd');}

					thePlayer.RemoveTag('ACS_Dual_Wield_Active');
				}
			}

			return false;
		}

		if ( GetWitcherPlayer().IsItemEquippedByName('acs_spear_transform_item') 
		&& thePlayer.GetInventory().GetItemName( itemId ) == 'acs_spear_transform_item' )
		{
			if (IsPressed(action))
			{
				if( 
				!SpearTransformRequirements()
				) 
				{
					return false;
				}
				
				if ( FactsQuerySum("ACS_Spear_Transform_Toggle_Enabled") > 0 )
				{
					if (!thePlayer.HasTag('ACS_Spear_Transform_Active'))
					{
						thePlayer.AddTag('ACS_Spear_Transform_Active');
					}
				}
				else
				{
					vACS_Stance_Switch = new cACS_Stance_Switch in this;

					vACS_Stance_Switch.ACS_Spear_Transform_Switch_Deactivate_Engage();

					thePlayer.RemoveTag('ACS_Spear_Transform_Active');
				}
			}

			return false;
		}

		if ( GetWitcherPlayer().IsItemEquippedByName('acs_wolven_cross_item') 
		&& thePlayer.GetInventory().GetItemName( itemId ) == 'acs_wolven_cross_item' )
		{
			if (IsPressed(action))
			{
				CombatArtSwitch('wolven_cross');
			}

			return false;
		}

		if ( GetWitcherPlayer().IsItemEquippedByName('acs_wolven_flash_item') 
		&& thePlayer.GetInventory().GetItemName( itemId ) == 'acs_wolven_flash_item' )
		{
			if (IsPressed(action))
			{
				CombatArtSwitch('wolven_flash');
			}

			return false;
		}

		if ( GetWitcherPlayer().IsItemEquippedByName('acs_mortal_draw_item') 
		&& thePlayer.GetInventory().GetItemName( itemId ) == 'acs_mortal_draw_item' )
		{
			if (IsPressed(action))
			{
				CombatArtSwitch('mortal_draw');
			}

			return false;
		}

		if ( GetWitcherPlayer().IsItemEquippedByName('acs_feainnewedd_flower_item') 
		&& thePlayer.GetInventory().GetItemName( itemId ) == 'acs_feainnewedd_flower_item' )
		{
			if (IsPressed(action))
			{
				CombatArtSwitch('feainnewedd_dance');
			}

			return false;
		}

		if ( GetWitcherPlayer().IsItemEquippedByName('acs_one_mind_item') 
		&& thePlayer.GetInventory().GetItemName( itemId ) == 'acs_one_mind_item' )
		{
			if (IsPressed(action))
			{
				CombatArtSwitch('one_mind');
			}

			return false;
		}

		if ( GetWitcherPlayer().IsItemEquippedByName('acs_spiral_cloud_passage_item') 
		&& thePlayer.GetInventory().GetItemName( itemId ) == 'acs_spiral_cloud_passage_item' )
		{
			if (IsPressed(action))
			{
				CombatArtSwitch('spiral_cloud_passage');
			}

			return false;
		}

		if ( GetWitcherPlayer().IsItemEquippedByName('acs_shadowfall_item') 
		&& thePlayer.GetInventory().GetItemName( itemId ) == 'acs_shadowfall_item' )
		{
			if (IsPressed(action))
			{
				CombatArtSwitch('shadowfall');
			}

			return false;
		}

		if ( GetWitcherPlayer().IsItemEquippedByName('acs_mask_item') 
		&& thePlayer.GetInventory().GetItemName( itemId ) == 'acs_mask_item' )
		{
			if (IsPressed(action))
			{
				if (!AnimProgressCheck())
				{
					return false;
				}

				if (!facemasktoggle)
				{
					Facegear_Include();
				}
				else
				{
					Facegear_Exclude();
				}
			}

			return false;
		}

		if ( GetWitcherPlayer().IsItemEquippedByName('acs_hood_item') 
		&& thePlayer.GetInventory().GetItemName( itemId ) == 'acs_hood_item' )
		{
			if (IsPressed(action))
			{
				if (ACS_Armor_Set_Check('acs_armor', false))
				{
					if (hoodtoggle)
					{
						return false;
					}

					if (!AnimProgressCheck())
					{
						return false;
					}

					if (!helmtoggle && FactsQuerySum("acs_transformation_activated") <= 0 && !hoodtoggle)
					{
						thePlayer.PlayEffectSingle('demonic_possession');
						thePlayer.StopEffect('demonic_possession');

						RemoveTimer('ACS_AdditionalHelmetsSpawnDelay');
						RemoveTimer('ACS_AdditionalHelmetsDespawnDelay');

						AddTimer('ACS_AdditionalHelmetsSpawnDelay', 0.75 , false);
					}
					else
					{
						thePlayer.PlayEffectSingle('demonic_possession');
						thePlayer.StopEffect('demonic_possession');

						RemoveTimer('ACS_AdditionalHelmetsSpawnDelay');
						RemoveTimer('ACS_AdditionalHelmetsDespawnDelay');

						AddTimer('ACS_AdditionalHelmetsDespawnDelay', 0.75 , false);
					}
				}
				else
				{
					if (helmtoggle)
					{
						return false;
					}

					if (!AnimProgressCheck())
					{
						return false;
					}

					if (FactsQuerySum("acs_transformation_activated") > 0)
					{
						return false;
					}

					RemoveTimer('Hood_Include_Delay');
					RemoveTimer('Hood_Exclude_Delay');

					if (thePlayer.HasTag('ACS_IsSwordWalking'))
					{
						thePlayer.RemoveTag('ACS_IsSwordWalking');
					}

					if ( thePlayer.IsHoldingItemInLHand() ) 
					{
						thePlayer.OnUseSelectedItem( true );
					}

					if ( thePlayer.IsCrossbowHeld() ) 
					{
						thePlayer.OnRangedForceHolster( false, true );
					}

					hoodaniminprogress = true;

					if( GetWitcherPlayer().IsItemEquippedByName('KM Cloak') 
					|| GetWitcherPlayer().IsItemEquippedByName('KM Cloak Lowered') 
					|| GetWitcherPlayer().IsItemEquippedByName('KM Pointy Cloak') 
					)
					{
						if( GetWitcherPlayer().IsItemEquippedByName('KM Cloak') || GetWitcherPlayer().IsItemEquippedByName('KM Pointy Cloak') )
						{
							thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');

							thePlayer.RaiseEvent('ACS_HoodDisabled');

							AddTimer('Hood_Exclude_Delay', 1.5 , false);
						}
						else if( GetWitcherPlayer().IsItemEquippedByName('KM Cloak Lowered') )
						{
							thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');

							thePlayer.RaiseEvent('ACS_HoodEnabled');

							AddTimer('Hood_Include_Delay', 0.75 , false);
						}
					}
					else
					{
						if (!helmtoggle && !hoodtoggle)
						{
							thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');

							thePlayer.RaiseEvent('ACS_HoodEnabled');

							AddTimer('Hood_Include_Delay', 0.45 , false);
						}
						else
						{
							thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');

							thePlayer.RaiseEvent('ACS_HoodDisabled');

							AddTimer('Hood_Exclude_Delay', 1.5 , false);
						}
					}
				}

				return false;
			}

			return false;
		}

		if ( GetWitcherPlayer().IsItemEquippedByName('acs_shroud_item') 
		&& thePlayer.GetInventory().GetItemName( itemId ) == 'acs_shroud_item' )
		{
			if (IsPressed(action))
			{
				if (!AnimProgressCheck())
				{
					return false;
				}
		
				if (ACS_Armor_Set_Check('acs_armor', false) && FactsQuerySum("acs_transformation_activated") <= 0)
				{
					thePlayer.PlayEffectSingle('special_attack_only_black_fx');
					thePlayer.StopEffect('special_attack_only_black_fx');

					thePlayer.PlayEffectSingle('ethereal_appear');
					thePlayer.StopEffect('ethereal_appear');

					thePlayer.PlayEffectSingle('embers_particles_test');
					thePlayer.StopEffect('embers_particles_test');

					RemoveTimer('ACS_ShoulderToggleDelay');
					AddTimer('ACS_ShoulderToggleDelay', 0.5 , false);
				}
				else
				{
					if (thePlayer.HasTag('ACS_IsSwordWalking'))
					{
						thePlayer.RemoveTag('ACS_IsSwordWalking');
					}

					if ( thePlayer.IsHoldingItemInLHand() ) 
					{
						thePlayer.OnUseSelectedItem( true );
					}

					if ( thePlayer.IsCrossbowHeld() ) 
					{
						thePlayer.OnRangedForceHolster( false, true );
					}

					cloakaniminprogress = true;

					RemoveTimer('CloakAnimProgressSet');
					AddTimer('CloakAnimProgressSet', 2 , false);

					thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');

					if ( theInput.GetActionValue('Focus') > 0.1f )
					{
						CloakToggleOff();

						if (FactsQuerySum("ACS_Force_Weapons_On_Hips") <= 0)
						{
							if (theGame.GetInGameConfigWrapper().GetVarValue('acs_player_equipment_visual_settings', 'acs_swords_positioning_when_cloaked' ) != "1" )
							{
								theGame.GetInGameConfigWrapper().SetVarValue('acs_player_equipment_visual_settings', 'acs_swords_positioning_when_cloaked', "1" );
							}
							
							if (thePlayer.IsAnyWeaponHeld())
							{
								thePlayer.RaiseEvent('ACS_CloakEnabled');
							}
							else
							{
								thePlayer.RaiseEvent('ACS_HolsterSwordHip');
							}
							
							FactsAdd("ACS_Force_Weapons_On_Hips", 1, -1);
						}
						else if (FactsQuerySum("ACS_Force_Weapons_On_Hips") > 0)
						{
							if (theGame.GetInGameConfigWrapper().GetVarValue('acs_player_equipment_visual_settings', 'acs_swords_positioning_when_cloaked' ) != "0" )
							{
								theGame.GetInGameConfigWrapper().SetVarValue('acs_player_equipment_visual_settings', 'acs_swords_positioning_when_cloaked', "0" );
							}
							
							if (thePlayer.IsAnyWeaponHeld())
							{
								thePlayer.RaiseEvent('ACS_CloakEnabled');
							}
							else
							{
								thePlayer.RaiseEvent('ACS_HolsterSwordAlt');
							}

							FactsRemove("ACS_Force_Weapons_On_Hips");
						}

						if (medallion_hold_anim_active)
						{
							thePlayer.RaiseEvent('ACS_MedallionHoldReset');

							medallion_hold_anim_active = false;
						}

						theGame.GetFocusModeController().Deactivate();
					}
					else
					{
						thePlayer.RaiseEvent('ACS_CloakEnabled');

						RemoveTimer('CloakToggleDelay');
						AddTimer('CloakToggleDelay', 0.5 , false);
					}
				}

				return false;
			}

			return false;
		}

		if ( GetWitcherPlayer().IsItemEquippedByName('acs_pocket_dummy_item') 
		&& thePlayer.GetInventory().GetItemName( itemId ) == 'acs_pocket_dummy_item' )
		{
			if (IsPressed(action))
			{
				if (!AnimProgressCheck())
				{
					return false;
				}

				thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');

				if (ACSGetCEntity('ACS_Training_Dummy'))
				{
					AddTimer('AardLightIconSmall', 0.5 , false);

					thePlayer.RaiseEvent('ACS_AardLight');
				}
				else
				{
					AddTimer('IgniLightIconSmall', 0.5 , false);

					thePlayer.RaiseEvent('ACS_IgniLight');
				}

				RemoveTimer('DummySummonDelay');
				AddTimer('DummySummonDelay', 1 , false);
			}

			return false;
		}

		if ( GetWitcherPlayer().IsItemEquippedByName('acs_horse_oil_lamp') 
		&& thePlayer.GetInventory().GetItemName( itemId ) == 'acs_horse_oil_lamp' )
		{
			component = theGame.GetInteractionsManager().GetActiveInteraction();

			if (component
			&& component.IsEnabled()
			&& thePlayer.GetPlayerAction() == PEA_None
			)
			{
				horseEntity = component.GetEntity();
				boatEntity = (W3Boat)component.GetEntity();
			}

			if (IsPressed(action))
			{
				if(horseEntity
				&& horseEntity == thePlayer.GetHorseWithInventory()
				)
				{
					if ( FactsQuerySum("ACS_Lantern_Stowed_On_Horse") <= 0 )
					{
						if ( thePlayer.IsHoldingItemInLHand() ) 
						{
							thePlayer.OnUseSelectedItem( true );
						}

						thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');

						thePlayer.RaiseEvent('ACS_GiveItem');

						FactsAdd("ACS_Lantern_Stowed_On_Horse", 1, -1);
					}
					else if ( FactsQuerySum("ACS_Lantern_Stowed_On_Horse") > 0 )
					{
						thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');

						if( (thePlayer.IsAnyWeaponHeld() && !thePlayer.IsWeaponHeld('fist')) 
						|| thePlayer.GetWeaponHolster().IsOnTheMiddleOfHolstering() 
						)
						{
							thePlayer.RaiseEvent('ACS_LootWithWeapon');
						}
						else
						{
							if (thePlayer.IsHoldingItemInLHand() )
							{
								thePlayer.RaiseEvent('ACS_Loot');
							}
							else
							{
								if (FactsQuerySum("ACS_Loot_Anim_Played") <= 0 )
								{
									thePlayer.RaiseEvent('ACS_Loot');

									FactsAdd("ACS_Loot_Anim_Played", 1, -1);
								}
								else if (FactsQuerySum("ACS_Loot_Anim_Played") > 0 )
								{
									thePlayer.RaiseEvent('ACS_LootWithWeapon');

									FactsRemove("ACS_Loot_Anim_Played");
								}
							}
						}

						FactsRemove("ACS_Lantern_Stowed_On_Horse");
					}

					return false;
				}
				else
				{
					if ( FactsQuerySum("ACS_Lantern_Stowed_On_Horse") > 0 && !boatEntity)
					{
						thePlayer.UnblockAction( EIAB_CallHorse, 'OnCombatActionStart' );

						if( thePlayer.IsActionAllowed( EIAB_CallHorse ) 
						&& !thePlayer.IsInInterior() && !thePlayer.IsInAir())
						{
							if (thePlayer.HasTag('ACS_IsSwordWalking'))
							{
								thePlayer.RemoveTag('ACS_IsSwordWalking');
							}

							RemoveTimer('SwordTauntSwitch'); 
							RemoveTimer('SwordTauntRunningSwitch'); 
							 
							thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');

							thePlayer.RaiseEvent('HorseSummon');

							horsesummonanimprogress = true;

							RemoveTimer('HorseSummonAnimProgressComplete');
							AddTimer('HorseSummonAnimProgressComplete', 1.5 , false);

							RemoveTimer('ACSOnSpawnPlayerHorse');
							AddTimer('ACSOnSpawnPlayerHorse', RandRangeF(1, 0.5) , false);		
						}

						return false;
					}
				}

				if(boatEntity 
				)
				{
					if ( FactsQuerySum("ACS_Lantern_Stowed_On_Boat") <= 0 
					)
					{
						if ( thePlayer.IsHoldingItemInLHand() ) 
						{
							thePlayer.OnUseSelectedItem( true );
						}

						thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');

						thePlayer.RaiseEvent('LootHerb');

						FactsAdd("ACS_Lantern_Stowed_On_Boat", 1, -1);

						boatEntity.ACS_AttachBoatLantern();
					}
					else if ( FactsQuerySum("ACS_Lantern_Stowed_On_Boat") > 0 )
					{
						thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');

						if( (thePlayer.IsAnyWeaponHeld() && !thePlayer.IsWeaponHeld('fist')) 
						|| thePlayer.GetWeaponHolster().IsOnTheMiddleOfHolstering() 
						)
						{
							thePlayer.RaiseEvent('ACS_LootWithWeapon');
						}
						else
						{
							if (thePlayer.IsHoldingItemInLHand() )
							{
								thePlayer.RaiseEvent('ACS_Loot');
							}
							else
							{
								if (FactsQuerySum("ACS_Loot_Anim_Played") <= 0 )
								{
									thePlayer.RaiseEvent('ACS_Loot');

									FactsAdd("ACS_Loot_Anim_Played", 1, -1);
								}
								else if (FactsQuerySum("ACS_Loot_Anim_Played") > 0 )
								{
									thePlayer.RaiseEvent('ACS_LootWithWeapon');

									FactsRemove("ACS_Loot_Anim_Played");
								}
							}
						}

						ACSGetCEntityDestroyAll('ACS_Boat_Oil_Lamp_Anchor');

						ACSGetCEntityDestroyAll('ACS_Boat_Oil_Lamp_Bow');

						ACSGetCEntityDestroyAll('ACS_Boat_Oil_Lamp_Stern');

						FactsRemove("ACS_Lantern_Stowed_On_Boat");
					}

					return false;
				}
			}
		}

		//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

		if( IsPressed(action))
		{
			action_interrupt();

			itemuseanimprogress = true;

			RemoveTimer('ItemUseProgressComplete');
			AddTimer('ItemUseProgressComplete', 3 , false);
		}

		//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

		if ( GetWitcherPlayer().IsItemEquippedByName('acs_babilu_item') 
		&& thePlayer.GetInventory().GetItemName( itemId ) == 'acs_babilu_item' )
		{
			if( IsPressed(action) )
			{
				vACS_GatesOfBabylon = new cACS_GatesOfBabylon in this;
			
				vACS_GatesOfBabylon.cACS_GatesOfBabylon_Engage();
			}

			return false;
		}

		if ( GetWitcherPlayer().IsItemEquippedByName('acs_echinops_turret_item') 
		&& thePlayer.GetInventory().GetItemName( itemId ) == 'acs_echinops_turret_item' )
		{
			if( IsPressed(action) )
			{
				vACS_ArchesporeTurretSwitch = new cACS_ArchesporeTurretSwitch in this;
			
				vACS_ArchesporeTurretSwitch.Engage();
			}

			return false;
		}

		if ( GetWitcherPlayer().IsItemEquippedByName('acs_wooden_flute_item') 
		&& thePlayer.GetInventory().GetItemName( itemId ) == 'acs_wooden_flute_item' )
		{
			if (IsPressed(action) && GetWitcherPlayer().IsAnyWeaponHeld() && !GetWitcherPlayer().IsWeaponHeld('fist'))
			{

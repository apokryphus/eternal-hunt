					meditation_base_rotation.Roll += 0;
					meditation_base_rotation.Pitch += 0;
					meditation_base_rotation.Yaw += 0;
					
					bolt.CreateAttachment( theGame.GetEntityByTag('ACS_Meditation_Base'),,meditation_base_position, meditation_base_rotation );

					bolt.AddTag('ACS_Meditation_Item');	
					bolt.AddTag('ACS_Meditation_Bolt');	
					bolt.AddTag('ACS_Meditation_Primary_Bolt');
					

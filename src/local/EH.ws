			.tag("font")
			.attr("size", "16")
			.attr("color", "#ffffff")
			.text(GetLocStringById(2118449908) + "<br/>" + GetLocStringById(2116581051) + "<br/>" + GetLocStringById(2118449902))
			, anchor1, "ACS_Spear_Transform_Toggle_Notification", Vector(0,0,0), 2);

			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Spear_Transform_Toggle_Notification", 100);

			GetACSStorage().acs_setScaleForOnelinerByTag("ACS_Spear_Transform_Toggle_Notification", 100, 100, 100);

			FactsAdd("ACS_Spear_Transform_Toggle_Enabled", 1, -1);
		}
		else if (FactsQuerySum("ACS_Spear_Transform_Toggle_Enabled") > 0)
		{
			ACS_Oneliner(
			(new ACS_Oneliner_TagBuilder in theGame)
			.tag("font")
			.attr("size", "16")
			.attr("color", "#ffffff")
			.text(GetLocStringById(2118449908) + "<br/>" + GetLocStringById(2116581051) + "<br/>" + GetLocStringById(2118449903))
			, anchor1, "ACS_Spear_Transform_Toggle_Notification", Vector(0,0,0), 2);

			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Spear_Transform_Toggle_Notification", 100);

			GetACSStorage().acs_setScaleForOnelinerByTag("ACS_Spear_Transform_Toggle_Notification", 100, 100, 100);

			RemoveTimer('SpearTransformToggleInitDelay'); 

			FactsRemove("ACS_Spear_Transform_Toggle_Enabled");
		}

		GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Spear_Transform_Toggle_Notification", 100);

		return true;
	}

	timer function TorchDamageDelay( dt : float, id : int )
	{
		var actors																		: array<CActor>;
		var i																			: int;
		var dmg																			: W3DamageAction;
		var actortarget																	: CActor;

		actors.Clear();
			
		actors = thePlayer.GetNPCsAndPlayersInCone(2, VecHeading(thePlayer.GetHeadingVector()), 60, 20, , FLAG_OnlyAliveActors + FLAG_Attitude_Hostile + FLAG_ExcludePlayer );

		if( actors.Size() > 0 )
		{
			for( i = 0; i < actors.Size(); i += 1 )
			{
				actortarget = (CActor)actors[i];

				dmg = new W3DamageAction in theGame.damageMgr;
		
				dmg.Initialize(thePlayer, actortarget, NULL, thePlayer, EHRT_Heavy, CPS_Undefined, false, false, true, false);
				
				if (actortarget.UsesVitality())
				{
					dmg.AddDamage( theGame.params.DAMAGE_NAME_POISON, 50 + actortarget.GetStatMax( BCS_Vitality ) * 0.025 );
				}
				else if (actortarget.UsesEssence())
				{
					dmg.AddDamage( theGame.params.DAMAGE_NAME_POISON, 50 + actortarget.GetStatMax( BCS_Essence ) * 0.025 );
				}

				dmg.AddEffectInfo( EET_Burning, 1 );

				dmg.SetCriticalHit(); theGame.damageMgr.ProcessAction( dmg );
					
				delete dmg;	
			}
		}
	}

	function WitcherMedallionControl()
	{
		var bone_vec											: Vector;
		var bone_rot											: EulerAngles;
		var anchor_temp											: CEntityTemplate;
		var anchor1, anchor2									: CEntity;

		thePlayer.GetBoneWorldPositionAndRotationByIndex( thePlayer.GetBoneIndex( 'torso3' ), bone_vec, bone_rot );

		anchor_temp = (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\entities\other\fx_ent.w2ent", true );
		anchor1 = (CEntity)theGame.CreateEntity( anchor_temp, thePlayer.GetWorldPosition() );
		anchor1.CreateAttachmentAtBoneWS( GetWitcherPlayer(), 'torso3', bone_vec, bone_rot );

		anchor1.DestroyAfter(2);

		if ( (FactsQuerySum("ACS_Wolf_Style_Activate") <= 0 
		|| FactsQuerySum("ACS_Bear_Style_Activate") <= 0
		|| FactsQuerySum("ACS_Cat_Style_Activate") <= 0
		|| FactsQuerySum("ACS_Griffin_Style_Activate") <= 0
		|| FactsQuerySum("ACS_Manticore_Style_Activate") <= 0
		|| FactsQuerySum("ACS_Forgotten_Wolf_Style_Activate") <= 0
		|| FactsQuerySum("ACS_Viper_Style_Activate") <= 0)
		&& (FactsQuerySum("ACS_Dual_Wield_Toggle_Enabled") > 0 || FactsQuerySum("ACS_Spear_Transform_Toggle_Enabled") > 0)
		)
		{
			thePlayer.GetBoneWorldPositionAndRotationByIndex( thePlayer.GetBoneIndex( 'r_hand' ), bone_vec, bone_rot );
			anchor2 = (CEntity)theGame.CreateEntity( anchor_temp, thePlayer.GetWorldPosition() );
			anchor2.CreateAttachmentAtBoneWS( GetWitcherPlayer(), 'r_hand', bone_vec, bone_rot );

			anchor2.DestroyAfter(2);

			if (FactsQuerySum("ACS_Dual_Wield_Toggle_Enabled") > 0)
			{
				ACS_Oneliner(

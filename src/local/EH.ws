	function GeraltHeavyAttackDefault( vamp : bool )
	{
		if (vamp)
		{
			if (combo_counter_geralt_heavy_attack == 0)
			{
				thePlayer.RaiseEvent('ACS_ForceHandClosedRBackhand');

				if (!thePlayer.HasTag('ACS_Dual_Wield_Active') && !ACSGetCEntity('ACS_Viper_Dagger_L')){thePlayer.RaiseEvent('ACS_ForceHandClosedLEnd');}

				PlayerPlayAnimation( 'attack_counter_medium_ACS');

				combo_counter_damage += 1;

				combo_counter_geralt_heavy_attack += 1;
			}
			else if (combo_counter_geralt_heavy_attack == 1)
			{
				thePlayer.RaiseEvent('ACS_ForceHandClosedR');

				thePlayer.RaiseEvent('ACS_ForceHandVampireClawsL');

				PlayerPlayAnimation( 'tw2_short_attack_strong_01_ACS');	

				combo_counter_damage += 1;

				combo_counter_geralt_heavy_attack += 1;
			}
			else if (combo_counter_geralt_heavy_attack == 2)
			{
				
				thePlayer.RaiseEvent('ACS_ForceHandClosedRBackhand');

				if (!thePlayer.HasTag('ACS_Dual_Wield_Active') && !ACSGetCEntity('ACS_Viper_Dagger_L')){thePlayer.RaiseEvent('ACS_ForceHandClosedLEnd');}


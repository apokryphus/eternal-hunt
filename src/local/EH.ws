							Attack_Process_28('geraltRandomGregHeavyAttack'); 			

							if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}				
														
							if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier(1.25  ); }
													
							RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5  , false);	

							ACS_StaminaDrain(2);
						
					}
					break;

					case 'HybridModeGregForwardHeavyAttack':
					if ( ACS_can_perform_heavy_attack() )
					{
						
							ACS_refresh_heavy_attack_cooldown();
								
							thePlayer.BreakPheromoneEffect();
														
							SecondaryWeaponSwitch();
														
							Attack_Process_28('geraltRandomGregHeavyAttackAlt');	 				

							if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}			
														
							if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier(1.25  ); }
							
							RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5  , false);	

							ACS_StaminaDrain(2);	
						
					}
					break;

					case 'FocusModeOlgierdHeavyAttack':
					if ( ACS_can_perform_heavy_attack() )
					{
						
							ACS_refresh_heavy_attack_cooldown();
																				
							thePlayer.BreakPheromoneEffect();
														
							PrimaryWeaponSwitch();
																					
							if (Attack_Directional_Press_Check())
							{
								Attack_Process_15('geraltRandomOlgierdHeavyAttackAlt');

								if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier(1.75  ); }
														
								RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.75   , false);	
							}
							else
							{
								Attack_Process_16('geraltRandomOlgierdHeavyAttack');

								if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	

								if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier(1.75  ); }
														
								RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.75   , false);	
							}

							ACS_StaminaDrain(2);
						
					}
					break;

					
					default:
					break;
				}
				
			}
		}
	}

	function Attack_Setup_18( attack_name : name )
	{	
		ACS_ExplorationDelayHack(false, 3);

		finisherActorTarget = (CActor)( thePlayer.GetTarget() );	
		ccomp = finisherActorTarget.GetComponent("Finish");
		ccompEnabled = ccomp.IsEnabled();

		if (
		ccompEnabled
		&& ACS_AttitudeCheck (finisherActorTarget)
		&& VecDistanceSquared2D( thePlayer.GetWorldPosition(), finisherActorTarget.GetNearestPointInBothPersonalSpaces( thePlayer.GetWorldPosition() ) ) < 2.75f * 2.75f
		)
		{
			PrimarySecondaryWeaponSwitch ( attack_name );

			ACS_Setup_Light_Attack_Internal();
		}
		else
		{
			if ( ACS_Settings_Main_Bool('acs_stamina_settings','acs_stamina_block_action', false) 
			&& StaminaCheck('default')
			)
			{
				RemoveTimer('SwordTauntSwitch'); RemoveTimer('SwordTauntRunningSwitch');   if (thePlayer.HasTag('ACS_IsSwordWalking')){thePlayer.RemoveTag('ACS_IsSwordWalking');} if(thePlayer.IsInCombat()){if(thePlayer.GetCombatIdleStance() <= 0.f ){thePlayer.RaiseEvent('ACS_CombatTauntLeft');}else{thePlayer.RaiseEvent('ACS_CombatTauntRight');}} thePlayer.SoundEvent("gui_no_stamina");
			}
			else
			{
				switch ( attack_name )
				{

					case 'HybridModeOlgierdHeavyAttack':
					if ( ACS_can_perform_heavy_attack() )
					{
						
							ACS_refresh_heavy_attack_cooldown();
								
							thePlayer.BreakPheromoneEffect();
														
							PrimaryWeaponSwitch();
														
							Attack_Process_16('geraltRandomOlgierdHeavyAttack'); 	

							if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}						
														
							if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier(1.75  ); }
														
							RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.75   , false);	

							ACS_StaminaDrain(2);
						
					}
					break;

					case 'HybridModeOlgierdForwardHeavyAttack':
					if ( ACS_can_perform_heavy_attack() )
					{
						
							ACS_refresh_heavy_attack_cooldown();
								
							thePlayer.BreakPheromoneEffect();
														
							PrimaryWeaponSwitch();
								
							Attack_Process_15('geraltRandomOlgierdHeavyAttackAlt');

							if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier(1.75  ); }
														
							RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.75   , false);	

							ACS_StaminaDrain(2);
						
					}
					break;

					case 'FocusModeEredinShieldHeavyAttack':
					if ( ACS_can_perform_heavy_attack() )
					{
						
							ACS_refresh_heavy_attack_cooldown();
									
							thePlayer.BreakPheromoneEffect();
														
							PrimaryWeaponSwitch();
														
							if (thePlayer.IsGuarded() && thePlayer.HasTag('acs_axii_sword_equipped'))
							{
								if (Attack_Directional_Press_Check())
								{
									Attack_Process_17('geraltRandomShieldHeavyAttackAlt');
								}
								else
								{
									
									Attack_Process_17('geraltRandomShieldHeavyAttack');
								}
							}
							else
							{
								if (Attack_Directional_Press_Check())
								{
									Attack_Process_19('geraltRandomEredinHeavyAttackAlt');
								}
								else
								{
									Attack_Process_19('geraltRandomEredinHeavyAttack');
								}	
							} 	

							if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	
							
							if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier(1.75  ); }
														
							RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5  , false);		

							ACS_StaminaDrain(2);
						
					}
					break;

					case 'HybridModeEredinShieldHeavyAttack':
					if ( ACS_can_perform_heavy_attack() )
					{
						
							ACS_refresh_heavy_attack_cooldown();
																				
							thePlayer.BreakPheromoneEffect();
														
							PrimaryWeaponSwitch();
														
							if (thePlayer.IsGuarded() && thePlayer.HasTag('acs_axii_sword_equipped'))
							{
								Attack_Process_17('geraltRandomShieldHeavyAttack');
							}
							else
							{
								Attack_Process_19('geraltRandomEredinHeavyAttack');
							} 	

							if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	
							
							if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier(1.6  ); }
														
							RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5  , false);	

							ACS_StaminaDrain(2);
						
					}
					break;

					case 'HybridModeEredinShieldForwardHeavyAttack':
					if ( ACS_can_perform_heavy_attack() )
					{
						
							ACS_refresh_heavy_attack_cooldown();
									
							thePlayer.BreakPheromoneEffect();
														
							PrimaryWeaponSwitch();
														
							if (thePlayer.IsGuarded() && thePlayer.HasTag('acs_axii_sword_equipped'))
							{
								Attack_Process_17('geraltRandomShieldHeavyAttackAlt');
							}
							else
							{
								Attack_Process_19('geraltRandomEredinHeavyAttackAlt');
							} 	

							if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	
							
							if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier(1.75  ); }
														
							RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5  , false);	

							ACS_StaminaDrain(2);
						
					}
					break;

					case 'FocusModeImlerithHeavyAttack':
					if ( ACS_can_perform_heavy_attack() )
					{
						
							ACS_refresh_heavy_attack_cooldown();
									
							thePlayer.BreakPheromoneEffect();
														
							PrimaryWeaponSwitch();
																					
							if (Attack_Directional_Press_Check())
							{
								Attack_Process_20('geraltRandomImlerithHeavyAttackAlt');
							}
							else
							{
								Attack_Process_20('geraltRandomImlerithHeavyAttack');

								if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	

								if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier(1.5  ); }
														
								RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5   , false);

								ACS_StaminaDrain(2);
							}
						
					}
					break;

					
					default:
					break;
				}
				
			}
		}
	}


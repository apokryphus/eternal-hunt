	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	function ACS_can_bruxa_dash(): bool 
	{
		var cooldown : float;

		if (thePlayer.IsUsingHorse()
		|| thePlayer.IsUsingVehicle()
		)
		{
			return false;
		}

		cooldown = ACS_Settings_Main_Float('acs_bruxa_dash_settings','acs_bruxa_dash_cooldown', 0.35);

		if (!thePlayer.IsInCombat())
		{
			cooldown += 0;
		}
		else
		{
			if( thePlayer.GetStat( BCS_Focus ) < thePlayer.GetStatMax( BCS_Focus )/3) 
			{
				cooldown += 0.225;
			}
			else if( thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus )/3
			&& thePlayer.GetStat( BCS_Focus ) < thePlayer.GetStatMax( BCS_Focus ) * 2/3) 
			{	
				cooldown += 0.125;
			}
			else if( thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus ) * 2/3)
			{	
				cooldown += 0.025;
			}
		}
		
		return (theGame.GetEngineTimeAsSeconds() - last_bruxa_dash_time > cooldown) ;
	}

	function ACS_refresh_bruxa_dash_cooldown() 
	{
		var animatedComponentA 	: CAnimatedComponent;

		last_bruxa_dash_time = theGame.GetEngineTimeAsSeconds();

		if (GetWitcherPlayer().HasTag('ACS_Special_Dodge'))
		{
			GetWitcherPlayer().RemoveTag('ACS_Special_Dodge');
		}

		RemoveSneaking(true);

		animatedComponentA = (CAnimatedComponent)thePlayer.GetComponentByClassName( 'CAnimatedComponent' );

		animatedComponentA.UnfreezePose(); animatedComponentA.UnfreezePoseFadeOut(0.01f);
	}

	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	function VampClawLightAttack()
	{
		ACS_ExplorationDelayHack(false, 3);

		if (ACS_Settings_Main_Bool('acs_stamina_settings','acs_stamina_block_action', false) 
		&& StaminaCheck('fist')
		)
		{					 
			RemoveTimer('SwordTauntSwitch'); RemoveTimer('SwordTauntRunningSwitch');   if (thePlayer.HasTag('ACS_IsSwordWalking')){thePlayer.RemoveTag('ACS_IsSwordWalking');} if(thePlayer.IsInCombat()){if(thePlayer.GetCombatIdleStance() <= 0.f ){thePlayer.RaiseEvent('ACS_CombatTauntLeft');}else{thePlayer.RaiseEvent('ACS_CombatTauntRight');}} thePlayer.SoundEvent("gui_no_stamina");
		}
		else
		{
			if (ACS_can_perform_light_attack())
			{
				ACS_refresh_light_attack_cooldown();

				if ( !thePlayer.HasTag('acs_axii_sword_equipped') && FactsQuerySum("ACS_Azkar_Aiming") <= 0)
				{
					thePlayer.SetGuarded(false);
					thePlayer.OnGuardedReleased();
				}

				PrimaryWeaponSwitch();

				if (!GetWitcherPlayer().IsInCombat() 
				&& !GetWitcherPlayer().HasTag('acs_vampire_claws_equipped')
				)
				{
					if (
					( ACS_GetWeaponMode() == 0 && ACS_Settings_Main_Int('acs_combat_main_settings','acs_fist_mode', 0) == 1 )
					|| ( ACS_GetWeaponMode() == 1 && ACS_Settings_Main_Int('acs_combat_main_settings','acs_fist_mode', 0) == 1 )
					|| ( ACS_GetWeaponMode() == 2 && ACS_Settings_Main_Int('acs_combat_main_settings','acs_fist_mode', 0) == 1 )
					|| ( ACS_GetWeaponMode() == 3 && (ACS_GetItem_VampClaw('shades') || ACS_GetItem_VampClaw('default') ) )
					)
					{
						vClawEquipStandalone = new cClawEquipStandalone in this;
						vClawEquipStandalone.Claw_Equip_Standalone_Engage();	
					}
				}

				if (Attack_Directional_Press_Check())
				{
					if (ACS_Settings_Main_Bool('acs_player_misc_settings','acs_vampire_sound_effects', true)) {VampVoiceEffects_Effort_Big();}						

					if (thePlayer.GetIsSprinting())
					{
						Attack_Process_01('geraltClawSprintingAttack');
					}
					else
					{
						Attack_Process_05('geraltRandomClawComboAttack');
					}
				}
				//else if (theInput.GetActionValue('GI_AxisLeftY') < -0.5
				else if (theInput.GetActionValue(DodgeOrRoll()) > 0.7
				&& thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus ) * 1/3 )
				{
					ACS_Tutorial_Display_Check('ACS_Weapon_Arts_Tutorial_Shown');

					RemoveTimer('RollDelay');

					Bruxa_Scream();

					if( thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus )/3
					&& thePlayer.GetStat( BCS_Focus ) < thePlayer.GetStatMax( BCS_Focus ) * 2/3) 
					{	
						thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) );
					}
					else if( thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus ) * 2/3
					&& thePlayer.GetStat( BCS_Focus ) < thePlayer.GetStatMax( BCS_Focus ) * 0.9875 )  
					{	
						thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) * 1/3);
					}
					else if( thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus ) * 0.9875 ) 
					{
						thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) * 1/3);
					}
				}
				else
				{
					if (ACS_Settings_Main_Bool('acs_player_misc_settings','acs_vampire_sound_effects', true)) {VampVoiceEffects_Effort();}

					Attack_Process_01('geraltRandomClawFistAttack');
				}

				ACS_StaminaDrain(1);
			
			}
		}
	}

	function VampClawHeavyAttack()
	{
		ACS_ExplorationDelayHack(false, 3);

		if (ACS_Settings_Main_Bool('acs_stamina_settings','acs_stamina_block_action', false) 
		&& StaminaCheck('fist')
		)
		{
			RemoveTimer('SwordTauntSwitch'); RemoveTimer('SwordTauntRunningSwitch');   if (thePlayer.HasTag('ACS_IsSwordWalking')){thePlayer.RemoveTag('ACS_IsSwordWalking');} if(thePlayer.IsInCombat()){if(thePlayer.GetCombatIdleStance() <= 0.f ){thePlayer.RaiseEvent('ACS_CombatTauntLeft');}else{thePlayer.RaiseEvent('ACS_CombatTauntRight');}} thePlayer.SoundEvent("gui_no_stamina");
		}
		else
		{
			if (ACS_can_perform_heavy_attack())
			{
				ACS_refresh_heavy_attack_cooldown();
											
				PrimaryWeaponSwitch();

				if ( !thePlayer.HasTag('acs_axii_sword_equipped') && FactsQuerySum("ACS_Azkar_Aiming") <= 0)
				{
					thePlayer.SetGuarded(false);
					thePlayer.OnGuardedReleased();
				}

				if (!GetWitcherPlayer().IsInCombat() 
				&& !GetWitcherPlayer().HasTag('acs_vampire_claws_equipped')
				)
				{
					if (
					( ACS_GetWeaponMode() == 0 && ACS_Settings_Main_Int('acs_combat_main_settings','acs_fist_mode', 0) == 1 )
					|| ( ACS_GetWeaponMode() == 1 && ACS_Settings_Main_Int('acs_combat_main_settings','acs_fist_mode', 0) == 1 )
					|| ( ACS_GetWeaponMode() == 2 && ACS_Settings_Main_Int('acs_combat_main_settings','acs_fist_mode', 0) == 1 )
					|| ( ACS_GetWeaponMode() == 3 && (ACS_GetItem_VampClaw('shades') || ACS_GetItem_VampClaw('default') ) )
					)
					{
						vClawEquipStandalone = new cClawEquipStandalone in this;
						vClawEquipStandalone.Claw_Equip_Standalone_Engage();	
					}
				}

				if (Attack_Directional_Press_Check())
				{
					if (ACS_Settings_Main_Bool('acs_player_misc_settings','acs_vampire_sound_effects', true)) {VampVoiceEffects_Monster();}

					Attack_Process_06('geraltRandomClawAttackSpecialDash');
				}
				else
				{
					if (ACS_Settings_Main_Bool('acs_player_misc_settings','acs_vampire_sound_effects', true)) {VampVoiceEffects_Effort_Big();}

					Attack_Process_01('geraltRandomHeavyClawAttack');

					if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	

					if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier(1.5  ); }	

					RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5   , false);
				}

				ACS_StaminaDrain(2);
			}
		}
	}

	function SorcFistLightAttack()
	{
		var ent_1, ent_2            : CEntity;
		var rot                     : EulerAngles;
		var pos						: Vector;

		ACS_ExplorationDelayHack(false, 3);

		if (
		ACS_Settings_Main_Bool('acs_stamina_settings','acs_stamina_block_action', false) 
		&& 
		StaminaCheck('fist')
		)
		{ 
			RemoveTimer('SwordTauntSwitch'); RemoveTimer('SwordTauntRunningSwitch');   if (thePlayer.HasTag('ACS_IsSwordWalking')){thePlayer.RemoveTag('ACS_IsSwordWalking');} if(thePlayer.IsInCombat()){if(thePlayer.GetCombatIdleStance() <= 0.f ){thePlayer.RaiseEvent('ACS_CombatTauntLeft');}else{thePlayer.RaiseEvent('ACS_CombatTauntRight');}} thePlayer.SoundEvent("gui_no_stamina");
		}
		else
		{
			if (ACS_can_perform_light_attack())
			{
				ACS_refresh_light_attack_cooldown();

				if ( !thePlayer.HasTag('acs_axii_sword_equipped') && FactsQuerySum("ACS_Azkar_Aiming") <= 0)
				{
					thePlayer.SetGuarded(false);
					thePlayer.OnGuardedReleased();
				}
				
				if (!GetWitcherPlayer().IsInCombat() 
				&& !GetWitcherPlayer().HasTag('acs_sorc_fists_equipped')
				)
				{
					ACSGetCEntity('ACS_Sorc_Fist_Fx_1').Destroy();

					ACSGetCEntity('ACS_Sorc_Fist_Fx_2').Destroy();

					rot = thePlayer.GetWorldRotation();

					pos = thePlayer.GetWorldPosition();

					ent_1 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

					"dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent"

					, true ), pos, rot );

					ent_1.PlayEffectSingle('sorc_hand_fx');

					ent_1.AddTag('ACS_Sorc_Fist_Fx_1');

					ent_1.DestroyAfter(2);

					ent_1.CreateAttachment( GetWitcherPlayer(), 'r_weapon' );

					ent_2 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

					"dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent"

					, true ), pos, rot );

					ent_2.PlayEffectSingle('sorc_hand_fx');

					ent_2.AddTag('ACS_Sorc_Fist_Fx_2');

					ent_2.CreateAttachment( GetWitcherPlayer(), 'l_weapon' );

					ent_2.DestroyAfter(2);
				}

				Attack_Process_02('geraltRandomLightSorcAttack');

				//AddTimer('ACS_portable_aard', 0.5 , false);

				ACS_StaminaDrain(2);
			}
		}
	}


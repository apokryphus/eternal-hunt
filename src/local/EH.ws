			break;

			case 11:
			TransformationGiantAnchorSwitch(true, false, 0.1);
			ACSTransformationGiantPlayAnim( 'giant_combat_anchor_attack_far_b_acs_ice_giant', 0.25f, 0.325f);
			break;

			case 10:
			TransformationGiantAnchorSwitch(true, false, 0.1);
			ACSTransformationGiantPlayAnim( 'giant_combat_anchor_attack_far_f_acs_ice_giant', 0.25f, 0.325f);
			break;

			case 9:
			TransformationGiantAnchorSwitch(false, false, 0);
			ACSTransformationGiantPlayAnim( 'giant_combat_anchor_attack_far_f', 0.25f, 0.325f);
			RemoveTimer('Transformation_Giant_Secondary_Attack');
			AddTimer('Transformation_Giant_Secondary_Attack', 2   , false);
			break;

			case 8:
			TransformationGiantAnchorSwitch(false, false, 0);
			ACSTransformationGiantPlayAnim( 'giant_combat_attack_b_1', 0.25f, 0.325f);
			RemoveTimer('Transformation_Giant_Secondary_Attack');
			AddTimer('Transformation_Giant_Secondary_Attack', 2   , false);
			break;

			case 7:
			TransformationGiantAnchorSwitch(false, false, 0);
			ACSTransformationGiantPlayAnim( 'giant_combat_attack_bl_1', 0.25f, 0.325f);
			RemoveTimer('Transformation_Giant_Secondary_Attack');
			AddTimer('Transformation_Giant_Secondary_Attack', 2   , false);
			break;
			
			case 6:
			TransformationGiantAnchorSwitch(false, false, 0);
			ACSTransformationGiantPlayAnim( 'giant_combat_attack_br_1', 0.25f, 0.325f);
			RemoveTimer('Transformation_Giant_Secondary_Attack');
			AddTimer('Transformation_Giant_Secondary_Attack', 2   , false);

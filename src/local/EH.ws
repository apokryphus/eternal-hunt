					l_mcAnchor 	= l_hudModuleAnchors.GetAnchorSprite( "mcAnchorLootPopup" );
				}
			}	
			break;

			case 'journal':
			{
				baseHud = (CR4HudModuleBase)hud.GetHudModule("JournalUpdateModule");

				journalModule = (CR4HudModuleJournalUpdate)hud.GetHudModule("JournalUpdateModule");


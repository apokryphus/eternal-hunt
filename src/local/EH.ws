			default : 
			{
				//movementAdjustorFinisher.RotateTowards( ticketFinisher, slave );

				AddTimer('ACS_Finisher_Unblock_Action', 0.125 , false);
				return false;
			}
		}

		masterDef.parts.PushBack( masterSequencePart );
		masterDef.entity						= master;
		masterSequencePart.sequenceIndex		= 0;
		masterDef.manualSlotName			= 'GAMEPLAY_SLOT';
		masterDef.freezeAtEnd					= false;

		slaveSequencePart.sequenceIndex			= 0;
		slaveSequencePart.disableProxyCollisions = true;
		slave.SetKinematic( true );
		slaveDef.parts.PushBack( slaveSequencePart );
		slaveDef.entity							= slave;
		slaveDef.manualSlotName					= 'GAMEPLAY_SLOT';
		slaveDef.freezeAtEnd					= false;

		finisherAnim 							= false;
		
		sequenceIndex = syncInstance.RegisterMaster( masterDef );
		
		
		actorMaster = (CActor)master;
		actorSlave = (CActor)slave;
		
		if(actorMaster)
		{
			actorMaster.SignalGameplayEventParamInt( 'SetupSyncInstance', instanceIndex );
			actorMaster.SignalGameplayEventParamInt( 'SetupSequenceIndex', sequenceIndex );
			if ( finisherAnim )
				actorMaster.SignalGameplayEvent( 'PlayFinisherSyncedAnim' );
			else
				actorMaster.SignalGameplayEvent( 'PlaySyncedAnim' );
			
		}
		
		sequenceIndex = syncInstance.RegisterSlave( slaveDef );
		if( sequenceIndex == -1 ) 
		{
			return false;
		}
		
		if(actorSlave)
		{
			if( syncAction == 'Throat' )
				actorSlave.SignalGameplayEventParamCName( 'SetupEndEvent', 'CriticalState' );
				
			actorSlave.SignalGameplayEventParamInt( 'SetupSyncInstance', instanceIndex );
			actorSlave.SignalGameplayEventParamInt( 'SetupSequenceIndex', sequenceIndex );
			if ( finisherAnim )
				actorSlave.SignalGameplayEvent( 'PlayFinisherSyncedAnim' );
			else
				actorSlave.SignalGameplayEvent( 'PlaySyncedAnim' );
		}
		
		return true;
	}

	public function ACS_SetupSyncAnimInternalHumanBruxaBite( syncAction : name, master, slave : CEntity ) : bool
	{
		var masterDef, slaveDef													: SAnimationSequenceDefinition;
		var masterSequencePart, slaveSequencePart								: SAnimationSequencePartDefinition;
		var syncInstance														: CAnimationManualSlotSyncInstance;
		
		var instanceIndex														: int;
		var sequenceIndex														: int;
		
		var temp 																: name; 
		var tempF 																: float;
		var rot 																: EulerAngles;
		
		var finisherAnim 														: bool;
		var pos 																: Vector;
		
		var syncAnimName, cameraAnimName										: name;
		
		var node, node1 														: CNode; 
		var rot0, rot1, slaveRot 												: EulerAngles;
		
		var masterAnim, slaveAnim 												: name;
		var syncAnimIndex														: int;
		var currentAnimInstance													: CAnimationManualSlotSyncInstance;
		var actorMaster, actorSlave 											: CActor;

		var fear_actors															: array<CActor>;
		var j, k 																: int;
		var fear_actor															: CActor;
		var animatedComponentFearActor											: CAnimatedComponent;
		var movementAdjustorFinisher, movementAdjustorFinisherActor				: CMovementAdjustor;
		var ticketFinisher, ticketFinisherActor 								: SMovementAdjustmentRequestTicket;
		var dist																: float;

		var attatchment_anchor, anchor, anchor_2  								: CEntity;
		var bone_rot															: EulerAngles;
		var anchorTemplate, head_temp											: CEntityTemplate;

		var vampire_head_anchor, vampire_head									: CEntity;

		var attach_vec															: Vector;
		var attach_rot															: EulerAngles;

		var bIndex 																: int;
		var bPos 																: Vector;
		var bRot 																: EulerAngles;
		var animatedComponentB													: CAnimatedComponent;

		if ( ((CActor)slave).HasTag('ACS_Hit_Lag'))
		{
			animatedComponentB = (CAnimatedComponent)(((CActor)slave).GetComponentByClassName( 'CAnimatedComponent' ));

			animatedComponentB.UnfreezePose();

			animatedComponentB.UnfreezePoseFadeOut(0.1);

			((CActor)slave).RemoveTag('ACS_Hit_Lag');
		}

		if (((CActor)slave).GetInteractionPriority() != IP_Max_Unpushable )
		{
			((CActor)slave).SetInteractionPriority( IP_Max_Unpushable );
		}

		theInput.IgnoreGameInput( 'GI_AxisLeftX', true );
		theInput.IgnoreGameInput( 'GI_AxisLeftY', true );

		ACS_ExplorationDelayHack(false, 3);
		
		syncInstance = theGame.GetSyncAnimManager().CreateNewSyncInstance( instanceIndex );
		syncAnimIndex = instanceIndex;
		currentAnimInstance = syncInstance;

		action_interrupt();

		RemoveTimer('SwordTauntSwitch'); 
		RemoveTimer('SwordTauntRunningSwitch'); 
		 
		thePlayer.RaiseEvent('ACS_SwordTauntEnd');
		thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');

		if(ACSGetCEntity('ACS_Viper_Dagger_L'))
		{
			thePlayer.RaiseEvent('ACS_LHandAttack01');
		}
		
		RemoveTimer('CombatTauntDelay');RemoveTimer('SwordTauntRunningSwitchSecondary'); 
		RemoveTimer('SwordTauntRunningSwitchSecondaryWeaponBlood'); 

		if (backhandSwordWield)
		{
			backhandSwordWield = false;
		}
		
		thePlayer.RaiseEvent('ACS_ForceHandClosedREnd');

		thePlayer.AddTag('ACS_Sword_Hit_Blood_Trigger');

		dist = (((CMovingPhysicalAgentComponent)((CActor)slave).GetMovingAgentComponent()).GetCapsuleRadius() 
		+ ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent()).GetCapsuleRadius());

		movementAdjustorFinisher = GetWitcherPlayer().GetMovingAgentComponent().GetMovementAdjustor();

		movementAdjustorFinisher.CancelAll();
		
		ticketFinisher = movementAdjustorFinisher.CreateNewRequest( 'ACS_Finisher_Rotate' );
			
		movementAdjustorFinisher.AdjustmentDuration( ticketFinisher, 0.001 );

		movementAdjustorFinisher.ShouldStartAt(ticketFinisher, GetWitcherPlayer().GetWorldPosition());
		movementAdjustorFinisher.MaxRotationAdjustmentSpeed( ticketFinisher, 5000000 );
		movementAdjustorFinisher.MaxLocationAdjustmentSpeed( ticketFinisher, 5000000 );
		//movementAdjustorFinisher.Continuous(ticketFinisher);
		
		movementAdjustorFinisher.SlideTowards( ticketFinisher, slave, 0, 0 );
		movementAdjustorFinisher.RotateTowards( ticketFinisher, slave );


		movementAdjustorFinisherActor = ((CActor)slave).GetMovingAgentComponent().GetMovementAdjustor();

		movementAdjustorFinisherActor.CancelAll();
		
		ticketFinisherActor = movementAdjustorFinisherActor.CreateNewRequest( 'ACS_Finisher_Rotate' );
			
		movementAdjustorFinisherActor.AdjustmentDuration( ticketFinisherActor, 0.0125 );

		movementAdjustorFinisherActor.ShouldStartAt(ticketFinisherActor, slave.GetWorldPosition());
		movementAdjustorFinisherActor.MaxRotationAdjustmentSpeed( ticketFinisherActor, 5000000 );
		movementAdjustorFinisherActor.MaxLocationAdjustmentSpeed( ticketFinisherActor, 5000000 );

		//movementAdjustorFinisherActor.SlideTowards( ticketFinisherActor, GetWitcherPlayer(), dist, dist );
		movementAdjustorFinisherActor.RotateTowards( ticketFinisherActor, GetWitcherPlayer() );

		thePlayer.BlockAllActions( 'ACS_Finisher_Action_Block', true );

		thePlayer.SetGuarded(false);
		thePlayer.OnGuardedReleased();

		if (((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'wood_hollow'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'wood_debris'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'dirt_hard'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'dirt_soil'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'hay'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'stone_debris'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'stone_solid'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'clay_tile'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'gravel_large'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'gravel_small'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'sand'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'water_shallow'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'water_deep'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'grass_short'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'grass_long'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'carpet'
		)
		{

			thePlayer.StopEffect('jump_ground_fx1');
			thePlayer.PlayEffect('jump_ground_fx1');

			if (((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'dirt_hard'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'dirt_soil'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'hay'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'stone_debris'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'clay_tile'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'gravel_large'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'gravel_small'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'sand'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'grass_short'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'grass_long'
			)
			{
				//thePlayer.StopEffect('covered_dirt_ACS');
				//thePlayer.PlayEffect('covered_dirt_ACS');

				if( GetRainStrength() > 0 
				&& !thePlayer.IsInInterior()
				&& !RoofCheck()
				) 
				{

				}
				else if (ACS_Settings_Main_Bool('acs_player_misc_settings','acs_dirt_vfx_enabled', true))
				{
					thePlayer.StopEffect('covered_dirt_big_ACS');
					thePlayer.PlayEffect('covered_dirt_big_ACS');

					thePlayer.StopEffect('covered_dirt_small_ACS');
					thePlayer.PlayEffect('covered_dirt_small_ACS');
				}
			}
		}

		thePlayer.AddTag('ACS_IsPerformingFinisher');

		if (!thePlayer.HasTag('ACS_HasPerformedFinisher'))
		{
			thePlayer.AddTag('ACS_HasPerformedFinisher');
		}

		thePlayer.SetImmortalityMode( AIM_Invulnerable, AIC_Default, true ); 
		thePlayer.SetCanPlayHitAnim(false); 
		//thePlayer.EnableCharacterCollisions(false); 
		thePlayer.AddBuffImmunity_AllNegative('ACS_Finisher_Immune_Negative', true); 
		thePlayer.AddBuffImmunity_AllCritical('ACS_Finisher_Immune_Critical', true); 

		//ChangeInteractionPriority();
		
		RemoveTimer('ACS_Finisher_Unblock_Action');

		RemoveTimer('ACS_Finisher_Unblock_Camera');

		((CActor)slave).SetCanPlayHitAnim(true);

		((CNewNPC)slave).SetUnstoppable(false);

		FreezeMoveTargets(6);
		
		if (((CActor)slave).IsAlive())
		{
			((CActor)slave).Kill( 'ACS_Finisher', false, thePlayer );
		}

		if (thePlayer.HasTag('ACS_IsSwordWalking'))
		{
			thePlayer.RemoveTag('ACS_IsSwordWalking');
		}

		RemoveTimer('SwordTauntSwitch'); 
		RemoveTimer('SwordTauntRunningSwitch'); 
		 
		 

		if ( AnimProgressCheck() )
		{
			if (thePlayer.IsInAir()
			|| thePlayer.IsFalling()
			)
			{
				//thePlayer.RaiseEvent('ACS_ForceLegsFloatIdle');
			}
			else
			{
				if (thePlayer.HasTag('ACS_IsSwordWalking'))
				{
					thePlayer.RaiseEvent('ACS_SwordWalkAdditiveEnd');thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');RemoveTimer('CombatTauntDelay');thePlayer.RaiseEvent('ACS_SwordTauntEnd');

					thePlayer.RemoveTag('ACS_IsSwordWalking');
				}
			}
		}

		thePlayer.EnableCharacterCollisions(false);

		((CActor)slave).EnableCharacterCollisions(false);

		anchorTemplate = (CEntityTemplate)LoadResource( 
				
		"dlc\dlc_acs\data\fx\nekker_share_life_force.w2ent"

		, true );

		attatchment_anchor = (CEntity)theGame.CreateEntity( anchorTemplate, thePlayer.GetWorldPosition() + Vector( 0, 0, -10 ) );

		if ( ((CActor)slave).GetBoneIndex('pelvis') != -1 )
		{
			bIndex = ((CActor)slave).GetBoneIndex( 'pelvis' );	
			((CActor)slave).GetBoneWorldPositionAndRotationByIndex( bIndex, bPos, bRot );

			attatchment_anchor.CreateAttachmentAtBoneWS(((CActor)slave), 'pelvis', bPos, bRot);
		}
		else
		{
			if ( actor.GetBoneIndex('k_pelvis_g') != -1 )
			{
				bIndex = ((CActor)slave).GetBoneIndex( 'k_pelvis_g' );	
				((CActor)slave).GetBoneWorldPositionAndRotationByIndex( bIndex, bPos, bRot );

				attatchment_anchor.CreateAttachmentAtBoneWS(((CActor)slave), 'k_pelvis_g', bPos, bRot);
			}
			else
			{
				attatchment_anchor.CreateAttachment(((CActor)slave), , Vector(0,0,1.5), thePlayer.GetWorldRotation());
			}
		}

		thePlayer.CreateAttachment(attatchment_anchor,,Vector(0,1,0), EulerAngles(90,0,0));

		attatchment_anchor.DestroyAfter(10);

		//thePlayer.BreakAttachment();

		thePlayer.GetBoneWorldPositionAndRotationByIndex( thePlayer.GetBoneIndex( 'head' ), bone_vec, bone_rot );

		anchor = (CEntity)theGame.CreateEntity( anchorTemplate, thePlayer.GetWorldPosition() + Vector( 0, 0, -10 ) );

		anchor.CreateAttachmentAtBoneWS( thePlayer, 'head', bone_vec, bone_rot );

		anchor.DestroyAfter(5);

		anchor_2 = (CEntity)theGame.CreateEntity( anchorTemplate, attatchment_anchor.GetWorldPosition() );

		anchor_2.CreateAttachment( attatchment_anchor, '', Vector(0,0,0) );

		anchor_2.DestroyAfter(5);

		anchor.StopEffect('drain_energy_1');
		anchor.PlayEffectSingle('drain_energy_1', anchor_2);

		anchor_2.PlayEffectSingle('drain_energy');

		anchor_2.StopEffect('drain_energy_1');
		anchor_2.PlayEffectSingle('drain_energy_1', anchor);

		ACSGetCEntity('ACS_Bruxa_Bite_Finisher_Vampire_Head').BreakAttachment(); 
		ACSGetCEntity('ACS_Bruxa_Bite_Finisher_Vampire_Head').Teleport( GetWitcherPlayer().GetWorldPosition() + Vector( 0, 0, -200 ) );
		ACSGetCEntity('ACS_Bruxa_Bite_Finisher_Vampire_Head').DestroyAfter(0.00125);
		ACSGetCEntity('ACS_Bruxa_Bite_Finisher_Vampire_Head').RemoveTag('ACS_Bruxa_Bite_Finisher_Vampire_Head');

		head_temp = (CEntityTemplate)LoadResource(
		"dlc\dlc_acs\data\entities\other\dettlaff_monster_head.w2ent"
		//"dlc\dlc_acs\data\entities\other\dettlaff_monster_head_2.w2ent"
		//"dlc\dlc_acs\data\entities\other\dettlaff_monster_head_3.w2ent"
		//"dlc\dlc_acs\data\entities\other\dettlaff_monster_head_4.w2ent"
		, true);

		vampire_head = (CEntity)theGame.CreateEntity( head_temp, GetWitcherPlayer().GetWorldPosition() );
		
		attach_rot.Roll = 0;
		attach_rot.Pitch = 0;
		attach_rot.Yaw = 10;
		attach_vec.X = -0.2825;
		attach_vec.Y = -0.075;
		attach_vec.Z = 0;
		
		vampire_head.CreateAttachment( anchor, , attach_vec, attach_rot );

		vampire_head.AddTag('ACS_Bruxa_Bite_Finisher_Vampire_Head');

		switch( syncAction )
		{
			case 'bruxa_attack_bite_front_lp_bruxa_ACS':
			{
				//movementAdjustorFinisher.RotateTowards( ticketFinisher, slave );

				AddTimer('ACS_Finisher_Unblock_Action', 2.516667 , false);

				masterSequencePart.animation			= 'bruxa_attack_bite_back_lp_bruxa_ACS';
				masterSequencePart.syncType				= AMST_SyncBeginning;
				masterSequencePart.useRefBone			= 'Reference';
				masterSequencePart.rotationTypeUsingRefBone = SRT_TowardsOtherEntity;
				masterSequencePart.shouldSlide			= false;
				masterSequencePart.shouldRotate			= false;
				
				masterSequencePart.blendInTime			= 0.5f;
				masterSequencePart.blendOutTime			= 0.5f;

				slave.AddTag('ACS_bruxa_attack_bite_front_lp_ACS');
				slaveSequencePart.animation				= 'bruxa_attack_bite_front_lp_ACS';	
				slaveSequencePart.syncType				= AMST_SyncBeginning;
				slaveSequencePart.useRefBone			= 'Reference';	
				slaveSequencePart.rotationTypeUsingRefBone = SRT_ToMatchOthersRotation;
				slaveSequencePart.shouldRotate			= false;
				slaveSequencePart.shouldSlide			= false;
				slaveSequencePart.finalHeading			= thePlayer.GetHeading();
				
				slaveSequencePart.blendInTime			= 0.2f;
				slaveSequencePart.blendOutTime			= 0.75f;
				
				break;		
			}
			case 'bruxa_attack_bite_front_rp_bruxa_ACS':
			{
				//movementAdjustorFinisher.RotateTowards( ticketFinisher, slave );
				
				AddTimer('ACS_Finisher_Unblock_Action', 2.316667 , false);

				masterSequencePart.animation			= 'bruxa_attack_bite_back_rp_bruxa_ACS';
				masterSequencePart.syncType				= AMST_SyncBeginning;
				masterSequencePart.useRefBone			= 'Reference';
				masterSequencePart.rotationTypeUsingRefBone = SRT_TowardsOtherEntity;
				masterSequencePart.shouldSlide			= false;
				masterSequencePart.shouldRotate			= false;
				
				masterSequencePart.blendInTime			= 0.5f;

				masterSequencePart.blendOutTime			= 0.5f;
				
				slave.AddTag('ACS_bruxa_attack_bite_front_rp_ACS');
				slaveSequencePart.animation				= 'bruxa_attack_bite_front_rp_ACS';	
				slaveSequencePart.syncType				= AMST_SyncBeginning;
				slaveSequencePart.useRefBone			= 'Reference';	
				slaveSequencePart.rotationTypeUsingRefBone = SRT_ToMatchOthersRotation;
				slaveSequencePart.shouldRotate			= false;
				slaveSequencePart.shouldSlide			= false;
				slaveSequencePart.finalHeading			= thePlayer.GetHeading();
				
				slaveSequencePart.blendInTime			= 0.2f;
				slaveSequencePart.blendOutTime			= 0.75f;
				
				break;		
			}
			case 'bruxa_attack_bite_back_lp_bruxa_ACS':
			{
				AddTimer('ACS_Finisher_Unblock_Action', 2.85 , false);

				masterSequencePart.animation			= 'bruxa_attack_bite_back_lp_bruxa_ACS';
				masterSequencePart.syncType				= AMST_SyncBeginning;
				masterSequencePart.useRefBone			= 'Reference';
				masterSequencePart.rotationTypeUsingRefBone = SRT_TowardsOtherEntity;
				masterSequencePart.shouldSlide			= false;
				masterSequencePart.shouldRotate			= false;
				
				masterSequencePart.blendInTime			= 0.5f;
				masterSequencePart.blendOutTime			= 0.5f;

				slave.AddTag('ACS_bruxa_attack_bite_back_lp_ACS');
				slaveSequencePart.animation				= 'bruxa_attack_bite_back_lp_ACS';	
				slaveSequencePart.syncType				= AMST_SyncBeginning;
				slaveSequencePart.useRefBone			= 'Reference';	
				slaveSequencePart.rotationTypeUsingRefBone = SRT_ToMatchOthersRotation;
				slaveSequencePart.shouldRotate			= false;
				slaveSequencePart.shouldSlide			= false;
				slaveSequencePart.finalHeading			= thePlayer.GetHeading();
				
				slaveSequencePart.blendInTime			= 0.2f;
				slaveSequencePart.blendOutTime			= 0.75f;

				break;		
			}
			case 'bruxa_attack_bite_back_rp_bruxa_ACS':
			{
				AddTimer('ACS_Finisher_Unblock_Action', 2.85 , false);

				masterSequencePart.animation			= 'bruxa_attack_bite_back_rp_bruxa_ACS';
				masterSequencePart.syncType				= AMST_SyncBeginning;
				masterSequencePart.useRefBone			= 'Reference';
				masterSequencePart.rotationTypeUsingRefBone = SRT_TowardsOtherEntity;
				masterSequencePart.shouldSlide			= false;
				masterSequencePart.shouldRotate			= false;
				
				masterSequencePart.blendInTime			= 0.5f;

				masterSequencePart.blendOutTime			= 0.5f;
				
				slave.AddTag('ACS_bruxa_attack_bite_back_rp_ACS');

				slaveSequencePart.animation				= 'bruxa_attack_bite_back_rp_ACS';	
				slaveSequencePart.syncType				= AMST_SyncBeginning;
				slaveSequencePart.useRefBone			= 'Reference';	
				slaveSequencePart.rotationTypeUsingRefBone = SRT_ToMatchOthersRotation;
				slaveSequencePart.shouldRotate			= false;
				slaveSequencePart.shouldSlide			= false;
				slaveSequencePart.finalHeading			= thePlayer.GetHeading();
				
				slaveSequencePart.blendInTime			= 0.2f;
				slaveSequencePart.blendOutTime			= 0.75f;

				break;		
			}			
			default : 
			{
				//movementAdjustorFinisher.RotateTowards( ticketFinisher, slave );

				AddTimer('ACS_Finisher_Unblock_Action', 0.125 , false);
				return false;
			}
		}
		
		masterDef.parts.PushBack( masterSequencePart );
		masterDef.entity						= master;
		masterSequencePart.sequenceIndex		= 0;
		masterDef.manualSlotName			= 'GAMEPLAY_SLOT';
		masterDef.freezeAtEnd					= false;

		slaveSequencePart.sequenceIndex			= 0;
		slaveSequencePart.disableProxyCollisions = true;
		slave.SetKinematic( true );
		slaveDef.parts.PushBack( slaveSequencePart );
		slaveDef.entity							= slave;
		slaveDef.manualSlotName					= 'GAMEPLAY_SLOT';
		slaveDef.freezeAtEnd					= false;

		finisherAnim 							= false;


		sequenceIndex = syncInstance.RegisterMaster( masterDef );
		
		actorMaster = (CActor)master;
		actorSlave = (CActor)slave;

		if(actorMaster)
		{
			actorMaster.SignalGameplayEventParamInt( 'SetupSyncInstance', instanceIndex );
			actorMaster.SignalGameplayEventParamInt( 'SetupSequenceIndex', sequenceIndex );
			if ( finisherAnim )
				actorMaster.SignalGameplayEvent( 'PlayFinisherSyncedAnim' );
			else
				actorMaster.SignalGameplayEvent( 'PlaySyncedAnim' );
			
		}
	
		sequenceIndex = syncInstance.RegisterSlave( slaveDef );
		if( sequenceIndex == -1 ) 
		{
			return false;
		}
		
		if(actorSlave)
		{
			if( syncAction == 'Throat' )
				actorSlave.SignalGameplayEventParamCName( 'SetupEndEvent', 'CriticalState' );
				
			actorSlave.SignalGameplayEventParamInt( 'SetupSyncInstance', instanceIndex );
			actorSlave.SignalGameplayEventParamInt( 'SetupSequenceIndex', sequenceIndex );
			if ( finisherAnim )
				actorSlave.SignalGameplayEvent( 'PlayFinisherSyncedAnim' );
			else
				actorSlave.SignalGameplayEvent( 'PlaySyncedAnim' );
		}
		
		return true;
	}

	public function ACS_SetupSyncAnimInternalMonsterBruxaBite( syncAction : name, master, slave : CEntity ) : bool
	{
		var masterDef, slaveDef													: SAnimationSequenceDefinition;
		var masterSequencePart, slaveSequencePart								: SAnimationSequencePartDefinition;
		var syncInstance														: CAnimationManualSlotSyncInstance;
		
		var instanceIndex														: int;
		var sequenceIndex														: int;
		
		var temp 																: name; 
		var tempF 																: float;
		var rot 																: EulerAngles;
		
		var finisherAnim 														: bool;
		var pos 																: Vector;
		
		var syncAnimName, cameraAnimName										: name;
		
		var node, node1 														: CNode; 
		var rot0, rot1, slaveRot 												: EulerAngles;
		
		var masterAnim, slaveAnim 												: name;
		var syncAnimIndex														: int;
		var currentAnimInstance													: CAnimationManualSlotSyncInstance;
		var actorMaster, actorSlave 											: CActor;

		var fear_actors															: array<CActor>;
		var j, k 																: int;
		var fear_actor															: CActor;
		var animatedComponentFearActor											: CAnimatedComponent;
		var movementAdjustorFinisher, movementAdjustorFinisherActor				: CMovementAdjustor;
		var ticketFinisher, ticketFinisherActor 								: SMovementAdjustmentRequestTicket;
		var dist																: float;

		var finisher_actor														: CActor;
		var animatedComponentFinisherActor										: CAnimatedComponent;

		var attatchment_anchor, anchor, anchor_2  								: CEntity;
		var bone_rot															: EulerAngles;
		var anchorTemplate, head_temp											: CEntityTemplate;

		var vampire_head_anchor, vampire_head									: CEntity;

		var attach_vec															: Vector;
		var attach_rot															: EulerAngles;

		var bIndex 																: int;
		var bPos 																: Vector;
		var bRot 																: EulerAngles;
		var animatedComponentB													: CAnimatedComponent;

		if ( ((CActor)slave).HasTag('ACS_Hit_Lag'))
		{
			animatedComponentB = (CAnimatedComponent)(((CActor)slave).GetComponentByClassName( 'CAnimatedComponent' ));

			animatedComponentB.UnfreezePose();

			animatedComponentB.UnfreezePoseFadeOut(0.1);

			((CActor)slave).RemoveTag('ACS_Hit_Lag');
		}

		if (((CActor)slave).GetInteractionPriority() != IP_Max_Unpushable )
		{
			((CActor)slave).SetInteractionPriority( IP_Max_Unpushable );
		}

		theInput.IgnoreGameInput( 'GI_AxisLeftX', true );
		theInput.IgnoreGameInput( 'GI_AxisLeftY', true );

		ACS_ExplorationDelayHack(false, 3);
		
		syncInstance = theGame.GetSyncAnimManager().CreateNewSyncInstance( instanceIndex );
		syncAnimIndex = instanceIndex;
		currentAnimInstance = syncInstance;

		action_interrupt();

		RemoveTimer('SwordTauntSwitch'); 
		RemoveTimer('SwordTauntRunningSwitch'); 
		
		thePlayer.RaiseEvent('ACS_SwordTauntEnd');
		thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');

		if(ACSGetCEntity('ACS_Viper_Dagger_L'))
		{
			thePlayer.RaiseEvent('ACS_LHandAttack01');
		}
		 
		RemoveTimer('CombatTauntDelay');RemoveTimer('SwordTauntRunningSwitchSecondary'); 
		RemoveTimer('SwordTauntRunningSwitchSecondaryWeaponBlood'); 

		if (backhandSwordWield)
		{
			backhandSwordWield = false;
		}
		
		thePlayer.RaiseEvent('ACS_ForceHandClosedREnd');

		thePlayer.AddTag('ACS_Sword_Hit_Blood_Trigger');

		dist = (((CMovingPhysicalAgentComponent)((CActor)slave).GetMovingAgentComponent()).GetCapsuleRadius() 
		+ ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent()).GetCapsuleRadius());

		movementAdjustorFinisher = GetWitcherPlayer().GetMovingAgentComponent().GetMovementAdjustor();

		movementAdjustorFinisher.CancelAll();
		
		ticketFinisher = movementAdjustorFinisher.CreateNewRequest( 'ACS_Finisher_Rotate' );
			
		movementAdjustorFinisher.AdjustmentDuration( ticketFinisher, 0.001 );

		movementAdjustorFinisher.ShouldStartAt(ticketFinisher, GetWitcherPlayer().GetWorldPosition());
		movementAdjustorFinisher.MaxRotationAdjustmentSpeed( ticketFinisher, 5000000 );
		movementAdjustorFinisher.MaxLocationAdjustmentSpeed( ticketFinisher, 5000000 );
		movementAdjustorFinisher.Continuous(ticketFinisher);
		
		//movementAdjustorFinisher.SlideTowards( ticketFinisher, slave, dist, dist );
		////movementAdjustorFinisher.RotateTowards( ticketFinisher, slave );


		movementAdjustorFinisherActor = ((CActor)slave).GetMovingAgentComponent().GetMovementAdjustor();

		movementAdjustorFinisherActor.CancelAll();
		
		ticketFinisherActor = movementAdjustorFinisherActor.CreateNewRequest( 'ACS_Finisher_Rotate' );
			
		movementAdjustorFinisherActor.AdjustmentDuration( ticketFinisherActor, 0.0125 );

		movementAdjustorFinisherActor.ShouldStartAt(ticketFinisherActor, slave.GetWorldPosition());
		movementAdjustorFinisherActor.MaxRotationAdjustmentSpeed( ticketFinisherActor, 5000000 );
		movementAdjustorFinisherActor.MaxLocationAdjustmentSpeed( ticketFinisherActor, 5000000 );

		//movementAdjustorFinisherActor.SlideTowards( ticketFinisherActor, GetWitcherPlayer(), dist, dist );
		movementAdjustorFinisherActor.RotateTowards( ticketFinisherActor, GetWitcherPlayer() );


		thePlayer.BlockAllActions( 'ACS_Finisher_Action_Block', true );

		thePlayer.SetGuarded(false);
		thePlayer.OnGuardedReleased();

		if (((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'wood_hollow'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'wood_debris'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'dirt_hard'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'dirt_soil'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'hay'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'stone_debris'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'stone_solid'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'clay_tile'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'gravel_large'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'gravel_small'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'sand'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'water_shallow'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'water_deep'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'grass_short'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'grass_long'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'carpet'
		)
		{

			thePlayer.StopEffect('jump_ground_fx1');
			thePlayer.PlayEffect('jump_ground_fx1');

			if (((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'dirt_hard'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'dirt_soil'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'hay'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'stone_debris'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'clay_tile'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'gravel_large'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'gravel_small'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'sand'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'grass_short'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'grass_long'
			)
			{
				//thePlayer.StopEffect('covered_dirt_ACS');
				//thePlayer.PlayEffect('covered_dirt_ACS');

				if( GetRainStrength() > 0 
				&& !thePlayer.IsInInterior()
				&& !RoofCheck()
				) 
				{

				}
				else if (ACS_Settings_Main_Bool('acs_player_misc_settings','acs_dirt_vfx_enabled', true))
				{
					thePlayer.StopEffect('covered_dirt_big_ACS');
					thePlayer.PlayEffect('covered_dirt_big_ACS');

					thePlayer.StopEffect('covered_dirt_small_ACS');
					thePlayer.PlayEffect('covered_dirt_small_ACS');
				}
			}
		}

		thePlayer.AddTag('ACS_IsPerformingFinisher');

		if (!thePlayer.HasTag('ACS_HasPerformedFinisher'))
		{
			thePlayer.AddTag('ACS_HasPerformedFinisher');
		}

		thePlayer.SetImmortalityMode( AIM_Invulnerable, AIC_Default, true ); 
		thePlayer.SetCanPlayHitAnim(false); 
		//thePlayer.EnableCharacterCollisions(false); 
		thePlayer.AddBuffImmunity_AllNegative('ACS_Finisher_Immune_Negative', true); 
		thePlayer.AddBuffImmunity_AllCritical('ACS_Finisher_Immune_Critical', true); 

		//ChangeInteractionPriority();
		
		RemoveTimer('ACS_Finisher_Unblock_Action');

		RemoveTimer('ACS_Finisher_Unblock_Camera');

		((CActor)slave).SetCanPlayHitAnim(true);

		((CNewNPC)slave).SetUnstoppable(false);

		((CActor)slave).GetRootAnimatedComponent().PlaySlotAnimationAsync( '', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0, 0) );

		FreezeMoveTargets(6);
		
		if (((CActor)slave).IsAlive())
		{
			((CActor)slave).Kill( 'ACS_Finisher', false, thePlayer );
		}

		if (thePlayer.HasTag('ACS_IsSwordWalking'))
		{
			thePlayer.RemoveTag('ACS_IsSwordWalking');
		}

		RemoveTimer('SwordTauntSwitch'); 
		RemoveTimer('SwordTauntRunningSwitch'); 
		 
		 

		if ( AnimProgressCheck() )
		{
			if (thePlayer.IsInAir()
			|| thePlayer.IsFalling()
			)
			{
				//thePlayer.RaiseEvent('ACS_ForceLegsFloatIdle');
			}
			else
			{
				if (thePlayer.HasTag('ACS_IsSwordWalking'))
				{
					thePlayer.RaiseEvent('ACS_SwordWalkAdditiveEnd');thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');RemoveTimer('CombatTauntDelay');thePlayer.RaiseEvent('ACS_SwordTauntEnd');

					thePlayer.RemoveTag('ACS_IsSwordWalking');
				}
			}
		}

		thePlayer.EnableCharacterCollisions(false);

		((CActor)slave).EnableCharacterCollisions(false);

		finisher_actor = ((CActor)(slave));

		animatedComponentFinisherActor = (CAnimatedComponent)finisher_actor.GetComponentByClassName( 'CAnimatedComponent' );

		animatedComponentFinisherActor.FreezePoseFadeIn(0.125f);

		animatedComponentFinisherActor.UnfreezePoseFadeOut(7.75f);

		anchorTemplate = (CEntityTemplate)LoadResource( 
				
		"dlc\dlc_acs\data\fx\nekker_share_life_force.w2ent"

		, true );

		attatchment_anchor = (CEntity)theGame.CreateEntity( anchorTemplate, thePlayer.GetWorldPosition() + Vector( 0, 0, -10 ) );

		if ( ((CActor)slave).GetBoneIndex('pelvis') != -1 )
		{
			bIndex = ((CActor)slave).GetBoneIndex( 'pelvis' );	
			((CActor)slave).GetBoneWorldPositionAndRotationByIndex( bIndex, bPos, bRot );

			attatchment_anchor.CreateAttachmentAtBoneWS(((CActor)slave), 'pelvis', bPos, bRot);
		}
		else
		{
			if ( actor.GetBoneIndex('k_pelvis_g') != -1 )
			{
				bIndex = ((CActor)slave).GetBoneIndex( 'k_pelvis_g' );	
				((CActor)slave).GetBoneWorldPositionAndRotationByIndex( bIndex, bPos, bRot );

				attatchment_anchor.CreateAttachmentAtBoneWS(((CActor)slave), 'k_pelvis_g', bPos, bRot);
			}
			else
			{
				attatchment_anchor.CreateAttachment(((CActor)slave), , Vector(0,0,1.5), thePlayer.GetWorldRotation());
			}
		}

		thePlayer.CreateAttachment(attatchment_anchor,,Vector(0,1,0), EulerAngles(90,0,0));

		attatchment_anchor.DestroyAfter(10);

		thePlayer.GetBoneWorldPositionAndRotationByIndex( thePlayer.GetBoneIndex( 'head' ), bone_vec, bone_rot );

		anchor = (CEntity)theGame.CreateEntity( anchorTemplate, thePlayer.GetWorldPosition() + Vector( 0, 0, -10 ) );

		anchor.CreateAttachmentAtBoneWS( thePlayer, 'head', bone_vec, bone_rot );

		anchor.DestroyAfter(5);

		anchor_2 = (CEntity)theGame.CreateEntity( anchorTemplate, attatchment_anchor.GetWorldPosition() + Vector( 0, 0, -10 ) );

		anchor_2.CreateAttachment( attatchment_anchor, '', Vector(0,0,0) );

		anchor_2.DestroyAfter(5);

		anchor.StopEffect('drain_energy_1');
		anchor.PlayEffectSingle('drain_energy_1', anchor_2);

		anchor_2.PlayEffectSingle('drain_energy');

		anchor_2.StopEffect('drain_energy_1');
		anchor_2.PlayEffectSingle('drain_energy_1', anchor);

		ACSGetCEntity('ACS_Bruxa_Bite_Finisher_Vampire_Head').BreakAttachment(); 
		ACSGetCEntity('ACS_Bruxa_Bite_Finisher_Vampire_Head').Teleport( GetWitcherPlayer().GetWorldPosition() + Vector( 0, 0, -200 ) );
		ACSGetCEntity('ACS_Bruxa_Bite_Finisher_Vampire_Head').DestroyAfter(0.00125);
		ACSGetCEntity('ACS_Bruxa_Bite_Finisher_Vampire_Head').RemoveTag('ACS_Bruxa_Bite_Finisher_Vampire_Head');

		head_temp = (CEntityTemplate)LoadResource(
		"dlc\dlc_acs\data\entities\other\dettlaff_monster_head.w2ent"
		//"dlc\dlc_acs\data\entities\other\dettlaff_monster_head_2.w2ent"
		//"dlc\dlc_acs\data\entities\other\dettlaff_monster_head_3.w2ent"
		//"dlc\dlc_acs\data\entities\other\dettlaff_monster_head_4.w2ent"
		, true);

		vampire_head = (CEntity)theGame.CreateEntity( head_temp, GetWitcherPlayer().GetWorldPosition() );
		
		attach_rot.Roll = 0;
		attach_rot.Pitch = 0;
		attach_rot.Yaw = 10;
		attach_vec.X = -0.2825;
		attach_vec.Y = -0.075;
		attach_vec.Z = 0;
		
		vampire_head.CreateAttachment( anchor, , attach_vec, attach_rot );

		vampire_head.AddTag('ACS_Bruxa_Bite_Finisher_Vampire_Head');

		switch( syncAction )
		{
			case 'bruxa_attack_bite_front_lp_bruxa_ACS':
			{
				//movementAdjustorFinisher.RotateTowards( ticketFinisher, slave );

				AddTimer('ACS_Finisher_Unblock_Action', 2.516667 , false);

				masterSequencePart.animation			= 'bruxa_attack_bite_back_lp_bruxa_ACS';
				masterSequencePart.syncType				= AMST_SyncBeginning;
				masterSequencePart.useRefBone			= 'Reference';
				masterSequencePart.rotationTypeUsingRefBone = SRT_TowardsOtherEntity;
				masterSequencePart.shouldSlide			= false;
				masterSequencePart.shouldRotate			= false;
				
				masterSequencePart.blendInTime			= 0.5f;
				masterSequencePart.blendOutTime			= 0.5f;

				slave.AddTag('ACS_bruxa_attack_bite_front_lp_ACS');

				slaveSequencePart.animation				= '';	
				slaveSequencePart.syncType				= AMST_SyncBeginning;
				slaveSequencePart.shouldRotate			= false;
				slaveSequencePart.shouldSlide			= false;
				slaveSequencePart.finalHeading			= thePlayer.GetHeading();
				
				slaveSequencePart.blendInTime			= 0;
				slaveSequencePart.blendOutTime			= 0;

				break;		
			}
			case 'bruxa_attack_bite_front_rp_bruxa_ACS':
			{
				//movementAdjustorFinisher.RotateTowards( ticketFinisher, slave );

				AddTimer('ACS_Finisher_Unblock_Action', 2.316667 , false);

				masterSequencePart.animation			= 'bruxa_attack_bite_back_rp_bruxa_ACS';
				masterSequencePart.syncType				= AMST_SyncBeginning;
				masterSequencePart.useRefBone			= 'Reference';
				masterSequencePart.rotationTypeUsingRefBone = SRT_TowardsOtherEntity;
				masterSequencePart.shouldSlide			= false;
				masterSequencePart.shouldRotate			= false;
				
				masterSequencePart.blendInTime			= 0.5f;

				masterSequencePart.blendOutTime			= 0.5f;
				
				slave.AddTag('ACS_bruxa_attack_bite_front_rp_ACS');

				slaveSequencePart.animation				= '';	
				slaveSequencePart.syncType				= AMST_SyncBeginning;
				slaveSequencePart.shouldRotate			= false;
				slaveSequencePart.shouldSlide			= false;
				slaveSequencePart.finalHeading			= thePlayer.GetHeading();
				
				slaveSequencePart.blendInTime			= 0;
				slaveSequencePart.blendOutTime			= 0;

				break;		
			}
			case 'bruxa_attack_bite_back_lp_bruxa_ACS':
			{
				//movementAdjustorFinisher.RotateTowards( ticketFinisher, slave );

				AddTimer('ACS_Finisher_Unblock_Action', 2.85 , false);

				masterSequencePart.animation			= 'bruxa_attack_bite_back_lp_bruxa_ACS';
				masterSequencePart.syncType				= AMST_SyncBeginning;
				masterSequencePart.useRefBone			= 'Reference';
				masterSequencePart.rotationTypeUsingRefBone = SRT_TowardsOtherEntity;
				masterSequencePart.shouldSlide			= false;
				masterSequencePart.shouldRotate			= false;
				
				masterSequencePart.blendInTime			= 0.5f;
				masterSequencePart.blendOutTime			= 0.5f;

				slave.AddTag('ACS_bruxa_attack_bite_back_lp_ACS');

				slaveSequencePart.animation				= '';	
				slaveSequencePart.syncType				= AMST_SyncBeginning;
				slaveSequencePart.shouldRotate			= false;
				slaveSequencePart.shouldSlide			= false;
				slaveSequencePart.finalHeading			= thePlayer.GetHeading();
				
				slaveSequencePart.blendInTime			= 0;
				slaveSequencePart.blendOutTime			= 0;

				break;		
			}
			case 'bruxa_attack_bite_back_rp_bruxa_ACS':
			{
				//movementAdjustorFinisher.RotateTowards( ticketFinisher, slave );

				AddTimer('ACS_Finisher_Unblock_Action', 2.85 , false);

				masterSequencePart.animation			= 'bruxa_attack_bite_back_rp_bruxa_ACS';
				masterSequencePart.syncType				= AMST_SyncBeginning;
				masterSequencePart.useRefBone			= 'Reference';
				masterSequencePart.rotationTypeUsingRefBone = SRT_TowardsOtherEntity;
				masterSequencePart.shouldSlide			= false;
				masterSequencePart.shouldRotate			= false;
				
				masterSequencePart.blendInTime			= 0.5f;

				masterSequencePart.blendOutTime			= 0.5f;

				slave.AddTag('ACS_bruxa_attack_bite_back_rp_ACS');

				slaveSequencePart.animation				= '';	
				slaveSequencePart.syncType				= AMST_SyncBeginning;
				slaveSequencePart.shouldRotate			= false;
				slaveSequencePart.shouldSlide			= false;
				slaveSequencePart.finalHeading			= thePlayer.GetHeading();
				
				slaveSequencePart.blendInTime			= 0;
				slaveSequencePart.blendOutTime			= 0;

				break;		
			}			
			default : 
			{
				//movementAdjustorFinisher.RotateTowards( ticketFinisher, slave );

				AddTimer('ACS_Finisher_Unblock_Action', 0.125 , false);
				return false;
			}
		}

		masterDef.parts.PushBack( masterSequencePart );
		masterDef.entity						= master;
		masterSequencePart.sequenceIndex		= 0;
		masterDef.manualSlotName			= 'GAMEPLAY_SLOT';
		masterDef.freezeAtEnd					= false;

		slaveSequencePart.sequenceIndex			= 0;
		slaveSequencePart.disableProxyCollisions = true;
		//slave.SetKinematic( true );
		slaveDef.parts.PushBack( slaveSequencePart );
		slaveDef.entity							= slave;
		slaveDef.manualSlotName					= 'GAMEPLAY_SLOT';
		slaveDef.freezeAtEnd					= false;

		finisherAnim 							= false;

		
		sequenceIndex = syncInstance.RegisterMaster( masterDef );
		
		
		actorMaster = (CActor)master;
		actorSlave = (CActor)slave;
		
		if(actorMaster)
		{
			actorMaster.SignalGameplayEventParamInt( 'SetupSyncInstance', instanceIndex );
			actorMaster.SignalGameplayEventParamInt( 'SetupSequenceIndex', sequenceIndex );
			if ( finisherAnim )
				actorMaster.SignalGameplayEvent( 'PlayFinisherSyncedAnim' );
			else
				actorMaster.SignalGameplayEvent( 'PlaySyncedAnim' );
			
		}
		
		sequenceIndex = syncInstance.RegisterSlave( slaveDef );
		if( sequenceIndex == -1 ) 
		{
			return false;
		}
		
		if(actorSlave)
		{
			if( syncAction == 'Throat' )
				actorSlave.SignalGameplayEventParamCName( 'SetupEndEvent', 'CriticalState' );
				
			actorSlave.SignalGameplayEventParamInt( 'SetupSyncInstance', instanceIndex );
			actorSlave.SignalGameplayEventParamInt( 'SetupSequenceIndex', sequenceIndex );
			if ( finisherAnim )
				actorSlave.SignalGameplayEvent( 'PlayFinisherSyncedAnim' );
			else
				actorSlave.SignalGameplayEvent( 'PlaySyncedAnim' );
		}
		
		return true;
	}

	var monster_finisher_index : int;

	default monster_finisher_index = -1;

	var previous_monster_finisher_index : int;

	default previous_monster_finisher_index = -1;

	public function ACS_SetupSyncAnimInternalMonster( syncAction : name, master, slave : CEntity ) : bool
	{
		var masterDef, slaveDef						: SAnimationSequenceDefinition;
		var masterSequencePart, slaveSequencePart	: SAnimationSequencePartDefinition;
		var syncInstance							: CAnimationManualSlotSyncInstance;
		
		var instanceIndex							: int;
		var sequenceIndex							: int;
		
		var temp 									: name; 
		var tempF 									: float;
		var rot 									: EulerAngles;
		
		var finisherAnim 							: bool;
		var pos 									: Vector;
		
		var syncAnimName, cameraAnimName			: name;
		
		var node, node1 							: CNode; 
		var rot0, rot1 								: EulerAngles;
		
		var masterAnim, slaveAnim 					: name;
		var syncAnimIndex							: int;
		var currentAnimInstance						: CAnimationManualSlotSyncInstance;
		var actorMaster, actorSlave 				: CActor;

		var fear_actors								: array<CActor>;
		var j, k 									: int;
		var fear_actor								: CActor;
		var animatedComponentFearActor				: CAnimatedComponent;

		var finisher_actor							: CActor;
		var animatedComponentFinisherActor			: CAnimatedComponent;

		var movementAdjustorFinisher, movementAdjustorFinisherActor				: CMovementAdjustor;
		var ticketFinisher, ticketFinisherActor 								: SMovementAdjustmentRequestTicket;
		var animatedComponentB													: CAnimatedComponent;

		if ( ((CActor)slave).HasTag('ACS_Hit_Lag'))
		{
			animatedComponentB = (CAnimatedComponent)(((CActor)slave).GetComponentByClassName( 'CAnimatedComponent' ));

			animatedComponentB.UnfreezePose();

			animatedComponentB.UnfreezePoseFadeOut(0.1);

			((CActor)slave).RemoveTag('ACS_Hit_Lag');
		}
		
		if (((CActor)slave).GetInteractionPriority() != IP_Max_Unpushable )
		{
			((CActor)slave).SetInteractionPriority( IP_Max_Unpushable );
		}

		theInput.IgnoreGameInput( 'GI_AxisLeftX', true );
		theInput.IgnoreGameInput( 'GI_AxisLeftY', true );

		syncInstance = theGame.GetSyncAnimManager().CreateNewSyncInstance( instanceIndex );
		syncAnimIndex = instanceIndex;
		currentAnimInstance = syncInstance;

		//thePlayer.BlockAction(EIAB_Interactions, 'SyncManager' );
		//thePlayer.BlockAction(EIAB_FastTravel, 'SyncManager' );

		ACS_ExplorationDelayHack(false, 3);

		action_interrupt();

		RemoveTimer('SwordTauntSwitch'); 
		RemoveTimer('SwordTauntRunningSwitch'); 
		 
		thePlayer.RaiseEvent('ACS_SwordTauntEnd');
		thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');

		if(ACSGetCEntity('ACS_Viper_Dagger_L'))
		{
			thePlayer.RaiseEvent('ACS_LHandAttack01');
		}

		RemoveTimer('CombatTauntDelay');RemoveTimer('SwordTauntRunningSwitchSecondary'); 
		RemoveTimer('SwordTauntRunningSwitchSecondaryWeaponBlood'); 

		if (backhandSwordWield)
		{
			backhandSwordWield = false;
		}
		
		thePlayer.RaiseEvent('ACS_ForceHandClosedREnd');

		movementAdjustorFinisher = GetWitcherPlayer().GetMovingAgentComponent().GetMovementAdjustor();

		movementAdjustorFinisher.CancelAll();
		
		ticketFinisher = movementAdjustorFinisher.CreateNewRequest( 'ACS_Finisher_Rotate' );
			
		movementAdjustorFinisher.AdjustmentDuration( ticketFinisher, 0.25 );

		movementAdjustorFinisher.ShouldStartAt(ticketFinisher, GetWitcherPlayer().GetWorldPosition());
		movementAdjustorFinisher.MaxRotationAdjustmentSpeed( ticketFinisher, 5000000 );
		movementAdjustorFinisher.MaxLocationAdjustmentSpeed( ticketFinisher, 5000000 );

		movementAdjustorFinisher.RotateTowards( ticketFinisher, slave );

		thePlayer.BlockAllActions( 'ACS_Finisher_Action_Block', true );

		thePlayer.SetGuarded(false);
		thePlayer.OnGuardedReleased();

		ACS_Axii_Shield_Destroy_IMMEDIATE();

		if (((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'wood_hollow'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'wood_debris'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'dirt_hard'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'dirt_soil'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'hay'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'stone_debris'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'stone_solid'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'clay_tile'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'gravel_large'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'gravel_small'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'sand'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'water_shallow'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'water_deep'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'grass_short'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'grass_long'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'carpet'
		)
		{

			thePlayer.StopEffect('jump_ground_fx1');
			thePlayer.PlayEffect('jump_ground_fx1');

			if (((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'dirt_hard'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'dirt_soil'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'hay'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'stone_debris'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'clay_tile'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'gravel_large'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'gravel_small'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'sand'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'grass_short'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'grass_long'
			)
			{
				//thePlayer.StopEffect('covered_dirt_ACS');
				//thePlayer.PlayEffect('covered_dirt_ACS');

				if( GetRainStrength() > 0 
				&& !thePlayer.IsInInterior()
				&& !RoofCheck()
				) 
				{

				}
				else if (ACS_Settings_Main_Bool('acs_player_misc_settings','acs_dirt_vfx_enabled', true))
				{
					thePlayer.StopEffect('covered_dirt_big_ACS');
					thePlayer.PlayEffect('covered_dirt_big_ACS');

					thePlayer.StopEffect('covered_dirt_small_ACS');
					thePlayer.PlayEffect('covered_dirt_small_ACS');
				}
			}
		}

		thePlayer.AddTag('ACS_IsPerformingFinisher');

		thePlayer.AddTag('ACS_Sword_Hit_Blood_Trigger');

		thePlayer.SetImmortalityMode( AIM_Invulnerable, AIC_Default, true ); 
		thePlayer.SetCanPlayHitAnim(false); 
		//thePlayer.EnableCharacterCollisions(false); 
		thePlayer.AddBuffImmunity_AllNegative('ACS_Finisher_Immune_Negative', true); 
		thePlayer.AddBuffImmunity_AllCritical('ACS_Finisher_Immune_Critical', true); 

		//ChangeInteractionPriority();
		
		RemoveTimer('ACS_Finisher_Unblock_Action');

		RemoveTimer('ACS_Finisher_Unblock_Camera');

		((CActor)slave).SetCanPlayHitAnim(true);

		((CNewNPC)slave).SetUnstoppable(false);

		FreezeMoveTargets(6);
		
		if (((CActor)slave).IsAlive())
		{
			((CActor)slave).Kill( 'ACS_Finisher', false, thePlayer );
		}

		if (thePlayer.HasTag('ACS_IsSwordWalking'))
		{
			thePlayer.RemoveTag('ACS_IsSwordWalking');
		}

		RemoveTimer('SwordTauntSwitch'); 
		RemoveTimer('SwordTauntRunningSwitch'); 
		 
		 

		if ( AnimProgressCheck() )
		{
			if (thePlayer.IsInAir()
			|| thePlayer.IsFalling()
			)
			{
				//thePlayer.RaiseEvent('ACS_ForceLegsFloatIdle');
			}
			else
			{
				if (thePlayer.HasTag('ACS_IsSwordWalking'))
				{
					thePlayer.RaiseEvent('ACS_SwordWalkAdditiveEnd');thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');RemoveTimer('CombatTauntDelay');thePlayer.RaiseEvent('ACS_SwordTauntEnd');

					thePlayer.RemoveTag('ACS_IsSwordWalking');
				}
			}
		}

		if (thePlayer.IsWeaponHeld('steelsword'))
		{
			if ( ACS_GetItem_Sword_IsEquipped('olgierd_steel', 'steel') )
			{
				if (!GetWitcherPlayer().HasTag('ACS_Camo_Active')
				&& ACS_Settings_Main_Bool('acs_dodge_settings','acs_dodge_effects', false))
				{
					GetWitcherPlayer().PlayEffectSingle('special_attack_fx');
					GetWitcherPlayer().StopEffect('special_attack_fx');
				}
			}
		}
		else if (thePlayer.IsWeaponHeld('silversword'))
		{
			if ( ACS_GetItem_Sword_IsEquipped('olgierd_silver', 'silver') )
			{
				if (!GetWitcherPlayer().HasTag('ACS_Camo_Active')
				&& ACS_Settings_Main_Bool('acs_dodge_settings','acs_dodge_effects', false))
				{
					GetWitcherPlayer().PlayEffectSingle('special_attack_fx');
					GetWitcherPlayer().StopEffect('special_attack_fx');
				}
			}
		}

		pos = ACSGetCActorPosition( slave );

		switch( syncAction )
		{
			case 'monster_stab_finisher':
			{
				AddTimer('ACS_Finisher_Unblock_Action', 1.5 , false);

				masterSequencePart.animation			= 'tw2_npc_sword1h_40_ACS';
				masterSequencePart.syncType				= AMST_SyncBeginning;
				masterSequencePart.shouldSlide			= true;
				masterSequencePart.shouldRotate			= true;
		
				masterSequencePart.finalPosition	= 0.5 * VecNormalize( master.GetWorldPosition() - pos ) + pos;
				masterSequencePart.finalHeading		= VecHeading( pos - master.GetWorldPosition() );
				
				masterSequencePart.blendInTime			= 0.5f;
				masterSequencePart.blendOutTime			= 1.0f;

				//slave.SetKinematic( true );

				slave.AddTag('ACS_monster_stab_finisher');

				slaveSequencePart.animation				= '';	
				slaveSequencePart.syncType				= AMST_SyncBeginning;
				slaveSequencePart.shouldRotate			= false;
				slaveSequencePart.shouldSlide			= false;
				slaveSequencePart.finalHeading			= thePlayer.GetHeading();
				
				slaveSequencePart.blendInTime			= 0;
				slaveSequencePart.blendOutTime			= 0;

				break;		
			}

			case 'monster_slice_finisher':
			{
				AddTimer('ACS_Finisher_Unblock_Action', 1.75 , false);

				monster_finisher_index = RandDifferent(previous_monster_finisher_index , 6);

				switch (monster_finisher_index) 
				{	
					case 5:

					masterSequencePart.animation			= 'man_finisher_dlc_arm_rp_for_monsters_ACS';
					masterSequencePart.blendInTime			= 0.125f;
					masterSequencePart.blendOutTime			= 0.125f;

					thePlayer.RaiseEvent('ACS_AimAssistDodgeForwardR');

					ProcessFinisherCamera('man_finisher_dlc_arm_rp');

					break;	
							
					case 4:

					masterSequencePart.animation			= 'man_finisher_dlc_arm_lp_for_monsters_ACS';
					masterSequencePart.blendInTime			= 0.125f;
					masterSequencePart.blendOutTime			= 0.125f;

					thePlayer.RaiseEvent('ACS_AimAssistDodgeForwardR');

					ProcessFinisherCamera('man_finisher_dlc_arm_lp');

					break;	

					case 3:

					masterSequencePart.animation			= 'man_finisher_dlc_torso_lp';
					masterSequencePart.blendInTime			= 0.5f;
					if (thePlayer.IsLastEnemyKilled())
					{
						masterSequencePart.blendOutTime			= 0.5f;
					}
					else
					{
						masterSequencePart.blendOutTime			= 1.5f;
					}

					ProcessFinisherCamera('man_finisher_dlc_torso_lp');

					break;	
							
					case 2:

					masterSequencePart.animation			= 'man_finisher_dlc_torso_rp';
					masterSequencePart.blendInTime			= 0.5f;
					if (thePlayer.IsLastEnemyKilled())
					{
						masterSequencePart.blendOutTime			= 0.5f;
					}
					else
					{
						masterSequencePart.blendOutTime			= 1.5f;
					}

					ProcessFinisherCamera('man_finisher_dlc_torso_rp');

					break;	

					case 1:

					masterSequencePart.animation			= 'man_finisher_dlc_legs_rp';
					masterSequencePart.blendInTime			= 0.5f;
					masterSequencePart.blendOutTime			= 0.25f;

					ProcessFinisherCamera('man_finisher_dlc_legs_rp');

					break;	

					case 0:

					masterSequencePart.animation			= 'man_finisher_dlc_legs_lp';
					masterSequencePart.blendInTime			= 0.5f;
					masterSequencePart.blendOutTime			= 1.0f;

					ProcessFinisherCamera('man_finisher_dlc_legs_lp');

					break;	
						
					default:

					masterSequencePart.animation			= 'man_finisher_dlc_legs_lp';
					masterSequencePart.blendInTime			= 0.5f;
					masterSequencePart.blendOutTime			= 1.0f;

					ProcessFinisherCamera('man_finisher_dlc_legs_lp');

					break;	
				}

				previous_monster_finisher_index = monster_finisher_index;

				masterSequencePart.syncType				= AMST_SyncBeginning;
				masterSequencePart.useRefBone			= 'Reference';
				masterSequencePart.rotationTypeUsingRefBone = SRT_TowardsOtherEntity;
				masterSequencePart.shouldSlide			= true;
				masterSequencePart.shouldRotate			= true;

				slave.AddTag('ACS_monster_slice_finisher');

				finisher_actor = ((CActor)(slave));

				animatedComponentFinisherActor = (CAnimatedComponent)finisher_actor.GetComponentByClassName( 'CAnimatedComponent' );

				if 
				(finisher_actor.HasAbility('mon_ghoul_base')
				|| finisher_actor.HasTag('ACS_Nekker_Guardian'))
				{
					finisher_actor.ACS_SetAnimationSpeedMultiplier(0.5);
				}
				else
				{
					animatedComponentFinisherActor.FreezePoseFadeIn(0.125f);

					animatedComponentFinisherActor.UnfreezePoseFadeOut(2.75f);
				}

				((CNewNPC)slave).RemoveTimer('ACS_Finisher_Slice_Delay');
				((CNewNPC)slave).AddTimer('ACS_Finisher_Slice_Delay', 0.5 , false);

				slaveSequencePart.animation				= '';	
				slaveSequencePart.syncType				= AMST_SyncBeginning;
				slaveSequencePart.shouldRotate			= false;
				slaveSequencePart.shouldSlide			= false;
				slaveSequencePart.finalHeading			= thePlayer.GetHeading();
				
				slaveSequencePart.blendInTime			= 0;
				slaveSequencePart.blendOutTime			= 0;

				break;		
			}	

			case 'monster_igni_finisher':
			{
				AddTimer('ACS_Finisher_Unblock_Action', 1.5 , false);

				if(thePlayer.GetCombatIdleStance() <= 0.f )
				{
					masterSequencePart.animation			= 'man_ger_sword_ignii_front_lp';
				}
				else
				{
					masterSequencePart.animation			= 'man_ger_sword_ignii_front_rp';
				}

				//thePlayer.RaiseEvent('ACS_IgniLight');

				masterSequencePart.syncType				= AMST_SyncBeginning;
				masterSequencePart.useRefBone			= 'Reference';
				masterSequencePart.rotationTypeUsingRefBone = SRT_TowardsOtherEntity;
				masterSequencePart.shouldSlide			= true;
				masterSequencePart.shouldRotate			= true;
				
				masterSequencePart.blendInTime			= 0;
				masterSequencePart.blendOutTime			= 0.5f;

				ProcessFinisherCamera('man_finisher_04_lp', 'man_finisher_05_rp');

				slave.AddTag('ACS_monster_igni_finisher');
				slave.AddTag('ACS_Killed_By_Fire');

				((CNewNPC)slave).RemoveTimer('ACS_Finisher_Igni_Delay');
				((CNewNPC)slave).AddTimer('ACS_Finisher_Igni_Delay', 0.5 , false);

				RemoveTimer('IgniLightIcon');
				AddTimer('IgniLightIcon', 0.5 , false);

				finisher_actor = ((CActor)(slave));

				slaveSequencePart.animation				= '';	
				slaveSequencePart.syncType				= AMST_SyncBeginning;
				slaveSequencePart.shouldRotate			= false;
				slaveSequencePart.shouldSlide			= false;
				slaveSequencePart.finalHeading			= thePlayer.GetHeading();
				
				slaveSequencePart.blendInTime			= 0;
				slaveSequencePart.blendOutTime			= 0;

				break;		
			}	

			case 'monster_aard_finisher':
			{
				AddTimer('ACS_Finisher_Unblock_Action', 1.5 , false);

				if(thePlayer.GetCombatIdleStance() <= 0.f )
				{
					masterSequencePart.animation			= 'man_ger_sword_aard_front_lp';
				}
				else
				{
					masterSequencePart.animation			= 'man_ger_sword_aard_front_rp';
				}

				//thePlayer.RaiseEvent('ACS_IgniLight');

				masterSequencePart.syncType				= AMST_SyncBeginning;
				masterSequencePart.useRefBone			= 'Reference';
				masterSequencePart.rotationTypeUsingRefBone = SRT_TowardsOtherEntity;
				masterSequencePart.shouldSlide			= true;
				masterSequencePart.shouldRotate			= true;
				
				masterSequencePart.blendInTime			= 0;
				masterSequencePart.blendOutTime			= 0.5f;

				ProcessFinisherCamera('man_finisher_04_lp', 'man_finisher_05_rp');

				slave.AddTag('ACS_monster_aard_finisher');
	
				((CNewNPC)slave).RemoveTimer('ACS_Finisher_Aard_Delay');
				((CNewNPC)slave).AddTimer('ACS_Finisher_Aard_Delay', 0.75 , false);

				RemoveTimer('AardLightIcon');
				AddTimer('AardLightIcon', 0.75 , false);

				finisher_actor = ((CActor)(slave));

				slaveSequencePart.animation				= '';	
				slaveSequencePart.syncType				= AMST_SyncBeginning;
				slaveSequencePart.shouldRotate			= false;
				slaveSequencePart.shouldSlide			= false;
				slaveSequencePart.finalHeading			= thePlayer.GetHeading();
				
				slaveSequencePart.blendInTime			= 0;
				slaveSequencePart.blendOutTime			= 0;

				break;		
			}	

			case 'monster_quen_finisher':
			{
				AddTimer('ACS_Finisher_Unblock_Action', 1.5 , false);

				if(thePlayer.GetCombatIdleStance() <= 0.f )
				{
					masterSequencePart.animation			= 'man_ger_sword_quen_front_lp';
				}
				else
				{
					masterSequencePart.animation			= 'man_ger_sword_quen_front_rp';
				}

				//thePlayer.RaiseEvent('ACS_IgniLight');

				masterSequencePart.syncType				= AMST_SyncBeginning;
				masterSequencePart.useRefBone			= 'Reference';
				masterSequencePart.rotationTypeUsingRefBone = SRT_TowardsOtherEntity;
				masterSequencePart.shouldSlide			= true;
				masterSequencePart.shouldRotate			= true;
				
				masterSequencePart.blendInTime			= 0;
				masterSequencePart.blendOutTime			= 0.5f;

				ProcessFinisherCamera('man_finisher_04_lp', 'man_finisher_05_rp');

				slave.AddTag('ACS_monster_quen_finisher');
	
				((CNewNPC)slave).RemoveTimer('ACS_Finisher_Quen_Delay');
				((CNewNPC)slave).AddTimer('ACS_Finisher_Quen_Delay', 0.5 , false);

				RemoveTimer('QuenLightIcon');
				AddTimer('QuenLightIcon', 0.5 , false);

				finisher_actor = ((CActor)(slave));

				slaveSequencePart.animation				= '';	
				slaveSequencePart.syncType				= AMST_SyncBeginning;
				slaveSequencePart.shouldRotate			= false;
				slaveSequencePart.shouldSlide			= false;
				slaveSequencePart.finalHeading			= thePlayer.GetHeading();
				
				slaveSequencePart.blendInTime			= 0;
				slaveSequencePart.blendOutTime			= 0;

				break;		
			}	

			case 'monster_yrden_finisher':
			{
				AddTimer('ACS_Finisher_Unblock_Action', 1.5 , false);

				if(thePlayer.GetCombatIdleStance() <= 0.f )
				{
					masterSequencePart.animation			= 'man_ger_sword_yrden_ground_lp';
				}
				else
				{
					masterSequencePart.animation			= 'man_ger_sword_yrden_ground_rp';
				}

				//thePlayer.RaiseEvent('ACS_AardLight');

				masterSequencePart.syncType				= AMST_SyncBeginning;
				masterSequencePart.useRefBone			= 'Reference';
				masterSequencePart.rotationTypeUsingRefBone = SRT_TowardsOtherEntity;
				masterSequencePart.shouldSlide			= true;
				masterSequencePart.shouldRotate			= true;
				
				masterSequencePart.blendInTime			= 0;
				masterSequencePart.blendOutTime			= 0.5f;

				ProcessFinisherCamera('man_finisher_04_lp', 'man_finisher_05_rp');

				slave.AddTag('ACS_monster_yrden_finisher');
	
				RemoveTimer('YrdenLightIcon');
				AddTimer('YrdenLightIcon', 0.5 , false);

				((CNewNPC)slave).RemoveTimer('ACS_Finisher_Yrden_Delay');
				((CNewNPC)slave).AddTimer('ACS_Finisher_Yrden_Delay', 0.5 , false);

				finisher_actor = ((CActor)(slave));

				slaveSequencePart.animation				= '';	
				slaveSequencePart.syncType				= AMST_SyncBeginning;
				slaveSequencePart.shouldRotate			= false;
				slaveSequencePart.shouldSlide			= false;
				slaveSequencePart.finalHeading			= thePlayer.GetHeading();
				
				slaveSequencePart.blendInTime			= 0;
				slaveSequencePart.blendOutTime			= 0;

				break;		
			}		

			case 'monster_axii_finisher':
			{
				AddTimer('ACS_Finisher_Unblock_Action', 1.5 , false);

				if(thePlayer.GetCombatIdleStance() <= 0.f )
				{
					masterSequencePart.animation			= 'man_ger_sword_axii_release_lp';
				}
				else
				{
					masterSequencePart.animation			= 'man_ger_sword_axii_release_rp';
				}

				//thePlayer.RaiseEvent('ACS_AardLight');

				masterSequencePart.syncType				= AMST_SyncBeginning;
				masterSequencePart.useRefBone			= 'Reference';
				masterSequencePart.rotationTypeUsingRefBone = SRT_TowardsOtherEntity;
				masterSequencePart.shouldSlide			= true;
				masterSequencePart.shouldRotate			= true;
				
				masterSequencePart.blendInTime			= 0.125f;
				masterSequencePart.blendOutTime			= 0.125f;

				ProcessFinisherCamera('man_finisher_04_lp', 'man_finisher_05_rp');

				slave.AddTag('ACS_monster_axii_finisher');
	
				RemoveTimer('AxiiLightIcon');
				AddTimer('AxiiLightIcon', 0.5 , false);

				thePlayer.SoundEvent("sign_axii_pre_start");

				((CNewNPC)slave).RemoveTimer('ACS_Finisher_Axii_Delay');
				((CNewNPC)slave).AddTimer('ACS_Finisher_Axii_Delay', 0.5 , false);

				finisher_actor = ((CActor)(slave));

				slaveSequencePart.animation				= '';	
				slaveSequencePart.syncType				= AMST_SyncBeginning;
				slaveSequencePart.shouldRotate			= false;
				slaveSequencePart.shouldSlide			= false;
				slaveSequencePart.finalHeading			= thePlayer.GetHeading();
				
				slaveSequencePart.blendInTime			= 0;
				slaveSequencePart.blendOutTime			= 0;

				break;		
			}

			default : 
			{
				return false;
			}
		}
		
		masterDef.parts.PushBack( masterSequencePart );
		masterDef.entity						= master;
		masterSequencePart.sequenceIndex		= 0;
		masterDef.manualSlotName			= 'GAMEPLAY_SLOT';
		masterDef.freezeAtEnd					= false;

		slaveSequencePart.sequenceIndex			= 0;
		slaveSequencePart.disableProxyCollisions = true;
		//slave.SetKinematic( true );
		slaveDef.parts.PushBack( slaveSequencePart );
		slaveDef.entity							= slave;
		slaveDef.manualSlotName					= 'GAMEPLAY_SLOT';
		slaveDef.freezeAtEnd					= false;

		finisherAnim 							= false;


		sequenceIndex = syncInstance.RegisterMaster( masterDef );
		
		
		actorMaster = (CActor)master;
		actorSlave = (CActor)slave;
		
		if(actorMaster)
		{
			actorMaster.SignalGameplayEventParamInt( 'SetupSyncInstance', instanceIndex );
			actorMaster.SignalGameplayEventParamInt( 'SetupSequenceIndex', sequenceIndex );
			if ( finisherAnim )
				actorMaster.SignalGameplayEvent( 'PlayFinisherSyncedAnim' );
			else
				actorMaster.SignalGameplayEvent( 'PlaySyncedAnim' );
			
		}
		
		sequenceIndex = syncInstance.RegisterSlave( slaveDef );
		if( sequenceIndex == -1 ) 
		{
			return false;
		}
		
		/*
		if(actorSlave)
		{
			if( syncAction == 'Throat' )
				actorSlave.SignalGameplayEventParamCName( 'SetupEndEvent', 'CriticalState' );
				
			actorSlave.SignalGameplayEventParamInt( 'SetupSyncInstance', instanceIndex );
			actorSlave.SignalGameplayEventParamInt( 'SetupSequenceIndex', sequenceIndex );
			if ( finisherAnim )
				actorSlave.SignalGameplayEvent( 'PlayFinisherSyncedAnim' );
			else
				actorSlave.SignalGameplayEvent( 'PlaySyncedAnim' );
		}
		*/

		return true;
	}

	////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	var counter_wound_index : int;

	default counter_wound_index = -1;

	var previous_counter_wound_index : int;

	default previous_counter_wound_index = -1;



	var counter_wound_index_secondary : int;

	default counter_wound_index_secondary = -1;

	var previous_counter_wound_index_secondary : int;

	default previous_counter_wound_index_secondary = -1;




	var counter_wound_target : CNewNPC;

	function CreateCounterWoundSwordFX( actor : CNewNPC)
	{
		var sword_slash_ent														: CEntity;

		if (ACS_Settings_Main_Bool('acs_visual_main_settings','acs_directional_slash_effects_enabled', true)
		&& (thePlayer.IsDeadlySwordHeld() || ACSGetCEntity('acs_finisher_dagger') || ACS_Vampire_Claws_Access())
		)
		{
			sword_slash_ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\fx\sword_slash_circular\acs_sword_slash_circular.w2ent", true ), actor.GetWorldPosition() + Vector(0,0,1.5), thePlayer.GetWorldRotation());

			if (RandF() < 0.5 )
			{
				sword_slash_ent.AddTag('ACS_Sword_Slash_Circular_Finisher_Switch_Diagonal_Left');
			}
			else
			{
				sword_slash_ent.AddTag('ACS_Sword_Slash_Circular_Finisher_Switch_Diagonal_Right');
			}
		}
	}

	public function ACS_SetupSyncAnimInternalCounterWound(master, slave : CEntity, optional force_tw1_anim : bool ) : bool
	{
		var masterDef, slaveDef													: SAnimationSequenceDefinition;
		var masterSequencePart, slaveSequencePart								: SAnimationSequencePartDefinition;
		var syncInstance														: CAnimationManualSlotSyncInstance;
		
		var instanceIndex														: int;
		var sequenceIndex														: int;
		
		var temp 																: name; 
		var tempF 																: float;
		var rot 																: EulerAngles;
		
		var finisherAnim 														: bool;
		var pos 																: Vector;
		
		var syncAnimName, cameraAnimName										: name;
		
		var node, node1 														: CNode; 
		var rot0, rot1 															: EulerAngles;
		
		var masterAnim, slaveAnim 												: name;
		var syncAnimIndex														: int;
		var currentAnimInstance													: CAnimationManualSlotSyncInstance;
		var actorMaster, actorSlave 											: CActor;

		var fear_actors															: array<CActor>;
		var j, k 																: int;
		var fear_actor															: CActor;
		var animatedComponentFearActor											: CAnimatedComponent;

		var finisher_actor														: CActor;
		var animatedComponentFinisherActor										: CAnimatedComponent;

		var movementAdjustorFinisher, movementAdjustorFinisherActor				: CMovementAdjustor;
		var ticketFinisher, ticketFinisherActor 								: SMovementAdjustmentRequestTicket;
		var animatedComponentB													: CAnimatedComponent;

		var params 																: SCustomEffectParams;

		var dist																: float;

		var sword_slash_ent														: CEntity;

		var boneRotation, pBoneRotation											: EulerAngles;
		var bonePosition, pBonePosition											: Vector;

		if (!thePlayer.IsAnyWeaponHeld()
		|| thePlayer.IsWeaponHeld('fist')
		)
		{
			thePlayer.RaiseEvent('ACS_IdleAdditiveReset');

			if (ACS_Vampire_Claws_Access())
			{

			}
			else
			{
				if (!sneaking_dagger_enabled)
				{
					//thePlayer.RaiseEvent('ACS_IdleAdditiveHeavyMeleeCheck');

					thePlayer.RaiseEvent('ACS_SwordTaunt10');

					ACSGetCEntityDestroyAll('acs_finisher_dagger');

					vACS_Dagger_Summon = new cACS_Dagger_Summon in this;
						
					vACS_Dagger_Summon.ACS_Finisher_Dagger_Summon_Engage();

					RemoveTimer('ForceControlModuleHudUpdate');
					AddTimer('ForceControlModuleHudUpdate', 0.25f , false);

					sneaking_dagger_enabled = true;
				}

				if (ACSGetCEntity('acs_finisher_dagger'))
				{
					thePlayer.RaiseEvent('ACS_SwordTaunt10');

					ACSGetCEntity('acs_finisher_dagger').BreakAttachment();

					ACSGetCEntity('acs_finisher_dagger').CreateAttachment( GetWitcherPlayer(), 'r_weapon', Vector(0,0,0), EulerAngles(0,0,0) );

					thePlayer.SoundEvent("scene_geralt_unsheat_dagger");

					thePlayer.SoundEvent("scene_geralt_catch_dagger");
				}
			}
		}
		else
		{
			if (sneaking_dagger_enabled)
			{
				sneaking_dagger_enabled = false;

			}

			if ( !theSound.SoundIsBankLoaded("qu_nml_105.bnk") )
			{
				theSound.SoundLoadBank( "qu_nml_105.bnk", false );
			}

			GetWitcherPlayer().SoundEvent("qu_nml_105_geralt_sheats_dagger");

			ACSGetCEntityDestroyAll('acs_finisher_dagger');
		}

		((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent()).SetAnimatedMovement( true );

		//thePlayer.GetMovingAgentComponent().SetUseExtractedMotion( false );

		thePlayer.SoundEvent("sprj_kill_chance_bb_acs");

		if (!thePlayer.HasTag('ACS_Is_Sneaking')
		&& !ACS_IS_SNEAKING)
		{
			thePlayer.SoundEvent("sprj_kill_chance_bb_acs");
		}

		counter_wound_target = ((CNewNPC)slave);

		((CNewNPC)slave).ACS_ResetPostureImmediate();

		if ( ((CActor)slave).HasTag('ACS_Hit_Lag'))
		{
			animatedComponentB = (CAnimatedComponent)(((CActor)slave).GetComponentByClassName( 'CAnimatedComponent' ));

			animatedComponentB.UnfreezePose();

			animatedComponentB.UnfreezePoseFadeOut(0.1);

			((CActor)slave).RemoveTag('ACS_Hit_Lag');
		}

		((CActor)slave).ACS_SetAnimationSpeedMultiplier(1);
		
		if (((CActor)slave).GetInteractionPriority() != IP_Max_Unpushable )
		{
			((CActor)slave).SetInteractionPriority( IP_Max_Unpushable );
		}

		((CActor)slave).ACS_SetAnimationSpeedMultiplier(1);

		//syncInstance = theGame.GetSyncAnimManager().CreateNewSyncInstance( instanceIndex );
		//syncAnimIndex = instanceIndex;
		//currentAnimInstance = syncInstance;

		//thePlayer.BlockAction(EIAB_Interactions, 'SyncManager' );
		//thePlayer.BlockAction(EIAB_FastTravel, 'SyncManager' );

		ACS_ExplorationDelayHack(false, 3);

		action_interrupt();

		RemoveTimer('SwordTauntSwitch'); 
		RemoveTimer('SwordTauntRunningSwitch'); 
		 
		thePlayer.RaiseEvent('ACS_SwordTauntEnd');
		thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');

		if(ACSGetCEntity('ACS_Viper_Dagger_L'))
		{
			thePlayer.RaiseEvent('ACS_LHandAttack01');
		}

		RemoveTimer('CombatTauntDelay');RemoveTimer('SwordTauntRunningSwitchSecondary'); 
		RemoveTimer('SwordTauntRunningSwitchSecondaryWeaponBlood'); 

		if (backhandSwordWield)
		{
			backhandSwordWield = false;
		}
		
		thePlayer.RaiseEvent('ACS_ForceHandClosedREnd');

		movementAdjustorFinisher = GetWitcherPlayer().GetMovingAgentComponent().GetMovementAdjustor();

		movementAdjustorFinisher.CancelAll();
		
		ticketFinisher = movementAdjustorFinisher.CreateNewRequest( 'ACS_Finisher_Rotate' );
			
		movementAdjustorFinisher.AdjustmentDuration( ticketFinisher, 1 );

		movementAdjustorFinisher.ShouldStartAt(ticketFinisher, GetWitcherPlayer().GetWorldPosition());
		movementAdjustorFinisher.MaxRotationAdjustmentSpeed( ticketFinisher, 5000000 );
		movementAdjustorFinisher.MaxLocationAdjustmentSpeed( ticketFinisher, 5000000 );

		movementAdjustorFinisher.RotateTowards( ticketFinisher, slave );

		if (silver_fast_stance
		|| steel_fast_stance
		|| silver_group_stance
		|| steel_group_stance
		|| silver_strong_stance
		|| steel_strong_stance
		|| force_tw1_anim
		)
		{
			dist = (((CMovingPhysicalAgentComponent)((CActor)slave).GetMovingAgentComponent()).GetCapsuleRadius() 
			+ ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent()).GetCapsuleRadius());
		}
		else
		{
			if (thePlayer.IsDeadlySwordHeld())
			{
				dist = (((CMovingPhysicalAgentComponent)((CActor)slave).GetMovingAgentComponent()).GetCapsuleRadius() 
				+ ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent()).GetCapsuleRadius()) * 0.5;
			}
			else
			{
				dist = (((CMovingPhysicalAgentComponent)((CActor)slave).GetMovingAgentComponent()).GetCapsuleRadius() 
				+ ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent()).GetCapsuleRadius()) * 0.25;
			}
		}

		if (
		(((CMovingPhysicalAgentComponent)(counter_wound_target.GetMovingAgentComponent())).GetCapsuleHeight() >= 2
		|| counter_wound_target.GetRadius() >= 0.7
		|| counter_wound_target.HasAbility('Boss')
		|| counter_wound_target.HasTag('IsBoss')
		|| counter_wound_target.HasTag('ACS_Big_Boi'))
		&& !counter_wound_target.HasTag('ice_troll')
		&& counter_wound_target.GetSfxTag() != 'sfx_troll_cave')
		{
			dist = (((CMovingPhysicalAgentComponent)((CActor)counter_wound_target).GetMovingAgentComponent()).GetCapsuleRadius() 
				+ ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent()).GetCapsuleRadius()) * 0.825;
		}

		movementAdjustorFinisher.SlideTowards(ticketFinisher, slave, dist, dist);

		movementAdjustorFinisherActor = ((CActor)slave).GetMovingAgentComponent().GetMovementAdjustor();

		movementAdjustorFinisherActor.CancelAll();



		thePlayer.RaiseEvent('ACS_SneakAnimEnd');


		thePlayer.BlockAllActions( 'ACS_Finisher_Action_Block', true );

		thePlayer.SetGuarded(false);
		thePlayer.OnGuardedReleased();

		ACS_Axii_Shield_Destroy_IMMEDIATE();

		if (((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'wood_hollow'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'wood_debris'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'dirt_hard'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'dirt_soil'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'hay'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'stone_debris'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'stone_solid'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'clay_tile'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'gravel_large'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'gravel_small'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'sand'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'water_shallow'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'water_deep'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'grass_short'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'grass_long'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'carpet'
		)
		{

			thePlayer.StopEffect('jump_ground_fx1');
			thePlayer.PlayEffect('jump_ground_fx1');

			if (((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'dirt_hard'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'dirt_soil'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'hay'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'stone_debris'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'clay_tile'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'gravel_large'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'gravel_small'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'sand'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'grass_short'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'grass_long'
			)
			{
				//thePlayer.StopEffect('covered_dirt_ACS');
				//thePlayer.PlayEffect('covered_dirt_ACS');

				if( GetRainStrength() > 0 
				&& !thePlayer.IsInInterior()
				&& !RoofCheck()
				) 
				{

				}
				else if (ACS_Settings_Main_Bool('acs_player_misc_settings','acs_dirt_vfx_enabled', true))
				{
					thePlayer.StopEffect('covered_dirt_big_ACS');
					thePlayer.PlayEffect('covered_dirt_big_ACS');

					thePlayer.StopEffect('covered_dirt_small_ACS');
					thePlayer.PlayEffect('covered_dirt_small_ACS');
				}
			}
		}

		thePlayer.AddTag('ACS_IsPerformingFinisher');

		thePlayer.AddTag('ACS_IsPerformingCounterWound');

		thePlayer.AddTag('ACS_Sword_Hit_Blood_Trigger');

		thePlayer.SetImmortalityMode( AIM_Invulnerable, AIC_Default, true ); 
		thePlayer.SetCanPlayHitAnim(false); 
		thePlayer.EnableCharacterCollisions(false); 
		thePlayer.AddBuffImmunity_AllNegative('ACS_Finisher_Immune_Negative', true); 
		thePlayer.AddBuffImmunity_AllCritical('ACS_Finisher_Immune_Critical', true); 

		//ChangeInteractionPriority();
		
		RemoveTimer('ACS_Finisher_Unblock_Action');

		RemoveTimer('ACS_Finisher_Unblock_Camera');

		((CActor)slave).SetCanPlayHitAnim(true);

		((CNewNPC)slave).SetUnstoppable(false);

		params.effectType = EET_Blindness;
		params.creator = GetWitcherPlayer();
		params.sourceName = "ACS_Counter_Wound";
		params.duration = 3;

		((CNewNPC)slave).AddEffectCustom( params );	

		FreezeMoveTargets(6);

		if (thePlayer.HasTag('ACS_IsSwordWalking'))
		{
			thePlayer.RemoveTag('ACS_IsSwordWalking');
		}

		RemoveTimer('SwordTauntSwitch'); 
		RemoveTimer('SwordTauntRunningSwitch'); 
		 
		 

		if ( AnimProgressCheck() )
		{
			if (thePlayer.IsInAir()
			|| thePlayer.IsFalling()
			)
			{
				//thePlayer.RaiseEvent('ACS_ForceLegsFloatIdle');
			}
			else
			{
				if (thePlayer.HasTag('ACS_IsSwordWalking'))
				{
					thePlayer.RaiseEvent('ACS_SwordWalkAdditiveEnd');thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');RemoveTimer('CombatTauntDelay');thePlayer.RaiseEvent('ACS_SwordTauntEnd');

					thePlayer.RemoveTag('ACS_IsSwordWalking');
				}
			}
		}

		if (thePlayer.IsWeaponHeld('steelsword'))
		{
			if ( ACS_GetItem_Sword_IsEquipped('olgierd_steel', 'steel') )
			{
				if (!GetWitcherPlayer().HasTag('ACS_Camo_Active')
				&& ACS_Settings_Main_Bool('acs_dodge_settings','acs_dodge_effects', false))
				{
					GetWitcherPlayer().PlayEffectSingle('special_attack_fx');
					GetWitcherPlayer().StopEffect('special_attack_fx');
				}
			}
		}
		else if (thePlayer.IsWeaponHeld('silversword'))
		{
			if ( ACS_GetItem_Sword_IsEquipped('olgierd_silver', 'silver') )
			{
				if (!GetWitcherPlayer().HasTag('ACS_Camo_Active')
				&& ACS_Settings_Main_Bool('acs_dodge_settings','acs_dodge_effects', false))
				{
					GetWitcherPlayer().PlayEffectSingle('special_attack_fx');
					GetWitcherPlayer().StopEffect('special_attack_fx');
				}
			}
		}

		RemoveTimer('Counter_Wound_Secondary');

		if (((CActor)slave).IsAlive()
		)
		{
			if ( ((CNewNPC)slave).GetBoneIndex('head') != -1 )
			{
				((CNewNPC)slave).GetBoneWorldPositionAndRotationByIndex( ((CNewNPC)slave).GetBoneIndex( 'head' ), bonePosition, boneRotation );
			}
			else
			{
				if ( ((CNewNPC)slave).GetBoneIndex('k_head_g') != -1 )
				{
					((CNewNPC)slave).GetBoneWorldPositionAndRotationByIndex( ((CNewNPC)slave).GetBoneIndex( 'k_head_g' ), bonePosition, boneRotation );
				}
				else
				{
					if ( ((CNewNPC)slave).GetBoneIndex('pelvis') != -1 )
					{
						((CNewNPC)slave).GetBoneWorldPositionAndRotationByIndex( ((CNewNPC)slave).GetBoneIndex( 'pelvis' ), bonePosition, boneRotation );
					}
					else
					{
						if ( ((CNewNPC)slave).GetBoneIndex('k_pelvis_g') != -1 )
						{
							((CNewNPC)slave).GetBoneWorldPositionAndRotationByIndex( ((CNewNPC)slave).GetBoneIndex( 'k_pelvis_g' ), bonePosition, boneRotation );
						}
						else
						{
							bonePosition = ((CNewNPC)slave).GetWorldPosition();
						}
					}
				}
			}

			thePlayer.GetBoneWorldPositionAndRotationByIndex( thePlayer.GetBoneIndex( 'head' ), pBonePosition, pBoneRotation );
			
			if (silver_fast_stance
			|| steel_fast_stance
			|| silver_group_stance
			|| steel_group_stance
			|| silver_strong_stance
			|| steel_strong_stance
			|| force_tw1_anim
			)
			{
				movementAdjustorFinisher = GetWitcherPlayer().GetMovingAgentComponent().GetMovementAdjustor();

				movementAdjustorFinisher.CancelAll();
				
				ticketFinisher = movementAdjustorFinisher.CreateNewRequest( 'ACS_Finisher_Rotate' );
					
				movementAdjustorFinisher.AdjustmentDuration( ticketFinisher, 0.25 );

				movementAdjustorFinisher.ShouldStartAt(ticketFinisher, GetWitcherPlayer().GetWorldPosition());
				movementAdjustorFinisher.MaxRotationAdjustmentSpeed( ticketFinisher, 5000000 );
				movementAdjustorFinisher.MaxLocationAdjustmentSpeed( ticketFinisher, 5000000 );

				movementAdjustorFinisher.RotateTowards( ticketFinisher, slave );

				dist = (((CMovingPhysicalAgentComponent)((CActor)slave).GetMovingAgentComponent()).GetCapsuleRadius() 
				+ ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent()).GetCapsuleRadius()) * 0.5;

				movementAdjustorFinisher.SlideTowards(ticketFinisher, slave, dist, dist);

				counter_wound_index = RandDifferent(previous_counter_wound_index , 5);

				if (((CActor)slave).HasBuff(EET_Knockdown)
				|| ((CActor)slave).HasBuff(EET_HeavyKnockdown)
				|| ((CActor)slave).HasBuff(EET_Stagger)
				|| ((CActor)slave).GetIsRecoveringFromKnockdown()
				|| bonePosition.Z < (pBonePosition.Z - 0.375))
				{
					switch (counter_wound_index) 
					{	
						case 4:

							AddTimer('ACS_Finisher_Unblock_Action', 4 , false);

							PlayerPlayAnimation('tw1_finisher_06_ACS', 0.1, 0.875);

						break;	

						case 3:

							AddTimer('ACS_Finisher_Unblock_Action', 3 , false);
							
							PlayerPlayAnimation('man_finisher_dlc_head_rp_counter_wound_ACS', 0.1, 0.1f);

							AddTimer('Counter_Wound_Secondary', 1.33  , false);

						break;	

						case 2:

							AddTimer('ACS_Finisher_Unblock_Action', 3 , false);

							PlayerPlayAnimation('man_finisher_01_rp_counter_wound_ACS', 0.1, 0.1f);

							AddTimer('Counter_Wound_Secondary', 1.33  , false);

						break;	

						case 1:

							AddTimer('ACS_Finisher_Unblock_Action', 3 , false);

							PlayerPlayAnimation('man_finisher_07_lp_counter_wound_ACS', 0.1, 0.1f);

							AddTimer('Counter_Wound_Secondary', 1.33  , false);

						break;	
								
						default:

							AddTimer('ACS_Finisher_Unblock_Action', 3 , false);

							PlayerPlayAnimation('man_finisher_02_lp_counter_wound_ACS', 0.1, 0.1f);

							AddTimer('Counter_Wound_Secondary', 1.33  , false);

						break;	
					}
				}
				else
				{
					switch (counter_wound_index) 
					{	
						case 4:

							AddTimer('ACS_Finisher_Unblock_Action', 6 , false);

							PlayerPlayAnimation('tw1_finisher_07_ACS', 0.1, 0.875);

							//ProcessFinisherCamera('man_finisher_04_lp',, true, true);

						break;	

						case 3:

							AddTimer('ACS_Finisher_Unblock_Action', 4 , false);

							PlayerPlayAnimation('tw1_finisher_06_ACS', 0.1, 0.875);

							//ProcessFinisherCamera('man_finisher_04_lp',, true, true);

						break;	

						case 2:

							AddTimer('ACS_Finisher_Unblock_Action', 4 , false);

							PlayerPlayAnimation('tw1_finisher_05_ACS', 0.1, 0.875);

							//ProcessFinisherCamera('man_finisher_04_lp',, true, true);

						break;	

						case 1:

							AddTimer('ACS_Finisher_Unblock_Action', 4 , false);

							PlayerPlayAnimation('tw1_finisher_04_ACS', 0.1, 0.875);

							//ProcessFinisherCamera('man_finisher_04_lp',, true, true);

						break;	
								
						default:

							AddTimer('ACS_Finisher_Unblock_Action', 2 , false);

							if (force_tw1_anim)
							{
								PlayerPlayAnimation('tw1_finisher_03_ACS', 0.1, 0.875);
							}
							else
							{
								PlayerPlayAnimation('tw1_finisher_02_ACS', 0.1, 0.875);
							}

							//ProcessFinisherCamera('man_finisher_04_lp',, true, true);

						break;	
					}
				}

				previous_counter_wound_index = counter_wound_index;
			}
			else
			{
				AddTimer('ACS_Finisher_Unblock_Action', 3 , false);

				counter_wound_index = RandDifferent(previous_counter_wound_index , 4);

				switch (counter_wound_index) 
				{	
					case 3:
				
						PlayerPlayAnimation('man_finisher_dlc_head_rp_counter_wound_ACS', 0.1, 0.1f);

						//ProcessFinisherCamera('man_finisher_05_rp',, true, true);

					break;	

					case 2:
					
						PlayerPlayAnimation('man_finisher_01_rp_counter_wound_ACS', 0.1, 0.1f);

						//ProcessFinisherCamera('man_finisher_03_rp',, true, true);

					break;	

					case 1:
					
						PlayerPlayAnimation('man_finisher_07_lp_counter_wound_ACS', 0.1, 0.1f);

						//ProcessFinisherCamera('man_finisher_06_lp',, true, true);

					break;	

					default:
					
						PlayerPlayAnimation('man_finisher_02_lp_counter_wound_ACS', 0.1, 0.1f);

						//ProcessFinisherCamera('man_finisher_04_lp',, true, true);

					break;	
				}

				previous_counter_wound_index = counter_wound_index;

				AddTimer('Counter_Wound_Secondary', 1.33  , false);
			}
		}
		else
		{
			AddTimer('ACS_Finisher_Unblock_Action', 1 , false);

			monster_finisher_index = RandDifferent(previous_monster_finisher_index , 6);

			switch (monster_finisher_index) 
			{	
				case 5:
				
					PlayerPlayAnimation('man_finisher_dlc_arm_lp_counter_wound_ACS', 0.1, 0.25);

					thePlayer.RaiseEvent('ACS_AimAssistDodgeForwardR');

					//ProcessFinisherCamera('man_finisher_dlc_arm_lp',, true, true);

				break;	

				case 4:
				
					PlayerPlayAnimation('man_finisher_dlc_arm_rp_counter_wound_ACS', 0.1, 0.25);

					thePlayer.RaiseEvent('ACS_AimAssistDodgeForwardR');

					//ProcessFinisherCamera('man_finisher_dlc_arm_rp',, true, true);

				break;	

				case 3:
				
					PlayerPlayAnimation('man_finisher_dlc_torso_lp_counter_wound_ACS', 0.1, 0.25);

					//ProcessFinisherCamera('man_finisher_dlc_torso_lp',, true, true);

				break;	
						
				case 2:

					PlayerPlayAnimation('man_finisher_dlc_torso_rp_counter_wound_ACS', 0.1, 0.25);

					//ProcessFinisherCamera('man_finisher_dlc_torso_rp',, true, true);

				break;	

				case 1:

					PlayerPlayAnimation('man_finisher_dlc_legs_rp_counter_wound_ACS', 0.1, 0.25);

					//ProcessFinisherCamera('man_finisher_dlc_legs_rp',, true, true);

				break;	

				case 0:

					PlayerPlayAnimation('man_finisher_dlc_legs_lp_counter_wound_ACS', 0.1, 0.25);

					//ProcessFinisherCamera('man_finisher_dlc_legs_lp',, true, true);

				break;	
					
				default:

					PlayerPlayAnimation('man_finisher_dlc_legs_lp_counter_wound_ACS', 0.1, 0.25);

					//ProcessFinisherCamera('man_finisher_dlc_legs_lp',, true, true);

				break;	
			}

			previous_monster_finisher_index = monster_finisher_index;
		}
	
		theInput.IgnoreGameInput( 'GI_AxisLeftX', true );
		theInput.IgnoreGameInput( 'GI_AxisLeftY', true );
		
		return true;
	}

	function Counter_Wound_Secdonary_Delay_Deal_Damage()
	{
		var vfxEnt											: CEntity;
		var tmpBool 										: bool;
		var mc 												: EMonsterCategory;
		var tmpName 										: name;
		var torsoBoneIndex									: int;
		var pos 											: Vector;
		var dmg												: W3DamageAction;
		var animatedComponentB 								: CAnimatedComponent;
		var sword_slash_ent, sword_slash_ent_sword			: CEntity;
		var sound_names										: array<string>;
		var attAction										: W3DamageAction;
		var movementAdjustorFinisher, movementAdjustorFinisherActor				: CMovementAdjustor;
		var ticketFinisher, ticketFinisherActor 								: SMovementAdjustmentRequestTicket;
		var dist											: float;

		movementAdjustorFinisher = GetWitcherPlayer().GetMovingAgentComponent().GetMovementAdjustor();

		movementAdjustorFinisher.CancelAll();
		
		ticketFinisher = movementAdjustorFinisher.CreateNewRequest( 'ACS_Finisher_Rotate' );
			
		movementAdjustorFinisher.AdjustmentDuration( ticketFinisher, 0.25 );

		movementAdjustorFinisher.ShouldStartAt(ticketFinisher, GetWitcherPlayer().GetWorldPosition());
		movementAdjustorFinisher.MaxRotationAdjustmentSpeed( ticketFinisher, 5000000 );
		movementAdjustorFinisher.MaxLocationAdjustmentSpeed( ticketFinisher, 5000000 );

		movementAdjustorFinisher.RotateTowards( ticketFinisher, counter_wound_target );

		if (silver_fast_stance
		|| steel_fast_stance
		|| silver_group_stance
		|| steel_group_stance
		|| silver_strong_stance
		|| steel_strong_stance
		)
		{
			dist = (((CMovingPhysicalAgentComponent)((CActor)counter_wound_target).GetMovingAgentComponent()).GetCapsuleRadius() 
			+ ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent()).GetCapsuleRadius());
		}
		else
		{
			if (thePlayer.IsDeadlySwordHeld())
			{
				dist = (((CMovingPhysicalAgentComponent)((CActor)counter_wound_target).GetMovingAgentComponent()).GetCapsuleRadius() 
				+ ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent()).GetCapsuleRadius()) * 0.5;
			}
			else
			{
				dist = (((CMovingPhysicalAgentComponent)((CActor)counter_wound_target).GetMovingAgentComponent()).GetCapsuleRadius() 
				+ ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent()).GetCapsuleRadius()) * 0.25;
			}
		}

		if (
		(((CMovingPhysicalAgentComponent)(counter_wound_target.GetMovingAgentComponent())).GetCapsuleHeight() >= 2
		|| counter_wound_target.GetRadius() >= 0.7
		|| counter_wound_target.HasAbility('Boss')
		|| counter_wound_target.HasTag('IsBoss')
		|| counter_wound_target.HasTag('ACS_Big_Boi'))
		&& !counter_wound_target.HasTag('ice_troll')
		&& counter_wound_target.GetSfxTag() != 'sfx_troll_cave')
		{
			dist = (((CMovingPhysicalAgentComponent)((CActor)counter_wound_target).GetMovingAgentComponent()).GetCapsuleRadius() 
			+ ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent()).GetCapsuleRadius()) * 0.825;
		}

		movementAdjustorFinisher.SlideTowards(ticketFinisher, counter_wound_target, dist, dist);

		animatedComponentB = (CAnimatedComponent)thePlayer.GetComponentByClassName( 'CAnimatedComponent' );

		animatedComponentB.UnfreezePose();
		
		animatedComponentB.FreezePoseFadeIn(0.1f);

		thePlayer.AddTag('ACS_Player_Hit_Lag');

		thePlayer.RemoveTimer('ACS_PlayerUnfreezePose');

		thePlayer.AddTimer('ACS_PlayerUnfreezePose', 0.1f , false);

		if (ACS_Settings_Main_Bool('acs_visual_main_settings','acs_directional_slash_effects_enabled', true)
		)
		{
			sword_slash_ent_sword = theGame.CreateEntity( (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\fx\sword_slash_circular\acs_sword_slash_circular.w2ent", true ), counter_wound_target.GetWorldPosition() + Vector(0,0,1.5), thePlayer.GetWorldRotation());

			if (RandF() < 0.5 )
			{
				sword_slash_ent_sword.AddTag('ACS_Sword_Slash_Circular_Finisher_Switch_Left');
			}
			else
			{
				sword_slash_ent_sword.AddTag('ACS_Sword_Slash_Circular_Finisher_Switch_Right');
			}
		}

		torsoBoneIndex = ((CActor)counter_wound_target).GetTorsoBoneIndex();

		if ( torsoBoneIndex != -1 )
		{
			pos = MatrixGetTranslation( ((CActor)counter_wound_target).GetBoneWorldMatrixByIndex( torsoBoneIndex ) );
		}
		else
		{
			pos = counter_wound_target.GetWorldPosition();
		}

		vfxEnt = theGame.CreateEntity( (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\fx\blood_fx.w2ent", true ), pos );
		vfxEnt.DestroyAfter(1.5);

		theGame.GetMonsterParamsForActor(counter_wound_target, mc, tmpName, tmpBool, tmpBool, tmpBool);

		if( counter_wound_target.GetBloodType() == BT_Red) 
		{
			if (counter_wound_target.HasAbility('mon_lessog_base')
			||counter_wound_target. HasAbility('mon_sprigan_base')
			)
			{	
				weapon_blood_fx('black');

				vfxEnt.PlayEffectSingle('blood_explode_black');

				vfxEnt.PlayEffectSingle('blood_spatter_black');
			} 
			else 
			{
				weapon_blood_fx('red');

				vfxEnt.PlayEffectSingle('blood_explode_red');

				vfxEnt.PlayEffectSingle('blood_spatter_red');
			}
		}
		else if( counter_wound_target.GetBloodType() == BT_Green) 
		{
			if (counter_wound_target.HasAbility('mon_kikimore_base')
			|| counter_wound_target.HasAbility('mon_black_spider_base')
			|| counter_wound_target.HasAbility('mon_black_spider_ep2_base')
			|| counter_wound_target.HasTag('ACS_Ungoliant')
			)
			{				
				weapon_blood_fx('black');

				vfxEnt.PlayEffectSingle('blood_explode_black');

				vfxEnt.PlayEffectSingle('blood_spatter_black');
			} 
			else 
			{
				weapon_blood_fx('green');

				vfxEnt.PlayEffectSingle('blood_explode_green');

				vfxEnt.PlayEffectSingle('blood_spatter_green');
			}
		}
		else if( counter_wound_target.GetBloodType() == BT_Yellow) 
		{
			if (counter_wound_target.HasAbility('mon_archespor_base'))
			{
				weapon_blood_fx('yellow');

				vfxEnt.PlayEffectSingle('blood_explode_yellow');

				vfxEnt.PlayEffectSingle('blood_spatter_yellow');
			} 
			else 
			{
				weapon_blood_fx('red');

				vfxEnt.PlayEffectSingle('blood_explode_red');

				vfxEnt.PlayEffectSingle('blood_spatter_red');
			}
		}
		else if	( counter_wound_target.GetBloodType() == BT_Black) 
		{
			if ( mc == MC_Vampire ) 
			{
				weapon_blood_fx('red');

				vfxEnt.PlayEffectSingle('blood_explode_red');

				vfxEnt.PlayEffectSingle('blood_spatter_red');
			}
			else if ( mc == MC_Magicals ) 
			{
				if (counter_wound_target.HasAbility('mon_golem_base')
				|| counter_wound_target.HasAbility('mon_djinn')
				|| counter_wound_target.HasAbility('mon_gargoyle')
				)
				{
					weapon_blood_fx('black');

					vfxEnt.PlayEffectSingle('blood_explode_black');

					vfxEnt.PlayEffectSingle('blood_spatter_black');
				}
				else
				{
					weapon_blood_fx('red');

					vfxEnt.PlayEffectSingle('blood_explode_red');

					vfxEnt.PlayEffectSingle('blood_spatter_red');
				}
			}
			else
			{
				weapon_blood_fx('black');

				vfxEnt.PlayEffectSingle('blood_explode_black');

				vfxEnt.PlayEffectSingle('blood_spatter_black');
			}
		}

		if (counter_wound_target.IsAlive())
		{
			((CAnimatedComponent)thePlayer.GetComponentByClassName( 'CAnimatedComponent' )).UnfreezePose();

			((CAnimatedComponent)thePlayer.GetComponentByClassName( 'CAnimatedComponent' )).FreezePoseFadeIn(0.5);

			thePlayer.AddTag('ACS_Player_Hit_Lag');

			thePlayer.RemoveTimer('ACS_PlayerUnfreezePose');

			thePlayer.AddTimer('ACS_PlayerUnfreezePose', 0.25f, false );

			attAction = new W3DamageAction in theGame.damageMgr;

			attAction.Initialize(thePlayer, counter_wound_target, NULL, thePlayer.GetName(), EHRT_Heavy, CPS_Undefined, false, false, true, false);

			attAction.SetHitReactionType(EHRT_Heavy, true);

			attAction.SetHitAnimationPlayType(EAHA_ForceYes);

			if (thePlayer.IsDeadlySwordHeld())
			{
				attAction.SetForceExplosionDismemberment();
			}

			attAction.SetCriticalHit();

			if ( ((CNewNPC)counter_wound_target).acs_backstab_wound_fx
			&& ((CNewNPC)counter_wound_target).acs_backstab_wound_fx.HasTag('ACS_Counter_Wound_Disable')
			&& thePlayer.HasTag('ACS_Is_Sneaking')
			&& ACS_IS_SNEAKING
			)
			{
				if (((CMovingPhysicalAgentComponent)(counter_wound_target.GetMovingAgentComponent())).GetCapsuleHeight() >= 2
				|| counter_wound_target.GetRadius() >= 0.7
				|| counter_wound_target.HasAbility('Boss')
				|| counter_wound_target.HasTag('IsBoss')
				|| counter_wound_target.HasTag('ACS_Big_Boi')
				|| sneaking_initiated_in_combat
				)
				{
					if (thePlayer.IsDeadlySwordHeld())
					{
						if (counter_wound_target.UsesEssence()
						)
						{
							attAction.AddDamage( theGame.params.DAMAGE_NAME_SILVER, counter_wound_target.GetMaxHealth() * 0.375 );
						}
						else if (counter_wound_target.UsesVitality()
						)
						{
							attAction.AddDamage( theGame.params.DAMAGE_NAME_PHYSICAL, counter_wound_target.GetMaxHealth() * 0.375 );
						}
					}
					else
					{
						if (counter_wound_target.UsesEssence()
						)
						{
							attAction.AddDamage( theGame.params.DAMAGE_NAME_SILVER, counter_wound_target.GetMaxHealth() * 0.1875 );
						}
						else if (counter_wound_target.UsesVitality()
						)
						{
							attAction.AddDamage( theGame.params.DAMAGE_NAME_PHYSICAL, counter_wound_target.GetMaxHealth() * 0.1875 );
						}
					}
				}
				else
				{
					if (counter_wound_target.UsesEssence()
					)
					{
						attAction.AddDamage( theGame.params.DAMAGE_NAME_SILVER, counter_wound_target.GetMaxHealth() * 0.75 );
					}
					else if (counter_wound_target.UsesVitality()
					)
					{
						attAction.AddDamage( theGame.params.DAMAGE_NAME_PHYSICAL, counter_wound_target.GetMaxHealth() * 0.75 );
					}
				}
			}
			else
			{
				if (counter_wound_target.GetCurrentHealth() > counter_wound_target.GetMaxHealth() * 0.5)
				{
					if (counter_wound_target.UsesEssence()
					)
					{
						attAction.AddDamage( theGame.params.DAMAGE_NAME_SILVER, counter_wound_target.GetMaxHealth() * 0.25 );
					}
					else if (counter_wound_target.UsesVitality()
					)
					{
						attAction.AddDamage( theGame.params.DAMAGE_NAME_PHYSICAL, counter_wound_target.GetMaxHealth() * 0.25 );
					}
				}
				else if (counter_wound_target.GetCurrentHealth() <= counter_wound_target.GetMaxHealth() * 0.5)
				{
					if (counter_wound_target.UsesEssence()
					)
					{
						attAction.AddDamage( theGame.params.DAMAGE_NAME_SILVER, (counter_wound_target.GetMaxHealth() - counter_wound_target.GetCurrentHealth()) * 0.25 );
					}
					else if (counter_wound_target.UsesVitality()
					)
					{
						attAction.AddDamage( theGame.params.DAMAGE_NAME_PHYSICAL, (counter_wound_target.GetMaxHealth() - counter_wound_target.GetCurrentHealth()) * 0.25 );
					}
				}
			}

			if ( thePlayer.CanUseSkill(S_Sword_s11) )
			{
				if (counter_wound_target.UsesEssence()
				)
				{
					attAction.AddDamage( theGame.params.DAMAGE_NAME_SILVER, counter_wound_target.GetMaxHealth() * (thePlayer.GetSkillLevel(S_Sword_s11) * 0.025) );
				}
				else if (counter_wound_target.UsesVitality()
				)
				{
					attAction.AddDamage( theGame.params.DAMAGE_NAME_PHYSICAL, counter_wound_target.GetMaxHealth() * (thePlayer.GetSkillLevel(S_Sword_s11) * 0.025) );
				}
			}

			theGame.damageMgr.ProcessAction( attAction );	
			
			delete attAction;
		}

		if(RandF() < 0.5)
		{
			GetWitcherPlayer().SoundEvent("monster_dettlaff_monster_combat_geralt_deathblow_01");
		}
		else
		{
			GetWitcherPlayer().SoundEvent("monster_dettlaff_monster_combat_geralt_deathblow_02");
		}

		sound_names.Clear();
		sound_names.PushBack("extreme_hit_01_bb_acs");
		sound_names.PushBack("extreme_hit_02_bb_acs");
		sound_names.PushBack("extreme_hit_03_bb_acs");

		counter_wound_target.SoundEvent(sound_names[RandRange(sound_names.Size())]);

		counter_wound_target.SoundEvent("proc_slash_wf_acs");

		counter_wound_target.SoundEvent("cmb_play_hit_heavy");

		GetWitcherPlayer().SoundEvent("cmb_play_dismemberment_gore");

		GetWitcherPlayer().SoundEvent("monster_dettlaff_monster_vein_hit_blood");

		if (ACS_Settings_Main_Bool('acs_visual_main_settings','acs_directional_slash_effects_enabled', true)
		&& !ACS_IS_SNEAKING
		&& !thePlayer.HasTag('ACS_Is_Sneaking')
		)
		{
			sword_slash_ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\fx\acs_sword_slashes.w2ent", true ), counter_wound_target.GetWorldPosition() + Vector( 0, 0, RandRangeF(1.5,1.25) ), EulerAngles(RandRangeF(360,0),RandRangeF(360,0),RandRangeF(360,0)));

			if (((CMovingPhysicalAgentComponent)(counter_wound_target.GetMovingAgentComponent())).GetCapsuleHeight() >= 2
			|| counter_wound_target.GetRadius() >= 0.7
			|| counter_wound_target.HasAbility('Boss')
			|| counter_wound_target.HasTag('IsBoss')
			|| counter_wound_target.HasTag('ACS_Big_Boi')
			)
			{
				sword_slash_ent.PlayEffectSingle('sword_slash_finisher_large');
			}
			else
			{
				sword_slash_ent.PlayEffectSingle('sword_slash_finisher');
			}

			sword_slash_ent.PlayEffectSingle('sword_slash_finisher_secondary');
			
			sword_slash_ent.DestroyAfter(0.5);
		}

		ACS_SlowMoAdjustable(0.3, 0.1);
	}

	timer function Counter_Wound_Secondary(deltaTime : float , id : int)
	{
		var sound_names								: array<string>;
		var dist 									: float;
		var tmpName 								: name;
		var tmpBool 								: bool;
		var mc 										: EMonsterCategory;
		var sword_slash_ent							: CEntity;
		var movementAdjustorFinisher, movementAdjustorFinisherActor				: CMovementAdjustor;
		var ticketFinisher, ticketFinisherActor 								: SMovementAdjustmentRequestTicket;

		if (ACS_IS_SNEAKING
		|| thePlayer.HasTag('ACS_Is_Sneaking'))
		{
			Counter_Wound_Secdonary_Delay_Deal_Damage();
			return;
		}

		movementAdjustorFinisher = GetWitcherPlayer().GetMovingAgentComponent().GetMovementAdjustor();

		movementAdjustorFinisher.CancelAll();
		
		ticketFinisher = movementAdjustorFinisher.CreateNewRequest( 'ACS_Finisher_Rotate' );
			
		movementAdjustorFinisher.AdjustmentDuration( ticketFinisher, 0.25 );

		movementAdjustorFinisher.ShouldStartAt(ticketFinisher, GetWitcherPlayer().GetWorldPosition());
		movementAdjustorFinisher.MaxRotationAdjustmentSpeed( ticketFinisher, 5000000 );
		movementAdjustorFinisher.MaxLocationAdjustmentSpeed( ticketFinisher, 5000000 );

		movementAdjustorFinisher.RotateTowards( ticketFinisher, counter_wound_target );

		if (silver_fast_stance
		|| steel_fast_stance
		|| silver_group_stance
		|| steel_group_stance
		|| silver_strong_stance
		|| steel_strong_stance
		)
		{
			dist = (((CMovingPhysicalAgentComponent)((CActor)counter_wound_target).GetMovingAgentComponent()).GetCapsuleRadius() 
			+ ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent()).GetCapsuleRadius());
		}
		else
		{
			if (thePlayer.IsDeadlySwordHeld())
			{
				dist = (((CMovingPhysicalAgentComponent)((CActor)counter_wound_target).GetMovingAgentComponent()).GetCapsuleRadius() 
				+ ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent()).GetCapsuleRadius()) * 0.5;
			}
			else
			{
				dist = (((CMovingPhysicalAgentComponent)((CActor)counter_wound_target).GetMovingAgentComponent()).GetCapsuleRadius() 
				+ ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent()).GetCapsuleRadius()) * 0.25;
			}
		}

		if (
		(((CMovingPhysicalAgentComponent)(counter_wound_target.GetMovingAgentComponent())).GetCapsuleHeight() >= 2
		|| counter_wound_target.GetRadius() >= 0.7
		|| counter_wound_target.HasAbility('Boss')
		|| counter_wound_target.HasTag('IsBoss')
		|| counter_wound_target.HasTag('ACS_Big_Boi'))
		&& !counter_wound_target.HasTag('ice_troll')
		&& counter_wound_target.GetSfxTag() != 'sfx_troll_cave')
		{
			dist = (((CMovingPhysicalAgentComponent)((CActor)counter_wound_target).GetMovingAgentComponent()).GetCapsuleRadius() 
				+ ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent()).GetCapsuleRadius()) * 0.825;
		}

		movementAdjustorFinisher.SlideTowards(ticketFinisher, counter_wound_target, dist, dist);

		ACS_SlowMoAdjustable(0.3, 0.1);

		theGame.GetMonsterParamsForActor(counter_wound_target, mc, tmpName, tmpBool, tmpBool, tmpBool);

		if( counter_wound_target.GetBloodType() == BT_Red) 
		{
			
			if (counter_wound_target.HasAbility('mon_lessog_base')
			|| counter_wound_target.HasAbility('mon_sprigan_base')
			)
			{		
				weapon_blood_fx('black');
			} 
			else 
			{
				weapon_blood_fx('red');
			}
		}
		else if( counter_wound_target.GetBloodType() == BT_Green) 
		{
			if (counter_wound_target.HasAbility('mon_kikimore_base')
			|| counter_wound_target.HasAbility('mon_black_spider_base')
			|| counter_wound_target.HasAbility('mon_black_spider_ep2_base')
			|| counter_wound_target.HasTag('ACS_Ungoliant')
			)
			{						
				weapon_blood_fx('black');
			} 
			else 
			{
				weapon_blood_fx('green');
			}
		}
		else if( counter_wound_target.GetBloodType() == BT_Yellow) 
		{
			if (counter_wound_target.HasAbility('mon_archespor_base'))
			{
				weapon_blood_fx('yellow');
			} 
			else 
			{
				weapon_blood_fx('red');
			}
		}
		else if	( counter_wound_target.GetBloodType() == BT_Black) 
		{
			if ( mc == MC_Vampire ) 
			{
				weapon_blood_fx('red');
			}
			else if ( mc == MC_Magicals ) 
			{
				if (counter_wound_target.HasAbility('mon_golem_base')
				|| counter_wound_target.HasAbility('mon_djinn')
				|| counter_wound_target.HasAbility('mon_gargoyle')
				)
				{
					weapon_blood_fx('black');
				}
				else
				{
					weapon_blood_fx('red');
				}
			}
			else
			{
				weapon_blood_fx('black');
			}
		}
		else
		{
			weapon_blood_fx('red');
		}
		

		movementAdjustorFinisher = GetWitcherPlayer().GetMovingAgentComponent().GetMovementAdjustor();

		movementAdjustorFinisher.CancelAll();
		
		ticketFinisher = movementAdjustorFinisher.CreateNewRequest( 'ACS_Finisher_Rotate' );
			
		movementAdjustorFinisher.AdjustmentDuration( ticketFinisher, 0.25 );

		movementAdjustorFinisher.ShouldStartAt(ticketFinisher, GetWitcherPlayer().GetWorldPosition());
		movementAdjustorFinisher.MaxRotationAdjustmentSpeed( ticketFinisher, 5000000 );
		movementAdjustorFinisher.MaxLocationAdjustmentSpeed( ticketFinisher, 5000000 );

		movementAdjustorFinisher.RotateTowards( ticketFinisher, counter_wound_target );

		dist = (((CMovingPhysicalAgentComponent)counter_wound_target.GetMovingAgentComponent()).GetCapsuleRadius() 
		+ ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent()).GetCapsuleRadius());

		movementAdjustorFinisher.SlideTowards(ticketFinisher, counter_wound_target, dist, dist);

		GetWitcherPlayer().SoundEvent("cmb_play_ger_stab_out");

		GetWitcherPlayer().SoundEvent("large_weapon_pullout_bb_acs");

		GetWitcherPlayer().SoundEvent("cmb_play_dismemberment_gore");

		GetWitcherPlayer().SoundEvent("monster_dettlaff_monster_vein_hit_blood");

		monster_finisher_index = RandDifferent(previous_monster_finisher_index , 6);

		switch (monster_finisher_index) 
		{	
			case 5:
				
				PlayerPlayAnimation('man_finisher_dlc_arm_lp_counter_wound_ACS', 0.1, 1);

				thePlayer.RaiseEvent('ACS_AimAssistDodgeForwardR');

			break;	
					
			case 4:

				PlayerPlayAnimation('man_finisher_dlc_arm_rp_counter_wound_ACS', 0.1, 1);

				thePlayer.RaiseEvent('ACS_AimAssistDodgeForwardR');

			break;	

			case 3:
			
				PlayerPlayAnimation('man_finisher_dlc_torso_lp_counter_wound_ACS', 0.1, 1);

			break;	
					
			case 2:

				PlayerPlayAnimation('man_finisher_dlc_torso_rp_counter_wound_ACS', 0.1, 1);

			break;	

			case 1:

				PlayerPlayAnimation('man_finisher_dlc_legs_rp_counter_wound_ACS', 0.1, 1);

			break;	
				
			default:

				PlayerPlayAnimation('man_finisher_dlc_legs_lp_counter_wound_ACS', 0.1, 1);
				
			break;	
		}

		previous_monster_finisher_index = monster_finisher_index;
	}

	////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	public function ACS_PhantomSetupSyncAnimInternalHuman( syncAction : name, master, slave : CEntity ) : bool
	{
		var masterDef, slaveDef													: SAnimationSequenceDefinition;
		var masterSequencePart, slaveSequencePart								: SAnimationSequencePartDefinition;
		var syncInstance														: CAnimationManualSlotSyncInstance;
		
		var instanceIndex														: int;
		var sequenceIndex														: int;
		
		var temp 																: name; 
		var tempF 																: float;
		var rot 																: EulerAngles;
		
		var finisherAnim 														: bool;
		var pos 																: Vector;
		
		var syncAnimName, cameraAnimName										: name;
		
		var node, node1 														: CNode; 
		var rot0, rot1, slaveRot 												: EulerAngles;
		
		var masterAnim, slaveAnim 												: name;
		var syncAnimIndex														: int;
		var currentAnimInstance													: CAnimationManualSlotSyncInstance;
		var actorMaster, actorSlave 											: CActor;

		var fear_actors															: array<CActor>;
		var j, k 																: int;
		var fear_actor															: CActor;
		var animatedComponentFearActor											: CAnimatedComponent;
		var movementAdjustorFinisher, movementAdjustorFinisherActor				: CMovementAdjustor;
		var ticketFinisher, ticketFinisherActor 								: SMovementAdjustmentRequestTicket;
		var dist																: float;
	
		syncInstance = theGame.GetSyncAnimManager().CreateNewSyncInstance( instanceIndex );
		syncAnimIndex = instanceIndex;
		currentAnimInstance = syncInstance;

		dist = (((CMovingPhysicalAgentComponent)((CActor)slave).GetMovingAgentComponent()).GetCapsuleRadius() 
		+ ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent()).GetCapsuleRadius());

		movementAdjustorFinisher = ((CMovingPhysicalAgentComponent)((CActor)master).GetMovingAgentComponent()).GetMovementAdjustor();

		movementAdjustorFinisher.CancelAll();
		
		ticketFinisher = movementAdjustorFinisher.CreateNewRequest( 'ACS_Phatom_Finisher_Rotate' );
			
		movementAdjustorFinisher.AdjustmentDuration( ticketFinisher, 0.5 );

		movementAdjustorFinisher.ShouldStartAt(ticketFinisher, master.GetWorldPosition());
		movementAdjustorFinisher.MaxRotationAdjustmentSpeed( ticketFinisher, 5000000 );
		movementAdjustorFinisher.MaxLocationAdjustmentSpeed( ticketFinisher, 5000000 );
		//movementAdjustorFinisher.Continuous(ticketFinisher);
		
		//movementAdjustorFinisher.SlideTowards( ticketFinisher, slave, dist, dist );
		movementAdjustorFinisher.RotateTowards( ticketFinisher, slave );


		movementAdjustorFinisherActor = ((CActor)slave).GetMovingAgentComponent().GetMovementAdjustor();

		movementAdjustorFinisherActor.CancelAll();
		
		ticketFinisherActor = movementAdjustorFinisherActor.CreateNewRequest( 'ACS_Phantom_Finisher_Rotate' );
			
		movementAdjustorFinisherActor.AdjustmentDuration( ticketFinisherActor, 0.0125 );

		movementAdjustorFinisherActor.ShouldStartAt(ticketFinisherActor, slave.GetWorldPosition());
		movementAdjustorFinisherActor.MaxRotationAdjustmentSpeed( ticketFinisherActor, 5000000 );
		movementAdjustorFinisherActor.MaxLocationAdjustmentSpeed( ticketFinisherActor, 5000000 );

		//movementAdjustorFinisherActor.SlideTowards( ticketFinisherActor, GetWitcherPlayer(), dist, dist );
		movementAdjustorFinisherActor.RotateTowards( ticketFinisherActor, master );
		
		if (((CActor)slave).IsAlive())
		{
			((CActor)slave).Kill( 'ACS_Phantom_Finisher', false, thePlayer );
		}

		if ( slave.HasTag('ACS_Wraith_Finisher_Marked')
		)
		{
			slave.RemoveTag('ACS_Wraith_Finisher_Marked');
		}

		slave.DestroyAfter(10);

		slave.CreateAttachment(master);
		slave.BreakAttachment();

		switch( syncAction )
		{
			case 'man_finisher_dlc_legs_rp':
			{
				masterSequencePart.animation			= 'man_finisher_dlc_legs_rp_attacker_ACS';
				masterSequencePart.syncType				= AMST_SyncBeginning;
				masterSequencePart.useRefBone			= 'Reference';
				masterSequencePart.rotationTypeUsingRefBone = SRT_TowardsOtherEntity;
				masterSequencePart.shouldSlide			= true;
				masterSequencePart.shouldRotate			= true;
				
				masterSequencePart.blendInTime			= 0.25f;
				masterSequencePart.blendOutTime			= 0.25f;

				slave.AddTag('ACS_man_finisher_dlc_legs_rp');
				slaveSequencePart.animation				= 'man_finisher_dlc_legs_rp';
				slaveSequencePart.syncType				= AMST_SyncBeginning;

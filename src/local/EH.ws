	function RedBladeProjectileSingle()
	{
		if (ACS_Armor_Set_Check('acs_armor', false))
		{
			RemoveTimer('ACS_RedBladeProjectile_1');
			RemoveTimer('ACS_RedBladeProjectile_2');
			RemoveTimer('ACS_RedBladeProjectile_3');
			AddTimer('ACS_RedBladeProjectile_1', 0.75 , false);
		}
	}

	function RedBladeProjectileTriple()
	{
		if (ACS_Armor_Set_Check('acs_armor', false))
		{
			RemoveTimer('ACS_RedBladeProjectile_1');
			RemoveTimer('ACS_RedBladeProjectile_2');
			RemoveTimer('ACS_RedBladeProjectile_3');
			AddTimer('ACS_RedBladeProjectile_1', 0.75 , false);
			AddTimer('ACS_RedBladeProjectile_2', 0.875 , false);
			AddTimer('ACS_RedBladeProjectile_3', 1 , false);
		}
	}

	function Hair_Thing()
	{
		var inv : CInventoryComponent;
		var witcher : W3PlayerWitcher;
		var ids : array<SItemUniqueId>;
		var size : int;
		var i : int;

		if (helmtoggle
		|| hoodtoggle
		)
		{
			witcher = GetWitcherPlayer();
			inv = witcher.GetInventory();

			ids.Clear();

			ids = inv.GetItemsByCategory( 'hair' );

			size = ids.Size();

			if( size <= 0 )
			{
				return;
			}
				
			if( size > 0 )
			{					
				for( i = 0; i < size; i+=1 )
				{
					if(inv.IsItemMounted( ids[i] ) )
					{
						inv.DespawnItem(ids[i]);
					}
				}				
			}		
		}
	}

	function AllBlackControl()
	{
		if (ACS_GetItem_Sword_IsEquipped('all_black', 'steel'))
		{
			if (GetWitcherPlayer().IsAnyItemEquippedOnSlot(EES_SilverSword))
			{
				GetWitcherPlayer().UnequipItemFromSlot(EES_SilverSword);
			}

			if (ACS_GetItem_Sword_IsEquipped('all_black_held', 'steel'))
			{
				if (thePlayer.GetCurrentHealth() > thePlayer.GetMaxHealth() * 0.5)
				{
					thePlayer.DrainVitality( thePlayer.GetStat( BCS_Vitality ) * 0.0125 );
				}

				if (!thePlayer.HasTag('ACS_Player_Has_Summoned_Constructs')
				)
				{
					vACS_Construct_Summon = new cACS_Construct_Summon in this;
				
					vACS_Construct_Summon.Construct_Summon_Engage();

					RemoveTimer('ACS_AllBlackHealthRevert');
					RemoveTimer('ACS_AllBlackHealthRevertRemove');

					ACS_Quen();

					thePlayer.AddTag('ACS_Player_Has_Summoned_Constructs');
				}
			}
			else
			{
				if (thePlayer.HasTag('ACS_Player_Has_Summoned_Constructs'))
				{
					RemoveTimer('ACS_AllBlackHealthRevert');
					AddTimer('ACS_AllBlackHealthRevert', 0.00001 , true);
					AddTimer('ACS_AllBlackHealthRevertRemove', 1 , false);
					Summoned_Construct_Destroy();

					thePlayer.RemoveTag('ACS_Player_Has_Summoned_Constructs');
				}
			}
		}
		else
		{
			if (thePlayer.HasTag('ACS_Player_Has_Summoned_Constructs'))
			{
				RemoveTimer('ACS_AllBlackHealthRevert');
				AddTimer('ACS_AllBlackHealthRevert', 0.00001 , true);
				AddTimer('ACS_AllBlackHealthRevertRemove', 1 , false);
				Summoned_Construct_Destroy();

				thePlayer.RemoveTag('ACS_Player_Has_Summoned_Constructs');
			}
		}
	}

	var vACS_Construct_Summon : cACS_Construct_Summon;

	timer function ACS_AllBlackHealthRevertRemove( time : float , id : int )
	{
		RemoveTimer('ACS_AllBlackHealthRevert');
	}

	timer function ACS_AllBlackHealthRevert( time : float , id : int )
	{
		if (thePlayer.GetCurrentHealth() == thePlayer.GetMaxHealth())
		{
			RemoveTimer('ACS_AllBlackHealthRevert');
		}
		else if (thePlayer.GetCurrentHealth() < thePlayer.GetMaxHealth())
		{
			thePlayer.GainStat( BCS_Vitality, thePlayer.GetStat( BCS_Vitality ) * 0.0125 );

			ShowHealFloatingValue(thePlayer.GetStat( BCS_Vitality ) * 0.0125, true);
		}
	}

	function Summoned_Construct_Destroy()
	{
		var animatedComponentA												: CAnimatedComponent;

		if (!ACSGetCActor('ACS_Summoned_Construct_1').HasTag('ACS_Summoned_Construct_Destroy_Start'))
		{
			//ACSGetCActor('ACS_Summoned_Construct_1').PlayEffectSingle('avatar_death_swollen_no_decal');
			//ACSGetCActor('ACS_Summoned_Construct_1').StopEffect('avatar_death_swollen_no_decal');

			//ACSGetCActor('ACS_Summoned_Construct_1').PlayEffectSingle('shadowdash');
			//ACSGetCActor('ACS_Summoned_Construct_1').StopEffect('shadowdash');

			ACSGetCActor('ACS_Summoned_Construct_1').DestroyAfter(1.5);

			animatedComponentA = (CAnimatedComponent)(ACSGetCActor('ACS_Summoned_Construct_1')).GetComponentByClassName( 'CAnimatedComponent' );	

			animatedComponentA.PlaySlotAnimationAsync ( 'dettlaff_construct_death', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.5f, 0.5f));

			ACSGetCActor('ACS_Summoned_Construct_1').AddTag('ACS_Summoned_Construct_Destroy_Start');
		}

		if (!ACSGetCActor('ACS_Summoned_Construct_2').HasTag('ACS_Summoned_Construct_Destroy_Start'))
		{
			//ACSGetCActor('ACS_Summoned_Construct_2').PlayEffectSingle('avatar_death_swollen_no_decal');
			//ACSGetCActor('ACS_Summoned_Construct_2').StopEffect('avatar_death_swollen_no_decal');

			//ACSGetCActor('ACS_Summoned_Construct_2').PlayEffectSingle('shadowdash');
			//ACSGetCActor('ACS_Summoned_Construct_2').StopEffect('shadowdash');

			ACSGetCActor('ACS_Summoned_Construct_2').DestroyAfter(1.5);

			animatedComponentA = (CAnimatedComponent)(ACSGetCActor('ACS_Summoned_Construct_2')).GetComponentByClassName( 'CAnimatedComponent' );	

			animatedComponentA.PlaySlotAnimationAsync ( 'dettlaff_construct_death', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.5f, 0.5f));

			ACSGetCActor('ACS_Summoned_Construct_2').AddTag('ACS_Summoned_Construct_Destroy_Start');
		}
	}

	var vACS_EtherSword_Summon : cACS_EtherSword_Summon;

	function ACS_Ether_Sword_Control()
	{
		if (ACS_Armor_Set_Check('acs_armor', false)
		&& FactsQuerySum("acs_transformation_activated") <= 0
		&& FactsQuerySum("ACS_Azkar_Active") <= 0
		&& FactsQuerySum("ACS_Slayer_Active") <= 0
		)
		{
			if (thePlayer.IsDeadlySwordHeld())
			{
				if (!ACSGetCEntity('ACS_Armor_Ether_Sword') 
				&& (thePlayer.HasTag('acs_igni_secondary_sword_equipped')
				|| thePlayer.HasTag('acs_igni_secondary_sword_equipped_TAG')
				|| thePlayer.HasTag('acs_igni_sword_equipped')
				|| thePlayer.HasTag('acs_igni_sword_equipped_TAG'))
				&& !thePlayer.HasTag('acs_quen_sword_equipped')
				&& !thePlayer.HasTag('acs_axii_sword_equipped')
				&& !thePlayer.HasTag('acs_aard_sword_equipped')
				&& !thePlayer.HasTag('acs_yrden_sword_equipped')
				&& !thePlayer.HasTag('acs_quen_secondary_sword_equipped')
				&& !thePlayer.HasTag('acs_axii_secondary_sword_equipped')
				&& !thePlayer.HasTag('acs_aard_secondary_sword_equipped')
				&& !thePlayer.HasTag('acs_yrden_secondary_sword_equipped')
				&& !thePlayer.HasTag('ACS_HideWeaponOnDodge')
				&& !thePlayer.HasTag('ACS_HideWeaponOnDodge_Claw_Effect')
				&& !ACS_GetItem_Sword_IsEquipped('all_black_held', 'steel')
				)
				{
					vACS_EtherSword_Summon = new cACS_EtherSword_Summon in this;

					vACS_EtherSword_Summon.EtherSword_Spawner_Engage();
				}
			}
			else
			{
				if (ACSGetCEntity('ACS_Armor_Ether_Sword'))
				{
					ACSGetCEntity('ACS_Armor_Ether_Sword').Destroy();
				}
			}

			if (ACSGetCEntity('ACS_Armor_Ether_Sword'))
			{
				if (thePlayer.GetStat(BCS_Focus) >= thePlayer.GetStatMax( BCS_Focus ) * 0.33
				|| thePlayer.IsDoingSpecialAttack(true)
				|| thePlayer.IsDoingSpecialAttack(false)
				)
				{
					if (!ACSGetCEntity('ACS_Armor_Ether_Sword').IsEffectActive('red_runeword_igni_2', false))
					{
						ACSGetCEntity('ACS_Armor_Ether_Sword').PlayEffectSingle('red_runeword_igni_2');
					}

					if (!ACSGetCEntity('ACS_Armor_Ether_Sword').IsEffectActive('red_runeword_igni_1', false))
					{
						ACSGetCEntity('ACS_Armor_Ether_Sword').PlayEffectSingle('red_runeword_igni_1');
					}
				}
				else
				{
					if (ACSGetCEntity('ACS_Armor_Ether_Sword').IsEffectActive('red_runeword_igni_2', false))
					{
						ACSGetCEntity('ACS_Armor_Ether_Sword').StopEffect('red_runeword_igni_2');
					}

					if (ACSGetCEntity('ACS_Armor_Ether_Sword').IsEffectActive('red_runeword_igni_1', false))
					{
						ACSGetCEntity('ACS_Armor_Ether_Sword').StopEffect('red_runeword_igni_1');
					}
				}

				if (ACS_Armor_Set_Check('acs_armor_omega', false))
				{
					if (ACSGetCEntity('ACS_Armor_Ether_Sword').IsEffectActive('andurial_glow', false))
					{
						ACSGetCEntity('ACS_Armor_Ether_Sword').DestroyEffect('andurial_glow');
					}

					if (ACSGetCEntity('ACS_Armor_Ether_Sword').IsEffectActive('pridefall_glow', false))
					{
						ACSGetCEntity('ACS_Armor_Ether_Sword').DestroyEffect('pridefall_glow');
					}

					if (ACSGetCEntity('ACS_Armor_Ether_Sword').IsEffectActive('dsd_open_glow', false))
					{
						ACSGetCEntity('ACS_Armor_Ether_Sword').DestroyEffect('dsd_open_glow');
					}

					if (ACSGetCEntity('ACS_Armor_Ether_Sword').IsEffectActive('dsd_closed_glow', false))
					{
						ACSGetCEntity('ACS_Armor_Ether_Sword').DestroyEffect('dsd_closed_glow');
					}

					if(GetWitcherPlayer().IsWeaponHeld( 'silversword' ) )
					{
						if (ACSGetCEntity('ACS_Armor_Ether_Sword').IsEffectActive('war_sword_glow', false))
						{
							ACSGetCEntity('ACS_Armor_Ether_Sword').DestroyEffect('war_sword_glow');
						}

						if (!ACSGetCEntity('ACS_Armor_Ether_Sword').IsEffectActive('soul_edge_glow', false))
						{
							thePlayer.SoundEvent("fx_rune_activate_igni");
							thePlayer.SoundEvent("fx_rune_activate_igni");
							thePlayer.SoundEvent("fx_rune_activate_igni");

							ACSGetCEntity('ACS_Armor_Ether_Sword').DestroyEffect('fire_sparks_trail');

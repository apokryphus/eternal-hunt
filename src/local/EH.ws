		RemoveTimer('ACS_blood_suck_victim_paralyze'); 
		
		thePlayer.StopEffect('blood_drain'); 
		thePlayer.StopEffect('blood_start');
		thePlayer.SetImmortalityMode( AIM_None, AIC_Default, true ); 

		thePlayer.SetCanPlayHitAnim(true); 
		
		//AddTimer('ACS_collision_delay', 0.1    , false);
		if (!thePlayer.IsUsingHorse()&& !thePlayer.IsUsingVehicle()){thePlayer.EnableCharacterCollisions(true); } 
		thePlayer.SetIsCurrentlyDodging(false);
		thePlayer.EnableCollisions(true);

		actors.Clear();
		
		actors = GetActorsInRange(thePlayer, 10, 10, 'acs_bruxa_bite_victim');

		//actors = thePlayer.GetNPCsAndPlayersInRange( 10, 10);

		//theGame.GetActorsByTag( 'acs_bruxa_bite_victim', actors );

		if( actors.Size() > 0 )
		{
			for( i = 0; i < actors.Size(); i += 1 )
			{
				npc = (CNewNPC)actors[i];

				NPCanimatedComponent = (CAnimatedComponent)npc.GetComponentByClassName( 'CAnimatedComponent' );	

				actor = actors[i];

				if (npc.HasTag('acs_bruxa_bite_victim'))
				{
					npc.SetImmortalityMode( AIM_None, AIC_Default, true ); 

					npc.StopEffect('demonic_possession');

					thePlayer.PlayEffectSingle('dive_shape');
					thePlayer.StopEffect('dive_shape');

					//thePlayer.PlayEffectSingle('dive_smoke');
					//thePlayer.StopEffect('dive_smoke');

					npc.RemoveBuff(EET_Confusion);

					npc.RemoveBuff(EET_Confusion);

					npc.RemoveBuff(EET_LongStagger);

					npc.RemoveBuff(EET_Slowdown);

					actor.RemoveBuffImmunity_AllNegative();

					actor.RemoveBuffImmunity_AllCritical();

					npc.RemoveBuffImmunity_AllNegative();

					npc.RemoveBuffImmunity_AllCritical();

					((CNewNPC)npc).SetUnstoppable(false);

					//NPCanimatedComponent.PlaySlotAnimationAsync ( '', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0, 0));

					npc.RemoveTag('ACS_demonic_possession');

					npc.RemoveTag('acs_bruxa_bite_victim');
				}
			}
		}

		thePlayer.RemoveTag('ACS_Bruxa_Bite_Process'); 
	}

	private var paintingEnvironment 							: CEnvironmentDefinition;	

	
	
	private var moonDayEnvironment, moonNightEnvironment, redWaterEnvironment, redGrassEnv, dofEnv, flareEnv		: CEnvironmentDefinition;	

	private var redGrassEnvID, redWaterEnvID, dofEnvID, flareEnvID										: Int32;

	
	
	private var env1, env2, env3, env4, env5, env6, env7, env8, env9, env10, env11, env12 								: CEnvironmentDefinition;	

	private var env1ID, env2ID, env3ID, env4ID, env5ID, env6ID, env7ID, env8ID, env9ID, env10ID, env11ID, env12ID 			: Int32;

	
	
	function Custom_Env_Switch( env_name : name, activate: bool )
	{
		switch(env_name)
		{
			case 'flare' :

				DeactivateEnvironment(flareEnvID, 0);

				if (activate)
				{
					flareEnv = ( CEnvironmentDefinition )LoadResource( 

					"dlc\dlc_acs\data\env\light_flare.env"
					
					, true );

					flareEnvID = ActivateEnvironmentDefinition( flareEnv, 1002, 1, 1 );

					theGame.SetEnvironmentID(flareEnvID);
				}
				else
				{
					DeactivateEnvironment(flareEnvID, 0);
				}
			break;

			case 'dof' :

				DeactivateEnvironment(dofEnvID, 0);

				if (!ACS_Settings_Main_Bool('acs_world_visual_settings','acs_dof_enabled', true))
				{
					return;
				}

				if (activate)
				{
					dofEnv = ( CEnvironmentDefinition )LoadResource( 

					"dlc\dlc_acs\data\env\env_dof.env"
					
					, true );

					dofEnv.envParams.m_depthOfField.intensity.dataCurveValues[0].lue = ACS_Settings_Main_Float('acs_world_visual_settings','acs_dof_blend', 1);		

					dofEnv.envParams.m_depthOfField.nearBlurDist.dataCurveValues[0].lue = ACS_Settings_Main_Float('acs_world_visual_settings','acs_dof_near_blur_dist', 50);
					dofEnv.envParams.m_depthOfField.nearFocusDist.dataCurveValues[0].lue = ACS_Settings_Main_Float('acs_world_visual_settings','acs_dof_near_focus_dist', 50);

					dofEnv.envParams.m_depthOfField.farBlurDist.dataCurveValues[0].lue = ACS_Settings_Main_Float('acs_world_visual_settings','acs_dof_far_blur_dist', 50);
					dofEnv.envParams.m_depthOfField.farFocusDist.dataCurveValues[0].lue = ACS_Settings_Main_Float('acs_world_visual_settings','acs_dof_far_focus_dist', 50);

					dofEnv.envParams.m_depthOfField.activatedSkyThreshold = ACS_Settings_Main_Bool('acs_world_visual_settings','acs_dof_activated_sky_threshold_enabled', true);

					dofEnv.envParams.m_depthOfField.activatedSkyRange = ACS_Settings_Main_Bool('acs_world_visual_settings','acs_dof_activated_sky_range_enabled', true);

					dofEnv.envParams.m_depthOfField.skyRange = ACS_Settings_Main_Float('acs_world_visual_settings','acs_dof_sky_range', 600);
	
					dofEnvID = ActivateEnvironmentDefinition( dofEnv, 1001, 1, 1 );

					theGame.SetEnvironmentID(dofEnvID);
				}
				else
				{
					DeactivateEnvironment(dofEnvID, 0);
				}
			break;

			case 'red_grass' :

				DeactivateEnvironment(redGrassEnvID, 0);

				if (!ACS_Settings_Main_Bool('acs_world_visual_settings','acs_spiral_sky_grass_enabled', false))
				{
					return;
				}

				if (activate)
				{
					redGrassEnv = ( CEnvironmentDefinition )LoadResource( 

					"dlc\dlc_acs\data\env\custom_hell_red_grass.env"
					
					, true );

					redGrassEnvID = ActivateEnvironmentDefinition( redGrassEnv, 1000, 1, 0 );

					theGame.SetEnvironmentID(redGrassEnvID);
				}
				else
				{
					DeactivateEnvironment(redGrassEnvID, 0);
				}
			break;

			case 'red_water' :

				DeactivateEnvironment(redWaterEnvID, 0);

				if (!ACS_Settings_Main_Bool('acs_world_visual_settings','acs_spiral_sky_water_enabled', true))
				{
					return;
				}

				if (activate)
				{
					redWaterEnvironment = ( CEnvironmentDefinition )LoadResource( 

					"dlc\dlc_acs\data\env\custom_hell_red_water.env"
					
					, true );

					redWaterEnvID = ActivateEnvironmentDefinition( redWaterEnvironment, 1000, 1, 1 );

					theGame.SetEnvironmentID(redWaterEnvID);
				}
				else
				{
					DeactivateEnvironment(redWaterEnvID, 0);
				}
			break;

			case 'bruxa_camo' :
				if (activate)
				{
					DeactivateEnvironment(bruxaCamoEnvID, 0);

					bruxaCamoEnvironment = (CEnvironmentDefinition)LoadResource(

					"dlc\dlc_acs\data\env\env_bies_hypnotize.env"

					, true);

					bruxaCamoEnvID = ActivateEnvironmentDefinition( bruxaCamoEnvironment, 1100, 1, 0.25f );

					theGame.SetEnvironmentID(bruxaCamoEnvID);
				}
				else
				{
					DeactivateEnvironment(bruxaCamoEnvID, 0.25f);
				}
			break;

			case 'global_fast_travel' :
				if (activate)
				{
					DeactivateEnvironment(globalFastTravelEnvID, 0);

					globalFastTravelEnvironment = (CEnvironmentDefinition)LoadResource(

					"dlc\dlc_acs\data\env\env_bies_hypnotize.env"

					, true);

					globalFastTravelEnvID = ActivateEnvironmentDefinition( globalFastTravelEnvironment, 1100, 1, 4.5 );

					theGame.SetEnvironmentID(globalFastTravelEnvID);
				}
				else
				{
					DeactivateEnvironment(globalFastTravelEnvID, 4.5);
				}
			break;

			case 'naglfar' :
				if (activate)
				{
					DeactivateEnvironment(env11ID, 0);

					env11 = ( CEnvironmentDefinition )LoadResource( 

					"dlc\dlc_acs\data\env\env_blizzard.env"
					
					, true );

					env11ID = ActivateEnvironmentDefinition( env11, 1000, 1, 2.25f );

					theGame.SetEnvironmentID(env11ID);
				}
				else
				{
					DeactivateEnvironment(env11ID, 2.25f);
				}
			break;

			case 'focus' :
				if (activate)
				{
					if (ACS_Settings_Main_Float('acs_hud_settings_focus_mode','acs_focus_mode_intensity', 0.5) <= 0)
					{
						return;
					}

					if (
					FactsQuerySum("ACS_Darkness_Upon_Us") > 0 
					&& ACS_Settings_Main_Float('acs_darkness_settings_main','acs_darkness_intensity', 50) >= 50
					)
					{
						return;
					}

					DeactivateEnvironment(focusModeEnvID, 0);

					if (ACS_Settings_Main_Bool('acs_hud_settings_focus_mode','acs_custom_focus_env_enabled', false))
					{
						focusModeEnvironment = (CEnvironmentDefinition)LoadResource(

						"dlc\dlc_acs\data\env\q605_hell_red_blockout.env"

						, true);

						focusModeEnvID = ActivateEnvironmentDefinition( focusModeEnvironment, 99998, 1, 1.f );

						theGame.SetEnvironmentID(focusModeEnvID);

						return;
					}

					if ((theGame.GetWorld().GetDepotPath() == "dlc\bob\data\levels\bob\bob.w2w"))
					{
						if (ACS_Settings_Main_Bool('acs_darkness_settings_main','acs_darkness_HBAO_enabled', true))
						{
							focusModeEnvironment = (CEnvironmentDefinition)LoadResource(

							"dlc\dlc_acs\data\env\darkness_upon_us_bob_alt.env"

							, true);
						}
						else
						{
							focusModeEnvironment = (CEnvironmentDefinition)LoadResource(

							"dlc\dlc_acs\data\env\darkness_upon_us_bob.env"

							, true);
						}
					}
					else
					{
						if (ACS_Settings_Main_Bool('acs_darkness_settings_main','acs_darkness_HBAO_enabled', true))
						{
							focusModeEnvironment = (CEnvironmentDefinition)LoadResource(

							"dlc\dlc_acs\data\env\darkness_upon_us_alt.env"

							, true);
						}
						else
						{
							focusModeEnvironment = (CEnvironmentDefinition)LoadResource(

							"dlc\dlc_acs\data\env\darkness_upon_us.env"

							, true);
						}
					}

					focusModeEnvID = ActivateEnvironmentDefinition( focusModeEnvironment, 1000, ACS_Settings_Main_Float('acs_hud_settings_focus_mode','acs_focus_mode_intensity', 0.5), 0.75f );

					theGame.SetEnvironmentID(focusModeEnvID);
				}
				else
				{
					if (ACS_Settings_Main_Bool('acs_hud_settings_focus_mode','acs_custom_focus_env_enabled', false))
					{
						DeactivateEnvironment(focusModeEnvID, 1.f);
					}
					else
					{
						DeactivateEnvironment(focusModeEnvID, 0.75f);
					}
				}
			break;

			case 'sneaking' :
				if (activate)
				{
					DeactivateEnvironment(sneakingEnvID, 0);

					if ((theGame.GetWorld().GetDepotPath() == "dlc\bob\data\levels\bob\bob.w2w"))
					{

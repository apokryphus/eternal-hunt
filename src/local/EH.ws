			theInput.UnregisterListener( thePlayer.GetInputHandler(), 'GI_MouseDampX' );

			theInput.RegisterListener( this, 'OnMouseMoveX', 'GI_MouseDampX' );

			theInput.UnregisterListener( thePlayer.GetInputHandler(), 'GI_MouseDampY' );

			theInput.RegisterListener( this, 'OnMouseMoveY', 'GI_MouseDampY' );
			*/
			
			vehicle = (CVehicleComponent)(thePlayer.GetUsedVehicle().GetComponentByClassName('CVehicleComponent'));

			if (vehicle)
			{
				itemId = thePlayer.GetSelectedItemId();

				isCrossbow = thePlayer.inv.IsItemCrossbow(itemId);

				if(!isCrossbow)
				{
					isBomb = thePlayer.inv.IsItemBomb(itemId);

					if(!isBomb)
					{
						isUsableItem = true;
					}
				}

				if (
				(thePlayer.IsUsingHorse() || thePlayer.IsUsingVehicle())
				)
				{
					if (isUsableItem
					|| (thePlayer.GetUsedVehicle()).HasTag('ACS_Player_Merchant_Ship') 
					|| (thePlayer.GetUsedVehicle()).HasTag('ACS_Player_Ghost_Ship')
					)
					{
						theInput.UnregisterListener( thePlayer.GetInputHandler(), 'VehicleItemAction' );

						theInput.RegisterListener( this, 'OnCbtThrowItem', 'VehicleItemAction' );
					}
				}
				else
				{
					theInput.UnregisterListener( this, 'VehicleItemAction' );
					//theInput.UnregisterListener( this, 'VehicleItemActionHold' );
					//theInput.UnregisterListener( this, 'VehicleItemActionAbort' );

					theInput.RegisterListener( vehicle.GetUserCombatManager(), 'OnItemAction', 'VehicleItemAction' );
					//theInput.RegisterListener( vehicle.GetUserCombatManager(), 'OnItemActionHold', 'VehicleItemActionHold' );
					//theInput.RegisterListener( vehicle.GetUserCombatManager(), 'OnItemActionAbort', 'VehicleItemActionAbort' );
				}
			}
		}

		if(!theGame.GetGuiManager().IsAnyMenu())
		{
			theInput.UnregisterListener( thePlayer.GetInputHandler(), 'ShowDeveloperModeAlt' );

			theInput.RegisterListener( this, 'OnShowDeveloperMode', 'ShowDeveloperModeAlt' );
		}
		else
		{
			theInput.UnregisterListener( this, 'ShowDeveloperModeAlt' );
		}
	}


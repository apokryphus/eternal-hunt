	event OnCbtAttackWithAlternateLight( action : SInputAction )
	{
		if (theInput.GetActionValue('ControllerCastModifier') > 0.5)
		{
			return false;
		}
	
		CbtAttackPC( action, false);
	}

	function FocusModeOverlapCheck() : bool
	{
		if (theGame.GetFocusModeController().IsActive())
		{
			return false;
		}

		if (theInput.IsActionJustReleased('Focus'))
		{
			return false;
		}

		if (theInput.GetActionValue('Focus') > 0)
		{
			return false;
		}

		if (theInput.GetActionValue('Focus') < 0)
		{
			return false;
		}

		return true;	
	}
	
	event OnCbtAttackWithAlternateHeavy( action : SInputAction )
	{
		if (theInput.GetActionValue('ControllerCastModifier') > 0.5)
		return false;

		if ( !FocusModeOverlapCheck() )
		return false;
		
		CbtAttackPC( action, true);
	}
	
	function CbtAttackPC( action : SInputAction, isHeavy : bool )
	{
		var switchAttackType : bool;
		
		switchAttackType = ShouldSwitchAttackType();
		
		if ( !theInput.LastUsedPCInput() )
		{
			return;
		}
		
		if ( switchAttackType != isHeavy) 
		{
			if ( !FocusModeOverlapCheck() )
			return;
	
			OnCbtAttackHeavy(action);
		}
		else
		{
			OnCbtAttackLight(action);
		}
	}

	private function ShouldSwitchAttackType():bool
	{
		var outKeys : array<EInputKey>;	
		
		if ( theInput.LastUsedPCInput() )
		{		
			theInput.GetPCKeysForAction('PCAlternate',outKeys);
			if ( outKeys.Size() > 0 )
			{
				if ( theInput.IsActionPressed('PCAlternate') )
				{
					return true;
				}
			}
		}
		return false;
	}

	var last_fast_sprint_activate : float;

	var last_swim_dodge_activate : float;

	var fast_sprint_activated : bool;

	default fast_sprint_activated = false;

	event OnCommSprint( action : SInputAction )
	{
		var movementAdjustor														: CMovementAdjustor;
		var ticket_rotate 															: SMovementAdjustmentRequestTicket;
		var pos 																	: Vector;
		var camera 																	: CCustomCamera;

		var ent, ent_1, ent_2, ent_3, ent_4, wings_torso_anchor_1					: CEntity;
		var anchor_temp																: CEntityTemplate;
		var bonePosition															: Vector;
		var boneRotation															: EulerAngles;
		var targetDistance 															: float;

		if( IsPressed( action ) 
		&& FactsQuerySum("ACS_Has_Double_Jumped") > 0
		)
		{
			if (FactsQuerySum("ACS_Is_Gliding") > 0)
			{
				theGame.ReleaseNoSaveLock( ACS_Glide_Savelock_ID );

				thePlayer.UnblockAction( EIAB_Crossbow, 			'ACS_Gliding');
				thePlayer.UnblockAction( EIAB_CallHorse,			'ACS_Gliding');
				thePlayer.UnblockAction( EIAB_Signs, 				'ACS_Gliding');
				thePlayer.UnblockAction( EIAB_DrawWeapon, 			'ACS_Gliding');
				thePlayer.UnblockAction( EIAB_FastTravel, 			'ACS_Gliding');
				thePlayer.UnblockAction( EIAB_Fists, 				'ACS_Gliding');
				thePlayer.UnblockAction( EIAB_InteractionAction, 	'ACS_Gliding');
				thePlayer.UnblockAction( EIAB_UsableItem,			'ACS_Gliding');
				thePlayer.UnblockAction( EIAB_ThrowBomb,			'ACS_Gliding');
				thePlayer.UnblockAction( EIAB_SwordAttack,			'ACS_Gliding');
				thePlayer.UnblockAction( EIAB_LightAttacks,			'ACS_Gliding');
				thePlayer.UnblockAction( EIAB_HeavyAttacks,			'ACS_Gliding');
				thePlayer.UnblockAction( EIAB_SpecialAttackLight,	'ACS_Gliding');
				thePlayer.UnblockAction( EIAB_SpecialAttackHeavy,	'ACS_Gliding');
				thePlayer.UnblockAction( EIAB_Dodge,				'ACS_Gliding');
				thePlayer.UnblockAction( EIAB_Roll,					'ACS_Gliding');
				thePlayer.UnblockAction( EIAB_Parry,				'ACS_Gliding');
				thePlayer.UnblockAction( EIAB_MeditationWaiting,	'ACS_Gliding');
				thePlayer.UnblockAction( EIAB_OpenMeditation,		'ACS_Gliding');
				thePlayer.UnblockAction( EIAB_RadialMenu,			'ACS_Gliding');
				thePlayer.UnblockAction( EIAB_Movement,				'ACS_Gliding');
				thePlayer.UnblockAction( EIAB_Interactions, 		'ACS_Gliding');
				thePlayer.UnblockAction( EIAB_Jump, 				'ACS_Gliding');
				thePlayer.UnblockAction( EIAB_QuickSlots, 			'ACS_Gliding');

				RemoveTimer('ACS_Gliding');

				thePlayer.RaiseEvent('ACS_ForceHandClosedREnd');

				if (!thePlayer.HasTag('ACS_Dual_Wield_Active') && !ACSGetCEntity('ACS_Viper_Dagger_L')){thePlayer.RaiseEvent('ACS_ForceHandClosedLEnd');}

				thePlayer.StopEffect('glide_fx');
				thePlayer.PlayEffectSingle('glide_fx');
				thePlayer.StopEffect('glide_fx');

				thePlayer.StopEffect( 'bruxa_dash_trails' );
				thePlayer.PlayEffectSingle( 'bruxa_dash_trails' );
				thePlayer.StopEffect( 'bruxa_dash_trails' );

				thePlayer.PlayEffectSingle('embers_particles_test');
				thePlayer.StopEffect('embers_particles_test');

				thePlayer.EnableCollisions(true);
				if (!thePlayer.IsUsingHorse()&& !thePlayer.IsUsingVehicle()){thePlayer.EnableCharacterCollisions(true); }

				thePlayer.SetImmortalityMode( AIM_None, AIC_Default, true ); 

				thePlayer.SetVisibility( true );

				thePlayer.DestroyEffect('acs_glide_disappear');

				thePlayer.RemoveTag('ACS_Wild_Hunt_Horse_Flying');

				if (thePlayer.HasTag('ACS_Vampire_Blood_Flight'))
				{
					thePlayer.RemoveTag('ACS_Vampire_Blood_Flight');

					thePlayer.SoundEvent("magic_yennefer_necromancy_loop_stop");

					thePlayer.SoundEvent("q704_regis_mistform_LP_stop");
					thePlayer.SoundEvent("q704_regis_mistform_LP_stop");
					thePlayer.SoundEvent("q704_regis_mistform_LP_stop");

					thePlayer.SoundEvent("monster_dettlaff_monster_combat_construct_dash_vfx");

					thePlayer.StopEffect('shadowdash_body_blood_construct');

					thePlayer.StopEffect('shadowdash_ground_blood_construct');

					thePlayer.StopEffect('avatar_death_swollen_no_decal_construct');

					ACSGetCEntity('ACS_Wings_Entity').StopEffect('shadowdash_construct');

					ACSGetCEntity('ACS_Wings_Entity').DestroyAfter(3);

					ACSGetCEntity('ACS_Wings_Entity').RemoveTag('ACS_Wings_Entity');

				}
				else
				{
					ACSGetCEntity('ACS_Wings_Entity_Anchor').BreakAttachment();

					ACSGetCEntity('ACS_Wings_Entity_Anchor').CreateAttachment(thePlayer,,Vector(0,0,-200));

					ACSGetCEntity('ACS_Wings_Entity_Anchor').DestroyAfter(0.5);

					ACSGetCEntity('ACS_Wings_Entity_Anchor').RemoveTag('ACS_Wings_Entity_Anchor');

					ACSGetCEntity('ACS_Wings_Entity').BreakAttachment();

					ACSGetCEntity('ACS_Wings_Entity').CreateAttachment(thePlayer,,Vector(0,0,-200));

					ACSGetCEntity('ACS_Wings_Entity').DestroyAfter(0.5);

					ACSGetCEntity('ACS_Wings_Entity').RemoveTag('ACS_Wings_Entity');
				}

				ACSGetCEntity('ACS_Igni_Glide_Entity_R').Destroy();

				ACSGetCEntity('ACS_Igni_Glide_Entity_L').Destroy();

				ACSGetCEntity('ACS_Igni_Glide_Entity_L_Leg').Destroy();

				ACSGetCEntity('ACS_Igni_Glide_Entity_R_Leg').Destroy();

				RemoveTimer('Fleder_Glide_Fear');

				RemoveTimer('Vampire_Monster_Bat_Swarm_Small');

				((CAnimatedComponent)thePlayer.GetComponentByClassName('CAnimatedComponent')).UnfreezePoseFadeOut(0.1);

				((CAnimatedComponent)thePlayer.GetComponentByClassName('CAnimatedComponent')).UnfreezePose();

				if (thePlayer.IsInAir())
				{
					PlayerPlayAnimation( 'ex_fall_start' );
				}
				else
				{
					if ( thePlayer.IsAnyWeaponHeld() )
					{
						if (thePlayer.IsWeaponHeld('fist') )
						{
							PlayerPlayAnimation( 'man_geralt_sword_dodge_roll_rp_f_01_fist' );
						}
						else
						{
							PlayerPlayAnimation( 'man_geralt_sword_dodge_roll_rp_f_01' );
						}
					}
					else
					{
						PlayerPlayAnimation( 'man_geralt_sword_dodge_roll_rp_f_01_fist' );
					}
				}

				thePlayer.SoundEvent("monster_dettlaff_monster_movement_wing_flap_long_hard");

				thePlayer.SoundEvent("monster_dettlaff_monster_movement_land");

				if ( thePlayer.HasTag('ACS_HideWeaponOnDodge') )
				{
					if (!thePlayer.HasTag('acs_aard_sword_equipped'))
					{
						ACS_Weapon_Respawn();
					}
					
					thePlayer.RemoveTag('ACS_HideWeaponOnDodge');

					thePlayer.RemoveTag('ACS_HideWeaponOnDodge_Claw_Effect');
				}

				thePlayer.RaiseEvent('ACS_FlyPoseReset');

				if (wraith_pose)
				{
					wraith_pose = false;
				}

				if (wraith_pose_switch
				)
				{
					wraith_pose_switch = false;
				}

				FactsRemove("ACS_Is_Gliding");
			}

			if( FactsQuerySum("ACS_Has_Air_Dashed") <= 0
			)
			{
				
				theGame.GetBehTreeReactionManager().CreateReactionEventIfPossible( thePlayer, 'CastSignAction', 1, 1.75f, -1.f, -1, true );

				thePlayer.RaiseEvent('ACS_DodgeAdditiveEnd');

				if (ACS_Armor_Set_Check('acs_armor', false)
				|| thePlayer.HasTag('acs_vampire_claws_equipped')
				|| ACS_Vampire_Claws_Access()
				)
				{
					thePlayer.PlayEffectSingle('vampire_magic_step_r');
					thePlayer.StopEffect('vampire_magic_step_r');

					thePlayer.PlayEffectSingle('vampire_magic_step_l');
					thePlayer.StopEffect('vampire_magic_step_l');
				}
				else
				{
					thePlayer.PlayEffectSingle('odim_magic_step_r');
					thePlayer.StopEffect('odim_magic_step_r');

					thePlayer.PlayEffectSingle('odim_magic_step_l');
					thePlayer.StopEffect('odim_magic_step_l');
				}

				thePlayer.SoundEvent("sign_aard_blast");

				RemoveTimer('DoubleJumpSlowMo');

				RemoveTimer('RemoveACSSlowmo');

				theGame.RemoveTimeScale( theGame.GetTimescaleSource(ETS_InstantKill) );
				
				AardLightIconHands();

				movementAdjustor = thePlayer.GetMovingAgentComponent().GetMovementAdjustor();

				ticket_rotate = movementAdjustor.GetRequest( 'ACS_Air_Dash');
				movementAdjustor.CancelByName( 'ACS_Air_Dash' );
				movementAdjustor.CancelAll();
				
				ticket_rotate = movementAdjustor.CreateNewRequest( 'ACS_Air_Dash');
				movementAdjustor.MaxRotationAdjustmentSpeed( ticket_rotate, 5000000 );
				movementAdjustor.MaxLocationAdjustmentSpeed( ticket_rotate, 5000000 );
				movementAdjustor.AdjustmentDuration( ticket_rotate, 0.25f );
				movementAdjustor.AdjustLocationVertically( ticket_rotate, true );

				camera = (CCustomCamera)theCamera.GetTopmostCameraObject();
				
				if(	AbsF(AngleDistance(camera.GetHeading(), thePlayer.GetHeading())) > 45)
				{
					movementAdjustor.RotateTo( ticket_rotate, VecHeading( thePlayer.GetHeadingVector() ) );

					pos = thePlayer.GetWorldPosition() + thePlayer.GetWorldForward() * 10;
				}
				else
				{
					movementAdjustor.RotateTo( ticket_rotate, VecHeading( theCamera.GetCameraDirection() ) );
		
					pos = theCamera.GetCameraPosition() + theCamera.GetCameraDirection() * 15;
				}

				movementAdjustor.SlideTo(ticket_rotate, pos);

				if (thePlayer.IsAnyWeaponHeld()
				&& !thePlayer.IsWeaponHeld('fist')
				)
				{
					thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( 'man_geralt_sword_dodge_roll_rp_f_01', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0, 1.0f) );

					RemoveTimer('CombatTauntDelay');
					RemoveTimer('SwordTauntRunningSwitchSecondary'); 
					RemoveTimer('SwordTauntRunningSwitchSecondaryWeaponBlood'); 
					AddTimer('SwordTauntRunningSwitchSecondary', 0.01 , false); 
				}
				else
				{
					thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( 'man_geralt_sword_dodge_roll_rp_f_01_fist', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0, 1.0f) );
				}

				((CAnimatedComponent)(thePlayer).GetComponentByClassName('CAnimatedComponent')).FreezePoseFadeIn(1.375f);

				//thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( '', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(1, 1) );

				//thePlayer.RaiseEvent('ACS_Dodge03');

				thePlayer.SoundEvent("cmb_weapon_swoosh_light_slow");

				thePlayer.SoundEvent("monster_panther_movement_whoosh_jump");

				thePlayer.SoundEvent("scene_grunt_vo_attack_long_ALWAYS");

				thePlayer.PlayEffectSingle('acs_fast_sprint_trail');
				thePlayer.StopEffect('acs_fast_sprint_trail');

				thePlayer.StopEffect('shadowdash_shockwave');

				thePlayer.PlayEffectSingle('shadowdash_shockwave');

				thePlayer.StopEffect('shadowdash_shockwave');

				thePlayer.RaiseEvent('ACS_TorsoBend');

				FactsAdd("ACS_Has_Air_Dashed", 1, -1);
			}
			
			return false;
		}

		if (FactsQuerySum("acs_transformation_activated") > 0)
		{
			if( IsPressed(action) )
			{
				ACS_ExplorationDelayHack(false, 3);

				if (FactsQuerySum("acs_wolven_curse_activated") > 0)
				{
					//ACS_Transformation_Werewolf_Light_Attacks();
				}

				if (FactsQuerySum("acs_vampireess_transformation_activated") > 0)
				{
					ACS_Transformation_Vampiress_Dash();
				}

				if (FactsQuerySum("acs_vampire_monster_transformation_activated") > 0)
				{
					
				}

				if (FactsQuerySum("acs_toad_transformation_activated") > 0)
				{
					ACS_Transformation_Toad_Leap();
				}

				if (FactsQuerySum("acs_sharley_curse_activated") > 0)
				{
					SharleyRollInit();
				}
			}

			if (IsReleased(action) )
			{
				if (FactsQuerySum("acs_sharley_curse_activated") > 0)
				{
					ACSGetCActor('ACS_Transformation_Sharley').RemoveTag('ACS_Sharley_Roll_Init');
				}
			}

			return false;
		}
		
		if( IsPressed( action ) )
		{
			if(theGame.GetInGameConfigWrapper().GetVarValue('Gameplay', 'EnableAlternateSignCasting') == "1")
			{
				altSignCasting = true;
			}	
			else
			{
				altSignCasting = false;
			}

			if( altSignCasting )
			{
				thePlayer.ApplyCastSettings(); 
			}

			if(altSignCasting && !theInput.LastUsedPCInput() && theInput.GetActionValue('CastSign') > 0.1f && !GetWitcherPlayer().IsCurrentSignChanneled())
			{

				if (ACS_Settings_Main_Bool('acs_signs_settings','acs_alternate_quickcasting_controls_enabled', false))
				{
					return false;
				}
				
				AltCastSign(ST_Aard);
				return false;
			}

			if (ACS_New_Replacers_Female_Active())
			{
				thePlayer.SetSprintActionPressed(true);
			
				if ( thePlayer.rangedWeapon )
					thePlayer.rangedWeapon.OnSprintHolster();

				return false;
			}

			if (ACS_Settings_Main_Bool('acs_bruxa_dash_settings','acs_bruxa_dash', false))
			{
				if 
				(
				ACS_CombatToExplorationCheck()
				&& !thePlayer.IsInCombat() 
				&& !thePlayer.IsInCombatState()
				&& !thePlayer.IsInCombatAction()
				)
				{
					BruxaDash_NEW_For_Sprint();
				}
				else
				{
					if (thePlayer.IsInAir() 
					&& thePlayer.IsInCombat()
					&& ACS_Settings_Main_Bool('acs_dodge_settings','acs_bruxa_leap_attack', false)
					&& ACS_Settings_Main_Int('acs_bruxa_dash_settings','acs_bruxa_dash_input', 0) == 1
					&& ACS_Settings_Main_Int('acs_bruxa_dash_settings','acs_bruxa_dash_sprint_or_w', 0) == 1
					)
					{
						Attack_Process_06('geraltRandomAirJumpAttack');
					}
				}
			}

		
			if( DoubleTapSprintCallTime + DOUBLE_TAP_WINDOW >= theGame.GetEngineTimeAsSeconds() )
			{
				SprintDoubleTap = true;
			}
			else
			{
				SprintDoubleTap = false;	
			}
			
			if( SprintDoubleTap ) 
			{
				if (!thePlayer.IsInHitAnim()
				&& !thePlayer.HasTag('ACS_IsPerformingFinisher')
				&& !thePlayer.HasTag('ACS_IsPerformingCombatDismember')
				&& !thePlayer.IsCrossbowHeld()
				&& ACS_BuffCheck()
				&& !thePlayer.IsCurrentlyDodging()
				&& !thePlayer.HasTag('ACS_Is_Currently_Dodging')
				&& thePlayer.IsActionAllowed(EIAB_Movement)
				&& ACS_CombatToExplorationCheck()
				&& !thePlayer.IsInCombat() 
				&& !thePlayer.IsInCombatState()
				&& !thePlayer.IsInCombatAction()
				&& thePlayer.GetStat( BCS_Stamina ) > 0
				&& !thePlayer.IsSwimming()
				&& !thePlayer.IsDiving()
				&& !thePlayer.IsThreatened()
				)
				{
					if (ACS_Settings_Main_Bool('acs_movement_main_settings','acs_fast_sprint', true)
					&& theGame.GetEngineTimeAsSeconds() - last_fast_sprint_activate > 2
					&& !fast_sprint_activated
					)
					{
						last_fast_sprint_activate = theGame.GetEngineTimeAsSeconds();

						RemoveTimer('ActivateFastSprint');
						AddTimer('ActivateFastSprint', 1 , false);
					}
				}

				if (!thePlayer.HasTag('acs_in_wraith'))
				{
					if (thePlayer.IsSwimming() || thePlayer.IsDiving())
					{
						if (thePlayer.GetStat(BCS_Stamina) > thePlayer.GetStatMax(BCS_Stamina) * 0.01)
						{
							if (theGame.GetEngineTimeAsSeconds() - last_swim_dodge_activate > 1
							)
							{
								last_swim_dodge_activate = theGame.GetEngineTimeAsSeconds();

								SwimDodges();
							}
						}
						else
						{
							GetWitcherPlayer().SoundEvent("gui_no_stamina");
						}
					}
				}
			}
			
			DoubleTapSprintCallTime = theGame.GetEngineTimeAsSeconds();
		
			thePlayer.SetSprintActionPressed(true);

			switch(currspeed)
			{
				case 4:
					if (currspeed_was_slowwalking)
					{	
						currspeed_was_slowwalking = false;
					}

					if (currspeed_was_walking)
					{	
						currspeed_was_walking = false;
					}

					if (currspeed_was_slowjogging)
					{
						currspeed_was_slowjogging = false;
					}

					if (currspeed_was_jogging)
					{	
						currspeed_was_jogging = false;
					}

					currspeed = 4;
				break;

				case 3:

					if (currspeed_was_slowwalking)
					{	
						currspeed_was_slowwalking = false;
					}

					if (currspeed_was_walking)
					{	
						currspeed_was_walking = false;
					}

					if (currspeed_was_slowjogging)
					{
						currspeed_was_slowjogging = false;
					}

					if (!currspeed_was_jogging)
					{	
						currspeed_was_jogging = true;
					}
					currspeed = 4;
				break;

				case 2:

					if (currspeed_was_slowwalking)
					{	
						currspeed_was_slowwalking = false;
					}

					if (currspeed_was_walking)
					{	
						currspeed_was_walking = false;
					}

					if (currspeed_was_jogging)
					{	
						currspeed_was_jogging = false;
					}

					if (!currspeed_was_slowjogging)
					{
						currspeed_was_slowjogging = true;
					}
					currspeed = 4;
				break;

				case 1:
					if (currspeed_was_jogging)
					{	
						currspeed_was_jogging = false;
					}

					if (currspeed_was_slowwalking)
					{	
						currspeed_was_slowwalking = false;
					}

					if (currspeed_was_slowjogging)
					{
						currspeed_was_slowjogging = false;
					}

					if (!currspeed_was_walking)
					{	
						currspeed_was_walking = true;
					}
					
					currspeed = 4;
				break;

				case 0:
					if (currspeed_was_jogging)
					{	
						currspeed_was_jogging = false;
					}

					if (currspeed_was_walking)
					{	
						currspeed_was_walking = false;
					}

					if (currspeed_was_slowjogging)
					{
						currspeed_was_slowjogging = false;
					}

					if (!currspeed_was_slowwalking)
					{	
						currspeed_was_slowwalking = true;
					}

					currspeed = 4;
				break;

				default:
					if (currspeed_was_jogging)
					{	
						currspeed_was_jogging = false;
					}

					if (currspeed_was_walking)
					{	
						currspeed_was_walking = false;
					}

					if (currspeed_was_slowjogging)
					{
						currspeed_was_slowjogging = false;
					}

					if (!currspeed_was_slowwalking)
					{	
						currspeed_was_slowwalking = true;
					}

					currspeed = 4;
				break;
			}
			
			if ( thePlayer.rangedWeapon )
			{
				thePlayer.rangedWeapon.OnSprintHolster();
			}

			if (!thePlayer.HasTag('acs_in_wraith'))
			{
				if (thePlayer.IsSwimming() || thePlayer.IsDiving())
				{
					if (!swimmingCounterCheck)
					{
						swimmingCounterCheck = true;

						RemoveTimer('SwimCounterCheckRemove');
						AddTimer('SwimCounterCheckRemove', 0.5 , false);
					}
				}
			}
		}

		if (IsReleased(action))
		{
			if (currspeed_was_jogging)
			{
				currspeed = 2;

				currspeed_was_jogging = false;
			}
			else
			{
				if (currspeed_was_slowjogging)
				{
					currspeed = 2;

					currspeed_was_slowjogging = false;
				}
				else
				{
					if (currspeed_was_walking)
					{
						currspeed = 1;

						currspeed_was_walking = false;
					}
					else
					{
						if (currspeed_was_slowwalking)
						{
							currspeed = 0;

							currspeed_was_slowwalking = false;
						}
						else
						{
							currspeed = 0;
						}
					}
				}
			}

			if (swimmingCounterCheck)
			{
				swimmingCounterCheck = false;
			}

			RemoveTimer('SwimCounterCheckRemove');

			RemoveTimer('ActivateFastSprint');
		}
	}

	var currspeed_was_jogging : bool;

	var currspeed_was_slowjogging : bool;

	var currspeed_was_walking : bool;

	var currspeed_was_slowwalking : bool;

	event OnCommSprintToggle( action : SInputAction )
	{
		if( IsPressed(action) )
		{
			
			if( theInput.LastUsedPCInput() 
			|| thePlayer.GetLeftStickSprint() 
			)
			{
				switch(currspeed)
				{
					case 4:
						if (currspeed_was_jogging)
						{
							currspeed = 2;

							currspeed_was_jogging = false;
						}
						else
						{
							if (currspeed_was_slowjogging)
							{
								currspeed = 2;

								currspeed_was_slowjogging = false;
							}
							else
							{
								if (currspeed_was_walking)
								{
									currspeed = 1;

									currspeed_was_walking = false;
								}
								else
								{
									if (currspeed_was_slowwalking)
									{
										currspeed = 0;

										currspeed_was_slowwalking = false;
									}
									else
									{
										currspeed = 0;
									}
								}
							}
						}
					break;

					case 3:
						if (currspeed_was_slowwalking)
						{
							currspeed_was_slowwalking = false;
						}

						if (currspeed_was_walking)
						{
							currspeed_was_walking = false;
						}

						if (currspeed_was_slowjogging)
						{
							currspeed_was_slowjogging = false;
						}

						if (!currspeed_was_jogging)
						{
							currspeed_was_jogging = true;
						}

						currspeed = 4;
					break;

					case 2:
						if (currspeed_was_slowwalking)
						{
							currspeed_was_slowwalking = false;
						}

						if (currspeed_was_walking)
						{
							currspeed_was_walking = false;
						}

						if (currspeed_was_jogging)
						{
							currspeed_was_jogging = false;
						}

						if (!currspeed_was_slowjogging)
						{
							currspeed_was_slowjogging = true;
						}

						currspeed = 4;
					break;

					case 1:
						if (currspeed_was_slowwalking)
						{
							currspeed_was_slowwalking = false;
						}

						if (currspeed_was_jogging)
						{
							currspeed_was_jogging = false;
						}

						if (currspeed_was_slowjogging)
						{
							currspeed_was_slowjogging = false;
						}

						if (!currspeed_was_walking)
						{
							currspeed_was_walking = true;
						}

						currspeed = 4;
					break;

					case 0:
						if (currspeed_was_walking)
						{
							currspeed_was_walking = false;
						}

						if (currspeed_was_jogging)
						{
							currspeed_was_jogging = false;
						}

						if (currspeed_was_slowjogging)
						{
							currspeed_was_slowjogging = false;
						}

						if (!currspeed_was_slowwalking)
						{
							currspeed_was_slowwalking = true;
						}

						currspeed = 4;
					break;

					default:
						if (currspeed_was_walking)
						{
							currspeed_was_walking = false;
						}

						if (currspeed_was_jogging)
						{
							currspeed_was_jogging = false;
						}

						if (currspeed_was_slowjogging)
						{
							currspeed_was_slowjogging = false;
						}

						if (!currspeed_was_slowwalking)
						{
							currspeed_was_slowwalking = true;
						}

						currspeed = 4;
					break;
				}
					
				if ( thePlayer.GetIsSprintToggled() )
					thePlayer.SetSprintToggle( false );
				else
				{
					thePlayer.SetSprintToggle( true );
					
					if ( thePlayer.rangedWeapon )
						thePlayer.rangedWeapon.OnSprintHolster();
					
				}
			}
		}
	}	
	
	function SwimDodges()
	{
		var movementAdjustor						: CMovementAdjustor;
		var ticket									: SMovementAdjustmentRequestTicket;
		var item 									: array<CEntity>;
		var i										: int;
		var dive_distance							: float;
		
		item.Clear();

		theGame.GetEntitiesByTag( 'ACS_Bubble_Trail' , item );	
		
		for( i = 0; i < item.Size(); i += 1 )
		{
			item[i].PlayEffect('underwater_dodge');
			item[i].StopEffect('underwater_dodge');
		}

		if (!thePlayer.IsEffectActive('water_effect_surfacing', false))
		{
			thePlayer.PlayEffectSingle('water_effect_surfacing');
		}

		if (!swimmingDodgeCheck)
		{
			swimmingDodgeCheck = true;

			RemoveTimer('swimmingDodgeCheckRemove');
			AddTimer('swimmingDodgeCheckRemove', 1 , false);
		}

		thePlayer.PlayEffectSingle('acs_fast_sprint_trail');
		thePlayer.StopEffect('acs_fast_sprint_trail');

		thePlayer.DrainStamina( ESAT_FixedValue, thePlayer.GetStatMax( BCS_Stamina ) * 0.125, 2 );

		movementAdjustor = GetWitcherPlayer().GetMovingAgentComponent().GetMovementAdjustor();

		movementAdjustor.CancelAll();
		ticket = movementAdjustor.CreateNewRequest( 'ACS_Swimming_Movement_Adjustor' );
		
		movementAdjustor.AdjustmentDuration( ticket, 0.5 );
		movementAdjustor.MaxRotationAdjustmentSpeed( ticket, 50000000 );
		movementAdjustor.MaxLocationAdjustmentSpeed( ticket, 100 );

		if (thePlayer.IsDiving())
		{
			movementAdjustor.AdjustLocationVertically( ticket, true );

			dive_distance = 6;
		}
		else
		{
			dive_distance = 3;
		}

		//movementAdjustor.RotateTo( ticket, VecHeading( theCamera.GetCameraDirection() ));
		
		if (theInput.GetActionValue('GI_AxisLeftY') > 0.1 && theInput.GetActionValue('GI_AxisLeftX') == 0)
		{
			if (RandF() < 0.5)
			{
				thePlayer.RaiseEvent('ACS_SwimmingDodgesForward');
			}
			else
			{
				thePlayer.RaiseEvent('ACS_SwimmingDodgesForwardAlt');
			}

			movementAdjustor.SlideTo( ticket, GetWitcherPlayer().GetWorldPosition() + theCamera.GetCameraDirection() * dive_distance );
		}
		else if (theInput.GetActionValue('GI_AxisLeftY') < -0.1 && theInput.GetActionValue('GI_AxisLeftX') == 0  )
		{
			if (RandF() < 0.5)
			{
				thePlayer.RaiseEvent('ACS_SwimmingDodgesForward');
			}
			else
			{
				thePlayer.RaiseEvent('ACS_SwimmingDodgesForwardAlt');
			}

			movementAdjustor.SlideTo( ticket, GetWitcherPlayer().GetWorldPosition() + theCamera.GetCameraDirection() * -dive_distance );
		}
		else if (theInput.GetActionValue('GI_AxisLeftX') > 0.1 && theInput.GetActionValue('GI_AxisLeftY') == 0 )
		{
			thePlayer.RaiseEvent('ACS_SwimmingDodgesRight');

			movementAdjustor.SlideTo( ticket, GetWitcherPlayer().GetWorldPosition() + theCamera.GetCameraDirection() + theCamera.GetCameraRight() * dive_distance );
		}
		else if (theInput.GetActionValue('GI_AxisLeftX') < -0.1 && theInput.GetActionValue('GI_AxisLeftY') == 0) 
		{
			thePlayer.RaiseEvent('ACS_SwimmingDodgesLeft');

			movementAdjustor.SlideTo( ticket, GetWitcherPlayer().GetWorldPosition() + theCamera.GetCameraDirection() + theCamera.GetCameraRight() * -dive_distance );
		}
		else if (theInput.GetActionValue('GI_AxisLeftY') > 0.1 && theInput.GetActionValue('GI_AxisLeftX') > 0.1 )
		{
			thePlayer.RaiseEvent('ACS_SwimmingDodgesRight');

			movementAdjustor.SlideTo( ticket, GetWitcherPlayer().GetWorldPosition() + theCamera.GetCameraDirection() * dive_distance + theCamera.GetCameraRight() * dive_distance);
		}
		else if (theInput.GetActionValue('GI_AxisLeftY') > 0.1 && theInput.GetActionValue('GI_AxisLeftX') < -0.1 )
		{
			thePlayer.RaiseEvent('ACS_SwimmingDodgesLeft');

			movementAdjustor.SlideTo( ticket, GetWitcherPlayer().GetWorldPosition() + theCamera.GetCameraDirection() * dive_distance + theCamera.GetCameraRight() * -dive_distance);
		}
		else if (theInput.GetActionValue('GI_AxisLeftY') < -0.1 && theInput.GetActionValue('GI_AxisLeftX') > 0.1 )
		{
			if (RandF() < 0.5)
			{
				thePlayer.RaiseEvent('ACS_SwimmingDodgesForward');
			}
			else
			{
				thePlayer.RaiseEvent('ACS_SwimmingDodgesForwardAlt');
			}

			movementAdjustor.SlideTo( ticket, GetWitcherPlayer().GetWorldPosition() + theCamera.GetCameraDirection() * -dive_distance + theCamera.GetCameraRight() * dive_distance);
		}
		else if (theInput.GetActionValue('GI_AxisLeftX') < -0.1 && theInput.GetActionValue('GI_AxisLeftY') < -0.1 )
		{
			if (RandF() < 0.5)
			{
				thePlayer.RaiseEvent('ACS_SwimmingDodgesForward');
			}
			else
			{
				thePlayer.RaiseEvent('ACS_SwimmingDodgesForwardAlt');
			}

			movementAdjustor.SlideTo( ticket, GetWitcherPlayer().GetWorldPosition() + theCamera.GetCameraDirection() * -dive_distance + theCamera.GetCameraRight() * -dive_distance);
		}
		else
		{
			if (RandF() < 0.5)
			{
				thePlayer.RaiseEvent('ACS_SwimmingDodgesForward');
			}
			else
			{
				thePlayer.RaiseEvent('ACS_SwimmingDodgesForwardAlt');
			}

			movementAdjustor.SlideTo( ticket, GetWitcherPlayer().GetWorldPosition() + theCamera.GetCameraDirection() * dive_distance );
		}

		//thePlayer.RaiseEvent('ACS_Dodge03');
	}

	var swimmingCounterCheck : bool;

	timer function SwimCounterCheckRemove( dt : float, id : int )
	{
		swimmingCounterCheck = false;
	}

	timer function swimmingDodgeCheckRemove( dt : float, id : int )
	{
		swimmingDodgeCheck = false;
	}

	timer function ActivateFastSprint( dt : float, id : int )
	{
		ResetFastWalk();

		if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	

		thePlayer.SoundEvent("grunt_vo_attack_long");
		thePlayer.SoundEvent("grunt_vo_attack_long_ALWAYS");
		
		if (
		( ACS_GetWeaponMode() == 0 && ACS_Settings_Main_Int('acs_combat_main_settings','acs_fist_mode', 0) == 1 )
		|| ( ACS_GetWeaponMode() == 1 && ACS_Settings_Main_Int('acs_combat_main_settings','acs_fist_mode', 0) == 1 )
		|| ( ACS_GetWeaponMode() == 2 && ACS_Settings_Main_Int('acs_combat_main_settings','acs_fist_mode', 0) == 1 )
		|| ( ACS_GetWeaponMode() == 3 && (ACS_GetItem_VampClaw('shades') || ACS_GetItem_VampClaw('default') ) )
		|| ACS_Armor_Set_Check('acs_armor', false)
		)
		{
			CreateFastSprintTrail('red');
		}
		else
		{
			CreateFastSprintTrail('white');
		}

		thePlayer.RaiseEvent('ACS_TorsoBendLock');

		RemoveTimer('ACS_ResetAnimation');

		fast_sprint_activated = true;
	}

	function CreateFastSprintTrail( color : name )
	{
		var boneNames										: array<CName>;
		var boneIndex, i									: int;
		var boneRotation									: EulerAngles;
		var bonePosition									: Vector;
		var trail_ent                  						: CEntity;

		ACSGetCEntityDestroyAll('ACS_Player_Fast_Sprint_Trail');

		boneNames.Clear();

		boneNames.PushBack('torso');
		boneNames.PushBack('torso2');
		//boneNames.PushBack('head');
		boneNames.PushBack('l_shoulder');
		boneNames.PushBack('l_forearm');
		boneNames.PushBack('l_hand');
		boneNames.PushBack('r_shoulder');
		boneNames.PushBack('r_forearm');
		boneNames.PushBack('r_hand');
		boneNames.PushBack('l_thigh');
		boneNames.PushBack('l_kneeRoll');
		boneNames.PushBack('l_foot');
		boneNames.PushBack('r_thigh');
		boneNames.PushBack('r_kneeRoll');
		boneNames.PushBack('r_foot');

		for( i = 0; i < boneNames.Size(); i += 1 )
		{
			boneIndex = thePlayer.GetBoneIndex( boneNames[i] );	

			thePlayer.GetBoneWorldPositionAndRotationByIndex( boneIndex, bonePosition, boneRotation );

			trail_ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

			"dlc\dlc_acs\data\fx\body_trail.w2ent"

			, true ), GetWitcherPlayer().GetWorldPosition(), GetWitcherPlayer().GetWorldRotation() );

			trail_ent.CreateAttachmentAtBoneWS(thePlayer, boneNames[i], bonePosition, boneRotation );

			if (color == 'red')
			{
				trail_ent.PlayEffect('trails_red');

				trail_ent.PlayEffect('trails2_red');
				trail_ent.StopEffect('trails2_red');
			}
			else if (color == 'black')
			{
				trail_ent.PlayEffect('trails_black');
			}
			else
			{
				trail_ent.PlayEffect('trails_white');

				//trail_ent.PlayEffect('trails2_white');
			}

			trail_ent.AddTag('ACS_Player_Fast_Sprint_Trail');
		}
	}

	function CreateHorseFastSprintTrail( color : name )
	{
		var boneNames										: array<CName>;
		var boneIndex, i									: int;
		var boneRotation									: EulerAngles;
		var bonePosition									: Vector;
		var trail_ent                  						: CEntity;

		ACSGetCEntityDestroyAll('ACS_Horse_Fast_Sprint_Trail');

		boneNames.Clear();

		boneNames.PushBack('pelvis');
		
		boneNames.PushBack('l_thigh');
		boneNames.PushBack('r_thigh');
		boneNames.PushBack('l_shoulder');
		boneNames.PushBack('r_shoulder');

		boneNames.PushBack('r_f_hoof');
		boneNames.PushBack('l_f_hoof');

		boneNames.PushBack('r_b_hoof');
		boneNames.PushBack('l_b_hoof');

		boneNames.PushBack('r_forearm');
		boneNames.PushBack('l_forearm');

		boneNames.PushBack('tail1');
		boneNames.PushBack('tail2');
		boneNames.PushBack('tail3');
		boneNames.PushBack('tail4');
		boneNames.PushBack('tail5');
		boneNames.PushBack('tail6');
		boneNames.PushBack('tail7');
		boneNames.PushBack('tail8');
		boneNames.PushBack('tail9');

		for( i = 0; i < boneNames.Size(); i += 1 )
		{
			boneIndex = (thePlayer.GetHorseCurrentlyMounted()).GetBoneIndex( boneNames[i] );	

			(thePlayer.GetHorseCurrentlyMounted()).GetBoneWorldPositionAndRotationByIndex( boneIndex, bonePosition, boneRotation );

			trail_ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

			"dlc\dlc_acs\data\fx\body_trail.w2ent"

			, true ), (thePlayer.GetHorseCurrentlyMounted()).GetWorldPosition(), (thePlayer.GetHorseCurrentlyMounted()).GetWorldRotation() );

			trail_ent.CreateAttachmentAtBoneWS((thePlayer.GetHorseCurrentlyMounted()), boneNames[i], bonePosition, boneRotation );

			if (color == 'red')
			{
				trail_ent.PlayEffect('trails_red');

				trail_ent.PlayEffect('trails2_red');
				trail_ent.StopEffect('trails2_red');
			}
			else
			{
				trail_ent.PlayEffect('trails_white');

				//trail_ent.PlayEffect('trails2_white');
			}

			trail_ent.AddTag('ACS_Horse_Fast_Sprint_Trail');
		}
	}

	var torso_bend_cooldown : float;

	function SprintAdditiveDelay()
	{
		if( 
		theGame.IsDialogOrCutscenePlaying() 
		|| !thePlayer.IsAlive()
		|| thePlayer.IsInCutsceneIntro()
		|| theGame.HasBlackscreenRequested()
		|| theGame.IsCurrentlyPlayingNonGameplayScene()
		|| theGame.GetGuiManager().IsAnyMenu()
		|| theGame.GetTutorialSystem().HasActiveTutorial()
		|| theGame.GetPhotomodeEnabled() 
		|| theGame.IsFading()
		|| theGame.IsBlackscreen()
		)
		{
			if (FactsQuerySum("ACS_TorsoBendActive") > 0)
			{
				if (!fast_sprint_activated)
				{
					thePlayer.RaiseEvent('ACS_TorsoBendReset');
				}
				
				FactsRemove("ACS_TorsoBendActive");
			}
			
			return;
		}

		if(thePlayer.GetIsSprinting() 
		&& (thePlayer.IsActionAllowed( EIAB_RunAndSprint ) || thePlayer.IsActionAllowed( EIAB_Sprint ))
		&& thePlayer.GetSprintingTime() > 1
		&& thePlayer.substateManager.GetStateTimeF() > 3
		&& thePlayer.GetMovingAgentComponent().GetSpeed() > 3 
		&& thePlayer.terrainPitch > 85
		)
		{
			if (theGame.GetEngineTimeAsSeconds() - torso_bend_cooldown > 5)
			{
				torso_bend_cooldown = theGame.GetEngineTimeAsSeconds();

				if ( FactsQuerySum("ACS_TorsoBendActive") <= 0 )
				{
					if (!fast_sprint_activated)
					{
						thePlayer.RaiseEvent('ACS_TorsoBendSlow');
					}

					FactsAdd("ACS_TorsoBendActive", 1, -1);
				}
			}
		}
		else
		{
			if (FactsQuerySum("ACS_TorsoBendActive") > 0)
			{
				if (!fast_sprint_activated)
				{
					thePlayer.RaiseEvent('ACS_TorsoBendReset');
				}
				
				FactsRemove("ACS_TorsoBendActive");
			}
		}
	}

	event OnCbtAttackLight( action : SInputAction )
	{
		var allowed, checkedFists 			: bool;

		if ( thePlayer.inv.IsItemCrossbow( thePlayer.inv.GetItemFromSlot( 'l_weapon' ) ) )
		{
			thePlayer.OnRangedForceHolster(false, true, false);
		}

		if (FactsQuerySum("acs_transformation_activated") > 0)
		{
			if( IsPressed(action) )
			{
				ACS_ExplorationDelayHack(false, 3);

				if( thePlayer.IsActionAllowed(EIAB_LightAttacks)  )
				{
					if (FactsQuerySum("acs_wolven_curse_activated") > 0)
					{
						ACS_Transformation_Werewolf_Light_Attacks();
					}

					if (FactsQuerySum("acs_vampireess_transformation_activated") > 0)
					{
						if (!ACSGetCActor('ACS_Transformation_Vampiress').HasTag('ACS_Vampiress_Sorceress_Mode'))
						{
							ACS_Transformation_Vampiress_Light_Attacks_Melee();
						}
						else
						{
							ACS_Transformation_Vampiress_Light_Attacks_Ranged();
						}
					}

					if (FactsQuerySum("acs_vampire_monster_transformation_activated") > 0)
					{
						if (ACSGetCActor('ACS_Transformation_Vampire_Monster').HasTag('ACS_Vampire_Monster_Ground_Mode'))
						{
							ACS_Transformation_Vampire_Monster_Light_Attacks_Ground();
						}
						else
						{
							ACS_Transformation_Vampire_Monster_Light_Attacks_Air();
						}
					}

					if (FactsQuerySum("acs_toad_transformation_activated") > 0)
					{
						ACS_Transformation_Toad_Light_Attacks();
					}

					if (FactsQuerySum("acs_red_miasmal_curse_activated") > 0)
					{
						ACS_Transformation_Red_Miasmal_Light_Attacks();
					}

					if (FactsQuerySum("acs_sharley_curse_activated") > 0)
					{
						ACS_Transformation_Sharley_Light_Attacks();
					}

					if (FactsQuerySum("acs_black_wolf_curse_activated") > 0)
					{
						ACS_Transformation_Black_Wolf_Light_Attacks();
					}

					if (FactsQuerySum("acs_giant_curse_activated") > 0&& !ACSGetCActor('ACS_Transformation_Giant').HasTag('ACS_Transformation_Giant_Block_All_Actions'))
					{
						ACS_Transformation_Giant_Light_Attacks();
					}

				}
			}

			return false;
		}
		
		if (theInput.GetActionValue('ControllerCastModifier') > 0.5)
		return false;

		if ( IsReleased( action )  )
		{
			RemoveTimer('SpearAttackRepeatWhirl');
			thePlayer.CancelHoldAttacks();
			return true;
		}

		if( IsPressed(action) )
		{
			if(theGame.GetInGameConfigWrapper().GetVarValue('Gameplay', 'EnableAlternateSignCasting') == "1")
			{
				altSignCasting = true;
			}	
			else
			{
				altSignCasting = false;
			}

			if(altSignCasting 
			&& !theInput.LastUsedPCInput() && theInput.GetActionValue('CastSign') > 0.1f && !GetWitcherPlayer().IsCurrentSignChanneled())
			{
				
				if (ACS_Settings_Main_Bool('acs_signs_settings','acs_alternate_quickcasting_controls_enabled', false))
				{
					return false;
				}

				AltCastSign(ST_Axii);
				return false;
			}


			if( thePlayer.IsActionAllowed(EIAB_LightAttacks)  )
			{
				if (thePlayer.GetBIsInputAllowed())
				{
					allowed = false;					
					
					if( thePlayer.GetCurrentMeleeWeaponType() == PW_Fists || thePlayer.GetCurrentMeleeWeaponType() == PW_None )
					{
						checkedFists = true;
						if(thePlayer.IsActionAllowed(EIAB_Fists))
							allowed = true;
					}
					else if(thePlayer.IsActionAllowed(EIAB_SwordAttack))
					{
						checkedFists = false;
						allowed = true;
					}
					
					if(allowed)
					{
						Rage_Counter_Manager(3);

						ACSGetCEntity('ACS_Quen_Bubble').Destroy();
		
						ACSGetCEntity('ACS_Quen_Fx').Destroy();

						ACSGetCEntity('ACS_Sign_Icon').Destroy();

						ACSGetCEntity('ACS_Sign_Icon_Anchor').Destroy();

						if ( ACS_Settings_Main_Bool('acs_main_settings','acs_mod_enabled', true)) 
						{
							if( checkedFists)
							{
								FistAttackSwitch(); //ACS
							}
							else
							{
								LightAttackSwitch(); //ACS
							}
						}
						else
						{
							thePlayer.SetupCombatAction( EBAT_LightAttack, BS_Pressed );
						}
					}
					else
					{
						if(checkedFists)
							thePlayer.DisplayActionDisallowedHudMessage(EIAB_Fists);
						else
							thePlayer.DisplayActionDisallowedHudMessage(EIAB_SwordAttack);
					}
				}
			}
			else  if ( !thePlayer.IsActionBlockedBy(EIAB_LightAttacks,'interaction') )
			{
				thePlayer.DisplayActionDisallowedHudMessage(EIAB_LightAttacks);
			}
		}
	}

	event OnCbtSpecialAttackLight( action : SInputAction )
	{
		if ( thePlayer.inv.IsItemCrossbow( thePlayer.inv.GetItemFromSlot( 'l_weapon' ) ) )
		{
			thePlayer.OnRangedForceHolster(false, true, false);
		}

		if (FactsQuerySum("acs_transformation_activated") > 0)
		{
			if( IsPressed(action) )
			{
				ACS_ExplorationDelayHack(false, 3);

				if( thePlayer.IsActionAllowed(EIAB_LightAttacks)  )
				{
					if (thePlayer.GetBIsInputAllowed())
					{
						if (FactsQuerySum("acs_wolven_curse_activated") > 0)
						{
							ACS_Transformation_Werewolf_Special_Light_Attacks();
						}

						if (FactsQuerySum("acs_vampireess_transformation_activated") > 0)
						{
							if (!ACSGetCActor('ACS_Transformation_Vampiress').HasTag('ACS_Vampiress_Sorceress_Mode'))
							{
								ACS_Transformation_Vampiress_Special_Light_Attacks_Melee();
							}
							else
							{
								ACS_Transformation_Vampiress_Special_Light_Attacks_Ranged();
							}
						}

						if (FactsQuerySum("acs_vampire_monster_transformation_activated") > 0)
						{
							if (ACSGetCActor('ACS_Transformation_Vampire_Monster').HasTag('ACS_Vampire_Monster_Ground_Mode'))
							{
								ACS_Transformation_Vampire_Monster_Special_Light_Attack_Ground();
							}
							else
							{
								ACS_Transformation_Vampire_Monster_Special_Light_Attack_Air();
							}
						}

						if (FactsQuerySum("acs_toad_transformation_activated") > 0)
						{
							ACS_Transformation_Toad_Special_Attack();
						}

						if (FactsQuerySum("acs_red_miasmal_curse_activated") > 0)
						{
							ACS_Transformation_Red_Miasmal_Special_Attack_Pressed();
						}

						if (FactsQuerySum("acs_sharley_curse_activated") > 0)
						{
							ACS_Transformation_Sharley_Special_Attack_Pressed();
						}

						if (FactsQuerySum("acs_black_wolf_curse_activated") > 0)
						{
							ACS_Transformation_Black_Wolf_Special_Attack();
						}

						if (FactsQuerySum("acs_giant_curse_activated") > 0&& !ACSGetCActor('ACS_Transformation_Giant').HasTag('ACS_Transformation_Giant_Block_All_Actions'))
						{
							ACS_Transformation_Giant_Special_Attacks();
						}
						
					}
				}
			}

			if ( IsReleased( action )  )
			{
				if (FactsQuerySum("acs_red_miasmal_curse_activated") > 0)
				{
					ACS_Transformation_Red_Miasmal_Special_Attack_Released();
				}

				if (FactsQuerySum("acs_sharley_curse_activated") > 0)
				{
					ACS_Transformation_Sharley_Special_Attack_Released();
				}
			}

			return false;
		}

		if (FactsQuerySum("ACS_Slayer_Active") > 0 || FactsQuerySum("ACS_Azkar_Active") > 0)
		{
			return false;	
		}
		
		if (theInput.GetActionValue('ControllerCastModifier') > 0.5)
		return false;

		if(!theInput.LastUsedPCInput() && IsPressed( action ) && theInput.GetActionValue( 'CastSign' ) > 0)
		{
			return false;
		}
			
		if ( IsReleased( action )  )
		{
			RemoveTimer('SpearAttackRepeatWhirl');
			thePlayer.CancelHoldAttacks();
			return true;
		}

		if (ACS_Is_DLC_Installed('dlc_spectre') && IsPressed( action ))
		{
			if (thePlayer.HasTag('spectre_whirl_cooldown_active'))
			{
				return false;
			}
		}
		
		if ( !IsPlayerAbleToPerformSpecialAttack() )
			return false;
		
		if( !thePlayer.IsActionAllowed(EIAB_LightAttacks) ) 
		{
			thePlayer.DisplayActionDisallowedHudMessage(EIAB_LightAttacks);
			return false;
		}
		if(!thePlayer.IsActionAllowed(EIAB_SpecialAttackLight) )
		{
			thePlayer.DisplayActionDisallowedHudMessage(EIAB_SpecialAttackLight);
			return false;
		}

		if (thePlayer.HasTag('ACS_IsSwordWalking'))
		{
			thePlayer.RemoveTag('ACS_IsSwordWalking');
		}

		SwordWalkAdditiveEnd(action);
		
		if( IsPressed(action) )	
		{
			if ( thePlayer.CanUseSkill(S_Sword_s01) )
			{
				if ( ACS_Settings_Main_Bool('acs_main_settings','acs_mod_enabled', true) ) 
				{ 
					SpecialAttackSwitch(); //ACS
				} 
				else
				{
					thePlayer.PrepareToAttack();
					thePlayer.SetPlayedSpecialAttackMissingResourceSound(false);
					thePlayer.AddTimer( 'IsSpecialLightAttackInputHeld', 0.00001 , true );
				}
			}
		}
	}

	private var vampiressEquippedSpecialNum 		: int;

	default vampiressEquippedSpecialNum 			= 1;

	function VampiressSpecialAbilityEffectsSwitch()
	{
		ACSGetCActor('ACS_Transformation_Vampiress').StopEffect('special_ability_01');
		ACSGetCActor('ACS_Transformation_Vampiress').StopEffect('special_ability_02');
		ACSGetCActor('ACS_Transformation_Vampiress').StopEffect('special_ability_03');
		ACSGetCActor('ACS_Transformation_Vampiress').StopEffect('special_ability_04');
		ACSGetCActor('ACS_Transformation_Vampiress').StopEffect('special_ability_05');
		ACSGetCActor('ACS_Transformation_Vampiress').StopEffect('special_ability_06');
		ACSGetCActor('ACS_Transformation_Vampiress').StopEffect('special_ability_07');
		ACSGetCActor('ACS_Transformation_Vampiress').StopEffect('special_ability_08');

		if (GetVampiressEquippedSpecial() == 1)
		{
			ACSGetCActor('ACS_Transformation_Vampiress').PlayEffectSingle('special_ability_01');
		}
		else if (GetVampiressEquippedSpecial() == 2)
		{
			ACSGetCActor('ACS_Transformation_Vampiress').PlayEffectSingle('special_ability_02');
		}
		else if (GetVampiressEquippedSpecial() == 3)
		{
			ACSGetCActor('ACS_Transformation_Vampiress').PlayEffectSingle('special_ability_03');
		}
		else if (GetVampiressEquippedSpecial() == 4)
		{
			ACSGetCActor('ACS_Transformation_Vampiress').PlayEffectSingle('special_ability_04');
		}
		else if (GetVampiressEquippedSpecial() == 5)
		{
			ACSGetCActor('ACS_Transformation_Vampiress').PlayEffectSingle('special_ability_05');
		}
		else if (GetVampiressEquippedSpecial() == 6)
		{
			ACSGetCActor('ACS_Transformation_Vampiress').PlayEffectSingle('special_ability_06');
		}
		else if (GetVampiressEquippedSpecial() == 7)
		{
			ACSGetCActor('ACS_Transformation_Vampiress').PlayEffectSingle('special_ability_07');
		}
		else if (GetVampiressEquippedSpecial() == 8)
		{
			ACSGetCActor('ACS_Transformation_Vampiress').PlayEffectSingle('special_ability_08');
		}
	}

	function GetVampiressEquippedSpecial() : int
	{
		return vampiressEquippedSpecialNum;
	}

	function ACS_Transformation_Vampiress_CycleSelectSpecial( bIsCyclingLeft : bool ) : int
	{
		var signOrder : array<int>;
		var i : int;
		
		signOrder.PushBack( 1 );
		signOrder.PushBack( 2 );
		signOrder.PushBack( 3 );
		signOrder.PushBack( 4 );
		signOrder.PushBack( 5 );
		signOrder.PushBack( 6 );
		signOrder.PushBack( 7 );
		//signOrder.PushBack( 8 );
			
		for( i = 0; i < signOrder.Size(); i += 1 )
			if( signOrder[i] == vampiressEquippedSpecialNum )
				break;
		
		if(bIsCyclingLeft)
			return signOrder[ (6 + i) % 7 ];	
		else
			return signOrder[ (8 + i) % 7 ];
	}

	public timer function ACS_Vampiress_Hand_Fx_Restart ( dt : float, id : int)
	{ 
		ACSGetCActor('ACS_Transformation_Vampiress').PlayEffectSingle('hand_fx');

		ACSGetCActor('ACS_Transformation_Vampiress').PlayEffectSingle('hand_fx_l');
	}

	private var vampiress_taunt_index_1																											: int;
	default vampiress_taunt_index_1 																											= -1;

	private var previous_vampiress_taunt_index_1																								: int;
	default previous_vampiress_taunt_index_1 																									= -1;

	function ACS_Transformation_Vampiress_Sorceress_Taunt()
	{
		vampiress_taunt_index_1 = RandDifferent(this.previous_vampiress_taunt_index_1 , 3);

		switch (vampiress_taunt_index_1) 
		{	
			case 2:
			if (RandF() < 0.5)
			{
				ACSTransformVampiressPlayAnim( 'woman_sorceress_taunt_03_rp', 0.25f, 0.325f);
			}
			else
			{
				ACSTransformVampiressPlayAnim( 'woman_sorceress_taunt_03_lp', 0.25f, 0.325f);
			}
			break;
			
			case 1:
			if (RandF() < 0.5)
			{
				ACSTransformVampiressPlayAnim( 'woman_sorceress_taunt_02_rp', 0.25f, 0.325f);
			}
			else
			{
				ACSTransformVampiressPlayAnim( 'woman_sorceress_taunt_02_lp', 0.25f, 0.325f);
			}
			break;
			
			default:
			if (RandF() < 0.5)
			{
				ACSTransformVampiressPlayAnim( 'woman_sorceress_taunt_01_rp', 0.25f, 0.325f);
			}
			else
			{
				ACSTransformVampiressPlayAnim( 'woman_sorceress_taunt_01_lp', 0.25f, 0.325f);
			}
			break;
		}

		this.previous_vampiress_taunt_index_1 = vampiress_taunt_index_1;
	}

	function ACS_Transformation_Vampiress_Hand_FX_Refresh()
	{
		ACS_Transformation_Vampiress_Sorceress_Taunt();

		thePlayer.SoundEvent("magic_triss_q303_power");
		thePlayer.SoundEvent("magic_triss_q303_kill");
		thePlayer.SoundEvent("magic_triss_q303_power");
		thePlayer.SoundEvent("magic_triss_q303_kill");
		thePlayer.SoundEvent("magic_triss_q303_power");
		thePlayer.SoundEvent("magic_triss_q303_kill");

		ACSGetCActor('ACS_Transformation_Vampiress').StopEffect('hand_fx');

		ACSGetCActor('ACS_Transformation_Vampiress').StopEffect('hand_fx_l');

		RemoveTimer('ACS_Vampiress_Hand_Fx_Restart');
		AddTimer('ACS_Vampiress_Hand_Fx_Restart', 1.5 , false);
	}

	function ACS_Transformation_Vampiress_Toggle_Next_Special()
	{
		ACS_Transformation_Vampiress_SetSpecial(ACS_Transformation_Vampiress_CycleSelectSpecial( true ));

		VampiressSpecialAbilityEffectsSwitch();
	}
	
	function ACS_Transformation_Vampiress_Toggle_Previous_Special()
	{
		ACS_Transformation_Vampiress_SetSpecial(ACS_Transformation_Vampiress_CycleSelectSpecial( false ));

		VampiressSpecialAbilityEffectsSwitch();
	}

	function ACS_Transformation_Vampiress_SetSpecial( special_num : int )
	{
		vampiressEquippedSpecialNum = special_num;
	}

	function ACS_Deal_Damage_To_Abduction_Victim()
	{
		var dmg																		: W3DamageAction;
		var projDMG																	: float;

		if (ACSGetCActor('ACS_Transformation_Vampire_Abduction_Victim').UsesVitality()) 
		{ 
			if ( ACSGetCActor('ACS_Transformation_Vampire_Abduction_Victim').GetStat( BCS_Vitality ) >= ACSGetCActor('ACS_Transformation_Vampire_Abduction_Victim').GetStatMax( BCS_Vitality ) * 0.25 )
			{
				projDMG = ACSGetCActor('ACS_Transformation_Vampire_Abduction_Victim').GetStat( BCS_Vitality ) * 0.125; 
			}
			else if ( ACSGetCActor('ACS_Transformation_Vampire_Abduction_Victim').GetStat( BCS_Vitality ) < ACSGetCActor('ACS_Transformation_Vampire_Abduction_Victim').GetStatMax( BCS_Vitality ) * 0.25 )
			{
				projDMG = ( ACSGetCActor('ACS_Transformation_Vampire_Abduction_Victim').GetStatMax( BCS_Vitality ) - ACSGetCActor('ACS_Transformation_Vampire_Abduction_Victim').GetStat( BCS_Vitality ) ) * 0.125; 
			}
		} 
		else if (ACSGetCActor('ACS_Transformation_Vampire_Abduction_Victim').UsesEssence()) 
		{ 
			if (((CMovingPhysicalAgentComponent)(ACSGetCActor('ACS_Transformation_Vampire_Abduction_Victim').GetMovingAgentComponent())).GetCapsuleHeight() >= 2
			|| ACSGetCActor('ACS_Transformation_Vampire_Abduction_Victim').GetRadius() >= 0.7
			|| ACSGetCActor('ACS_Transformation_Vampire_Abduction_Victim').HasAbility('Boss')
			|| ACSGetCActor('ACS_Transformation_Vampire_Abduction_Victim').HasTag('IsBoss')
			|| ACSGetCActor('ACS_Transformation_Vampire_Abduction_Victim').HasTag('ACS_Big_Boi')
			)
			{
				if ( ACSGetCActor('ACS_Transformation_Vampire_Abduction_Victim').GetStat( BCS_Essence ) >= ACSGetCActor('ACS_Transformation_Vampire_Abduction_Victim').GetStatMax( BCS_Essence ) * 0.25 )
				{
					projDMG = ACSGetCActor('ACS_Transformation_Vampire_Abduction_Victim').GetStat( BCS_Essence ) * 0.06125; 
				}
				else if ( ACSGetCActor('ACS_Transformation_Vampire_Abduction_Victim').GetStat( BCS_Essence ) < ACSGetCActor('ACS_Transformation_Vampire_Abduction_Victim').GetStatMax( BCS_Essence ) * 0.25 )
				{
					projDMG = ( ACSGetCActor('ACS_Transformation_Vampire_Abduction_Victim').GetStatMax( BCS_Essence ) - ACSGetCActor('ACS_Transformation_Vampire_Abduction_Victim').GetStat( BCS_Essence ) ) * 0.06125; 
				}
			}
			else
			{
				if ( ACSGetCActor('ACS_Transformation_Vampire_Abduction_Victim').GetStat( BCS_Essence ) >= ACSGetCActor('ACS_Transformation_Vampire_Abduction_Victim').GetStatMax( BCS_Essence ) * 0.25 )
				{
					projDMG = ACSGetCActor('ACS_Transformation_Vampire_Abduction_Victim').GetStat( BCS_Essence ) * 0.125; 
				}
				else if ( ACSGetCActor('ACS_Transformation_Vampire_Abduction_Victim').GetStat( BCS_Essence ) < ACSGetCActor('ACS_Transformation_Vampire_Abduction_Victim').GetStatMax( BCS_Essence ) * 0.25 )
				{
					projDMG = ( ACSGetCActor('ACS_Transformation_Vampire_Abduction_Victim').GetStatMax( BCS_Essence ) - ACSGetCActor('ACS_Transformation_Vampire_Abduction_Victim').GetStat( BCS_Essence ) ) * 0.125; 
				}
			}
		}

		if (ACSGetCActor('ACS_Transformation_Vampire_Abduction_Victim').UsesVitality()) 
		{
			if (ACSGetCActor('ACS_Transformation_Vampire_Abduction_Victim').GetStat(BCS_Vitality) > ACSGetCActor('ACS_Transformation_Vampire_Abduction_Victim').GetStatMax(BCS_Vitality) * 0.1) 
			{
				ACSGetCActor('ACS_Transformation_Vampire_Abduction_Victim').DrainVitality(projDMG);
			}
			else
			{
				dmg =  new W3DamageAction in this;

				dmg.Initialize(GetWitcherPlayer(), ACSGetCActor('ACS_Transformation_Vampire_Abduction_Victim'), GetWitcherPlayer(), GetWitcherPlayer().GetName(), EHRT_None, CPS_Undefined, false, false, true, false);

				dmg.AddDamage( theGame.params.DAMAGE_NAME_DIRECT, 9999 );

				dmg.SetHitAnimationPlayType(EAHA_ForceNo);

				dmg.SetSuppressHitSounds(false);

				dmg.SetForceExplosionDismemberment();

				
				
				dmg.SetCriticalHit(); theGame.damageMgr.ProcessAction( dmg );
				
				delete dmg;
			}
		}
		else if (ACSGetCActor('ACS_Transformation_Vampire_Abduction_Victim').UsesEssence()) 
		{
			if (ACSGetCActor('ACS_Transformation_Vampire_Abduction_Victim').GetStat(BCS_Essence) > ACSGetCActor('ACS_Transformation_Vampire_Abduction_Victim').GetStatMax(BCS_Essence) * 0.1) 
			{
				ACSGetCActor('ACS_Transformation_Vampire_Abduction_Victim').DrainEssence(projDMG);
			}
			else
			{
				dmg =  new W3DamageAction in this;

				dmg.Initialize(GetWitcherPlayer(), ACSGetCActor('ACS_Transformation_Vampire_Abduction_Victim'), GetWitcherPlayer(), GetWitcherPlayer().GetName(), EHRT_None, CPS_Undefined, false, false, true, false);

				dmg.AddDamage( theGame.params.DAMAGE_NAME_DIRECT, 9999 );

				dmg.SetHitAnimationPlayType(EAHA_ForceNo);

				dmg.SetSuppressHitSounds(false);

				dmg.SetForceExplosionDismemberment();

				
				
				dmg.SetCriticalHit(); theGame.damageMgr.ProcessAction( dmg );
				
				delete dmg;
			}
		}

		if (ACSGetCActor('ACS_Transformation_Vampire_Abduction_Victim'))
		{
			thePlayer.GainStat( BCS_Vitality, thePlayer.GetCurrentHealth() * 0.06 );

			ShowHealFloatingValue(thePlayer.GetCurrentHealth() * 0.06, true);
		}
	}

	var currspeed : int;
	default currspeed = 0;

	function CycleLocomotionSpeed( bIsCyclingLeft : bool ) : int
	{
		var speed : array<int>;
		var i : int;
		
		speed.PushBack( 0 );
		speed.PushBack( 1 );
		speed.PushBack( 2 );
		speed.PushBack( 3 );
		speed.PushBack( 4 );

		for( i = 0; i < speed.Size(); i += 1 )
			if( speed[i] == currspeed )
				break;
		
		if(bIsCyclingLeft)
			return speed[ (4 + i) % 5 ];	
		else
			return speed[ (6 + i) % 5 ];
	}

	function CycleTargets( bIsCyclingLeft : bool )
	{
		var targets 		: array<CActor>;
		var i 				: int;
		var curTarget		: CActor;

		if ( thePlayer.IsActionAllowed(EIAB_HardLock) && thePlayer.IsHardLockEnabled() && ( thePlayer.IsThreatened() || thePlayer.IsActorLockedToTarget() ) )
		{
			curTarget = thePlayer.GetTarget();
			targets = thePlayer.GetMoveTargets();
			
			if ( targets.Size() > 0 )
			{
				for( i = 0; i < targets.Size(); i += 1 )
					if( targets[i] == curTarget )
						break;
				
				if(bIsCyclingLeft)
				{
					curTarget = targets[ ((targets.Size()-1) + i) % targets.Size() ];
				}
				else
				{
					curTarget = targets[ ((targets.Size()+1) + i) % targets.Size() ];
				}

				thePlayer.HardLockToTarget(false);
				thePlayer.ProcessLockTarget(curTarget);
				thePlayer.HardLockToTarget(true);
			}
		}
	}

	var last_stance_cycle_refresh_time : float;

	var last_sign_switch_arsenal_refresh_time : float;

	var last_sign_switch_taunt_refresh_time : float;

	function CycleStances(bIsCyclingLeft : bool)
	{
		var ent            																	: CEntity; 

		if( !thePlayer.IsUsingHorse()
		&& !thePlayer.IsUsingVehicle()
		&& (thePlayer.IsInCombat() || thePlayer.IsThreatened())
		&& (thePlayer.IsGuarded() 
		|| thePlayer.IsInGuardedState() 
		|| theInput.GetActionValue('LockAndGuard') > 0.5 )
		&& (thePlayer.IsWeaponHeld('steelsword') || thePlayer.IsWeaponHeld('silversword'))
		&& theGame.GetEngineTimeAsSeconds() - last_stance_cycle_refresh_time > 1
		&& !thePlayer.IsHardLockEnabled()
		)
		{
			last_stance_cycle_refresh_time = theGame.GetEngineTimeAsSeconds();

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Sword_Stance_Notification");

			ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

			"dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent"

			, true ), thePlayer.GetWorldPosition() );

			ent.CreateAttachment(thePlayer,'blood_point', Vector(0,0,0));

			ent.DestroyAfter(2);

			vACS_Stance_Switch = new cACS_Stance_Switch in this;

			if (RandF() < 0.5)
			{
				thePlayer.SoundEvent('sprj_katana_iai_00_bb_acs');
			}
			else
			{
				thePlayer.SoundEvent('sprj_katana_iai_01_bb_acs');
			}

			if( thePlayer.IsWeaponHeld( 'steelsword' )
			)
			{
				if (bIsCyclingLeft)
				{
					switch(ACS_Settings_Main_Int('acs_combat_main_settings','acs_steel_silver_moveset_switch', 0))
					{
						case 1:
						case 3:
							if (!silver_strong_stance 
							&& !silver_group_stance
							&& !silver_fast_stance
							)
							{
								ShowSwordStanceNotification(ent,  GetLocStringById(2116581193));

								silver_fast_stance = true;

								vACS_Stance_Switch.ACS_Silver_Fast_Switch_Activate_Engage();
							}
							else if ( !silver_strong_stance 
							&& !silver_group_stance
							&& silver_fast_stance
							)
							{
								ShowSwordStanceNotification(ent,  GetLocStringById(2116581194));

								silver_fast_stance = false;

								silver_group_stance = true;

								vACS_Stance_Switch.ACS_Silver_Group_Switch_Activate_Engage();
							}
							else if ( 
							silver_group_stance 
							&& !silver_strong_stance 
							&& !silver_fast_stance
							)
							{
								ShowSwordStanceNotification(ent,  GetLocStringById(2116581195));

								silver_group_stance = false;

								silver_strong_stance = true;

								vACS_Stance_Switch.ACS_Silver_Strong_Switch_Activate_Engage();
							}
							else if ( 
							silver_strong_stance 
							&& !silver_group_stance 
							&& !silver_fast_stance 
							)
							{
								ShowSwordStanceNotification(ent,  GetLocStringById(2116581198));

								silver_strong_stance = false;

								if (thePlayer.IsInCombat())
								{
									thePlayer.RaiseEvent('ACS_CombatExtraTW1SilverStrongStart');
								}
								else
								{
									RemoveTimer('SwordTauntSwitch'); 
									RemoveTimer('SwordTauntRunningSwitch'); 
									RemoveTimer('CombatTauntDelay');
									RemoveTimer('SwordTauntRunningSwitchSecondary'); 
									RemoveTimer('SwordTauntRunningSwitchSecondaryWeaponBlood'); 
									AddTimer('SwordTauntRunningSwitchSecondary', 0.01 , false); 
								}

								vACS_Stance_Switch.ACS_Stance_Switch_Deactivate_Engage();
							}
						break;

						case 0:
						case 2:
							if (!steel_strong_stance 
							&& !steel_group_stance
							&& !steel_fast_stance
							)
							{
								ShowSwordStanceNotification(ent,  GetLocStringById(2116581193));


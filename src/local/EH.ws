	function ACS_StaminaDrain( i : int, optional forced : bool )
	{
		if (forced || ACS_Settings_Main_Bool('acs_stamina_settings','acs_stamina_cost_action', false))
		{
			switch(i)
			{
				case 6:
					if (ACS_Settings_Main_Float('acs_stamina_settings','acs_azkar_stamina_cost', 0.1) > 0)
					{
						thePlayer.DrainStamina( ESAT_FixedValue,  thePlayer.GetStatMax( BCS_Stamina ) * ACS_Settings_Main_Float('acs_stamina_settings','acs_azkar_stamina_cost', 0.1), ACS_Settings_Main_Float('acs_stamina_settings','acs_azkar_stamina_regen_delay', 2) );
					}
				break;

				case 5:
					if (ACS_Settings_Main_Float('acs_stamina_settings','acs_transformation_action_stamina_cost', 0.1) > 0)
					{
						thePlayer.DrainStamina( ESAT_FixedValue,  thePlayer.GetStatMax( BCS_Stamina ) * ACS_Settings_Main_Float('acs_stamina_settings','acs_transformation_action_stamina_cost', 0.075), ACS_Settings_Main_Float('acs_stamina_settings','acs_transformation_action_stamina_regen_delay', 1) );
					}
				break;

				case 4:
					if (ACS_Settings_Main_Float('acs_stamina_settings','acs_dodge_stamina_cost', 0.1) > 0)
					{
						thePlayer.DrainStamina( ESAT_FixedValue,  thePlayer.GetStatMax( BCS_Stamina ) * ACS_Settings_Main_Float('acs_stamina_settings','acs_dodge_stamina_cost', 0.05), ACS_Settings_Main_Float('acs_stamina_settings','acs_dodge_stamina_regen_delay', 1) );
					}
				break;

				case 3:
					if (ACS_Settings_Main_Float('acs_stamina_settings','acs_special_attack_stamina_cost', 0.1) > 0
					&& !ACS_Is_DLC_Installed('dlc_spectre')
					)
					{
						thePlayer.DrainStamina( ESAT_FixedValue,  thePlayer.GetStatMax( BCS_Stamina ) * ACS_Settings_Main_Float('acs_stamina_settings','acs_special_attack_stamina_cost', 0.15), ACS_Settings_Main_Float('acs_stamina_settings','acs_special_attack_stamina_regen_delay', 1) );
					}
				break;

				case 2:
					if (ACS_Settings_Main_Float('acs_stamina_settings','acs_heavy_attack_stamina_cost', 0.1) > 0
					&& !ACS_Is_DLC_Installed('dlc_spectre')
					)
					{
						thePlayer.DrainStamina( ESAT_FixedValue,  thePlayer.GetStatMax( BCS_Stamina ) * ACS_Settings_Main_Float('acs_stamina_settings','acs_heavy_attack_stamina_cost', 0.1), ACS_Settings_Main_Float('acs_stamina_settings','acs_heavy_attack_stamina_regen_delay', 1) );
					}
				break;

				case 1:
					if (ACS_Settings_Main_Float('acs_stamina_settings','acs_light_attack_stamina_cost', 0.1) > 0
					&& !ACS_Is_DLC_Installed('dlc_spectre')
					)
					{
						thePlayer.DrainStamina( ESAT_FixedValue,  thePlayer.GetStatMax( BCS_Stamina ) * ACS_Settings_Main_Float('acs_stamina_settings','acs_light_attack_stamina_cost', 0.05), ACS_Settings_Main_Float('acs_stamina_settings','acs_light_attack_stamina_regen_delay', 1) );
					}
				break;

				default:
					if (ACS_Settings_Main_Float('acs_stamina_settings','acs_light_attack_stamina_cost', 0.1) > 0
					&& !ACS_Is_DLC_Installed('dlc_spectre')
					)
					{
						thePlayer.DrainStamina( ESAT_FixedValue,  thePlayer.GetStatMax( BCS_Stamina ) * ACS_Settings_Main_Float('acs_stamina_settings','acs_light_attack_stamina_cost', 0.05), ACS_Settings_Main_Float('acs_stamina_settings','acs_light_attack_stamina_regen_delay', 1) );
					}
				break;
			}
		}
	}
	
	

	function taunted_npc_destroy()
	{
		//actors = GetActorsInRange(thePlayer, 10, 10 );

		//actors = GetActorsInRange(thePlayer, 100, 100, 'ACS_taunted' );

		actors.Clear();

		theGame.GetActorsByTag( 'ACS_taunted', actors );

		if( actors.Size() > 0 )
		{
			for( i = 0; i < actors.Size(); i += 1 )
			{
				npc_ANIMATION_CANCEL = (CNewNPC)actors[i];

				npcactor_ANIMATION_CANCEL = (CActor)actors[i];

				if ( npc_ANIMATION_CANCEL == thePlayer || npc_ANIMATION_CANCEL.HasTag('smokeman') )
					continue;
				
				if(
				//npc_ANIMATION_CANCEL.IsHuman()
				//&& ACS_AttitudeCheck( npcactor_ANIMATION_CANCEL )
				//&& thePlayer.IsInCombat()
				ACS_Settings_Main_Bool('acs_taunt_settings','acs_combat_taunt_enabled', false)
				//&& npc_ANIMATION_CANCEL.HasTag('ACS_taunted')
				)
				{	
					npc_ANIMATION_CANCEL.Destroy();
				}
			}
		}
	}

	
	
	function sword_destroy()
	{
		if ( 
			!theGame.IsDialogOrCutscenePlaying() && !thePlayer.IsInCutsceneIntro() )
		{
			if ( !thePlayer.IsAnyWeaponHeld() || thePlayer.IsWeaponHeld('fist') )
			{
				ACS_QuenSwordDestroy(true);

				ACS_AxiiSwordDestroy(true);

				ACS_AardSwordDestroy(true);

				ACS_YrdenSwordDestroy(true);

				ACS_QuenSecondarySwordDestroy(true);

				ACS_AxiiSecondarySwordDestroy(true);

				ACS_AardSecondarySwordDestroy(true);

				ACS_YrdenSecondarySwordDestroy(true);

				ACS_BowDestroy();

				ACS_CrossbowDestroy();

				if (thePlayer.HasTag('ACS_Holster_Sword_Effect'))
				{
					thePlayer.RemoveTag('ACS_Holster_Sword_Effect');
				}
			}
		}
	}

	public timer function ACS_Weapon_Summon_Delay(deltaTime : float , id : int)
	{
		if ( ACS_GetWeaponMode() == 0 
		|| ACS_GetWeaponMode() == 1
		|| ACS_GetWeaponMode() == 2 )
		{
			if (thePlayer.HasTag('acs_quen_sword_equipped'))
			{
				thePlayer.PlayEffectSingle('embers_particles_test');
				thePlayer.StopEffect('embers_particles_test');
				ACSSwordSummonEffect('quen');
			}
			else if (thePlayer.HasTag('acs_axii_sword_equipped'))
			{
				thePlayer.PlayEffectSingle('embers_particles_test');
				thePlayer.StopEffect('embers_particles_test');
				ACSSwordSummonEffect('axii');
			}
			else if (thePlayer.HasTag('acs_aard_sword_equipped'))
			{
				thePlayer.PlayEffectSingle('embers_particles_test');
				thePlayer.StopEffect('embers_particles_test');
				ACSSwordSummonEffect('aard');
			}
			else if (thePlayer.HasTag('acs_yrden_sword_equipped'))
			{
				thePlayer.PlayEffectSingle('embers_particles_test');
				thePlayer.StopEffect('embers_particles_test');
				ACSSwordSummonEffect('yrden');
			}
			else if (thePlayer.HasTag('acs_quen_secondary_sword_equipped'))
			{
				thePlayer.PlayEffectSingle('embers_particles_test');
				thePlayer.StopEffect('embers_particles_test');
				ACSSwordSummonEffect('quen_secondary');
			}
			else if (thePlayer.HasTag('acs_axii_secondary_sword_equipped'))
			{
				thePlayer.PlayEffectSingle('embers_particles_test');
				thePlayer.StopEffect('embers_particles_test');
				ACSSwordSummonEffect('axii_secondary');
			}
			else if (thePlayer.HasTag('acs_aard_secondary_sword_equipped'))
			{
				thePlayer.PlayEffectSingle('embers_particles_test');
				thePlayer.StopEffect('embers_particles_test');
				ACSSwordSummonEffect('aard_secondary');
			}
			else if (thePlayer.HasTag('acs_yrden_secondary_sword_equipped'))
			{
				thePlayer.PlayEffectSingle('embers_particles_test');
				thePlayer.StopEffect('embers_particles_test');
				ACSSwordSummonEffect('yrden_secondary');
			}
			else if (
			thePlayer.HasTag('acs_igni_secondary_sword_equipped')
			|| thePlayer.HasTag('acs_igni_sword_equipped'))
			{
				if (!thePlayer.HasTag('acs_igni_sword_effect_played'))
				{
					thePlayer.PlayEffectSingle('embers_particles_test');
					thePlayer.StopEffect('embers_particles_test');
					ACSSwordSummonEffect('igni');
				}

				if (!thePlayer.HasTag('ACS_HideWeaponOnDodge')
				&& !thePlayer.HasTag('acs_in_wraith')
				&& !thePlayer.HasTag('ACS_Bruxa_Bite_Process')
				&& !ACSGetCEntity('ACS_Armor_Ether_Sword')
				)
				{
					ACSSwordUpdateEnhancements('default_sword');
				}
			}
		}
		else if (ACS_GetWeaponMode() == 3)
		{
			if (thePlayer.HasTag('acs_aard_sword_equipped'))
			{
				thePlayer.PlayEffectSingle('embers_particles_test');
				thePlayer.StopEffect('embers_particles_test');
				ACSSwordSummonEffect('aard');
			}
			else if (
			thePlayer.HasTag('acs_igni_secondary_sword_equipped')
			|| thePlayer.HasTag('acs_igni_sword_equipped'))
			{
				if (!thePlayer.HasTag('ACS_HideWeaponOnDodge')
				&& !thePlayer.HasTag('acs_in_wraith')
				&& !thePlayer.HasTag('ACS_Bruxa_Bite_Process')
				&& !ACSGetCEntity('ACS_Armor_Ether_Sword')
				)
				{
					ACSSwordUpdateEnhancements('default_sword');
				}
			}
		}
	}


					BowShowCrosshair(false);

					RemoveTimer('BowRotateTowardsCamera');

					GetACSStorage().acs_deleteOnelinerByTag("ACS_Bow_Aiming_Target");

					ACSGetCEntity('acs_bow').GetRootAnimatedComponent().PlaySkeletalAnimationAsync( 'man_npc_bow_switch_bow_to_sword' );

					thePlayer.UnblockAction( EIAB_Crossbow, 			'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_CallHorse,			'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_Signs, 				'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_DrawWeapon, 			'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_FastTravel, 			'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_Fists, 				'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_InteractionAction, 	'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_UsableItem,			'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_ThrowBomb,			'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_SwordAttack,			'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_LightAttacks,			'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_HeavyAttacks,			'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_SpecialAttackLight,	'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_SpecialAttackHeavy,	'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_Dodge,				'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_Roll,					'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_Parry,				'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_MeditationWaiting,	'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_OpenMeditation,		'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_RadialMenu,			'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_Movement,				'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_Interactions, 		'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_Jump, 				'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_QuickSlots, 			'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_OpenFastMenu, 		'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_OpenInventory,		'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_OpenPreparation, 		'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_OpenMap, 				'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_OpenCharacterPanel, 	'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_OpenJournal, 			'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_OpenAlchemy, 			'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_OpenGlossary,			'acs_azkar_aiming');

					FactsRemove("ACS_Azkar_Aiming");
				}
			}
		}
		else
		{
			if (FactsQuerySum("ACS_Azkar_Active") > 0)
			{
				if ( FactsQuerySum("ACS_Bow_Quiver_Loaded") > 0 )
				{
					BowQuiverUnload();

					FactsRemove("ACS_Bow_Quiver_Loaded");
				}
				
				if (ACSGetCEntity('acs_bow'))
				{
					AzkarFXCreate();

					ACSGetCEntity('acs_bow').BreakAttachment(); 
					ACSGetCEntity('acs_bow').Teleport( GetWitcherPlayer().GetWorldPosition() + Vector( 0, 0, -200 ) );
					ACSGetCEntity('acs_bow').DestroyAfter(0.00125);
					ACSGetCEntity('acs_bow').RemoveTag('acs_bow');

					DefaultSwitch();
				}

				ACS_BowArrowDestroy();

				if (FactsQuerySum("ACS_Azkar_Aiming") > 0)
				{
					thePlayer.playerAiming.StopAiming();

					BowShowCrosshair(false);

					RemoveTimer('BowRotateTowardsCamera');

					GetACSStorage().acs_deleteOnelinerByTag("ACS_Bow_Aiming_Target");

					ACSGetCEntity('acs_bow').GetRootAnimatedComponent().PlaySkeletalAnimationAsync( 'man_npc_bow_switch_bow_to_sword' );

					thePlayer.UnblockAction( EIAB_Crossbow, 			'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_CallHorse,			'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_Signs, 				'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_DrawWeapon, 			'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_FastTravel, 			'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_Fists, 				'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_InteractionAction, 	'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_UsableItem,			'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_ThrowBomb,			'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_SwordAttack,			'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_LightAttacks,			'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_HeavyAttacks,			'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_SpecialAttackLight,	'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_SpecialAttackHeavy,	'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_Dodge,				'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_Roll,					'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_Parry,				'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_MeditationWaiting,	'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_OpenMeditation,		'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_RadialMenu,			'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_Movement,				'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_Interactions, 		'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_Jump, 				'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_QuickSlots, 			'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_OpenFastMenu, 		'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_OpenInventory,		'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_OpenPreparation, 		'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_OpenMap, 				'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_OpenCharacterPanel, 	'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_OpenJournal, 			'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_OpenAlchemy, 			'acs_azkar_aiming');
					thePlayer.UnblockAction( EIAB_OpenGlossary,			'acs_azkar_aiming');

					FactsRemove("ACS_Azkar_Aiming");
				}

				FactsRemove("ACS_Azkar_Active");
			}
		}

		if ( GetWitcherPlayer().IsItemEquippedByName('ACS_Slayer')
		&& thePlayer.GetInventory().GetItemName( itemId ) == 'ACS_Slayer' 
		)
		{
			if (FactsQuerySum("ACS_Slayer_Active") > 0)
			{
				if (!ACSGetCEntity('acs_crossbow')
				&& thePlayer.IsAnyWeaponHeld()
				&& !thePlayer.IsWeaponHeld('fist')
				)
				{
					SlayerShotgunCreate();

					ACS_RangedWeaponSwitch();
				}
				else
				{
					if(thePlayer.IsInCombat()
					|| thePlayer.IsThreatened()
					)
					{
						if (!thePlayer.HasTag('ACS_Player_Is_Attacking'))
						{
							ShotgunPositioningSwitch('in_combat');
						}
					}
				}
			}
			else
			{
				if (ACSGetCEntity('acs_crossbow'))
				{
					ACSGetCEntity('acs_crossbow').BreakAttachment(); 
					ACSGetCEntity('acs_crossbow').Teleport( GetWitcherPlayer().GetWorldPosition() + Vector( 0, 0, -200 ) );
					ACSGetCEntity('acs_crossbow').DestroyAfter(0.00125);
					ACSGetCEntity('acs_crossbow').RemoveTag('acs_crossbow');

					DefaultSwitch();

					RemoveTimer('ACS_ShootShotgunLight');

					RemoveTimer('ACS_ShootShotgunHeavy');

					RemoveTimer('ACS_ShotgunReload');

					theSound.SoundEvent("scene_cmb_sword_unsheat_fast_2D");

					thePlayer.RaiseEvent('ACS_ShotgunAnimReset');

					thePlayer.RaiseEvent('ACS_SwordTaunt02');
				}
			}
		}
		else
		{
			if (FactsQuerySum("ACS_Slayer_Active") > 0)
			{
				if (ACSGetCEntity('acs_crossbow'))
				{
					ACSGetCEntity('acs_crossbow').BreakAttachment(); 
					ACSGetCEntity('acs_crossbow').Teleport( GetWitcherPlayer().GetWorldPosition() + Vector( 0, 0, -200 ) );
					ACSGetCEntity('acs_crossbow').DestroyAfter(0.00125);
					ACSGetCEntity('acs_crossbow').RemoveTag('acs_crossbow');

					DefaultSwitch();

					RemoveTimer('ACS_ShootShotgunLight');

					RemoveTimer('ACS_ShootShotgunHeavy');

					RemoveTimer('ACS_ShotgunReload');

					theSound.SoundEvent("scene_cmb_sword_unsheat_fast_2D");

					thePlayer.RaiseEvent('ACS_ShotgunAnimReset');

					thePlayer.RaiseEvent('ACS_SwordTaunt02');
				}

				FactsRemove("ACS_Slayer_Active");
			}
		}
	}

	function SetPlayerTargetAcquire()
	{
		var player : CR4Player;
		var distMin, distMax, distInteract : float;

		if (player != thePlayer)
		{
			player = thePlayer;
		}

		if (player.disableSprintTerrainPitch != 0)
		{
			player.disableSprintTerrainPitch = 0;
		}

		if (thePlayer.GetTarget().HasTag('dettlaff_construct'))
		{
			if (player.forceFinisher != true)
			{
				player.forceFinisher = true;
			}

			if (player.forceFinisherChance != 1)
			{
				player.forceFinisherChance = 1;
			}
		}
		else
		{
			if (player.forceFinisher != false)
			{
				player.forceFinisher = false;
			}

			if (player.forceFinisherChance != 0)
			{
				player.forceFinisherChance = 0;
			}
		}

		if (thePlayer.IsUsingVehicle() || thePlayer.IsUsingHorse())
		{
			distMin = 200.f;
			distMax = 200.f;
			distInteract = 200.f;
		}
		else
		{
			if (
			(thePlayer.IsInCombat() || thePlayer.IsCombatMusicEnabled() || thePlayer.IsThreatened())
			&& thePlayer.IsAnyWeaponHeld() && !thePlayer.IsWeaponHeld('fist')
			)
			{
				distMin = ACS_Settings_Main_Float('acs_target_settings','acs_target_distance_min', 50);
				distMax = ACS_Settings_Main_Float('acs_target_settings','acs_target_distance_max', 50);
				distInteract = ACS_Settings_Main_Float('acs_target_settings','acs_target_distance_interaction', 50);
			}
			else
			{
				distMin = 10.f;
				distMax = 18.f;
				distInteract = ACS_Settings_Main_Float('acs_target_settings','acs_target_distance_interaction', 50);
			}
		}

		if (player.findMoveTargetDistMin != distMin )
		{
			player.findMoveTargetDistMin = distMin;
		}
		
		if (player.findMoveTargetDistMax != distMax)
		{
			player.findMoveTargetDistMax = distMax;
		}
			
		if (player.interactDist != distInteract)
		{
			player.interactDist = distInteract;
		}
	}

	function Guiding_Light_Distance_Controller()
	{
		//var component 								: CInteractionComponent;

		//component = theGame.GetInteractionsManager().GetActiveInteraction();

		if ( (theGame.IsDialogOrCutscenePlaying() 
		|| theGame.IsFading()
		|| theGame.IsBlackscreen()
		|| theGame.IsPaused() 
		|| theGame.GetPhotomodeEnabled() 
		|| thePlayer.IsInCutsceneIntro() 
		|| theInput.GetActionValue('Focus') == 0)
		&& ACS_Settings_Main_Bool('acs_hud_settings_markers','acs_guiding_light_distance_marker_show_only_in_witcher_sense_enabled', true)
		//|| theInput.GetActionValue('Interact') > 0.1f
		//|| theInput.GetActionValue('InteractHold') > 0.1f
		//|| component.IsEnabled()
		)
		{
			if (ACS_Guiding_Light_Untracked_Quest_Marker_Distance_Available)
			{
				GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Untracked_Quest_Distance_GUI_Marker", 100);

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Untracked_Quest_Distance_GUI_Marker");

				ACS_Guiding_Light_Untracked_Quest_Marker_Distance_Available = false;
			}

			if (ACS_Guiding_Light_Quest_Marker_Distance_Available)
			{
				GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Quest_Distance_GUI_Marker", 100);

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Quest_Distance_GUI_Marker");

				ACS_Guiding_Light_Quest_Marker_Distance_Available = false;
			}

			if (ACS_Guiding_Light_Horse_Marker_Distance_Available)
			{
				GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Horse_Distance_GUI_Marker", 100);

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Horse_Distance_GUI_Marker");

				ACS_Guiding_Light_Horse_Marker_Distance_Available = false;
			}

			if (ACS_Guiding_Light_POI_Marker_Distance_Available)
			{
				GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_POI_Distance_GUI_Marker", 100);

				GetACSStorage().acs_deleteOnelinerByTag("ACS_POI_Distance_GUI_Marker");

				ACS_Guiding_Light_POI_Marker_Distance_Available = false;
			}

			if (ACS_Guiding_Light_Available_Quest_Marker_Distance_Available)
			{
				GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Available_Quest_Distance_GUI_Marker", 100);

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Available_Quest_Distance_GUI_Marker");

				ACS_Guiding_Light_Available_Quest_Marker_Distance_Available = false;
			}

			if (ACS_Guiding_Light_User_Marker_Distance_Available)
			{
				GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_User_Distance_GUI_Marker", 100);

				GetACSStorage().acs_deleteOnelinerByTag("ACS_User_Distance_GUI_Marker");

				ACS_Guiding_Light_User_Marker_Distance_Available = false;
			}

			if (ACS_Guiding_Light_Enemy_Marker_Distance_Available)
			{
				GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Enemy_Distance_GUI_Marker", 100);

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Enemy_Distance_GUI_Marker");

				ACS_Guiding_Light_Enemy_Marker_Distance_Available = false;
			}

			if (ACS_Guiding_Light_Merchant_Marker_Distance_Available)
			{
				GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Merchant_Distance_GUI_Marker", 100);

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Merchant_Distance_GUI_Marker");

				ACS_Guiding_Light_Merchant_Marker_Distance_Available = false;
			}

			return;
		}

		if (ACS_Guiding_Light_Horse_Marker_Distance_Available)
		{
			ACS_Guiding_Light_Horse_Marker_Distance_Actual();
		}

		if (ACS_Guiding_Light_POI_Marker_Distance_Available)
		{
			ACS_Guiding_Light_POI_Marker_Distance_Actual();
		}

		if (ACS_Guiding_Light_User_Marker_Distance_Available)
		{
			ACS_Guiding_Light_User_Marker_Distance_Actual();
		}

		if (ACS_Guiding_Light_Available_Quest_Marker_Distance_Available)
		{
			ACS_Guiding_Light_Available_Quest_Marker_Distance_Actual();
		}

		if (ACS_Guiding_Light_Untracked_Quest_Marker_Distance_Available)
		{
			ACS_Guiding_Light_Untracked_Marker_Distance_Actual();
		}

		if (ACS_Guiding_Light_Quest_Marker_Distance_Available)
		{
			ACS_Guiding_Light_Quest_Marker_Distance_Actual();
		}

		if (ACS_Guiding_Light_Enemy_Marker_Distance_Available)
		{
			ACS_Guiding_Light_Enemy_Marker_Distance_Actual();
		}

		if(ACS_Guiding_Light_Merchant_Marker_Distance_Available)
		{
			ACS_Guiding_Light_Merchant_Marker_Distance_Actual();
		}
	}

	var last_starfall_time : float;

	function Starfall_Control()
	{
		if (FactsQuerySum("ACS_Darkness_Upon_Us") > 0 
		&& ACS_Settings_Main_Bool('acs_world_visual_settings','acs_spiral_sky_stars_enabled', true))
		{
			if (theGame.GetEngineTimeAsSeconds() - last_starfall_time > RandRangeF(60,36))
			{
				last_starfall_time = theGame.GetEngineTimeAsSeconds();

				if (FactsQuerySum("ACS_Starfall_Active") <= 0)
				{

					FactsAdd("ACS_Starfall_Active", 1, -1);
				}
				else if (FactsQuerySum("ACS_Starfall_Active") > 0)
				{

					FactsRemove("ACS_Starfall_Active");
				}
			}

			if (FactsQuerySum("ACS_Starfall_Active") > 0)
			{
				if (!ACSGetCEntity('acs_spiral_entity').IsEffectActive('meteors', false))
				{
					ACSGetCEntity('acs_spiral_entity').PlayEffectSingle('meteors');
				}
			}
			else
			{
				ACSGetCEntity('acs_spiral_entity').StopEffect('meteors');
			}

			return;
		}
		
		if (ACSGetCEntity('acs_spiral_entity').IsEffectActive('meteors'))
		{
			ACSGetCEntity('acs_spiral_entity').DestroyEffect('meteors');
		}
	}

	function Rainbow_Control()
	{
		var teleportPos : Vector;
		var teleportRot : EulerAngles;

		if (
		FactsQuerySum("ACS_Rainbow_Active") > 0
		&& 
		(
		FactsQuerySum("ACS_Darkness_Upon_Us") > 0
		|| GetWeatherConditionName() == 'WT_Rain_Storm' 
		|| GetWeatherConditionName() == 'WT_Rain_Heavy' 
		|| GetWeatherConditionName() == 'WT_Rain_Dark' 
		)
		)
		{
			ACSGetCEntity('acs_spiral_rainbow_entity').DestroyEffect('rainbow');

			RemoveTimer('RainbowRemove');

			FactsRemove("ACS_Rainbow_Active");

			return;
		}

		if (
		(
		GetWeatherConditionName() == 'WT_Rain_Storm' 
		|| GetWeatherConditionName() == 'WT_Rain_Heavy' 
		|| GetWeatherConditionName() == 'WT_Rain_Dark' 
		)
		)
		{
			if (FactsQuerySum("ACS_Rainbow_Active") > 0)
			{
				ACSGetCEntity('acs_spiral_rainbow_entity').DestroyEffect('rainbow');

				RemoveTimer('RainbowRemove');

				FactsRemove("ACS_Rainbow_Active");
			}

			if ( FactsQuerySum("ACS_Rainbow_Prep") <= 0 )
			{
				FactsAdd("ACS_Rainbow_Prep", 1, -1);
			}
		}
		else
		{
			if (
			FactsQuerySum("ACS_Rainbow_Prep") > 0
			&& !thePlayer.IsInInterior()
			&& FactsQuerySum("ACS_Darkness_Upon_Us") <= 0
			)
			{
				if ( FactsQuerySum("ACS_Rainbow_Active") <= 0 )
				{
					if (!ACSGetCEntity('acs_spiral_rainbow_entity').IsEffectActive('rainbow', false))
					{
						ACSGetCEntity('acs_spiral_rainbow_entity').PlayEffectSingle('rainbow');
					}

					teleportPos = ACSFixZAxis(theCamera.GetCameraPosition() + VecFromHeading(theCamera.GetCameraHeading()) *  RandRangeF(750, 250));

					teleportRot = thePlayer.GetWorldRotation();

					teleportRot.Yaw += RandRangeF( 135, 90 );

					ACSGetCEntity('acs_spiral_rainbow_entity').TeleportWithRotation(teleportPos, teleportRot);

					RemoveTimer('RainbowRemove');
					AddTimer('RainbowRemove', 300 , false);

					FactsAdd("ACS_Rainbow_Active", 1, -1);

					FactsRemove("ACS_Rainbow_Prep");
				}
			}
		}
	}

	timer function RainbowRemove ( dt : float, id : int )
	{
		ACSGetCEntity('acs_spiral_rainbow_entity').DestroyEffect('rainbow');

		if (FactsQuerySum("ACS_Rainbow_Active") > 0)
		{
			FactsRemove("ACS_Rainbow_Active");
		}
	}

	var last_horse_follow_target_novigrad_teleport_time : float;

	var last_horse_follow_target_nilfgaard_teleport_time : float;

	var last_horse_follow_target_redania_teleport_time : float;

	function HorseRiderFollowTargetTeleport()
	{
		var novigrad_pos1, novigrad_pos2, novigrad_pos3													: Vector;

		var nilfgaard_pos1, nilfgaard_pos2, nilfgaard_pos3												: Vector;

		var redania_pos1, redania_pos2, redania_pos3													: Vector;

		if (ACSGetCActor('ACS_Horse_Rider_Follow_Target_Novigrad_Tag'))
		{
			if (theGame.GetEngineTimeAsSeconds() - last_horse_follow_target_novigrad_teleport_time > 120)
			{
				last_horse_follow_target_novigrad_teleport_time = theGame.GetEngineTimeAsSeconds();

				if (theGame.GetWorld().GetDepotPath() == "levels\novigrad\novigrad.w2w")
				{
					novigrad_pos3 = Vector(733.319580, 1393.808716, 14.814985, 1);

					novigrad_pos2 = Vector(1032.619873, 2068.319824, 1.808512, 1);

					novigrad_pos1 = Vector(453.506348, 2240.663330, 47.299950, 1);
				}

				if (!ACSGetCActor('ACS_Horse_Rider_Follow_Target_Novigrad_Tag').HasTag('ACS_Horse_Rider_Follow_Target_Position_1')
				&& !ACSGetCActor('ACS_Horse_Rider_Follow_Target_Novigrad_Tag').HasTag('ACS_Horse_Rider_Follow_Target_Position_2')
				&& !ACSGetCActor('ACS_Horse_Rider_Follow_Target_Novigrad_Tag').HasTag('ACS_Horse_Rider_Follow_Target_Position_3')
				)
				{
					ACSGetCActor('ACS_Horse_Rider_Follow_Target_Novigrad_Tag').Teleport(novigrad_pos1);

					ACSGetCActor('ACS_Horse_Rider_Follow_Target_Novigrad_Tag').AddTag('ACS_Horse_Rider_Follow_Target_Position_1');
				}
				else if (ACSGetCActor('ACS_Horse_Rider_Follow_Target_Novigrad_Tag').HasTag('ACS_Horse_Rider_Follow_Target_Position_1')
				&& !ACSGetCActor('ACS_Horse_Rider_Follow_Target_Novigrad_Tag').HasTag('ACS_Horse_Rider_Follow_Target_Position_2')
				&& !ACSGetCActor('ACS_Horse_Rider_Follow_Target_Novigrad_Tag').HasTag('ACS_Horse_Rider_Follow_Target_Position_3')
				)
				{
					ACSGetCActor('ACS_Horse_Rider_Follow_Target_Novigrad_Tag').Teleport(novigrad_pos2);

					ACSGetCActor('ACS_Horse_Rider_Follow_Target_Novigrad_Tag').AddTag('ACS_Horse_Rider_Follow_Target_Position_2');
				}
				else if (ACSGetCActor('ACS_Horse_Rider_Follow_Target_Novigrad_Tag').HasTag('ACS_Horse_Rider_Follow_Target_Position_1')
				&& ACSGetCActor('ACS_Horse_Rider_Follow_Target_Novigrad_Tag').HasTag('ACS_Horse_Rider_Follow_Target_Position_2')
				&& !ACSGetCActor('ACS_Horse_Rider_Follow_Target_Novigrad_Tag').HasTag('ACS_Horse_Rider_Follow_Target_Position_3')
				)
				{
					ACSGetCActor('ACS_Horse_Rider_Follow_Target_Novigrad_Tag').Teleport(novigrad_pos3);

					ACSGetCActor('ACS_Horse_Rider_Follow_Target_Novigrad_Tag').AddTag('ACS_Horse_Rider_Follow_Target_Position_3');
				}
				else if (ACSGetCActor('ACS_Horse_Rider_Follow_Target_Novigrad_Tag').HasTag('ACS_Horse_Rider_Follow_Target_Position_1')
				&& ACSGetCActor('ACS_Horse_Rider_Follow_Target_Novigrad_Tag').HasTag('ACS_Horse_Rider_Follow_Target_Position_2')
				&& ACSGetCActor('ACS_Horse_Rider_Follow_Target_Novigrad_Tag').HasTag('ACS_Horse_Rider_Follow_Target_Position_3')
				)
				{
					ACSGetCActor('ACS_Horse_Rider_Follow_Target_Novigrad_Tag').Teleport(novigrad_pos1);

					ACSGetCActor('ACS_Horse_Rider_Follow_Target_Novigrad_Tag').RemoveTag('ACS_Horse_Rider_Follow_Target_Position_1');
					ACSGetCActor('ACS_Horse_Rider_Follow_Target_Novigrad_Tag').RemoveTag('ACS_Horse_Rider_Follow_Target_Position_2');
					ACSGetCActor('ACS_Horse_Rider_Follow_Target_Novigrad_Tag').RemoveTag('ACS_Horse_Rider_Follow_Target_Position_3');
				}
			}
		}

		if (ACSGetCActor('ACS_Horse_Rider_Follow_Target_Nilfgaard_Tag'))
		{
			if (theGame.GetEngineTimeAsSeconds() - last_horse_follow_target_nilfgaard_teleport_time > 30)
			{
				last_horse_follow_target_nilfgaard_teleport_time = theGame.GetEngineTimeAsSeconds();

				if (theGame.GetWorld().GetDepotPath() == "levels\novigrad\novigrad.w2w")
				{
					nilfgaard_pos1 = Vector(2194.010010, -717.697571, 0.935780, 1);

					nilfgaard_pos2 = Vector(2587.317139, -977.438538, 4.314292, 1);

					nilfgaard_pos3 = Vector(2503.556152, -863.483826, 2.293803, 1);
				}

				if (!ACSGetCActor('ACS_Horse_Rider_Follow_Target_Nilfgaard_Tag').HasTag('ACS_Horse_Rider_Follow_Target_Position_1')
				&& !ACSGetCActor('ACS_Horse_Rider_Follow_Target_Nilfgaard_Tag').HasTag('ACS_Horse_Rider_Follow_Target_Position_2')
				&& !ACSGetCActor('ACS_Horse_Rider_Follow_Target_Nilfgaard_Tag').HasTag('ACS_Horse_Rider_Follow_Target_Position_3')
				)
				{
					ACSGetCActor('ACS_Horse_Rider_Follow_Target_Nilfgaard_Tag').Teleport(nilfgaard_pos1);

					ACSGetCActor('ACS_Horse_Rider_Follow_Target_Nilfgaard_Tag').AddTag('ACS_Horse_Rider_Follow_Target_Position_1');
				}
				else if (ACSGetCActor('ACS_Horse_Rider_Follow_Target_Nilfgaard_Tag').HasTag('ACS_Horse_Rider_Follow_Target_Position_1')
				&& !ACSGetCActor('ACS_Horse_Rider_Follow_Target_Nilfgaard_Tag').HasTag('ACS_Horse_Rider_Follow_Target_Position_2')
				&& !ACSGetCActor('ACS_Horse_Rider_Follow_Target_Nilfgaard_Tag').HasTag('ACS_Horse_Rider_Follow_Target_Position_3')
				)
				{
					ACSGetCActor('ACS_Horse_Rider_Follow_Target_Nilfgaard_Tag').Teleport(nilfgaard_pos2);

					ACSGetCActor('ACS_Horse_Rider_Follow_Target_Nilfgaard_Tag').AddTag('ACS_Horse_Rider_Follow_Target_Position_2');
				}
				else if (ACSGetCActor('ACS_Horse_Rider_Follow_Target_Nilfgaard_Tag').HasTag('ACS_Horse_Rider_Follow_Target_Position_1')
				&& ACSGetCActor('ACS_Horse_Rider_Follow_Target_Nilfgaard_Tag').HasTag('ACS_Horse_Rider_Follow_Target_Position_2')
				&& !ACSGetCActor('ACS_Horse_Rider_Follow_Target_Nilfgaard_Tag').HasTag('ACS_Horse_Rider_Follow_Target_Position_3')
				)
				{
					ACSGetCActor('ACS_Horse_Rider_Follow_Target_Nilfgaard_Tag').Teleport(nilfgaard_pos3);

					ACSGetCActor('ACS_Horse_Rider_Follow_Target_Nilfgaard_Tag').AddTag('ACS_Horse_Rider_Follow_Target_Position_3');
				}
				else if (ACSGetCActor('ACS_Horse_Rider_Follow_Target_Nilfgaard_Tag').HasTag('ACS_Horse_Rider_Follow_Target_Position_1')
				&& ACSGetCActor('ACS_Horse_Rider_Follow_Target_Nilfgaard_Tag').HasTag('ACS_Horse_Rider_Follow_Target_Position_2')
				&& ACSGetCActor('ACS_Horse_Rider_Follow_Target_Nilfgaard_Tag').HasTag('ACS_Horse_Rider_Follow_Target_Position_3')
				)
				{
					ACSGetCActor('ACS_Horse_Rider_Follow_Target_Nilfgaard_Tag').Teleport(nilfgaard_pos1);

					ACSGetCActor('ACS_Horse_Rider_Follow_Target_Nilfgaard_Tag').RemoveTag('ACS_Horse_Rider_Follow_Target_Position_1');
					ACSGetCActor('ACS_Horse_Rider_Follow_Target_Nilfgaard_Tag').RemoveTag('ACS_Horse_Rider_Follow_Target_Position_2');
					ACSGetCActor('ACS_Horse_Rider_Follow_Target_Nilfgaard_Tag').RemoveTag('ACS_Horse_Rider_Follow_Target_Position_3');
				}
			}
		}

		if (ACSGetCActor('ACS_Horse_Rider_Follow_Target_Redania_Tag'))
		{
			if (theGame.GetEngineTimeAsSeconds() - last_horse_follow_target_redania_teleport_time > 60)
			{
				last_horse_follow_target_redania_teleport_time = theGame.GetEngineTimeAsSeconds();

				if (theGame.GetWorld().GetDepotPath() == "levels\novigrad\novigrad.w2w")
				{
					redania_pos3 = Vector(1224.159180, 644.492615, 34.799957, 1);

					redania_pos2 = Vector(1808.964233, 511.915314, 3.037488, 1);

					redania_pos1 = Vector(2059.403564, 1120.827759, 4.660693, 1);
				}

				if (!ACSGetCActor('ACS_Horse_Rider_Follow_Target_Redania_Tag').HasTag('ACS_Horse_Rider_Follow_Target_Position_1')
				&& !ACSGetCActor('ACS_Horse_Rider_Follow_Target_Redania_Tag').HasTag('ACS_Horse_Rider_Follow_Target_Position_2')
				&& !ACSGetCActor('ACS_Horse_Rider_Follow_Target_Redania_Tag').HasTag('ACS_Horse_Rider_Follow_Target_Position_3')
				)
				{
					ACSGetCActor('ACS_Horse_Rider_Follow_Target_Redania_Tag').Teleport(redania_pos1);

					ACSGetCActor('ACS_Horse_Rider_Follow_Target_Redania_Tag').AddTag('ACS_Horse_Rider_Follow_Target_Position_1');
				}
				else if (ACSGetCActor('ACS_Horse_Rider_Follow_Target_Redania_Tag').HasTag('ACS_Horse_Rider_Follow_Target_Position_1')
				&& !ACSGetCActor('ACS_Horse_Rider_Follow_Target_Redania_Tag').HasTag('ACS_Horse_Rider_Follow_Target_Position_2')
				&& !ACSGetCActor('ACS_Horse_Rider_Follow_Target_Redania_Tag').HasTag('ACS_Horse_Rider_Follow_Target_Position_3')
				)
				{
					ACSGetCActor('ACS_Horse_Rider_Follow_Target_Redania_Tag').Teleport(redania_pos2);

					ACSGetCActor('ACS_Horse_Rider_Follow_Target_Redania_Tag').AddTag('ACS_Horse_Rider_Follow_Target_Position_2');
				}
				else if (ACSGetCActor('ACS_Horse_Rider_Follow_Target_Redania_Tag').HasTag('ACS_Horse_Rider_Follow_Target_Position_1')
				&& ACSGetCActor('ACS_Horse_Rider_Follow_Target_Redania_Tag').HasTag('ACS_Horse_Rider_Follow_Target_Position_2')
				&& !ACSGetCActor('ACS_Horse_Rider_Follow_Target_Redania_Tag').HasTag('ACS_Horse_Rider_Follow_Target_Position_3')
				)
				{
					ACSGetCActor('ACS_Horse_Rider_Follow_Target_Redania_Tag').Teleport(redania_pos3);

					ACSGetCActor('ACS_Horse_Rider_Follow_Target_Redania_Tag').AddTag('ACS_Horse_Rider_Follow_Target_Position_3');
				}
				else if (ACSGetCActor('ACS_Horse_Rider_Follow_Target_Redania_Tag').HasTag('ACS_Horse_Rider_Follow_Target_Position_1')
				&& ACSGetCActor('ACS_Horse_Rider_Follow_Target_Redania_Tag').HasTag('ACS_Horse_Rider_Follow_Target_Position_2')
				&& ACSGetCActor('ACS_Horse_Rider_Follow_Target_Redania_Tag').HasTag('ACS_Horse_Rider_Follow_Target_Position_3')
				)
				{
					ACSGetCActor('ACS_Horse_Rider_Follow_Target_Redania_Tag').Teleport(redania_pos1);

					ACSGetCActor('ACS_Horse_Rider_Follow_Target_Redania_Tag').RemoveTag('ACS_Horse_Rider_Follow_Target_Position_1');
					ACSGetCActor('ACS_Horse_Rider_Follow_Target_Redania_Tag').RemoveTag('ACS_Horse_Rider_Follow_Target_Position_2');
					ACSGetCActor('ACS_Horse_Rider_Follow_Target_Redania_Tag').RemoveTag('ACS_Horse_Rider_Follow_Target_Position_3');
				}
			}
		}

		HorseRiderRedaniaBreakAttachment();

		HorseRiderNovigradBreakAttachment();

		HorseRiderNilfgaardBreakAttachment();
	}

	function HorseRiderRedaniaBreakAttachment()
	{	
		var i, j											: int;
		var ents, horseEnts 								: array<CActor>;
		var enemyAnimatedComponent 							: CAnimatedComponent;
		var targetDistanceRider, targetDistanceHorse		: float;

		ents.Clear();

		theGame.GetActorsByTag( 'ACS_Horse_Rider_Redania', ents );	

		if (ents.Size() < 0)
		{
			return;
		}
		
		for( i = 0; i < ents.Size(); i += 1 )
		{
			enemyAnimatedComponent = (CAnimatedComponent)ents[i].GetComponentByClassName( 'CAnimatedComponent' );	

			targetDistanceRider = VecDistanceSquared2D( thePlayer.GetWorldPosition(), ents[i].GetWorldPosition() );

			if (ents[i].IsInCombat())
			{
				if (!ents[i].HasTag('ACS_Horse_Rider_In_Combat'))
				{
					enemyAnimatedComponent.UnfreezePose();

					ents[i].EnableCollisions(true);
					ents[i].EnableCharacterCollisions(true);

					ents[i].BreakAttachment();

					ents[i].AddTag('ACS_Horse_Rider_In_Combat');
				}
			}

			if (targetDistanceRider >= 150 * 150
			)
			{
				ents[i].Destroy();
			}
		}

		horseEnts.Clear();

		theGame.GetActorsByTag( 'ACS_Horse_Rider_Horse_Redania', horseEnts );	

		if (horseEnts.Size() < 0)
		{
			return;
		}
		
		for( j = 0; j < horseEnts.Size(); j += 1 )
		{
			targetDistanceHorse = VecDistanceSquared2D( thePlayer.GetWorldPosition(), horseEnts[j].GetWorldPosition() );

			if (targetDistanceHorse >= 150 * 150
			)
			{
				horseEnts[j].Destroy();
			}
		}
	}


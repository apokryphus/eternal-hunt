	private var acs_caranthir_magic_index_1							: int;
	private var previous_acs_caranthir_magic_index_1 				: int;

	private var acs_draug_attack_index_1						: int;
	private var previous_acs_draug_attack_index_1 				: int;

	private var acs_draug_attack_index_2						: int;
	private var previous_acs_draug_attack_index_2 				: int;

	function ACS_KnightmareEternumManager()
	{
		var animatedComponentA																									: CAnimatedComponent;
		var movementAdjustorNPC																									: CMovementAdjustor; 
		var ticketNPC 																											: SMovementAdjustmentRequestTicket; 
		var targetDistance, fireballChance, firelineChance, fireballDistance, firelineDistance, flameOnChance					: float;

		if (!ACSGetCActor('ACS_Knightmare_Eternum') 
		)
		{
			return;
		}

		animatedComponentA = (CAnimatedComponent)((CNewNPC)ACSGetCActor('ACS_Knightmare_Eternum')).GetComponentByClassName( 'CAnimatedComponent' );	

		movementAdjustorNPC = ACSGetCActor('ACS_Knightmare_Eternum').GetMovingAgentComponent().GetMovementAdjustor();

		targetDistance = VecDistanceSquared2D( ACSGetCActor('ACS_Knightmare_Eternum').GetWorldPosition(), GetWitcherPlayer().GetWorldPosition() );

		if (!ACSGetCActor('ACS_Knightmare_Eternum').IsAlive()
		|| ACSGetCActor('ACS_Knightmare_Eternum').ACS_IsInDimeritiumCloud()
		|| ACSGetCActor('ACS_Knightmare_Eternum').HasBuff(EET_HeavyKnockdown) 
		|| ACSGetCActor('ACS_Knightmare_Eternum').HasBuff( EET_Knockdown ) 
		|| ACSGetCActor('ACS_Knightmare_Eternum').HasBuff( EET_Ragdoll ) 
		|| ACSGetCActor('ACS_Knightmare_Eternum').HasBuff( EET_Stagger )
		|| ACSGetCActor('ACS_Knightmare_Eternum').HasBuff( EET_LongStagger )
		|| ACSGetCActor('ACS_Knightmare_Eternum').HasBuff( EET_Pull )
		|| ACSGetCActor('ACS_Knightmare_Eternum').HasBuff( EET_Hypnotized )
		|| ACSGetCActor('ACS_Knightmare_Eternum').HasBuff( EET_WitchHypnotized )
		|| ACSGetCActor('ACS_Knightmare_Eternum').HasBuff( EET_Blindness )
		|| ACSGetCActor('ACS_Knightmare_Eternum').HasBuff( EET_WraithBlindness )
		|| ACSGetCActor('ACS_Knightmare_Eternum').HasBuff( EET_Frozen )
		|| ACSGetCActor('ACS_Knightmare_Eternum').HasBuff( EET_Paralyzed )
		|| ACSGetCActor('ACS_Knightmare_Eternum').HasBuff( EET_Confusion )
		|| ACSGetCActor('ACS_Knightmare_Eternum').HasBuff( EET_Tangled )
		|| ACSGetCActor('ACS_Knightmare_Eternum').HasBuff( EET_Tornado ) 
		|| ACSGetCActor('ACS_Knightmare_Eternum').HasBuff( EET_Swarm ) 
		)
		{
			return;
		}

		if (ACSGetCActor('ACS_Knightmare_Eternum')
		&& ACSGetCActor('ACS_Knightmare_Eternum').IsAlive())
		{
			if (ACS_knightmare_shout()
			//&& ACS_Knightmare_Igni_Process == false
			)
			{
				ACS_refresh_knightmare_shout_cooldown();

				if ( targetDistance <= 5 * 5 )
				{
					ticketNPC = movementAdjustorNPC.GetRequest( 'ACS_Knightmare_Eternum_Shout_Rotate');
					movementAdjustorNPC.CancelByName( 'ACS_Knightmare_Eternum_Shout_Rotate' );

					ticketNPC = movementAdjustorNPC.CreateNewRequest( 'ACS_Knightmare_Eternum_Shout_Rotate' );
					movementAdjustorNPC.AdjustmentDuration( ticketNPC, 0.25 );
					movementAdjustorNPC.MaxRotationAdjustmentSpeed( ticketNPC, 500000 );

					movementAdjustorNPC.RotateTowards( ticketNPC, ACSGetCActor('ACS_Knightmare_Eternum').GetTarget() );

					ACSGetCActor('ACS_Knightmare_Eternum').PlayEffectSingle('olgierd_energy_blast');

					ACSGetCActor('ACS_Knightmare_Eternum').PlayEffectSingle('special_attack_fx');

					ACSGetCActor('ACS_Knightmare_Eternum').SetImmortalityMode( AIM_None, AIC_Default, true ); 

					ACSGetCActor('ACS_Knightmare_Eternum').SetCanPlayHitAnim(true); 

					ACSGetCActor('ACS_Knightmare_Eternum').SetIsCurrentlyDodging(false);

					ACSGetCActor('ACS_Knightmare_Eternum').SetParryEnabled(false);

					ACSGetCActor('ACS_Knightmare_Eternum').SetGuarded(false);

					if( ACS_Knightmare_Igni_Process == false )
					{
						ACS_Knightmare_Igni_Process = true;

						animatedComponentA.PlaySlotAnimationAsync ( 'ethereal_attack_shout', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 1));

						AddTimer('KnightmareEternumShout', 1.75 , false);
					}
					else
					{
						ACS_Knightmare_Igni_Process = false;

						animatedComponentA.PlaySlotAnimationAsync ( 'ethereal_attack_with_shout_001', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 1));

						AddTimer('KnightmareEternumIgni', 1 , false);
					}
				}
			}
		}
	}

	function ACS_RatMageManager()
	{
		var animatedComponentA																									: CAnimatedComponent;
		var movementAdjustorNPC																									: CMovementAdjustor; 
		var ticketNPC 																											: SMovementAdjustmentRequestTicket; 
		var targetDistance, fireballChance, firelineChance, fireballDistance, firelineDistance, flameOnChance					: float;

		if (!ACSGetCActor('ACS_Rat_Mage') 
		)
		{
			return;
		}

		animatedComponentA = (CAnimatedComponent)((CNewNPC)ACSGetCActor('ACS_Rat_Mage')).GetComponentByClassName( 'CAnimatedComponent' );	

		movementAdjustorNPC = ACSGetCActor('ACS_Rat_Mage').GetMovingAgentComponent().GetMovementAdjustor();

		targetDistance = VecDistanceSquared2D( ACSGetCActor('ACS_Rat_Mage').GetWorldPosition(), GetWitcherPlayer().GetWorldPosition() );

		if (!ACSGetCActor('ACS_Rat_Mage').IsAlive()
		|| ACSGetCActor('ACS_Rat_Mage').ACS_IsInDimeritiumCloud()
		|| ACSGetCActor('ACS_Rat_Mage').HasBuff(EET_HeavyKnockdown) 
		|| ACSGetCActor('ACS_Rat_Mage').HasBuff( EET_Knockdown ) 
		|| ACSGetCActor('ACS_Rat_Mage').HasBuff( EET_Ragdoll ) 
		|| ACSGetCActor('ACS_Rat_Mage').HasBuff( EET_Stagger )
		|| ACSGetCActor('ACS_Rat_Mage').HasBuff( EET_LongStagger )
		|| ACSGetCActor('ACS_Rat_Mage').HasBuff( EET_Pull )
		|| ACSGetCActor('ACS_Rat_Mage').HasBuff( EET_Hypnotized )
		|| ACSGetCActor('ACS_Rat_Mage').HasBuff( EET_WitchHypnotized )
		|| ACSGetCActor('ACS_Rat_Mage').HasBuff( EET_Blindness )
		|| ACSGetCActor('ACS_Rat_Mage').HasBuff( EET_WraithBlindness )
		|| ACSGetCActor('ACS_Rat_Mage').HasBuff( EET_Frozen )
		|| ACSGetCActor('ACS_Rat_Mage').HasBuff( EET_Paralyzed )
		|| ACSGetCActor('ACS_Rat_Mage').HasBuff( EET_Confusion )
		|| ACSGetCActor('ACS_Rat_Mage').HasBuff( EET_Tangled )
		|| ACSGetCActor('ACS_Rat_Mage').HasBuff( EET_Tornado ) 
		|| ACSGetCActor('ACS_Rat_Mage').HasBuff( EET_Swarm ) 
		)
		{
			return;
		}

		if (ACSGetCActor('ACS_Rat_Mage')
		&& ACSGetCActor('ACS_Rat_Mage').IsAlive())
		{
			if (ACS_rat_mage_abilities()
			)
			{
				ACS_refresh_rat_mage_abilities_cooldown();

				if ( targetDistance >= 5 * 5 && targetDistance < 15 * 15 )
				{
					ticketNPC = movementAdjustorNPC.GetRequest( 'ACS_Rat_Mage_Rotate');
					movementAdjustorNPC.CancelByName( 'ACS_Rat_Mage_Rotate' );
					movementAdjustorNPC.CancelAll();

					ticketNPC = movementAdjustorNPC.CreateNewRequest( 'ACS_Rat_Mage_Rotate' );
					movementAdjustorNPC.AdjustmentDuration( ticketNPC, 0.25 );
					movementAdjustorNPC.MaxRotationAdjustmentSpeed( ticketNPC, 500000 );

					movementAdjustorNPC.RotateTowards( ticketNPC, thePlayer );

					if( !ACSGetCActor('ACS_Rat_Mage').HasTag('ACS_Summoned_Rats') )
					{
						ACSGetCActor('ACS_Rat_Mage').AddTag('ACS_Summoned_Rats');

						animatedComponentA.PlaySlotAnimationAsync ( 'man_mage_root_attack_01', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));

						AddTimer('RatMageSummonRats', 1 , false);
					}
					else
					{
						animatedComponentA.PlaySlotAnimationAsync ( 'man_mage_fireball_01', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));

						AddTimer('RatMageProjectile', 1 , false);

						ACSGetCActor('ACS_Rat_Mage').RemoveTag('ACS_Summoned_Rats');
					}
				}
			}
		}
	}

	function ACS_SheWhoKnowsManager()
	{
		var animatedComponentA																									: CAnimatedComponent;
		var movementAdjustorNPC																									: CMovementAdjustor; 
		var ticketNPC 																											: SMovementAdjustmentRequestTicket; 
		var targetDistance																										: float;

		if (!ACSGetCActor('ACS_She_Who_Knows'))
		{
			return;
		}

		if (!ACSGetCActor('ACS_She_Who_Knows').IsAlive()
		|| ACSGetCActor('ACS_She_Who_Knows').ACS_IsInDimeritiumCloud()
		|| ACSGetCActor('ACS_She_Who_Knows').HasBuff(EET_HeavyKnockdown) 
		|| ACSGetCActor('ACS_She_Who_Knows').HasBuff( EET_Knockdown ) 
		|| ACSGetCActor('ACS_She_Who_Knows').HasBuff( EET_Ragdoll ) 
		|| ACSGetCActor('ACS_She_Who_Knows').HasBuff( EET_Stagger )
		|| ACSGetCActor('ACS_She_Who_Knows').HasBuff( EET_LongStagger )
		|| ACSGetCActor('ACS_She_Who_Knows').HasBuff( EET_Pull )
		|| ACSGetCActor('ACS_She_Who_Knows').HasBuff( EET_Hypnotized )
		|| ACSGetCActor('ACS_She_Who_Knows').HasBuff( EET_WitchHypnotized )
		|| ACSGetCActor('ACS_She_Who_Knows').HasBuff( EET_Blindness )
		|| ACSGetCActor('ACS_She_Who_Knows').HasBuff( EET_WraithBlindness )
		|| ACSGetCActor('ACS_She_Who_Knows').HasBuff( EET_Frozen )
		|| ACSGetCActor('ACS_She_Who_Knows').HasBuff( EET_Paralyzed )
		|| ACSGetCActor('ACS_She_Who_Knows').HasBuff( EET_Confusion )
		|| ACSGetCActor('ACS_She_Who_Knows').HasBuff( EET_Tangled )
		|| ACSGetCActor('ACS_She_Who_Knows').HasBuff( EET_Tornado ) 
		|| ACSGetCActor('ACS_She_Who_Knows').HasBuff( EET_Swarm ) 
		)
		{
			return;
		}

		animatedComponentA = (CAnimatedComponent)((CNewNPC)ACSGetCActor('ACS_She_Who_Knows')).GetComponentByClassName( 'CAnimatedComponent' );	

		movementAdjustorNPC = ACSGetCActor('ACS_She_Who_Knows').GetMovingAgentComponent().GetMovementAdjustor();

		targetDistance = VecDistanceSquared2D( ACSGetCActor('ACS_She_Who_Knows').GetWorldPosition(), GetWitcherPlayer().GetWorldPosition() );

		if (ACSGetCActor('ACS_She_Who_Knows')
		&& ACSGetCActor('ACS_She_Who_Knows').IsAlive()
		&& ACSGetCActor('ACS_She_Who_Knows').IsInCombat())
		{
			ACSGetCActor('ACS_She_Who_Knows').DisableLookAt();

			if (ACS_she_who_knows_abilities()
			)
			{
				ACS_refresh_she_who_knows_abilities_cooldown();

				ticketNPC = movementAdjustorNPC.GetRequest( 'ACS_She_Who_Knows_Abilities_Rotate');
				movementAdjustorNPC.CancelByName( 'ACS_She_Who_Knows_Abilities_Rotate' );

				ticketNPC = movementAdjustorNPC.CreateNewRequest( 'ACS_She_Who_Knows_Abilities_Rotate' );
				movementAdjustorNPC.AdjustmentDuration( ticketNPC, 0.25 );
				movementAdjustorNPC.MaxRotationAdjustmentSpeed( ticketNPC, 500000 );

				movementAdjustorNPC.RotateTowards( ticketNPC, GetWitcherPlayer() );

				if ( targetDistance <= 5 * 5)
				{
					animatedComponentA.PlaySlotAnimationAsync ( 'water_dodge_to_submerge', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 1));

					ACSGetCActor('ACS_She_Who_Knows').StopEffect('spawn_disappear');
					ACSGetCActor('ACS_She_Who_Knows').PlayEffectSingle('spawn_disappear');
					ACSGetCActor('ACS_She_Who_Knows').PlayEffectSingle('spawn_disappear');
					ACSGetCActor('ACS_She_Who_Knows').PlayEffectSingle('spawn_disappear');
					ACSGetCActor('ACS_She_Who_Knows').PlayEffectSingle('spawn_disappear');
					ACSGetCActor('ACS_She_Who_Knows').PlayEffectSingle('spawn_disappear');

					RemoveTimer('SheWhoKnowsHide');
					AddTimer('SheWhoKnowsHide', 0.5 , false);

					RemoveTimer('SheWhoKnowsTeleport');
					AddTimer('SheWhoKnowsTeleport', 1.25 , false);
				}
				else if ( targetDistance > 5 * 5 && targetDistance <= 20 * 20 )
				{
					if( ACS_She_Who_Knows_Throw_Projectile_Process == false )
					{
						SetSheWhoKnowsProjectileProcess(true);

						if(!ACSGetCActor('ACS_She_Who_Knows').HasTag('ACS_SheWhoKnowsVolleyContinuous'))
						{
							movementAdjustorNPC.Continuous(ticketNPC);

							animatedComponentA.PlaySlotAnimationAsync ( 'witch_hypno_loop', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 1));

							RemoveTimer('SheWhoKnowsProjectileSingle');

							RemoveTimer('SheWhoKnowsProjectileSingleStop');

							AddTimer('SheWhoKnowsProjectileSingle', 0.5 , true);

							AddTimer('SheWhoKnowsProjectileSingleStop', 4.5 , false);

							ACSGetCActor('ACS_She_Who_Knows').AddTag('ACS_SheWhoKnowsVolleyContinuous');
						}
						else
						{
							ACSGetCActor('ACS_She_Who_Knows').RemoveTag('ACS_SheWhoKnowsVolleyContinuous');

							RemoveTimer('SheWhoKnowsProjectileVolley1');

							RemoveTimer('SheWhoKnowsProjectileVolley2');

							RemoveTimer('SheWhoKnowsProjectileVolley3');

							if (!ACSGetCActor('ACS_She_Who_Knows').HasTag('ACS_SheWhoKnows_1st_Volley')
							&& !ACSGetCActor('ACS_She_Who_Knows').HasTag('ACS_SheWhoKnows_2nd_Volley')
							)
							{
								animatedComponentA.PlaySlotAnimationAsync ( 'water_attack_throw_mud_faster', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 1));

								AddTimer('SheWhoKnowsProjectileVolley2', 0.875, false,,,false);

								ACSGetCActor('ACS_She_Who_Knows').AddTag('ACS_SheWhoKnows_1st_Volley');
							}
							else if (ACSGetCActor('ACS_She_Who_Knows').HasTag('ACS_SheWhoKnows_1st_Volley')
							&& !ACSGetCActor('ACS_She_Who_Knows').HasTag('ACS_SheWhoKnows_2nd_Volley'))
							{
								if (RandF() < 0.5)
								{
									animatedComponentA.PlaySlotAnimationAsync ( 'water_emerge_throw_mud_fast', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 1));

									AddTimer('SheWhoKnowsProjectileVolley2', 1, false,,,false);

									AddTimer('SheWhoKnowsProjectileVolley3', 1.125, false,,,false);
								}
								else
								{
									animatedComponentA.PlaySlotAnimationAsync ( 'water_attack_throw_mud_faster', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 1));

									AddTimer('SheWhoKnowsProjectileVolley1', 0.875, false,,,false);

									AddTimer('SheWhoKnowsProjectileVolley2', 1, false,,,false);
								}

								ACSGetCActor('ACS_She_Who_Knows').AddTag('ACS_SheWhoKnows_2nd_Volley');
							}
							else if (ACSGetCActor('ACS_She_Who_Knows').HasTag('ACS_SheWhoKnows_1st_Volley')
							&& ACSGetCActor('ACS_She_Who_Knows').HasTag('ACS_SheWhoKnows_2nd_Volley')) 
							{
								animatedComponentA.PlaySlotAnimationAsync ( 'water_emerge_throw_mud_fast', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 1));

								AddTimer('SheWhoKnowsProjectileVolley1', 0.875, false,,,false);

								AddTimer('SheWhoKnowsProjectileVolley2', 1, false,,,false);

								AddTimer('SheWhoKnowsProjectileVolley3', 1.125, false,,,false);

								ACSGetCActor('ACS_She_Who_Knows').RemoveTag('ACS_SheWhoKnows_1st_Volley');
								ACSGetCActor('ACS_She_Who_Knows').RemoveTag('ACS_SheWhoKnows_2nd_Volley');
							}
						}	
					}
					else
					{
						SetSheWhoKnowsProjectileProcess(false);

						animatedComponentA.PlaySlotAnimationAsync ( 'water_submerge', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 1));

						ACSGetCActor('ACS_She_Who_Knows').StopEffect('spawn_disappear');
						ACSGetCActor('ACS_She_Who_Knows').PlayEffectSingle('spawn_disappear');
						ACSGetCActor('ACS_She_Who_Knows').PlayEffectSingle('spawn_disappear');
						ACSGetCActor('ACS_She_Who_Knows').PlayEffectSingle('spawn_disappear');
						ACSGetCActor('ACS_She_Who_Knows').PlayEffectSingle('spawn_disappear');
						ACSGetCActor('ACS_She_Who_Knows').PlayEffectSingle('spawn_disappear');

						RemoveTimer('SheWhoKnowsHide');
						AddTimer('SheWhoKnowsHide', 1.125 , false);

						RemoveTimer('SheWhoKnowsTeleport');
						AddTimer('SheWhoKnowsTeleport', 1.25 , false);
					}
				}
			}
		}
	}

	function ACS_VampireMonsterManager()
	{
		var animatedComponentA																									: CAnimatedComponent;
		var movementAdjustorNPC																									: CMovementAdjustor; 
		var ticketNPC 																											: SMovementAdjustmentRequestTicket; 
		var targetDistance																										: float;
		var wing_temp_1, wing_temp_2, wing_temp_3																				: CEntityTemplate;
		var p_comp 																												: CComponent;

		if (!ACSGetCActor('ACS_Vampire_Monster') || !ACSGetCActor('ACS_Vampire_Monster').IsAlive())
		{
			return;
		}

		animatedComponentA = (CAnimatedComponent)((CNewNPC)ACSGetCActor('ACS_Vampire_Monster')).GetComponentByClassName( 'CAnimatedComponent' );	

		movementAdjustorNPC = ACSGetCActor('ACS_Vampire_Monster').GetMovingAgentComponent().GetMovementAdjustor();

		targetDistance = VecDistanceSquared2D( ACSGetCActor('ACS_Vampire_Monster').GetWorldPosition(), GetWitcherPlayer().GetWorldPosition() );

		if (ACSGetCActor('ACS_Vampire_Monster')
		&& ACSGetCActor('ACS_Vampire_Monster').IsAlive()
		&& ACSGetCActor('ACS_Vampire_Monster').IsInCombat())
		{
			if (ACS_vampire_monster_abilities()
			&& ACS_Vampire_Monster_Flying_Process == false
			&& ACS_Vampire_Monster_Spawn_Process == false )
			{
				ACS_refresh_vampire_monster_cooldown();

				ticketNPC = movementAdjustorNPC.GetRequest( 'ACS_Vampire_Monster_Abilities_Rotate');
				movementAdjustorNPC.CancelByName( 'ACS_Vampire_Monster_Abilities_Rotate' );
				movementAdjustorNPC.CancelAll();

				ticketNPC = movementAdjustorNPC.CreateNewRequest( 'ACS_Vampire_Monster_Abilities_Rotate' );
				movementAdjustorNPC.AdjustmentDuration( ticketNPC, 0.1 );
				movementAdjustorNPC.MaxRotationAdjustmentSpeed( ticketNPC, 500000 );

				movementAdjustorNPC.Continuous(ticketNPC);

				movementAdjustorNPC.RotateTowards( ticketNPC, GetWitcherPlayer() );

				ACSGetCActor('ACS_Vampire_Monster').StopEffect('swarm_light');
				ACSGetCActor('ACS_Vampire_Monster').PlayEffectSingle('swarm_light');

				if ( targetDistance < 2 * 2 )
				{
					animatedComponentA.PlaySlotAnimationAsync ( 'dettlaff_fly_phase2_start', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.75f));
					ACS_VampireMonsterFlyingStartDamage();

					ACSGetCActor('ACS_Vampire_Monster').StopEffect('shadowdash');
					ACSGetCActor('ACS_Vampire_Monster').PlayEffectSingle('shadowdash');

					RemoveTimer('VampireMonsterCancel');

					AddTimer('VampireMonsterCancel', 1 , false);
				}
				else if ( targetDistance >= 2 * 2 )
				{
					GetWitcherPlayer().SetFlyingBossCamera( true );

					SetVampireMonsterFlyingProcess(true);

					p_comp = ACSGetCActor('ACS_Vampire_Monster').GetComponentByClassName( 'CAppearanceComponent' );

					wing_temp_1 = (CEntityTemplate)LoadResource(
					"dlc\bob\data\characters\models\monsters\detlaff_monster\detlaff_wings.w2ent"
					, true);	
					
					((CAppearanceComponent)p_comp).IncludeAppearanceTemplate(wing_temp_1);

					wing_temp_2 = (CEntityTemplate)LoadResource(
					"dlc\dlc_acs\data\models\vampire_monster\wings_bloody_large.w2ent"
					, true);	
					
					((CAppearanceComponent)p_comp).IncludeAppearanceTemplate(wing_temp_2);

					wing_temp_3 = (CEntityTemplate)LoadResource(
					"dlc\dlc_acs\data\models\vampire_monster\wings_large.w2ent"
					, true);	
					
					((CAppearanceComponent)p_comp).IncludeAppearanceTemplate(wing_temp_3);

					animatedComponentA.PlaySlotAnimationAsync ( 'dettlaff_fly_phase2_start', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.75f));

					ACS_VampireMonsterFlyingStartDamage();

					ACSGetCActor('ACS_Vampire_Monster').StopEffect('swarm_attack');
					ACSGetCActor('ACS_Vampire_Monster').PlayEffectSingle('swarm_attack');
					
					RemoveTimer('VampireMonsterFlyAttack');

					AddTimer('VampireMonsterFlyAttack', 3 , false);
				}
			}
		}
	}

	function ACS_VampireMonsterFlyingStartDamage()
	{
		var npc, actortarget				: CActor;
		var victims			 				: array<CActor>;
		var dmg								: W3DamageAction;
		var i								: int;
		var movementAdjustor				: CMovementAdjustor;
		var ticket 							: SMovementAdjustmentRequestTicket;
		var AnimatedComponent 				: CAnimatedComponent;
		var params 							: SCustomEffectParams;

		ACSGetCActor('ACS_Vampire_Monster').PlayEffectSingle('shadowdash');
		ACSGetCActor('ACS_Vampire_Monster').StopEffect('shadowdash');

		ACSGetCActor('ACS_Vampire_Monster').PlayEffectSingle('smoke_explosion');
		ACSGetCActor('ACS_Vampire_Monster').StopEffect('smoke_explosion');

		ACSGetCActor('ACS_Vampire_Monster').PlayEffectSingle('third_teleport_out');
		ACSGetCActor('ACS_Vampire_Monster').StopEffect('third_teleport_out');

		ACSGetCActor('ACS_Vampire_Monster').PlayEffectSingle('third_dash');
		ACSGetCActor('ACS_Vampire_Monster').StopEffect('third_dash');

		victims.Clear();

		//victims = ACSGetCActor('ACS_Vampire_Monster').GetNPCsAndPlayersInCone(5, VecHeading(ACSGetCActor('ACS_Vampire_Monster').GetHeadingVector()), 360, 20, , FLAG_OnlyAliveActors );

		victims = ACSGetCActor('ACS_Vampire_Monster').GetNPCsAndPlayersInRange( 5, 5, , FLAG_OnlyAliveActors);

		if (ACSGetCActor('ACS_Vampire_Monster').IsAlive())
		{
			if( victims.Size() > 0)
			{
				for( i = 0; i < victims.Size(); i += 1 )
				{
					actortarget = (CActor)victims[i];

					if (actortarget != ACSGetCActor('ACS_Vampire_Monster')
					&& actortarget != ACSGetCActor('ACS_Vampire_Monster_Boss_Bar')
					&& actortarget != ACSGetCActor('ACS_Necrofiend_Tentacle_1')
					&& actortarget != ACSGetCActor('ACS_Necrofiend_Tentacle_2')
					&& actortarget != ACSGetCActor('ACS_Necrofiend_Tentacle_3')
					&& actortarget != ACSGetCActor('ACS_Necrofiend_Tentacle_4')
					&& actortarget != ACSGetCActor('ACS_Necrofiend_Tentacle_5')
					&& actortarget != ACSGetCActor('ACS_Necrofiend_Tentacle_6')
					&& actortarget != ACSGetCEntity('acs_necrofiend_tentacle_anchor')
					&& actortarget != ACSGetCEntity('acs_tentacle_anchor')
					)
					{
						if 
						(
							GetWitcherPlayer().IsAnyQuenActive()
						)
						{
							GetWitcherPlayer().PlayEffectSingle('quen_lasting_shield_hit');
							GetWitcherPlayer().StopEffect('quen_lasting_shield_hit');
							GetWitcherPlayer().PlayEffectSingle('lasting_shield_discharge');
							GetWitcherPlayer().StopEffect('lasting_shield_discharge');
						}
						else
						{
							movementAdjustor = actortarget.GetMovingAgentComponent().GetMovementAdjustor();

							ticket = movementAdjustor.GetRequest( 'ACS_Vampire_Monster_Hit_Rotate');
							movementAdjustor.CancelByName( 'ACS_Vampire_Monster_Hit_Rotate' );
							movementAdjustor.CancelAll();

							ticket = movementAdjustor.CreateNewRequest( 'ACS_Vampire_Monster_Hit_Rotate' );
							movementAdjustor.AdjustmentDuration( ticket, 0.1 );
							movementAdjustor.MaxRotationAdjustmentSpeed( ticket, 50000 );

							movementAdjustor.RotateTowards( ticket, ACSGetCActor('ACS_Vampire_Monster') );

							if (actortarget == GetWitcherPlayer())
							{
								AnimatedComponent = (CAnimatedComponent)actortarget.GetComponentByClassName( 'CAnimatedComponent' );	

								AnimatedComponent.PlaySlotAnimationAsync ( '', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0, 0));

								GetWitcherPlayer().ACS_ClearAnimationSpeedMultipliers();	
							}

							actortarget.SoundEvent("cmb_play_dismemberment_gore");

							actortarget.SoundEvent("monster_dettlaff_monster_vein_hit_blood");

							params.effectType = EET_Knockdown;
							params.creator = ACSGetCActor('ACS_Vampire_Monster');
							params.sourceName = "ACS_Vampire_Monster_Knockdown";
							params.duration = 1;

							actortarget.AddEffectCustom( params );
						}
					}
				}
			}
		}
	}

	var cutsceneDelayRecentDialogueTime, cutsceneDelayCurrentTime : GameTime;

	function CutsceneDelayCheck() : bool
	{
		cutsceneDelayRecentDialogueTime = theGame.GetRecentDialogOrCutsceneEndGameTime();
		cutsceneDelayCurrentTime = theGame.GetGameTime();
		
		if( GameTimeDTAtLeastRealSecs( cutsceneDelayCurrentTime, cutsceneDelayRecentDialogueTime, 3 ) )
		{
			return true;
		}

		return false;
	}

	var adrenalineDrain : bool;
	default adrenalineDrain = true;

	function SetAdrenalineDrain( b : bool)
	{
		adrenalineDrain = b;
	}

	timer function AdrenalineDrainResume( deltaTime : float , id : int)
	{
		adrenalineDrain = true;
	}

	var last_fast_sprint_stamina_drain : float;

	var sprintSpeed : float;

	default sprintSpeed = 1;

	var sprintSpeedFinal : float;

	default sprintSpeedFinal = 1;

	var sprintSpeedDistance : float;

	default sprintSpeedDistance = 0;

	var sprintSpeedDistanceFinal : float;

	default sprintSpeedDistanceFinal = 0;

	var sprintSpeedModifier : float;

	var sprintStaminaDrainRate : float;

	var walkSpeed : float;

	default walkSpeed = 1;

	var fastWalkDisabled : bool;

	default fastWalkDisabled = false;

	function ResetFastWalk()
	{
		if (thePlayer.HasTag('ACS_WalkTypeChange_Activated'))
		{
			FactsRemove("ACS_BadassWalk");
			FactsRemove("ACS_DrunkWalk");
			FactsRemove("ACS_ZombieWalk");
			FactsRemove("ACS_BigHeavyWalk");
			FactsRemove("ACS_OlgierdWalk");
			FactsRemove("ACS_RichWalk");
			FactsRemove("ACS_TimidWalk");

			thePlayer.ACS_ClearAnimationSpeedMultipliers();

			thePlayer.ACS_SetAnimationSpeedMultiplier(1);

			walkSpeed = 1;

			thePlayer.RaiseEvent('ACS_WalkingAdditiveEnd');

			fastWalkDisabled = true;

			RemoveTimer('FastWalkCooldown');
			AddTimer('FastWalkCooldown', 1 , false);

			thePlayer.RemoveTag('ACS_WalkTypeChange_Activated');
		}
	}

	timer function FastWalkCooldown(deltaTime : float , id : int)
	{
		fastWalkDisabled = false;
	}

	var last_door_open_signal : float;

	function doors_manage( range : float, b : bool )
	{
		var i, j 												: int;
		var ents 												: array<CGameplayEntity>;
		var doorEnts 											: array<CEntity>;
		var doorsCmp											: CDoorComponent;		

		if (theGame.GetEngineTimeAsSeconds() - last_door_open_signal > 0.5f)
		{
			last_door_open_signal = theGame.GetEngineTimeAsSeconds();

			if (b)
			{
				if ((thePlayer.IsInCombat() 
				|| thePlayer.IsThreatened())
				&& thePlayer.IsAlive()
				)
				{
					ents.Clear();
					
					FindGameplayEntitiesInRange(ents,thePlayer,range,20,,FLAG_ExcludePlayer );

					if (ents.Size() <= 0)
					{
						return;
					}
					
					for ( i = 0; i < ents.Size(); i+=1 )
					{
						doorsCmp = ( CDoorComponent )ents[i].GetComponentByClassName('CDoorComponent');

						if (!doorsCmp)
						{
							continue;
						}

						ents[i].AddTag('ACS_Entity_Door_Forced_Open');

						if( doorsCmp 
						&& !doorsCmp.IsLocked() 
						&& !doorsCmp.IsTrapdoor()
						)
						{
							if(!doorsCmp.IsOpen() )
							{
								doorsCmp.Open( true, false );
							}
						}
					}
				}
			}
			else
			{
				doorEnts.Clear();
						
				theGame.GetEntitiesByTag( 'ACS_Entity_Door_Forced_Open', doorEnts );

				if (doorEnts.Size() <= 0)
				{
					return;
				}

				for( j=0; j<doorEnts.Size(); j+=1 )
				{	
					if (doorEnts[j].HasTag('ACS_Entity_Door_Forced_Open'))
					{
						doorsCmp = ( CDoorComponent )doorEnts[j].GetComponentByClassName('CDoorComponent');

						if( doorsCmp 
						&& !doorsCmp.IsLocked()
						&& doorsCmp.IsOpen() 
						&& !doorsCmp.IsTrapdoor()
						)
						{
							doorsCmp.Close( true );
						}

						doorEnts[j].RemoveTag('ACS_Entity_Door_Forced_Open');
					}
				}
			}
		}
	}

	var adrenaline_gain_stance, adrenaline_gain_prep : bool;

	default adrenaline_gain_stance = false;

	default adrenaline_gain_prep = false;

	timer function AdrenalineGainStart(dt:float,id:int)
	{	
		thePlayer.DestroyEffect('acs_adrenaline_gain');
		thePlayer.PlayEffectSingle('acs_adrenaline_gain');

		thePlayer.SoundEvent("gui_stamina_recharged");
		
		if (!adrenaline_gain_stance)
		{
			adrenaline_gain_stance = true;
		}
	}

	var cLean : EulerAngles;
	var combatLeanCheck : bool;

	function Player_In_Combat()
	{
		var cam_direction, lean_roll_modifier 				: float;
		
		if ((GetWitcherPlayer().IsInGuardedState()
		|| GetWitcherPlayer().IsGuarded())
		&& theInput.GetActionValue('GI_AxisLeftX') == 0
		&& theInput.GetActionValue('GI_AxisLeftY') == 0
		)
		{
			if (!adrenaline_gain_prep)
			{
				RemoveTimer('AdrenalineGainStart');
				AddTimer('AdrenalineGainStart', 7 , false);

				adrenaline_gain_prep = true;
			}

			if (adrenaline_gain_prep && adrenaline_gain_stance)
			{
				thePlayer.GainStat( BCS_Focus, thePlayer.GetStatMax( BCS_Focus ) * 0.001 );
			}
		}
		else
		{
			if (adrenaline_gain_prep)
			{
				thePlayer.DestroyEffect('acs_adrenaline_gain');

				RemoveTimer('AdrenalineGainStart');
				RemoveTimer('AdrenalineGain');

				adrenaline_gain_prep = false;
			}

			if (adrenaline_gain_stance)
			{
				adrenaline_gain_stance = false;
			}
		}

		if(
		!thePlayer.IsActionAllowed(EIAB_ExplorationFocus) 
		|| GetWitcherPlayer().IsCurrentSignChanneled()
		|| thePlayer.IsDoingSpecialAttack(true)
		|| thePlayer.IsDoingSpecialAttack(false)
		|| thePlayer.IsCastingSign()
		|| ACS_Cast_Sign_Process
		|| !theGame.GetFocusModeController().CanUseFocusMode()
		|| thePlayer.IsInCombat()
		|| swimmingMeleeCheck
		|| swimmingAardCheck
		|| swimmingDodgeCheck
		|| swimmingCounterCheck
		) 
		{
			if (medallion_hold_anim_active)
			{
				thePlayer.RaiseEvent('ACS_MedallionHoldReset');

				medallion_hold_anim_active = false;
			}
		}
		
		if ((thePlayer.IsInCombat() 
		|| thePlayer.IsThreatened())
		&& thePlayer.IsAlive()
		)
		{
			if (clair_obscur_music_enabled
			|| doom_music_enabled
			|| witcher_1_music_enabled
			|| witcher_2_music_enabled
			|| gwent_music_enabled
			|| witcher_3_select_music_enabled
			)
			{
				if (!acs_combat_music_playing)
				{
					RemoveTimer('EnableExplorationMusic');
					RemoveTimer('DisableMusic');
					RemoveTimer('EnableMusic');

					if (!acs_combat_music_is_currently_playing)
					{
						AddTimer('EnableMusic', 1 , false);
					}

					acs_combat_music_playing = true;
				}
			}

			if (medallion_hold_anim_active)
			{
				thePlayer.RaiseEvent('ACS_MedallionHoldReset');

				medallion_hold_anim_active = false;
			}

			if (thePlayer.IsActionAllowed(EIAB_Movement)
			&& ACS_Settings_Main_Bool('acs_movement_main_settings','acs_auto_climb_enabled', true)
			&& !thePlayer.IsSwimming()
			&& !thePlayer.IsDiving()
			&& thePlayer.GetCurrentStateName() != 'Swimming'
			&& thePlayer.GetCurrentStateName() != 'HorseRiding'
			&& thePlayer.GetCurrentStateName() != 'Sailing'
			&& thePlayer.GetCurrentStateName() != 'SailingPassive'
			&& thePlayer.GetCurrentStateName() != 'MountHorse'
			&& thePlayer.GetCurrentStateName() != 'MountBoat'
			&& !thePlayer.IsThrowingItem()
			&& !thePlayer.IsThrowingItemWithAim()
			&& !thePlayer.IsThrowHold()
			&& !thePlayer.IsCrossbowHeld()
			&& !thePlayer.IsCurrentlyDodging()
			&& !thePlayer.HasTag('ACS_Is_Currently_Dodging')
			&& !GetWitcherPlayer().IsPerformingFinisher()
			&& !thePlayer.HasTag('ACS_IsPerformingFinisher')
			&& !thePlayer.HasTag('ACS_IsPerformingCombatDismember')
			&& !thePlayer.HasTag('ACS_In_Combat_Art')
			&& !thePlayer.HasTag('ACS_Ghost_Stance_Active')
			&& !thePlayer.HasTag('ACS_Is_Sneaking')
			&& !thePlayer.HasTag('ACS_In_Heavenly_Strike')
			&& !thePlayer.HasTag('ACS_In_Dance_Of_Wrath')
			&& !thePlayer.HasTag('ACS_In_Combat_Art')
			&& !thePlayer.HasTag('ACS_Neutral_Flip')
			&& !thePlayer.HasTag('ACS_Bruxa_Bite_Process')
			&& !thePlayer.HasTag('ACS_Transformation_Bruxa_Cloaked')
			&& !thePlayer.IsInsideInteraction()
			&& !Enemy_Attack_From_Behind_Evade_Process
			&& VecDistanceSquared( thePlayer.GetWorldPosition(), (thePlayer.GetHorseWithInventory()).GetWorldPosition() ) > 4 * 4 
			)
			{
				if (
				(theInput.IsActionPressed('Sprint') || thePlayer.GetIsSprinting())
				&& (theInput.GetActionValue('GI_AxisLeftX') != 0 || theInput.GetActionValue('GI_AxisLeftY') != 0) 
				)
				{
					if (thePlayer.GetCurrentStateName() != 'Exploration')
					{
						thePlayer.GotoState( 'Exploration' );
					}

					return;
				}


				if (
				thePlayer.substateManager.GetStateCur() == 'Jump' 
				|| thePlayer.substateManager.GetStateCur() == 'Interaction' 
				|| thePlayer.substateManager.GetStateCur() == 'Climb'
				|| thePlayer.substateManager.GetStateCur() == 'Slide'
				)
				{
					if (thePlayer.GetCurrentStateName() != 'Exploration')
					{
						thePlayer.GotoState( 'Exploration' );
					}

					return;
				}
			}
			
			if (fast_sprint_activated)
			{
				ACSGetCEntityDestroyAll('ACS_Player_Fast_Sprint_Trail');

				thePlayer.ACS_ClearAnimationSpeedMultipliers();

				thePlayer.ACS_SetAnimationSpeedMultiplier(1);

				sprintSpeed = 1;

				sprintSpeedFinal = 1;

				sprintSpeedDistance = 0;

				sprintSpeedDistanceFinal = 0;

				movementAdjustor = thePlayer.GetMovingAgentComponent().GetMovementAdjustor();

				movementAdjustor.CancelAll();

				thePlayer.RaiseEvent('ACS_TorsoBendReset');

				fast_sprint_activated = false;
			}

			ResetFastWalk();

			if (!CutsceneDelayCheck())
			{
				return;
			}

			if ( thePlayer.IsPCModeEnabled() )
			{
				cam_direction = theInput.GetActionValue( 'GI_MouseDampX' );
			}
			else
			{
				cam_direction = theInput.GetActionValue( 'GI_AxisRightX' );
			}

			lean_roll_modifier = 0.25f;

			if( cam_direction < 0 )
			{
				if (combatLeanCheck)
				{
					combatLeanCheck = false;
				}

				cLean.Roll -= lean_roll_modifier;

				if(cLean.Roll < -15)
				{
					cLean.Roll = -15;
				}
			}
			else if(theInput.GetActionValue('GI_AxisLeftX') > 0
			)
			{
				if(combatLeanCheck
				)
				{
					if(cLean.Roll < 0)
					{
						cLean.Roll += lean_roll_modifier;
					}
					
					if(cLean.Roll > 0)
					{
						cLean.Roll -= lean_roll_modifier;
					}
				}
				else
				{
					cLean.Roll += lean_roll_modifier;

					if(cLean.Roll > 15)
					{
						cLean.Roll = 15;

						if (!combatLeanCheck)
						{
							combatLeanCheck = true;
						}
					}
				}
			}

			if( cam_direction > 0)
			{
				if (combatLeanCheck)
				{
					combatLeanCheck = false;
				}

				cLean.Roll += lean_roll_modifier;

				if(cLean.Roll > 15)
				{
					cLean.Roll = 15;
				}
			}
			else if(theInput.GetActionValue('GI_AxisLeftX') < 0
			)
			{
				if(combatLeanCheck
				)
				{
					if(cLean.Roll < 0)
					{
						cLean.Roll += lean_roll_modifier;
					}
					
					if(cLean.Roll > 0)
					{
						cLean.Roll -= lean_roll_modifier;
					}
				}
				else
				{
					cLean.Roll -= lean_roll_modifier;

					if(cLean.Roll < -15)
					{
						cLean.Roll = -15;

						if (!combatLeanCheck)
						{
							combatLeanCheck = true;
						}
					}
				}
			}

			if(theInput.GetActionValue('GI_AxisLeftX') == 0
			&& cam_direction == 0
			)
			{
				if (combatLeanCheck)
				{
					combatLeanCheck = false;
				}

				if(cLean.Roll < 0)
				{
					cLean.Roll += lean_roll_modifier;
				}
				
				if(cLean.Roll > 0)
				{
					cLean.Roll -= lean_roll_modifier;
				}
			}

			doors_manage(1.5, true);

			SetPlayerTarget();

			if (thePlayer.HasTag('ACS_Is_Sneaking'))
			{
				return;
			}
			
			HorseKickRunning();

			CloakUnequip();

			if(thePlayer.HasTag('ACS_Camo_Active'))
			{
				if (theInput.GetActionValue('GI_AxisLeftX') == 0 && theInput.GetActionValue('GI_AxisLeftY') == 0 )
				{
					thePlayer.DrainVitality( thePlayer.GetStat( BCS_Vitality ) * 0.00005 );
				}
				else
				{
					thePlayer.DrainVitality( thePlayer.GetStat( BCS_Vitality ) * 0.00025 );
				}
			}

			if(thePlayer.HasTag('ACS_AardPull_Active'))
			{
				if (thePlayer.GetStat( BCS_Stamina ) > 0.01)
				{
					ACS_Bat_Damage();
				}
				else
				{
					ACS_AardPull_Deactivate();
				}	
			}

			if (FactsQuerySum("acs_transformation_activated") <= 0
			&& FactsQuerySum("ACS_Azkar_Active") <= 0
			&& FactsQuerySum("ACS_Slayer_Active") <= 0
			&& !thePlayer.HasTag('ACS_Ghost_Stance_Active')
			&& !thePlayer.IsDoingSpecialAttack( false )
			&& !thePlayer.IsDoingSpecialAttack( true )
			&& !thePlayer.IsCastingSign()
			&& !ACS_Cast_Sign_Process
			&& ACS_Settings_Main_Bool('acs_combat_main_settings','acs_adrenaline_drain', true)
			&& !thePlayer.IsInAir()
			&& !thePlayer.IsFalling()
			&& !thePlayer.GetInventory().ItemHasTag( thePlayer.GetInventory().GetCurrentlyHeldSword(), 'acsmagestaff' )
			&& !thePlayer.HasTag('ACS_In_Combat_Art')
			&& !adrenaline_gain_stance
			&& !ACS_IS_SNEAKING
			&& !thePlayer.HasTag('ACS_Is_Sneaking')
			&& !thePlayer.IsUsingHorse()
			&& !thePlayer.IsUsingVehicle()
			)
			{
				if (adrenalineDrain)
				{
					if (thePlayer.GetStat(BCS_Focus) >= thePlayer.GetStatMax( BCS_Focus ) * 0.9875)
					{
						thePlayer.DrainFocus(thePlayer.GetStatMax( BCS_Focus ) * 0.00025);
					}
					else
					{
						thePlayer.DrainFocus(thePlayer.GetStatMax( BCS_Focus ) * 0.0005);
					}
				}
			}

			//////////////////////////////////////// MANAGER TODO

			Necrofiend_Manager();

			ShadesKara_Spawn_Adds_Manager();

			Nekker_Guardian_Manager();

			ACS_Fire_Bear_Flames_Manager();

			ACS_KnightmareEternumManager();

			ACS_RatMageManager();

			ACS_SheWhoKnowsManager();

			ACS_VampireMonsterManager();

			ACS_CanarisManager();

			ACS_FireGargoyleManager();

			ACS_ShrekManager();

			ACS_FluffyManager();

			ACS_FogAssassinManager();

			ACS_DuskwraithManager();

			ACS_DraugManager();

			//ACS_Bat_Projectile_Manager();

			////////////////////////////////////////

			if ((theGame.GetEngineTimeAsSeconds() - last_rage_marker_spawn_time > ACS_RageMechanicCooldown())
			&& ACS_RageMechanic_Enabled()
			&& !thePlayer.IsUsingHorse()
			&& !thePlayer.IsUsingVehicle()
			&& !thePlayer.HasTag('ACS_IsPerformingFinisher')
			&& !thePlayer.HasTag('ACS_IsPerformingCounterWound')
			&& !ACSGetCActor('ACS_Stab_Hostage')
			&& !thePlayer.IsInAir()
			&& !thePlayer.IsFalling()
			&& !thePlayer.HasTag('ACS_Ghost_Stance_Active')
			&& !thePlayer.HasTag('ACS_Bruxa_Bite_Process')
			&& !thePlayer.HasTag('ACS_Transformation_Bruxa_Cloaked')
			&& FactsQuerySum("ACS_Mounted_Attack_Attachment_Active") <= 0 
			&& FactsQuerySum("ACS_Bloodsmoke_Active") <= 0
			&& !stab_hostage_enabled
			&& !ACS_IS_SNEAKING
			&& !thePlayer.HasTag('ACS_Is_Sneaking')
			)
			{
				last_rage_marker_spawn_time = theGame.GetEngineTimeAsSeconds();

				RemoveTimer('rage_counter_reset');
				rage_counter -= rage_counter;

				RemoveTimer('RemoveSignComboStuffRepeating');
				RemoveTimer('RemoveSignComboStuff');
				ACSGetCEntityDestroyAll('ACS_Sign_Combo_Icon');
				ACSSignComboSystemRemoveTags();

				Remove_On_Hit_Tags();

				ACSGetCEntityDestroyAll('ACS_Rage_Marker_1');

				ACSGetCEntityDestroyAll('ACS_Rage_Marker_2');

				ACSGetCEntityDestroyAll('ACS_Rage_Marker_Player_1');

				vACS_Rage_Marker = new cACS_Rage_Marker in this;

				vACS_Rage_Marker.ACS_Rage_Marker_Player_Pre_Engage();

				RemoveTimer('ACS_Rage_Delay');

				AddTimer('ACS_Rage_Delay', 1 , false);
			}

			////////////////////////////////////////
		}
		else
		{
			if (acs_combat_music_playing)
			{
				RemoveTimer('EnableExplorationMusic');
				RemoveTimer('DisableMusic');
				RemoveTimer('EnableMusic');

				if (acs_combat_music_is_currently_playing)
				{
					AddTimer('DisableMusic', 6 , false);
				}

				acs_combat_music_playing = false;
			}

			if (combatLeanCheck)
			{
				combatLeanCheck = false;
			}

			if(cLean.Roll < 0)
			{
				cLean.Roll += 0.25;
			}
			else if(cLean.Roll > 0)
			{
				cLean.Roll -= 0.25;
			}
			else
			{
				cLean.Roll = 0;
			}
			
			if(cloakHidden)
			{
				ACS_EquipCloak();

				if (FactsQuerySum("ACS_Virtual_Cloak_Temporarily_Unequipped") > 0)
				{
					if (thePlayer.HasTag('ACS_IsSwordWalking'))
					{
						thePlayer.RemoveTag('ACS_IsSwordWalking');
					}

					RemoveTimer('SwordTauntSwitch'); 
					RemoveTimer('SwordTauntRunningSwitch'); 
					 
					 

					if ( thePlayer.IsHoldingItemInLHand() ) 
					{
						thePlayer.OnUseSelectedItem( true );
					}

					if ( thePlayer.IsCrossbowHeld() ) 
					{
						thePlayer.OnRangedForceHolster( false, true );
					}

					cloakaniminprogress = true;

					RemoveTimer('CloakAnimProgressSet');
					AddTimer('CloakAnimProgressSet', 2 , false);

					thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');

					thePlayer.RaiseEvent('ACS_CloakEnabled');
					
					RemoveTimer('CloakToggleDelay');
					AddTimer('CloakToggleDelay', 0.5 , false);

					FactsRemove("ACS_Virtual_Cloak_Temporarily_Unequipped");
				}

				cloakHidden = false;
			}

			doors_manage(1.5, false);
		}
	}

	var drunkWalkChangeStage1, drunkWalkChangeStage2, drunkWalkChangeStage3, drunkIdleChangeStage1, drunkIdleChangeStage2, drunkIdleChangeStage3 									: bool;

	default drunkWalkChangeStage1 = false;

	default drunkWalkChangeStage2 = false;

	default drunkWalkChangeStage3 = false;

	default drunkIdleChangeStage1 = false;

	default drunkIdleChangeStage2 = false;

	default drunkIdleChangeStage3 = false;


	var last_idle_additive_action : float;

	var idle_additive_cooldown : float;

	private var idle_additive_index_1																										: int;
	default idle_additive_index_1 																											= -1;

	private var previous_idle_additive_index_1																								: int;
	default previous_idle_additive_index_1 																									= -1;

	default idle_additive_cooldown 																											= 7.5;

	var idleAdditiveBlock 																													: bool;

	default idleAdditiveBlock 																												= false;

	timer function RemoveIdleAdditiveBlock ( dt : float, id : int )
	{
		idleAdditiveBlock = false;
	}

	function IdleAdditiveBlockTemp()
	{
		if(!idleAdditiveBlock)
		{
			idleAdditiveBlock = true;
		}

		RemoveTimer('RemoveIdleAdditiveBlock');
		AddTimer('RemoveIdleAdditiveBlock', 3 , false);
	}

	function IdleAdditivesControl()
	{
		var component 								: CInteractionComponent;

		component = theGame.GetInteractionsManager().GetActiveInteraction();

		if (component)
		{
			IdleAdditiveBlockTemp();
		}

		if ((thePlayer.playerMoveType == PMT_Walk || thePlayer.playerMoveType == PMT_Idle)
		&& thePlayer.GetBehaviorVariable('alternateWalk') == 0
		&& thePlayer.GetBehaviorVariable('proudWalk') == 0
		&& !thePlayer.GetIsRunning()
		&& !thePlayer.GetIsSprinting()
		&& !thePlayer.IsCurrentlyDodging()
		&& !thePlayer.HasTag('ACS_Is_Currently_Dodging')
		&& !thePlayer.HasTag('ACS_IsManagingSword')
		&& !thePlayer.HasTag('acs_in_wraith')
		&& thePlayer.GetPlayerAction() == PEA_None
		&& !thePlayer.GetWeaponHolster().IsOnTheMiddleOfHolstering()
		&& !thePlayer.IsInHitAnim()
		&& !thePlayer.HasTag('ACS_IsPerformingFinisher')
		&& !thePlayer.HasTag('ACS_IsPerformingCombatDismember')
		&& !idleAdditiveBlock
		&& !thePlayer.IsCrossbowHeld()
		&& ACS_BuffCheck()
		&& thePlayer.IsActionAllowed(EIAB_Movement)
		&& ACS_CombatToExplorationCheck()
		&& !thePlayer.IsInCombat() 
		&& !thePlayer.IsInCombatState()
		&& !thePlayer.IsInCombatAction()
		&& !thePlayer.IsSwimming()
		&& !thePlayer.IsDiving()
		&& !thePlayer.IsUsingHorse()
		&& !thePlayer.IsUsingVehicle()
		&& !ACSGetCEntity('ACS_Lute')
		&& !ACSGetCEntity('ACS_Pipe')
		&& !ACSGetCEntity('ACS_Flute')
		&& AnimProgressCheck()
		&& theInput.GetActionValue( 'Jump' ) == 0
		&& !thePlayer.IsFalling()
		&& !thePlayer.HasBuff(EET_Drunkenness)
		&& !thePlayer.HasTag('ACS_Is_Sneaking')
		&& thePlayer.GetStat(BCS_Vitality) > thePlayer.GetStatMax(BCS_Vitality) * 0.3
		&& !theGame.IsDialogOrCutscenePlaying() 
		&& thePlayer.IsAlive()
		&& !thePlayer.IsInCutsceneIntro()
		&& !theGame.HasBlackscreenRequested()
		&& !theGame.IsCurrentlyPlayingNonGameplayScene()
		&& !theGame.GetGuiManager().IsAnyMenu()
		&& !thePlayer.IsCastingSign()
		&& !ACS_Cast_Sign_Process
		&& !GetTransformationCamera()
		&& !GetKestralCamera()
		&& !GetPlayerCamera()
		&& FactsQuerySum("ACS_In_Meditation") <= 0 
		&& !thePlayer.IsInsideInteraction()
		&& !theGame.IsFocusModeActive()
		&& theInput.GetActionValue('Focus') == 0
		&& theGame.GetFocusModeController().CanUseFocusMode()
		&& thePlayer.substateManager.GetStateCur() != 'Climb'
		&& thePlayer.substateManager.GetStateCur() != 'Interaction'
		&& !thePlayer.IsHoldingItemInLHand()
		&& !ACSGetCEntity('ACS_Viper_Dagger_L')
		&& !thePlayer.HasTag('ACS_Dual_Wield_Active')
		&& !ACSGetCEntity('ACS_Dual_Wield_L_Sword_Steel')
		&& !ACSGetCEntity('ACS_Dual_Wield_L_Sword_Silver')
		//&& ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() != 'grass_short'
		)
		{
			if(theGame.GetEngineTimeAsSeconds() - last_idle_additive_action > idle_additive_cooldown)
			{
				last_idle_additive_action = theGame.GetEngineTimeAsSeconds();

				idle_additive_index_1 = RandDifferent(this.previous_idle_additive_index_1 , 11);

				switch (idle_additive_index_1) 
				{	
					case 10:
					if (thePlayer.IsAnyWeaponHeld() && !thePlayer.IsWeaponHeld('fist'))
					{
						if (thePlayer.IsInInterior() || RoofCheck() )
						{
							thePlayer.RaiseEvent('ACS_IdleAdditiveKnifeplay04');
						}
						else
						{
							thePlayer.RaiseEvent('ACS_IdleAdditiveKnifeplay03');
						}
					}
					else
					{
						thePlayer.RaiseEvent('ACS_IdleAdditiveTired01');
					}
					break;

					case 9:
					if (thePlayer.IsAnyWeaponHeld() && !thePlayer.IsWeaponHeld('fist'))
					{
						thePlayer.RaiseEvent('ACS_IdleAdditiveKnifeplay04');
					}
					else
					{
						thePlayer.RaiseEvent('ACS_IdleAdditiveTired02');
					}
					break;

					case 8:
					if (thePlayer.IsAnyWeaponHeld() && !thePlayer.IsWeaponHeld('fist'))
					{
						thePlayer.RaiseEvent('ACS_IdleAdditiveShrugSkipHands');
					}
					else
					{
						thePlayer.RaiseEvent('ACS_IdleAdditiveShrug');
					}
					break;

					case 7:
					if (thePlayer.IsAnyWeaponHeld() && !thePlayer.IsWeaponHeld('fist'))
					{
						thePlayer.RaiseEvent('ACS_IdleAdditiveRightShoulderRelaxSkipHands');
					}
					else
					{
						thePlayer.RaiseEvent('ACS_IdleAdditiveRightShoulderRelax');
					}
					break;

					case 6:
					if (thePlayer.IsAnyWeaponHeld() && !thePlayer.IsWeaponHeld('fist'))
					{
						thePlayer.RaiseEvent('ACS_IdleAdditiveLeftShoulderRelaxSkipHands');
					}
					else
					{
						thePlayer.RaiseEvent('ACS_IdleAdditiveLeftShoulderRelax');
					}
					break;

					case 5:
					if (thePlayer.IsAnyWeaponHeld() && !thePlayer.IsWeaponHeld('fist'))
					{
						thePlayer.RaiseEvent('ACS_IdleAdditiveFlex02SkipHands');
					}
					else
					{
						thePlayer.RaiseEvent('ACS_IdleAdditiveFlex02');
					}
					break;

					case 4:
					if (thePlayer.IsAnyWeaponHeld() && !thePlayer.IsWeaponHeld('fist'))
					{
						thePlayer.RaiseEvent('ACS_IdleAdditiveFlex01SkipHands');
					}
					else
					{
						thePlayer.RaiseEvent('ACS_IdleAdditiveFlex01');
					}
					break;

					case 3:
					if (thePlayer.IsAnyWeaponHeld() && !thePlayer.IsWeaponHeld('fist'))
					{
						thePlayer.RaiseEvent('ACS_IdleAdditiveSwordCheck02');
					}
					else
					{
						thePlayer.RaiseEvent('ACS_IdleAdditivePantsCheck');
					}
					break;
					
					case 2:
					if (thePlayer.IsAnyWeaponHeld() && !thePlayer.IsWeaponHeld('fist'))
					{
						thePlayer.RaiseEvent('ACS_IdleAdditiveSwordCheck01');
					}
					else
					{
						thePlayer.RaiseEvent('ACS_IdleAdditiveGlovesCheck');
					}
					break;
					
					case 1:
					if (thePlayer.IsAnyWeaponHeld() && !thePlayer.IsWeaponHeld('fist'))
					{
						thePlayer.RaiseEvent('ACS_IdleAdditiveHeavyMeleeCheck');
					}
					else
					{
						thePlayer.RaiseEvent('ACS_IdleAdditiveArmorCheck');
					}
					break;

					default:
					if (thePlayer.IsAnyWeaponHeld() && !thePlayer.IsWeaponHeld('fist'))
					{
						thePlayer.RaiseEvent('ACS_IdleAdditiveArmRelaxSkipHands');
					}
					else
					{
						thePlayer.RaiseEvent('ACS_IdleAdditiveArmRelax');
					}
					break;
				}

				this.previous_idle_additive_index_1 = idle_additive_index_1;

				idle_additive_cooldown = RandRangeF(15,10);

				if (!idleAdditiveExtraActive)
				{
					SetIdleAdditiveExtraStatus(true);
				}
			}
		}
		else
		{
			if (idleAdditiveExtraActive)
			{
				thePlayer.RaiseEvent('ACS_IdleAdditiveReset');

				SetIdleAdditiveExtraStatus(false);
			}
		}
	}

	var playerRunningAdditiveName : array< CName >;

	var field_of_reeds_anim_active : bool;

	var field_of_reeds_anim_cooldown : float;

	function WalkTypeControl()
	{
		var dest1 												: Vector;
		var item												: SItemUniqueId;
		var idleTypes											: array<name>;	

		if( 
		theGame.IsDialogOrCutscenePlaying() 
		|| !thePlayer.IsAlive()
		|| thePlayer.IsInCutsceneIntro()
		|| theGame.HasBlackscreenRequested()
		|| theGame.IsCurrentlyPlayingNonGameplayScene()
		|| theGame.GetGuiManager().IsAnyMenu()
		|| theGame.GetTutorialSystem().HasActiveTutorial()
		|| theGame.GetPhotomodeEnabled() 
		|| theGame.IsFading()
		|| theGame.IsBlackscreen()
		)
		{
			return;
		}

		if (!thePlayer.IsSwimming() 
		&& !thePlayer.IsDiving())
		{
			if (thePlayer.GetSubmergeDepth() != 0)
			{
				thePlayer.SetSubmergeDepth(0);
			}

			if( thePlayer.GetBehaviorVariable('submergeDepth') != 0 
			)
			{
				thePlayer.SetBehaviorVariable( 'submergeDepth', 0, true );
			}
		}


		// idle additives

		if ( 
		//((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'grass_short'
		//&& 
		thePlayer.playerMoveType == PMT_Walk
		&& thePlayer.GetBehaviorVariable('alternateWalk') == 0
		&& thePlayer.GetBehaviorVariable('proudWalk') == 0
		&& !thePlayer.GetIsRunning()
		&& !thePlayer.GetIsSprinting()
		&& !thePlayer.IsCurrentlyDodging()
		&& !thePlayer.HasTag('ACS_Is_Currently_Dodging')
		&& !thePlayer.HasTag('ACS_IsManagingSword')
		&& !thePlayer.HasTag('acs_in_wraith')
		&& thePlayer.GetPlayerAction() == PEA_None
		&& !thePlayer.GetWeaponHolster().IsOnTheMiddleOfHolstering()
		&& !thePlayer.IsInHitAnim()
		&& !thePlayer.HasTag('ACS_IsPerformingFinisher')
		&& !thePlayer.HasTag('ACS_IsPerformingCombatDismember')
		&& !idleAdditiveBlock
		&& !thePlayer.IsCrossbowHeld()
		&& ACS_BuffCheck()
		&& thePlayer.IsActionAllowed(EIAB_Movement)
		&& ACS_CombatToExplorationCheck()
		&& !thePlayer.IsInCombat() 
		&& !thePlayer.IsInCombatState()
		&& !thePlayer.IsInCombatAction()
		&& !thePlayer.IsSwimming()
		&& !thePlayer.IsDiving()
		&& !thePlayer.IsUsingHorse()
		&& !thePlayer.IsUsingVehicle()
		&& !ACSGetCEntity('ACS_Lute')
		&& !ACSGetCEntity('ACS_Pipe')
		&& !ACSGetCEntity('ACS_Flute')
		&& AnimProgressCheck()
		&& theInput.GetActionValue( 'Jump' ) == 0
		&& !thePlayer.IsFalling()
		&& !thePlayer.HasBuff(EET_Drunkenness)
		&& !thePlayer.HasTag('ACS_Is_Sneaking')
		&& thePlayer.GetStat(BCS_Vitality) > thePlayer.GetStatMax(BCS_Vitality) * 0.3
		&& !theGame.IsDialogOrCutscenePlaying() 
		&& thePlayer.IsAlive()
		&& !thePlayer.IsInCutsceneIntro()
		&& !theGame.HasBlackscreenRequested()
		&& !theGame.IsCurrentlyPlayingNonGameplayScene()
		&& !theGame.GetGuiManager().IsAnyMenu()
		&& !thePlayer.IsCastingSign()
		&& !ACS_Cast_Sign_Process
		&& !GetTransformationCamera()
		&& !GetKestralCamera()
		&& !GetPlayerCamera()
		&& FactsQuerySum("ACS_In_Meditation") <= 0 
		&& !thePlayer.IsInsideInteraction()
		&& !theGame.IsFocusModeActive()
		&& theInput.GetActionValue('Focus') == 0
		&& theGame.GetFocusModeController().CanUseFocusMode()
		&& thePlayer.substateManager.GetStateCur() != 'Climb'
		&& thePlayer.substateManager.GetStateCur() != 'Interaction'
		&& !thePlayer.IsHoldingItemInLHand()
		&& !ACSGetCEntity('ACS_Viper_Dagger_L')
		&& !thePlayer.HasTag('ACS_Dual_Wield_Active')
		&& !ACSGetCEntity('ACS_Dual_Wield_L_Sword_Steel')
		&& !ACSGetCEntity('ACS_Dual_Wield_L_Sword_Silver')
		&& !thePlayer.HasTag('ACS_Drawn_Weapon')
		&& theGame.GetWorld().GetDepotPath() != "dlc\dlc_acs_worlds\data\levels\acs_waterworld\acs_waterworld.w2w"
		&& thePlayer.substateManager.GetStateTimeF() > 5
		&& (((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'grass_short' 
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'grass_long'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'water_deep'
		)
		)
		{
			if (theGame.GetEngineTimeAsSeconds() - field_of_reeds_anim_cooldown > 3)
			{
				field_of_reeds_anim_cooldown = theGame.GetEngineTimeAsSeconds();

				if (!field_of_reeds_anim_active)
				{
					if (thePlayer.IsAnyWeaponHeld())
					{
						thePlayer.RaiseEvent('ACS_FieldOfReedsL');
					}
					else
					{
						if (RandF() < 0.75)
						{
							thePlayer.RaiseEvent('ACS_FieldOfReedsR');
						}
						else
						{
							thePlayer.RaiseEvent('ACS_FieldOfReedsL');
						}
					}

					field_of_reeds_anim_active = true;
				}
			}
		}
		else
		{
			if (field_of_reeds_anim_active)
			{
				thePlayer.RaiseEvent('ACS_FieldOfReedsEnd');

				field_of_reeds_anim_active = false;
			}
		}
		
		IdleAdditivesControl();

		if( thePlayer.GetBehaviorVariable('alternateWalk') != 2 
		&& thePlayer.GetBehaviorVariable('proudWalk') != 1 
		)
		{
			if( thePlayer.GetStat(BCS_Vitality) <= thePlayer.GetStatMax(BCS_Vitality) * 0.3
			&& !thePlayer.IsInCombat()
			&& !thePlayer.IsThreatened()
			)
			{
				if( thePlayer.GetBehaviorVariable('alternateWalk') != 1 )
				{
					ResetFastWalk();

					thePlayer.SetBehaviorVariable('alternateWalk', 1 );
				}
			}
			else
			{
				if( thePlayer.GetBehaviorVariable('alternateWalk') != 0 )
				{
					ResetFastWalk();

					thePlayer.SetBehaviorVariable('alternateWalk', 0 );
				}
			}
		}

		if (fast_sprint_activated)
		{
			if (thePlayer.GetIsSprinting()
			&& !thePlayer.IsCurrentlyDodging()
			&& !thePlayer.HasTag('ACS_Is_Currently_Dodging')
			&& !thePlayer.IsInHitAnim()
			&& !thePlayer.HasTag('ACS_IsPerformingFinisher')
			&& !thePlayer.HasTag('ACS_IsPerformingCombatDismember')
			&& !thePlayer.IsCrossbowHeld()
			&& ACS_BuffCheck()
			&& thePlayer.IsActionAllowed(EIAB_Movement)
			&& ACS_CombatToExplorationCheck()
			&& !thePlayer.IsInCombat() 
			&& !thePlayer.IsInCombatState()
			&& !thePlayer.IsInCombatAction()
			&& thePlayer.GetStat( BCS_Stamina ) > 0
			&& thePlayer.GetStat(BCS_Vitality) > thePlayer.GetStatMax(BCS_Vitality) * 0.3
			&& !thePlayer.IsSwimming()
			&& !thePlayer.IsDiving()
			&& !thePlayer.IsUsingHorse()
			&& !thePlayer.IsUsingVehicle()
			&& (currspeed == 4 && ACS_Settings_Main_Bool('acs_movement_main_settings','acs_modular_movement_speed_enabled', true))
			)
			{
				ResetFastWalk();

				if (
				( ACS_GetWeaponMode() == 0 && ACS_Settings_Main_Int('acs_combat_main_settings','acs_fist_mode', 0) == 1 )
				|| ( ACS_GetWeaponMode() == 1 && ACS_Settings_Main_Int('acs_combat_main_settings','acs_fist_mode', 0) == 1 )
				|| ( ACS_GetWeaponMode() == 2 && ACS_Settings_Main_Int('acs_combat_main_settings','acs_fist_mode', 0) == 1 )
				|| ( ACS_GetWeaponMode() == 3 && (ACS_GetItem_VampClaw('shades') || ACS_GetItem_VampClaw('default') ) )
				|| ACS_Armor_Set_Check('acs_armor', false)
				)
				{
					sprintSpeedModifier = 3.0f;
				}
				else
				{
					sprintSpeedModifier = 2.0f;
				}

				if(sprintSpeed >= (sprintSpeedModifier - 0.66f))
				{
					if (ACS_Settings_Main_Bool('acs_stamina_settings','acs_fast_sprint_stamina_cost_action', true))
					{
						if( GetWitcherPlayer().GetInventory().GetItemEquippedOnSlot(EES_Armor, item) )
						{
							if( GetWitcherPlayer().GetInventory().ItemHasTag(item, 'HeavyArmor') )
							{
								sprintStaminaDrainRate = 0.5;
							}
							else if( GetWitcherPlayer().GetInventory().ItemHasTag(item, 'MediumArmor') )
							{
								sprintStaminaDrainRate = 0.75;
							}
							else if( GetWitcherPlayer().GetInventory().ItemHasTag(item, 'LightArmor') )
							{
								sprintStaminaDrainRate = 1;
							}
							else
							{
								sprintStaminaDrainRate = 1;
							}
						}
						else
						{
							sprintStaminaDrainRate = 1;
						}

						if(theGame.GetEngineTimeAsSeconds() - last_fast_sprint_stamina_drain > sprintStaminaDrainRate)
						{
							last_fast_sprint_stamina_drain = theGame.GetEngineTimeAsSeconds();
						
							thePlayer.DrainStamina( ESAT_FixedValue,  thePlayer.GetStatMax( BCS_Stamina ) * ACS_Settings_Main_Float('acs_stamina_settings','acs_fast_sprint_stamina_cost', 0.05), ACS_Settings_Main_Float('acs_stamina_settings','acs_fast_sprint_stamina_regen_delay', 1) );
						}
					}

					sprintSpeed = (sprintSpeedModifier - 0.66f);

					if (thePlayer.GetStat( BCS_Stamina ) <= thePlayer.GetStatMax( BCS_Stamina ) * 0.33)
					{
						sprintSpeedFinal = sprintSpeed - (((thePlayer.GetStatMax(BCS_Stamina) - thePlayer.GetStat( BCS_Stamina )) / thePlayer.GetStatMax(BCS_Stamina)) * 0.75);
					}
					else
					{
						sprintSpeedFinal = sprintSpeed;
					}
				}
				else
				{
					sprintSpeed += 0.001;

					sprintSpeedFinal = sprintSpeed;
				}

				if (sprintSpeedDistance >= sprintSpeedModifier)
				{
					sprintSpeedDistance = sprintSpeedModifier;

					if (thePlayer.GetStat( BCS_Stamina ) <= thePlayer.GetStatMax( BCS_Stamina ) * 0.33)
					{
						sprintSpeedDistanceFinal = sprintSpeedDistance - (((thePlayer.GetStatMax(BCS_Stamina) - thePlayer.GetStat( BCS_Stamina )) / thePlayer.GetStatMax(BCS_Stamina)) * 1);
					}
					else
					{
						sprintSpeedDistanceFinal = sprintSpeedDistance;
					}
				}
				else
				{
					sprintSpeedDistance += 0.005;

					sprintSpeedDistanceFinal = sprintSpeedDistance;
				}
				
				MovementAdjust('bruxa_dash');
	
				dest1 = thePlayer.GetWorldPosition() + thePlayer.GetHeadingVector() * (sprintSpeedDistanceFinal + sprintSpeedFinal);// + theCamera.GetCameraDirection() * (1 + sprintSpeedFinal);

				//if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTo( ticket, VecHeading( theCamera.GetCameraDirection() ) );}
					
				movementAdjustor.SlideTo( ticket, dest1 );
				
				sprintSpeedFinal = ClampF(sprintSpeedFinal, 1.f, 1.33f);

				thePlayer.ACS_SetAnimationSpeedMultiplier(sprintSpeedFinal);
			}
			else
			{
				if (fast_sprint_activated)
				{
					ACSGetCEntityDestroyAll('ACS_Player_Fast_Sprint_Trail');

					sprintSpeed = 1;

					sprintSpeedFinal = 1;

					sprintSpeedDistance = 0;

					sprintSpeedDistanceFinal = 0;

					movementAdjustor = thePlayer.GetMovingAgentComponent().GetMovementAdjustor();

					movementAdjustor.CancelAll();

					thePlayer.ACS_ClearAnimationSpeedMultipliers();

					thePlayer.ACS_SetAnimationSpeedMultiplier(1);

					thePlayer.RaiseEvent('ACS_TorsoBendReset');

					fast_sprint_activated = false;
				}
			}
		}

		if ((thePlayer.GetIsRunning() || thePlayer.GetIsSprinting())
		&& !thePlayer.IsCurrentlyDodging()
		&& !thePlayer.HasTag('ACS_Is_Currently_Dodging')
		&& !thePlayer.HasTag('ACS_IsManagingSword')
		&& thePlayer.GetPlayerAction() == PEA_None
		&& !thePlayer.GetWeaponHolster().IsOnTheMiddleOfHolstering()
		&& !thePlayer.IsInHitAnim()
		&& !thePlayer.HasTag('ACS_IsPerformingFinisher')
		&& !thePlayer.HasTag('ACS_IsPerformingCombatDismember')
		&& !thePlayer.IsCrossbowHeld()
		&& ACS_BuffCheck()
		&& thePlayer.IsActionAllowed(EIAB_Movement)
		&& ACS_CombatToExplorationCheck()
		&& !thePlayer.IsInCombat() 
		&& !thePlayer.IsInCombatState()
		&& !thePlayer.IsInCombatAction()
		&& !thePlayer.IsSwimming()
		&& !thePlayer.IsDiving()
		&& !thePlayer.IsUsingHorse()
		&& !thePlayer.IsUsingVehicle()
		&& !ACSGetCEntity('ACS_Lute')
		&& !ACSGetCEntity('ACS_Pipe')
		&& !ACSGetCEntity('ACS_Flute')
		&& AnimProgressCheck()
		&& theInput.GetActionValue( 'Jump' ) <= 0
		&& !thePlayer.IsFalling()
		&& !thePlayer.IsHoldingItemInLHand()
		&& !thePlayer.IsAnyWeaponHeld()
		//&& !thePlayer.IsInAir()
		//&& thePlayer.IsOnGround()
		//&& theGame.GetEngineTimeAsSeconds() - last_fast_walk_activate_time > 3
		)
		{
			if (thePlayer.GetStat(BCS_Vitality) <= thePlayer.GetStatMax(BCS_Vitality) * 0.3)
			{
				if(!playerRunningAdditiveActive)
				{
					if(RandF() < 0.5)
					{
						thePlayer.RaiseEvent('ACS_InjuredOverrideRightLeg');
					}
					else
					{
						thePlayer.RaiseEvent('ACS_InjuredOverrideLeftLeg');
					}

					playerRunningAdditiveActive = true;
				}
			}
		}
		else
		{
			if(playerRunningAdditiveActive)
			{
				thePlayer.RaiseEvent('ACS_InjuredExtrasAdditiveEnd');

				playerRunningAdditiveActive = false;
			}
		}

		/*
		if (thePlayer.playerMoveType == PMT_Run
		&& thePlayer.GetIsRunning()
		&& !thePlayer.GetIsSprinting()
		&& !thePlayer.IsCurrentlyDodging()
		&& !thePlayer.HasTag('ACS_Is_Currently_Dodging')
		&& !thePlayer.HasTag('ACS_IsManagingSword')
		&& thePlayer.GetPlayerAction() == PEA_None
		&& !thePlayer.GetWeaponHolster().IsOnTheMiddleOfHolstering()
		&& !thePlayer.IsInHitAnim()
		&& !thePlayer.HasTag('ACS_IsPerformingFinisher')
		&& !thePlayer.HasTag('ACS_IsPerformingCombatDismember')
		&& !thePlayer.IsCrossbowHeld()
		&& ACS_BuffCheck()
		&& thePlayer.IsActionAllowed(EIAB_Movement)
		&& ACS_CombatToExplorationCheck()
		&& !thePlayer.IsInCombat() 
		&& !thePlayer.IsInCombatState()
		&& !thePlayer.IsInCombatAction()
		&& !thePlayer.IsSwimming()
		&& !thePlayer.IsDiving()
		&& !thePlayer.IsUsingHorse()
		&& !thePlayer.IsUsingVehicle()
		&& !ACSGetCEntity('ACS_Lute')
		&& !ACSGetCEntity('ACS_Pipe')
		&& !ACSGetCEntity('ACS_Flute')
		&& AnimProgressCheck()
		&& theInput.GetActionValue( 'Jump' ) <= 0
		&& !thePlayer.IsFalling()
		&& !thePlayer.IsHoldingItemInLHand()
		&& !thePlayer.IsAnyWeaponHeld()
		//&& !thePlayer.IsInAir()
		//&& thePlayer.IsOnGround()
		//&& theGame.GetEngineTimeAsSeconds() - last_fast_walk_activate_time > 3
		)
		{
			if (RandF() < 0.5)
			{
				if(!playerRunningAdditiveActive)
				{
					playerRunningAdditiveName.Clear();
					playerRunningAdditiveName.PushBack('ACS_GeraltRunAdditive');
					playerRunningAdditiveName.PushBack('ACS_LocomotionRunCycleFastForward45UpAdditive');
					playerRunningAdditiveName.PushBack('ACS_LocomotionRunCycleFastForwardManBigAdditive');

					thePlayer.RaiseEvent(playerRunningAdditiveName[RandRange(playerRunningAdditiveName.Size())]);

					playerRunningAdditiveActive = true;
				}
			}
		}
		else
		{
			if(playerRunningAdditiveActive)
			{
				thePlayer.RaiseEvent('ACS_RunningAdditiveEnd');

				playerRunningAdditiveActive = false;
			}
		}
		*/
		
		if (thePlayer.playerMoveType == PMT_Walk
		&& !thePlayer.GetIsRunning()
		&& !thePlayer.GetIsSprinting()
		&& !thePlayer.IsCurrentlyDodging()
		&& !thePlayer.HasTag('ACS_Is_Currently_Dodging')
		&& !thePlayer.HasTag('ACS_IsManagingSword')
		&& thePlayer.GetPlayerAction() == PEA_None
		&& !thePlayer.GetWeaponHolster().IsOnTheMiddleOfHolstering()
		&& !thePlayer.IsInHitAnim()
		&& !thePlayer.HasTag('ACS_IsPerformingFinisher')
		&& !thePlayer.HasTag('ACS_IsPerformingCombatDismember')
		&& !thePlayer.IsCrossbowHeld()
		&& ACS_BuffCheck()
		&& thePlayer.IsActionAllowed(EIAB_Movement)
		&& ACS_CombatToExplorationCheck()
		&& !thePlayer.IsInCombat() 
		&& !thePlayer.IsInCombatState()
		&& !thePlayer.IsInCombatAction()
		&& !thePlayer.IsSwimming()
		&& !thePlayer.IsDiving()
		&& !thePlayer.IsUsingHorse()
		&& !thePlayer.IsUsingVehicle()
		&& !ACSGetCEntity('ACS_Lute')
		&& !ACSGetCEntity('ACS_Pipe')
		&& !ACSGetCEntity('ACS_Flute')
		&& AnimProgressCheck()
		&& theInput.GetActionValue( 'Jump' ) <= 0
		&& !thePlayer.IsFalling()
		&& !thePlayer.IsHoldingItemInLHand()
		&& !thePlayer.HasTag('ACS_Is_Sneaking')
		&& !thePlayer.IsCastingSign()
		&& !ACS_Cast_Sign_Process
		&& thePlayer.terrainPitch > 85
		//&& !thePlayer.IsInAir()
		//&& thePlayer.IsOnGround()
		//&& theGame.GetEngineTimeAsSeconds() - last_fast_walk_activate_time > 3
		)
		{
			if (thePlayer.HasBuff(EET_Drunkenness)
			|| thePlayer.HasTag('ACS_TalkingAnimalsEnabled')
			)
			{
				if (!drunkWalkChangeStage1)
				{
					ResetFastWalk();

					drunkWalkChangeStage1 = true;
				}

				if(thePlayer.GetStat(BCS_Toxicity) < thePlayer.GetStatMax(BCS_Toxicity) * 0.33 )
				{
					if (drunkWalkChangeStage2)
					{
						ResetFastWalk();

						drunkWalkChangeStage3 = false;

						drunkWalkChangeStage2 = false;
					}
				}
				else if(thePlayer.GetStat(BCS_Toxicity) >= thePlayer.GetStatMax(BCS_Toxicity) * 0.33 && thePlayer.GetStat(BCS_Toxicity) < thePlayer.GetStatMax(BCS_Toxicity) * 0.66 )
				{
					if (!drunkWalkChangeStage2)
					{
						ResetFastWalk();

						drunkWalkChangeStage3 = false;

						drunkWalkChangeStage2 = true;
					}
				}
				else if(thePlayer.GetStat(BCS_Toxicity) >= thePlayer.GetStatMax(BCS_Toxicity) * 0.66 )
				{
					if (!drunkWalkChangeStage3)
					{
						ResetFastWalk();

						drunkWalkChangeStage2 = false;

						drunkWalkChangeStage3 = true;
					}
				}
			}
			else
			{
				if (drunkWalkChangeStage1)
				{
					ResetFastWalk();

					drunkWalkChangeStage1 = false;
				}

				if(thePlayer.GetStat(BCS_Toxicity) < thePlayer.GetStatMax(BCS_Toxicity) * 0.33 )
				{
					if (drunkWalkChangeStage2)
					{
						ResetFastWalk();

						drunkWalkChangeStage2 = false;
					}
				}
				else if(thePlayer.GetStat(BCS_Toxicity) >= thePlayer.GetStatMax(BCS_Toxicity) * 0.33 && thePlayer.GetStat(BCS_Toxicity) < thePlayer.GetStatMax(BCS_Toxicity) * 0.66 )
				{
					if (!drunkWalkChangeStage2)
					{
						ResetFastWalk();

						drunkWalkChangeStage3 = false;

						drunkWalkChangeStage2 = true;
					}
				}
				else if(thePlayer.GetStat(BCS_Toxicity) >= thePlayer.GetStatMax(BCS_Toxicity) * 0.66 )
				{
					if (!drunkWalkChangeStage3)
					{
						ResetFastWalk();

						drunkWalkChangeStage2 = false;

						drunkWalkChangeStage3 = true;
					}
				}
			}

			if (!fastWalkDisabled
			)
			{
				if (!thePlayer.HasTag('ACS_WalkTypeChange_Activated')
				)
				{
					thePlayer.ACS_ClearAnimationSpeedMultipliers();

					thePlayer.ACS_SetAnimationSpeedMultiplier(1);

					walkSpeed = 1;

					if (thePlayer.GetStat(BCS_Vitality) <= thePlayer.GetStatMax(BCS_Vitality) * 0.3)
					{
						thePlayer.RaiseEvent('ACS_InjuredWalk');
					}
					else
					{
						if (thePlayer.HasBuff(EET_Drunkenness)
						|| thePlayer.HasTag('ACS_TalkingAnimalsEnabled')
						)
						{
							if(thePlayer.GetStat(BCS_Toxicity) < thePlayer.GetStatMax(BCS_Toxicity) * 0.33 )
							{
								thePlayer.RaiseEvent('ACS_TimidWalk');
							}
							else if(thePlayer.GetStat(BCS_Toxicity) >= thePlayer.GetStatMax(BCS_Toxicity) * 0.33 && thePlayer.GetStat(BCS_Toxicity) < thePlayer.GetStatMax(BCS_Toxicity) * 0.66 )
							{
								thePlayer.RaiseEvent('ACS_DrunkWalk');
							}
							else if(thePlayer.GetStat(BCS_Toxicity) >= thePlayer.GetStatMax(BCS_Toxicity) * 0.66 )
							{
								if (RandF() < 0.5)
								{
									thePlayer.RaiseEvent('ACS_HumanCrawl');
								}
								else
								{
									thePlayer.RaiseEvent('ACS_HumanCrawlAlt');
								}
							}
						}
						else
						{
							if ( FactsQuerySum("ACS_BadassWalk") > 0 )
							{
								thePlayer.RaiseEvent('ACS_BadassWalk');
							}
							else if ( FactsQuerySum("ACS_BadassWalkAlt") > 0 )
							{
								thePlayer.RaiseEvent('ACS_BadassWalkAlt');
							}
							else if ( FactsQuerySum("ACS_DrunkWalk") > 0 )
							{
								thePlayer.RaiseEvent('ACS_DrunkWalk');
							}
							else if ( FactsQuerySum("ACS_ZombieWalk") > 0 )
							{
								thePlayer.RaiseEvent('ACS_ZombieWalk');
							}
							else if ( FactsQuerySum("ACS_BigHeavyWalk") > 0 )
							{
								thePlayer.RaiseEvent('ACS_BigHeavyWalk');
							}
							else if ( FactsQuerySum("ACS_OlgierdWalk") > 0 )
							{
								thePlayer.RaiseEvent('ACS_OlgierdWalk');
							}
							else if ( FactsQuerySum("ACS_RichWalk") > 0 )
							{
								thePlayer.RaiseEvent('ACS_RichWalk');
							}
							else if ( FactsQuerySum("ACS_TimidWalk") > 0 )
							{
								thePlayer.RaiseEvent('ACS_TimidWalk');
							}
						}
					}
				
					thePlayer.AddTag('ACS_WalkTypeChange_Activated');
				}
			}

			if (thePlayer.HasTag('ACS_WalkTypeChange_Activated')
			&& ACS_Settings_Main_Bool('acs_movement_main_settings','acs_fast_walk', true)
			)
			{
				if (FactsQuerySum("ACS_ZombieWalk") <= 0 
				&& FactsQuerySum("ACS_DrunkWalk") <= 0
				&& FactsQuerySum("ACS_BigHeavyWalk") <= 0
				&& FactsQuerySum("ACS_TimidWalk") <= 0
				&& FactsQuerySum("ACS_BadassWalk") <= 0
				&& FactsQuerySum("ACS_BadassWalkAlt") <= 0
				&& FactsQuerySum("ACS_OlgierdWalk") <= 0
				&& FactsQuerySum("ACS_RichWalk") <= 0
				&& !thePlayer.HasTag('ACS_Is_Sneaking')
				&& thePlayer.GetStat(BCS_Vitality) > thePlayer.GetStatMax(BCS_Vitality) * 0.3
				&& !thePlayer.HasBuff(EET_Drunkenness)
				&& !thePlayer.HasTag('ACS_TalkingAnimalsEnabled')
				&& (currspeed > 0 && ACS_Settings_Main_Bool('acs_movement_main_settings','acs_modular_movement_speed_enabled', true))
				)
				{
					if (walkSpeed >= 1.125f)
					{
						walkSpeed = 1.125f;
					}
					else
					{
						walkSpeed += 0.00001;
					}

					thePlayer.ACS_SetAnimationSpeedMultiplier(walkSpeed);
				}
			}
			
		}
		else
		{
			ResetFastWalk();
		}

		if (
		thePlayer.playerMoveType == PMT_Idle
		&& !thePlayer.GetIsRunning()
		&& !thePlayer.GetIsSprinting()
		&& !thePlayer.IsCurrentlyDodging()
		&& !thePlayer.HasTag('ACS_Is_Currently_Dodging')
		&& !thePlayer.HasTag('ACS_IsManagingSword')
		&& thePlayer.GetPlayerAction() == PEA_None
		&& !thePlayer.GetWeaponHolster().IsOnTheMiddleOfHolstering()
		&& !thePlayer.IsInHitAnim()
		&& !thePlayer.HasTag('ACS_IsPerformingFinisher')
		&& !thePlayer.HasTag('ACS_IsPerformingCombatDismember')
		&& !thePlayer.IsCrossbowHeld()
		&& ACS_BuffCheck()
		&& thePlayer.IsActionAllowed(EIAB_Movement)
		&& ACS_CombatToExplorationCheck()
		&& !thePlayer.IsInCombat() 
		&& !thePlayer.IsInCombatState()
		&& !thePlayer.IsInCombatAction()
		&& !thePlayer.IsSwimming()
		&& !thePlayer.IsDiving()
		&& !thePlayer.IsUsingHorse()
		&& !thePlayer.IsUsingVehicle()
		&& !ACSGetCEntity('ACS_Lute')
		&& !ACSGetCEntity('ACS_Pipe')
		&& !ACSGetCEntity('ACS_Flute')
		&& AnimProgressCheck()
		&& theInput.GetActionValue( 'Jump' ) <= 0
		&& !thePlayer.IsFalling()
		&& !thePlayer.IsHoldingItemInLHand()
		&& !thePlayer.IsCastingSign()
		&& !ACS_Cast_Sign_Process
		//&& !thePlayer.IsInAir()
		//&& thePlayer.IsOnGround()
		//&& theGame.GetEngineTimeAsSeconds() - last_fast_walk_activate_time > 3
		)
		{
			if (!playerIdle)
			{
				switch(currspeed)
				{
					case 4:
						if (ACS_Settings_Main_Bool('acs_movement_main_settings','acs_walking_by_default_enabled', true))
						{
							currspeed = 0;
							thePlayer.SetWalkToggle( true );
						}
						else
						{
							currspeed = 3;
							thePlayer.SetWalkToggle( false );
						}
						thePlayer.SetSprintActionPressed( false );
						thePlayer.SetSprintToggle( false );
					break;

					case 3:
						currspeed = 3;
						thePlayer.SetSprintActionPressed( false );
						thePlayer.SetSprintToggle( false );
						thePlayer.SetWalkToggle( false );
					break;

					case 2:
						currspeed = 2;
						thePlayer.SetSprintActionPressed( false );
						thePlayer.SetSprintToggle( false );
						thePlayer.SetWalkToggle( false );
					break;

					case 1:
						currspeed = 1;
						thePlayer.SetSprintActionPressed( false );
						thePlayer.SetSprintToggle( false );
						thePlayer.SetWalkToggle( true );
					break;

					case 0:
						currspeed = 0;
						thePlayer.SetSprintActionPressed( false );
						thePlayer.SetSprintToggle( false );
						thePlayer.SetWalkToggle( true );
					break;

					default:
						currspeed = 0;
						thePlayer.SetSprintActionPressed( false );
						thePlayer.SetSprintToggle( false );
						thePlayer.SetWalkToggle( true );
					break;
				}

				playerIdle = true;
			}

			if (groundPuffEffectCache)
			{
				if (((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'wood_hollow'
				|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'wood_debris'
				|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'dirt_hard'
				|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'dirt_soil'
				|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'hay'
				|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'stone_debris'
				|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'stone_solid'
				|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'clay_tile'
				|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'gravel_large'
				|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'gravel_small'
				|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'sand'
				|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'water_shallow'
				|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'water_deep'
				|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'grass_short'
				|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'grass_long'
				|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'carpet'
				)
				{
					thePlayer.StopEffect('jump_ground_fx1');
					thePlayer.PlayEffect('jump_ground_fx1');
				}
				

				groundPuffEffectCache = false;
			}
			

			if (thePlayer.HasBuff(EET_Drunkenness)
			|| thePlayer.HasTag('ACS_TalkingAnimalsEnabled')
			)
			{
				if (!drunkIdleChangeStage1)
				{
					if (thePlayer.HasTag('ACS_Idle_Activated'))
					{
						thePlayer.RaiseEvent('ACS_IdleAdditiveEnd');

						thePlayer.RemoveTag('ACS_Idle_Activated');
					}

					drunkIdleChangeStage1 = true;
				}

				if(thePlayer.GetStat(BCS_Toxicity) < thePlayer.GetStatMax(BCS_Toxicity) * 0.33 )
				{
					if (drunkIdleChangeStage2)
					{
						if (thePlayer.HasTag('ACS_Idle_Activated'))
						{
							thePlayer.RaiseEvent('ACS_IdleAdditiveEnd');

							thePlayer.RemoveTag('ACS_Idle_Activated');
						}

						drunkIdleChangeStage3 = false;

						drunkIdleChangeStage2 = false;
					}
				}
				else if(thePlayer.GetStat(BCS_Toxicity) >= thePlayer.GetStatMax(BCS_Toxicity) * 0.33 && thePlayer.GetStat(BCS_Toxicity) < thePlayer.GetStatMax(BCS_Toxicity) * 0.66 )
				{
					if (!drunkIdleChangeStage2)
					{
						if (thePlayer.HasTag('ACS_Idle_Activated'))
						{
							thePlayer.RaiseEvent('ACS_IdleAdditiveEnd');

							thePlayer.RemoveTag('ACS_Idle_Activated');
						}

						drunkIdleChangeStage3 = false;

						drunkIdleChangeStage2 = true;
					}
				}
				else if(thePlayer.GetStat(BCS_Toxicity) >= thePlayer.GetStatMax(BCS_Toxicity) * 0.66 )
				{
					if (!drunkIdleChangeStage3)
					{
						if (thePlayer.HasTag('ACS_Idle_Activated'))
						{
							thePlayer.RaiseEvent('ACS_IdleAdditiveEnd');

							thePlayer.RemoveTag('ACS_Idle_Activated');
						}

						drunkIdleChangeStage2 = false;

						drunkIdleChangeStage3 = true;
					}
				}
			}
			else
			{
				if (drunkIdleChangeStage1)
				{
					if (thePlayer.HasTag('ACS_Idle_Activated'))
					{
						thePlayer.RaiseEvent('ACS_IdleAdditiveEnd');

						thePlayer.RemoveTag('ACS_Idle_Activated');
					}

					drunkIdleChangeStage1 = false;
				}

				if(thePlayer.GetStat(BCS_Toxicity) < thePlayer.GetStatMax(BCS_Toxicity) * 0.33 )
				{
					if (drunkIdleChangeStage2)
					{
						if (thePlayer.HasTag('ACS_Idle_Activated'))
						{
							thePlayer.RaiseEvent('ACS_IdleAdditiveEnd');

							thePlayer.RemoveTag('ACS_Idle_Activated');
						}

						drunkIdleChangeStage3 = false;

						drunkIdleChangeStage2 = false;
					}
				}
				else if(thePlayer.GetStat(BCS_Toxicity) >= thePlayer.GetStatMax(BCS_Toxicity) * 0.33 && thePlayer.GetStat(BCS_Toxicity) < thePlayer.GetStatMax(BCS_Toxicity) * 0.66 )
				{
					if (!drunkIdleChangeStage2)
					{
						if (thePlayer.HasTag('ACS_Idle_Activated'))
						{
							thePlayer.RaiseEvent('ACS_IdleAdditiveEnd');

							thePlayer.RemoveTag('ACS_Idle_Activated');
						}

						drunkIdleChangeStage3 = false;

						drunkIdleChangeStage2 = true;
					}
				}
				else if(thePlayer.GetStat(BCS_Toxicity) >= thePlayer.GetStatMax(BCS_Toxicity) * 0.66 )
				{
					if (!drunkIdleChangeStage3)
					{
						if (thePlayer.HasTag('ACS_Idle_Activated'))
						{
							thePlayer.RaiseEvent('ACS_IdleAdditiveEnd');

							thePlayer.RemoveTag('ACS_Idle_Activated');
						}

						drunkIdleChangeStage2 = false;

						drunkIdleChangeStage3 = true;
					}
				}
			}

			if (!thePlayer.HasTag('ACS_Idle_Activated'))
			{
				idleTypes.Clear();

				if (thePlayer.GetStat(BCS_Vitality) <= thePlayer.GetStatMax(BCS_Vitality) * 0.3)
				{
					idleTypes.PushBack( 'ACS_InjuredIdle' );

					thePlayer.RaiseEvent(idleTypes[RandRange(idleTypes.Size())]);
				}
				else
				{
					if (thePlayer.HasBuff(EET_Drunkenness)
					|| thePlayer.HasTag('ACS_TalkingAnimalsEnabled')
					)
					{
						if(thePlayer.GetStat(BCS_Toxicity) < thePlayer.GetStatMax(BCS_Toxicity) * 0.33 )
						{
							idleTypes.PushBack( 'ACS_DrunkIdle' );
							idleTypes.PushBack( 'ACS_DevastatedIdle' );

							thePlayer.RaiseEvent(idleTypes[RandRange(idleTypes.Size())]);
						}
						else if(thePlayer.GetStat(BCS_Toxicity) >= thePlayer.GetStatMax(BCS_Toxicity) * 0.33 && thePlayer.GetStat(BCS_Toxicity) < thePlayer.GetStatMax(BCS_Toxicity) * 0.66 )
						{
							idleTypes.PushBack( 'ACS_DrunkIdleAlt01' );
							idleTypes.PushBack( 'ACS_DrunkIdleAlt02' );
							idleTypes.PushBack( 'ACS_DrunkIdleAlt03' );
							idleTypes.PushBack( 'ACS_DrunkIdleAlt04' );
							idleTypes.PushBack( 'ACS_DrunkIdleAlt05' );

							thePlayer.RaiseEvent(idleTypes[RandRange(idleTypes.Size())]);
						}
						else if(thePlayer.GetStat(BCS_Toxicity) >= thePlayer.GetStatMax(BCS_Toxicity) * 0.66 )
						{
							idleTypes.PushBack( 'ACS_CrawlIdle' );
							//idleTypes.PushBack( 'ACS_DrunkIdleAlt06' );

							thePlayer.RaiseEvent(idleTypes[RandRange(idleTypes.Size())]);
						}
					}
				}
				
				thePlayer.AddTag('ACS_Idle_Activated');
			}
		}
		else
		{
			if (playerIdle)
			{
				playerIdle = false;
			}

			if (thePlayer.GetIsSprinting()
			&& thePlayer.GetSprintingTime() > 0.5
			)
			{
				if (!groundPuffEffectCache)
				{
					groundPuffEffectCache = true;
				}
			}
			else
			{
				if (thePlayer.playerMoveType == PMT_Walk)
				{
					if (groundPuffEffectCache)
					{
						groundPuffEffectCache = false;
					}
				}
			}

			if (thePlayer.HasTag('ACS_Idle_Activated'))
			{
				thePlayer.RaiseEvent('ACS_IdleAdditiveEnd');

				thePlayer.RemoveTag('ACS_Idle_Activated');
			}
		}
	}

	var playerIdle, groundPuffEffectCache : bool;

	var playerRunningAdditiveActive : bool;

	function ACS_NPC_Add_Health()
	{
		var actors		    																								: array<CActor>;
		var i 																												: int;
		var npc																												: CNewNPC;

		if (ACS_Settings_Main_Float('acs_damage_settings','acs_enemy_health_multiplier', 1) == 1)
		{
			return;
		}

		actors.Clear();

		actors = thePlayer.GetNPCsAndPlayersInRange( 100, 100, , FLAG_ExcludePlayer + FLAG_Attitude_Hostile + FLAG_OnlyAliveActors );

		if( actors.Size() > 0 )
		{
			for( i = 0; i < actors.Size(); i += 1 )
			{
				npc = (CNewNPC)actors[i];

				if(
				!npc.HasTag('ACS_Add_Health')
				)
				{
					if (npc.UsesEssence())
					{
						npc.abilityManager.SetStatPointMax(BCS_Essence, npc.GetMaxHealth() * ACS_Settings_Main_Float('acs_damage_settings','acs_enemy_health_multiplier', 1) );
					}
					else if (npc.UsesVitality())
					{
						npc.abilityManager.SetStatPointMax(BCS_Vitality, npc.GetMaxHealth() * ACS_Settings_Main_Float('acs_damage_settings','acs_enemy_health_multiplier', 1) );
					}
					
					npc.SetHealth(npc.GetMaxHealth());

					npc.AddTag('ACS_Add_Health');
				}	
			}
		}
	}

	function FUCKING_SECOND_LIFE_HACK()
	{
		if( thePlayer.IsActionBlockedBy(EIAB_Movement, 'Mutation11') 
		&& GetWitcherPlayer().IsMutationActive( EPMT_Mutation11 ) 
		&& !GetWitcherPlayer().HasBuff( EET_Mutation11Debuff ) 
		&& !GetWitcherPlayer().IsInAir() )
		{
			thePlayer.AddTag('ACS_Second_Life_Active');
		}
	}

	function Manual_Camera_Control()
	{
		if (!thePlayer.IsHardLockEnabled())
		{
			if (!thePlayer.IsUsingHorse() 
			&& !thePlayer.IsUsingVehicle() 
			&& !thePlayer.IsPerformingFinisher()
			&& !thePlayer.HasTag('ACS_IsPerformingFinisher')
			&& !thePlayer.HasTag('ACS_IsPerformingCombatDismember')
			&& thePlayer.HasTag('ACS_Manual_Combat_Control')
			) 
			{
				movementAdjustor = thePlayer.GetMovingAgentComponent().GetMovementAdjustor();

				movementAdjustor.CancelAll();
				
				ticket = movementAdjustor.CreateNewRequest( 'ACS_Manual_Combat_Control_Rotate' );
					
				movementAdjustor.AdjustmentDuration( ticket, 0.25 );

				movementAdjustor.ShouldStartAt(ticket, thePlayer.GetWorldPosition());
				movementAdjustor.MaxRotationAdjustmentSpeed( ticket, 5000000 );
				movementAdjustor.MaxLocationAdjustmentSpeed( ticket, 5000000 );

				movementAdjustor.RotateTo( ticket, VecHeading( theCamera.GetCameraDirection() ) );
			}
		}
	}

	//private var acs_enabledQuestTracking : bool; 
	
	//default acs_enabledQuestTracking = false;

	function ACS_IsInDarkPlace() : bool
	{
		var envs : array< string >;

		if (GetWitcherPlayer().IsInInterior() 
		//&& theGame.GetWorld().GetDepotPath() == "dlc\bob\data\levels\bob\bob.w2w"
		)
		{
			return true;
		}

		if( FactsQuerySum( "tut_in_dark_place" ) )
		{
			return true;
		}
		
		GetActiveAreaEnvironmentDefinitions( envs );
		
		if( envs.Contains( 'env_novigrad_cave' ) 
		|| envs.Contains( 'cave_catacombs' ) 
		|| envs.Contains( 'env_novigrad_cave_dark' ) 
		|| envs.Contains( 'env_novigrad_cave_fog_1' ) 
		|| envs.Contains( 'env_novigrad_cave_red_water' ) 
		|| envs.Contains( 'env_novigrad_cave_simpa' ) 
		|| envs.Contains( 'env_novigrad_cave_blizzard' ) 
		|| envs.Contains( 'env_skellige_sq209_02' ) 
		|| envs.Contains( 'env_spiral_snow_hour_6_22_cave' ) 
		|| envs.Contains( 'cave_catacombs_ft' ) 
		|| envs.Contains( 'env_novigrad_cave_frogarena' ) 
		)
		{
			return true;
		}
		
		return false;
	}

	function ACS_Focus_Mode_Env_Control()
	{
		var ent_anchor, ent																	: CEntity;
		var bone_vec																		: Vector;
		var bone_rot																		: EulerAngles;
		var hud 																			: CR4ScriptedHud;
		var controlsFeedbackModule 															: CR4HudModuleControlsFeedback;	

		if(theGame.GetFocusModeController().CanUseFocusMode()
		&& theGame.IsFocusModeActive()
		&& !thePlayer.IsInCombat()
		&& !ACSGetCEntity('acs_swimming_dagger')
		)
		{
			if (FactsQuerySum("ACS_FocusModeEnv_Enabled") <= 0)
			{
				Custom_Env_Switch('focus', true);

				RemoveTimer('ForceControlModuleHudUpdate');
				AddTimer('ForceControlModuleHudUpdate', 0.25f , false);

				sonar_fx_spawn_check = false;

				RemoveTimer('SonarFXSpawnDelay');
				AddTimer('SonarFXSpawnDelay', 0.375f , false);

				FactsAdd("ACS_FocusModeEnv_Enabled", 1, -1);
			}
		}
		else
		{
			if (FactsQuerySum("ACS_FocusModeEnv_Enabled") > 0)
			{
				if (medallion_hold_anim_active)
				{
					thePlayer.RaiseEvent('ACS_MedallionHoldReset');

					medallion_hold_anim_active = false;
				}

				Custom_Env_Switch('focus', false);

				RemoveTimer('ForceControlModuleHudUpdate');
				AddTimer('ForceControlModuleHudUpdate', 0.25f , false);

				RemoveTimer('SonarFXSpawnDelay');

				if (sonar_fx_spawn_check)
				{
					theSound.SoundEvent("cmb_focus_stop");

					theSound.SoundEvent("mq1058_hide_medalion");

					RemoveTimer('ForceControlModuleHudUpdate');
					AddTimer('ForceControlModuleHudUpdate', 0.25f , false);

					GetWitcherPlayer().GetBoneWorldPositionAndRotationByIndex( GetWitcherPlayer().GetBoneIndex( 'neck' ), bone_vec, bone_rot );

					ACSGetCEntity('ACS_Medallion_Fx_Anchor_Ent').Destroy();

					ACSGetCEntity('ACS_Medallion_Active_Fx_Ent').Destroy();

					ent_anchor = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

					"dlc\dlc_acs\data\fx\acs_pulse.w2ent"

					, true ), bone_vec, GetWitcherPlayer().GetWorldRotation() );

					ent_anchor.CreateAttachmentAtBoneWS(GetWitcherPlayer(), 'neck', bone_vec, bone_rot );

					//ent_anchor.PlayEffectSingle('sonar_contract');

					//ent_anchor.PlayEffectSingle('fx_sonar');

					ent_anchor.AddTag('ACS_Medallion_Fx_Anchor_Ent');

					ent_anchor.DestroyAfter(5);

					//thePlayer.StopEffect('acs_sharley_sonar');
					//thePlayer.PlayEffect('acs_sharley_sonar');


					ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

					"dlc\dlc_acs\data\fx\acs_pulse.w2ent"

					, true ), bone_vec, GetWitcherPlayer().GetWorldRotation() );

					ent.CreateAttachment(ent_anchor,,Vector(-0.25,0,-0.75), EulerAngles(0,0,0) );

					ent.PlayEffectSingle('medallion_pulse');

					ent.DestroyAfter(5);

					ent.AddTag('ACS_Medallion_Active_Fx_Ent');

					sonar_fx_spawn_check = false;
				}

				FactsRemove("ACS_FocusModeEnv_Enabled");
			}
		}
	}

	var ACS_Clue_Activated : bool;

	function ClueCheck()
	{
		var ents			 						: array<CGameplayEntity>;
		var reset_ents 								: array<CEntity>;
		var i,j										: int;
		var cluestash								: W3MonsterClue;
		var iconPath								: string;

		if (!ACS_Settings_Main_Bool('acs_hud_settings_markers','acs_clue_icon_enabled', true))
		{
			if (ACS_Clue_Activated)
			{
				RemoveTimer('ClueIconDestroyDelay');
				GetACSStorage().acs_deleteOnelinerByTag("ACS_Clue_Icon");

				//RemoveTimer('ClueIconDestroyDelay');
				//AddTimer('ClueIconDestroyDelay', 7 , false );

				reset_ents.Clear();
		
				theGame.GetEntitiesByTag('ACS_Clue_Tagged',reset_ents);

				for(j=0; j < reset_ents.Size(); j+=1)
				{
					reset_ents[j].RemoveTag('ACS_Clue_Tagged');
				}

				ACS_Clue_Activated = false;
			}

			return;
		}

		if((theGame.GetFocusModeController().CanUseFocusMode()
		&& theGame.IsFocusModeActive())
		|| thePlayer.IsAnyWeaponHeld()
		)
		{
			if (!ACS_Clue_Activated)
			{
				RemoveTimer('ClueIconDestroyDelay');
				GetACSStorage().acs_deleteOnelinerByTag("ACS_Clue_Icon");

				ACS_Clue_Activated = true;
			}

			ents.Clear();

			FindGameplayEntitiesInRange(ents, thePlayer, 20, 1000, ,FLAG_ExcludePlayer,, 'W3MonsterClue');

			for( i = 0; i < ents.Size(); i += 1 )
			{
				if( ents.Size() > 0 )
				{
					
					cluestash = (W3MonsterClue) ents[i];

					if(!cluestash)
					{
						continue;
					}

					if(cluestash
					&& cluestash.GetIsVisible()
					&& (cluestash.GetFocusModeVisibility() == FMV_Interactive || cluestash.GetFocusModeVisibility() == FMV_Clue)
					&& thePlayer.WasVisibleInScaledFrame( cluestash, 1.f, 1.f )
					&& ACS_GetLineOfSightFromPlayer(cluestash)
					)
					{
						if(!cluestash.HasTag('ACS_Clue_Tagged')
						)
						{
							if( theGame.GetInGameConfigWrapper().GetVarValue( 'Gameplay', 'ColorblindFocusMode' ) == "true" )
							{
								iconPath = "<img src='img://" + "icons/inventory/acs_clue_icon_colorblind_mode.xbm" + "' vspace='" + (7) + "' />&nbsp;";
							}
							else
							{
								iconPath = "<img src='img://" + "icons/inventory/acs_clue_icon.xbm" + "' vspace='" + (7) + "' />&nbsp;";
							}

							ACS_Oneliner(
							iconPath
							, cluestash, "ACS_Clue_Icon", Vector(0,0,0), 999).run_indicator('clue_icon');

							//GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Clue_Icon", 50);

							//GetACSStorage().acs_setScaleForOnelinerByTag("ACS_Clue_Icon", 33, 33, 33);

							cluestash.AddTag('ACS_Clue_Tagged');
						}
					}
				}
			}
		}
		else
		{
			if (ACS_Clue_Activated)
			{
				//RemoveTimer('ClueIconDestroyDelay');
				//AddTimer('ClueIconDestroyDelay', 7 , false );

				reset_ents.Clear();
		
				theGame.GetEntitiesByTag('ACS_Clue_Tagged',reset_ents);

				for(j=0; j < reset_ents.Size(); j+=1)
				{
					reset_ents[j].RemoveTag('ACS_Clue_Tagged');
				}

				ACS_Clue_Activated = false;
			}
		}
	}
	

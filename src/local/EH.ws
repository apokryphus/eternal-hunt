								{
									Attack_Process_12('geraltRandomGeraltHeavyAttackForward_Wolf');
								}
								else
								{
									Attack_Process_12('geraltRandomGeraltHeavyAttackForward_Wolf_Silver');
								}
								break;

								case 0:
								if ( thePlayer.IsWeaponHeld( 'steelsword' ) )
								{
									Attack_Process_12('geraltRandomGeraltHeavyAttackForward_Wolf');
								}
								else if( thePlayer.IsWeaponHeld( 'silversword' ) )
								{
									Attack_Process_12('geraltRandomGeraltHeavyAttackForward_Wolf_Silver');
								}
								else
								{
									Attack_Process_12('geraltRandomGeraltHeavyAttackForward_Wolf');
								}
								break;

								default:
								if ( thePlayer.IsWeaponHeld( 'steelsword' ) )
								{
									Attack_Process_12('geraltRandomGeraltHeavyAttackForward_Wolf');
								}
								else if( thePlayer.IsWeaponHeld( 'silversword' ) )
								{
									Attack_Process_12('geraltRandomGeraltHeavyAttackForward_Wolf_Silver');
								}
								else

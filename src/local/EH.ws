	function HorseCanAutoJump(horse : W3HorseComponent) : bool
	{
		var tempEndPoint_1, tempEndPoint_2, tempEndPoint_3, normal_1, normal_2, normal_3, startPos, endPos, endPos1, endPos2, endPos3, cameraAngle, horseVelocity						: Vector;
		var collisionGroupsNames																																						: array<name>;	
		var waterDepth, distanceCheck 																																					: float;
		var material_1, material_2, material_3																																			: name;
		var comp_1, comp_2, comp_3																																						: CComponent;
		var l_destructibleCmp																																							: CDestructionSystemComponent;
		var l_gameplayLightComp																																							: CGameplayLightComponent;
		var barrel 																																										: COilBarrelEntity;
		var mac																																											: CMovingPhysicalAgentComponent;

		mac = ((CMovingPhysicalAgentComponent)((CActor)horse.GetEntity()).GetMovingAgentComponent());

		waterDepth = mac.GetSubmergeDepth();

		horseVelocity = mac.GetVelocity();
		
		if( !mac.IsOnGround() )
		{
			return false;
		}

		if(waterDepth < -0.5)
		{
			return false;
		}

		if (!ACS_Settings_Main_Bool('acs_horse_settings','acs_horse_auto_jump_enabled', true))
		{
			return false;
		}

		if (AbsF(horseVelocity.Z) <= 0.1
		)
		{
			distanceCheck = 2;
		}
		else
		{
			if (horse.inCanter)
			{
				if ( (AbsF(horseVelocity.Z) > 0.1 && AbsF(horseVelocity.Z) <= 0.3)
				)
				{
					distanceCheck = 4.5;
				}
				else
				{
					distanceCheck = 6;
				}
			}
			else if(horse.inGallop)
			{
				if ( (AbsF(horseVelocity.Z) > 0.1 && AbsF(horseVelocity.Z) <= 0.2)
				)
				{
					distanceCheck = 3.5;
				}
				else
				{
					distanceCheck = 4.5;
				}
			}
			else
			{
				distanceCheck = 3.5;
			}
		}

		startPos = ACSFixZAxis(horse.GetWorldPosition());

		startPos.Z += 0.25;

		endPos = ACSFixZAxis(horse.GetWorldPosition() + horse.GetHeadingVector() * distanceCheck);

		endPos1 = endPos;

		endPos1.Z += 1;

		endPos2 = endPos;

		endPos2.Z += 0.5;

		endPos3 = endPos;

		endPos3.Z += 1.5;

		collisionGroupsNames.Clear();

		//collisionGroupsNames.PushBack( 'Terrain');
		collisionGroupsNames.PushBack( 'Static');
		collisionGroupsNames.PushBack( 'Dynamic');
		collisionGroupsNames.PushBack( 'Fence' );
		//collisionGroupsNames.PushBack( 'Water'); 
        //collisionGroupsNames.PushBack( 'Door' );
        //collisionGroupsNames.PushBack( 'Dangles' );
        //collisionGroupsNames.PushBack( 'Foliage' );
		collisionGroupsNames.PushBack( 'Debris' );
        collisionGroupsNames.PushBack( 'Destructible' );
        collisionGroupsNames.PushBack( 'RigidBody' );
        collisionGroupsNames.PushBack( 'Boat' );
        collisionGroupsNames.PushBack( 'BoatDocking' );
		collisionGroupsNames.PushBack('BoatSide');
        //collisionGroupsNames.PushBack( 'Platforms' );
       	//collisionGroupsNames.PushBack( 'Corpse' );
       	//collisionGroupsNames.PushBack( 'Projectile' );
       	//collisionGroupsNames.PushBack( 'ParticleCollider' ); 
        //collisionGroupsNames.PushBack( 'Ragdoll' ); 

		if (
		(theInput.GetActionValue('GI_AxisLeftX') != 0 || theInput.GetActionValue('GI_AxisLeftY') != 0)
		&& ((thePlayer.GetHorseCurrentlyMounted().GetHorseComponent()).inCanter || (thePlayer.GetHorseCurrentlyMounted().GetHorseComponent()).inGallop)
		)
		{
			if ( 
			(theGame.GetWorld().StaticTraceWithAdditionalInfo( startPos, endPos1, tempEndPoint_1, normal_1, material_1, comp_1, collisionGroupsNames ) 
			|| theGame.GetWorld().StaticTraceWithAdditionalInfo( startPos, endPos2, tempEndPoint_2, normal_2, material_2, comp_2, collisionGroupsNames ) )
			&& !theGame.GetWorld().StaticTraceWithAdditionalInfo( startPos, endPos3, tempEndPoint_3, normal_3, material_3, comp_3, collisionGroupsNames )
			)		
			{
				if(comp_1)
				{
					barrel = (COilBarrelEntity)comp_1.GetEntity();

					if(barrel)
					{
						//barrel.SetOnFire( RandRangeF(5,3), false );
					}

					l_destructibleCmp = (CDestructionSystemComponent) comp_1;

					if (l_destructibleCmp)
					{
						l_destructibleCmp.ApplyFracture();

						return false;
					}

					l_gameplayLightComp = (CGameplayLightComponent) comp_1;

					if (l_gameplayLightComp)
					{
						if (l_gameplayLightComp.IsLightOn())
						{
							l_gameplayLightComp.SetFadeLight(false);

							return false;
						}
					}
				}
				

				if(comp_2)
				{
					barrel = (COilBarrelEntity)comp_2.GetEntity();

					if(barrel)
					{
						//barrel.SetOnFire( RandRangeF(5,3), false );
					}

					l_destructibleCmp = (CDestructionSystemComponent) comp_2;

					if (l_destructibleCmp)
					{
						l_destructibleCmp.ApplyFracture();

						return false;
					}

					l_gameplayLightComp = (CGameplayLightComponent) comp_2;

					if (l_gameplayLightComp)
					{
						if (l_gameplayLightComp.IsLightOn())
						{
							l_gameplayLightComp.SetFadeLight(false);

							return false;
						}
					}
				}
				
				cameraAngle = theCamera.GetCameraDirection();

				if (cameraAngle.Z >= -0.4
				)
				{
					if (material_1 == 'hay'
					|| material_2 == 'hay'
					|| material_3 == 'hay'
					)
					{
						return false;
					}

					return true;
				}
			}
		}
		
		return false;
	}

	function CreateLootItemsInHand(type, hand : name)
	{
		var prop				: CEntity;
		var temp 				: CEntityTemplate;

		thePlayer.RaiseEvent('ACS_ForceHandClosedREnd');

		if (!thePlayer.HasTag('ACS_Dual_Wield_Active') && !ACSGetCEntity('ACS_Viper_Dagger_L')){thePlayer.RaiseEvent('ACS_ForceHandClosedLEnd');}

		ACSGetCEntityDestroyAll('ACS_Loot_Prop');

		switch(type)
		{
			case 'meat':

			temp = (CEntityTemplate)LoadResource(

			"items\work\meat_01\meat_food.w2ent"
			
			, true);

			break;

			case 'herb':

			if(RandF() < 0.5)
			{
				temp = (CEntityTemplate)LoadResource(

				"dlc\dlc_acs\data\entities\other\loot_prop\tool_herb_a.w2ent" 
				
				, true);
			}
			else
			{
				temp = (CEntityTemplate)LoadResource(

				"dlc\dlc_acs\data\entities\other\loot_prop\tool_herb_b.w2ent" 
				
				, true);
			}

			break;

			case 'default':

			temp = (CEntityTemplate)LoadResource(

			"dlc\dlc_acs\data\entities\other\pouch_dummy.w2ent"
			
			, true);

			break;

			default:
			temp = (CEntityTemplate)LoadResource(

			"dlc\dlc_acs\data\entities\other\pouch_dummy.w2ent"
			
			, true);
			break;
		}

		prop = (CEntity)theGame.CreateEntity( temp, thePlayer.GetWorldPosition() -100, thePlayer.GetWorldRotation());

		prop.AddTag('ACS_Loot_Prop');

		RemoveTimer('LootPropDisappear');

		switch(hand)
		{
			case 'l_hand_kneeling':
			
			thePlayer.RaiseEvent('ACS_ForceHandClosedL');

			prop.CreateAttachment(thePlayer, 'l_weapon', Vector(0,0,0), EulerAngles(0,180,0));

			AddTimer('LootPropDisappear', 1.5f   , false);

			break;

			case 'l_hand':
			
			thePlayer.RaiseEvent('ACS_ForceHandClosedL');

			prop.CreateAttachment(thePlayer, 'l_weapon', Vector(-0.06125,0.05125,0), EulerAngles(0,180,180));

			AddTimer('LootPropDisappear', 1.125f   , false);

			break;

			case 'r_hand':

			thePlayer.RaiseEvent('ACS_ForceHandClosedR');

			prop.CreateAttachment(thePlayer, 'r_weapon', Vector(0,0,0), EulerAngles(0,0,0));

			AddTimer('LootPropDisappear', 1.5f   , false);

			break;

			default:

			thePlayer.RaiseEvent('ACS_ForceHandClosedR');

			prop.CreateAttachment(thePlayer, 'r_weapon', Vector(0,0,0), EulerAngles(0,0,0));

			AddTimer('LootPropDisappear', 1.5f   , false);

			break;
		}
	}

	timer function LootPropDisappear( dt : float, id : int )
	{
		thePlayer.RaiseEvent('ACS_ForceHandClosedREnd');

		if (!thePlayer.HasTag('ACS_Dual_Wield_Active') && !ACSGetCEntity('ACS_Viper_Dagger_L')){thePlayer.RaiseEvent('ACS_ForceHandClosedLEnd');}

		ACSGetCEntity('ACS_Loot_Prop').BreakAttachment();
		ACSGetCEntity('ACS_Loot_Prop').Teleport(thePlayer.GetWorldPosition() + Vector (0,0, -200));
		ACSGetCEntity('ACS_Loot_Prop').DestroyAfter(0.125);
		ACSGetCEntity('ACS_Loot_Prop').RemoveTag('ACS_Loot_Prop');
	}

	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	var horseLeapStrikeProcess : bool;
	default horseLeapStrikeProcess = false;

	function HorseLeapStrike()
	{	
		var pos : Vector;
		var actors 	: array<CActor>;
		var i	: int;

		if(thePlayer.IsUsingHorse())
		{
			((CActor)(thePlayer.GetHorseCurrentlyMounted().GetHorseComponent()).GetEntity()).EnableCharacterCollisions(false);

			((CActor)(thePlayer.GetHorseCurrentlyMounted().GetHorseComponent()).GetEntity()).EnableCollisions(false);

			actors.Clear();

			theGame.GetActorsByTag( 'ACS_PlayerLastMountedHorse' , actors );	
			
			for( i = 0; i < actors.Size(); i += 1 )
			{
				actors[i].RemoveTag('ACS_PlayerLastMountedHorse');
			}

			((CActor)(thePlayer.GetHorseCurrentlyMounted().GetHorseComponent()).GetEntity()).AddTag('ACS_PlayerLastMountedHorse');

			if ((thePlayer.GetHorseCurrentlyMounted().GetHorseComponent()).inCanter)
			{
				thePlayer.AddTag('ACS_PlayerLeapStrikeCanter');
			}
			else if ((thePlayer.GetHorseCurrentlyMounted().GetHorseComponent()).inGallop)
			{
				thePlayer.AddTag('ACS_PlayerLeapStrikeGallop');
			}
			else
			{
				thePlayer.AddTag('ACS_PlayerLeapStrikeNormal');
			}

			thePlayer.ClearCleanupFunction();
			thePlayer.GotoState( 'ACS_DismountHorse', true );


			thePlayer.EnableCollisions(false);

			thePlayer.EnableCharacterCollisions(false);

			if (ACSGetCActor('ACS_PlayerLastMountedHorse'))
			{
				pos = ACSGetCActor('ACS_PlayerLastMountedHorse').GetWorldPosition();
			}
			else
			{
				pos = thePlayer.GetWorldPosition();
			}

			pos.Z += 1;

			thePlayer.TeleportWithRotation(pos, thePlayer.GetWorldRotation());
		}

		AardLightIconFeet();

		if ( thePlayer.IsAnyWeaponHeld() 
		&& !thePlayer.IsWeaponHeld('fist') 
		)
		{
			if(RandF() < 0.5)
			{
				PlayerPlayAnimation('man_ger_sword_aard_ground_lp');
			}
			else
			{
				PlayerPlayAnimation('man_ger_sword_aard_ground_rp');
			}
		}
		else
		{
			PlayerPlayAnimation('man_geralt_aard_ground');
		}

		thePlayer.SoundEvent("sign_aard_blast");

		thePlayer.RaiseEvent('ACS_FeetAdditiveEnd');

		thePlayer.RaiseEvent('ACS_SwordTauntEnd');

		RemoveTimer('SwordTauntSwitch'); 
		RemoveTimer('SwordTauntRunningSwitch');
		RemoveTimer('CombatTauntDelay');
		RemoveTimer('SwordTauntRunningSwitchSecondary'); 
		RemoveTimer('SwordTauntRunningSwitchSecondaryWeaponBlood'); 

		GetWitcherPlayer().DrainStamina( ESAT_FixedValue, GetWitcherPlayer().GetStatMax( BCS_Stamina ) * 0.125 , 2 );

		horseLeapStrikeProcess = true;

		GetWitcherPlayer().BlockAction( EIAB_Movement,		'acs_horse_dismount_jump');
		GetWitcherPlayer().BlockAction( EIAB_MountVehicle,		'acs_horse_dismount_jump');
		GetWitcherPlayer().BlockAction( EIAB_DismountVehicle,	'acs_horse_dismount_jump');
		GetWitcherPlayer().BlockAction( EIAB_Crossbow, 			'acs_horse_dismount_jump');
		GetWitcherPlayer().BlockAction( EIAB_CallHorse,			'acs_horse_dismount_jump');
		GetWitcherPlayer().BlockAction( EIAB_Signs, 				'acs_horse_dismount_jump');
		GetWitcherPlayer().BlockAction( EIAB_DrawWeapon, 			'acs_horse_dismount_jump'); 
		GetWitcherPlayer().BlockAction( EIAB_FastTravel, 			'acs_horse_dismount_jump');
		GetWitcherPlayer().BlockAction( EIAB_Fists, 				'acs_horse_dismount_jump');
		GetWitcherPlayer().BlockAction( EIAB_InteractionAction, 	'acs_horse_dismount_jump');
		GetWitcherPlayer().BlockAction( EIAB_UsableItem,			'acs_horse_dismount_jump');
		GetWitcherPlayer().BlockAction( EIAB_ThrowBomb,			'acs_horse_dismount_jump');
		GetWitcherPlayer().BlockAction( EIAB_SwordAttack,			'acs_horse_dismount_jump');
		GetWitcherPlayer().BlockAction( EIAB_Jump,				'acs_horse_dismount_jump');
		GetWitcherPlayer().BlockAction( EIAB_LightAttacks,		'acs_horse_dismount_jump');
		GetWitcherPlayer().BlockAction( EIAB_HeavyAttacks,		'acs_horse_dismount_jump');
		GetWitcherPlayer().BlockAction( EIAB_SpecialAttackLight,	'acs_horse_dismount_jump');
		GetWitcherPlayer().BlockAction( EIAB_SpecialAttackHeavy,	'acs_horse_dismount_jump');
		GetWitcherPlayer().BlockAction( EIAB_Dodge,				'acs_horse_dismount_jump');
		GetWitcherPlayer().BlockAction( EIAB_Roll,				'acs_horse_dismount_jump');
		GetWitcherPlayer().BlockAction( EIAB_Parry,				'acs_horse_dismount_jump');
		GetWitcherPlayer().BlockAction( EIAB_MeditationWaiting,	'acs_horse_dismount_jump');
		GetWitcherPlayer().BlockAction( EIAB_OpenMeditation,		'acs_horse_dismount_jump');
		GetWitcherPlayer().BlockAction( EIAB_RadialMenu,			'acs_horse_dismount_jump');
		GetWitcherPlayer().BlockAction( EIAB_Interactions, 		'acs_horse_dismount_jump');

		theGame.CreateNoSaveLock( "ACS_Horse_Dismount_Jump_State", ACS_Horse_Dismount_Jump_Savelock_ID, false, false );

		RemoveTimer('HorseDismountJumpDelay');
		RemoveTimer('HorseDismountJumpDelaySecondary');
		AddTimer('HorseDismountJumpDelay', 0.1   , false);
	}

	timer function HorseDismountJumpDelay( dt : float, id : int )
	{
		var movementAdjustor: CMovementAdjustor;
		var ticket_rotate: SMovementAdjustmentRequestTicket;
		var pos : Vector;
		var dist : float;
		var aimImpactEntity 	: CEntity;


		ACS_SlowMoAdjustable(0.3, 0.1);

		ACS_ExplorationDelayHack(false, 3);

		RemoveTimer('SwordTauntSwitch'); 
		RemoveTimer('SwordTauntRunningSwitch'); 

		thePlayer.RaiseEvent('ACS_SwordTauntEnd');

		thePlayer.AddTag('ACS_Horse_Dismount_Jump_Attack');
		 
		RemoveTimer('CombatTauntDelay');
		RemoveTimer('SwordTauntRunningSwitchSecondary'); 
		RemoveTimer('SwordTauntRunningSwitchSecondaryWeaponBlood'); 

		ACSGetCActor('ACS_PlayerLastMountedHorse').EnableCollisions(true);

		ACSGetCActor('ACS_PlayerLastMountedHorse').EnableCharacterCollisions(true);

		ACSGetCActor('ACS_PlayerLastMountedHorse').RemoveTag('ACS_PlayerLastMountedHorse');

		movementAdjustor = thePlayer.GetMovingAgentComponent().GetMovementAdjustor();

		ticket_rotate = movementAdjustor.GetRequest( 'ACS_Horse_Dismount_Jump');
		movementAdjustor.CancelByName( 'ACS_Horse_Dismount_Jump' );
		movementAdjustor.CancelAll();
		
		ticket_rotate = movementAdjustor.CreateNewRequest( 'ACS_Horse_Dismount_Jump');
		movementAdjustor.MaxRotationAdjustmentSpeed( ticket_rotate, 5000000 );
		movementAdjustor.MaxLocationAdjustmentSpeed( ticket_rotate, 5000000 );
		movementAdjustor.AdjustmentDuration( ticket_rotate, 0.5f );
		movementAdjustor.RotateTo( ticket_rotate, VecHeading( theCamera.GetCameraDirection() ) );
		movementAdjustor.AdjustLocationVertically( ticket_rotate, true );

		if (thePlayer.HasTag('ACS_PlayerLeapStrikeCanter'))
		{
			dist = 7;

			if(RandF() < 0.5)
			{
				PlayerPlayAnimation( 'jump_run_lf_sword');
			}
			else
			{
				PlayerPlayAnimation( 'jump_run_rf_sword');
			}
		}
		else if (thePlayer.HasTag('ACS_PlayerLeapStrikeGallop'))
		{
			dist = 6;

			if(RandF() < 0.5)
			{
				PlayerPlayAnimation( 'combat_jump_run_lf');
			}
			else
			{
				PlayerPlayAnimation( 'combat_jump_run_rf');
			}
		}
		else if (thePlayer.HasTag('ACS_PlayerLeapStrikeNormal'))
		{
			dist = 5;

			if(RandF() < 0.5)
			{
				PlayerPlayAnimation( 'combat_jump_walk_lf');
			}
			else
			{
				PlayerPlayAnimation( 'combat_jump_walk_rf');
			}
		}
		else
		{
			dist = 5;

			if(RandF() < 0.5)
			{
				PlayerPlayAnimation( 'combat_jump_run_lf');
			}
			else
			{
				PlayerPlayAnimation( 'combat_jump_run_rf');
			}
		}

		pos = thePlayer.GetWorldPosition() + (thePlayer.GetWorldForward() * dist);

		pos.Z += dist;

		movementAdjustor.SlideTo(ticket_rotate, pos);

		//PlayerPlayAnimation( 'horse_idle_get_off');

		thePlayer.SoundEvent("monster_dettlaff_monster_movement_whoosh_large");
		thePlayer.SoundEvent("monster_dettlaff_monster_movement_whoosh_med");

		RemoveTimer('HorseDismountJumpDelaySecondary');
		AddTimer('HorseDismountJumpDelaySecondary', 0.5f   , false);

		thePlayer.SoundEvent("scene_grunt_vo_attack_long_ALWAYS");
		
		thePlayer.PlayEffectSingle('acs_fast_sprint_trail');
		thePlayer.StopEffect('acs_fast_sprint_trail');

		thePlayer.EnableCollisions(false);

		thePlayer.EnableCharacterCollisions(false);

		thePlayer.RaiseEvent('ACS_TorsoBendLock');

	}

	timer function HorseDismountJumpDelaySecondary( dt : float, id : int )
	{
		var movementAdjustor: CMovementAdjustor;
		var ticket_rotate: SMovementAdjustmentRequestTicket;
		var actors		 : array<CActor>;
		var i					: int;
		var dist		: float;

		ACS_SlowMoAdjustable(0.3, 0.1);

		ACS_ExplorationDelayHack(false, 3);

		thePlayer.RaiseEvent('ACS_SwordTauntEnd');

		RemoveTimer('SwordTauntSwitch'); 
		RemoveTimer('SwordTauntRunningSwitch'); 
		 
		 
		RemoveTimer('CombatTauntDelay');
		RemoveTimer('SwordTauntRunningSwitchSecondary'); 
		RemoveTimer('SwordTauntRunningSwitchSecondaryWeaponBlood'); 

		thePlayer.SoundEvent("monster_dettlaff_monster_movement_whoosh_small");

		movementAdjustor = thePlayer.GetMovingAgentComponent().GetMovementAdjustor();

		ticket_rotate = movementAdjustor.GetRequest( 'ACS_Horse_Dismount_Jump');
		movementAdjustor.CancelByName( 'ACS_Horse_Dismount_Jump' );
		movementAdjustor.CancelAll();
		
		ticket_rotate = movementAdjustor.CreateNewRequest( 'ACS_Horse_Dismount_Jump');
		movementAdjustor.MaxRotationAdjustmentSpeed( ticket_rotate, 5000000 );
		movementAdjustor.MaxLocationAdjustmentSpeed( ticket_rotate, 5000000 );
		movementAdjustor.AdjustmentDuration( ticket_rotate, 0.5 );
		movementAdjustor.AdjustLocationVertically( ticket_rotate, true );

		actors.Clear();

		if (thePlayer.HasTag('ACS_PlayerLeapStrikeCanter'))
		{
			actors = thePlayer.GetNPCsAndPlayersInRange( 20, 1, , FLAG_ExcludePlayer + FLAG_Attitude_Hostile + FLAG_OnlyAliveActors );
		}
		else if (thePlayer.HasTag('ACS_PlayerLeapStrikeGallop'))
		{
			actors = thePlayer.GetNPCsAndPlayersInRange( 15, 1, , FLAG_ExcludePlayer + FLAG_Attitude_Hostile + FLAG_OnlyAliveActors );
		}
		else if (thePlayer.HasTag('ACS_PlayerLeapStrikeNormal'))
		{
			actors = thePlayer.GetNPCsAndPlayersInRange( 10, 1, , FLAG_ExcludePlayer + FLAG_Attitude_Hostile + FLAG_OnlyAliveActors );
		}
		else
		{
			actors = GetWitcherPlayer().GetNPCsAndPlayersInCone(10, VecHeading(GetWitcherPlayer().GetHeadingVector()), 270, 10, , FLAG_ExcludePlayer + FLAG_Attitude_Hostile + FLAG_OnlyAliveActors  );
		}

		if( actors.Size() > 0 )
		{
			for( i = 0; i < actors.Size(); i += 1 )
			{
				dist = (((CMovingPhysicalAgentComponent)(thePlayer).GetMovingAgentComponent()).GetCapsuleRadius() 
					+ ((CMovingPhysicalAgentComponent)actors[i].GetMovingAgentComponent()).GetCapsuleRadius()) * 1.5;

				if (!actors[i].IsOnGround() || ((CNewNPC)actors[i]).IsFlying())
				{
					if(!thePlayer.HasTag('ACS_Leap_Attack_Hit_Adjustment'))
					{
						thePlayer.AddTag('ACS_Leap_Attack_Hit_Adjustment');
					}
				}

				if(thePlayer.HasTag('ACS_PlayerLeapStrikeCanter')
				|| thePlayer.HasTag('ACS_PlayerLeapStrikeGallop')
				|| thePlayer.HasTag('ACS_PlayerLeapStrikeNormal'))
				{
					movementAdjustor.RotateTowards( ticket_rotate, actors[i] );

					movementAdjustor.SlideTo( ticket_rotate, ACSFixZAxis(actors[i].GetWorldPosition()));
				}
				else
				{
					if (actors[i].IsOnGround() && !((CNewNPC)actors[i]).IsFlying())
					{
						movementAdjustor.RotateTowards( ticket_rotate, actors[i] );

						movementAdjustor.SlideTo( ticket_rotate, ACSFixZAxis(actors[i].GetWorldPosition()));
					}
					else
					{
						movementAdjustor.RotateTo( ticket_rotate, VecHeading( thePlayer.GetHeadingVector() ) );

						movementAdjustor.SlideTo(ticket_rotate, ACSFixZAxis(thePlayer.GetWorldPosition() + thePlayer.GetWorldForward() * 6));
					}
				}
			}
		}
		else
		{
			movementAdjustor.RotateTo( ticket_rotate, VecHeading( thePlayer.GetHeadingVector() ) );

			if (thePlayer.HasTag('ACS_PlayerLeapStrikeCanter'))
			{
				movementAdjustor.SlideTo(ticket_rotate, ACSFixZAxis(thePlayer.GetWorldPosition() + thePlayer.GetWorldForward() * 10));
			}
			else if (thePlayer.HasTag('ACS_PlayerLeapStrikeGallop'))
			{
				movementAdjustor.SlideTo(ticket_rotate, ACSFixZAxis(thePlayer.GetWorldPosition() + thePlayer.GetWorldForward() * 8));
			}
			else if (thePlayer.HasTag('ACS_PlayerLeapStrikeNormal'))
			{
				movementAdjustor.SlideTo(ticket_rotate, ACSFixZAxis(thePlayer.GetWorldPosition() + thePlayer.GetWorldForward() * 6));
			}
			else
			{
				movementAdjustor.SlideTo(ticket_rotate, ACSFixZAxis(thePlayer.GetWorldPosition() + thePlayer.GetWorldForward() * 6));
			}
		}

		thePlayer.RemoveTag('ACS_PlayerLeapStrikeCanter');
		thePlayer.RemoveTag('ACS_PlayerLeapStrikeGallop');
		thePlayer.RemoveTag('ACS_PlayerLeapStrikeNormal');

		RemoveTimer('HorseDismountJumpRestoreCollision');
		AddTimer('HorseDismountJumpRestoreCollision', 0.5f   , false);

		thePlayer.SoundEvent("grunt_vo_attack_long");
		thePlayer.SoundEvent("grunt_vo_attack_long_ALWAYS");
		
		thePlayer.PlayEffectSingle('acs_fast_sprint_trail');
		thePlayer.StopEffect('acs_fast_sprint_trail');

		GetWitcherPlayer().DrainStamina( ESAT_FixedValue, GetWitcherPlayer().GetStatMax( BCS_Stamina ) * 0.25 , 3 );
		
		if(thePlayer.HasTag('ACS_Leap_Attack_Hit_Adjustment'))
		{
			kick_index_1 = RandDifferent(this.previous_kick_index_1 , 2);

			switch (kick_index_1) 
			{	
				case 1:
				thePlayer.RaiseEvent('ACS_Leap_Attack_01');

				PlayerPlayAnimation( 'man_geralt_sword_repel_lp_kick_ACS');
				break;

				default:
				thePlayer.RaiseEvent('ACS_Leap_Attack_02');

				PlayerPlayAnimation( 'man_geralt_sword_repel_rp_kick_ACS');
				break;
			}

			this.previous_kick_index_1 = kick_index_1;

			thePlayer.RemoveTag('ACS_Leap_Attack_Hit_Adjustment');
		}
		else
		{
			if (thePlayer.HasTag('ACS_Dual_Wield_Active'))
			{
				PlayerPlayAnimation( 'man_geralt_sword_attack_heavy_special_rp_end_dw_ACS' );
			}
			else
			{
				PlayerPlayAnimation( 'man_geralt_sword_attack_heavy_special_rp_end');

				//PlayerPlayAnimation( 'attack_overhead_start_ACS');
			}
		}

		thePlayer.RaiseEvent('ACS_TorsoBendSlow');

		AddTimer('Horse_Leap_Attack_Knockdown', 0.5f   , false);
	}

	public timer function Horse_Leap_Attack_Knockdown(deltaTime : float , id : int)
	{
		var template 							: CEntityTemplate;
		var entPhysics                  		: CEntity;
		var rot                        			: EulerAngles;
		var pos, playerPos, targetPos			: Vector;
		var range, knockdownDur					: float;
		var movementAdjustor					: CMovementAdjustor;
		var ticket_rotate						: SMovementAdjustmentRequestTicket;

		thePlayer.EnableCollisions(true);

		if (!thePlayer.IsUsingHorse()&& !thePlayer.IsUsingVehicle()){thePlayer.EnableCharacterCollisions(true); }

		ACS_SlowMoAdjustable(0.3, 0.1);

		ACS_ExplorationDelayHack(false, 3);

		if (thePlayer.IsOnGround() || playerContactWithNpc)
		{
			//thePlayer.RaiseEvent('ACS_TorsoBendReset');

			//thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( 'tw2_npc_sword1h_40_ACS', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0.125f, 0.125f) );

			if (((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'wood_hollow'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'wood_debris'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'dirt_hard'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'dirt_soil'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'hay'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'stone_debris'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'stone_solid'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'clay_tile'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'gravel_large'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'gravel_small'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'sand'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'water_shallow'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'water_deep'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'grass_short'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'grass_long'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'carpet'
			)
			{

				thePlayer.StopEffect('jump_ground_fx1');
				thePlayer.PlayEffect('jump_ground_fx1');

				if (((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'dirt_hard'
				|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'dirt_soil'
				|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'hay'
				|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'stone_debris'
				|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'clay_tile'
				|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'gravel_large'
				|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'gravel_small'
				|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'sand'
				|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'grass_short'
				|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'grass_long'
				)
				{
					//thePlayer.StopEffect('covered_dirt_ACS');
					//thePlayer.PlayEffect('covered_dirt_ACS');

					if( GetRainStrength() > 0 
					&& !thePlayer.IsInInterior()
					&& !RoofCheck()
					) 
					{

					}
					else if (ACS_Settings_Main_Bool('acs_player_misc_settings','acs_dirt_vfx_enabled', true))
					{
						thePlayer.StopEffect('covered_dirt_big_ACS');
						thePlayer.PlayEffect('covered_dirt_big_ACS');

						thePlayer.StopEffect('covered_dirt_small_ACS');
						thePlayer.PlayEffect('covered_dirt_small_ACS');
					}
				}
			}

			rot = GetWitcherPlayer().GetWorldRotation();

			pos = ACSFixZAxis(GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetWorldForward() * 2);

			thePlayer.SoundEvent("monster_nazair_guard_combat_hits_ground");

			thePlayer.SoundEvent("monster_cloud_giant_fx_rumble_crack");

			pos.Z += 1;

			if (thePlayer.HasTag('ACS_Flammable_Oil_Enabled')
			)
			{
				if (ACS_GetItem_SwordHeldSwitchBasedUponStat('frost_sword'))
				{
					theGame.GetSurfacePostFX().AddSurfacePostFXGroup( TraceFloor( pos ), 0.125f, 3, 0.125f, 10.f, 0);

					template = (CEntityTemplate)LoadResource("dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent", true);

					entPhysics = theGame.CreateEntity( template, pos, rot );

					if( thePlayer.GetStat(BCS_Focus) >= thePlayer.GetStatMax( BCS_Focus ) * 0 && thePlayer.GetStat(BCS_Focus) < thePlayer.GetStatMax( BCS_Focus ) * 0.33)
					{
						entPhysics.PlayEffect('blast_lv2_aard');
					}
					else if( thePlayer.GetStat(BCS_Focus) >= thePlayer.GetStatMax( BCS_Focus ) * 0.33 && thePlayer.GetStat(BCS_Focus) < thePlayer.GetStatMax( BCS_Focus ) * 0.66)
					{
						entPhysics.PlayEffect('blast_lv2_aard');

						entPhysics.PlayEffect('blast_ground_mutation_6_aard');

						entPhysics.PlayEffect('blast_lv2_damage_aard');

						entPhysics.PlayEffect('blast_lv2_power_aard');
					}
					else if( thePlayer.GetStat(BCS_Focus) >= thePlayer.GetStatMax( BCS_Focus ) * 0.66)
					{
						entPhysics.PlayEffect('blast_lv2_aard');

						entPhysics.PlayEffect('blast_ground_mutation_6_aard');

						entPhysics.PlayEffect('blast_lv2_damage_aard');

						entPhysics.PlayEffect('blast_lv2_power_aard');

						vACS_Ice_Spikes = new cACS_Ice_Spikes in this;
				
						vACS_Ice_Spikes.ACS_Ice_Blast_Engage();
					}
				}
				else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('poison_sword'))
				{
					ACS_Poison_Cloud();
				}
				else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('bleed_sword'))
				{
					ACS_Blood_Arc();
				}
				else
				{
					theGame.GetSurfacePostFX().AddSurfacePostFXGroup( TraceFloor( pos ), 0.125f, 3, 0.125f, 10.f, 1);

					template = (CEntityTemplate)LoadResource("dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent", true);

					entPhysics = theGame.CreateEntity( template, pos, rot );

					//entPhysics.PlayEffect('blast_lv2_aard_fire');

					//entPhysics.PlayEffect('blast_lv1_aard_fire');

					if( thePlayer.GetStat(BCS_Focus) >= thePlayer.GetStatMax( BCS_Focus ) * 0 && thePlayer.GetStat(BCS_Focus) < thePlayer.GetStatMax( BCS_Focus ) * 0.33)
					{
						entPhysics.PlayEffect('leaf_fx_aard_fire');
					}
					else if( thePlayer.GetStat(BCS_Focus) >= thePlayer.GetStatMax( BCS_Focus ) * 0.33 && thePlayer.GetStat(BCS_Focus) < thePlayer.GetStatMax( BCS_Focus ) * 0.66)
					{
						entPhysics.PlayEffect('attack_special_fire_ACS');

						entPhysics.PlayEffect('leaf_fx_aard_fire');

						entPhysics.PlayEffect('attack_fx1_fire_ACS');
					}
					else if( thePlayer.GetStat(BCS_Focus) >= thePlayer.GetStatMax( BCS_Focus ) * 0.66)
					{
						entPhysics.PlayEffect('attack_special_fire_ACS');

						entPhysics.PlayEffect('leaf_fx_aard_fire');

						entPhysics.PlayEffect('attack_fx1_fire_ACS');

						entPhysics.PlayEffect('blast_fire_ACS');

						Rock_Pillar('horse_leap');
						
					}
				}
			}
			else
			{
				template = (CEntityTemplate)LoadResource("dlc\dlc_acs\data\fx\pc_aard.w2ent", true);

				entPhysics = theGame.CreateEntity( template, pos, rot );

				if( thePlayer.GetStat(BCS_Focus) >= thePlayer.GetStatMax( BCS_Focus ) * 0 && thePlayer.GetStat(BCS_Focus) < thePlayer.GetStatMax( BCS_Focus ) * 0.33)
				{
					entPhysics.PlayEffectSingle('sword_ground_hit');
				}
				else if( thePlayer.GetStat(BCS_Focus) >= thePlayer.GetStatMax( BCS_Focus ) * 0.33 && thePlayer.GetStat(BCS_Focus) < thePlayer.GetStatMax( BCS_Focus ) * 0.66)
				{
					entPhysics.PlayEffectSingle('earthquake_fx_small');

					entPhysics.PlayEffectSingle('sword_ground_hit');
				}
				else if( thePlayer.GetStat(BCS_Focus) >= thePlayer.GetStatMax( BCS_Focus ) * 0.66)
				{
					entPhysics.PlayEffectSingle('earthquake_fx_small');

					entPhysics.PlayEffectSingle('sword_ground_hit');

					if (ACS_Armor_Set_Check('forgotten_wolf', false) 
					|| ACS_Armor_Set_Check('acs_armor', false)
					|| ACS_Armor_Set_Check('volhikar', false)
					|| thePlayer.HasTag('acs_vampire_claws_equipped')
					|| ACS_Vampire_Claws_Access()
					)
					{
						entPhysics.PlayEffectSingle('blast_lv3_red');
					}
					else
					{
						entPhysics.PlayEffectSingle('blast_lv3');
					}

					Rock_Pillar('horse_leap');
				}
			}

			entPhysics.DestroyAfter(20);
		
			actors.Clear();

			if( thePlayer.GetStat(BCS_Focus) >= thePlayer.GetStatMax( BCS_Focus ) * 0 && thePlayer.GetStat(BCS_Focus) < thePlayer.GetStatMax( BCS_Focus ) * 0.33)
			{
				range = 2.5;
			}
			else if( thePlayer.GetStat(BCS_Focus) >= thePlayer.GetStatMax( BCS_Focus ) * 0.33 && thePlayer.GetStat(BCS_Focus) < thePlayer.GetStatMax( BCS_Focus ) * 0.66)
			{
				range = 5;
			}
			else if( thePlayer.GetStat(BCS_Focus) >= thePlayer.GetStatMax( BCS_Focus ) * 0.66)
			{
				range = 7.5;
			}

			actors = thePlayer.GetNPCsAndPlayersInCone(range, VecHeading(thePlayer.GetHeadingVector()), 360, 5, , FLAG_ExcludePlayer + FLAG_Attitude_Hostile + FLAG_OnlyAliveActors );

			if( actors.Size() > 0 )
			{
				for( i = 0; i < actors.Size(); i += 1 )
				{
					targetPos = actors[i].GetWorldPosition();

					actortarget = (CActor)actors[i];

					actortarget.IsAttacked();

					actortarget.SignalGameplayEventParamInt('Time2Dodge', (int)EDT_Attack_Light );

					movementAdjustor = actortarget.GetMovingAgentComponent().GetMovementAdjustor();

					ticket_rotate = movementAdjustor.GetRequest( 'ACS_NPC_Kick_Attacked_Rotate');
					movementAdjustor.CancelByName( 'ACS_NPC_Kick_Attacked_Rotate' );
					movementAdjustor.CancelAll();

					ticket_rotate = movementAdjustor.CreateNewRequest( 'ACS_NPC_Kick_Attacked_Rotate' );
					movementAdjustor.AdjustmentDuration( ticket_rotate, 0.5 );
					movementAdjustor.MaxRotationAdjustmentSpeed( ticket_rotate, 50000 );

					dmg = new W3DamageAction in theGame.damageMgr;
					
					dmg.Initialize(thePlayer, actortarget, NULL, thePlayer.GetName(), EHRT_Heavy, CPS_Undefined, false, false, true, false);
					
					dmg.SetProcessBuffsIfNoDamage(true);
					
					dmg.SetIgnoreImmortalityMode(false);

					dmg.SetHitAnimationPlayType(EAHA_ForceYes);
					
					//dmg.AddDamage( theGame.params.DAMAGE_NAME_DIRECT, RandRangeF(damageMax,damageMin) );

					if (((CMovingPhysicalAgentComponent)(actortarget.GetMovingAgentComponent())).GetCapsuleHeight() >= 2
					|| actortarget.GetRadius() >= 0.7
					|| actortarget.HasAbility('Boss')
					|| actortarget.HasTag('IsBoss')
					|| actortarget.HasTag('ACS_Big_Boi')
					|| actortarget.HasTag('ACS_Swapped_To_Shield') 
					|| ((CNewNPC)actortarget).IsShielded( NULL ) 
					)
					{
						if (actortarget.UsesVitality()) 
						{ 
							maxTargetVitality = actortarget.GetStat( BCS_Vitality );

							damageMax = maxTargetVitality * 0.125; 

							damageMin = maxTargetVitality * 0.0625; 
						} 
						else if (actortarget.UsesEssence()) 
						{ 
							maxTargetEssence = actortarget.GetStat( BCS_Essence );
							
							damageMax = maxTargetEssence * 0.125; 
							
							damageMin = maxTargetEssence * 0.0625; 
						}
					}
					else
					{
						if (actortarget.UsesVitality()) 
						{ 
							maxTargetVitality = actortarget.GetStatMax( BCS_Vitality ) - actortarget.GetStat( BCS_Vitality );

							damageMax = maxTargetVitality * 0.125; 

							damageMin = maxTargetVitality * 0.0625; 
						} 
						else if (actortarget.UsesEssence()) 
						{ 
							maxTargetEssence = actortarget.GetStatMax( BCS_Essence ) - actortarget.GetStat( BCS_Essence );
							
							damageMax = maxTargetEssence * 0.125; 
							
							damageMin = maxTargetEssence * 0.0625; 
						}
					}

					dmg.AddDamage( theGame.params.DAMAGE_NAME_PHYSICAL, RandRangeF(50 + damageMax,50 + damageMin) );

					dmg.AddDamage( theGame.params.DAMAGE_NAME_SILVER, RandRangeF(50 + damageMax,50 + damageMin) );

					//thePlayer.SoundEvent("cmb_fistfight_parry");

					dmg.SetHitReactionType( EHRT_Heavy, true);

					movementAdjustorNPC.RotateTowards( ticketNPC, thePlayer );

					if( thePlayer.GetStat(BCS_Focus) >= thePlayer.GetStatMax( BCS_Focus ) * 0 && thePlayer.GetStat(BCS_Focus) < thePlayer.GetStatMax( BCS_Focus ) * 0.33)
					{
						knockdownDur = 1;

						if(!actortarget.IsImmuneToBuff(EET_Stagger) || !actortarget.IsImmuneToBuff(EET_Stagger) )
						{
							if(!actortarget.IsImmuneToBuff(EET_Stagger) )
							{
								dmg.AddEffectInfo( EET_Stagger, knockdownDur );
							}
						}
					}
					else if( thePlayer.GetStat(BCS_Focus) >= thePlayer.GetStatMax( BCS_Focus ) * 0.33 && thePlayer.GetStat(BCS_Focus) < thePlayer.GetStatMax( BCS_Focus ) * 0.66)
					{
						knockdownDur = 1.5;

						if(!actortarget.IsImmuneToBuff(EET_HeavyKnockdown) || !actortarget.IsImmuneToBuff(EET_HeavyKnockdown) )
						{
							if(!actortarget.IsImmuneToBuff(EET_HeavyKnockdown) )
							{
								dmg.AddEffectInfo( EET_HeavyKnockdown, knockdownDur );
							}
							else
							{
								dmg.AddEffectInfo( EET_Knockdown, knockdownDur );
							}
						}
					}
					else if( thePlayer.GetStat(BCS_Focus) >= thePlayer.GetStatMax( BCS_Focus ) * 0.66)
					{
						knockdownDur = 2;

						if(!actortarget.IsImmuneToBuff(EET_HeavyKnockdown) || !actortarget.IsImmuneToBuff(EET_HeavyKnockdown) )
						{
							if(!actortarget.IsImmuneToBuff(EET_HeavyKnockdown) )
							{
								dmg.AddEffectInfo( EET_HeavyKnockdown, knockdownDur );
							}
							else
							{
								dmg.AddEffectInfo( EET_Knockdown, knockdownDur );
							}
						}
					}

					if (thePlayer.HasTag('ACS_Flammable_Oil_Enabled')
					)
					{
						if (ACS_GetItem_SwordHeldSwitchBasedUponStat('frost_sword'))
						{
							dmg.AddEffectInfo( EET_Frozen, 3 );
						}
						else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('poison_sword'))
						{
							dmg.AddEffectInfo( EET_Poison, 3 );
						}
						else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('bleed_sword'))
						{
							dmg.AddEffectInfo( EET_Bleeding, 3 );
						} 
						else
						{
							dmg.AddEffectInfo( EET_Burning, 3 );
						}
					}

					//thePlayer.SoundEvent("scene_cmb_fist_hit");

					thePlayer.GainStat( BCS_Focus, thePlayer.GetStatMax( BCS_Focus) * 0.15 );
				
					dmg.SetCriticalHit(); theGame.damageMgr.ProcessAction( dmg );
						
					delete dmg;	

					if(thePlayer.IsOnGround() && actortarget.IsOnGround() && actortarget.GetCurrentHealth() <= 0)
					{
						thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( 'tw2_npc_sword1h_40_ACS', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0.125f, 0.125f) );
					}
				}
			}
		}
	}

	timer function HorseDismountJumpRestoreCollision( dt : float, id : int )
	{
		ACS_ExplorationDelayHack(false, 3);

		RemoveTimer('HorseDismountJumpAttackRemoveTag');
		AddTimer('HorseDismountJumpAttackRemoveTag', 0.5f   , false);

		thePlayer.EnableCollisions(true);

		if (!thePlayer.IsUsingHorse()&& !thePlayer.IsUsingVehicle()){thePlayer.EnableCharacterCollisions(true); }

		GetWitcherPlayer().UnblockAction( EIAB_Movement,			'acs_horse_dismount_jump');
		GetWitcherPlayer().UnblockAction( EIAB_MountVehicle,		'acs_horse_dismount_jump');
		GetWitcherPlayer().UnblockAction( EIAB_DismountVehicle,		'acs_horse_dismount_jump');
		GetWitcherPlayer().UnblockAction( EIAB_Crossbow, 			'acs_horse_dismount_jump');
		GetWitcherPlayer().UnblockAction( EIAB_CallHorse,			'acs_horse_dismount_jump');
		GetWitcherPlayer().UnblockAction( EIAB_Signs, 				'acs_horse_dismount_jump');
		GetWitcherPlayer().UnblockAction( EIAB_DrawWeapon, 			'acs_horse_dismount_jump'); 
		GetWitcherPlayer().UnblockAction( EIAB_FastTravel, 			'acs_horse_dismount_jump');
		GetWitcherPlayer().UnblockAction( EIAB_Fists, 				'acs_horse_dismount_jump');
		GetWitcherPlayer().UnblockAction( EIAB_InteractionAction, 	'acs_horse_dismount_jump');
		GetWitcherPlayer().UnblockAction( EIAB_UsableItem,			'acs_horse_dismount_jump');
		GetWitcherPlayer().UnblockAction( EIAB_ThrowBomb,			'acs_horse_dismount_jump');
		GetWitcherPlayer().UnblockAction( EIAB_SwordAttack,			'acs_horse_dismount_jump');
		GetWitcherPlayer().UnblockAction( EIAB_Jump,				'acs_horse_dismount_jump');
		GetWitcherPlayer().UnblockAction( EIAB_LightAttacks,		'acs_horse_dismount_jump');
		GetWitcherPlayer().UnblockAction( EIAB_HeavyAttacks,		'acs_horse_dismount_jump');
		GetWitcherPlayer().UnblockAction( EIAB_SpecialAttackLight,	'acs_horse_dismount_jump');
		GetWitcherPlayer().UnblockAction( EIAB_SpecialAttackHeavy,	'acs_horse_dismount_jump');
		GetWitcherPlayer().UnblockAction( EIAB_Dodge,				'acs_horse_dismount_jump');
		GetWitcherPlayer().UnblockAction( EIAB_Roll,				'acs_horse_dismount_jump');
		GetWitcherPlayer().UnblockAction( EIAB_Parry,				'acs_horse_dismount_jump');
		GetWitcherPlayer().UnblockAction( EIAB_MeditationWaiting,	'acs_horse_dismount_jump');
		GetWitcherPlayer().UnblockAction( EIAB_OpenMeditation,		'acs_horse_dismount_jump');
		GetWitcherPlayer().UnblockAction( EIAB_RadialMenu,			'acs_horse_dismount_jump');
		GetWitcherPlayer().UnblockAction( EIAB_Interactions, 		'acs_horse_dismount_jump');
	}

	timer function HorseDismountJumpAttackRemoveTag( dt : float, id : int )
	{
		ACS_ExplorationDelayHack(false, 3);

		thePlayer.RemoveTag('ACS_Horse_Dismount_Jump_Attack');

		theGame.ReleaseNoSaveLock( ACS_Horse_Dismount_Jump_Savelock_ID );

		horseLeapStrikeProcess = false;
	}

	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	public var drunkenessRagdollCheck : bool;
	default drunkenessRagdollCheck = false;

	function SetDrunkenessRagdollCheck( b : bool )
	{
		if (b)
		{
			thePlayer.PlayBattleCry('BattleCryBadSituation', 1, true, true );

			GetWitcherPlayer().SetImmortalityMode( AIM_Invulnerable, AIC_Default, true );

			GetWitcherPlayer().SetCanPlayHitAnim(false);

			theGame.CreateNoSaveLock( "ACS_Drunk_Ragdoll_State", ACS_Drunk_Ragdoll_Savelock_ID, false, false );
		}

		drunkenessRagdollCheck = b;
	}

	timer function RagdollGetup( dt : float, id : int )
	{
		var lines 					: array<int>;

		if (thePlayer.IsAnyWeaponHeld()
		&& !thePlayer.IsWeaponHeld('fist')
		)
		{
			if (RandF() < 0.5)
			{
				thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( 'man_npc_sword_1hand_front_getup_l_ACS', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0, 0.5) );
			}
			else
			{
				thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( 'man_npc_sword_1hand_back_getup_l_ACS', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0, 0.5) );
			}
		}
		else
		{
			if (RandF() < 0.5)
			{
				thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( 'locomotion_man_geralt_back_getup_normal', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0, 0.5) );
			}
			else
			{
				thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( 'locomotion_man_geralt_front_getup_normal', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0, 0.5) );
			}
		}

		lines.Clear();
		lines.PushBack(535513);
		lines.PushBack(532759);
		lines.PushBack(1046718);
		lines.PushBack(1046714);
		lines.PushBack(1046716);
		lines.PushBack(1046712);

		thePlayer.PlayLine( lines[RandRange(lines.Size())], false);

		thePlayer.SetKinematic( true );

		RemoveTimer('RagdollGetupRemoveBlock');
		AddTimer('RagdollGetupRemoveBlock', 1.25   , false);
	}

	timer function RagdollGetupRemoveBlock( dt : float, id : int )
	{
		drunkenessRagdollCheck = false;

		thePlayer.BlockAllActions( 'ACS_Drunkenness_Ragdoll', false );

		GetWitcherPlayer().SetImmortalityMode( AIM_None, AIC_Default, true );

		GetWitcherPlayer().SetCanPlayHitAnim(true);

		theGame.ReleaseNoSaveLock( ACS_Drunk_Ragdoll_Savelock_ID );
	}

	timer function ACS_TakeTrophyHandRevert( dt : float, id : int )
	{
		if (!thePlayer.IsAnyWeaponHeld() || thePlayer.IsWeaponHeld('fist') )
		{
			//thePlayer.RaiseEvent('LootHerb');

			thePlayer.RaiseEvent('ACS_HolsterDagger');

			if ( !theSound.SoundIsBankLoaded("qu_nml_105.bnk") )
			{
				theSound.SoundLoadBank( "qu_nml_105.bnk", false );
			}

			GetWitcherPlayer().SoundEvent("qu_nml_105_geralt_sheats_dagger");


			ACSGetCEntityDestroyAll('acs_trophy_dagger_1');
		}
		else
		{
			thePlayer.RaiseEvent('ACS_ForceHandClosedREnd');
		}
	}

	function ACS_CreateTrophyDagger()
	{
		if (!thePlayer.IsAnyWeaponHeld() || thePlayer.IsWeaponHeld('fist') )
		{
			ACSGetCEntityDestroyAll('acs_trophy_dagger_1');

			vACS_Dagger_Summon = new cACS_Dagger_Summon in this;
				
			vACS_Dagger_Summon.ACS_Trophy_Dagger_Summon_Engage();
		}
		else
		{
			thePlayer.RaiseEvent('ACS_ForceHandClosedRBackhand');
		}
	}


				ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker_bigger');
				ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker_biggest');

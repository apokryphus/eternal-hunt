	function GeraltLightAttack()
	{	
		if (thePlayer.HasTag('acs_igni_secondary_sword_equipped_TAG'))
		{
			thePlayer.RemoveTag('acs_igni_secondary_sword_equipped_TAG');	
		}
		
		if (!thePlayer.HasTag('acs_igni_sword_equipped_TAG'))
		{
			thePlayer.AddTag('acs_igni_sword_equipped_TAG');	
		}

		if (thePlayer.HasTag('ACS_Dual_Wield_Active')
		)
		{
			Attack_Setup_03('DualWieldLightAttack');

			return;
		}

		if (thePlayer.HasTag('ACS_Spear_Transform_Active')
		)
		{
			Attack_Setup_13('FocusModeSpearLightAttack');

			return;
		}

		if (ACS_GetItem_Sword_IsEquipped('zireal_steel_held', 'steel') || ACS_GetItem_Sword_IsEquipped('zireal_silver_held', 'silver'))
		{
			Attack_Setup_08('GeraltCiriLightAttack');

			return;
		}

		if (ACS_Armor_Set_Check('wolf', true))
		{
			Attack_Setup_03('GeraltWolfLightAttack');
		}
		else if (ACS_Armor_Set_Check('bear', true))
		{
			Attack_Setup_04('GeraltBearLightAttack');
		}
		else if (ACS_Armor_Set_Check('cat', true))
		{
			Attack_Setup_04('GeraltCatLightAttack');
		}
		else if (ACS_Armor_Set_Check('griffin', true))
		{
			Attack_Setup_05('GeraltGriffinLightAttack');
		}
		else if (ACS_Armor_Set_Check('manticore', true))

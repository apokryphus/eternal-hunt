	public timer function ACS_Ice_Giant_Armor_Timer ( dt : float, id : int){ IceGiantArmorIndicator(); if(theGame.GetEngineTimeAsSeconds() - last_ice_spikes_time > 1){last_ice_spikes_time = theGame.GetEngineTimeAsSeconds();ACS_Ice_Spikes();} if(theGame.GetEngineTimeAsSeconds() - last_ice_blast_time > RandRangeF(10,5)){last_ice_blast_time = theGame.GetEngineTimeAsSeconds();ACS_Ice_Blast();}} 

	public timer function ACS_Red_Lightning_Timer ( dt : float, id : int){if(theGame.GetEngineTimeAsSeconds() - last_red_lightning_time > RandRangeF(2,1)){last_red_lightning_time = theGame.GetEngineTimeAsSeconds();ACS_Red_Lightning();}} 

	public timer function ACS_Embers_Particles_Timer ( dt : float, id : int)
	{ 
		if (!thePlayer.HasTag('acs_in_wraith') 
		&& !thePlayer.HasTag('ACS_Camo_Active') 
		&& !thePlayer.IsEffectActive( 'invisible' )
		&& !theGame.IsFading()
		&& !theGame.IsBlackscreen()
		)
		{
			if (!thePlayer.IsEffectActive('embers_particles_test', false))
			{
				thePlayer.PlayEffectSingle('embers_particles_test');
				//thePlayer.StopEffect('embers_particles_test');
			}
		}
		else
		{
			thePlayer.DestroyEffect('embers_particles_test');
		}
	} 

	public timer function ACS_ResetAnimation ( dt: float, id : int){ if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();} } 

	public timer function ACS_ResetAnimationInDanceOfWrath ( dt: float, id : int){ if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers(); GetWitcherPlayer().ACS_SetAnimationSpeedMultiplier( 4 );} } 

	public timer function ACS_Caranthir_ResetAnimation ( dt: float, id : int){ if( ACSGetCActor('ACS_Canaris').IsAlive()) {ACSGetCActor('ACS_Canaris').ACS_ClearAnimationSpeedMultipliers();} } 
	
	public timer function ACS_reveal_timer ( dt : float, id : int) { thePlayer.SetVisibility( true ); thePlayer.RemoveTag('ACS_In_Umbral_Slash_End');} 


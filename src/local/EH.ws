					{
						
							ACS_refresh_light_attack_cooldown();
																			
							thePlayer.BreakPheromoneEffect();
														
							PrimaryWeaponSwitch();
														
							if (thePlayer.IsGuarded() && thePlayer.HasTag('acs_axii_sword_equipped'))
							{
								if (Attack_Directional_Press_Check())
								{
									Attack_Process_17('geraltRandomShieldLightAttackAlt');
								}
								else
								{
									Attack_Process_17('geraltRandomShieldLightAttack');
								}
							}
							else
							{
								if (Attack_Directional_Press_Check())
								{
									Attack_Process_19('geraltRandomEredinLightAttackAlt');

									if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	
							
									if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier( 1.75  ); }
																
									RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5  , false);	
								}
								//else if (theInput.GetActionValue('GI_AxisLeftY') < -0.5
								else if (theInput.GetActionValue(DodgeOrRoll()) > 0.7
								&& thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus ) * 1/3 )
								{
									ACS_Tutorial_Display_Check('ACS_Weapon_Arts_Tutorial_Shown');

									RemoveTimer('RollDelay');

									Sparagmos();

									if( thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus )/3
									&& thePlayer.GetStat( BCS_Focus ) < thePlayer.GetStatMax( BCS_Focus ) * 2/3) 
									{	
										
										thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) );
									}
									else if( thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus ) * 2/3
									&& thePlayer.GetStat( BCS_Focus ) < thePlayer.GetStatMax( BCS_Focus ) * 0.9875 )  
									{	
										thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) * 1/3);
									}
									else if( thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus ) * 0.9875 ) 
									{
										thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) * 1/3);
									}
								}
								else
								{
									Attack_Process_19('geraltRandomEredinLightAttack');

									if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	
							
									if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier( 1.75  ); }
																
									RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5  , false);	
								}	
							}

							ACS_StaminaDrain(1);	
						
					}
					break;

					case 'HybridModeEredinShieldLightAttack':
					if (ACS_can_perform_light_attack())
					{
						
							ACS_refresh_light_attack_cooldown();
								
							thePlayer.BreakPheromoneEffect();
														
							PrimaryWeaponSwitch();
														
							if (thePlayer.IsGuarded() && thePlayer.HasTag('acs_axii_sword_equipped'))
							{		
								Attack_Process_17('geraltRandomShieldLightAttack');
							}
							else
							{	
								Attack_Process_19('geraltRandomEredinLightAttack');
							} 	

							if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	
							
							if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier(1.75  ); }
														
							RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5   , false);

							ACS_StaminaDrain(1);
						
					}
					break;

					case 'HybridModeEredinShieldForwardLightAttack':
					if (ACS_can_perform_light_attack())
					{
						
							ACS_refresh_light_attack_cooldown();
								
							thePlayer.BreakPheromoneEffect();
														
							PrimaryWeaponSwitch();
														
							if (thePlayer.IsGuarded() && thePlayer.HasTag('acs_axii_sword_equipped'))
							{
								Attack_Process_17('geraltRandomShieldLightAttackAlt');
							}
							else
							{
								Attack_Process_19('geraltRandomEredinLightAttackAlt');
							} 	

							if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	
							
							if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier(1.75  ); }
														
							RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5   , false);

							ACS_StaminaDrain(1);
						
					}
					break;

					case 'FocusModeImlerithLightAttack':
					if (ACS_can_perform_light_attack())
					{
						
							ACS_refresh_light_attack_cooldown();
															
							thePlayer.BreakPheromoneEffect();
															
							PrimaryWeaponSwitch();
										
							if (Attack_Directional_Press_Check())
							{
								Attack_Process_21('geraltRandomImlerithLightAttack');

								RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5  , false);	
							}
							//else if (theInput.GetActionValue('GI_AxisLeftY') < -0.5
							else if (theInput.GetActionValue(DodgeOrRoll()) > 0.7
							&& thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus ) * 1/3 )
							{
								ACS_Tutorial_Display_Check('ACS_Weapon_Arts_Tutorial_Shown');

								RemoveTimer('RollDelay');

								vACS_TK = new cACS_TK in this;

								ACS_Tutorial_Display_Check('ACS_Caressing_Moon_Tutorial_Shown');

								vACS_TK.ACS_TK_Engage();


								if( thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus )/3
								&& thePlayer.GetStat( BCS_Focus ) < thePlayer.GetStatMax( BCS_Focus ) * 2/3) 
								{		
									thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) );
								}
								else if( thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus ) * 2/3
								&& thePlayer.GetStat( BCS_Focus ) < thePlayer.GetStatMax( BCS_Focus ) * 0.9875 )  
								{	
									thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) * 1/3);
								}
								else if( thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus ) * 0.9875 ) 
								{
									thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) * 1/3);
								}
							}
							else
							{
								Attack_Process_21('geraltRandomImlerithLightAttack');

								if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	

								if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier(1.5  ); }

								RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5  , false);	
							}

							ACS_StaminaDrain(1);
						
					}
					break;

					case 'HybridModeImlerithLightAttack':
					if (ACS_can_perform_light_attack())
					{
						
							ACS_refresh_light_attack_cooldown();
															
							thePlayer.BreakPheromoneEffect();
															
							PrimaryWeaponSwitch();
															
							Attack_Process_21('geraltRandomImlerithLightAttack'); 			

							if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}			
															
							if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier( 1.5  ); }
							
							RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5   , false);

							ACS_StaminaDrain(1);
						
					}
					break;

					
					default:
					break;
				}
				
			}
		}
	}

	function Attack_Setup_13( attack_name : name )
	{	
		ACS_ExplorationDelayHack(false, 3);

		finisherActorTarget = (CActor)( thePlayer.GetTarget() );	
		ccomp = finisherActorTarget.GetComponent("Finish");
		ccompEnabled = ccomp.IsEnabled();

		if (
		ccompEnabled
		&& ACS_AttitudeCheck (finisherActorTarget)
		&& VecDistanceSquared2D( thePlayer.GetWorldPosition(), finisherActorTarget.GetNearestPointInBothPersonalSpaces( thePlayer.GetWorldPosition() ) ) < 2.75f * 2.75f
		)
		{
			PrimarySecondaryWeaponSwitch ( attack_name );

			ACS_Setup_Light_Attack_Internal();
		}
		else
		{
			if ( ACS_Settings_Main_Bool('acs_stamina_settings','acs_stamina_block_action', false) 
			&& StaminaCheck('default')
			)
			{
				RemoveTimer('SwordTauntSwitch'); RemoveTimer('SwordTauntRunningSwitch');   if (thePlayer.HasTag('ACS_IsSwordWalking')){thePlayer.RemoveTag('ACS_IsSwordWalking');} if(thePlayer.IsInCombat()){if(thePlayer.GetCombatIdleStance() <= 0.f ){thePlayer.RaiseEvent('ACS_CombatTauntLeft');}else{thePlayer.RaiseEvent('ACS_CombatTauntRight');}} thePlayer.SoundEvent("gui_no_stamina");
			}
			else
			{
				switch ( attack_name )
				{
					case 'HybridModeImlerithForwardLightAttack':
					if (ACS_can_perform_light_attack())
					{
						
							ACS_refresh_light_attack_cooldown();
															
							thePlayer.BreakPheromoneEffect();
															
							PrimaryWeaponSwitch();

							Attack_Process_21('geraltRandomImlerithLightAttack');
							
							RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5   , false);

							ACS_StaminaDrain(1);
						
					}
					break;

					case 'FocusModeSpearLightAttack':
					if (ACS_can_perform_light_attack())
					{
						
							ACS_refresh_light_attack_cooldown();
															
							thePlayer.BreakPheromoneEffect();
															
							SecondaryWeaponSwitch();					
															
							if (Attack_Directional_Press_Check())
							{
								Attack_Process_21('geraltRandomSpearLightAttackAlt');

								if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	

								if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier( 1.5  ); }

								RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5   , false);
							}
							//else if (theInput.GetActionValue('GI_AxisLeftY') < -0.5
							else if (theInput.GetActionValue(DodgeOrRoll()) > 0.7
							&& thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus ) * 1/3 )
							{
								ACS_Tutorial_Display_Check('ACS_Weapon_Arts_Tutorial_Shown');

								RemoveTimer('RollDelay');

								if (thePlayer.HasTag('ACS_Spear_Transform_Active'))
								{
									FlammableOilEvent();
								}
								else
								{
									Storm_Spear();
								}

								if( thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus )/3
								&& thePlayer.GetStat( BCS_Focus ) < thePlayer.GetStatMax( BCS_Focus ) * 2/3) 
								{	
									thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) );
								}
								else if( thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus ) * 2/3
								&& thePlayer.GetStat( BCS_Focus ) < thePlayer.GetStatMax( BCS_Focus ) * 0.9875 )  
								{	
									thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) * 1/3);
								}
								else if( thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus ) * 0.9875 ) 
								{
									thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) * 1/3);
								}
							}
							else if ((theInput.GetActionValue(TargetLockOrSpawnHorse()) > 0.1f || theInput.GetActionValue('CameraLockOrSpawnHorse') > 0.1f)
							&& thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus ) * 1/3 
							&& thePlayer.HasTag('ACS_Spear_Transform_Active')
							)
							{
								ACSHeavenlyStrike();
							}
							else
							{
								Attack_Process_22('geraltRandomSpearLightAttack');

								if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	

								if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier( 1.5  ); }

								RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5   , false);
							}

							ACS_StaminaDrain(1);
						
					}
					break;

					case 'FocusModeJinguBangLightAttack':
					if (ACS_can_perform_light_attack())
					{
						
							ACS_refresh_light_attack_cooldown();
															
							thePlayer.BreakPheromoneEffect();
															
							SecondaryWeaponSwitch();					
															
							if (Attack_Directional_Press_Check())
							{
								Attack_Process_23('geraltJingubangLightAttackAlt');

								if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	

								if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier( 1.5  ); }

								RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5   , false);
							}
							else
							{
								Attack_Process_22('geraltJingubangLightAttack');

								if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	

								if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier( 1.5  ); }

								RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5   , false);
							}

							ACS_StaminaDrain(1);
						
					}
					break;

					case 'FocusModeMageLightAttack':
					if (ACS_can_perform_light_attack())
					{
						
							ACS_refresh_light_attack_cooldown();
															
							thePlayer.BreakPheromoneEffect();
															
							PrimaryWeaponSwitch();	

							if (thePlayer.GetStat( BCS_Focus ) > thePlayer.GetStatMax( BCS_Focus ) * 0
							&& thePlayer.GetStat( BCS_Stamina ) > thePlayer.GetStatMax( BCS_Stamina ) * 0)
							{
								if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	

								RemoveTimer('ACS_ResetAnimation');

								Attack_Process_23('geraltMageLightAttack');
							}
							else
							{
								if (Attack_Directional_Press_Check())
								{
									Attack_Process_21('geraltRandomSpearLightAttackAlt');

									if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	

									if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier( 1.5  ); }

									RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5   , false);
								}
								else
								{
									Attack_Process_22('geraltRandomSpearLightAttack');

									if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	

									if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier( 1.5  ); }

									RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5   , false);
								}
							}							
							

							ACS_StaminaDrain(1);
						
					}
					break;

					case 'HybridModeSpearLightAttack':
					if (ACS_can_perform_light_attack())
					{
						
							ACS_refresh_light_attack_cooldown();
															
							thePlayer.BreakPheromoneEffect();
															
							SecondaryWeaponSwitch();
															
							Attack_Process_22('geraltRandomSpearLightAttack'); 				

							if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}		
															
							if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier( 1.5  ); }

							RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5   , false);

							ACS_StaminaDrain(1);
						
					}
					break;

					case 'HybridModeSpearForwardLightAttack':
					if (ACS_can_perform_light_attack())
					{
						
							ACS_refresh_light_attack_cooldown();
															
							thePlayer.BreakPheromoneEffect();
															
							SecondaryWeaponSwitch();
															
							Attack_Process_21('geraltRandomSpearLightAttackAlt'); 		

							if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}				
															
							if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier( 1.5  ); }

							RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5   , false);

							ACS_StaminaDrain(1);
						
					}
					break;


					
					default:
					break;
				}
				
			}
		}
	}


	function weapon_blood_fx(blood_type : name)
	{
		switch(blood_type)
		{
			case 'yellow' :
				ACSGetCEntity('acs_sword_trail_1').StopEffect('aerondight_blood_yellow');
				ACSGetCEntity('acs_sword_trail_1').PlayEffectSingle('aerondight_blood_yellow');

				ACSGetCEntity('acs_sword_trail_2').StopEffect('aerondight_blood_yellow');
				ACSGetCEntity('acs_sword_trail_2').PlayEffectSingle('aerondight_blood_yellow');

				ACSGetCEntity('acs_sword_trail_3').StopEffect('aerondight_blood_yellow');
				ACSGetCEntity('acs_sword_trail_3').PlayEffectSingle('aerondight_blood_yellow');

				ACSGetCEntity('acs_sword_trail_4').StopEffect('aerondight_blood_yellow');
				ACSGetCEntity('acs_sword_trail_4').PlayEffectSingle('aerondight_blood_yellow');

				ACSGetCEntity('acs_sword_trail_5').StopEffect('aerondight_blood_yellow');
				ACSGetCEntity('acs_sword_trail_5').PlayEffectSingle('aerondight_blood_yellow');

				ACSGetCEntity('acs_sword_trail_6').StopEffect('aerondight_blood_yellow');
				ACSGetCEntity('acs_sword_trail_6').PlayEffectSingle('aerondight_blood_yellow');

				ACSGetCEntity('acs_sword_trail_7').StopEffect('aerondight_blood_yellow');
				ACSGetCEntity('acs_sword_trail_7').PlayEffectSingle('aerondight_blood_yellow');

				ACSGetCEntity('acs_sword_trail_8').StopEffect('aerondight_blood_yellow');
				ACSGetCEntity('acs_sword_trail_8').PlayEffectSingle('aerondight_blood_yellow');



				ACSGetCEntity('acs_sword_trail_1_dual_wield').StopEffect('aerondight_blood_yellow');
				ACSGetCEntity('acs_sword_trail_1_dual_wield').PlayEffectSingle('aerondight_blood_yellow');

				ACSGetCEntity('acs_sword_trail_2_dual_wield').StopEffect('aerondight_blood_yellow');
				ACSGetCEntity('acs_sword_trail_2_dual_wield').PlayEffectSingle('aerondight_blood_yellow');

				ACSGetCEntity('acs_sword_trail_3_dual_wield').StopEffect('aerondight_blood_yellow');
				ACSGetCEntity('acs_sword_trail_3_dual_wield').PlayEffectSingle('aerondight_blood_yellow');
			break;

			case 'black' :
				ACSGetCEntity('acs_sword_trail_1').StopEffect('aerondight_blood_black');
				ACSGetCEntity('acs_sword_trail_1').PlayEffectSingle('aerondight_blood_black');

				ACSGetCEntity('acs_sword_trail_2').StopEffect('aerondight_blood_black');
				ACSGetCEntity('acs_sword_trail_2').PlayEffectSingle('aerondight_blood_black');

				ACSGetCEntity('acs_sword_trail_3').StopEffect('aerondight_blood_black');
				ACSGetCEntity('acs_sword_trail_3').PlayEffectSingle('aerondight_blood_black');

				ACSGetCEntity('acs_sword_trail_4').StopEffect('aerondight_blood_black');
				ACSGetCEntity('acs_sword_trail_4').PlayEffectSingle('aerondight_blood_black');

				ACSGetCEntity('acs_sword_trail_5').StopEffect('aerondight_blood_black');
				ACSGetCEntity('acs_sword_trail_5').PlayEffectSingle('aerondight_blood_black');

				ACSGetCEntity('acs_sword_trail_6').StopEffect('aerondight_blood_black');
				ACSGetCEntity('acs_sword_trail_6').PlayEffectSingle('aerondight_blood_black');

				ACSGetCEntity('acs_sword_trail_7').StopEffect('aerondight_blood_black');
				ACSGetCEntity('acs_sword_trail_7').PlayEffectSingle('aerondight_blood_black');

				ACSGetCEntity('acs_sword_trail_8').StopEffect('aerondight_blood_black');
				ACSGetCEntity('acs_sword_trail_8').PlayEffectSingle('aerondight_blood_black');



				ACSGetCEntity('acs_sword_trail_1_dual_wield').StopEffect('aerondight_blood_black');
				ACSGetCEntity('acs_sword_trail_1_dual_wield').PlayEffectSingle('aerondight_blood_black');

				ACSGetCEntity('acs_sword_trail_2_dual_wield').StopEffect('aerondight_blood_black');
				ACSGetCEntity('acs_sword_trail_2_dual_wield').PlayEffectSingle('aerondight_blood_black');

				ACSGetCEntity('acs_sword_trail_3_dual_wield').StopEffect('aerondight_blood_black');
				ACSGetCEntity('acs_sword_trail_3_dual_wield').PlayEffectSingle('aerondight_blood_black');
			break;

			case 'green' :
				ACSGetCEntity('acs_sword_trail_1').StopEffect('aerondight_blood_green');
				ACSGetCEntity('acs_sword_trail_1').PlayEffectSingle('aerondight_blood_green');

				ACSGetCEntity('acs_sword_trail_2').StopEffect('aerondight_blood_green');
				ACSGetCEntity('acs_sword_trail_2').PlayEffectSingle('aerondight_blood_green');

				ACSGetCEntity('acs_sword_trail_3').StopEffect('aerondight_blood_green');
				ACSGetCEntity('acs_sword_trail_3').PlayEffectSingle('aerondight_blood_green');

				ACSGetCEntity('acs_sword_trail_4').StopEffect('aerondight_blood_green');
				ACSGetCEntity('acs_sword_trail_4').PlayEffectSingle('aerondight_blood_green');

				ACSGetCEntity('acs_sword_trail_5').StopEffect('aerondight_blood_green');
				ACSGetCEntity('acs_sword_trail_5').PlayEffectSingle('aerondight_blood_green');

				ACSGetCEntity('acs_sword_trail_6').StopEffect('aerondight_blood_green');
				ACSGetCEntity('acs_sword_trail_6').PlayEffectSingle('aerondight_blood_green');

				ACSGetCEntity('acs_sword_trail_7').StopEffect('aerondight_blood_green');
				ACSGetCEntity('acs_sword_trail_7').PlayEffectSingle('aerondight_blood_green');

				ACSGetCEntity('acs_sword_trail_8').StopEffect('aerondight_blood_green');
				ACSGetCEntity('acs_sword_trail_8').PlayEffectSingle('aerondight_blood_green');



				ACSGetCEntity('acs_sword_trail_1_dual_wield').StopEffect('aerondight_blood_green');
				ACSGetCEntity('acs_sword_trail_1_dual_wield').PlayEffectSingle('aerondight_blood_green');

				ACSGetCEntity('acs_sword_trail_2_dual_wield').StopEffect('aerondight_blood_green');
				ACSGetCEntity('acs_sword_trail_2_dual_wield').PlayEffectSingle('aerondight_blood_green');

				ACSGetCEntity('acs_sword_trail_3_dual_wield').StopEffect('aerondight_blood_green');
				ACSGetCEntity('acs_sword_trail_3_dual_wield').PlayEffectSingle('aerondight_blood_green');
			break;

			case 'red' :
				blood_fx.Clear();
		
				if (!thePlayer.HasTag('ACS_HasPerformedFinisher'))
				{
					blood_fx.PushBack('blood_trail_horseriding');
					blood_fx.PushBack('blood_trail_finisher');
					blood_fx.PushBack('fast_trail_blood_fx');
				}

				blood_fx.PushBack('cutscene_blood_trail');
				blood_fx.PushBack('cutscene_blood_trail_02');

				if (thePlayer.HasTag('acs_axii_sword_equipped'))
				{
					ACSGetCEntity('acs_sword_trail_3').StopEffect('aerondight_blood_red');
					ACSGetCEntity('acs_sword_trail_3').PlayEffectSingle('aerondight_blood_red');

					if (ACS_GetWeaponMode() == 0
					|| ACS_GetWeaponMode() == 1
					|| ACS_GetWeaponMode() == 2
					)
					{
						ACSGetCEntity('acs_axii_sword_1').StopEffect('cutscene_blood_trail');
						ACSGetCEntity('acs_axii_sword_1').StopEffect('cutscene_blood_trail_02');
						ACSGetCEntity('acs_axii_sword_1').StopEffect('blood_trail_horseriding');
						ACSGetCEntity('acs_axii_sword_1').StopEffect('blood_trail_finisher');
						ACSGetCEntity('acs_axii_sword_1').StopEffect('fast_trail_blood_fx');

						ACSGetCEntity('acs_axii_sword_2').StopEffect('cutscene_blood_trail');
						ACSGetCEntity('acs_axii_sword_2').StopEffect('cutscene_blood_trail_02');
						ACSGetCEntity('acs_axii_sword_2').StopEffect('blood_trail_horseriding');
						ACSGetCEntity('acs_axii_sword_2').StopEffect('blood_trail_finisher');
						ACSGetCEntity('acs_axii_sword_2').StopEffect('fast_trail_blood_fx');

						ACSGetCEntity('acs_axii_sword_3').StopEffect('cutscene_blood_trail');
						ACSGetCEntity('acs_axii_sword_3').StopEffect('cutscene_blood_trail_02');
						ACSGetCEntity('acs_axii_sword_3').StopEffect('blood_trail_horseriding');
						ACSGetCEntity('acs_axii_sword_3').StopEffect('blood_trail_finisher');
						ACSGetCEntity('acs_axii_sword_3').StopEffect('fast_trail_blood_fx');

						ACSGetCEntity('acs_axii_sword_4').StopEffect('cutscene_blood_trail');
						ACSGetCEntity('acs_axii_sword_4').StopEffect('cutscene_blood_trail_02');
						ACSGetCEntity('acs_axii_sword_4').StopEffect('blood_trail_horseriding');
						ACSGetCEntity('acs_axii_sword_4').StopEffect('blood_trail_finisher');
						ACSGetCEntity('acs_axii_sword_4').StopEffect('fast_trail_blood_fx');

						ACSGetCEntity('acs_axii_sword_5').StopEffect('cutscene_blood_trail');
						ACSGetCEntity('acs_axii_sword_5').StopEffect('cutscene_blood_trail_02');
						ACSGetCEntity('acs_axii_sword_5').StopEffect('blood_trail_horseriding');
						ACSGetCEntity('acs_axii_sword_5').StopEffect('blood_trail_finisher');
						ACSGetCEntity('acs_axii_sword_5').StopEffect('fast_trail_blood_fx');

						/*
						ACSGetEquippedSword().StopEffect('default_blood_trail');
						ACSGetEquippedSword().StopEffect('cutscene_blood_trail');
						ACSGetEquippedSword().StopEffect('blood_trail_horseriding');
						ACSGetEquippedSword().StopEffect('blood_trail_finisher');
						ACSGetEquippedSword().StopEffect('fast_trail_blood_fx');
						ACSGetEquippedSword().StopEffect('weapon_blood');
						ACSGetEquippedSword().StopEffect('weapon_blood_stage1');
						ACSGetEquippedSword().StopEffect('weapon_blood_stage2');

						ACSGetEquippedSword().PlayEffectSingle(blood_fx[RandRange(blood_fx.Size())]);
						*/

						ACSGetCEntity('acs_axii_sword_1').PlayEffectSingle(blood_fx[RandRange(blood_fx.Size())]);
						//ACSGetCEntity('acs_axii_sword_2').PlayEffectSingle(blood_fx[RandRange(blood_fx.Size())]);
						//ACSGetCEntity('acs_axii_sword_3').PlayEffectSingle(blood_fx[RandRange(blood_fx.Size())]);
						//ACSGetCEntity('acs_axii_sword_4').PlayEffectSingle(blood_fx[RandRange(blood_fx.Size())]);
						//ACSGetCEntity('acs_axii_sword_5').PlayEffectSingle(blood_fx[RandRange(blood_fx.Size())]);
					}
					else if (ACS_GetWeaponMode() == 3)
					{
						ACSGetEquippedSword().StopEffect('cutscene_blood_trail');

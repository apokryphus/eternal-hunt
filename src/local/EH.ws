							{
								dest1 = GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetHeadingVector() * (2.5 * mult);
							}
							else
							{
								dest1 = GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetWorldUp() * 1;
							}
						}
						else if (theInput.IsActionPressed('DiveDown'))

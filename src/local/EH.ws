	private var sword_walk_index_1							: int;
	private var previous_sword_walk_index_1 				: int; 

	timer function SwordWalkSwitch( time : float , id : int )
	{
		var anim_names		: array< name >;

		if (thePlayer.IsAnyWeaponHeld()
		&& !thePlayer.IsWeaponHeld('fist')
		&& AnimProgressCheck()
		&& !thePlayer.HasTag('acs_aard_sword_equipped')
		//&& thePlayer.IsOnGround()
		&& !thePlayer.GetIsSprinting()
		&& !thePlayer.GetIsRunning()
		&& ACS_CombatToExplorationCheck()
		&& !thePlayer.IsPerformingFinisher()
		&& !thePlayer.IsSwimming()
		&& !thePlayer.IsDiving()
		//&& !thePlayer.IsInAir()
		&& !thePlayer.IsFalling()
		&& thePlayer.GetWeaponHolster().IsMeleeWeaponReady()
		&& !thePlayer.IsInCombat() 
		&& !thePlayer.IsInCombatState()
		&& !thePlayer.IsInCombatAction()
		&& !thePlayer.IsThreatened()
		&& FactsQuerySum("ACS_Player_Extended_Remains_Looting_Start") <= 0
		&& FactsQuerySum("ACS_Player_Remains_Looting_Start") <= 0
		)
		{
			swordWalkActive = true;

			if (idleAdditiveExtraActive)
			{
				thePlayer.RaiseEvent('ACS_IdleAdditiveReset');

				SetIdleAdditiveExtraStatus(false);
			}

			thePlayer.RaiseEvent('ACS_ForceHandClosedREnd');

			if ( FactsQuerySum("ACS_Slayer_Active") > 0 )
			{
				theSound.SoundEvent("doom_shotgun_load_acs");

				ShotgunPositioningSwitch('out_of_combat');

				thePlayer.RaiseEvent('ACS_SwordWalkAlt02Additive');
			}
			else
			{
				if (thePlayer.GetStat(BCS_Vitality) <= thePlayer.GetStatMax(BCS_Vitality) * 0.3)
				{
					thePlayer.RaiseEvent('ACS_SwordWalkAdditive');
				}
				else
				{

					if (thePlayer.HasTag('acs_axii_sword_equipped')
					|| thePlayer.HasTag('acs_axii_secondary_sword_equipped')
					|| thePlayer.HasTag('acs_quen_secondary_sword_equipped')
					|| thePlayer.HasTag('acs_aard_secondary_sword_equipped')
					|| ACS_Armor_Set_Check('acs_armor', false)
					|| ACS_Armor_Set_Check('wh_armor', false)
					|| ACS_Armor_Set_Check('eredin_armor', false)
					|| ACS_Armor_Set_Check('imlerith_armor', false)
					|| ACS_Armor_Set_Check('caranthir_armor', false)
					|| ACS_Armor_Set_Check('vgx_eredin_armor', false)
					|| ACS_Armor_Set_Check('volhikar', false)
					)
					{
						if (thePlayer.HasTag('ACS_Flammable_Oil_Enabled')
						|| thePlayer.GetBehaviorVariable('alternateWalk') != 0
						|| thePlayer.GetBehaviorVariable('proudWalk') != 0
						|| ACSGetCActor('ACS_Gravehag_Tongue_Weapon_R')
						|| ACS_GetItem_Sword_IsEquipped('knife_steel', 'steel')
						|| ACS_Vampire_Claws_Access()
						|| ACS_IS_SNEAKING
						|| thePlayer.HasTag('ACS_Is_Sneaking')
						)
						{
							anim_names.Clear();

							//anim_names.PushBack('ACS_SwordWalkAlt05Additive');
							anim_names.PushBack('ACS_SwordWalkAlt04Additive');
							anim_names.PushBack('ACS_SwordWalkAlt03Additive');
							anim_names.PushBack('ACS_SwordWalkAdditive');

							thePlayer.RaiseEvent(anim_names[RandRange(anim_names.Size())]);
						}
						else
						{
							thePlayer.RaiseEvent('ACS_SwordWalkAlt02Additive');
						}
					}
					else
					{
						switch (ACS_Settings_Main_Int('acs_taunt_settings','acs_sword_flair', 1)) 
						{	
							case 2:
							case 1:
							
							sword_walk_index_1 = RandDifferent(this.previous_sword_walk_index_1 , 4);

							switch (sword_walk_index_1) 
							{	
								//case 4:
								//thePlayer.RaiseEvent('ACS_SwordWalkAlt05Additive');
								//break;

								case 3:
								thePlayer.RaiseEvent('ACS_SwordWalkAlt04Additive');
								break;

								case 2:
								thePlayer.RaiseEvent('ACS_SwordWalkAlt03Additive');
								break;

								case 1:
								if (thePlayer.HasTag('ACS_Flammable_Oil_Enabled')
								|| thePlayer.HasTag('ACS_HasPerformedFinisher')
								|| thePlayer.GetBehaviorVariable('alternateWalk') != 0
								|| thePlayer.GetBehaviorVariable('proudWalk') != 0
								|| ACSGetCActor('ACS_Gravehag_Tongue_Weapon_R')
								|| ACS_GetItem_Sword_IsEquipped('knife_steel', 'steel')
								|| ACS_Vampire_Claws_Access()
								|| ACS_IS_SNEAKING
								|| thePlayer.HasTag('ACS_Is_Sneaking')
								)
								{
									anim_names.Clear();

									//anim_names.PushBack('ACS_SwordWalkAlt05Additive');
									anim_names.PushBack('ACS_SwordWalkAlt04Additive');
									anim_names.PushBack('ACS_SwordWalkAlt03Additive');
									anim_names.PushBack('ACS_SwordWalkAdditive');

									thePlayer.RaiseEvent(anim_names[RandRange(anim_names.Size())]);
								}
								else
								{
									thePlayer.RaiseEvent('ACS_SwordWalkAlt02Additive');
								}
								
								break;

								default:
								thePlayer.RaiseEvent('ACS_SwordWalkAdditive');
								break;
							}
						
							this.previous_sword_walk_index_1 = sword_walk_index_1;

							break;

							case 0:
							default:

							sword_walk_index_1 = RandDifferent(this.previous_sword_walk_index_1 , 3);

							switch (sword_walk_index_1) 
							{	
								//case 3:
								//thePlayer.RaiseEvent('ACS_SwordWalkAlt05Additive');
								//break;

								case 2:
								thePlayer.RaiseEvent('ACS_SwordWalkAlt04Additive');
								break;

								case 1:
								thePlayer.RaiseEvent('ACS_SwordWalkAlt03Additive');
								break;

								default:
								thePlayer.RaiseEvent('ACS_SwordWalkAdditive');
								break;
							}
						
							this.previous_sword_walk_index_1 = sword_walk_index_1;

							break;
						}
					}
				}
			}
		}
	}

	public var swordWalkActive 									: bool;

	public function setSwordwalkActive( b : bool)
	{
		swordWalkActive = b;
	}

	function SwordWalkControl()
	{
		var interactionTarget 									: CInteractionComponent;
		var steelid, silverid 									: SItemUniqueId;

		if (!thePlayer.IsAnyWeaponHeld()
		|| thePlayer.IsWeaponHeld('fist'))
		{
			if (swordWalkActive)
			{
				RemoveTimer('SwordWalkLongWeaponSwitch'); 

				RemoveTimer('SwordWalkSwitch'); 

				thePlayer.RaiseEvent('ACS_SwordWalkAdditiveEnd');

				swordWalkActive = false;
			}

			if (thePlayer.HasTag('ACS_IsSwordWalking'))
			{
				RemoveTimer('SwordTauntSwitch'); 

				RemoveTimer('SwordTauntRunningSwitch'); 

				thePlayer.RaiseEvent('ACS_SwordWalkAdditiveEnd');

				thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');

				RemoveTimer('CombatTauntDelay');

				thePlayer.RaiseEvent('ACS_SwordTauntEnd');

				thePlayer.RemoveTag('ACS_IsSwordWalking');
			}

			return;
		}
			
		if (
		thePlayer.IsActionAllowed(EIAB_Movement) 
		&& thePlayer.IsAnyWeaponHeld()
		&& !thePlayer.IsWeaponHeld('fist')
		&& thePlayer.GetWeaponHolster().IsMeleeWeaponReady()
		&& FactsQuerySum("ACS_Player_Extended_Remains_Looting_Start") <= 0
		&& FactsQuerySum("ACS_In_Meditation") <= 0
		&& FactsQuerySum("ACS_Player_Remains_Looting_Start") <= 0 
		&& AnimProgressCheck()
		&& ACS_CombatToExplorationCheck()
		&& !thePlayer.IsInCombat() 
		&& !thePlayer.IsInCombatState()
		&& !thePlayer.IsInCombatAction()
		&& !thePlayer.IsThreatened()
		&& !ACS_Cast_Sign_Process
		//&& !thePlayer.GetWeaponHolster().IsOnTheMiddleOfHolstering() 
		&& !thePlayer.IsUsingHorse()
		&& !thePlayer.IsUsingVehicle()
		&& !thePlayer.GetIsSprinting()
		&& !thePlayer.GetIsRunning()
		&& !thePlayer.IsPerformingFinisher()
		&& !thePlayer.IsSwimming()
		&& !thePlayer.IsDiving()
		&& !thePlayer.HasTag('ACS_IsPerformingFinisher')
		&& !thePlayer.HasTag('ACS_IsPerformingCombatDismember')
		&& thePlayer.GetPlayerAction() == PEA_None
		&& theGame.GetFocusModeController().CanUseFocusMode()
		&& thePlayer.GetWeaponHolster().IsMeleeWeaponReady()
		&& !theGame.IsDialogOrCutscenePlaying() 
		&& thePlayer.IsAlive()
		&& !thePlayer.IsInCutsceneIntro()
		&& !theGame.HasBlackscreenRequested()
		&& !theGame.IsCurrentlyPlayingNonGameplayScene()
		&& !GetWitcherPlayer().IsInNonGameplayCutscene() 
		&& !theGame.GetPhotomodeEnabled() 
		//&& thePlayer.GetWeaponHolster().TryToPrepareMeleeWeaponToAttack()
		//&& thePlayer.IsOnGround()
		//&& !thePlayer.IsInAir()
		&& !thePlayer.IsFalling()
		&& !thePlayer.HasTag('ACS_IsManagingSword')
		&& theInput.GetActionValue( 'Jump' ) <= 0
		)
		{
			if (!thePlayer.HasTag('ACS_IsSwordWalking'))
			{
				if ( FactsQuerySum("ACS_Azkar_Active") > 0
				|| thePlayer.HasTag('acs_aard_sword_equipped')
				)
				{
					RemoveTimer('SwordTauntSwitch'); 
					RemoveTimer('SwordTauntRunningSwitch'); 	
				}
				else
				{
					GetWitcherPlayer().GetItemEquippedOnSlot(EES_SilverSword, silverid);

					GetWitcherPlayer().GetItemEquippedOnSlot(EES_SteelSword, steelid);

					if ( 
					(thePlayer.GetInventory().IsItemHeld(steelid) && ACS_DoNotCreateMeshCheck('steel', steelid)) 
					|| (thePlayer.GetInventory().IsItemHeld(silverid) && ACS_DoNotCreateMeshCheck('silver', silverid)) 
					|| thePlayer.HasTag('acs_yrden_sword_equipped')
					|| thePlayer.HasTag('acs_yrden_secondary_sword_equipped')
					|| (thePlayer.HasTag('ACS_Spear_Transform_Active') && (thePlayer.GetInventory().IsItemHeld(steelid) || thePlayer.GetInventory().IsItemHeld(silverid)))
					)
					{
						RemoveTimer('SwordTauntSwitch'); 
						RemoveTimer('SwordTauntRunningSwitch'); 
							
							

						AddTimer('SwordTauntRunningSwitch', 0.01 , false);

						AddTimer('SwordWalkLongWeaponSwitch', 1.01  , false);
					}
					else
					{
						RemoveTimer('SwordTauntSwitch'); 
						RemoveTimer('SwordTauntRunningSwitch'); 

						AddTimer('SwordTauntRunningSwitch', 0.01 , false);

						AddTimer('SwordWalkSwitch', 1.01  , false);
					}
				}

				thePlayer.AddTag('ACS_IsSwordWalking');
			}

			return;
		}
		
		if (thePlayer.HasTag('ACS_IsSwordWalking'))
		{
			thePlayer.RaiseEvent('ACS_SwordWalkAdditiveEnd');thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');RemoveTimer('CombatTauntDelay');thePlayer.RaiseEvent('ACS_SwordTauntEnd');
			
			thePlayer.RemoveTag('ACS_IsSwordWalking');
		}

		if (swordWalkActive)
		{
			if ((thePlayer.GetIsSprinting()
			|| thePlayer.GetIsRunning())
			&& !thePlayer.HasTag('acs_aard_sword_equipped')
			&& FactsQuerySum("ACS_Azkar_Active") <= 0 
			&& FactsQuerySum("ACS_Slayer_Active") <= 0
			)
			{
				RemoveTimer('SwordTauntSwitch'); 
				RemoveTimer('SwordTauntRunningSwitch'); 
					
					
					
				AddTimer('SwordTauntRunningSwitch', 0.01 , false);
				//thePlayer.RaiseEvent('ACS_SwordWalkAlt02Additive');

				//thePlayer.RaiseEvent('ACS_ForceHandClosedRBackhand');
			}
			else
			{
				if (
				thePlayer.IsUsingHorse()
				|| thePlayer.IsUsingVehicle()
				|| thePlayer.GetPlayerAction() != PEA_None
				|| thePlayer.IsPerformingFinisher()
				|| thePlayer.IsInCombatAction()
				//|| thePlayer.GetIsSprinting()
				//|| thePlayer.GetIsRunning()
				)
				{
					RemoveTimer('SwordTauntSwitch'); 
					RemoveTimer('SwordTauntRunningSwitch'); 
						
						

					thePlayer.RaiseEvent('ACS_SwordWalkAdditiveEnd');thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');RemoveTimer('CombatTauntDelay');thePlayer.RaiseEvent('ACS_SwordTauntEnd');
				}
			}
			
			
			swordWalkActive = false;
		}
	}

	var sneaking_dodge_anim_cancel : bool;

	var sneaking_dagger_enabled : bool;

	function SneakControl()
	{
		if (thePlayer.HasTag('ACS_Is_Sneaking'))
		{
			if ( FactsQuerySum("ACS_BadassWalk") > 0 )
			{
				ResetFastWalk();

				FactsRemove("ACS_BadassWalk");
			}

			if ( FactsQuerySum("ACS_DrunkWalk") > 0 )
			{
				ResetFastWalk();

				FactsRemove("ACS_DrunkWalk");
			}

			if ( FactsQuerySum("ACS_ZombieWalk") > 0 )
			{
				ResetFastWalk();

				FactsRemove("ACS_ZombieWalk");
			}

			if ( FactsQuerySum("ACS_BigHeavyWalk") > 0 )
			{
				ResetFastWalk();

				FactsRemove("ACS_BigHeavyWalk");
			}

			if ( FactsQuerySum("ACS_OlgierdWalk") > 0 )
			{
				ResetFastWalk();

				FactsRemove("ACS_OlgierdWalk");
			}

			if ( FactsQuerySum("ACS_RichWalk") > 0 )
			{
				ResetFastWalk();

				FactsRemove("ACS_RichWalk");
			}

			if ( FactsQuerySum("ACS_TimidWalk") > 0 )
			{
				ResetFastWalk();

				FactsRemove("ACS_TimidWalk");
			}
		}

		if (
		thePlayer.IsActionAllowed(EIAB_Movement) 
		//&& thePlayer.IsAnyWeaponHeld()
		//&& !thePlayer.IsWeaponHeld('fist')
		//&& thePlayer.GetWeaponHolster().IsMeleeWeaponReady()
		&& FactsQuerySum("ACS_Player_Extended_Remains_Looting_Start") <= 0
		&& FactsQuerySum("ACS_In_Meditation") <= 0
		&& FactsQuerySum("ACS_Player_Remains_Looting_Start") <= 0 
		//&& AnimProgressCheck()
		&& !ACS_Cast_Sign_Process
		//&& !thePlayer.GetWeaponHolster().IsOnTheMiddleOfHolstering() 
		&& !thePlayer.IsUsingHorse()
		&& !thePlayer.IsUsingVehicle()
		&& !thePlayer.GetIsSprinting()
		&& !thePlayer.GetIsRunning()
		&& !thePlayer.IsPerformingFinisher()
		&& !thePlayer.IsSwimming()
		&& !thePlayer.IsDiving()
		//&& !thePlayer.HasTag('ACS_IsPerformingFinisher')
		//&& !thePlayer.HasTag('ACS_IsPerformingCombatDismember')
		//&& thePlayer.GetPlayerAction() == PEA_None
		&& !theGame.IsDialogOrCutscenePlaying() 
		&& thePlayer.IsAlive()
		&& !thePlayer.IsInCutsceneIntro()
		&& !theGame.HasBlackscreenRequested()
		&& !theGame.IsCurrentlyPlayingNonGameplayScene()
		&& !GetWitcherPlayer().IsInNonGameplayCutscene() 
		//&& !thePlayer.HasTag('ACS_IsManagingSword')
		&& ACS_Settings_Main_Bool('acs_combat_main_settings','acs_sneaking', true)
		&& ACS_IS_SNEAKING
		&& !thePlayer.IsHoldingItemInLHand()
		)
		{
			if (
			thePlayer.IsCurrentlyDodging()
			//|| 
			//thePlayer.HasTag('ACS_Is_Currently_Dodging')
			|| thePlayer.HasTag('ACS_IsPerformingFinisher')
			|| thePlayer.HasTag('ACS_IsPerformingCounterWound')
			|| thePlayer.rangedWeapon.GetCurrentStateName() == 'State_WeaponAim' 
			|| thePlayer.rangedWeapon.GetCurrentStateName() == 'State_WeaponShoot'
			|| thePlayer.rangedWeapon.GetCurrentStateName() == 'State_WeaponReload'
			|| thePlayer.substateManager.GetStateCur() == 'Jump'
			|| thePlayer.substateManager.GetStateCur() == 'Interaction'
			|| thePlayer.substateManager.GetStateCur() == 'Climb'
			|| thePlayer.IsThrowHold() 
			|| thePlayer.GetIsAimingCrossbow()
			|| !AnimProgressCheck()
			|| thePlayer.GetPlayerAction() != PEA_None
			//|| ACSGetCEntity('ACS_Loot_Prop')
			|| thePlayer.HasTag('ACS_IsManagingSword')
			|| thePlayer.GetWeaponHolster().IsOnTheMiddleOfHolstering() 
			|| !thePlayer.GetWeaponHolster().IsMeleeWeaponReady()
			|| theInput.GetActionValue('AttackHeavy') > 0.1
			|| theInput.GetActionValue('AttackLight') > 0.1
			|| theInput.GetActionValue('AttackWithAlternateLight') > 0.1
			|| theInput.GetActionValue('AttackWithAlternateHeavy') > 0.1
			|| theInput.GetActionValue('SpecialAttackLight') > 0.1
			|| theInput.GetActionValue('SpecialAttackWithAlternateLight') > 0.1
			|| theInput.GetActionValue('SpecialAttackWithAlternateHeavy') > 0.1
			|| theInput.GetActionValue('SpawnHorse') > 0.1
			|| ACS_Vampire_Claws_Access()
			)
			{
				if (!sneaking_dodge_anim_cancel)
				{
					thePlayer.ACS_SetAnimationSpeedMultiplier(1);

					thePlayer.ACS_ClearAnimationSpeedMultipliers();

					thePlayer.RaiseEvent('ACS_SneakAnimEnd');

					thePlayer.RaiseEvent('ACS_IdleAdditiveReset');

					sneaking_dodge_anim_cancel = true;
				}
			}
			else
			{
				thePlayer.ACS_SetAnimationSpeedMultiplier(0.625);

				if (sneaking_dodge_anim_cancel)
				{
					if(RandF() < 0.5)
					{
						thePlayer.RaiseEvent('ACS_SwordTaunt11');
					}
					else
					{
						thePlayer.RaiseEvent('ACS_SwordTaunt10');
					}
					
					if (silver_group_stance
					|| silver_strong_stance
					|| silver_fast_stance
					|| steel_group_stance
					|| steel_strong_stance
					|| steel_fast_stance
					|| ACS_Vampire_Claws_Access()
					)
					{

					}
					else
					{
						if (RandF() < 0.5)
						{
							thePlayer.RaiseEvent('ACS_SneakAnim');
						}
						else
						{
							thePlayer.RaiseEvent('ACS_SneakAnimAlt');
						}
					}

					sneaking_dodge_anim_cancel = false;
				}
			}

			if ((!thePlayer.IsAnyWeaponHeld()
			|| thePlayer.IsWeaponHeld('fist'))
			&& !thePlayer.GetWeaponHolster().IsOnTheMiddleOfHolstering() 
			&& !thePlayer.HasTag('ACS_IsManagingSword')
			)
			{
				if (!sneaking_dagger_enabled
				)
				{
					if (ACS_Vampire_Claws_Access())
					{

					}
					else
					{
						//thePlayer.RaiseEvent('ACS_IdleAdditiveHeavyMeleeCheck');

						thePlayer.RaiseEvent('ACS_SwordTaunt10');

						ACSGetCEntityDestroyAll('acs_finisher_dagger');

						vACS_Dagger_Summon = new cACS_Dagger_Summon in this;
							
						vACS_Dagger_Summon.ACS_Finisher_Dagger_Summon_Engage();

						RemoveTimer('ForceControlModuleHudUpdate');
						AddTimer('ForceControlModuleHudUpdate', 0.25f , false);
					}

					sneaking_dagger_enabled = true;
				}
			}
			else
			{
				if (sneaking_dagger_enabled)
				{
					if ( !theSound.SoundIsBankLoaded("qu_nml_105.bnk") )
					{
						theSound.SoundLoadBank( "qu_nml_105.bnk", false );
					}

					GetWitcherPlayer().SoundEvent("qu_nml_105_geralt_sheats_dagger");

					ACSGetCEntityDestroyAll('acs_finisher_dagger');

					RemoveTimer('ForceControlModuleHudUpdate');
					AddTimer('ForceControlModuleHudUpdate', 0.25f , false);

					sneaking_dagger_enabled = false;
				}
			}
			
			if ( FactsQuerySum("ACS_BadassWalk") > 0 )
			{
				ResetFastWalk();

				FactsRemove("ACS_BadassWalk");
			}

			if ( FactsQuerySum("ACS_DrunkWalk") > 0 )
			{
				ResetFastWalk();

				FactsRemove("ACS_DrunkWalk");
			}

			if ( FactsQuerySum("ACS_ZombieWalk") > 0 )
			{
				ResetFastWalk();

				FactsRemove("ACS_ZombieWalk");
			}

			if ( FactsQuerySum("ACS_BigHeavyWalk") > 0 )
			{
				ResetFastWalk();

				FactsRemove("ACS_BigHeavyWalk");
			}

			if ( FactsQuerySum("ACS_OlgierdWalk") > 0 )
			{
				ResetFastWalk();

				FactsRemove("ACS_OlgierdWalk");
			}

			if ( FactsQuerySum("ACS_RichWalk") > 0 )
			{
				ResetFastWalk();

				FactsRemove("ACS_RichWalk");
			}

			if ( FactsQuerySum("ACS_TimidWalk") > 0 )
			{
				ResetFastWalk();

				FactsRemove("ACS_TimidWalk");
			}

			return;
		}

		RemoveSneaking(true);
	}

	var vACS_Destroy_Custom_Monsters : cACS_Destroy_Custom_Monsters;

	function DestroyCustomMonsters()
	{
		var actors 											: array<CActor>;

		actors.Clear();

		theGame.GetActorsByTag( 'ACS_Custom_Monster', actors );	

		if (actors.Size() <= 0)
		{
			return;
		}

		vACS_Destroy_Custom_Monsters = new cACS_Destroy_Custom_Monsters in this;

		vACS_Destroy_Custom_Monsters.Destroy_Custom_Monsters_Engage();
	}

	var last_horse_kick_time : float;

	var horse_kick_alternate : bool;

	function HorseKickRunning()
	{
		var heading : float;
		var riderPos, targetPos : Vector;
		var target : CActor;
		var targetDistance 	: Float;
		var horizontalVal : float;
		var cooldown, dist		: float;

		if ( FactsQuerySum("ACS_Mounted_Attack_Attachment_Active") > 0 )
		{
			return;
		}

		if(!thePlayer.IsUsingHorse())
		{
			return;
		}

		if (theInput.IsActionPressed('WalkToggle')
		//|| theInput.IsActionPressed('VehicleAttack')
		|| (thePlayer.GetHorseCurrentlyMounted().GetHorseComponent()).inCanter
		)
		{
			if ((thePlayer.GetHorseCurrentlyMounted().GetHorseComponent()).inCanter
			&& theInput.GetActionValue('WalkToggle') == 0
			&& theInput.GetActionValue('VehicleAttack') == 0
			)
			{
				cooldown = 0.5;

				dist = 4;
			}
			else
			{
				cooldown = 1;

				dist = 3.5;
			}

			if (theGame.GetEngineTimeAsSeconds() - last_horse_kick_time > cooldown)
			{
				last_horse_kick_time = theGame.GetEngineTimeAsSeconds();

				riderPos = thePlayer.GetWorldPosition();
				
				target = (CActor)thePlayer.GetTarget();

				targetDistance = VecDistanceSquared2D( thePlayer.GetWorldPosition(), target.GetWorldPosition() );

				if (targetDistance <= dist * dist
				&& !target.HasBuff(EET_Knockdown)
				&& !target.HasBuff(EET_HeavyKnockdown)
				)
				{
					targetPos = target.GetWorldPosition();
					heading = VecHeading( targetPos - riderPos );
					horizontalVal = AngleDistance( thePlayer.GetHeading(), heading ) / 180.f;

					if (horizontalVal > 0)
					{
						thePlayer.RaiseEvent('ACS_HorseKickRight');

						ACS_HorseKickDamage('right');
					}
					else if (horizontalVal < 0)
					{
						thePlayer.RaiseEvent('ACS_HorseKickLeft');

						ACS_HorseKickDamage('left');
					}
				}
			}
		}
	}

	function Remove3DHUDMarkers()
	{
		ACSTrackedQuestsEntsDestroy();

		if(ACSGetCEntity('ACS_Compass_Bar_Cardinal_North_Entity')
		)
		{

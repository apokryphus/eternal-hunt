				boatHealthModule = (CR4HudModuleBoatHealth)hud.GetHudModule("BoatHealthModule");

				l_flashModule = boatHealthModule.GetModuleFlash();

				if (ACS_Settings_Main_Bool('acs_hud_settings_positioning_all','acs_hud_positioning_enabled', false))
				{

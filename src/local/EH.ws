	timer function GetACSGuidingLightQuestMarker_EffectStopDelay( time : float , id : int )
	{
		RemoveTimer('GetACSGuidingLightQuestMarker_EffectStoppingDelay');

		ACSGetCEntity('ACS_Guiding_Light_Marker').StopEffect('quest_marker_smaller');
		ACSGetCEntity('ACS_Guiding_Light_Marker').StopEffect('quest_marker_small');
		ACSGetCEntity('ACS_Guiding_Light_Marker').StopEffect('quest_marker');
		ACSGetCEntity('ACS_Guiding_Light_Marker').StopEffect('quest_marker_bigger');
		ACSGetCEntity('ACS_Guiding_Light_Marker').StopEffect('quest_marker_biggest');
		ACSGetCEntity('ACS_Guiding_Light_Marker').StopEffect('quest_marker_biggest_x2');
		ACSGetCEntity('ACS_Guiding_Light_Marker').StopEffect('quest_marker_biggest_x4');

		trackedQuestMarkerFadeOut = 100;
		RemoveTimer('trackedQuestMarkerFadeOut');
		AddTimer('trackedQuestMarkerFadeOut', 0.01 , true);

		GetACSStorage().acs_deleteOnelinerByTag("ACS_Quest_Distance_GUI_Marker");

		if (ACS_Guiding_Light_Quest_Marker_Distance_Available)
		{
			ACS_Guiding_Light_Quest_Marker_Distance_Available = false;
		}

		if (ACS_Guiding_Light_Quest_Marker_Stopping )
		{
			ACS_Guiding_Light_Quest_Marker_Stopping = false;
		}
	}

	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	function ACS_Guiding_Light_Horse_Marker_Distance_Actual()
	{
		var iconPath, zPositioning				: string;
		var playerPosition, markerPosition 		: Vector;
		var distance 							: float;

		GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Horse_Distance_GUI_Marker", 100);

		GetACSStorage().acs_deleteOnelinerByTag("ACS_Horse_Distance_GUI_Marker");

		if (!ACSGetCEntity('ACS_Guiding_Light_Horse_Marker'))
		{
			return;
		}

		playerPosition = thePlayer.GetWorldPosition();

		markerPosition = ACSGetCEntity('ACS_Guiding_Light_Horse_Marker').GetWorldPosition();

		distance = VecDistance(playerPosition, markerPosition);

		if ((AbsF(playerPosition.Z - markerPosition.Z) <= 4)
		|| distance >= 50
		)
		{
			zPositioning = "";
		}
		else
		{
			if (playerPosition.Z > markerPosition.Z)
			{
				zPositioning = " - " + "[" + GetLocStringByKeyExt("fake_key_z98k3yl8") + "]";
			}
			else if (playerPosition.Z < markerPosition.Z)
			{
				zPositioning = " - " + "[" + GetLocStringByKeyExt("fake_key_dk0zqae") + "]";
			}
			else
			{
				zPositioning = "";
			}
		}

		if(RadialMenuCheck()
		|| HudExceptionCheck() 
		|| ACS_GetNearbyEnemyLocation() != Vector(0,0,-200)
		|| ACS_MapPinsCheck()
		|| thePlayer.IsAnyWeaponHeld()
		)
		{
			if (distance <= 4.5 )
			{
				iconPath = "<font size = '16' color = '#b9b9b9'>" + "[" + GetLocStringByKeyExt("map_location_horse") + "]" + "<br/><br/><br/><br/>" + "[" + GetLocStringByKeyExt("fake_key_1h78y_j") + "]" + zPositioning + "</font>";
			}
			else
			{
				iconPath = "<font size = '16' color = '#b9b9b9'>" + "[" + GetLocStringByKeyExt("map_location_horse") + "]" + "<br/><br/><br/><br/>" + "[" + FloatToStringPrec(distance, 0) + "m" + "]" + zPositioning + "</font>";
			}
		}
		else
		{
			if (distance <= 4.5 )
			{
				iconPath = "<br/><br/>" + "<font size = '16' color = '#b9b9b9'>" + "[" + GetLocStringByKeyExt("fake_key_1h78y_j") + "]" + zPositioning + "</font>";
			}
			else
			{
				iconPath = "<br/><br/>" + "<font size = '16' color = '#b9b9b9'>" + "[" + FloatToStringPrec(distance, 0) + "m" + "]" + zPositioning + "</font>";
			}
		}

		ACS_Oneliner(iconPath, ACSGetCEntity('ACS_Guiding_Light_Horse_Marker'), "ACS_Horse_Distance_GUI_Marker");

		GetACSStorage().acs_setScaleForOnelinerByTag("ACS_Horse_Distance_GUI_Marker", 100, 100, 100);

		GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Horse_Distance_GUI_Marker", 100);
	}

	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	private var horseMarkerFadeOut : float;
	default horseMarkerFadeOut = 100;

	timer function horseMarkerFadeOut(dt : float , id : int)
	{	
		GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Horse_GUI_Marker", horseMarkerFadeOut);

		if (horseMarkerFadeOut <= 0)
		{
			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Horse_GUI_Marker", 100);

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Horse_GUI_Marker");
			
			ACSGetCEntity('ACS_Guiding_Light_Horse_Marker').Destroy();

			horseMarkerFadeOut = 100;

			RemoveTimer('horseMarkerFadeOut');
		}
		else
		{
			horseMarkerFadeOut -= 1;
		}
	}

	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	
	var ACS_Guiding_Light_Horse_Marker_Stopped : bool;

	function Guiding_Light_Horse_Marker()
	{
		var position																			: Vector;
		var rot, newRot          																: EulerAngles;
		var ent, entNavigationGuide, entNavigationGuideMarker									: CEntity;
		var temp, tempNavigationGuide, tempNavigationGuideMarker								: CEntityTemplate;
		var targetDistance																		: float;
		var horsePos 																			: Vector;
		var horse 																				: CNewNPC;
		var compass_check 																		: bool;

		horse = thePlayer.GetHorseWithInventory();
	
		if ( !horse
		|| thePlayer.IsUsingHorse()
		|| theGame.IsDialogOrCutscenePlaying() 
		|| theGame.IsFading()
		|| theGame.IsBlackscreen()
		|| theGame.IsPaused()
		|| theGame.GetPhotomodeEnabled() 
		|| thePlayer.IsInCutsceneIntro() 
		|| ACS_Settings_Main_Float('acs_hud_settings_markers','acs_horse_marker_despawn_delay', 7) == 0
		)
		{
			if(ACSGetCEntity('ACS_Guiding_Light_Horse_Marker'))
			{
				horseMarkerFadeOut = 100;
				RemoveTimer('horseMarkerFadeOut');

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Horse_GUI_Marker");
				GetACSStorage().acs_deleteOnelinerByTag("ACS_Horse_Distance_GUI_Marker");

				if (ACS_Guiding_Light_Horse_Marker_Stopped)
				{
					ACS_Guiding_Light_Horse_Marker_Stopped = false;
				}

				if (ACS_Guiding_Light_Horse_Marker_Distance_Available)
				{
					ACS_Guiding_Light_Horse_Marker_Distance_Available = false;
				}

				ACSGetCEntity('ACS_Guiding_Light_Horse_Marker').Destroy();
			}

			return;
		}

		targetDistance = VecDistanceSquared2D( GetWitcherPlayer().GetWorldPosition(), ACSGetCEntity('ACS_Guiding_Light_Horse_Marker').GetWorldPosition() ) ;

		position = horse.GetWorldPosition();	

		rot = thePlayer.GetWorldRotation();

		rot.Pitch += 180;

		rot.Yaw += 180;

		if(!ACSGetCEntity('ACS_Guiding_Light_Horse_Marker'))
		{
			temp = (CEntityTemplate)LoadResource( 
				
			"dlc\dlc_acs\data\fx\guiding_light_marker_old.w2ent"
			
			, true );

			ent = (CEntity)theGame.CreateEntity( temp, position, rot );

			ent.AddTag('ACS_Guiding_Light_Horse_Marker');

			ent.AddTag('ACS_HUD_Marker_Entity');
		}
		else
		{
			if(RadialMenuCheck()
			|| HudExceptionCheck() 
			|| ACS_GetNearbyEnemyLocation() != Vector(0,0,-200)
			|| ACS_MapPinsCheck()
			|| thePlayer.IsAnyWeaponHeld()
			)
			{
				
					if (ACS_Guiding_Light_Horse_Marker_Stopped)
					{
						ACS_Guiding_Light_Horse_Marker_Stopped = false;
					}

					ACS_Guiding_Light_Horse_Marker_Distance_Available = true;

					RemoveTimer('GetACSGuidingLightHorseMarker_EffectStopDelay');

					GetACSStorage().acs_deleteOnelinerByTag("ACS_Horse_GUI_Marker");

					ACS_Oneliner(FormatIconPath("icons/inventory/acs_marker_horse.xbm"), ACSGetCEntity('ACS_Guiding_Light_Horse_Marker'), "ACS_Horse_GUI_Marker");

					GetACSStorage().acs_setScaleForOnelinerByTag("ACS_Horse_GUI_Marker", 100, 100, 100);

					GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Horse_GUI_Marker", 100);
				
			}
			else
			{
				if ( !ACS_Guiding_Light_Horse_Marker_Stopped )
				{
					AddTimer('GetACSGuidingLightHorseMarker_EffectStopDelay', ACS_Settings_Main_Float('acs_hud_settings_markers','acs_horse_marker_despawn_delay', 7) , false);

					ACS_Guiding_Light_Horse_Marker_Stopped = true;
				}
			}
		}
	}

	timer function GetACSGuidingLightHorseMarker_EffectStopDelay( time : float , id : int )
	{
		horseMarkerFadeOut = 100;
		RemoveTimer('horseMarkerFadeOut');
		AddTimer('horseMarkerFadeOut', 0.01 , true);

		GetACSStorage().acs_deleteOnelinerByTag("ACS_Horse_Distance_GUI_Marker");

		if (ACS_Guiding_Light_Horse_Marker_Distance_Available)
		{
			ACS_Guiding_Light_Horse_Marker_Distance_Available = false;
		}

		if (ACS_Guiding_Light_Horse_Marker_Stopped)
		{
			ACS_Guiding_Light_Horse_Marker_Stopped = false;
		}
	}


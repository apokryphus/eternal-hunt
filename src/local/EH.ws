			Attack_Setup_06('GeraltForgottenWolfLightAttack');
		}
		else if (ACS_Armor_Set_Check('viper', true))
		{
			Attack_Setup_06('GeraltViperLightAttack');
		}
		else if (ACS_Armor_Set_Check('acs_armor_alpha', false))
		{
			Attack_Setup_07('GeraltACSArmorAlphaLightAttack');
		}
		else if (ACS_Armor_Set_Check('acs_armor_omega', false))
		{
			Attack_Setup_07('GeraltACSArmorOmegaLightAttack');
		}
		else

	timer function DisableMusic( time : float , id : int )
	{
		theSound.SoundEvent("music_clair_obscur_e33_stop_acs");

		theSound.SoundEvent("music_metal_mix_stop_acs_01");

		theSound.SoundEvent("music_witcher_1_stop_acs_01");

		theSound.SoundEvent("music_witcher_2_stop_acs_01");

		theSound.SoundEvent("music_witcher_3_stop_acs_01");

		theSound.SoundEvent("music_gwent_stop_acs");

		currently_playing_music = "";

		RemoveTimer('EnableExplorationMusic');
		AddTimer('EnableExplorationMusic', 6   , false);

		acs_combat_music_is_currently_playing = false;
	}

	timer function EnableExplorationMusic( time : float , id : int )
	{
		if (thePlayer.IsAlive())
		{
			theSound.InitializeAreaMusic( theGame.GetCommonMapManager().GetCurrentArea() );
		}
	}

	var stab_hostage_enabled : bool;

	function StabHostageCheck() : bool
	{
		var victims							: array<CActor>;
		var i 								: int;
		var actor							: CNewNPC; 
		var movementAdjustor				: CMovementAdjustor;
		var ticket 							: SMovementAdjustmentRequestTicket;

		victims.Clear();

		victims = thePlayer.GetNPCsAndPlayersInCone(4, VecHeading(thePlayer.GetHeadingVector()), 60, 20, , FLAG_OnlyAliveActors + FLAG_Attitude_Hostile + FLAG_ExcludePlayer );

		if( victims.Size() > 0)
		{
			for( i = 0; i < victims.Size(); i += 1 )
			{
				actor = (CNewNPC)victims[i];

				if (
				actor.HasTag('ACS_Big_Boi')
				|| actor.HasAbility('mon_toad_base')
				|| actor.HasAbility('mon_type_huge')
				|| ((CMovingPhysicalAgentComponent)(actor.GetMovingAgentComponent())).GetCapsuleHeight() >= 2
				|| actor.GetRadius() >= 0.7
				|| actor.IsFlying()
				|| thePlayer.IsInAir()
				|| !thePlayer.WasVisibleInScaledFrame( actor, 0.9f, 0.9f )
				)
				{
					continue;
				}

				if (actor 
				&& actor.HasTag('ACS_Counter_Wound_Ready')
				&& !stab_hostage_enabled
				&& !ACSGetCActor('ACS_Stab_Hostage')
				&& actor.IsAlive()
				&& (theInput.GetActionValue('LockAndGuard') > 0.1f 
				|| theInput.GetActionValue('Guard') > 0.1f)
				)
				{
					ACS_Tutorial_Display_Check('ACS_Somne_Tutorial_Shown');

					thePlayer.ACS_ClearAnimationSpeedMultipliers();

					movementAdjustor = thePlayer.GetMovingAgentComponent().GetMovementAdjustor();

					ticket = movementAdjustor.GetRequest( 'ACS_Stab_Hostage_Rotate');
					movementAdjustor.CancelByName( 'ACS_Stab_Hostage_Rotate' );

					ticket = movementAdjustor.CreateNewRequest( 'ACS_Stab_Hostage_Rotate' );
					movementAdjustor.AdjustmentDuration( ticket, 0.25 );
					movementAdjustor.MaxRotationAdjustmentSpeed( ticket, 50000 );
					movementAdjustor.RotateTowards( ticket, actor );

					return true;
				}

			}
		}

		return false;
	}

	var somne_ent_anchor, somne_ent : CEntity;

	function StabHostageInit()
	{
		var victims							: array<CActor>;
		var i 								: int;
		var targetDistance					: float;
		var actor							: CNewNPC; 
		var attach_vec						: Vector;
		var bone_vec						: Vector;
		var bone_rot, attach_rot			: EulerAngles;
		var movementAdjustor				: CMovementAdjustor;
		var ticket 							: SMovementAdjustmentRequestTicket;

		victims.Clear();

		victims = thePlayer.GetNPCsAndPlayersInCone(4, VecHeading(thePlayer.GetHeadingVector()), 60, 20, , FLAG_OnlyAliveActors + FLAG_Attitude_Hostile + FLAG_ExcludePlayer );

		if( victims.Size() > 0)
		{
			for( i = 0; i < victims.Size(); i += 1 )
			{
				actor = (CNewNPC)victims[i];

				if (
				actor.HasTag('ACS_Big_Boi')
				|| actor.HasAbility('mon_toad_base')
				|| actor.HasAbility('mon_type_huge')
				|| ((CMovingPhysicalAgentComponent)(actor.GetMovingAgentComponent())).GetCapsuleHeight() >= 2
				|| actor.GetRadius() >= 0.7
				|| actor.IsFlying()
				|| thePlayer.IsInAir()
				|| !thePlayer.WasVisibleInScaledFrame( actor, 0.9f, 0.9f )
				)
				{
					continue;
				}

				if (actor 
				&& !stab_hostage_enabled
				&& !ACSGetCActor('ACS_Stab_Hostage')
				&& actor.IsAlive()
				&& actor.HasTag('ACS_Counter_Wound_Ready')
				)
				{
					thePlayer.ACS_ClearAnimationSpeedMultipliers();

					movementAdjustor = thePlayer.GetMovingAgentComponent().GetMovementAdjustor();

					ticket = movementAdjustor.GetRequest( 'ACS_Stab_Hostage_Rotate');
					movementAdjustor.CancelByName( 'ACS_Stab_Hostage_Rotate' );

					ticket = movementAdjustor.CreateNewRequest( 'ACS_Stab_Hostage_Rotate' );
					movementAdjustor.AdjustmentDuration( ticket, 0.25 );
					movementAdjustor.MaxRotationAdjustmentSpeed( ticket, 50000 );
					movementAdjustor.RotateTowards( ticket, actor );

					thePlayer.SoundEvent("sign_axii_pre_start");
					thePlayer.SoundEvent("sign_axii_ready");

					thePlayer.SoundEvent("sign_axii_base_loop");
					thePlayer.SoundEvent("sign_axii_target_confusion_loop");
					thePlayer.SoundEvent("sign_axii_target_guard_loop");
					thePlayer.SoundEvent("sign_axii_target_tag_loop");

					thePlayer.RaiseEvent('ACS_StabHostageHold03');

					ACSGetCEntity('ACS_Quen_Bubble').Destroy();

					ACSGetCEntity('ACS_Quen_Fx').Destroy();

					ACSGetCEntity('ACS_Sign_Icon').Destroy();

					ACSGetCEntity('ACS_Sign_Icon_Anchor').Destroy();

					somne_ent_anchor = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
					"dlc\dlc_acs\data\fx\sign_icons.w2ent"
					, true ), GetWitcherPlayer().GetWorldPosition(), GetWitcherPlayer().GetWorldRotation() );

					somne_ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
					"dlc\dlc_acs\data\fx\sign_icons.w2ent"
					, true ), GetWitcherPlayer().GetWorldPosition(), GetWitcherPlayer().GetWorldRotation() );

					GetWitcherPlayer().GetBoneWorldPositionAndRotationByIndex( GetWitcherPlayer().GetBoneIndex( 'l_handRoll' ), bone_vec, bone_rot );

					attach_rot.Roll = 0;
					attach_rot.Pitch = 0;
					attach_rot.Yaw = 0;
					attach_vec.X = 0.4;
					attach_vec.Y = 0.15;
					attach_vec.Z = 0;

					somne_ent_anchor.CreateAttachmentAtBoneWS( GetWitcherPlayer(), 'l_handRoll', bone_vec, bone_rot );

					somne_ent.CreateAttachment( somne_ent_anchor, , attach_vec, attach_rot );

					somne_ent.PlayEffectSingle('somne_icon');

					thePlayer.BlockAction( EIAB_Crossbow, 			'acs_stab_hostage');
					thePlayer.BlockAction( EIAB_CallHorse,			'acs_stab_hostage');
					thePlayer.BlockAction( EIAB_Signs, 				'acs_stab_hostage');
					thePlayer.BlockAction( EIAB_DrawWeapon, 			'acs_stab_hostage');
					thePlayer.BlockAction( EIAB_FastTravel, 			'acs_stab_hostage');
					//thePlayer.BlockAction( EIAB_Fists, 				'acs_stab_hostage');
					thePlayer.BlockAction( EIAB_InteractionAction, 	'acs_stab_hostage');
					thePlayer.BlockAction( EIAB_UsableItem,			'acs_stab_hostage');
					thePlayer.BlockAction( EIAB_ThrowBomb,			'acs_stab_hostage');
					//thePlayer.BlockAction( EIAB_SwordAttack,			'acs_stab_hostage');
					//thePlayer.BlockAction( EIAB_LightAttacks,			'acs_stab_hostage');
					//thePlayer.BlockAction( EIAB_HeavyAttacks,			'acs_stab_hostage');
					thePlayer.BlockAction( EIAB_SpecialAttackLight,	'acs_stab_hostage');
					thePlayer.BlockAction( EIAB_SpecialAttackHeavy,	'acs_stab_hostage');
					thePlayer.BlockAction( EIAB_Dodge,				'acs_stab_hostage');
					thePlayer.BlockAction( EIAB_Roll,					'acs_stab_hostage');
					thePlayer.BlockAction( EIAB_Parry,				'acs_stab_hostage');
					thePlayer.BlockAction( EIAB_MeditationWaiting,	'acs_stab_hostage');
					thePlayer.BlockAction( EIAB_OpenMeditation,		'acs_stab_hostage');
					thePlayer.BlockAction( EIAB_RadialMenu,			'acs_stab_hostage');
					thePlayer.BlockAction( EIAB_Interactions, 		'acs_stab_hostage');
					thePlayer.BlockAction( EIAB_Jump, 				'acs_stab_hostage');
					thePlayer.BlockAction( EIAB_QuickSlots, 			'acs_stab_hostage');
					thePlayer.BlockAction( EIAB_OpenFastMenu, 		'acs_stab_hostage');
					thePlayer.BlockAction( EIAB_OpenInventory,		'acs_stab_hostage');
					thePlayer.BlockAction( EIAB_OpenPreparation, 		'acs_stab_hostage');
					thePlayer.BlockAction( EIAB_OpenMap, 				'acs_stab_hostage');
					thePlayer.BlockAction( EIAB_OpenCharacterPanel, 	'acs_stab_hostage');
					thePlayer.BlockAction( EIAB_OpenJournal, 			'acs_stab_hostage');
					thePlayer.BlockAction( EIAB_OpenAlchemy, 			'acs_stab_hostage');
					thePlayer.BlockAction( EIAB_OpenGlossary,			'acs_stab_hostage');

					actor.EnableCharacterCollisions(false);
					actor.EnableCollisions(false);

					RemoveTimer('ACS_Stab_Hostage_Process');
					AddTimer('ACS_Stab_Hostage_Process', 0.0001 , true);

					actor.AddTag('ACS_Stab_Hostage');

					stab_hostage_enabled = true;
				
				}
			}
		}
	}

	function ReleaseStabHostage()
	{
		var proj	 					: ACSPlayerNPCLauncherProjectile;
		var initpos, targetPosition		: Vector;
		var victim						: CActor;
		var action						: W3DamageAction;


		if (stab_hostage_enabled
		)
		{
			somne_ent_anchor.Destroy();

			somne_ent.Destroy();

			thePlayer.SoundEvent("sign_axii_release");

			thePlayer.SoundEvent("sign_axii_base_loop_end");
			thePlayer.SoundEvent("sign_axii_target_confusion_loop_end");
			thePlayer.SoundEvent("sign_axii_target_guard_loop_end");
			thePlayer.SoundEvent("sign_axii_target_tag_loop_end");

			thePlayer.UnblockAction( EIAB_Crossbow, 			'acs_stab_hostage');
			thePlayer.UnblockAction( EIAB_CallHorse,			'acs_stab_hostage');
			thePlayer.UnblockAction( EIAB_Signs, 				'acs_stab_hostage');
			thePlayer.UnblockAction( EIAB_DrawWeapon, 			'acs_stab_hostage');
			thePlayer.UnblockAction( EIAB_FastTravel, 			'acs_stab_hostage');
			//thePlayer.UnblockAction( EIAB_Fists, 				'acs_stab_hostage');
			thePlayer.UnblockAction( EIAB_InteractionAction, 	'acs_stab_hostage');
			thePlayer.UnblockAction( EIAB_UsableItem,			'acs_stab_hostage');
			thePlayer.UnblockAction( EIAB_ThrowBomb,			'acs_stab_hostage');
			//thePlayer.UnblockAction( EIAB_SwordAttack,			'acs_stab_hostage');
			thePlayer.UnblockAction( EIAB_LightAttacks,			'acs_stab_hostage');
			thePlayer.UnblockAction( EIAB_HeavyAttacks,			'acs_stab_hostage');
			thePlayer.UnblockAction( EIAB_SpecialAttackLight,	'acs_stab_hostage');
			thePlayer.UnblockAction( EIAB_SpecialAttackHeavy,	'acs_stab_hostage');
			thePlayer.UnblockAction( EIAB_Dodge,				'acs_stab_hostage');
			thePlayer.UnblockAction( EIAB_Roll,					'acs_stab_hostage');
			thePlayer.UnblockAction( EIAB_Parry,				'acs_stab_hostage');
			thePlayer.UnblockAction( EIAB_MeditationWaiting,	'acs_stab_hostage');
			thePlayer.UnblockAction( EIAB_OpenMeditation,		'acs_stab_hostage');
			thePlayer.UnblockAction( EIAB_RadialMenu,			'acs_stab_hostage');
			thePlayer.UnblockAction( EIAB_Interactions, 		'acs_stab_hostage');
			thePlayer.UnblockAction( EIAB_Jump, 				'acs_stab_hostage');
			thePlayer.UnblockAction( EIAB_QuickSlots, 			'acs_stab_hostage');
			thePlayer.UnblockAction( EIAB_OpenFastMenu, 		'acs_stab_hostage');
			thePlayer.UnblockAction( EIAB_OpenInventory,		'acs_stab_hostage');
			thePlayer.UnblockAction( EIAB_OpenPreparation, 		'acs_stab_hostage');
			thePlayer.UnblockAction( EIAB_OpenMap, 				'acs_stab_hostage');
			thePlayer.UnblockAction( EIAB_OpenCharacterPanel, 	'acs_stab_hostage');
			thePlayer.UnblockAction( EIAB_OpenJournal, 			'acs_stab_hostage');
			thePlayer.UnblockAction( EIAB_OpenAlchemy, 			'acs_stab_hostage');
			thePlayer.UnblockAction( EIAB_OpenGlossary,			'acs_stab_hostage');

			victim = ACSGetCActor('ACS_Stab_Hostage');

			ACSGetCActor('ACS_Stab_Hostage').EnableCharacterCollisions(true);

			ACSGetCActor('ACS_Stab_Hostage').EnableCollisions(true);

			ACSGetCActor('ACS_Stab_Hostage').RemoveTag('ACS_Stab_Hostage');

			RemoveTimer('ACS_Stab_Hostage_Process');

			if (thePlayer.HasTag('ACS_Is_Sneaking'))
			{
				thePlayer.RaiseEvent('ACS_StabHostageReset');
			}
			else
			{
				thePlayer.RaiseEvent('ACS_StabHostageExit03');

				RemoveTimer('AardLightIcon');
				AddTimer('AardLightIcon', 0.125 , false );

				thePlayer.SoundEvent("sign_aard_blast");

				if (thePlayer.GetTarget() 
				&& ((CActor)thePlayer.GetTarget()) != victim
				)
				{
					targetPosition = ((CActor)thePlayer.GetTarget()).GetWorldPosition();

					targetPosition.Z += 1.5;
				}
				else
				{
					targetPosition = theCamera.GetCameraPosition() + theCamera.GetCameraDirection() * 10;

					if (targetPosition.Z > 2)
					{
						targetPosition.Z = 2;
					}
					else
					{
						if (targetPosition.Z < 0)
						{
							targetPosition.Z = 0;
						}
					}
				}

				action = new W3DamageAction in theGame.damageMgr;

				action.Initialize(GetWitcherPlayer(),victim,theGame,GetWitcherPlayer(),EHRT_Heavy,CPS_Undefined,false,true,false,false);

				action.SetHitReactionType( EHRT_Heavy );

				action.SetHitAnimationPlayType(EAHA_ForceYes);

				if (actortarget.UsesEssence())
				{
					action.AddDamage(theGame.params.DAMAGE_NAME_SILVER, 1 );
				}
				else if (actortarget.UsesVitality())
				{
					action.AddDamage(theGame.params.DAMAGE_NAME_PHYSICAL, 1 );
				}

				action.SetCanPlayHitParticle(false);

				theGame.damageMgr.ProcessAction( action );

				delete action;

				

				initpos = thePlayer.GetWorldPosition() + thePlayer.GetWorldForward();

				proj = (ACSPlayerNPCLauncherProjectile)theGame.CreateEntity( 
				(CEntityTemplate)LoadResource( 

				"dlc\dlc_acs\data\entities\projectiles\player_npc_launcher_projectile.w2ent"
				
				, true ), initpos );

				proj.Init(GetWitcherPlayer());

				proj.DesignateAttachmentVictim(victim);

				proj.ShootProjectileAtPosition(RandRangeF(45,15),	15, targetPosition, 50 );
			}

			stab_hostage_enabled = false;
		}
	}

	var stab_hostage_stamina_drain_cooldown			: float;

	timer function ACS_Stab_Hostage_Process( time : float , id : int)
	{
		var params																		: SCustomEffectParams;
		var duration 																	: float;
		var rot 																		: EulerAngles;
		var movementAdjustor 															: CMovementAdjustor;
		var ticket	 																	: SMovementAdjustmentRequestTicket;	
		
		if( 
		theGame.IsDialogOrCutscenePlaying() 
		|| !thePlayer.IsAlive()
		|| thePlayer.IsInCutsceneIntro()
		|| theGame.HasBlackscreenRequested()
		|| theGame.IsCurrentlyPlayingNonGameplayScene()
		|| theGame.GetGuiManager().IsAnyMenu()
		|| theGame.GetTutorialSystem().HasActiveTutorial()
		|| theGame.GetPhotomodeEnabled() 
		|| theGame.IsFading()
		|| theGame.IsBlackscreen()
		|| !stab_hostage_enabled
		|| !ACSGetCActor('ACS_Stab_Hostage')
		|| !ACSGetCActor('ACS_Stab_Hostage').IsAlive()
		|| thePlayer.GetStat(BCS_Stamina) <= 0.1
		)
		{
			ReleaseStabHostage();

			RemoveTimer('ACS_Stab_Hostage_Process');
			
			return;
		}

		if (theGame.GetEngineTimeAsSeconds() - stab_hostage_stamina_drain_cooldown > 0.5)
		{
			stab_hostage_stamina_drain_cooldown = theGame.GetEngineTimeAsSeconds();

			thePlayer.DrainStamina( ESAT_FixedValue,  thePlayer.GetStatMax( BCS_Stamina ) * 0.025, 0.5 );
		}

		movementAdjustor = thePlayer.GetMovingAgentComponent().GetMovementAdjustor();

		movementAdjustor.CancelAll();
		
		ticket = movementAdjustor.CreateNewRequest( 'ACS_Stab_Hostage' );
			
		movementAdjustor.AdjustmentDuration( ticket, 0.125  );

		movementAdjustor.ShouldStartAt(ticket, thePlayer.GetWorldPosition());
		movementAdjustor.MaxRotationAdjustmentSpeed( ticket, 5000000 );
		movementAdjustor.MaxLocationAdjustmentSpeed( ticket, 5000000 );

		movementAdjustor.RotateTo( ticket, VecHeading( theCamera.GetCameraDirection() ) );

		rot = thePlayer.GetWorldRotation();
		//rot.Yaw += 180;

		if (!ACSGetCActor('ACS_Stab_Hostage').HasBuff(EET_Blindness))
		{
			params.effectType = EET_Blindness;	
			params.creator = thePlayer;
			params.sourceName = "ACS_Stab_Hostage";
									
			params.duration = 7;

			ACSGetCActor('ACS_Stab_Hostage').AddEffectCustom(params);
		}

		ACSGetCActor('ACS_Stab_Hostage').TeleportWithRotation(LerpV(ACSGetCActor('ACS_Stab_Hostage').GetWorldPosition(), (thePlayer.GetWorldPosition() + thePlayer.GetWorldForward()), 0.1), rot);
	}

	function CounterWoundEndAnimationSwitch()
	{
		if (silver_fast_stance
		)
		{
			PlayerPlayAnimation('tw1_silver_fast_dodge_back_short_ACS');
		}
		else if ( 
		silver_group_stance 
		)
		{
			PlayerPlayAnimation('tw1_silver_group_dodge_back_short_ACS');
		}
		else if ( 
		silver_strong_stance 
		)
		{
			PlayerPlayAnimation('tw1_silver_strong_dodge_back_short_ACS');
		}
		else if (steel_fast_stance
		)
		{
			PlayerPlayAnimation('tw1_steel_fast_dodge_back_short_ACS');
		}
		else if (steel_group_stance
		)
		{
			PlayerPlayAnimation('tw1_steel_group_dodge_back_short_ACS');
		}
		else if ( 
		steel_strong_stance 
		)
		{
			PlayerPlayAnimation('tw1_steel_strong_dodge_back_short_ACS');
		}
		else
		{
			PlayerPlayAnimation('tw1_silver_fast_dodge_back_short_ACS');
		}
	}


	var dodge_variations 							: array<int>;
	var chosen_dodge_variation 						: int;

	function GetRandomizedDodgeVariation() : int
	{
		if (dodge_variations.Size() <= 0)
		{
			dodge_variations.Clear();
			dodge_variations.PushBack(0);
			dodge_variations.PushBack(1);
			dodge_variations.PushBack(2);
			dodge_variations.PushBack(3);
			dodge_variations.PushBack(4);
			dodge_variations.PushBack(5);
			dodge_variations.PushBack(6);
			dodge_variations.PushBack(7);
			dodge_variations.PushBack(8);
			dodge_variations.PushBack(9);
			dodge_variations.PushBack(10);
			dodge_variations.PushBack(11);
			dodge_variations.PushBack(12);
			dodge_variations.PushBack(13);
		}
		
		chosen_dodge_variation = dodge_variations[RandRange(dodge_variations.Size())];

		dodge_variations.Remove(chosen_dodge_variation);

		return chosen_dodge_variation;
	}

	var Enemy_Attack_From_Behind_Evade_Process : bool;

	function Enemy_Attack_From_Behind_Evade_Process_Manage(b : bool)
	{
		Enemy_Attack_From_Behind_Evade_Process = b;
	}

	// END OF CLASS
}

state ACS_BARADDUR in W3ACSWatcher 
{
	event OnEnterState(previous_state_name: name) 
	{
    	super.OnEnterState(previous_state_name);
	
    	this.ACS_BARADDUR_ENTRY();
	}

	entry function ACS_BARADDUR_ENTRY() 
	{
		while (true) 
		{
			parent.THE_EYE();

			if (
			(ACS_VersionControl() == 0 || ACS_VersionControl() > ACS_GetVersion() ) 
			&& FactsQuerySum("acs_version_control_toggle") <= 0 
			)
			{
				FactsAdd("acs_version_control_toggle", 1, -1);
			}

			if (
			ACS_Settings_Main_Bool('acs_misc_main_settings','acs_reset_tut_popups', false)
			)
			{
				FactsAdd("acs_reset_tutorial_toggle", 1, -1);
			}
			
			if ( !theGame.IsPaused() 
			&& !theGame.IsDialogOrCutscenePlaying()
			&& !theGame.GetPhotomodeEnabled() 
			&& !thePlayer.IsInCutsceneIntro() 
			&& !theGame.IsCurrentlyPlayingNonGameplayScene()
			&& !theGame.IsFading()
			&& !theGame.IsBlackscreen()
			)
			{
				if ( FactsQuerySum("acs_reset_tutorial_toggle") > 0 
				)
				{
					ResetTutorials();

					theGame.GetInGameConfigWrapper().SetVarValue('acs_misc_main_settings', 'acs_reset_tut_popups', 0);

					FactsRemove("acs_reset_tutorial_toggle");
				}

				if ( FactsQuerySum("acs_version_control_toggle") > 0 
				)
				{
					if (ACS_VersionControl() == 0)
					{
						ACS_InitializeSettings();
						ACS_Tutorial_Popup_Display(2117035665, 2117035666);
					}
					else
					{
						theGame.GetInGameConfigWrapper().SetVarValue('acs_main_settings', 'acs_version_control', ACS_GetVersion());
					}

					FactsRemove("ACS_Has_Seen_Logo");

					FactsRemove("acs_version_control_toggle");
				}
			}

			if (ACS_Settings_Main_Bool('acs_visual_main_settings','acs_disable_big_camera_lights', true))
			{
				if ( (theGame.IsDialogOrCutscenePlaying() 
				|| thePlayer.IsInCutsceneIntro() 
				|| theGame.IsCurrentlyPlayingNonGameplayScene())
				&& ACS_Settings_Main_Bool('acs_visual_main_settings','acs_enable_camera_lights_in_cutscenes', false)
				)
				{
					if (theGame.GetInGameConfigWrapper().GetVarValue('acs_visual_main_settings', 'DisableBigCameraLights' ) != "false" )
					{
						theGame.GetInGameConfigWrapper().SetVarValue('acs_visual_main_settings', 'DisableBigCameraLights', "false");
					}
				}
				else 
				{
					if (theGame.GetInGameConfigWrapper().GetVarValue('acs_visual_main_settings', 'DisableBigCameraLights' ) != "true" )
					{
						theGame.GetInGameConfigWrapper().SetVarValue('acs_visual_main_settings', 'DisableBigCameraLights', "true");
					}
				}
			}
			else
			{
				if (theGame.GetInGameConfigWrapper().GetVarValue('acs_visual_main_settings', 'DisableBigCameraLights' ) != "false" )
				{
					theGame.GetInGameConfigWrapper().SetVarValue('acs_visual_main_settings', 'DisableBigCameraLights', "false");
				}
			}

			if (ACS_Settings_Main_Bool('acs_visual_main_settings','acs_disable_small_camera_lights', true))
			{
				if ( (theGame.IsDialogOrCutscenePlaying() 
				|| thePlayer.IsInCutsceneIntro() 
				|| theGame.IsCurrentlyPlayingNonGameplayScene())
				&& ACS_Settings_Main_Bool('acs_visual_main_settings','acs_enable_camera_lights_in_cutscenes', false)
				)
				{
					if (theGame.GetInGameConfigWrapper().GetVarValue('acs_visual_main_settings', 'DisableSmallCameraLights' ) != "false" )
					{
						theGame.GetInGameConfigWrapper().SetVarValue('acs_visual_main_settings', 'DisableSmallCameraLights', "false");
					}
				}
				else
				{
					if (theGame.GetInGameConfigWrapper().GetVarValue('acs_visual_main_settings', 'DisableSmallCameraLights' ) != "true" )
					{
						theGame.GetInGameConfigWrapper().SetVarValue('acs_visual_main_settings', 'DisableSmallCameraLights', "true");
					}
				}
			}
			else
			{
				if (theGame.GetInGameConfigWrapper().GetVarValue('acs_visual_main_settings', 'DisableSmallCameraLights' ) != "false" )
				{
					theGame.GetInGameConfigWrapper().SetVarValue('acs_visual_main_settings', 'DisableSmallCameraLights', "false");
				}
			}

			if (ACS_Settings_Main_Bool('acs_visual_main_settings','acs_disable_all_camera_lights', true))
			{
				if ( (theGame.IsDialogOrCutscenePlaying() 
				|| thePlayer.IsInCutsceneIntro() 
				|| theGame.IsCurrentlyPlayingNonGameplayScene())
				&& ACS_Settings_Main_Bool('acs_visual_main_settings','acs_enable_camera_lights_in_cutscenes', false)
				)
				{
					if (theGame.GetInGameConfigWrapper().GetVarValue('acs_visual_main_settings', 'DisableAllCameraLights' ) != "false" )
					{
						theGame.GetInGameConfigWrapper().SetVarValue('acs_visual_main_settings', 'DisableAllCameraLights', "false");
					}
				}
				else
				{
					if (theGame.GetInGameConfigWrapper().GetVarValue('acs_visual_main_settings', 'DisableAllCameraLights' ) != "true" )
					{
						theGame.GetInGameConfigWrapper().SetVarValue('acs_visual_main_settings', 'DisableAllCameraLights', "true");
					}
				}
			}
			else
			{
				if (theGame.GetInGameConfigWrapper().GetVarValue('acs_visual_main_settings', 'DisableAllCameraLights' ) != "false" )
				{
					theGame.GetInGameConfigWrapper().SetVarValue('acs_visual_main_settings', 'DisableAllCameraLights', "false");
				}
			}

      		SleepOneFrame();
    	}
	}


	// Wraith Mode

	function WraithModeActivate()
	{
		var ent														: CEntity;

		ACS_Tutorial_Display_Check('ACS_Wraith_Mode_Tutorial_Shown');

		theGame.CreateNoSaveLock( "ACS_Wraith_Mode_State", ACS_Wraith_Mode_Savelock_ID, false, false );

		ACS_StaminaDrain(4);

		thePlayer.AddTag('acs_in_wraith');

		thePlayer.SoundEvent("magic_yennefer_necromancy_loop_start");

		thePlayer.SoundEvent( "q704_regis_mistform_activates" );

		thePlayer.SoundEvent( "q704_regis_mistform_LP" );
		thePlayer.SoundEvent( "q704_regis_mistform_LP" );
		thePlayer.SoundEvent( "q704_regis_mistform_LP" );

		environment = (CEnvironmentDefinition)LoadResource(
			//"dlc\bob\data\fx\cutscenes\cs702_vision\vision_env.env"
			"dlc\dlc_acs\data\env\q605_hell_red_blockout.env"
			, true);
		envID = ActivateEnvironmentDefinition( environment, 1000, 1, 0.25f );
		theGame.SetEnvironmentID(envID);

		camera = (CCustomCamera)theCamera.GetTopmostCameraObject();

		camera.StopAnimation('camera_shake_loop_lvl1_1');

		theGame.GetGameCamera().StopAnimation( 'camera_shake_loop_lvl1_1' );

		camera.StopAnimation('camera_shake_loop_lvl1_5');

		theGame.GetGameCamera().StopAnimation( 'camera_shake_loop_lvl1_5' );

		thePlayer.BlockAction( EIAB_DrawWeapon, 		'ACS_Wraith'); 
		thePlayer.BlockAction( EIAB_Crossbow, 			'ACS_Wraith');
		thePlayer.BlockAction( EIAB_CallHorse,			'ACS_Wraith');
		thePlayer.BlockAction( EIAB_Signs, 				'ACS_Wraith');
		thePlayer.BlockAction( EIAB_FastTravel, 		'ACS_Wraith');
		thePlayer.BlockAction( EIAB_Fists, 				'ACS_Wraith');
		thePlayer.BlockAction( EIAB_InteractionAction, 	'ACS_Wraith');
		thePlayer.BlockAction( EIAB_UsableItem,			'ACS_Wraith');
		thePlayer.BlockAction( EIAB_ThrowBomb,			'ACS_Wraith');
		thePlayer.BlockAction( EIAB_SwordAttack,		'ACS_Wraith');
		thePlayer.BlockAction( EIAB_LightAttacks,		'ACS_Wraith');
		thePlayer.BlockAction( EIAB_HeavyAttacks,		'ACS_Wraith');
		thePlayer.BlockAction( EIAB_SpecialAttackLight,	'ACS_Wraith');
		thePlayer.BlockAction( EIAB_SpecialAttackHeavy,	'ACS_Wraith');
		//thePlayer.BlockAction( EIAB_Dodge,			'ACS_Wraith');
		//thePlayer.BlockAction( EIAB_Roll,				'ACS_Wraith');
		thePlayer.BlockAction( EIAB_MeditationWaiting,	'ACS_Wraith');
		thePlayer.BlockAction( EIAB_OpenMeditation,		'ACS_Wraith');
		thePlayer.BlockAction( EIAB_RadialMenu,			'ACS_Wraith');
		thePlayer.BlockAction( EIAB_Interactions, 		'ACS_Wraith');
		thePlayer.BlockAction( EIAB_QuickSlots, 		'ACS_Wraith');

		thePlayer.OnMeleeForceHolster( true );
		thePlayer.OnRangedForceHolster( true );
				
		thePlayer.StopAllEffects();

		//RemoveTimer('ACS_Embers_Timer');
			
		thePlayer.StopEffect('special_attack_short_fx');
		thePlayer.PlayEffectSingle('special_attack_short_fx');

		//thePlayer.StopEffect('mist_fly_regis');
		//thePlayer.PlayEffectSingle('mist_fly_regis');

		//thePlayer.PlayEffectSingle( 'mist_regis' );

		//thePlayer.StopEffect( 'mist_regis' );

		ent = (CEntity)theGame.CreateEntity( 

		(CEntityTemplate)LoadResource( 
			
		"dlc\dlc_acs\data\entities\other\custom_wings\custom_vampire_wings.w2ent"
		
		, true ), 
		
		thePlayer.GetWorldPosition() );

		ent.CreateAttachment( thePlayer, 'blood_point', Vector( 
		-5, // + up - down
		0.3, // + forward - backward
		-0.02 // + left - right
		), 
		EulerAngles(
		0,
		0,
		90
		) );

		ent.AddTag('ACS_Vampire_Wings');

		if (ACSGetCEntity('ACS_Eredin_Skirt'))
		{
			ACSGetCEntity('ACS_Eredin_Skirt').StopEffect('special_attack_short_fx');
			ACSGetCEntity('ACS_Eredin_Skirt').PlayEffectSingle('special_attack_short_fx');
		}

		if (ACSGetCEntity('ACS_Eredin_Cloak'))
		{
			ACSGetCEntity('ACS_Eredin_Cloak').StopEffect('special_attack_short_fx');
			ACSGetCEntity('ACS_Eredin_Cloak').PlayEffectSingle('special_attack_short_fx');
		}

		if (ACSGetCEntity('ACS_VGX_Eredin_Cloak'))
		{
			ACSGetCEntity('ACS_VGX_Eredin_Cloak').StopEffect('special_attack_short_fx');
			ACSGetCEntity('ACS_VGX_Eredin_Cloak').PlayEffectSingle('special_attack_short_fx');
		}

		if (ACSGetCEntity('ACS_Imlerith_Skirt'))
		{
			ACSGetCEntity('ACS_Imlerith_Skirt').StopEffect('special_attack_short_fx');
			ACSGetCEntity('ACS_Imlerith_Skirt').PlayEffectSingle('special_attack_short_fx');
		}

		if (ACS_Armor_Set_Check('acs_armor', false))
		{
			thePlayer.PlayEffectSingle('shadows_form');
		}

		thePlayer.EnableCollisions(false);
		thePlayer.EnableCharacterCollisions(false);

		((CMovingPhysicalAgentComponent)(thePlayer).GetMovingAgentComponent()).EnableCollisionPrediction( false );

		((CMovingPhysicalAgentComponent)(thePlayer).GetMovingAgentComponent()).SetTerrainInfluence(0);

		((CMovingPhysicalAgentComponent)(thePlayer).GetMovingAgentComponent()).EnableAdditionalVerticalSlidingIteration(true);

		((CMovingPhysicalAgentComponent)(thePlayer).GetMovingAgentComponent()).SetPushable(false);

		((CMovingPhysicalAgentComponent)(thePlayer).GetMovingAgentComponent()).SetRagdollPushingMul(0);

		((CMovingPhysicalAgentComponent)(thePlayer).GetMovingAgentComponent()).SetGravity(false);

		if (!wraith_pose
		)
		{
			wraith_pose = true;
		}

		thePlayer.RaiseEvent('ACS_FlyPoseIdle');
										
		AddTimer('ACS_wraith', 0.000000000000000001f , true);
	}

	function WraithModeDeactivate()
	{
		if (thePlayer.HasTag('acs_in_wraith'))
		{
			theGame.ReleaseNoSaveLock( ACS_Wraith_Mode_Savelock_ID );

			if (wraith_pose)
			{
				wraith_pose = false;
			}

			if (wraith_pose_switch
			)
			{
				wraith_pose_switch = false;
			}

			thePlayer.RaiseEvent('ACS_FlyPoseReset');

			thePlayer.EnableCollisions(true);
			if (!thePlayer.IsUsingHorse()&& !thePlayer.IsUsingVehicle()){thePlayer.EnableCharacterCollisions(true); }

			thePlayer.SoundEvent("magic_yennefer_necromancy_loop_stop");

			thePlayer.SoundEvent("q704_regis_mistform_LP_stop");
			thePlayer.SoundEvent("q704_regis_mistform_LP_stop");
			thePlayer.SoundEvent("q704_regis_mistform_LP_stop");

			DeactivateEnvironment(envID, 1);

			RemoveTimer('ACS_wraith');

			thePlayer.StopEffect('special_attack_short_fx');

			thePlayer.StopEffect('wraith_fx');

			thePlayer.StopEffect('mist_fly_regis');

			thePlayer.PlayEffectSingle( 'mist_regis' );

			thePlayer.StopEffect( 'mist_regis' );

			ACSGetCEntity('ACS_Vampire_Wings').Destroy();

			if (ACS_Armor_Set_Check('acs_armor', false))
			{
				thePlayer.StopEffect('shadows_form');
			}

			if (ACSGetCEntity('ACS_Eredin_Skirt'))
			{
				ACSGetCEntity('ACS_Eredin_Skirt').StopEffect('special_attack_short_fx');
			}

			if (ACSGetCEntity('ACS_Eredin_Cloak'))
			{
				ACSGetCEntity('ACS_Eredin_Cloak').StopEffect('special_attack_short_fx');
			}

			if (ACSGetCEntity('ACS_VGX_Eredin_Cloak'))
			{
				ACSGetCEntity('ACS_VGX_Eredin_Cloak').StopEffect('special_attack_short_fx');
			}

			if (ACSGetCEntity('ACS_Imlerith_Skirt'))
			{
				ACSGetCEntity('ACS_Imlerith_Skirt').StopEffect('special_attack_short_fx');
			}

			thePlayer.UnblockAction( EIAB_DrawWeapon, 			'ACS_Wraith');
			thePlayer.UnblockAction( EIAB_Crossbow, 			'ACS_Wraith');
			thePlayer.UnblockAction( EIAB_CallHorse,			'ACS_Wraith');
			thePlayer.UnblockAction( EIAB_Signs, 				'ACS_Wraith');
			thePlayer.UnblockAction( EIAB_FastTravel, 			'ACS_Wraith');
			thePlayer.UnblockAction( EIAB_Fists, 				'ACS_Wraith');
			thePlayer.UnblockAction( EIAB_InteractionAction, 	'ACS_Wraith');
			thePlayer.UnblockAction( EIAB_UsableItem,			'ACS_Wraith');
			thePlayer.UnblockAction( EIAB_ThrowBomb,			'ACS_Wraith');
			thePlayer.UnblockAction( EIAB_SwordAttack,			'ACS_Wraith');
			thePlayer.UnblockAction( EIAB_LightAttacks,			'ACS_Wraith');
			thePlayer.UnblockAction( EIAB_HeavyAttacks,			'ACS_Wraith');
			thePlayer.UnblockAction( EIAB_SpecialAttackLight,	'ACS_Wraith');
			thePlayer.UnblockAction( EIAB_SpecialAttackHeavy,	'ACS_Wraith');
			//thePlayer.UnblockAction( EIAB_Dodge,				'ACS_Wraith');
			//thePlayer.UnblockAction( EIAB_Roll,				'ACS_Wraith');
			thePlayer.UnblockAction( EIAB_MeditationWaiting,	'ACS_Wraith');
			thePlayer.UnblockAction( EIAB_OpenMeditation,		'ACS_Wraith');
			thePlayer.UnblockAction( EIAB_RadialMenu,			'ACS_Wraith');
			thePlayer.UnblockAction( EIAB_Interactions, 		'ACS_Wraith');
			thePlayer.UnblockAction( EIAB_QuickSlots, 			'ACS_Wraith');

			((CMovingPhysicalAgentComponent)(thePlayer).GetMovingAgentComponent()).EnableCollisionPrediction( true );

			((CMovingPhysicalAgentComponent)(thePlayer).GetMovingAgentComponent()).SetTerrainInfluence(1);

			((CMovingPhysicalAgentComponent)(thePlayer).GetMovingAgentComponent()).EnableAdditionalVerticalSlidingIteration(true);

			((CMovingPhysicalAgentComponent)(thePlayer).GetMovingAgentComponent()).SetPushable(true);

			((CMovingPhysicalAgentComponent)(thePlayer).GetMovingAgentComponent()).SetRagdollPushingMul(0);

			((CMovingPhysicalAgentComponent)(thePlayer).GetMovingAgentComponent()).SetGravity(true);

			thePlayer.RemoveTag('acs_in_wraith');

			if (ACS_GetItem_Sword_IsEquipped('zireal_steel_held', 'steel') || ACS_GetItem_Sword_IsEquipped('zireal_silver_held', 'silver'))
			{
				if (!thePlayer.IsEffectActive('fury_403_ciri', false))
				{
					thePlayer.PlayEffectSingle( 'fury_403_ciri' );
				}

				if (!thePlayer.IsEffectActive('fury_ciri', false))
				{
					thePlayer.PlayEffectSingle( 'fury_ciri' );
				}

				if (!thePlayer.IsEffectActive('acs_fury_effect', false))
				{
					thePlayer.PlayEffectSingle( 'acs_fury_effect' );
				}
			}
		}
	}

	// Bruxa Dash
	
	function BruxaDash_Combat()
	{
		if(!thePlayer.IsInHitAnim()
		&& !thePlayer.HasTag('ACS_IsPerformingFinisher')
		&& !thePlayer.HasTag('ACS_IsPerformingCombatDismember')
		&& !thePlayer.IsCrossbowHeld()
		&& ACS_BuffCheck()
		&& thePlayer.IsActionAllowed(EIAB_Movement)
		&& (thePlayer.IsInCombat() || !ACS_CombatToExplorationCheck())
		)
		{
			if (ACS_can_bruxa_dash())
			{
				if ( ACS_Settings_Main_Bool('acs_stamina_settings','acs_stamina_block_action', false) 
				&& StaminaCheck('default')
				&& !thePlayer.HasTag('acs_in_wraith')
				)
				{	
					RemoveTimer('SwordTauntSwitch'); RemoveTimer('SwordTauntRunningSwitch');   if (thePlayer.HasTag('ACS_IsSwordWalking')){thePlayer.RemoveTag('ACS_IsSwordWalking');} if(thePlayer.IsInCombat()){if(thePlayer.GetCombatIdleStance() <= 0.f ){thePlayer.RaiseEvent('ACS_CombatTauntLeft');}else{thePlayer.RaiseEvent('ACS_CombatTauntRight');}} thePlayer.SoundEvent("gui_no_stamina");
				}
				else
				{
					ACS_refresh_bruxa_dash_cooldown();

					ACS_StaminaDrain(4);

					DeactivateThings_BruxaDash();

					ACS_ThingsThatShouldBeRemoved_BASE(false); 
	
					RemoveTimer('ACS_portable_aard'); 

					RemoveTimer('ACS_Dash_Attack_Process'); 

					RemoveTimer('ACS_Vampire_Claws_Sword_Hybrid_Dash');


					if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	

					thePlayer.SetIsCurrentlyDodging(true);

					thePlayer.EnableCharacterCollisions(false); 

					WraithModeDeactivate();

					if (!thePlayer.HasTag('ACS_Camo_Active')
					&& !thePlayer.HasTag('ACS_Bruxa_Bite_Process')
					&& !thePlayer.IsEffectActive( 'invisible' )
					)
					{
						thePlayer.PlayEffectSingle( 'bruxa_dash_trails_backup' );
						thePlayer.StopEffect( 'bruxa_dash_trails_backup' );

						thePlayer.DestroyEffect('shadowdash_short');
						thePlayer.PlayEffectSingle( 'shadowdash_short' );
						thePlayer.StopEffect( 'shadowdash_short' );
					}

					if (thePlayer.HasTag('ACS_Bruxa_Bite_Process'))
					{
						bruxa_blood_suck_end_no_jump_actual();
					}
					
					dodge_timer_actual();
						
					thePlayer.BreakAttachment();		

					ACS_ExplorationDelayHack(false, 3);

					DeactivateThings_BruxaDash();

					if (ACSGetCEntity('ACS_Bruxa_Camo_Trail'))
					{
						ACSGetCEntity('ACS_Bruxa_Camo_Trail').StopEffect('smoke');
						ACSGetCEntity('ACS_Bruxa_Camo_Trail').PlayEffectSingle('smoke');
					}	

					bruxa_dash();			
				}
			}
		}
	}

	function JumpAttackCombat()
	{
		if (theInput.GetActionValue('Sprint') == 0 )
		{
			WraithModeDeactivate();

			if (ACS_Settings_Main_Bool('acs_main_settings','acs_mod_enabled', true))
			{
				RemoveTimer('RollDelay');
				
				if (thePlayer.HasTag('ACS_Bruxa_Bite_Process'))
				{
					bruxa_blood_suck_end_no_jump_actual();
				}

				if ( ACS_Settings_Main_Bool('acs_stamina_settings','acs_stamina_block_action', false) 
				&& StaminaCheck('default')
				)
				{									 
					RemoveTimer('SwordTauntSwitch'); RemoveTimer('SwordTauntRunningSwitch');   if (thePlayer.HasTag('ACS_IsSwordWalking')){thePlayer.RemoveTag('ACS_IsSwordWalking');} if(thePlayer.IsInCombat()){if(thePlayer.GetCombatIdleStance() <= 0.f ){thePlayer.RaiseEvent('ACS_CombatTauntLeft');}else{thePlayer.RaiseEvent('ACS_CombatTauntRight');}} thePlayer.SoundEvent("gui_no_stamina");
				}
				else
				{
					thePlayer.DrainStamina( ESAT_FixedValue,  thePlayer.GetStatMax( BCS_Stamina ) * 0.5, 1 );

					if (thePlayer.HasTag('acs_aard_sword_equipped')
					|| thePlayer.HasTag('acs_vampire_claws_equipped'))
					{
						if (!thePlayer.HasTag('ACS_Camo_Active')
						&& !thePlayer.HasTag('ACS_Bruxa_Bite_Process')
						&& !thePlayer.IsEffectActive( 'invisible' )
						)
						{
							if (!ACS_Settings_Main_Bool('acs_player_misc_settings','acs_hide_vampire_claws', false))
							{
								if (thePlayer.HasTag('acs_aard_sword_equipped')
								|| thePlayer.HasTag('acs_vampire_claws_equipped')
								)
								{
									if (!ACS_Settings_Main_Bool('acs_player_misc_settings','acs_hide_vampire_claws', false))
									{
										thePlayer.PlayEffectSingle('claws_effect');
										thePlayer.StopEffect('claws_effect');
									}
								}

								thePlayer.PlayEffectSingle('shadowdash_shockwave');
								thePlayer.StopEffect('shadowdash_shockwave');
							}

							//thePlayer.PlayEffectSingle('trap_attack_smoke');
							//thePlayer.StopEffect('trap_attack_smoke');
						}
					}

					if (!thePlayer.HasTag('ACS_HideWeaponOnDodge'))
					{
						thePlayer.AddTag('ACS_HideWeaponOnDodge');
					}

					thePlayer.SetImmortalityMode( AIM_Invulnerable, AIC_Default, true ); 
					thePlayer.SetCanPlayHitAnim(false); 
					thePlayer.EnableCharacterCollisions(false); 
					thePlayer.AddBuffImmunity_AllNegative('acs_dodge', true); 
					thePlayer.SetIsCurrentlyDodging(true);

					RemoveTimer('ACS_jump_attack_reveal_timer');

					AddTimer('ACS_jump_attack_reveal_timer', 0.5   , false);
										
					if (thePlayer.IsInAir())
					{	
						Attack_Process_06('geraltRandomAirJumpAttack');
					}
					else
					{
						Attack_Process_05('geraltRandomJumpAttack');
					}
				}
			}
			else
			{
				if (thePlayer.HasTag('ACS_Bruxa_Bite_Process'))
				{
					bruxa_blood_suck_end_no_jump_actual();
				}

				ACS_BruxaDodgeSlideBackInit();
			}
		}
	}

	var vBruxaDodgeSlideBack : cBruxaDodgeSlideBack;

	function ACS_BruxaDodgeSlideBackInit()
	{
		if (ACS_New_Replacers_Female_Active())
		{
			GetWitcherPlayer().EvadePressed(EBAT_Dodge);
			ACS_StaminaDrain(4);
			return;
		}

		vBruxaDodgeSlideBack = new cBruxaDodgeSlideBack in this;
		
		if ( ACS_Settings_Main_Bool('acs_main_settings','acs_mod_enabled', true) )
		{
			if (!GetWitcherPlayer().IsPerformingFinisher()
			&& !GetWitcherPlayer().HasTag('acs_in_wraith')
			&& !GetWitcherPlayer().HasTag('ACS_Bruxa_Bite_Process')
			&& ACS_BuffCheck()
			&& GetWitcherPlayer().IsActionAllowed(EIAB_Dodge)
			)
			{
				vBruxaDodgeSlideBack.BruxaDodgeSlideBack_Engage();
			}
		}
	}

	var vWildHuntBlink : cWildHuntBlink;

	function ACS_WildHuntBlinkInit()
	{
		if (ACS_New_Replacers_Female_Active())
		{
			GetWitcherPlayer().EvadePressed(EBAT_Roll);
			ACS_StaminaDrain(4);
			return;
		}

		vWildHuntBlink = new cWildHuntBlink in this;
		
		if ( ACS_Settings_Main_Bool('acs_main_settings','acs_mod_enabled', true)
		&& !GetWitcherPlayer().IsPerformingFinisher()
		&& !GetWitcherPlayer().HasTag('acs_in_wraith')
		&& !GetWitcherPlayer().HasTag('ACS_Bruxa_Bite_Process')
		&& ACS_BuffCheck()
		&& GetWitcherPlayer().IsActionAllowed(EIAB_Roll)
		)
		{
			vWildHuntBlink.WildHuntBlink_Engage();
		}
	}

	public timer function ACS_jump_attack_reveal_timer ( dt : float, id : int)
	{	 
		thePlayer.SetImmortalityMode( AIM_None, AIC_Default, true ); 
		thePlayer.SetCanPlayHitAnim(true); 
		if (!thePlayer.IsUsingHorse()&& !thePlayer.IsUsingVehicle()){thePlayer.EnableCharacterCollisions(true); } 
		thePlayer.RemoveBuffImmunity_AllNegative('acs_dodge'); 
		thePlayer.SetIsCurrentlyDodging(false);

		if ( thePlayer.HasTag('ACS_HideWeaponOnDodge') 
		//&& !thePlayer.HasTag('ACS_Bruxa_Bite_Process')
		)
		{
			if (!thePlayer.HasTag('acs_aard_sword_equipped'))
			{
				ACS_Weapon_Respawn();
			}
			
			thePlayer.RemoveTag('ACS_HideWeaponOnDodge');

			thePlayer.RemoveTag('ACS_HideWeaponOnDodge_Claw_Effect');
		}
	}

	function BruxaDash_NEW_For_Sprint()
	{
		if (!thePlayer.IsInHitAnim()
		&& !thePlayer.HasTag('ACS_IsPerformingFinisher')
		&& !thePlayer.HasTag('ACS_IsPerformingCombatDismember')
		&& !thePlayer.IsCrossbowHeld()
		&& ACS_BuffCheck()
		&& !ACS_New_Replacers_Female_Active()
		&& thePlayer.IsActionAllowed(EIAB_Movement)
		)
		{
			DeactivateThings_BruxaDash();

			ACS_ThingsThatShouldBeRemoved_BASE(false); 
	
			RemoveTimer('ACS_portable_aard'); 

			RemoveTimer('ACS_Dash_Attack_Process'); 

			RemoveTimer('ACS_Vampire_Claws_Sword_Hybrid_Dash');

			if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	

			if( BruxaDashCallTime + DOUBLE_TAP_WINDOW >= theGame.GetEngineTimeAsSeconds() )
			{
				BruxaDashDoubleTap = true;
			}
			else
			{
				BruxaDashDoubleTap = false;	
			}
			
			if( BruxaDashDoubleTap )
			{
				if (ACS_Settings_Main_Bool('acs_bruxa_dash_settings','acs_bruxa_dash', false) 
				&& !theGame.IsFocusModeActive()
				&& theInput.GetActionValue('Focus') == 0
				&& ACS_Settings_Main_Int('acs_bruxa_dash_settings','acs_bruxa_dash_input', 0) == 1
				&& ACS_Settings_Main_Int('acs_bruxa_dash_settings','acs_bruxa_dash_sprint_or_w', 0) == 1
				&& ACS_can_bruxa_dash())
				{
					if ( ACS_Settings_Main_Bool('acs_stamina_settings','acs_stamina_block_action', false) 
					&& StaminaCheck('default')
					&& !thePlayer.HasTag('acs_in_wraith')
					)
					{	
						RemoveTimer('SwordTauntSwitch'); RemoveTimer('SwordTauntRunningSwitch');   if (thePlayer.HasTag('ACS_IsSwordWalking')){thePlayer.RemoveTag('ACS_IsSwordWalking');} if(thePlayer.IsInCombat()){if(thePlayer.GetCombatIdleStance() <= 0.f ){thePlayer.RaiseEvent('ACS_CombatTauntLeft');}else{thePlayer.RaiseEvent('ACS_CombatTauntRight');}} thePlayer.SoundEvent("gui_no_stamina");
					}
					else
					{
						ACS_StaminaDrain(4);

						thePlayer.SetIsCurrentlyDodging(true);

						thePlayer.EnableCharacterCollisions(false); 

						ACS_refresh_bruxa_dash_cooldown();

						WraithModeDeactivate();

						if (!thePlayer.HasTag('ACS_Camo_Active')
						&& !thePlayer.HasTag('ACS_Bruxa_Bite_Process')
						&& !thePlayer.IsEffectActive( 'invisible' )
						)
						{
							thePlayer.PlayEffectSingle( 'bruxa_dash_trails_backup' );
							thePlayer.StopEffect( 'bruxa_dash_trails_backup' );

							thePlayer.DestroyEffect('shadowdash_short');
							thePlayer.PlayEffectSingle( 'shadowdash_short' );
							thePlayer.StopEffect( 'shadowdash_short' );
						}

						if (thePlayer.HasTag('ACS_Bruxa_Bite_Process'))
						{
							bruxa_blood_suck_end_no_jump_actual();
						}
						
						dodge_timer_actual();
							
						thePlayer.BreakAttachment();		

						bruxa_dash();						
					}
				}
			}
			else 
			{	
				if ( thePlayer.HasTag('acs_vampire_claws_equipped') )
				{
					if ( !thePlayer.HasTag('ACS_Camo_Active') && !thePlayer.HasTag('acs_in_wraith') && !thePlayer.HasTag('ACS_Bruxa_Bite_Process') )
					{
						thePlayer.PlayEffectSingle( 'magic_step_l_new' );
						thePlayer.StopEffect( 'magic_step_l_new' );	

						thePlayer.PlayEffectSingle( 'magic_step_r_new' );
						thePlayer.StopEffect( 'magic_step_r_new' );	

						thePlayer.PlayEffectSingle( 'bruxa_dash_trails' );
						thePlayer.StopEffect( 'bruxa_dash_trails' );

						thePlayer.DestroyEffect('shadowdash_short');
						thePlayer.PlayEffectSingle( 'shadowdash_short' );
						thePlayer.StopEffect( 'shadowdash_short' );
					}
				}

				if (ACS_Settings_Main_Bool('acs_bruxa_dash_settings','acs_bruxa_dash', false) 
				&& !theGame.IsFocusModeActive()
				&& theInput.GetActionValue('Focus') == 0
				&& ACS_Settings_Main_Int('acs_bruxa_dash_settings','acs_bruxa_dash_input', 0) == 0
				&& ACS_Settings_Main_Int('acs_bruxa_dash_settings','acs_bruxa_dash_sprint_or_w', 0) == 1
				&& ACS_can_bruxa_dash()
				)
				{
					if ( ACS_Settings_Main_Bool('acs_stamina_settings','acs_stamina_block_action', false) 
					&& StaminaCheck('default')
					&& !thePlayer.HasTag('acs_in_wraith')
					)
					{	
						RemoveTimer('SwordTauntSwitch'); RemoveTimer('SwordTauntRunningSwitch');   if (thePlayer.HasTag('ACS_IsSwordWalking')){thePlayer.RemoveTag('ACS_IsSwordWalking');} if(thePlayer.IsInCombat()){if(thePlayer.GetCombatIdleStance() <= 0.f ){thePlayer.RaiseEvent('ACS_CombatTauntLeft');}else{thePlayer.RaiseEvent('ACS_CombatTauntRight');}} thePlayer.SoundEvent("gui_no_stamina");
					}
					else
					{
						ACS_StaminaDrain(4);

						thePlayer.SetIsCurrentlyDodging(true);

						thePlayer.EnableCharacterCollisions(false); 

						ACS_refresh_bruxa_dash_cooldown();

						WraithModeDeactivate();

						if (!thePlayer.HasTag('ACS_Camo_Active')
						&& !thePlayer.HasTag('ACS_Bruxa_Bite_Process')
						&& !thePlayer.IsEffectActive( 'invisible' )
						)
						{
							thePlayer.PlayEffectSingle( 'bruxa_dash_trails_backup' );
							thePlayer.StopEffect( 'bruxa_dash_trails_backup' );
							
							thePlayer.DestroyEffect('shadowdash_short');
							thePlayer.PlayEffectSingle( 'shadowdash_short' );
							thePlayer.StopEffect( 'shadowdash_short' );
						}

						if (thePlayer.HasTag('ACS_Bruxa_Bite_Process'))
						{
							bruxa_blood_suck_end_no_jump_actual();
						}
						
						dodge_timer_actual();
							
						thePlayer.BreakAttachment();		

						bruxa_dash();						
					}
				}
			}

			DeactivateThings_BruxaDash();
			
			BruxaDashCallTime = theGame.GetEngineTimeAsSeconds();
		}
	}

	function BruxaDash_NEW()
	{
		if (!thePlayer.IsInHitAnim()
		&& !thePlayer.HasTag('ACS_IsPerformingFinisher')
		&& !thePlayer.HasTag('ACS_IsPerformingCombatDismember')
		&& !thePlayer.IsCrossbowHeld()
		&& ACS_BuffCheck()
		&& !ACS_New_Replacers_Female_Active()
		&& thePlayer.IsActionAllowed(EIAB_Movement)
		)
		{
			DeactivateThings_BruxaDash();

			ACS_ThingsThatShouldBeRemoved_BASE(false); 

			RemoveTimer('ACS_portable_aard'); 

			RemoveTimer('ACS_Dash_Attack_Process'); 

			RemoveTimer('ACS_Vampire_Claws_Sword_Hybrid_Dash');

			if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	

			if( BruxaDashCallTime + DOUBLE_TAP_WINDOW >= theGame.GetEngineTimeAsSeconds() )
			{
				BruxaDashDoubleTap = true;
			}
			else
			{
				BruxaDashDoubleTap = false;	
			}
			
			if( BruxaDashDoubleTap )
			{
				if (ACS_Settings_Main_Bool('acs_bruxa_dash_settings','acs_bruxa_dash', false) 
				&& !theGame.IsFocusModeActive()
				&& theInput.GetActionValue('Focus') == 0
				&& ACS_Settings_Main_Int('acs_bruxa_dash_settings','acs_bruxa_dash_input', 0) == 1
				&& ACS_Settings_Main_Int('acs_bruxa_dash_settings','acs_bruxa_dash_sprint_or_w', 0) == 0
				&& ACS_can_bruxa_dash())
				{
					if ( ACS_Settings_Main_Bool('acs_stamina_settings','acs_stamina_block_action', false) 
					&& StaminaCheck('default')
					&& !thePlayer.HasTag('acs_in_wraith')
					)
					{	
						RemoveTimer('SwordTauntSwitch'); RemoveTimer('SwordTauntRunningSwitch');   if (thePlayer.HasTag('ACS_IsSwordWalking')){thePlayer.RemoveTag('ACS_IsSwordWalking');} if(thePlayer.IsInCombat()){if(thePlayer.GetCombatIdleStance() <= 0.f ){thePlayer.RaiseEvent('ACS_CombatTauntLeft');}else{thePlayer.RaiseEvent('ACS_CombatTauntRight');}} thePlayer.SoundEvent("gui_no_stamina");
					}
					else
					{
						ACS_StaminaDrain(4);

						thePlayer.SetIsCurrentlyDodging(true);

						thePlayer.EnableCharacterCollisions(false); 

						ACS_refresh_bruxa_dash_cooldown();

						WraithModeDeactivate();

						if (!thePlayer.HasTag('ACS_Camo_Active')
						&& !thePlayer.HasTag('ACS_Bruxa_Bite_Process')
						&& !thePlayer.IsEffectActive( 'invisible' )
						)
						{
							thePlayer.PlayEffectSingle( 'bruxa_dash_trails_backup' );
							thePlayer.StopEffect( 'bruxa_dash_trails_backup' );

							thePlayer.DestroyEffect('shadowdash_short');
							thePlayer.PlayEffectSingle( 'shadowdash_short' );
							thePlayer.StopEffect( 'shadowdash_short' );
						}

						if (thePlayer.HasTag('ACS_Bruxa_Bite_Process'))
						{
							bruxa_blood_suck_end_no_jump_actual();
						}
						
						dodge_timer_actual();
							
						thePlayer.BreakAttachment();		

						bruxa_dash();						
					}
				}
			}
			else 
			{	
				if ( thePlayer.HasTag('acs_vampire_claws_equipped') )
				{
					if ( !thePlayer.HasTag('ACS_Camo_Active') && !thePlayer.HasTag('acs_in_wraith') && !thePlayer.HasTag('ACS_Bruxa_Bite_Process') )
					{
						thePlayer.PlayEffectSingle( 'magic_step_l_new' );
						thePlayer.StopEffect( 'magic_step_l_new' );	

						thePlayer.PlayEffectSingle( 'magic_step_r_new' );
						thePlayer.StopEffect( 'magic_step_r_new' );	

						thePlayer.PlayEffectSingle( 'bruxa_dash_trails' );
						thePlayer.StopEffect( 'bruxa_dash_trails' );

						thePlayer.DestroyEffect('shadowdash_short');
						thePlayer.PlayEffectSingle( 'shadowdash_short' );
						thePlayer.StopEffect( 'shadowdash_short' );
					}
				}

				if (ACS_Settings_Main_Bool('acs_bruxa_dash_settings','acs_bruxa_dash', false) 
				&& !theGame.IsFocusModeActive()
				&& theInput.GetActionValue('Focus') == 0
				&& ACS_Settings_Main_Int('acs_bruxa_dash_settings','acs_bruxa_dash_input', 0) == 0
				&& ACS_Settings_Main_Int('acs_bruxa_dash_settings','acs_bruxa_dash_sprint_or_w', 0) == 0
				&& ACS_can_bruxa_dash()
				&& !thePlayer.GetIsRunning()
				&& !thePlayer.GetIsWalking()
				)
				{
					if ( ACS_Settings_Main_Bool('acs_stamina_settings','acs_stamina_block_action', false) 
					&& StaminaCheck('default')
					&& !thePlayer.HasTag('acs_in_wraith')
					)
					{	
						RemoveTimer('SwordTauntSwitch'); RemoveTimer('SwordTauntRunningSwitch');   if (thePlayer.HasTag('ACS_IsSwordWalking')){thePlayer.RemoveTag('ACS_IsSwordWalking');} if(thePlayer.IsInCombat()){if(thePlayer.GetCombatIdleStance() <= 0.f ){thePlayer.RaiseEvent('ACS_CombatTauntLeft');}else{thePlayer.RaiseEvent('ACS_CombatTauntRight');}} thePlayer.SoundEvent("gui_no_stamina");
					}
					else
					{
						ACS_StaminaDrain(4);

						thePlayer.SetIsCurrentlyDodging(true);

						thePlayer.EnableCharacterCollisions(false); 

						ACS_refresh_bruxa_dash_cooldown();

						WraithModeDeactivate();

						if (!thePlayer.HasTag('ACS_Camo_Active')
						&& !thePlayer.HasTag('ACS_Bruxa_Bite_Process')
						&& !thePlayer.IsEffectActive( 'invisible' )
						)
						{
							thePlayer.PlayEffectSingle( 'bruxa_dash_trails_backup' );
							thePlayer.StopEffect( 'bruxa_dash_trails_backup' );

							thePlayer.DestroyEffect('shadowdash_short');
							thePlayer.PlayEffectSingle( 'shadowdash_short' );
							thePlayer.StopEffect( 'shadowdash_short' );
						}

						if (thePlayer.HasTag('ACS_Bruxa_Bite_Process'))
						{
							bruxa_blood_suck_end_no_jump_actual();
						}
						
						dodge_timer_actual();
							
						thePlayer.BreakAttachment();		

						bruxa_dash();						
					}
				}
			}

			DeactivateThings_BruxaDash();
			
			BruxaDashCallTime = theGame.GetEngineTimeAsSeconds();
		}
	}

	function bruxa_dash()
	{
		var dest1, dest2, dest3, dest4		: Vector;

		ACS_Tutorial_Display_Check('ACS_Bruxa_Dash_Tutorial_Shown');

		if (thePlayer.HasTag('ACS_Camo_Active'))
		{
			thePlayer.SoundEvent("monster_bruxa_combat_disappear");
		}

		if (thePlayer.IsSwimming())
		{
			dest1 = theCamera.GetCameraPosition() + theCamera.GetCameraDirection() * ACS_Settings_Main_Int('acs_bruxa_dash_settings','acs_bruxa_dash_combat_distance', 6);
			
			dest2 = theCamera.GetCameraPosition() + theCamera.GetCameraDirection() * ACS_Settings_Main_Int('acs_bruxa_dash_settings','acs_bruxa_dash_combat_distance', 6);
			
			dest3 = theCamera.GetCameraPosition() + theCamera.GetCameraDirection() * ACS_Settings_Main_Int('acs_bruxa_dash_settings','acs_bruxa_dash_normal_distance', 15);
			
			dest4 = theCamera.GetCameraPosition() + theCamera.GetCameraDirection() * ACS_Settings_Main_Int('acs_bruxa_dash_settings','acs_bruxa_dash_normal_distance', 15);
		}
		else
		{
			if ( thePlayer.IsInInterior() )
			{
				dest1 = thePlayer.GetWorldPosition() + (thePlayer.GetWorldRight() * (0-(ACS_Settings_Main_Int('acs_bruxa_dash_settings','acs_bruxa_dash_combat_distance', 6)/4))) + thePlayer.GetHeadingVector() * (ACS_Settings_Main_Int('acs_bruxa_dash_settings','acs_bruxa_dash_combat_distance', 6)/2);
				
				dest2 = thePlayer.GetWorldPosition() + (thePlayer.GetWorldRight() * (ACS_Settings_Main_Int('acs_bruxa_dash_settings','acs_bruxa_dash_combat_distance', 6)/4)) + thePlayer.GetHeadingVector() * (ACS_Settings_Main_Int('acs_bruxa_dash_settings','acs_bruxa_dash_combat_distance', 6)/2);
				
				dest3 = thePlayer.GetWorldPosition() + (thePlayer.GetWorldRight() * (0-(ACS_Settings_Main_Int('acs_bruxa_dash_settings','acs_bruxa_dash_normal_distance', 15)/4))) + thePlayer.GetHeadingVector() * (ACS_Settings_Main_Int('acs_bruxa_dash_settings','acs_bruxa_dash_normal_distance', 15)/2);
				
				dest4 = thePlayer.GetWorldPosition() + (thePlayer.GetWorldRight() * (ACS_Settings_Main_Int('acs_bruxa_dash_settings','acs_bruxa_dash_normal_distance', 15)/4)) + thePlayer.GetHeadingVector() * (ACS_Settings_Main_Int('acs_bruxa_dash_settings','acs_bruxa_dash_normal_distance', 15)/2);

			}
			else
			{
				dest1 = thePlayer.GetWorldPosition() + (thePlayer.GetWorldRight() * (0-(ACS_Settings_Main_Int('acs_bruxa_dash_settings','acs_bruxa_dash_combat_distance', 6)/4))) + thePlayer.GetHeadingVector() * ACS_Settings_Main_Int('acs_bruxa_dash_settings','acs_bruxa_dash_combat_distance', 6);
				
				dest2 = thePlayer.GetWorldPosition() + (thePlayer.GetWorldRight() * (ACS_Settings_Main_Int('acs_bruxa_dash_settings','acs_bruxa_dash_combat_distance', 6)/4)) + thePlayer.GetHeadingVector() * ACS_Settings_Main_Int('acs_bruxa_dash_settings','acs_bruxa_dash_combat_distance', 6);
				
				dest3 = thePlayer.GetWorldPosition() + (thePlayer.GetWorldRight() * (0-(ACS_Settings_Main_Int('acs_bruxa_dash_settings','acs_bruxa_dash_normal_distance', 15)/4))) + thePlayer.GetHeadingVector() * ACS_Settings_Main_Int('acs_bruxa_dash_settings','acs_bruxa_dash_normal_distance', 15);
				
				dest4 = thePlayer.GetWorldPosition() + (thePlayer.GetWorldRight() * (ACS_Settings_Main_Int('acs_bruxa_dash_settings','acs_bruxa_dash_normal_distance', 15)/4)) + thePlayer.GetHeadingVector() * ACS_Settings_Main_Int('acs_bruxa_dash_settings','acs_bruxa_dash_normal_distance', 15);
			}
		}
		
		MovementAdjust('bruxa_dash');
		
		if( actor && ACS_AttitudeCheck ( actor ) && thePlayer.IsInCombat())
		{	
			if ( ACS_Settings_Main_Int('acs_target_settings','acs_target_mode', 0) == 0 || ACS_Settings_Main_Int('acs_target_settings','acs_target_mode', 0) == 1 )
			{
				if (!thePlayer.IsSwimming())
				{
					if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTowards( ticket, actor );}  
				}
				else
				{
					if(thePlayer.HasTag('ACS_Manual_Combat_Control')){thePlayer.RemoveTag('ACS_Manual_Combat_Control');} RemoveTimer('Manual_Combat_Control_Remove');
					if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTo( ticket, VecHeading( theCamera.GetCameraDirection() ) );}
				}
			}
			else if ( ACS_Settings_Main_Int('acs_target_settings','acs_target_mode', 0) == 2 )
			{
				if (thePlayer.IsHardLockEnabled())
				{
					if (!thePlayer.IsSwimming())
					{
						if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTowards( ticket, actor );}  
					}
					else
					{
						if(thePlayer.HasTag('ACS_Manual_Combat_Control')){thePlayer.RemoveTag('ACS_Manual_Combat_Control');} RemoveTimer('Manual_Combat_Control_Remove');
						if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTo( ticket, VecHeading( theCamera.GetCameraDirection() ) );}
					}
				}
				else
				{
					if(thePlayer.HasTag('ACS_Manual_Combat_Control')){thePlayer.RemoveTag('ACS_Manual_Combat_Control');} RemoveTimer('Manual_Combat_Control_Remove');
					if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTo( ticket, VecHeading( theCamera.GetCameraDirection() ) );}
				}
			}
			
			bruxa_dash_index_1 = RandDifferent(this.previous_bruxa_dash_index_1 , 2);

			switch (bruxa_dash_index_1) 
			{				
				case 1:
				movementAdjustor.SlideTo( ticket, ACSFixZAxis(dest1) );
				PlayerPlayAnimation( 'bruxa_run_dash_short_ACS');	
				break;	
						
				default:
				movementAdjustor.SlideTo( ticket, ACSFixZAxis(dest2) );
				PlayerPlayAnimation( 'bruxa_run_dash_right_short_ACS');	
				break;	
			}

			this.previous_bruxa_dash_index_1 = bruxa_dash_index_1;
		}
		else
		{	
			if(thePlayer.HasTag('ACS_Manual_Combat_Control')){thePlayer.RemoveTag('ACS_Manual_Combat_Control');} RemoveTimer('Manual_Combat_Control_Remove');
			
			//if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTo( ticket, VecHeading( theCamera.GetCameraDirection() ) );}
			
					
			bruxa_dash_index_2 = RandDifferent(this.previous_bruxa_dash_index_2 , 2);

			switch (bruxa_dash_index_2) 
			{				
				case 1:
				
				if (thePlayer.IsInCombat())
				{
					movementAdjustor.SlideTo( ticket, ACSFixZAxis(dest1) );
				}
				else
				{
					movementAdjustor.SlideTo( ticket, ACSFixZAxis(dest3) );
				}

				PlayerPlayAnimation( 'bruxa_run_dash_short_ACS');	

				break;	
						
				default:
				
				if (thePlayer.IsInCombat())
				{
					movementAdjustor.SlideTo( ticket, ACSFixZAxis(dest2) );
				}
				else
				{
					movementAdjustor.SlideTo( ticket, ACSFixZAxis(dest4) );
				}

				PlayerPlayAnimation( 'bruxa_run_dash_right_short_ACS');	
				
				break;	
			}

			this.previous_bruxa_dash_index_2 = bruxa_dash_index_2;
		}

		if (thePlayer.IsAnyWeaponHeld()
		&& !thePlayer.IsWeaponHeld('fist')
		)
		{
			GetWitcherPlayer().GetRootAnimatedComponent().PlaySlotAnimationAsync ( 'man_geralt_sword_dodge_jump_rp_f_01', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.875f));	
		}
	}

	// Attack Misc Stuff

	timer function SwordSheatheManagement( dt : float , optional id : int)
	{
		if ( ACS_Settings_Main_Bool('acs_main_settings','acs_mod_enabled', true) ) 
		{ 
			thePlayer.RemoveTag('ACS_IsManagingSword');

			ResetFastWalk();

			if (FactsQuerySum("ACS_TorsoBendActive") > 0)
			{
				if (!fast_sprint_activated)
				{
					thePlayer.RaiseEvent('ACS_TorsoBendReset');
				}
				
				FactsRemove("ACS_TorsoBendActive");
			}

			if ((!ACS_ShouldHideWeaponCheck('steel') 
			&& !ACS_DontReplaceScabbard('steel') 
			&& ACS_Settings_Main_Bool('acs_player_equipment_visual_settings','acs_alternate_scabbard_steel_enabled', false) ))
			{
				SteelSwordScabbardSetVisible(false);
			}
			
			if ((!ACS_ShouldHideWeaponCheck('silver') 
			&& !ACS_DontReplaceScabbard('silver') 
			&& ACS_Settings_Main_Bool('acs_player_equipment_visual_settings','acs_alternate_scabbard_silver_enabled', false) ))
			{
				SilverSwordScabbardSetVisible(false);
			}

			if ((!thePlayer.IsAnyWeaponHeld()
			|| thePlayer.IsWeaponHeld('fist'))
			)
			{
				if (thePlayer.IsEffectActive('bat_circle', false))
				{
					thePlayer.StopEffect('bat_circle');
				}

				if (
				FactsQuerySum("ACS_Azkar_Active") > 0
				|| FactsQuerySum("ACS_Slayer_Active") > 0
				|| ACS_CloakEquippedCheck()
				|| ACS_Settings_Main_Bool('acs_player_equipment_visual_settings','acs_hide_sword_sheathes', false)
				|| FactsQuerySum("ACS_Cloak_Equipped") > 0
				|| FactsQuerySum("ACS_In_Meditation") > 0 
				)
				{
					SteelSwordScabbardSetVisible(false);
					
					SteelSwordHide(true);

					SilverSwordScabbardSetVisible(false);

					SilverSwordHide(true);
				}
			}

			if ((!thePlayer.IsAnyWeaponHeld()
			|| thePlayer.IsWeaponHeld('fist'))
			&& !thePlayer.HasTag('acs_vampire_claws_equipped')
			)
			{
				ACS_WeaponHolsterInit();

				VampireClawsHybridLHandDestroy();

				RemoveTimer('SwordWalkLongWeaponSwitch'); 

				RemoveTimer('SwordWalkSwitch'); 

				thePlayer.RaiseEvent('ACS_SwordWalkAdditiveEnd');thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');RemoveTimer('CombatTauntDelay');
				
				//thePlayer.RaiseEvent('ACS_SwordTauntEnd');

				thePlayer.RaiseEvent('ACS_ForceHandClosedREnd');

				if (!thePlayer.HasTag('ACS_Dual_Wield_Active') && !ACSGetCEntity('ACS_Viper_Dagger_L')){thePlayer.RaiseEvent('ACS_ForceHandClosedLEnd');}
			}
			else
			{
				//RemoveTimer('SwordTauntRunningSwitch'); 
				//AddTimer('SwordTauntRunningSwitch', 0.01   , false); 

				if ( 
				(ACS_GetWeaponMode() == 3
				&& (ACS_GetItem_VampClaw('normal') 
				|| ACS_GetItem_VampClaw('shades')))
				&& !thePlayer.IsWeaponHeld('fist')
				&& !thePlayer.HasTag('acs_vampire_claws_equipped')
				&& !thePlayer.HasTag('acs_aard_sword_equipped') 
				&& !thePlayer.HasTag('acs_aard_secondary_sword_equipped') 
				&& !thePlayer.HasTag('acs_quen_sword_equipped') 
				&& !thePlayer.HasTag('acs_quen_secondary_sword_equipped') 
				&& !thePlayer.HasTag('acs_yrden_sword_equipped') 
				&& !thePlayer.HasTag('acs_yrden_secondary_sword_equipped') 
				&& !thePlayer.HasTag('acs_axii_sword_equipped') 
				&& !thePlayer.HasTag('acs_axii_secondary_sword_equipped') 
				&& !thePlayer.HasTag('acs_sorc_fists_equipped')
				)
				{
					VampireClawsHybridLHand();

					//thePlayer.RaiseEvent('ACS_ForceHandClosedRBackhand');
					
					thePlayer.RaiseEvent('ACS_ForceHandVampireClawsL');
				}

				if (!thePlayer.HasTag('ACS_HideWeaponOnDodge')
				&& !thePlayer.HasTag('acs_in_wraith')
				&& !thePlayer.HasTag('ACS_Bruxa_Bite_Process')
				&& !ACSGetCEntity('ACS_Armor_Ether_Sword')
				)
				{
					ACSSwordUpdateEnhancements('default_sword');
				}
			}
		}
	}

	function VampireClawsHybridLHand()
	{
		var anchor_temp, blade_temp											: CEntityTemplate;
		
		var 

		r_anchor1, 
		r_anchor2,
		r_anchor3,
		r_anchor4,
		r_anchor5,

		l_anchor1, 
		l_anchor2,
		l_anchor3,
		l_anchor4,
		l_anchor5,

		r_blade1, 
		r_blade2,
		r_blade3,
		r_blade4,
		r_blade5,

		l_blade1,
		l_blade2,
		l_blade3,
		l_blade4,
		l_blade5	

		: CEntity;

		var bone_vec, attach_vec											: Vector;
		var bone_rot, attach_rot											: EulerAngles;

		var morphManager : CMorphedMeshManagerComponent;

		if(
		ACSGetCEntity('ACS_Vamp_Claws_Hybrid_L1_Anchor')

		&& ACSGetCEntity('ACS_Vamp_Claws_Hybrid_L2_Anchor')

		&& ACSGetCEntity('ACS_Vamp_Claws_Hybrid_L3_Anchor')

		&& ACSGetCEntity('ACS_Vamp_Claws_Hybrid_L4_Anchor')

		&& ACSGetCEntity('ACS_Vamp_Claws_Hybrid_L5_Anchor')

		&& ACSGetCEntity('ACS_Vamp_Claws_Hybrid_L1')

		&& ACSGetCEntity('ACS_Vamp_Claws_Hybrid_L2')
		
		&& ACSGetCEntity('ACS_Vamp_Claws_Hybrid_L3')

		&& ACSGetCEntity('ACS_Vamp_Claws_Hybrid_L4')
		
		&& ACSGetCEntity('ACS_Vamp_Claws_Hybrid_L5'))
		{
			return;
		}

		anchor_temp = (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\entities\other\fx_ent.w2ent", true );

		blade_temp = (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\models\vamp_claws\blood\vamp_claws_singular_morph_bone.w2ent", true );

		//////////////////////////////////////////////////////////////////////////////////////////////////////////////////

		thePlayer.GetBoneWorldPositionAndRotationByIndex( thePlayer.GetBoneIndex( 'l_thumb3' ), bone_vec, bone_rot );
		l_anchor1 = (CEntity)theGame.CreateEntity( anchor_temp, thePlayer.GetWorldPosition() );
		l_anchor1.CreateAttachmentAtBoneWS( GetWitcherPlayer(), 'l_thumb3', bone_vec, bone_rot );
		l_anchor1.AddTag('ACS_Vamp_Claws_Hybrid_L1_Anchor');

		thePlayer.GetBoneWorldPositionAndRotationByIndex( thePlayer.GetBoneIndex( 'l_index3' ), bone_vec, bone_rot );
		l_anchor2 = (CEntity)theGame.CreateEntity( anchor_temp, thePlayer.GetWorldPosition() );
		l_anchor2.CreateAttachmentAtBoneWS( GetWitcherPlayer(), 'l_index3', bone_vec, bone_rot );
		l_anchor2.AddTag('ACS_Vamp_Claws_Hybrid_L2_Anchor');

		thePlayer.GetBoneWorldPositionAndRotationByIndex( thePlayer.GetBoneIndex( 'l_middle3' ), bone_vec, bone_rot );
		l_anchor3 = (CEntity)theGame.CreateEntity( anchor_temp, thePlayer.GetWorldPosition() );
		l_anchor3.CreateAttachmentAtBoneWS( GetWitcherPlayer(), 'l_middle3', bone_vec, bone_rot );
		l_anchor3.AddTag('ACS_Vamp_Claws_Hybrid_L3_Anchor');

		thePlayer.GetBoneWorldPositionAndRotationByIndex( thePlayer.GetBoneIndex( 'l_ring3' ), bone_vec, bone_rot );
		l_anchor4 = (CEntity)theGame.CreateEntity( anchor_temp, thePlayer.GetWorldPosition() );
		l_anchor4.CreateAttachmentAtBoneWS( GetWitcherPlayer(), 'l_ring3', bone_vec, bone_rot );
		l_anchor4.AddTag('ACS_Vamp_Claws_Hybrid_L4_Anchor');

		thePlayer.GetBoneWorldPositionAndRotationByIndex( thePlayer.GetBoneIndex( 'l_pinky3' ), bone_vec, bone_rot );
		l_anchor5 = (CEntity)theGame.CreateEntity( anchor_temp, thePlayer.GetWorldPosition() );
		l_anchor5.CreateAttachmentAtBoneWS( GetWitcherPlayer(), 'l_pinky3', bone_vec, bone_rot );
		l_anchor5.AddTag('ACS_Vamp_Claws_Hybrid_L5_Anchor');

		//////////////////////////////////////////////////////////////////////////////////////////////////////////////////

		l_blade1 = (CEntity)theGame.CreateEntity( blade_temp, thePlayer.GetWorldPosition() + Vector( 0, 0, -20 ) );
		l_blade2 = (CEntity)theGame.CreateEntity( blade_temp, thePlayer.GetWorldPosition() + Vector( 0, 0, -20 ) );
		l_blade3 = (CEntity)theGame.CreateEntity( blade_temp, thePlayer.GetWorldPosition() + Vector( 0, 0, -20 ) );
		l_blade4 = (CEntity)theGame.CreateEntity( blade_temp, thePlayer.GetWorldPosition() + Vector( 0, 0, -20 ) );
		l_blade5 = (CEntity)theGame.CreateEntity( blade_temp, thePlayer.GetWorldPosition() + Vector( 0, 0, -20 ) );

		l_blade1.AddTag('ACS_Vamp_Claws_Hybrid_L1');
		l_blade2.AddTag('ACS_Vamp_Claws_Hybrid_L2');
		l_blade3.AddTag('ACS_Vamp_Claws_Hybrid_L3');
		l_blade4.AddTag('ACS_Vamp_Claws_Hybrid_L4');
		l_blade5.AddTag('ACS_Vamp_Claws_Hybrid_L5');

		//////////////////////////////////////////////////////////////////////////////////////////////////////////////////

		attach_rot.Roll = 90;
		attach_rot.Pitch = -90;
		attach_rot.Yaw = 0;
		attach_vec.X = -0.0825;
		attach_vec.Y = 0.00625;
		attach_vec.Z = 0.0;

		l_blade1.CreateAttachment( l_anchor1, , attach_vec, attach_rot );

		//////////////////////////////////////////////////////////////////////////////////////////////////////////////////

		l_blade2.CreateAttachment( l_anchor2, , attach_vec, attach_rot );

		//////////////////////////////////////////////////////////////////////////////////////////////////////////////////

		l_blade3.CreateAttachment( l_anchor3, , attach_vec, attach_rot );

		//////////////////////////////////////////////////////////////////////////////////////////////////////////////////

		l_blade4.CreateAttachment( l_anchor4, , attach_vec, attach_rot );

		//////////////////////////////////////////////////////////////////////////////////////////////////////////////////

		l_blade5.CreateAttachment( l_anchor5, , attach_vec, attach_rot );


		//////////////////////////////////////////////////////////////////////////////////////////////////////////////////

		morphManager = (CMorphedMeshManagerComponent) l_blade1.GetComponentByClassName('CMorphedMeshManagerComponent');
		morphManager.SetMorphBlend( 1, 1 );

		morphManager = (CMorphedMeshManagerComponent) l_blade2.GetComponentByClassName('CMorphedMeshManagerComponent');
		morphManager.SetMorphBlend( 1, 1 );

		morphManager = (CMorphedMeshManagerComponent) l_blade3.GetComponentByClassName('CMorphedMeshManagerComponent');
		morphManager.SetMorphBlend( 1, 1 );

		morphManager = (CMorphedMeshManagerComponent) l_blade4.GetComponentByClassName('CMorphedMeshManagerComponent');
		morphManager.SetMorphBlend( 1, 1 );

		morphManager = (CMorphedMeshManagerComponent) l_blade5.GetComponentByClassName('CMorphedMeshManagerComponent');
		morphManager.SetMorphBlend( 1, 1 );
	}


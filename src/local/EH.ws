	var dist															: float;
	var animatedComponentPlayer											: CAnimatedComponent;
	var evadeTargetRot													: EulerAngles;
	var interiorCameraDesiredPositionMult 								: float;
	default interiorCameraDesiredPositionMult 							= 10.f;

	event OnEnterState( prevStateName : name )
	{
		//thePlayer.EnableManualCameraControl( false, 'ACS_Feainnewedd_Dance' );

		ACS_Feainnewedd_Dance_Start();

		super.OnEnterState(prevStateName);
	}
	
	private entry function ACS_Feainnewedd_Dance_Start()
	{
		parent.LockEntryFunction(true);

		thePlayer.BlockAllActions( 'ACS_Feainnewedd_Dance', true );

		GetWitcherPlayer().DrainFocus( GetWitcherPlayer().GetStatMax( BCS_Focus ) * 0.33 );

		animatedComponentPlayer = (CAnimatedComponent)(thePlayer).GetComponentByClassName( 'CAnimatedComponent' );	

		movementAdjustorPlayer = GetWitcherPlayer().GetMovingAgentComponent().GetMovementAdjustor();

		playerPos = TraceFloor(thePlayer.GetWorldPosition());

		thePlayer.SetImmortalityMode( AIM_Invulnerable, AIC_Default, true ); 
		thePlayer.SetCanPlayHitAnim(false); 
		thePlayer.AddBuffImmunity_AllNegative('acs_dodge', true); 
		thePlayer.SetIsCurrentlyDodging(true);
		if (!thePlayer.IsUsingHorse()&& !thePlayer.IsUsingVehicle()){thePlayer.EnableCharacterCollisions(true); }	

		Sleep(0.1);

		thePlayer.AddTag('ACS_Feainnewedd_Dance');

		thePlayer.AddTag('ACS_In_Combat_Art');

		thePlayer.EnableCollisions(false);

		GetACSWatcher().RemoveTimer('SwordTauntSwitch'); 
		GetACSWatcher().RemoveTimer('SwordTauntRunningSwitch'); 
		 
		thePlayer.RaiseEvent('ACS_SwordTauntEnd');
		thePlayer.RaiseEvent('ACS_CombatTauntEnd'); 
		
		GetACSWatcher().RemoveTimer('CombatTauntDelay');
		GetACSWatcher().RemoveTimer('SwordTauntRunningSwitchSecondary'); 
		GetACSWatcher().RemoveTimer('SwordTauntRunningSwitchSecondaryWeaponBlood'); 


		(thePlayer.GetMovingAgentComponent()).SetEnabledFeetIK(false,0);
		(thePlayer.GetMovingAgentComponent()).SetEnabledSlidingOnSlopeIK( false );

		//thePlayer.RaiseEvent('ACS_ForceLegsFloatIdle');

		thePlayer.SetImmortalityMode( AIM_Invulnerable, AIC_Default, true ); 
		thePlayer.SetCanPlayHitAnim(false); 
		thePlayer.AddBuffImmunity_AllNegative('acs_dodge', true); 
		thePlayer.SetIsCurrentlyDodging(true);
		thePlayer.EnableCharacterCollisions(false);	

		movementAdjustorPlayer.CancelAll();
		ticketPlayer = movementAdjustorPlayer.CreateNewRequest( 'ACSMovAdj' );
		movementAdjustorPlayer.MaxRotationAdjustmentSpeed( ticketPlayer, 500000 );
		movementAdjustorPlayer.MaxLocationAdjustmentSpeed( ticketPlayer, 500000 );
		movementAdjustorPlayer.AdjustLocationVertically( ticketPlayer, true );
		movementAdjustorPlayer.ScaleAnimationLocationVertically( ticketPlayer, true );
		movementAdjustorPlayer.AdjustmentDuration( ticketPlayer, 0.1 );
		movementAdjustorPlayer.Continuous(ticketPlayer);

		movementAdjustorPlayer.RotateTo(ticketPlayer, VecHeading(theCamera.GetCameraDirection()));

		movementAdjustorPlayer.SlideTo(ticketPlayer, playerPos + thePlayer.GetWorldUp() * 1);

		thePlayer.PlayEffectSingle('acs_fast_sprint_trail');
		thePlayer.StopEffect('acs_fast_sprint_trail');

		thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( 'man_geralt_feainnewedd_dance_01_ACS', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0.125f, 0.125f) );

		markerNPC_1 = theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync( 

		"dlc\dlc_acs\data\fx\sword_slash_circular\acs_sword_slash_circular.w2ent"

			, true ), (thePlayer.GetWorldPosition() + thePlayer.GetWorldForward() * 2) + (Vector(0,0,2.5)), thePlayer.GetWorldRotation() );

		markerNPC_1.AddTag('ACS_Sword_Slash_Circular_Singular');

		markerNPC_1.AddTag('ACS_Sword_Slash_Feainnewedd_Dance');

		markerNPC_1.AddTag('ACS_Sword_Slash_Circular_Deal_Damage');

		thePlayer.StopEffect('jump_ground_fx1');
		thePlayer.PlayEffect('jump_ground_fx1');

		thePlayer.StopEffect('special_attack_break');

		thePlayer.PlayEffectSingle('special_attack_break');

		thePlayer.StopEffect('special_attack_break');

		Sleep(0.34);

		movementAdjustorPlayer.CancelAll();
		ticketPlayer = movementAdjustorPlayer.CreateNewRequest( 'ACSMovAdj' );
		movementAdjustorPlayer.MaxRotationAdjustmentSpeed( ticketPlayer, 500000 );
		movementAdjustorPlayer.MaxLocationAdjustmentSpeed( ticketPlayer, 500000 );
		movementAdjustorPlayer.AdjustLocationVertically( ticketPlayer, true );
		movementAdjustorPlayer.ScaleAnimationLocationVertically( ticketPlayer, true );
		movementAdjustorPlayer.AdjustmentDuration( ticketPlayer, 0.1 );
		movementAdjustorPlayer.Continuous(ticketPlayer);

		movementAdjustorPlayer.RotateTo(ticketPlayer, VecHeading(theCamera.GetCameraDirection()));

		movementAdjustorPlayer.SlideTo(ticketPlayer, playerPos + thePlayer.GetWorldUp() * 2);

		//GetACSWatcher().PlayerPlayAnimation( 'man_geralt_sword_approach_attack_1');

		thePlayer.PlayEffectSingle('acs_fast_sprint_trail');
		thePlayer.StopEffect('acs_fast_sprint_trail');

		markerNPC_2 = theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync( 

		"dlc\dlc_acs\data\fx\sword_slash_circular\acs_sword_slash_circular.w2ent"

			, true ), (thePlayer.GetWorldPosition() + thePlayer.GetWorldForward() * 2) + (Vector(0,0,2.5)), thePlayer.GetWorldRotation() );

		markerNPC_2.AddTag('ACS_Sword_Slash_Circular_Singular');

		markerNPC_2.AddTag('ACS_Sword_Slash_Feainnewedd_Dance');

		markerNPC_2.AddTag('ACS_Sword_Slash_Circular_Deal_Damage');

		thePlayer.StopEffect('special_attack_break');

		thePlayer.PlayEffectSingle('special_attack_break');

		thePlayer.StopEffect('special_attack_break');
		
		Sleep ( 0.4 );

		movementAdjustorPlayer.CancelAll();
		ticketPlayer = movementAdjustorPlayer.CreateNewRequest( 'ACSMovAdj' );
		movementAdjustorPlayer.MaxRotationAdjustmentSpeed( ticketPlayer, 500000 );
		movementAdjustorPlayer.MaxLocationAdjustmentSpeed( ticketPlayer, 500000 );
		movementAdjustorPlayer.AdjustLocationVertically( ticketPlayer, true );
		movementAdjustorPlayer.ScaleAnimationLocationVertically( ticketPlayer, true );
		movementAdjustorPlayer.AdjustmentDuration( ticketPlayer, 0.1 );
		movementAdjustorPlayer.Continuous(ticketPlayer);

		movementAdjustorPlayer.RotateTo(ticketPlayer, VecHeading(theCamera.GetCameraDirection()));

		movementAdjustorPlayer.SlideTo(ticketPlayer, playerPos + thePlayer.GetWorldUp() * 3);

		thePlayer.PlayEffectSingle('acs_fast_sprint_trail');
		thePlayer.StopEffect('acs_fast_sprint_trail');

		thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( 'man_geralt_feainnewedd_dance_02_ACS', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0.125f, 0.5f) );

		markerNPC_3 = theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync( 

		"dlc\dlc_acs\data\fx\sword_slash_circular\acs_sword_slash_circular.w2ent"

			, true ), (thePlayer.GetWorldPosition() + thePlayer.GetWorldForward() * 2) + (Vector(0,0,2.5)), thePlayer.GetWorldRotation() );

		markerNPC_3.AddTag('ACS_Sword_Slash_Circular_Singular');

		markerNPC_3.AddTag('ACS_Sword_Slash_Feainnewedd_Dance');

		markerNPC_3.AddTag('ACS_Sword_Slash_Circular_Deal_Damage');

		thePlayer.StopEffect('special_attack_break');

		thePlayer.PlayEffectSingle('special_attack_break');

		thePlayer.StopEffect('special_attack_break');

		Sleep ( 1 );

		if (thePlayer.GetPlayerCombatStance() != PCS_AlertNear)
		{
			thePlayer.SetPlayerCombatStance(PCS_AlertNear, true);
			thePlayer.SetPlayerCombatStance(PCS_AlertNear, true);
			thePlayer.SetPlayerCombatStance(PCS_AlertNear, true);
		}

		(thePlayer.GetMovingAgentComponent()).SetEnabledFeetIK(true,0);

		movementAdjustorPlayer.CancelAll();

		thePlayer.EnableCollisions(true);

		thePlayer.RemoveTag('ACS_In_Combat_Art');

		thePlayer.RemoveTag('ACS_Feainnewedd_Dance');

		thePlayer.BlockAllActions( 'ACS_Feainnewedd_Dance', false );

		thePlayer.SetImmortalityMode( AIM_None, AIC_Default, true ); 
		thePlayer.SetCanPlayHitAnim(true); 
		if (!thePlayer.IsUsingHorse()&& !thePlayer.IsUsingVehicle()){thePlayer.EnableCharacterCollisions(true); }	
		thePlayer.RemoveBuffImmunity_AllNegative('acs_dodge'); 
		thePlayer.SetIsCurrentlyDodging(false);

		parent.LockEntryFunction(false);

		parent.GotoState('ACS_ORTHANC');
	}
	
	event OnLeaveState( nextStateName : name )
	{
		super.OnLeaveState(nextStateName);
	}	
}

state ACS_Flip_Evade in W3ACSWatcherSecondary 
{
	var camera 															: CCustomCamera;
	var init_pos														: Vector;
	var dest_pos														: Vector;
	var evadeTarget														: CActor;
	var pos, newPos														: Vector;
	var markerNPC_1														: CEntity;
	var markerTemplate_1 												: CEntityTemplate;
	var movementAdjustorPlayer, movementAdjustorTarget					: CMovementAdjustor;
	var ticketPlayer, ticketTarget										: SMovementAdjustmentRequestTicket;
	var paramsFlip														: SCustomEffectParams;
	var dist															: float;
	var animatedComponentPlayer											: CAnimatedComponent;
	var evadeTargetRot													: EulerAngles;
	var bonePosition, attach_vec										: Vector;
	var boneRotation, attach_rot										: EulerAngles;
	var interiorCameraDesiredPositionMult 								: float;
	default interiorCameraDesiredPositionMult 							= 10.f;


	event OnEnterState( prevStateName : name )
	{
		init_pos = thePlayer.GetWorldPosition();

		//thePlayer.EnableManualCameraControl( false, 'ACS_Flip_Evade' );

		ACS_Flip_Evade_Start();

		super.OnEnterState(prevStateName);
	}
	
	private entry function ACS_Flip_Evade_Start()
	{
		parent.LockEntryFunction(true);

		thePlayer.DrainStamina( ESAT_FixedValue,  thePlayer.GetStatMax( BCS_Stamina ) * 0.125, 2 );

		if (((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'wood_hollow'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'wood_debris'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'dirt_hard'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'dirt_soil'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'hay'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'stone_debris'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'stone_solid'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'clay_tile'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'gravel_large'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'gravel_small'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'sand'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'water_shallow'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'water_deep'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'grass_short'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'grass_long'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'carpet'
		)
		{

			thePlayer.StopEffect('jump_ground_fx1');
			thePlayer.PlayEffect('jump_ground_fx1');

			if (((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'dirt_hard'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'dirt_soil'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'hay'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'stone_debris'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'clay_tile'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'gravel_large'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'gravel_small'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'sand'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'grass_short'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'grass_long'
			)
			{
				//thePlayer.StopEffect('covered_dirt_ACS');
				//thePlayer.PlayEffect('covered_dirt_ACS');

				if( GetRainStrength() > 0 
				&& !thePlayer.IsInInterior()
				&& !GetACSWatcher().RoofCheck()
				) 
				{

				}
				else if (ACS_Settings_Main_Bool('acs_player_misc_settings','acs_dirt_vfx_enabled', true))
				{
					switch(GetACSWatcher().dirt_counter)
					{
						case 5:
							
							thePlayer.StopEffect('covered_dirt_small_ACS');
							thePlayer.PlayEffect('covered_dirt_small_ACS');
							
							GetACSWatcher().ManageDirtCounter(false);
						break;

						case 4:

							GetACSWatcher().ManageDirtCounter(true);
						break;

						case 3:

							thePlayer.StopEffect('covered_dirt_big_ACS');
							thePlayer.PlayEffect('covered_dirt_big_ACS');

							GetACSWatcher().ManageDirtCounter(true);
						break;

						case 2:

							GetACSWatcher().ManageDirtCounter(true);
						break;

						case 1:

							GetACSWatcher().ManageDirtCounter(true);
							
						break;

						default:
							GetACSWatcher().ManageDirtCounter(true);

						break;
					}
				}
			}
		}
		

		thePlayer.PlayEffectSingle('acs_fast_sprint_trail');
		thePlayer.StopEffect('acs_fast_sprint_trail');

		thePlayer.RaiseEvent('ACS_TW1AnimsReset');

		if (thePlayer.GetPlayerCombatStance() != PCS_Normal)
		{
			thePlayer.SetPlayerCombatStance(PCS_Normal, true);
		}

		//GetACSWatcher().PlayerPlayAnimation( 'tw1_jump_flip_f_ACS');

		if (RandF() < 0.5)
		{
			thePlayer.RaiseEvent('ACS_FlipKick02');
		}
		else
		{
			thePlayer.RaiseEvent('ACS_FrontTwistFlip');
		}
		
		evadeTarget = ACSGetCActor('ACS_Flip_Target');

		animatedComponentPlayer = (CAnimatedComponent)(thePlayer).GetComponentByClassName( 'CAnimatedComponent' );	

		movementAdjustorPlayer = GetWitcherPlayer().GetMovingAgentComponent().GetMovementAdjustor();

		movementAdjustorTarget = evadeTarget.GetMovingAgentComponent().GetMovementAdjustor();

		evadeTargetRot = thePlayer.GetWorldRotation();

		//evadeTargetRot.Yaw -= 180;

		dist = (((CMovingPhysicalAgentComponent)evadeTarget.GetMovingAgentComponent()).GetCapsuleRadius() 
				+ ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent()).GetCapsuleRadius()) * 1.125f;

		thePlayer.SetImmortalityMode( AIM_Invulnerable, AIC_Default, true ); 
		thePlayer.SetCanPlayHitAnim(false); 
		thePlayer.AddBuffImmunity_AllNegative('acs_dodge', true); 
		thePlayer.SetIsCurrentlyDodging(true);
		if (!thePlayer.IsUsingHorse()&& !thePlayer.IsUsingVehicle()){thePlayer.EnableCharacterCollisions(true); }	

		movementAdjustorPlayer.CancelAll();
		ticketPlayer = movementAdjustorPlayer.CreateNewRequest( 'ACSMovAdj' );
		movementAdjustorPlayer.MaxRotationAdjustmentSpeed( ticketPlayer, 5000 );
		movementAdjustorPlayer.MaxLocationAdjustmentSpeed( ticketPlayer, 5000 );
		movementAdjustorPlayer.AdjustLocationVertically( ticketPlayer, true );
		movementAdjustorPlayer.ScaleAnimationLocationVertically( ticketPlayer, true );

		movementAdjustorPlayer.AdjustmentDuration( ticketPlayer, 0.1 );

		movementAdjustorPlayer.RotateTowards(ticketPlayer, evadeTarget);

		Sleep(0.1);

		thePlayer.SetImmortalityMode( AIM_Invulnerable, AIC_Default, true ); 
		thePlayer.SetCanPlayHitAnim(false); 
		thePlayer.AddBuffImmunity_AllNegative('acs_dodge', true); 
		thePlayer.SetIsCurrentlyDodging(true);
		thePlayer.EnableCharacterCollisions(false);	

		movementAdjustorTarget.CancelAll();

		//ticketTarget = movementAdjustorTarget.CreateNewRequest( 'ACS_Flip' );
		//movementAdjustorTarget.MaxRotationAdjustmentSpeed( ticketTarget, 500000 );
		//movementAdjustorTarget.MaxLocationAdjustmentSpeed( ticketTarget, 500000 );
		//movementAdjustorTarget.AdjustmentDuration( ticketTarget, 0.1f );
		//movementAdjustorTarget.Continuous(ticketTarget);

		//movementAdjustorPlayer.RotateTowards(ticketTarget, thePlayer);

		movementAdjustorPlayer.CancelAll();
		ticketPlayer = movementAdjustorPlayer.CreateNewRequest( 'ACSMovAdj' );
		movementAdjustorPlayer.MaxRotationAdjustmentSpeed( ticketPlayer, 500000 );
		movementAdjustorPlayer.MaxLocationAdjustmentSpeed( ticketPlayer, 500000 );
		movementAdjustorPlayer.AdjustLocationVertically( ticketPlayer, true );
		movementAdjustorPlayer.ScaleAnimationLocationVertically( ticketPlayer, true );
		movementAdjustorPlayer.AdjustmentDuration( ticketPlayer, 0.5f );
		//movementAdjustorPlayer.Continuous(ticketPlayer);

		//movementAdjustorPlayer.RotateTowards(ticketPlayer, evadeTarget);

		//movementAdjustorPlayer.RotateTo(ticketPlayer, VecHeading(evadeTarget.GetWorldPosition() + evadeTarget.GetWorldForward() * -10));

		//movementAdjustorPlayer.SlideTo(ticketPlayer, (evadeTarget.GetWorldPosition() + evadeTarget.GetWorldForward() * 0.5) + Vector(0,0,1.25f));

		if ( evadeTarget.GetBoneIndex('head') != -1 )
		{
			evadeTarget.GetBoneWorldPositionAndRotationByIndex( evadeTarget.GetBoneIndex( 'head' ), bonePosition, boneRotation );

			movementAdjustorPlayer.SlideTo(ticketPlayer, thePlayer.GetNearestPointInBothPersonalSpaces(bonePosition + Vector(0,0,2.125)));
		}
		else
		{
			if ( evadeTarget.GetBoneIndex('k_head_g') != -1 )
			{
				evadeTarget.GetBoneWorldPositionAndRotationByIndex( evadeTarget.GetBoneIndex( 'k_head_g' ), bonePosition, boneRotation );

				movementAdjustorPlayer.SlideTo(ticketPlayer, thePlayer.GetNearestPointInBothPersonalSpaces(bonePosition + Vector(0,0,2.125)));
			}
			else
			{
				movementAdjustorPlayer.SlideTo(ticketPlayer, thePlayer.GetNearestPointInBothPersonalSpaces(evadeTarget.GetWorldPosition()) + Vector(0,0,2.125f));
			}
		}

		if (RandF() < 0.5)
		{
			//thePlayer.RaiseEvent('ACS_FlipKick02');
		}
		else
		{
			//thePlayer.RaiseEvent('ACS_FrontTwistFlip');
		}

		if (thePlayer.IsAnyWeaponHeld()
		&& !thePlayer.IsWeaponHeld('fist')
		)
		{
			thePlayer.RaiseEvent('ACS_CombatExtraSwordAttackApproach');
			//thePlayer.RaiseEvent('ACS_CombatExtraAerialStrike');

			if (!GetACSWatcher().combatExtraActive)
			{
				GetACSWatcher().SetCombatExtraStatus(true);
			}

			GetACSWatcher().RemoveTimer('combatExtraReset');
			GetACSWatcher().AddTimer('combatExtraReset', 1.625   , false);
		}

		Sleep(0.125);

		if (thePlayer.GetPlayerCombatStance() != PCS_Normal)
		{
			thePlayer.SetPlayerCombatStance(PCS_Normal, true);
		}

		markerTemplate_1 = (CEntityTemplate)LoadResourceAsync( 
							
		"dlc\dlc_acs\data\fx\blood_fx.w2ent"

		, true );

		if ( evadeTarget.GetBoneIndex('head') != -1 )
		{
			evadeTarget.GetBoneWorldPositionAndRotationByIndex( evadeTarget.GetBoneIndex( 'head' ), bonePosition, boneRotation );

			markerNPC_1 = (CEntity)theGame.CreateEntity( markerTemplate_1, bonePosition + Vector(0,0,1.75) );
		}
		else
		{
			if ( evadeTarget.GetBoneIndex('k_head_g') != -1 )
			{
				evadeTarget.GetBoneWorldPositionAndRotationByIndex( evadeTarget.GetBoneIndex( 'k_head_g' ), bonePosition, boneRotation );
				markerNPC_1 = (CEntity)theGame.CreateEntity( markerTemplate_1, bonePosition + Vector(0,0,1.75) );
			}
			else
			{
				if (((CMovingPhysicalAgentComponent)(evadeTarget.GetMovingAgentComponent())).GetCapsuleHeight() > 2.25
				|| evadeTarget.GetRadius() > 0.7
				)
				{
					markerNPC_1 = (CEntity)theGame.CreateEntity( markerTemplate_1, evadeTarget.GetWorldPosition() + Vector(0,0,3.75f) );
				}
				else
				{
					markerNPC_1 = (CEntity)theGame.CreateEntity( markerTemplate_1, evadeTarget.GetWorldPosition() + Vector(0,0,2.25f) );
				}
			}
		}

		markerNPC_1.PlayEffectSingle('fist_hit_indicator');
		markerNPC_1.PlayEffectSingle('hit_refraction_red');
		markerNPC_1.DestroyAfter(1.5);

		thePlayer.EnableCharacterCollisions(false);	

		movementAdjustorTarget.CancelAll();

		//thePlayer.BreakAttachment();

		//thePlayer.CreateAttachment(markerNPC_1, , Vector(0,0,0), markerNPC_1.GetWorldRotation());

		movementAdjustorPlayer.CancelAll();
		ticketPlayer = movementAdjustorPlayer.CreateNewRequest( 'ACSMovAdj' );
		movementAdjustorPlayer.MaxRotationAdjustmentSpeed( ticketPlayer, 500000 );
		movementAdjustorPlayer.MaxLocationAdjustmentSpeed( ticketPlayer, 500000 );
		movementAdjustorPlayer.AdjustLocationVertically( ticketPlayer, true );
		movementAdjustorPlayer.ScaleAnimationLocationVertically( ticketPlayer, true );
		movementAdjustorPlayer.AdjustmentDuration( ticketPlayer, 0.25f );
		//movementAdjustorPlayer.Continuous(ticketPlayer);

		movementAdjustorPlayer.SlideTo(ticketPlayer, markerNPC_1.GetWorldPosition());

		//movementAdjustorPlayer.RotateTo(ticketPlayer, VecHeading(evadeTarget.GetWorldPosition() + evadeTarget.GetWorldForward() * -10));
		
		evadeTarget.SoundEvent("scene_cmb_fist_hit");
			
		paramsFlip.effectType = EET_Stagger;
		paramsFlip.creator = thePlayer;
		paramsFlip.sourceName = "ACS_Flip";
		paramsFlip.duration = 1;

		evadeTarget.AddEffectCustom( paramsFlip );	

		if (thePlayer.GetPlayerCombatStance() != PCS_Normal)
		{
			thePlayer.SetPlayerCombatStance(PCS_Normal, true);
		}

		Sleep ( 0.1875 );

		if (thePlayer.GetPlayerCombatStance() != PCS_Normal)
		{
			thePlayer.SetPlayerCombatStance(PCS_Normal, true);
		}

		thePlayer.BreakAttachment();

		movementAdjustorPlayer.CancelAll();
		ticketPlayer = movementAdjustorPlayer.CreateNewRequest( 'ACSMovAdj' );
		movementAdjustorPlayer.MaxRotationAdjustmentSpeed( ticketPlayer, 5000 );
		movementAdjustorPlayer.MaxLocationAdjustmentSpeed( ticketPlayer, 5000 );
		movementAdjustorPlayer.AdjustLocationVertically( ticketPlayer, true );
		movementAdjustorPlayer.ScaleAnimationLocationVertically( ticketPlayer, true );

		movementAdjustorPlayer.AdjustmentDuration( ticketPlayer, 0.25f );

		//movementAdjustorPlayer.RotateTo(ticketPlayer, VecHeading(thePlayer.GetWorldPosition() + thePlayer.GetWorldForward()));

		//movementAdjustorPlayer.SlideTo( ticketPlayer, TraceFloor(thePlayer.GetWorldPosition() + thePlayer.GetWorldForward() * 3) );

		movementAdjustorPlayer.SlideTo(ticketPlayer, TraceFloor(thePlayer.GetWorldPosition() + thePlayer.GetWorldForward() * 3));

		Sleep ( 0.1875 );

		if (thePlayer.GetPlayerCombatStance() != PCS_AlertNear)
		{
			thePlayer.SetPlayerCombatStance(PCS_AlertNear, true);
			thePlayer.SetPlayerCombatStance(PCS_AlertNear, true);
			thePlayer.SetPlayerCombatStance(PCS_AlertNear, true);
		}

		movementAdjustorPlayer.CancelAll();
		ticketPlayer = movementAdjustorPlayer.CreateNewRequest( 'ACSMovAdj' );
		movementAdjustorPlayer.MaxRotationAdjustmentSpeed( ticketPlayer, 5000 );
		movementAdjustorPlayer.MaxLocationAdjustmentSpeed( ticketPlayer, 5000 );
		movementAdjustorPlayer.AdjustLocationVertically( ticketPlayer, true );
		movementAdjustorPlayer.ScaleAnimationLocationVertically( ticketPlayer, true );

		movementAdjustorPlayer.AdjustmentDuration( ticketPlayer, 0.25f );

		movementAdjustorPlayer.RotateTowards(ticketPlayer, evadeTarget);

		ACSGetCActorRemoveTag('ACS_Flip_Target');

		thePlayer.RemoveTag('ACS_Neutral_Flip');

		thePlayer.BlockAllActions( 'ACS_Flip_Evade', false );

		thePlayer.SetImmortalityMode( AIM_None, AIC_Default, true ); 
		thePlayer.SetCanPlayHitAnim(true); 
		if (!thePlayer.IsUsingHorse()&& !thePlayer.IsUsingVehicle()){thePlayer.EnableCharacterCollisions(true); }	
		thePlayer.RemoveBuffImmunity_AllNegative('acs_dodge'); 
		thePlayer.SetIsCurrentlyDodging(false);

		parent.LockEntryFunction(false);

		parent.GotoState('ACS_ORTHANC');
	}
	
	event OnGameCameraTick( out moveData : SCameraMovementData, dt : float )
	{	
		camera = (CCustomCamera)theCamera.GetTopmostCameraObject();
		camera.SetAllowAutoRotation( true );
		UpdateCameraFlipEvade( moveData, dt );
		return true;
	}
	
	event OnGameCameraPostTick( out moveData : SCameraMovementData, dt : float )
	{
		UpdateCameraFlipEvade( moveData, dt );
		return true;
	}
	
	event OnLeaveState( nextStateName : name )
	{
		//thePlayer.EnableManualCameraControl( true, 'ACS_Flip_Evade' );
		super.OnLeaveState(nextStateName);
	}
	
	protected function UpdateCameraFlipEvade( out moveData : SCameraMovementData, timeDelta : float )
	{
		var playerToTargetVector : Vector;
		var playerToTargetAngles : EulerAngles;
		var playerToTargetPitch : float;
		var _tempVelocity : float;
		
		theGame.GetGameCamera().ChangePivotRotationController( 'CombatInterior' );
		theGame.GetGameCamera().ChangePivotDistanceController( 'Default' );
		theGame.GetGameCamera().ChangePivotPositionController( 'Default' );		
		
		moveData.pivotRotationController = theGame.GetGameCamera().GetActivePivotRotationController();
		moveData.pivotDistanceController = theGame.GetGameCamera().GetActivePivotDistanceController();
		moveData.pivotPositionController = theGame.GetGameCamera().GetActivePivotPositionController();
		
		DampFloatSpring(interiorCameraDesiredPositionMult, _tempVelocity, 10.f, 0.7f, timeDelta);
		
		moveData.pivotPositionController.SetDesiredPosition( thePlayer.GetWorldPosition(), interiorCameraDesiredPositionMult); 
		moveData.pivotDistanceController.SetDesiredDistance( 1.75f );
			
		if ( dest_pos == Vector( 0, 0, 0) )
		{
			playerToTargetVector = thePlayer.GetHeadingVector();

			moveData.pivotRotationController.SetDesiredHeading( VecHeading( playerToTargetVector ), 0.7f );
		}
		else
		{
			playerToTargetVector = dest_pos - init_pos;

			//playerToTargetVector = dest_pos;

			moveData.pivotRotationController.SetDesiredHeading( VecHeading( playerToTargetVector ), 1.5f );
		}
		
		
		if ( AbsF( playerToTargetVector.Z ) <= 1.f )
		{
			if ( thePlayer.IsGuarded() )
			{
				moveData.pivotRotationController.SetDesiredPitch( -25.5f );
			}
			else
			{
				moveData.pivotRotationController.SetDesiredPitch( -15.5f );
			}
		}
		else
		{
			playerToTargetAngles = VecToRotation( playerToTargetVector );
			playerToTargetPitch = playerToTargetAngles.Pitch + 10;
			moveData.pivotRotationController.SetDesiredPitch( playerToTargetPitch * -1, 0.5f );
		}

		moveData.pivotPositionController.offsetZ = 1.55f;

		DampVectorSpring( moveData.cameraLocalSpaceOffset, moveData.cameraLocalSpaceOffsetVel, Vector( 0.f, -3.f, 0.f ), 1.f, timeDelta );
	}	
}

state ACS_Enemy_Attack_From_Behind_Evade in CR4Player extends ExtendedMovable 
{
	var camera 									: CCustomCamera;
	var init_pos								: Vector;
	var dest_pos								: Vector;
	var evadeTarget								: CActor;
	var pos, newPos								: Vector;
	var markerNPC_1								: CEntity;
	var markerTemplate_1 						: CEntityTemplate;

	event OnEnterState( prevStateName : name )
	{
		init_pos = thePlayer.GetWorldPosition();

		thePlayer.EnableManualCameraControl( false, 'ACS_Enemy_Attack_From_Behind_Evade' );

		ACS_Enemy_Attack_From_Behind_Evade_Start();

		super.OnEnterState(prevStateName);
	}
	
	private entry function ACS_Enemy_Attack_From_Behind_Evade_Start()
	{
		GetACSWatcher().Enemy_Attack_From_Behind_Evade_Process_Manage(true);

		evadeTarget = ACSGetCActor('ACS_Enemy_Attacking_From_Behind');

		pos = evadeTarget.GetWorldPosition();
		
		dest_pos = pos;

		ACSGetCEntity('ACS_Enemy_Attacking_From_Behind_Marker').Destroy();

		markerTemplate_1 = (CEntityTemplate)LoadResourceAsync( 
							
		"dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent"

		, true );

		markerNPC_1 = (CEntity)theGame.CreateEntity( markerTemplate_1, pos );

		markerNPC_1.CreateAttachment( evadeTarget,, Vector(0,0.5,1.25) );

		//markerNPC_1.PlayEffectSingle('focus_sound_fx_red_alt');

		markerNPC_1.PlayEffectSingle('mutation_7_buff');

		markerNPC_1.AddTag('ACS_Enemy_Attacking_From_Behind_Marker');

		markerNPC_1.DestroyAfter(1);

		//markerNPC_1.PlayEffectSingle('mutation_7_debuff');

		Sleep ( 0.25 / thePlayer.GetAnimationTimeMultiplier() );

		ACSGetCActorRemoveTag('ACS_Enemy_Attacking_From_Behind');

		GetACSWatcher().Enemy_Attack_From_Behind_Evade_Process_Manage(false);

		if ( !theGame.IsDialogOrCutscenePlaying() )
		{
			parent.GotoState('Combat');
		}
		else
		{
			parent.PopState();
		}
	}
	
	event OnGameCameraTick( out moveData : SCameraMovementData, dt : float )
	{	
		camera = (CCustomCamera)theCamera.GetTopmostCameraObject();
		camera.SetAllowAutoRotation( true );
		UpdateCameraEnemyAttackFromBehind( moveData, dt );
		return true;
	}
	
	event OnGameCameraPostTick( out moveData : SCameraMovementData, dt : float )
	{
		UpdateCameraEnemyAttackFromBehind( moveData, dt );
		return true;
	}
	
	event OnLeaveState( nextStateName : name )
	{
		thePlayer.EnableManualCameraControl( true, 'ACS_Enemy_Attack_From_Behind_Evade' );
		super.OnLeaveState(nextStateName);
	}
	
	protected function UpdateCameraEnemyAttackFromBehind( out moveData : SCameraMovementData, timeDelta : float )
	{
		var playerToTargetVector : Vector;
		var playerToTargetAngles : EulerAngles;
		var playerToTargetPitch : float;
		var _tempVelocity : float;
		
		theGame.GetGameCamera().ChangePivotRotationController( 'CombatInterior' );
		theGame.GetGameCamera().ChangePivotDistanceController( 'Default' );
		theGame.GetGameCamera().ChangePivotPositionController( 'Default' );		
		
		moveData.pivotRotationController = theGame.GetGameCamera().GetActivePivotRotationController();
		moveData.pivotDistanceController = theGame.GetGameCamera().GetActivePivotDistanceController();
		moveData.pivotPositionController = theGame.GetGameCamera().GetActivePivotPositionController();
		
		DampFloatSpring(interiorCameraDesiredPositionMult, _tempVelocity, 10.f, 0.7f, timeDelta);
		
		moveData.pivotPositionController.SetDesiredPosition( parent.GetWorldPosition(), interiorCameraDesiredPositionMult); 
		moveData.pivotDistanceController.SetDesiredDistance( 1.75f );
			
		if ( dest_pos == Vector( 0, 0, 0) )
		{
			playerToTargetVector = thePlayer.GetHeadingVector();

			if(thePlayer.GetCombatIdleStance() <= 0.f )
			{
				moveData.pivotRotationController.SetDesiredHeading( VecHeading( playerToTargetVector ) - 45, 0.7f );
			}
			else
			{
				moveData.pivotRotationController.SetDesiredHeading( VecHeading( playerToTargetVector ) + 45, 0.7f );
			}
		}
		else
		{
			playerToTargetVector = dest_pos - init_pos;

			//playerToTargetVector = dest_pos;
			if(thePlayer.GetCombatIdleStance() <= 0.f )
			{
				moveData.pivotRotationController.SetDesiredHeading( VecHeading( playerToTargetVector ) - 45, 1.5f );
			}
			else
			{
				moveData.pivotRotationController.SetDesiredHeading( VecHeading( playerToTargetVector ) + 45, 1.5f );
			}
		}
		
		
		if ( AbsF( playerToTargetVector.Z ) <= 1.f )
		{
			if ( parent.IsGuarded() )
			{
				moveData.pivotRotationController.SetDesiredPitch( -25.5f );
			}
			else
			{
				moveData.pivotRotationController.SetDesiredPitch( -15.5f );
			}
		}
		else
		{
			playerToTargetAngles = VecToRotation( playerToTargetVector );
			playerToTargetPitch = playerToTargetAngles.Pitch + 10;
			moveData.pivotRotationController.SetDesiredPitch( playerToTargetPitch * -1, 0.5f );
		}

		moveData.pivotPositionController.offsetZ = 1.55f;

		DampVectorSpring( moveData.cameraLocalSpaceOffset, moveData.cameraLocalSpaceOffsetVel, Vector( 0.f, -3.f, 0.f ), 1.f, timeDelta );
	}	
}

state ACS_Ice_Blast_Evade in CR4Player extends ExtendedMovable 
{
	var was_in_combat							: bool;
	var camera 									: CCustomCamera;
	var init_pos								: Vector;
	var dest_pos								: Vector;
	var evadeTarget								: CActor;
	var sleep0, sleep1							: float;
	var pos, newPos								: Vector;
	var movementAdjustor						: CMovementAdjustor;
	var ticket 									: SMovementAdjustmentRequestTicket;
	var ent         							: CEntity;
	var teleport_fx, teleport_fx_1				: CEntity;
	var actor									: CActor;
	var npc     								: CNewNPC;
	var actors    								: array<CActor>;
	var i										: int;	
	var params 									: SCustomEffectParams;

	event OnEnterState( prevStateName : name )
	{
		if ( !theSound.SoundIsBankLoaded("magic_imlerith.bnk") )
		{
			theSound.SoundLoadBank( "magic_imlerith.bnk", false );
		}
		
		thePlayer.SoundEvent("magic_imlerith_appear_disappear");
	
		init_pos = thePlayer.GetWorldPosition();

		thePlayer.EnableManualCameraControl( false, 'ACS_Ice_Blast_Evade' );

		ACS_Ice_Blast_Evade_Start();

		super.OnEnterState(prevStateName);
	}
	
	private entry function ACS_Ice_Blast_Evade_Start()
	{
		parent.LockEntryFunction(true);
	
		sleep1 = 0.5;
		
		evadeTarget = parent.GetTarget();

		GetWitcherPlayer().GetRootAnimatedComponent().PlaySlotAnimationAsync ( 'blink_start_back_ready_ACS', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.875f));
		
		Sleep ( sleep1 / thePlayer.GetAnimationTimeMultiplier() );

		thePlayer.SetVisibility ( false );
		thePlayer.EnableCharacterCollisions(false);
		thePlayer.SetImmortalityMode( AIM_Invulnerable, AIC_Default, true );
		thePlayer.SetCanPlayHitAnim(false);
		thePlayer.AddBuffImmunity_AllNegative('ACS_Ice_Blast_Evade_Invul', false);
	
		movementAdjustor = thePlayer.GetMovingAgentComponent().GetMovementAdjustor();
		movementAdjustor.CancelAll();
		
		pos = evadeTarget.PredictWorldPosition(0.35) + VecFromHeading( AngleNormalize180( thePlayer.GetHeading() - NodeToNodeAngleDistance( evadeTarget, thePlayer ) ) ) * 3;
		if( !theGame.GetWorld().NavigationFindSafeSpot( pos, 0.3, 0.3 , newPos ) )
		{
			theGame.GetWorld().NavigationFindSafeSpot( pos, 0.3, 3 , newPos );
			pos = newPos;
		}
		
		dest_pos = pos;
		
		ticket = movementAdjustor.CreateNewRequest( 'ACS_Ice_Blast_Evade' );

		movementAdjustor.AdjustmentDuration( ticket, 0.1 );

		movementAdjustor.SlideTo(ticket, pos);

		movementAdjustor.RotateTowards( ticket, evadeTarget );

		teleport_fx_1 = theGame.CreateEntity( (CEntityTemplate)LoadResource( "fx\characters\eredin\eredin_teleport.w2ent", true ), GetWitcherPlayer().GetWorldPosition(), EulerAngles(0,0,0) );
		teleport_fx_1.CreateAttachment(GetWitcherPlayer());
		teleport_fx_1.PlayEffectSingle('disappear');
		teleport_fx_1.DestroyAfter(5);
		
		Sleep ( sleep1 / thePlayer.GetAnimationTimeMultiplier() );

		GetWitcherPlayer().DestroyEffect('suck_out');
		GetWitcherPlayer().PlayEffectSingle('suck_out');
		GetWitcherPlayer().StopEffect('suck_out');

		actors.Clear();

		actors = GetWitcherPlayer().GetNPCsAndPlayersInRange( 6, 20, , FLAG_ExcludePlayer + FLAG_Attitude_Hostile + FLAG_OnlyAliveActors);

		for( i = 0; i < actors.Size(); i += 1 )
		{
			npc = (CNewNPC)actors[i];
			
			if( actors.Size() > 0 )
			{		
				if( ACS_AttitudeCheck ( npc ) && npc.IsAlive() )
				{
					if (!npc.HasBuff(EET_Frozen))
					{
						params.effectType = EET_Frozen;
						params.creator = thePlayer;
						params.sourceName = "ACS_Ice_Blast";
						params.duration = 1;

						npc.AddEffectCustom( params );	
					}
				}
			}
		}

		teleport_fx = theGame.CreateEntity( (CEntityTemplate)LoadResource( "fx\characters\eredin\eredin_teleport.w2ent", true ), GetWitcherPlayer().GetWorldPosition(), EulerAngles(0,0,0) );
		teleport_fx.CreateAttachment(GetWitcherPlayer());
		teleport_fx.PlayEffectSingle('disappear');
		teleport_fx.DestroyAfter(5);

		GetACSWatcher().RemoveTimer('ACS_Ice_Giant_Armor_Timer');
		GetACSWatcher().AddTimer('ACS_Ice_Giant_Armor_Timer', 0.004 , true);

		GetACSWatcher().ACS_Quen();

		thePlayer.AddTag('ACS_Ice_Giant_Mode');

		ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

		"dlc\dlc_acs\data\entities\other\fx_ent.w2ent"

		, true ), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );

		ent.CreateAttachment(thePlayer,, Vector( 0, 0, 1 ), EulerAngles(0,0,0) );

		ent.PlayEffect('ice_blast');
		ent.PlayEffect('ice_blast_light');

		ent.DestroyAfter(3);
		
		if (!thePlayer.IsUsingHorse()&& !thePlayer.IsUsingVehicle()){thePlayer.EnableCharacterCollisions(true); }
		thePlayer.SetImmortalityMode( AIM_None, AIC_Default, true );	
		thePlayer.SetCanPlayHitAnim(true);
		thePlayer.RemoveBuffImmunity_AllNegative('ACS_Ice_Blast_Evade_Invul');
		thePlayer.SetVisibility ( true );
	
		parent.LockEntryFunction(false);
		
		thePlayer.SetIsCurrentlyDodging(false);
	
		if ( !theGame.IsDialogOrCutscenePlaying() )
		{
			parent.GotoState('Combat');
		}
		else
		{
			parent.PopState();
		}
	}
	
	event OnGameCameraTick( out moveData : SCameraMovementData, dt : float )
	{	
		camera = (CCustomCamera)theCamera.GetTopmostCameraObject();
		camera.SetAllowAutoRotation( true );
		UpdateCameraIceBlastEvade( moveData, dt );
		return true;
	}
	
	event OnGameCameraPostTick( out moveData : SCameraMovementData, dt : float )
	{
		UpdateCameraIceBlastEvade( moveData, dt );
		return true;
	}
	
	event OnLeaveState( nextStateName : name )
	{
		thePlayer.EnableManualCameraControl( true, 'ACS_Ice_Blast_Evade' );
		super.OnLeaveState(nextStateName);
	}
	
	protected function UpdateCameraIceBlastEvade( out moveData : SCameraMovementData, timeDelta : float )
	{
		var playerToTargetVector : Vector;
		var playerToTargetAngles : EulerAngles;
		var playerToTargetPitch : float;
		var _tempVelocity : float;
		
		theGame.GetGameCamera().ChangePivotRotationController( 'CombatInterior' );
		theGame.GetGameCamera().ChangePivotDistanceController( 'Default' );
		theGame.GetGameCamera().ChangePivotPositionController( 'Default' );		
		
		moveData.pivotRotationController = theGame.GetGameCamera().GetActivePivotRotationController();
		moveData.pivotDistanceController = theGame.GetGameCamera().GetActivePivotDistanceController();
		moveData.pivotPositionController = theGame.GetGameCamera().GetActivePivotPositionController();
		
		DampFloatSpring(interiorCameraDesiredPositionMult, _tempVelocity, 10.f, 0.7f, timeDelta);
		
		moveData.pivotPositionController.SetDesiredPosition( parent.GetWorldPosition(), interiorCameraDesiredPositionMult); 
		moveData.pivotDistanceController.SetDesiredDistance( 10.5f );
			
		if ( dest_pos == Vector( 0, 0, 0) )
		{
			playerToTargetVector = thePlayer.GetHeadingVector();
			moveData.pivotRotationController.SetDesiredHeading( VecHeading( playerToTargetVector ) - 180, 0.7f );
		}
		else
		{
			playerToTargetVector = dest_pos - init_pos;
			moveData.pivotRotationController.SetDesiredHeading( VecHeading( playerToTargetVector ) - 180, 1.5f );
		}
		
		
		if ( AbsF( playerToTargetVector.Z ) <= 1.f )
		{
			if ( parent.IsGuarded() )
				moveData.pivotRotationController.SetDesiredPitch( -25.f );
			else
				moveData.pivotRotationController.SetDesiredPitch( -15.f );
		}
		else
		{
			playerToTargetAngles = VecToRotation( playerToTargetVector );
			playerToTargetPitch = playerToTargetAngles.Pitch + 10;
			
			
			
			moveData.pivotRotationController.SetDesiredPitch( playerToTargetPitch * -1, 0.5f );
		}
	
		moveData.pivotPositionController.offsetZ = 1.55f;
		DampVectorSpring( moveData.cameraLocalSpaceOffset, moveData.cameraLocalSpaceOffsetVel, Vector( 0.f, -3.f, 0.f ), 1.f, timeDelta );
	}	
}

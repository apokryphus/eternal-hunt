					AddTimer('ACS_ResetAnimation', 0.25    , false);

					PlayerPlayAnimation( 'attack_special_dash_close_ACS');
					break;

					case 1:
					if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier( 2  ); }	
							
					AddTimer('ACS_ResetAnimation', 0.75    , false);


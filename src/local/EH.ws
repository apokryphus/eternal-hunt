				(ACSGetCEntity('ACS_Compass_Bar_Cardinal_NorthEast_Entity')).TeleportWithRotation(northEastPos, thePlayer.GetWorldRotation());
			}

			if(!ACSGetCEntity('ACS_Compass_Bar_Cardinal_NorthWest_Entity')
			)
			{
				ent_northWest = (CEntity)theGame.CreateEntity( tempCompass, northWestPos );

				ent_northWest.AddTag('ACS_HUD_Marker_Entity');

				ent_northWest.AddTag('ACS_Compass_Bar_Cardinal_NorthWest_Entity');

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Compass_Bar_Cardinal_NorthWest");

				ACS_Oneliner(FormatCardinalIconPath("icons/inventory/acs_marker_cardinal_north_west.xbm"), ACSGetCEntity('ACS_Compass_Bar_Cardinal_NorthWest_Entity'), "ACS_Compass_Bar_Cardinal_NorthWest");

				/*
				GetACSStorage().acs_deleteOnelinerByTag("ACS_Compass_Bar_Cardinal_NorthWest_Bar_Alpha");
				ACS_Oneliner(FormatCompassBarPathAlpha("icons/inventory/acs_compass_bar.xbm"), ACSGetCEntity('ACS_Compass_Bar_Cardinal_NorthWest_Entity'), "ACS_Compass_Bar_Cardinal_NorthWest_Bar_Alpha");
				GetACSStorage().acs_deleteOnelinerByTag("ACS_Compass_Bar_Cardinal_NorthWest_Bar_Omega");
				ACS_Oneliner(FormatCompassBarPathOmega("icons/inventory/acs_compass_bar.xbm"), ACSGetCEntity('ACS_Compass_Bar_Cardinal_NorthWest_Entity'), "ACS_Compass_Bar_Cardinal_NorthWest_Bar_Omega");
				*/

				GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Compass_Bar_Cardinal_NorthWest", 100);

				GetACSStorage().acs_setScaleForOnelinerByTag("ACS_Compass_Bar_Cardinal_NorthWest", 100, 100, 100);
			}
			else
			{
				GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Compass_Bar_Cardinal_NorthWest", 100);

				(ACSGetCEntity('ACS_Compass_Bar_Cardinal_NorthWest_Entity')).TeleportWithRotation(northWestPos, thePlayer.GetWorldRotation());
			}

			if(!ACSGetCEntity('ACS_Compass_Bar_Cardinal_SouthEast_Entity')
			)
			{
				ent_southEast = (CEntity)theGame.CreateEntity( tempCompass, southEastPos );

				ent_southEast.AddTag('ACS_HUD_Marker_Entity');

				ent_southEast.AddTag('ACS_Compass_Bar_Cardinal_SouthEast_Entity');

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Compass_Bar_Cardinal_SouthEast");

				ACS_Oneliner(FormatCardinalIconPath("icons/inventory/acs_marker_cardinal_south_east.xbm"), ACSGetCEntity('ACS_Compass_Bar_Cardinal_SouthEast_Entity'), "ACS_Compass_Bar_Cardinal_SouthEast");

				/*
				GetACSStorage().acs_deleteOnelinerByTag("ACS_Compass_Bar_Cardinal_SouthEast_Bar_Alpha");
				ACS_Oneliner(FormatCompassBarPathAlpha("icons/inventory/acs_compass_bar.xbm"), ACSGetCEntity('ACS_Compass_Bar_Cardinal_SouthEast_Entity'), "ACS_Compass_Bar_Cardinal_SouthEast_Bar_Alpha");
				GetACSStorage().acs_deleteOnelinerByTag("ACS_Compass_Bar_Cardinal_SouthEast_Bar_Omega");
				ACS_Oneliner(FormatCompassBarPathOmega("icons/inventory/acs_compass_bar.xbm"), ACSGetCEntity('ACS_Compass_Bar_Cardinal_SouthEast_Entity'), "ACS_Compass_Bar_Cardinal_SouthEast_Bar_Omega");
				*/

				GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Compass_Bar_Cardinal_SouthEast", 100);

				GetACSStorage().acs_setScaleForOnelinerByTag("ACS_Compass_Bar_Cardinal_SouthEast", 100, 100, 100);
			}
			else
			{
				GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Compass_Bar_Cardinal_SouthEast", 100);

				(ACSGetCEntity('ACS_Compass_Bar_Cardinal_SouthEast_Entity')).TeleportWithRotation(southEastPos, thePlayer.GetWorldRotation());
			}

			if(!ACSGetCEntity('ACS_Compass_Bar_Cardinal_SouthWest_Entity')
			)
			{
				ent_southWest = (CEntity)theGame.CreateEntity( tempCompass, southWestPos );

				ent_southWest.AddTag('ACS_HUD_Marker_Entity');

				ent_southWest.AddTag('ACS_Compass_Bar_Cardinal_SouthWest_Entity');

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Compass_Bar_Cardinal_SouthWest");

				ACS_Oneliner(FormatCardinalIconPath("icons/inventory/acs_marker_cardinal_south_west.xbm"), ACSGetCEntity('ACS_Compass_Bar_Cardinal_SouthWest_Entity'), "ACS_Compass_Bar_Cardinal_SouthWest");

				/*
				GetACSStorage().acs_deleteOnelinerByTag("ACS_Compass_Bar_Cardinal_SouthWest_Bar_Alpha");
				ACS_Oneliner(FormatCompassBarPathAlpha("icons/inventory/acs_compass_bar.xbm"), ACSGetCEntity('ACS_Compass_Bar_Cardinal_SouthWest_Entity'), "ACS_Compass_Bar_Cardinal_SouthWest_Bar_Alpha");
				GetACSStorage().acs_deleteOnelinerByTag("ACS_Compass_Bar_Cardinal_SouthWest_Bar_Omega");
				ACS_Oneliner(FormatCompassBarPathOmega("icons/inventory/acs_compass_bar.xbm"), ACSGetCEntity('ACS_Compass_Bar_Cardinal_SouthWest_Entity'), "ACS_Compass_Bar_Cardinal_SouthWest_Bar_Omega");
				*/

				GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Compass_Bar_Cardinal_SouthWest", 100);

				GetACSStorage().acs_setScaleForOnelinerByTag("ACS_Compass_Bar_Cardinal_SouthWest", 100, 100, 100);
			}
			else
			{
				GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Compass_Bar_Cardinal_SouthWest", 100);

				(ACSGetCEntity('ACS_Compass_Bar_Cardinal_SouthWest_Entity')).TeleportWithRotation(southWestPos, thePlayer.GetWorldRotation());
			}

			RemoveTimer('CompassBarDespawnDelay');

			if (ACS_Compas_Bar_Despawn_Activate)
			{
				ACS_Compas_Bar_Despawn_Activate = false;
			}

			compassbarAvailable = true;
		}
		else
		{
			(ACSGetCEntity('ACS_Compass_Bar_Entity')).TeleportWithRotation(targetpos, thePlayer.GetWorldRotation());

			(ACSGetCEntity('ACS_Compass_Bar_Cardinal_North_Entity')).TeleportWithRotation(northPos, thePlayer.GetWorldRotation());

			(ACSGetCEntity('ACS_Compass_Bar_Cardinal_South_Entity')).TeleportWithRotation(southPos, thePlayer.GetWorldRotation());

			(ACSGetCEntity('ACS_Compass_Bar_Cardinal_East_Entity')).TeleportWithRotation(eastPos, thePlayer.GetWorldRotation());

			(ACSGetCEntity('ACS_Compass_Bar_Cardinal_West_Entity')).TeleportWithRotation(westPos, thePlayer.GetWorldRotation());

			(ACSGetCEntity('ACS_Compass_Bar_Cardinal_NorthEast_Entity')).TeleportWithRotation(northEastPos, thePlayer.GetWorldRotation());

			(ACSGetCEntity('ACS_Compass_Bar_Cardinal_NorthWest_Entity')).TeleportWithRotation(northWestPos, thePlayer.GetWorldRotation());

			(ACSGetCEntity('ACS_Compass_Bar_Cardinal_SouthEast_Entity')).TeleportWithRotation(southEastPos, thePlayer.GetWorldRotation());

			(ACSGetCEntity('ACS_Compass_Bar_Cardinal_SouthWest_Entity')).TeleportWithRotation(southWestPos, thePlayer.GetWorldRotation());

			if (!ACS_Compas_Bar_Despawn_Activate )
			{
				RemoveTimer('CompassBarDespawnDelay');
				AddTimer('CompassBarDespawnDelay', ACS_Settings_Main_Float('acs_hud_settings_markers','acs_compass_bar_despawn_delay', 7) , false);

				ACS_Compas_Bar_Despawn_Activate = true;
			}
		}
	}

	timer function CompassBarDespawnDelay( time : float , id : int )
	{	
		compassbarAlphaFadeOut = 100;
		RemoveTimer('CompassBarFadeOut');
		AddTimer('CompassBarFadeOut', 0.01 , true);
	}


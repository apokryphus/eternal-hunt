	public timer function ACS_Shield_Spawn_Delay ( dt : float, id : int)
	{
		if (!thePlayer.HasTag('ACS_IsPerformingFinisher')
		&& !thePlayer.HasTag('ACS_IsPerformingCounterWound'))
		{
			action_interrupt();
		}

		vACS_Shield_Summon = new cACS_Shield_Summon in this; 

		vACS_Shield_Summon.Axii_Persistent_Shield_Summon(); 
	} 

	public timer function DimeritiumHitRestore ( dt : float, id : int)
	{
		GetWitcherPlayer().StopEffect('dimeritium_hit_electricity');

		GetWitcherPlayer().StopEffect('dimeritium_hit');

		GetWitcherPlayer().UnblockAction( EIAB_Signs, 				'ACS_Dimeritium');

		thePlayer.RemoveTag('ACS_Player_Hit_By_Dimeritium');
	} 

	var last_ice_spikes_time : float;

	var vACS_Ice_Spikes : cACS_Ice_Spikes;

	function ACS_Ice_Spikes()
	{
		if ( theGame.IsDialogOrCutscenePlaying() 
		|| thePlayer.IsPerformingFinisher()
		|| thePlayer.HasTag('ACS_IsPerformingFinisher')
		|| thePlayer.HasTag('ACS_IsPerformingCombatDismember')
		|| theGame.IsPaused() 
		|| theGame.IsFading()
		|| theGame.IsBlackscreen()
		|| thePlayer.IsInCutsceneIntro() 
		|| theGame.IsCurrentlyPlayingNonGameplayScene()
		|| thePlayer.HasTag('acs_in_wraith') 
		|| thePlayer.HasTag('ACS_Camo_Active') 
		|| thePlayer.IsEffectActive( 'invisible' )
		|| !thePlayer.GetVisibility()
		|| theGame.GetPhotomodeEnabled() 
		|| (thePlayer.HasBuff(EET_BlackBlood) && thePlayer.HasTag('acs_vampire_claws_equipped'))
		)
		{
			return;
		}

		vACS_Ice_Spikes = new cACS_Ice_Spikes in this;
				
		vACS_Ice_Spikes.ACS_Ice_Spikes_Engage();
	}
	
	var last_ice_blast_time : float;

	function ACS_Ice_Blast()
	{
		if ( theGame.IsDialogOrCutscenePlaying() 
		|| thePlayer.IsPerformingFinisher()
		|| thePlayer.HasTag('ACS_IsPerformingFinisher')
		|| thePlayer.HasTag('ACS_IsPerformingCombatDismember')
		|| theGame.IsFading()
		|| theGame.IsBlackscreen()
		|| theGame.IsPaused() 
		|| thePlayer.HasTag('acs_in_wraith') 
		|| thePlayer.HasTag('ACS_Camo_Active') 
		|| thePlayer.IsEffectActive( 'invisible' )
		|| !thePlayer.GetVisibility()
		|| theGame.GetPhotomodeEnabled() 
		|| theGame.IsCurrentlyPlayingNonGameplayScene()
		|| thePlayer.IsInCutsceneIntro() 
		|| (thePlayer.HasBuff(EET_BlackBlood) && thePlayer.HasTag('acs_vampire_claws_equipped'))
		)
		{
			return;
		}

		vACS_Ice_Spikes = new cACS_Ice_Spikes in this;
				
		vACS_Ice_Spikes.ACS_Ice_Blast_Engage();
	}



				(ACSGetCEntity('ACS_Compass_Bar_Cardinal_West_Entity')).TeleportWithRotation(westPos, thePlayer.GetWorldRotation());
			}

			if(!ACSGetCEntity('ACS_Compass_Bar_Cardinal_NorthEast_Entity')
			)
			{
				ent_northEast = (CEntity)theGame.CreateEntity( tempCompass, northEastPos );

				ent_northEast.AddTag('ACS_HUD_Marker_Entity');

				ent_northEast.AddTag('ACS_Compass_Bar_Cardinal_NorthEast_Entity');

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Compass_Bar_Cardinal_NorthEast");


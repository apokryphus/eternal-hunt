	////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	var xenoToggle 						: bool;

	function XenoSwitchToggle()
	{
		if (!xenoToggle)
		{
			if (!ACSGetCActor('ACS_Xeno_Tyrant').HasAbility('mon_kikimore_small'))
			{
				ACSGetCActor('ACS_Xeno_Tyrant').AddAbility('mon_kikimore_small');
			}

			ACSXenoSoldiersAddAbility();

			xenoToggle = true;
		}
		else
		{
			if (ACSGetCActor('ACS_Xeno_Tyrant').HasAbility('mon_kikimore_small'))
			{
				ACSGetCActor('ACS_Xeno_Tyrant').RemoveAbility('mon_kikimore_small');
			}

			ACSXenoSoldiersRemoveAbility();

			xenoToggle = false;
		}

		ACSXenoArmoredWorkersSwapAbility();
	}

	function SetFireBearFireLineProcess( flag : bool )
	{
		ACS_Fire_Bear_FireLine_Process = flag;
	}

	function SetFireBearFireballProcess( flag : bool )
	{
		ACS_Fire_Bear_Fireball_Process = flag;
	}

	///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	public var counterWindowExtendedCheck, counterWindowExtendedForEssence, counterWindowExtendedForVitality 						: bool;

	public var waitStartTimeEssence, waitStartTimeVitality																			: float;

	function counterWindowExtendedForEssenceSet( b : bool )
	{
		if (b)
		{
			waitStartTimeEssence = theGame.GetEngineTimeAsSeconds();
		}

		counterWindowExtendedForEssence = b;
	}

	function counterWindowExtendedForVitalitySet( b : bool )
	{
		if (b)
		{
			waitStartTimeVitality = theGame.GetEngineTimeAsSeconds();
		}

		counterWindowExtendedForVitality = b;
	}

	timer function counterWindowExtendedCheckForEssenceTimer( time : float , id : int )
	{
		counterWindowExtendedForEssenceSet(false);
	}

	timer function counterWindowExtendedCheckForVitalityTimer( time : float , id : int )
	{
		counterWindowExtendedForVitalitySet(false);
	}

	function ForceGuardedStance()
	{
		if (theGame.IsDialogOrCutscenePlaying() 
		|| GetWitcherPlayer().IsInNonGameplayCutscene() 
		|| GetWitcherPlayer().IsInGameplayScene()
		|| theGame.IsCurrentlyPlayingNonGameplayScene()
		|| theGame.IsFading()
		|| theGame.IsBlackscreen()
		|| theGame.IsPaused()
		|| thePlayer.IsInCutsceneIntro() 
		)
		{
			return;
		}

		if (
		thePlayer.IsUsingHorse()
		|| thePlayer.IsUsingVehicle()
		|| thePlayer.IsSwimming() 
		|| thePlayer.IsDiving()
		)
		{
			return;
		}
		
		if(thePlayer.IsGuarded()
		)
		{
			if (ACS_RageMechanic_Enabled())
			{
				if (!thePlayer.IsImmuneToBuff(EET_Stagger))
				{
					thePlayer.AddBuffImmunity	( EET_Stagger,					'acs_guard', true);
				}
				
				if (!thePlayer.IsImmuneToBuff(EET_LongStagger))
				{
					thePlayer.AddBuffImmunity	( EET_LongStagger,				'acs_guard', true);
				}
			}
			
			if (!counterWindowExtendedCheck)
			{
				counterWindowExtendedForEssenceSet(true);

				counterWindowExtendedForVitalitySet(true);

				RemoveTimer('counterWindowExtendedCheckForEssenceTimer');
				AddTimer('counterWindowExtendedCheckForEssenceTimer', ACS_Settings_Main_Float('acs_parry_skills_settings','acs_normal_counter_window_for_silver_health', 1) , false);

				RemoveTimer('counterWindowExtendedCheckForVitalityTimer');
				AddTimer('counterWindowExtendedCheckForVitalityTimer', ACS_Settings_Main_Float('acs_parry_skills_settings','acs_normal_counter_window_for_red_health', 0.5) , false);

				counterWindowExtendedCheck = true;
			}
		}
		else
		{
			thePlayer.RemoveBuffImmunity( EET_Stagger,								'acs_guard');
			thePlayer.RemoveBuffImmunity( EET_LongStagger,							'acs_guard');

			if (counterWindowExtendedCheck)
			{
				counterWindowExtendedForEssenceSet(false);

				counterWindowExtendedForVitalitySet(false);

				RemoveTimer('counterWindowExtendedCheckForEssenceTimer');

				RemoveTimer('counterWindowExtendedCheckForVitalityTimer');

				counterWindowExtendedCheck = false;
			}
		}

		if (ACS_IS_SNEAKING
		|| thePlayer.HasTag('ACS_Is_Sneaking'))
		{
			if (thePlayer.GetBehaviorVariable( 'playerWeapon') != 1)
			{
				thePlayer.SetBehaviorVariable( 'playerWeapon', 1 , true);
			}

			if (thePlayer.GetBehaviorVariable( 'playerWeaponLatent') != 1)
			{
				thePlayer.SetBehaviorVariable( 'playerWeaponLatent', 1 , true);
			}
			
			if (thePlayer.GetBehaviorVariable( 'playerWeaponForOverlay') != 1)
			{
				thePlayer.SetBehaviorVariable( 'playerWeaponForOverlay', 1 , true);
			}

			if (ACS_Vampire_Claws_Access())
			{
				if (thePlayer.GetBehaviorVariable( 'isHoldingWeaponR') != 0.0)
				{
					thePlayer.SetBehaviorVariable( 'isHoldingWeaponR', 0.0, true );
				}
			}
			else
			{
				if (thePlayer.GetBehaviorVariable( 'isHoldingWeaponR') != 1.0)
				{
					thePlayer.SetBehaviorVariable( 'isHoldingWeaponR', 1.0, true );
				}
			}	
		}
		else
		{
			if (thePlayer.IsAnyWeaponHeld() )
			{
				if (thePlayer.IsWeaponHeld('fist')
				)
				{
					if (thePlayer.HasTag('acs_vampire_claws_equipped') 
					|| thePlayer.HasTag('acs_sorc_fists_equipped')
					)
					{
						if (thePlayer.GetBehaviorVariable( 'playerWeapon') != 1)
						{
							thePlayer.SetBehaviorVariable( 'playerWeapon', 1 , true);
						}

						if (thePlayer.GetBehaviorVariable( 'playerWeaponLatent') != 1)
						{
							thePlayer.SetBehaviorVariable( 'playerWeaponLatent', 1 , true);
						}
						
						if (thePlayer.GetBehaviorVariable( 'playerWeaponForOverlay') != 1)
						{
							thePlayer.SetBehaviorVariable( 'playerWeaponForOverlay', 1 , true);
						}
					}
					else
					{
						if (thePlayer.GetBehaviorVariable( 'playerWeapon') != 3)
						{
							thePlayer.SetBehaviorVariable( 'playerWeapon', 3 , true);
						}

						if (thePlayer.GetBehaviorVariable( 'playerWeaponLatent') != 3)
						{
							thePlayer.SetBehaviorVariable( 'playerWeaponLatent', 3 , true);
						}
						
						if (thePlayer.GetBehaviorVariable( 'playerWeaponForOverlay') != 3)
						{
							thePlayer.SetBehaviorVariable( 'playerWeaponForOverlay', 3 , true);
						}
					}

					if (thePlayer.GetBehaviorVariable( 'isHoldingWeaponR') != 0.0)
					{
						thePlayer.SetBehaviorVariable( 'isHoldingWeaponR', 0.0, true );
					}
				}
				else
				{
					if (thePlayer.IsWeaponHeld('silversword'))
					{
						if (thePlayer.GetBehaviorVariable( 'playerWeapon') != 2)
						{
							thePlayer.SetBehaviorVariable( 'playerWeapon', 2 , true);
						}

						if (thePlayer.GetBehaviorVariable( 'playerWeaponLatent') != 2)
						{
							thePlayer.SetBehaviorVariable( 'playerWeaponLatent', 2 , true);
						}
						
						if (thePlayer.GetBehaviorVariable( 'playerWeaponForOverlay') != 2)
						{
							thePlayer.SetBehaviorVariable( 'playerWeaponForOverlay', 2 , true);
						}
					}
					else if (thePlayer.IsWeaponHeld('steelsword'))
					{
						if (thePlayer.GetBehaviorVariable( 'playerWeapon') != 1)
						{
							thePlayer.SetBehaviorVariable( 'playerWeapon', 1 , true);
						}

						if (thePlayer.GetBehaviorVariable( 'playerWeaponLatent') != 1)
						{
							thePlayer.SetBehaviorVariable( 'playerWeaponLatent', 1 , true);
						}
						
						if (thePlayer.GetBehaviorVariable( 'playerWeaponForOverlay') != 1)
						{
							thePlayer.SetBehaviorVariable( 'playerWeaponForOverlay', 1 , true);
						}
					}
					else
					{
						if (thePlayer.GetBehaviorVariable( 'playerWeapon') != 1)
						{
							thePlayer.SetBehaviorVariable( 'playerWeapon', 1 , true);
						}

						if (thePlayer.GetBehaviorVariable( 'playerWeaponLatent') != 1)
						{
							thePlayer.SetBehaviorVariable( 'playerWeaponLatent', 1 , true);
						}
						
						if (thePlayer.GetBehaviorVariable( 'playerWeaponForOverlay') != 1)
						{
							thePlayer.SetBehaviorVariable( 'playerWeaponForOverlay', 1 , true);
						}
					}

					if (thePlayer.GetBehaviorVariable( 'isHoldingWeaponR') != 1.0)
					{
						thePlayer.SetBehaviorVariable( 'isHoldingWeaponR', 1.0, true );
					}
				}
			}
			else
			{
				if (!ACS_CombatToExplorationCheck())
				{
					if (thePlayer.HasTag('acs_vampire_claws_equipped') 
					|| thePlayer.HasTag('acs_sorc_fists_equipped')
					)
					{
						if (thePlayer.GetBehaviorVariable( 'playerWeapon') != 1)
						{
							thePlayer.SetBehaviorVariable( 'playerWeapon', 1 , true);
						}

						if (thePlayer.GetBehaviorVariable( 'playerWeaponLatent') != 1)
						{
							thePlayer.SetBehaviorVariable( 'playerWeaponLatent', 1 , true);
						}
						
						if (thePlayer.GetBehaviorVariable( 'playerWeaponForOverlay') != 1)
						{
							thePlayer.SetBehaviorVariable( 'playerWeaponForOverlay', 1 , true);
						}
					}
					else
					{
						if (thePlayer.GetBehaviorVariable( 'playerWeapon') != 3)
						{
							thePlayer.SetBehaviorVariable( 'playerWeapon', 3 , true);
						}

						if (thePlayer.GetBehaviorVariable( 'playerWeaponLatent') != 3)
						{
							thePlayer.SetBehaviorVariable( 'playerWeaponLatent', 3 , true);
						}
						
						if (thePlayer.GetBehaviorVariable( 'playerWeaponForOverlay') != 3)
						{
							thePlayer.SetBehaviorVariable( 'playerWeaponForOverlay', 3 , true);
						}
					}
				}
				else
				{
					if (thePlayer.GetBehaviorVariable( 'playerWeapon') != 3)
					{
						thePlayer.SetBehaviorVariable( 'playerWeapon', 3 , true);
					}

					if (thePlayer.GetBehaviorVariable( 'playerWeaponLatent') != 3)
					{
						thePlayer.SetBehaviorVariable( 'playerWeaponLatent', 3 , true);
					}
					
					if (thePlayer.GetBehaviorVariable( 'playerWeaponForOverlay') != 3)
					{
						thePlayer.SetBehaviorVariable( 'playerWeaponForOverlay', 3 , true);
					}
				}

				if (thePlayer.GetBehaviorVariable( 'isHoldingWeaponR') != 0.0)
				{
					thePlayer.SetBehaviorVariable( 'isHoldingWeaponR', 0.0, true );
				}
			}
		}

		if (thePlayer.HasTag('acs_vampire_claws_equipped'))
		{
			return;
		}

		if(RadialMenuCheck())
		{
			return;
		}

		if (thePlayer.GetIsSprinting() && thePlayer.IsInCombat())
		{
			if (thePlayer.GetPlayerCombatStance() != PCS_Normal)
			{
				thePlayer.SetPlayerCombatStance(PCS_Normal, true);
			}

			return;
		}

		if (thePlayer.HasTag('ACS_MountedAttackDismountProcessStart'))
		{
			if (thePlayer.GetPlayerCombatStance() != PCS_AlertNear)
			{
				thePlayer.SetPlayerCombatStance(PCS_AlertNear, true);
				thePlayer.SetPlayerCombatStance(PCS_AlertNear, true);
				thePlayer.SetPlayerCombatStance(PCS_AlertNear, true);
			}

			return;
		}

		if (!thePlayer.IsInCombat()
		)
		{
			if (ACS_IS_SNEAKING
			|| thePlayer.HasTag('ACS_Is_Sneaking')
			)
			{
				if ( ACS_Vampire_Claws_Access() )
				{
					if (thePlayer.GetPlayerCombatStance() != PCS_Normal)
					{
						thePlayer.SetPlayerCombatStance(PCS_Normal, true);
					}
				}
				else
				{
					if (
					thePlayer.IsCurrentlyDodging()
					|| thePlayer.HasTag('ACS_Is_Currently_Dodging')
					|| thePlayer.HasTag('ACS_IsPerformingFinisher')
					|| thePlayer.HasTag('ACS_IsPerformingCounterWound')
					|| thePlayer.rangedWeapon.GetCurrentStateName() == 'State_WeaponAim' 
					|| thePlayer.rangedWeapon.GetCurrentStateName() == 'State_WeaponShoot'
					|| thePlayer.rangedWeapon.GetCurrentStateName() == 'State_WeaponReload'
					|| thePlayer.substateManager.GetStateCur() == 'Jump'
					|| thePlayer.substateManager.GetStateCur() == 'Interaction'
					|| thePlayer.substateManager.GetStateCur() == 'Climb'
					|| thePlayer.IsThrowHold() 
					|| thePlayer.GetIsAimingCrossbow()
					|| !AnimProgressCheck()
					|| thePlayer.GetPlayerAction() != PEA_None
					|| ACSGetCEntity('ACS_Loot_Prop')
					|| thePlayer.HasTag('ACS_IsManagingSword')
					|| thePlayer.GetWeaponHolster().IsOnTheMiddleOfHolstering() 
					|| !thePlayer.GetWeaponHolster().IsMeleeWeaponReady()
					)
					{
						if (thePlayer.GetPlayerCombatStance() != PCS_Normal)
						{
							thePlayer.SetPlayerCombatStance(PCS_Normal, true);
						}
					}
					else
					{
						if (thePlayer.GetPlayerCombatStance() != PCS_AlertNear)
						{
							thePlayer.SetPlayerCombatStance(PCS_AlertNear, true);
							thePlayer.SetPlayerCombatStance(PCS_AlertNear, true);
							thePlayer.SetPlayerCombatStance(PCS_AlertNear, true);
						}
					}
				}
			}
			else
			{
				if (theInput.GetActionValue('LockAndGuard') > 0.5
				)
				{
					if (thePlayer.GetPlayerCombatStance() != PCS_Guarded)
					{
						thePlayer.SetPlayerCombatStance(PCS_Guarded, true);
					}
				}
				else if (theInput.GetActionValue('LockAndGuard') == 0)
				{
					if (!ACS_CombatToExplorationCheck())
					{
						if (!ACS_Settings_Main_Bool('acs_combat_main_settings','acs_combat_stance', true)
						)
						{
							if (thePlayer.GetPlayerCombatStance() != PCS_Normal)
							{
								thePlayer.SetPlayerCombatStance(PCS_Normal, true);
							}
						}
						else
						{
							if (thePlayer.GetPlayerCombatStance() != PCS_AlertNear)
							{
								thePlayer.SetPlayerCombatStance(PCS_AlertNear, true);
								thePlayer.SetPlayerCombatStance(PCS_AlertNear, true);
								thePlayer.SetPlayerCombatStance(PCS_AlertNear, true);
							}
						}
					}
					else
					{
						if (thePlayer.GetPlayerCombatStance() == PCS_Guarded || thePlayer.GetPlayerCombatStance() == PCS_AlertNear)
						{
							thePlayer.SetPlayerCombatStance(PCS_Normal, true);
						}
					}
				}
			}

			return;
		}

		if (!ACS_Settings_Main_Bool('acs_combat_main_settings','acs_combat_stance', true))
		{
			if (theInput.GetActionValue('LockAndGuard') > 0.5)
			{
				if (thePlayer.GetPlayerCombatStance() != PCS_Guarded)
				{
					thePlayer.SetPlayerCombatStance(PCS_Guarded, true);
				}
			}
			else if (theInput.GetActionValue('LockAndGuard') == 0)
			{
				if (thePlayer.GetPlayerCombatStance() != PCS_Normal)
				{
					thePlayer.SetPlayerCombatStance(PCS_Normal, true);
				}
			}
		}
	}

	timer function Wraith_Swim_Timer( time : float , id : int )
	{
		var mult : float;

		//var angle : float;

		if (thePlayer.HasTag('acs_in_wraith'))
		{
			RemoveTimer('Wraith_Swim_Timer');

			return;
		}

		if ((thePlayer.rawPlayerSpeed == 0 
		&& theInput.IsActionReleased('DiveDown') 
		&& theInput.IsActionReleased('DiveUp'))
		|| swimmingMeleeCheck
		|| swimmingAardCheck
		|| swimmingDodgeCheck
		|| swimmingCounterCheck
		)
		{

		}
		else
		{
			if(GetWitcherPlayer().IsItemEquippedByName('acs_drowner_extract_item')
			|| thePlayer.HasBuff(EET_KillerWhale)
			|| ACS_Armor_Set_Check('acs_armor', false)
			)
			{
				mult = 0.5;
			}
			else
			{
				mult = 0.25;
			}

			camera.StopAnimation('camera_shake_loop_lvl1_1');

			theGame.GetGameCamera().StopAnimation( 'camera_shake_loop_lvl1_1' );

			camera.StopAnimation('camera_shake_loop_lvl1_5');

			theGame.GetGameCamera().StopAnimation( 'camera_shake_loop_lvl1_5' );

			MovementAdjust('wraith');
			
			movementAdjustor.ScaleAnimation( ticket, true, false, true );

			if (theInput.GetActionValue('GI_AxisLeftY') < -0.1)
			{
				if (thePlayer.IsInsideInteraction())
				{
					if (theInput.IsActionPressed('Sprint') || thePlayer.GetIsSprinting())
					{
						if (theInput.IsActionPressed('DiveUp'))
						{
							if(thePlayer.IsSwimming())
							{
								dest1 = GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetHeadingVector() * (0.625 * mult);
							}
							else
							{
								dest1 = GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetWorldUp() * 0.5;
							}	
						}
						else if (theInput.IsActionPressed('DiveDown'))
						{
							dest1 = GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetWorldUp() * -0.5;
						}
					}
					else
					{
						if (theInput.IsActionPressed('DiveUp'))
						{
							if(thePlayer.IsSwimming())
							{
								dest1 = GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetHeadingVector() * (0.0625 * mult);
							}
							else
							{
								dest1 = GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetWorldUp() * 0.25;
							}
						}
						else if (theInput.IsActionPressed('DiveDown'))
						{
							dest1 = GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetWorldUp() * -0.25;
						}
					}
				}
				else if (theGame.IsFocusModeActive() || theInput.GetActionValue('Focus') > 0.1f)
				{
					if (theInput.IsActionPressed('Sprint') || thePlayer.GetIsSprinting())
					{
						if (theInput.IsActionPressed('DiveUp'))
						{
							if(thePlayer.IsSwimming())
							{
								dest1 = GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetHeadingVector() * (1.25 * mult);
							}
							else
							{
								dest1 = GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetWorldUp() * 0.75;
							}
						}
						else if (theInput.IsActionPressed('DiveDown'))
						{
							dest1 = GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetWorldUp() * -0.75;
						}
					}
					else
					{
						if (theInput.IsActionPressed('DiveUp'))
						{
							if(thePlayer.IsSwimming())
							{
								dest1 = GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetHeadingVector() * (0.625 * mult);
							}

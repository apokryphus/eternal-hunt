				, anchor1, "ACS_Spear_Transform_Toggle_Notification", Vector(0,0,0), 2);

				GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Spear_Transform_Toggle_Notification", 100);

				GetACSStorage().acs_setScaleForOnelinerByTag("ACS_Spear_Transform_Toggle_Notification", 100, 100, 100);

				RemoveTimer('SpearTransformToggleInitDelay'); 

				FactsRemove("ACS_Spear_Transform_Toggle_Notification");
			}

			if (thePlayer.HasTag('ACS_Spear_Transform_Active'))
			{
				vACS_Stance_Switch = new cACS_Stance_Switch in this;

				vACS_Stance_Switch.ACS_Spear_Transform_Switch_Deactivate_Engage();

				thePlayer.RemoveTag('ACS_Spear_Transform_Active');
			}

			return;
		}
		
		if (thePlayer.HasTag('ACS_Spear_Transform_Active')
		)
		{
			if (!ACSGetCEntity('ACS_Spear_Transform_Sword_Steel')
			&& !ACSGetCEntity('ACS_Spear_Transform_Sword_Silver')
			)
			{
				//ACS_Tutorial_Display_Check('ACS_Gwynbleidd_Stance_Tutorial_Shown');

				vACS_Stance_Switch = new cACS_Stance_Switch in this;
	
				vACS_Stance_Switch.ACS_Spear_Transform_Switch_Activate_Engage();
			}

			if( 
			(theGame.IsDialogOrCutscenePlaying() 
			|| thePlayer.IsInNonGameplayCutscene() 
			|| thePlayer.IsInGameplayScene() 
			|| theGame.IsCurrentlyPlayingNonGameplayScene()
			|| theGame.IsFading()
			|| theGame.IsBlackscreen()
			//|| theGame.IsPaused() 
			|| theGame.GetPhotomodeEnabled() 
			|| thePlayer.IsInCutsceneIntro() 
			//|| !thePlayer.IsInCombat()
			|| !thePlayer.IsAnyWeaponHeld() 
			|| thePlayer.IsWeaponHeld('fist') 
			|| thePlayer.IsUsingHorse() 
			|| thePlayer.IsUsingVehicle()
			|| thePlayer.IsSwimming()
			|| thePlayer.IsDiving())
			&& ACS_CombatToExplorationCheck()
			) 
			{
				vACS_Stance_Switch = new cACS_Stance_Switch in this;

				vACS_Stance_Switch.ACS_Spear_Transform_Switch_Deactivate_Engage();

				thePlayer.RemoveTag('ACS_Spear_Transform_Active');
			}
		}
		else
		{
			if (ACSGetCEntity('ACS_Spear_Transform_Sword_Steel')
			|| ACSGetCEntity('ACS_Spear_Transform_Sword_Silver')
			)
			{
				vACS_Stance_Switch = new cACS_Stance_Switch in this;

				vACS_Stance_Switch.ACS_Spear_Transform_Switch_Deactivate_Engage();
			}
		}
	} 

	var changeDirectionR, changeDirectionL : bool;

	function DirectMovementTempDisable()
	{
		if (fast_sprint_activated)
		{
			if (thePlayer.HasTag('ACS_Direct_Movement_Disable'))
			{
				thePlayer.RemoveTag('ACS_Direct_Movement_Disable');
			}

			return;
		}

		if (!thePlayer.HasTag('ACS_Direct_Movement_Disable'))
		{
			thePlayer.AddTag('ACS_Direct_Movement_Disable');
		}

		RemoveTimer('DirectMovementEnable');
		AddTimer('DirectMovementEnable', 0.25 , false);
	}
	
	timer function DirectMovementEnable( time : float , id : int )
	{
		if (thePlayer.HasTag('ACS_Direct_Movement_Disable'))
		{
			thePlayer.RemoveTag('ACS_Direct_Movement_Disable');
		}
	}

	var pLean, pRotation : EulerAngles;

	function Motion_Leaning()
	{
		var cam_direction, lean_roll_modifier 				: float;
		var playerState : name;
		//var targetDistance									: float;

		//targetDistance = VecDistanceSquared2D( GetWitcherPlayer().GetWorldPosition(), (thePlayer.GetHorseWithInventory()).GetWorldPosition() ) ;

		//pRotation = thePlayer.GetWorldRotation();

		//pLean.Pitch = pRotation.Pitch;

		//pLean.Yaw = pRotation.Yaw;

		playerState = thePlayer.substateManager.GetStateCur();

		if ((thePlayer.GetMovingAgentComponent()).GetEnabledFeetIK())
		{
			//(thePlayer.GetMovingAgentComponent()).SetEnabledFeetIK(false,0);
		}

		if (thePlayer.terrainPitch == 90
		|| thePlayer.IsInAir()
		|| !thePlayer.IsOnGround()
		|| playerState == 'Vault'
		|| playerState == 'Climb'
		|| playerState == 'Jump'
		|| playerState == 'Ragdoll'
		|| playerState == 'Slide'
		|| playerState == 'StartFalling'
		|| playerState == 'IdleJump'
		|| playerState == 'AirCollision'
		|| playerState == 'PrepareJump'
		|| playerState == 'TransitionPrepareToJump'
		|| playerState == 'TurnToJump'
		|| playerState == 'Land'
		)
		{
			if ((thePlayer.GetMovingAgentComponent()).GetEnabledFeetIK())
			{
				(thePlayer.GetMovingAgentComponent()).SetEnabledFeetIK(false,0);
			}
		}
		else
		{
			if (!(thePlayer.GetMovingAgentComponent()).GetEnabledFeetIK())
			{
				(thePlayer.GetMovingAgentComponent()).SetEnabledFeetIK(true,0);
			}
		}

		if (theGame.IsDialogOrCutscenePlaying() 
		|| thePlayer.IsInNonGameplayCutscene() 
		|| thePlayer.IsInGameplayScene() 
		|| theGame.IsCurrentlyPlayingNonGameplayScene()
		|| theGame.IsFading()
		|| theGame.IsBlackscreen()
		|| theGame.IsPaused() 
		|| theGame.GetPhotomodeEnabled() 
		|| thePlayer.IsInCutsceneIntro() 
		|| !ACS_Settings_Main_Bool('acs_movement_main_settings','acs_motion_leaning_enabled', true)
		|| thePlayer.HasTag('acs_in_wraith')
		|| FactsQuerySum("ACS_Is_Gliding") > 0
		|| FactsQuerySum("ACS_Has_Double_Jumped") > 0
		|| ACS_New_Replacers_Female_Active()
		|| FactsQuerySum("ACS_Centaur_Active") > 0
		|| thePlayer.IsUsingHorse() 
		|| thePlayer.IsUsingVehicle()
		|| thePlayer.HasTag('ACS_Bruxa_Bite_Process')
		|| thePlayer.GetCurrentStateName() == 'MountTheVehicle'
		|| thePlayer.GetCurrentStateName() == 'ApproachTheVehicle'
		|| thePlayer.GetCurrentStateName() == 'MountHorse'
		|| thePlayer.playerAiming.GetCurrentStateName() == 'Aiming'
		|| thePlayer.IsCrossbowHeld()
		|| thePlayer.HasTag('ACS_GrappleMovingPlayer')
		|| playerState == 'Climb' 
		|| playerState == 'Interaction'
		|| thePlayer.IsInAir()
		|| !thePlayer.IsOnGround()
		//|| targetDistance <= 7
		) 
		{
			if (FactsQuerySum("ACS_Motion_Leaning_Active") > 0
			)
			{
				if(pLean.Roll != 0)
				{
					pLean.Roll = 0;

					((CMovingPhysicalAgentComponent)(thePlayer.GetMovingAgentComponent())).SetRotation(pLean);
				}

				FactsRemove("ACS_Motion_Leaning_Active");
			}

			if (FactsQuerySum("ACS_Motion_Leaning_Reset") > 0)
			{
				FactsRemove("ACS_Motion_Leaning_Reset");
			}

			if (changeDirectionR)
			{
				DirectMovementTempDisable();
				
				changeDirectionR = false;
			}

			if (changeDirectionL)
			{
				DirectMovementTempDisable();
				
				changeDirectionL = false;
			}

			return;
		}

		if (
		thePlayer.IsInCombat()
		|| thePlayer.IsThreatened()
		|| thePlayer.IsSwimming()
		|| thePlayer.IsDiving()
		|| !ACS_CombatToExplorationCheck()
		|| theGame.GetInteractionsManager().GetActiveInteraction()
		) 
		{
			if (FactsQuerySum("ACS_Motion_Leaning_Reset") > 0)
			{
				FactsRemove("ACS_Motion_Leaning_Reset");
			}

			if (FactsQuerySum("ACS_Motion_Leaning_Active") > 0
			&& pLean.Roll == 0
			)
			{
				FactsRemove("ACS_Motion_Leaning_Active");
			}

			if(pLean.Roll < 0)
			{
				pLean.Roll += 0.25;
			}
			else if(pLean.Roll > 0)
			{
				pLean.Roll -= 0.25;
			}
			else
			{
				pLean.Roll = 0;
			}

			if (changeDirectionR)
			{
				DirectMovementTempDisable();
				
				changeDirectionR = false;
			}

			if (changeDirectionL)
			{
				DirectMovementTempDisable();
				
				changeDirectionL = false;
			}

			((CMovingPhysicalAgentComponent)(thePlayer.GetMovingAgentComponent())).SetRotation(pLean);

			return;
		}

		if ( thePlayer.IsPCModeEnabled() )
		{
			cam_direction = theInput.GetActionValue( 'GI_MouseDampX' );
		}
		else
		{
			cam_direction = theInput.GetActionValue( 'GI_AxisRightX' );
		}

		lean_roll_modifier = 0.25f;

		if(thePlayer.GetIsSprinting()
		&& thePlayer.GetSprintingTime() > 2
		&& thePlayer.substateManager.GetStateTimeF() > 3
		&& thePlayer.GetMovingAgentComponent().GetSpeed() > 3 
		)
		{
			if (FactsQuerySum("ACS_Motion_Leaning_Active") <= 0)
			{
				FactsAdd("ACS_Motion_Leaning_Active", 1, -1);
			}

			if( cam_direction < 0 )
			{
				if (FactsQuerySum("ACS_Motion_Leaning_Reset") > 0)
				{
					FactsRemove("ACS_Motion_Leaning_Reset");
				}

				pLean.Roll -= lean_roll_modifier;

				if(pLean.Roll < -15)
				{
					pLean.Roll = -15;
				}

				((CMovingPhysicalAgentComponent)(thePlayer.GetMovingAgentComponent())).SetRotation(pLean);
			}
			else if(theInput.GetActionValue('GI_AxisLeftX') > 0
			)
			{
				if (changeDirectionL)
				{
					changeDirectionL = false;
				}

				if (!changeDirectionR)
				{
					DirectMovementTempDisable();
					
					changeDirectionR = true;
				}

				if(FactsQuerySum("ACS_Motion_Leaning_Reset") > 0
				)
				{
					if(pLean.Roll < 0)
					{
						pLean.Roll += lean_roll_modifier;
					}
					
					if(pLean.Roll > 0)
					{
						pLean.Roll -= lean_roll_modifier;
					}

					((CMovingPhysicalAgentComponent)(thePlayer.GetMovingAgentComponent())).SetRotation(pLean);
				}
				else
				{
					pLean.Roll += lean_roll_modifier;

					if(pLean.Roll > 15)
					{
						pLean.Roll = 15;

						if (FactsQuerySum("ACS_Motion_Leaning_Reset") <= 0)
						{
							FactsAdd("ACS_Motion_Leaning_Reset", 1, -1);
						}
					}

					((CMovingPhysicalAgentComponent)(thePlayer.GetMovingAgentComponent())).SetRotation(pLean);
				}
			}

			if( cam_direction > 0)
			{
				if (FactsQuerySum("ACS_Motion_Leaning_Reset") > 0)
				{
					FactsRemove("ACS_Motion_Leaning_Reset");
				}

				pLean.Roll += lean_roll_modifier;

				if(pLean.Roll > 15)
				{
					pLean.Roll = 15;
				}

				((CMovingPhysicalAgentComponent)(thePlayer.GetMovingAgentComponent())).SetRotation(pLean);
			}
			else if(theInput.GetActionValue('GI_AxisLeftX') < 0
			)
			{
				if (changeDirectionR)
				{
					changeDirectionR = false;
				}

				if (!changeDirectionL)
				{
					DirectMovementTempDisable();
					
					changeDirectionL = true;
				}

				if(FactsQuerySum("ACS_Motion_Leaning_Reset") > 0
				)
				{
					if(pLean.Roll < 0)
					{
						pLean.Roll += lean_roll_modifier;
					}
					
					if(pLean.Roll > 0)
					{
						pLean.Roll -= lean_roll_modifier;
					}

					((CMovingPhysicalAgentComponent)(thePlayer.GetMovingAgentComponent())).SetRotation(pLean);
				}
				else
				{
					pLean.Roll -= lean_roll_modifier;

					if(pLean.Roll < -15)
					{
						pLean.Roll = -15;

						if (FactsQuerySum("ACS_Motion_Leaning_Reset") <= 0)
						{
							FactsAdd("ACS_Motion_Leaning_Reset", 1, -1);
						}
					}

					((CMovingPhysicalAgentComponent)(thePlayer.GetMovingAgentComponent())).SetRotation(pLean);
				}
			}

			if(theInput.GetActionValue('GI_AxisLeftX') == 0
			&& cam_direction == 0
			)
			{
				if (changeDirectionR)
				{
					DirectMovementTempDisable();

					changeDirectionR = false;
				}

				if (changeDirectionL)
				{
					DirectMovementTempDisable();
					
					changeDirectionL = false;
				}

				if (FactsQuerySum("ACS_Motion_Leaning_Reset") > 0)
				{
					FactsRemove("ACS_Motion_Leaning_Reset");
				}

				if(pLean.Roll < 0)
				{
					pLean.Roll += lean_roll_modifier;
				}
				
				if(pLean.Roll > 0)
				{
					pLean.Roll -= lean_roll_modifier;
				}

				((CMovingPhysicalAgentComponent)(thePlayer.GetMovingAgentComponent())).SetRotation(pLean);
			}
		}
		else if(thePlayer.GetIsRunning()
		&& thePlayer.substateManager.GetStateTimeF() > 3
		)
		{
			if (FactsQuerySum("ACS_Motion_Leaning_Active") <= 0)
			{
				FactsAdd("ACS_Motion_Leaning_Active", 1, -1);
			}

			if( cam_direction < 0 )
			{
				if (FactsQuerySum("ACS_Motion_Leaning_Reset") > 0)
				{
					FactsRemove("ACS_Motion_Leaning_Reset");
				}

				pLean.Roll -= lean_roll_modifier;

				if(pLean.Roll < -10)
				{
					pLean.Roll = -10;
				}

				((CMovingPhysicalAgentComponent)(thePlayer.GetMovingAgentComponent())).SetRotation(pLean);
			}
			else if(theInput.GetActionValue('GI_AxisLeftX') > 0
			)
			{
				if (changeDirectionL)
				{
					changeDirectionL = false;
				}

				if (!changeDirectionR)
				{
					DirectMovementTempDisable();
					
					changeDirectionR = true;
				}

				if(FactsQuerySum("ACS_Motion_Leaning_Reset") > 0
				)
				{
					if(pLean.Roll < 0)
					{
						pLean.Roll += lean_roll_modifier;
					}
					
					if(pLean.Roll > 0)
					{
						pLean.Roll -= lean_roll_modifier;
					}

					((CMovingPhysicalAgentComponent)(thePlayer.GetMovingAgentComponent())).SetRotation(pLean);
				}
				else
				{
					pLean.Roll += lean_roll_modifier;

					if(pLean.Roll > 10)
					{
						pLean.Roll = 10;

						if (FactsQuerySum("ACS_Motion_Leaning_Reset") <= 0)
						{
							FactsAdd("ACS_Motion_Leaning_Reset", 1, -1);
						}
					}

					((CMovingPhysicalAgentComponent)(thePlayer.GetMovingAgentComponent())).SetRotation(pLean);
				}
			}

			if( cam_direction > 0)
			{
				if (FactsQuerySum("ACS_Motion_Leaning_Reset") > 0)
				{
					FactsRemove("ACS_Motion_Leaning_Reset");
				}

				pLean.Roll += lean_roll_modifier;

				if(pLean.Roll > 10)
				{
					pLean.Roll = 10;
				}

				((CMovingPhysicalAgentComponent)(thePlayer.GetMovingAgentComponent())).SetRotation(pLean);
			}
			else if(theInput.GetActionValue('GI_AxisLeftX') < 0
			)
			{
				if (changeDirectionR)
				{
					changeDirectionR = false;
				}

				if (!changeDirectionL)
				{
					DirectMovementTempDisable();
					
					changeDirectionL = true;
				}

				if(FactsQuerySum("ACS_Motion_Leaning_Reset") > 0
				)
				{
					if(pLean.Roll < 0)
					{
						pLean.Roll += lean_roll_modifier;
					}
					
					if(pLean.Roll > 0)
					{
						pLean.Roll -= lean_roll_modifier;
					}

					((CMovingPhysicalAgentComponent)(thePlayer.GetMovingAgentComponent())).SetRotation(pLean);
				}
				else
				{
					pLean.Roll -= lean_roll_modifier;

					if(pLean.Roll < -10)
					{
						pLean.Roll = -10;

						if (FactsQuerySum("ACS_Motion_Leaning_Reset") <= 0)
						{
							FactsAdd("ACS_Motion_Leaning_Reset", 1, -1);
						}
					}

					((CMovingPhysicalAgentComponent)(thePlayer.GetMovingAgentComponent())).SetRotation(pLean);
				}
			}

			if(theInput.GetActionValue('GI_AxisLeftX') == 0
			&& cam_direction == 0
			)
			{
				if (changeDirectionR)
				{
					DirectMovementTempDisable();
					
					changeDirectionR = false;
				}

				if (changeDirectionL)
				{
					DirectMovementTempDisable();
					
					changeDirectionL = false;
				}

				if (FactsQuerySum("ACS_Motion_Leaning_Reset") > 0)
				{
					FactsRemove("ACS_Motion_Leaning_Reset");
				}

				if(pLean.Roll < 0)
				{
					pLean.Roll += lean_roll_modifier;
				}
				
				if(pLean.Roll > 0)
				{
					pLean.Roll -= lean_roll_modifier;
				}

				((CMovingPhysicalAgentComponent)(thePlayer.GetMovingAgentComponent())).SetRotation(pLean);
			}
		}
		else
		{
			if (FactsQuerySum("ACS_Motion_Leaning_Reset") > 0)
			{
				FactsRemove("ACS_Motion_Leaning_Reset");
			}

			if (FactsQuerySum("ACS_Motion_Leaning_Active") > 0
			&& pLean.Roll == 0
			)
			{
				FactsRemove("ACS_Motion_Leaning_Active");
			}

			if(pLean.Roll < 0)
			{
				pLean.Roll += 0.25;
			}
			else if(pLean.Roll > 0)
			{
				pLean.Roll -= 0.25;
			}
			else
			{
				pLean.Roll = 0;
			}

			if (changeDirectionR)
			{
				DirectMovementTempDisable();
				
				changeDirectionR = false;
			}

			if (changeDirectionL)
			{
				DirectMovementTempDisable();
				
				changeDirectionL = false;
			}

			((CMovingPhysicalAgentComponent)(thePlayer.GetMovingAgentComponent())).SetRotation(pLean);
		}
	}

	function Guiding_Light_Navigation_Guide()
	{
		var ent																: ACSNavigationGuide;
		var rot, cameraRot 													: EulerAngles;
		var pos																: Vector;

		if (theInput.GetActionValue('Focus') > 0.1f
		&& theGame.GetFocusModeController().CanUseFocusMode()
		&& thePlayer.IsOnGround()
		&& FactsQuerySum("ACS_Wisp_Released") > 0
		)
		{
			if (!ACSGetCEntity('ACS_Guiding_Light_Navigation_Guide')
			&& FactsQuerySum("ACS_Guiding_Light_Navigation_Guide_Spawned") <= 0
			)
			{
				if (thePlayer.IsUsingHorse()
				|| thePlayer.IsUsingVehicle()
				)
				{
					pos = ACSFixZAxis(theCamera.GetCameraPosition() + theCamera.GetCameraDirection() * 15);
				}
				else
				{
					if (thePlayer.GetIsSprinting())
					{
						pos = ACSFixZAxis(theCamera.GetCameraPosition() + theCamera.GetCameraDirection() * 10);
					}
					else
					{
						if (thePlayer.GetIsWalking())
						{
							pos = ACSFixZAxis(theCamera.GetCameraPosition() + theCamera.GetCameraDirection() * 7.5);
						}
						else
						{
							pos = ACSFixZAxis(theCamera.GetCameraPosition() + theCamera.GetCameraDirection() * 5);
						}
					}
				}

				rot = thePlayer.GetWorldRotation();

				cameraRot = theCamera.GetCameraRotation();

				rot.Yaw = cameraRot.Yaw;
				rot.Pitch = 0;
				rot.Roll = 0;

				ent = (ACSNavigationGuide)theGame.CreateEntity( 

				(CEntityTemplate)LoadResource( 
					
				"dlc\dlc_acs\data\entities\other\navigation_guide.w2ent"
				
				, true ), 
				
				ACSFixZAxis(pos), 

				rot );

				ent.AddTag('ACS_Guiding_Light_Navigation_Guide');

				FactsAdd("ACS_Guiding_Light_Navigation_Guide_Spawned", 1, -1);
			}
		}
		else
		{
			if (ACSGetCEntity('ACS_Guiding_Light_Navigation_Guide')
			&& FactsQuerySum("ACS_Guiding_Light_Navigation_Guide_Spawned") > 0
			)
			{
				ACSGetCEntity('ACS_Guiding_Light_Navigation_Guide').Destroy();

				FactsRemove("ACS_Guiding_Light_Navigation_Guide_Spawned");
			}
		}
	}

	function ACS_Horse_Lamp_Control()
	{
		var horse 											: CNewNPC;
		var boneIndex 										: int;
		var boneName 										: name;
		var boneRotation									: EulerAngles;
		var bonePosition									: Vector;
		var anchor, lamp									: CEntity;
		var comp1 											: CLightComponent;
		var comp2 											: CSpotLightComponent;
		var comp3 											: CPointLightComponent;
		var boat											: W3Boat;

		if( 
		theGame.IsDialogOrCutscenePlaying() 
		|| !thePlayer.IsAlive()
		|| thePlayer.IsInCutsceneIntro()
		|| theGame.HasBlackscreenRequested()
		|| theGame.IsCurrentlyPlayingNonGameplayScene()
		|| theGame.GetGuiManager().IsAnyMenu()
		|| theGame.GetTutorialSystem().HasActiveTutorial()
		|| theGame.GetPhotomodeEnabled() 
		|| thePlayer.IsInCutsceneIntro() 
		)
		{
			if (ACSGetCEntity('ACS_Horse_Oil_Lamp_Anchor'))
			{
				ACSGetCEntity('ACS_Horse_Oil_Lamp_Anchor').Destroy();
			}

			if (ACSGetCEntity('ACS_Horse_Oil_Lamp_Day'))
			{
				ACSGetCEntity('ACS_Horse_Oil_Lamp_Day').Destroy();
			}

			if (ACSGetCEntity('ACS_Horse_Oil_Lamp_Night'))
			{
				ACSGetCEntity('ACS_Horse_Oil_Lamp_Night').Destroy();
			}
		}
		else
		{
			if (FactsQuerySum("ACS_Lantern_Stowed_On_Horse") > 0)
			{
				horse = thePlayer.GetHorseWithInventory();

				if (!ACSGetCEntity('ACS_Horse_Oil_Lamp_Anchor') && horse)
				{
					anchor = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource("dlc\dlc_acs\data\entities\other\fx_ent.w2ent", true), horse.GetWorldPosition(), horse.GetWorldRotation() );
					anchor.AddTag('ACS_Horse_Oil_Lamp_Anchor');

					boneIndex = horse.GetBoneIndex( 'spine3' );	
					horse.GetBoneWorldPositionAndRotationByIndex( boneIndex, bonePosition, boneRotation );
					anchor.CreateAttachmentAtBoneWS(horse, 'spine3', bonePosition, boneRotation );
				}

				if (ACS_IsInDarkPlace() || FactsQuerySum("ACS_Darkness_Upon_Us") > 0)
				{
					if (ACSGetCEntity('ACS_Horse_Oil_Lamp_Day'))
					{
						ACSGetCEntity('ACS_Horse_Oil_Lamp_Day').Destroy();
					}

					if (!ACSGetCEntity('ACS_Horse_Oil_Lamp_Night') && ACSGetCEntity('ACS_Horse_Oil_Lamp_Anchor') && horse )
					{
						lamp = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource("dlc\dlc_acs\data\entities\other\horse_lantern.w2ent", true), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );
						lamp.AddTag('ACS_Horse_Oil_Lamp_Night');
						lamp.CreateAttachment(ACSGetCEntity('ACS_Horse_Oil_Lamp_Anchor'), , Vector( 0.5, 0.45, 0 ), EulerAngles(90,95,-90));
						lamp.PlayEffect('light_on');
						lamp.PlayEffect('fire');
					}
				}
				else
				{
					if (ACSGetCEntity('ACS_Horse_Oil_Lamp_Night'))
					{
						ACSGetCEntity('ACS_Horse_Oil_Lamp_Night').Destroy();
					}

					if (!ACSGetCEntity('ACS_Horse_Oil_Lamp_Day') && ACSGetCEntity('ACS_Horse_Oil_Lamp_Anchor') && horse )
					{
						lamp = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource("dlc\dlc_acs\data\entities\other\horse_lantern_dummy.w2ent", true), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );
						lamp.AddTag('ACS_Horse_Oil_Lamp_Day');
						lamp.CreateAttachment(ACSGetCEntity('ACS_Horse_Oil_Lamp_Anchor'), , Vector( 0.5, 0.45, 0 ), EulerAngles(90,95,-90));
					}
				}
			}
			else
			{
				if (ACSGetCEntity('ACS_Horse_Oil_Lamp_Anchor'))
				{
					ACSGetCEntity('ACS_Horse_Oil_Lamp_Anchor').Destroy();
				}

				if (ACSGetCEntity('ACS_Horse_Oil_Lamp_Day'))
				{
					ACSGetCEntity('ACS_Horse_Oil_Lamp_Day').Destroy();
				}

				if (ACSGetCEntity('ACS_Horse_Oil_Lamp_Night'))
				{
					ACSGetCEntity('ACS_Horse_Oil_Lamp_Night').Destroy();
				}
			}
		}
	}

	private var sword_taunt_index_1							: int;
	private var previous_sword_taunt_index_1 				: int; 

	timer function SwordTauntSwitch( time : float , id : int )
	{
		if (thePlayer.IsAnyWeaponHeld()
		&& !thePlayer.IsWeaponHeld('fist')
		//&& AnimProgressCheck()
		&& !thePlayer.HasTag('acs_aard_sword_equipped')
		&& thePlayer.IsOnGround()
		&& thePlayer.GetStat(BCS_Vitality) > thePlayer.GetStatMax(BCS_Vitality) * 0.3
		&& FactsQuerySum("ACS_Player_Extended_Remains_Looting_Start") <= 0
		&& FactsQuerySum("ACS_Player_Remains_Looting_Start") <= 0
		&& theGame.GetEngineTimeAsSeconds() - last_sword_taunt_time > 1.5
		&& !thePlayer.IsFalling()
		&& !thePlayer.IsInAir()
		&& !horseLeapStrikeProcess
		&& FactsQuerySum("ACS_Slayer_Active") <= 0
		&& FactsQuerySum("ACS_Azkar_Active") <= 0
		)
		{
			last_sword_taunt_time = theGame.GetEngineTimeAsSeconds();

			if (idleAdditiveExtraActive)
			{
				thePlayer.RaiseEvent('ACS_IdleAdditiveReset');

				SetIdleAdditiveExtraStatus(false);
			}

			switch (ACS_Settings_Main_Int('acs_taunt_settings','acs_sword_flair', 1)) 
			{	
				case 2:
				sword_taunt_index_1 = RandDifferent(this.previous_sword_taunt_index_1 , 12);

				switch (sword_taunt_index_1) 
				{	
					case 11:
					thePlayer.RaiseEvent('ACS_SwordTaunt12');
					break;

					case 10:
					thePlayer.RaiseEvent('ACS_SwordTaunt11');
					break;

					case 9:
					thePlayer.RaiseEvent('ACS_SwordTaunt10');
					break;

					case 8:
					thePlayer.RaiseEvent('ACS_SwordTaunt09');
					break;

					case 7:
					thePlayer.RaiseEvent('ACS_SwordTaunt08');
					break;

					case 6:
					thePlayer.RaiseEvent('ACS_SwordTaunt07');
					break;

					case 5:
					thePlayer.RaiseEvent('ACS_SwordTaunt06');
					break;

					case 4:
					thePlayer.RaiseEvent('ACS_SwordTaunt05');
					break;

					case 3:
					thePlayer.RaiseEvent('ACS_SwordTaunt04');
					break;

					case 2:
					thePlayer.RaiseEvent('ACS_SwordTaunt03');
					break;

					case 1:
					thePlayer.RaiseEvent('ACS_SwordTaunt02');
					break;

					default:
					thePlayer.RaiseEvent('ACS_SwordTaunt01');
					break;
				}
			
				this.previous_sword_taunt_index_1 = sword_taunt_index_1;
				break;

				case 1:
				sword_taunt_index_1 = RandDifferent(this.previous_sword_taunt_index_1 , 8);

				switch (sword_taunt_index_1) 
				{	
					case 7:
					thePlayer.RaiseEvent('ACS_SwordTaunt12');
					break;

					case 6:
					thePlayer.RaiseEvent('ACS_SwordTaunt11');
					break;

					case 5:
					thePlayer.RaiseEvent('ACS_SwordTaunt10');
					break;

					case 4:
					thePlayer.RaiseEvent('ACS_SwordTaunt09');
					break;

					case 3:
					thePlayer.RaiseEvent('ACS_SwordTaunt08');
					break;

					case 2:
					thePlayer.RaiseEvent('ACS_SwordTaunt07');
					break;

					case 1:
					thePlayer.RaiseEvent('ACS_SwordTaunt02');
					break;

					default:
					thePlayer.RaiseEvent('ACS_SwordTaunt01');
					break;
				}
			
				this.previous_sword_taunt_index_1 = sword_taunt_index_1;
				break;

				case 0:
				thePlayer.RaiseEvent('ACS_SwordTauntEnd');
				break;

				default:
				thePlayer.RaiseEvent('ACS_SwordTauntEnd');
				break;
			}

			IdleAdditiveBlockTemp();

			if (thePlayer.GetInventory().ItemHasTag( thePlayer.GetInventory().GetCurrentlyHeldSword(), 'Aerondight' ))
			{
				aerondight_sword_trail();
			}
		}
	}

	private var sword_taunt_running_index_1							: int;
	private var previous_sword_taunt_running_index_1 				: int; 

	timer function SwordTauntRunningSwitch( time : float , id : int )
	{
		if (thePlayer.IsAnyWeaponHeld()
		&& !thePlayer.IsWeaponHeld('fist')
		//&& AnimProgressCheck()
		&& !thePlayer.HasTag('acs_aard_sword_equipped')
		&& thePlayer.GetStat(BCS_Vitality) > thePlayer.GetStatMax(BCS_Vitality) * 0.3
		&& FactsQuerySum("ACS_Player_Extended_Remains_Looting_Start") <= 0
		&& FactsQuerySum("ACS_Player_Remains_Looting_Start") <= 0
		&& theGame.GetEngineTimeAsSeconds() - last_sword_taunt_time > 1.5
		&& !horseLeapStrikeProcess
		&& !thePlayer.IsFalling()
		&& !thePlayer.IsInAir()
		&& FactsQuerySum("ACS_Slayer_Active") <= 0
		&& FactsQuerySum("ACS_Azkar_Active") <= 0
		)
		{
			last_sword_taunt_time = theGame.GetEngineTimeAsSeconds();

			SwordTauntRunningSwitch_Actual();
		}
	}

	timer function SwordTauntRunningSwitchSecondary( time : float , id : int )
	{
		if( 
		theGame.IsDialogOrCutscenePlaying() 
		|| !thePlayer.IsAlive()
		|| thePlayer.IsInCutsceneIntro()
		|| theGame.HasBlackscreenRequested()
		|| theGame.IsCurrentlyPlayingNonGameplayScene()
		|| theGame.GetGuiManager().IsAnyMenu()
		|| theGame.GetTutorialSystem().HasActiveTutorial()
		|| theGame.GetPhotomodeEnabled() 
		|| thePlayer.IsInCutsceneIntro() 
		|| thePlayer.IsInAir()
		|| horseLeapStrikeProcess
		|| FactsQuerySum("ACS_Player_Extended_Remains_Looting_Start") > 0
		|| FactsQuerySum("ACS_Player_Remains_Looting_Start") > 0
		|| thePlayer.IsFalling()
		|| ACS_IS_SNEAKING
		|| thePlayer.HasTag('ACS_Is_Sneaking')
		|| FactsQuerySum("ACS_Slayer_Active") > 0
		|| FactsQuerySum("ACS_Azkar_Active") > 0
		)
		{
			RemoveTimer('CombatTauntDelay');RemoveTimer('SwordTauntRunningSwitchSecondary');
			return;
		}

		RemoveTimer('CombatTauntDelay'); 

		if( 
		theGame.IsDialogOrCutscenePlaying() 
		|| theGame.GetPhotomodeEnabled() 
		|| thePlayer.IsInCutsceneIntro() 
		|| !thePlayer.IsAlive()
		|| thePlayer.IsInCutsceneIntro()
		|| theGame.HasBlackscreenRequested()
		|| theGame.IsCurrentlyPlayingNonGameplayScene()
		|| theGame.GetGuiManager().IsAnyMenu()
		|| theGame.GetTutorialSystem().HasActiveTutorial()
		|| !thePlayer.IsThreatened()
		|| !thePlayer.IsInCombat()
		//|| thePlayer.IsCastingSign()
		//|| theInput.GetActionValue('CastSign') > 0.1f 
		|| GetWitcherPlayer().IsCurrentSignChanneled()
		|| GetWitcherPlayer().GetIsSprinting()
		|| thePlayer.IsAttackerAtBack((CNewNPC)thePlayer.GetTarget())
		|| thePlayer.HasTag('ACS_Player_Is_Attacking')
		|| FactsQuerySum("ACS_Player_Extended_Remains_Looting_Start") > 0
		|| FactsQuerySum("ACS_Player_Remains_Looting_Start") > 0
		|| horseLeapStrikeProcess
		|| thePlayer.IsFalling()
		|| thePlayer.IsInAir()
		|| ACS_IS_SNEAKING
		|| thePlayer.HasTag('ACS_Is_Sneaking')
		|| FactsQuerySum("ACS_Slayer_Active") > 0
		|| FactsQuerySum("ACS_Azkar_Active") > 0
		)
		{
			
		}
		else
		{
			AddTimer('CombatTauntDelay', 1 , false); 
		}
		
		SwordTauntRunningSwitch_Actual();
	}

	timer function CombatTauntDelay( time : float , id : int )
	{
		if( 
		theGame.IsDialogOrCutscenePlaying() 
		|| theGame.GetPhotomodeEnabled() 
		|| thePlayer.IsInCutsceneIntro() 
		|| !thePlayer.IsAlive()
		|| thePlayer.IsInCutsceneIntro()
		|| theGame.HasBlackscreenRequested()
		|| theGame.IsCurrentlyPlayingNonGameplayScene()
		|| theGame.GetGuiManager().IsAnyMenu()
		|| theGame.GetTutorialSystem().HasActiveTutorial()
		|| !thePlayer.IsThreatened()
		|| !thePlayer.IsInCombat()
		//|| thePlayer.IsCastingSign()
		//|| theInput.GetActionValue('CastSign') > 0.1f 
		|| GetWitcherPlayer().IsCurrentSignChanneled()
		|| GetWitcherPlayer().GetIsSprinting()
		|| thePlayer.IsAttackerAtBack((CNewNPC)thePlayer.GetTarget())
		|| thePlayer.HasTag('ACS_Player_Is_Attacking')
		|| FactsQuerySum("ACS_Player_Extended_Remains_Looting_Start") > 0
		|| FactsQuerySum("ACS_Player_Remains_Looting_Start") > 0
		|| ACSGetCEntity('ACS_Viper_Dagger_L')
		|| horseLeapStrikeProcess
		|| thePlayer.IsFalling()
		|| thePlayer.IsInAir()
		|| ACS_IS_SNEAKING
		|| thePlayer.HasTag('ACS_Is_Sneaking')
		|| !AnimProgressCheck()
		|| FactsQuerySum("ACS_Slayer_Active") > 0
		|| FactsQuerySum("ACS_Azkar_Active") > 0
		)
		{
			RemoveTimer('CombatTauntDelay');
			return;
		}

		if(thePlayer.GetCombatIdleStance() <= 0.f )
		{
			thePlayer.RaiseEvent('ACS_CombatTauntLeft');
		}
		else
		{
			thePlayer.RaiseEvent('ACS_CombatTauntRight');
		}
	}

	var last_sword_taunt_time			: float;

	//var sword_taunt_cooldown			: float;

	//default sword_taunt_cooldown = 1.5;

	function SwordTauntRunningSwitch_Actual()
	{
		if (thePlayer.IsAnyWeaponHeld()
		&& !thePlayer.IsWeaponHeld('fist')
		//&& AnimProgressCheck()
		&& !thePlayer.HasTag('acs_aard_sword_equipped')
		//&& thePlayer.IsOnGround()
		&& thePlayer.GetStat(BCS_Vitality) > thePlayer.GetStatMax(BCS_Vitality) * 0.3
		&& FactsQuerySum("ACS_Player_Extended_Remains_Looting_Start") <= 0
		&& FactsQuerySum("ACS_Player_Remains_Looting_Start") <= 0
		&& !horseLeapStrikeProcess
		&& !thePlayer.IsFalling()
		&& !thePlayer.IsInAir()
		&& FactsQuerySum("ACS_Slayer_Active") <= 0
		&& FactsQuerySum("ACS_Azkar_Active") <= 0
		)
		{
			if (idleAdditiveExtraActive)
			{
				thePlayer.RaiseEvent('ACS_IdleAdditiveReset');

				SetIdleAdditiveExtraStatus(false);
			}

			switch (ACS_Settings_Main_Int('acs_taunt_settings','acs_sword_flair', 1)) 
			{	
				case 2:
				sword_taunt_running_index_1 = RandDifferent(this.previous_sword_taunt_running_index_1 , 12);

				switch (sword_taunt_running_index_1) 
				{	
					case 11:
					thePlayer.RaiseEvent('ACS_SwordTaunt12');
					break;

					case 10:
					thePlayer.RaiseEvent('ACS_SwordTaunt11');
					break;

					case 9:
					thePlayer.RaiseEvent('ACS_SwordTaunt10');
					break;

					case 8:
					thePlayer.RaiseEvent('ACS_SwordTaunt09');
					break;

					case 7:
					thePlayer.RaiseEvent('ACS_SwordTaunt08');
					break;

					case 6:
					thePlayer.RaiseEvent('ACS_SwordTaunt07');
					break;

					case 5:
					thePlayer.RaiseEvent('ACS_SwordTaunt06');
					break;

					case 4:
					thePlayer.RaiseEvent('ACS_SwordTaunt05');
					break;

					case 3:
					thePlayer.RaiseEvent('ACS_SwordTaunt04');
					break;

					case 2:
					thePlayer.RaiseEvent('ACS_SwordTaunt03');
					break;

					case 1:
					thePlayer.RaiseEvent('ACS_SwordTaunt02');
					break;

					default:
					thePlayer.RaiseEvent('ACS_SwordTaunt01');
					break;
				}
			
				this.previous_sword_taunt_running_index_1 = sword_taunt_running_index_1;
				break;

				case 1:
				sword_taunt_running_index_1 = RandDifferent(this.previous_sword_taunt_running_index_1 , 8);

				switch (sword_taunt_running_index_1) 
				{	
					case 7:
					thePlayer.RaiseEvent('ACS_SwordTaunt12');
					break;

					case 6:
					thePlayer.RaiseEvent('ACS_SwordTaunt11');
					break;

					case 5:
					thePlayer.RaiseEvent('ACS_SwordTaunt10');
					break;

					case 4:
					thePlayer.RaiseEvent('ACS_SwordTaunt07');
					break;

					case 3:
					thePlayer.RaiseEvent('ACS_SwordTaunt09');
					break;

					case 2:
					thePlayer.RaiseEvent('ACS_SwordTaunt08');
					break;

					case 1:
					thePlayer.RaiseEvent('ACS_SwordTaunt02');
					break;

					default:
					thePlayer.RaiseEvent('ACS_SwordTaunt01');
					break;
				}
			
				this.previous_sword_taunt_running_index_1 = sword_taunt_running_index_1;
				break;

				case 0:
				thePlayer.RaiseEvent('ACS_SwordTauntEnd');
				break;

				default:
				thePlayer.RaiseEvent('ACS_SwordTauntEnd');
				break;
			}

			IdleAdditiveBlockTemp();

			if (thePlayer.HasTag('ACS_HasPerformedFinisher'))
			{
				weapon_blood_fx('red');

				thePlayer.RemoveTag('ACS_HasPerformedFinisher');
			}

			if (thePlayer.GetInventory().ItemHasTag( thePlayer.GetInventory().GetCurrentlyHeldSword(), 'Aerondight' ))
			{
				aerondight_sword_trail();
			}
		}
	}

	timer function SwordTauntRunningSwitchSecondaryWeaponBlood( time : float , id : int )
	{
		if (thePlayer.IsAnyWeaponHeld()

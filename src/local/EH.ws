			}

			if (ACSGetCActor('ACS_Transformation_Giant').IsEffectActive('critical_burning_ex'))
			{
				ACSGetCActor('ACS_Transformation_Giant').DestroyEffect('critical_burning_ex');
			}

			if (ACSGetCActor('ACS_Transformation_Giant').IsEffectActive('critical_burning_ex_r'))
			{
				ACSGetCActor('ACS_Transformation_Giant').DestroyEffect('critical_burning_ex_r');
			}

			if (ACSGetCActor('ACS_Transformation_Giant').IsEffectActive('critical_burning_ex_l'))
			{
				ACSGetCActor('ACS_Transformation_Giant').DestroyEffect('critical_burning_ex_l');
			}

			if (ACSGetCActor('ACS_Transformation_Giant').IsEffectActive('lugos_vision_burning'))
			{
				ACSGetCActor('ACS_Transformation_Giant').DestroyEffect('lugos_vision_burning');
			}

			if (ACSGetCActor('ACS_Transformation_Giant').IsEffectActive('lugos_vision_burning_mat'))
			{
				ACSGetCActor('ACS_Transformation_Giant').DestroyEffect('lugos_vision_burning_mat');
			}

			if (ACSGetCActor('ACS_Transformation_Giant').IsEffectActive('lugos_vision_burning_gp'))
			{
				ACSGetCActor('ACS_Transformation_Giant').DestroyEffect('lugos_vision_burning_gp');
			}

			if (ACSGetCActor('ACS_Transformation_Giant').IsEffectActive('burning_body'))
			{
				ACSGetCActor('ACS_Transformation_Giant').DestroyEffect('burning_body');
			}

		}
		
		ACSGetCActor('ACS_Transformation_Giant').GetMovingAgentComponent().EnableCombatMode( true );
		
		if (theGame.GetEngineTimeAsSeconds() - last_transformation_giant_taunt_time > RandRangeF(15,7.5))
		{
			last_transformation_giant_taunt_time = theGame.GetEngineTimeAsSeconds();

			if (
			!ACSGetCActor('ACS_Transformation_Giant').HasTag('ACS_Transformation_Giant_Weapon_Mode')
			&& !ACSGetCActor('ACS_Transformation_Giant').HasTag('ACS_Transformation_Giant_Performed_Action')
			&& !ACSGetCActor('ACS_Transformation_Giant').HasTag('ACS_Transformation_Giant_Is_Parrying')
			)
			{
				if (thePlayer.IsInCombat())
				{
					if (RandF() < 0.5)
					{
						//((CNewNPC)ACSGetCActor('ACS_Transformation_Giant')).SetBehaviorVariable( 'targetAngleDiff', RandRange(1,9), true );
						
						((CAnimatedComponent)((CNewNPC)ACSGetCActor('ACS_Transformation_Giant')).GetComponentByClassName( 'CAnimatedComponent' )).RaiseBehaviorForceEvent('AttackOverride');
					}
					else
					{
						((CAnimatedComponent)((CNewNPC)ACSGetCActor('ACS_Transformation_Giant')).GetComponentByClassName( 'CAnimatedComponent' )).RaiseBehaviorForceEvent('TauntOverride');

						ACSGetCActor('ACS_Transformation_Giant').SoundEvent('monster_him_vo_pain_ALWAYS');
					}
				}
				else
				{
					((CAnimatedComponent)((CNewNPC)ACSGetCActor('ACS_Transformation_Giant')).GetComponentByClassName( 'CAnimatedComponent' )).RaiseBehaviorForceEvent('TauntOverride');

					ACSGetCActor('ACS_Transformation_Giant').SoundEvent('monster_him_vo_pain_ALWAYS');
				}
			}
		}

		if (ACSGetCActor('ACS_Transformation_Giant').HasTag('ACS_Transformation_Giant_Is_Parrying') 
		&& thePlayer.GetStat(BCS_Focus) >= thePlayer.GetStatMax( BCS_Focus ) * 0.9875
		&& thePlayer.GetStat(BCS_Stamina) != 0
		)
		{
			if (!ACSGetCActor('ACS_Transformation_Giant').HasTag('ACS_Transformation_Giant_Tesla_Coil_Active'))
			{
				RemoveTimer('TransformationGiantTeslaCoil');
				AddTimer('TransformationGiantTeslaCoil', 0.125f , true);

				ACSGetCActor('ACS_Transformation_Giant').AddTag('ACS_Transformation_Giant_Tesla_Coil_Active');
			}
		}
		else
		{
			if (ACSGetCActor('ACS_Transformation_Giant').HasTag('ACS_Transformation_Giant_Tesla_Coil_Active'))
			{
				RemoveTimer('TransformationGiantTeslaCoil');
				
				if (thePlayer.GetStat(BCS_Stamina) == 0
				)
				{
					GetWitcherPlayer().DrainFocus( GetWitcherPlayer().GetStatMax( BCS_Focus ) * 0.33 );
				}

				ACSGetCActor('ACS_Transformation_Giant').RemoveTag('ACS_Transformation_Giant_Tesla_Coil_Active');
			}
		}

		if (thePlayer.IsInCombat())
		{
			if (thePlayer.GetTarget())
			{
				lookatPos = ((CActor)(thePlayer.GetTarget())).GetWorldPosition();
			}
			else
			{
				lookatPos = ACSGetCEntity('acs_lookat_entity').GetWorldPosition();

				lookatPos.Z -= 10;
			}
		}
		else
		{
			lookatPos = ACSGetCEntity('acs_lookat_entity').GetWorldPosition();

			lookatPos.Z -= 10;
		}

		((CNewNPC)ACSGetCActor('ACS_Transformation_Giant')).SetBehaviorVectorVariable( 'lookAtTarget', lookatPos );

		if (((CNewNPC)ACSGetCActor('ACS_Transformation_Giant')).GetBehaviorVariable( 'lookatOn' ) != 1)
		{
			((CNewNPC)ACSGetCActor('ACS_Transformation_Giant')).SetBehaviorVariable( 'lookatOn', 1, true );
		}

		if (thePlayer.IsCurrentlyDodging() 
		)
		{
			ACSGetCActor('ACS_Transformation_Giant').GetMovingAgentComponent().ForceSetRelativeMoveSpeed( 0 );
			ACSGetCActor('ACS_Transformation_Giant').GetMovingAgentComponent().SetGameplayRelativeMoveSpeed( 0 );
			return;
		}

		if (theInput.GetActionValue('GI_AxisLeftX') == 0 && theInput.GetActionValue('GI_AxisLeftY') == 0 )
		{
			ACSGetCActor('ACS_Transformation_Giant').GetMovingAgentComponent().ForceSetRelativeMoveSpeed( 0 );
			ACSGetCActor('ACS_Transformation_Giant').GetMovingAgentComponent().SetGameplayRelativeMoveSpeed( 0 );
		}
		else
		{
			ACSGetCActor('ACS_Transformation_Giant').GetMovingAgentComponent().SetGameplayMoveDirection(VecHeading(ACSGetCActor('ACS_Transformation_Giant').GetHeadingVector()));

			ACSGetCActor('ACS_Transformation_Giant').GetMovingAgentComponent().SetGameplayRelativeMoveSpeed(1); 

			Transformation_Giant_Sprint_Modifier();

			if (ACSGetCActor('ACS_Transformation_Giant').HasTag('ACS_Transformation_Giant_Anim_Initiated'))
			{
				ACSTransformationGiantPlayAnim( '', 0.125f, 0.125f);

				ACSGetCActor('ACS_Transformation_Giant').RemoveTag('ACS_Transformation_Giant_Anim_Initiated');
			}

			if (theInput.GetActionValue('GI_AxisLeftY') > 0.1 && theInput.GetActionValue('GI_AxisLeftX') == 0 )
			{
				ACSTransformationGiantMovementAdjust('forward', false);
			}
			else if (theInput.GetActionValue('GI_AxisLeftY') < -0.1 && theInput.GetActionValue('GI_AxisLeftX') == 0 )
			{	
				ACSTransformationGiantMovementAdjust('backward', false);
			}
			else if (theInput.GetActionValue('GI_AxisLeftX') > 0.1 && theInput.GetActionValue('GI_AxisLeftY') == 0 )
			{
				ACSTransformationGiantMovementAdjust('right', false);
			}
			else if (theInput.GetActionValue('GI_AxisLeftX') < -0.1 && theInput.GetActionValue('GI_AxisLeftY') == 0 )
			{
				ACSTransformationGiantMovementAdjust('left', false);
			}
			else if (theInput.GetActionValue('GI_AxisLeftY') > 0.1 && theInput.GetActionValue('GI_AxisLeftX') > 0.1 )
			{
				ACSTransformationGiantMovementAdjust('forwardright', false);
			}
			else if (theInput.GetActionValue('GI_AxisLeftY') > 0.1 && theInput.GetActionValue('GI_AxisLeftX') < -0.1 )
			{
				ACSTransformationGiantMovementAdjust('forwardleft', false);
			}
			else if (theInput.GetActionValue('GI_AxisLeftY') < -0.1 && theInput.GetActionValue('GI_AxisLeftX') > 0.1 )
			{
				ACSTransformationGiantMovementAdjust('backright', false);
			}
			else if (theInput.GetActionValue('GI_AxisLeftX') < -0.1 && theInput.GetActionValue('GI_AxisLeftY') < -0.1 )
			{
				ACSTransformationGiantMovementAdjust('backleft', false);
			}
		}
	}

	public timer function Transformation_Giant_Remove_Action_Tag ( dt : float, id : int) 
	{
		ACSGetCActor('ACS_Transformation_Giant').RemoveTag('ACS_Transformation_Giant_Performed_Action');
	}

	function ACSTransformationGiantRemoveMoveTimers()
	{
		((CAnimatedComponent)((CNewNPC)ACSGetCActor('ACS_Transformation_Giant')).GetComponentByClassName( 'CAnimatedComponent' )).RaiseBehaviorForceEvent('InterruptOverlay');

		ACSGetCActor('ACS_Transformation_Giant').AddTag('ACS_Transformation_Giant_Performed_Action');

		RemoveTimer('Transformation_Giant_Secondary_Attack');

		RemoveTimer('ACS_transformation_giant_restore_anchor');

		RemoveTimer('Transformation_Giant_Remove_Action_Tag');
		AddTimer('Transformation_Giant_Remove_Action_Tag', 4   , false);

		ACSGetCActor('ACS_Transformation_Giant').EnableCharacterCollisions(true);

		ACSGetCActor('ACS_Transformation_Giant').ACS_ClearAnimationSpeedMultipliers();

		thePlayer.SetImmortalityMode( AIM_None, AIC_Default, true ); 

		thePlayer.SetIsCurrentlyDodging(false);
	}


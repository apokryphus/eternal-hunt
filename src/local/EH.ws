	timer function CreateMeditationWeapons( deltaTime : float , id : int)	
	{
		var steelSword, silverSword, scabsteel, scabsilver, crossbow									: CEntity;
		var sw 																							: int; 
		var steelSwordId, silverSwordId, crossbowId   													: SItemUniqueId;
		var scabbards		 																			: array<SItemUniqueId>; 
		var steelscabcopy, silverscabcopy, steelSwordCopy, silverSwordCopy, crossbowCopy				: CEntity;
		var meshComponent 																				: CMeshComponent;

		var steel_pos_x,steel_pos_y,steel_pos_z   														: Float;
		var silver_pos_x,silver_pos_y,silver_pos_z   													: Float;
		var steel_scab_pos_x,steel_scab_pos_y,steel_scab_pos_z  										: Float;
		var silver_scab_pos_x,silver_scab_pos_y,silver_scab_pos_z  										: Float;
		var steel_roll, steel_pitch, steel_yaw 															: Float; 
		var silver_roll, silver_pitch, silver_yaw 														: Float; 
		var steel_scab_roll, steel_scab_pitch, steel_scab_yaw											: Float; 
		var silver_scab_roll,silver_scab_pitch,silver_scab_yaw											: Float; 

		var meditation_steel_position,meditation_silver_position										: Vector;
		var meditation_steel_rotation,meditation_silver_rotation 										: EulerAngles;
		var meditation_steel_scab_postion,meditation_silver_scab_postion 								: Vector;
		var meditation_steel_scab_rotation,meditation_silver_scab_rotation 								: EulerAngles;

		var steelswordi, silverSwordi 																	: Float;

		var xbow_roll, xbow_pitch, xbow_yaw 															: Float; 
		var xbow_pos_x,xbow_pos_y,xbow_pos_z   															: Float;
		var meditation_crossbow_position																: Vector;
		var meditation_crossbow_rotation							 									: EulerAngles;

		var pos_steel_start 							 												: Vector;
		var pos_steel_test 							 													: float;
		var pos_steel_end 							 													: Vector;
		var steel_heights 							 													: array< float >; 
		var pos_silver_start 							 												: Vector;
		var pos_silver_end 							 													: Vector;
		var pos_silver_test 							 												: float;
		var silver_heights 							 													: array< float >; 
		var pos_xbow_start 							 													: Vector;
		var pos_xbow_end 							 													: Vector;

		if ( thePlayer.GetInventory().GetItemEquippedOnSlot(EES_RangedWeapon, crossbowId) )
		{	
			crossbow = thePlayer.GetInventory().GetItemEntityUnsafe(crossbowId);	
			
			if ( !theGame.GetEntityByTag('ACS_Meditation_Crossbow') )
			{
				crossbowCopy = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource(crossbow.GetReadableName(),true ),
				thePlayer.GetWorldPosition() + thePlayer.GetWorldUp() * -2, thePlayer.GetWorldRotation()  );
				crossbowCopy.BreakAttachment();
				
				meditation_crossbow_position.X = 0;            
				meditation_crossbow_position.Y = 0;            
				meditation_crossbow_position.Z = 0;             
				
				meditation_crossbow_rotation.Roll = 0;
				meditation_crossbow_rotation.Pitch = 0;
				meditation_crossbow_rotation.Yaw = 0;

				switch(ACS_Settings_Main_Int('acs_meditation_settings','acs_meditation_crossbow_positioning', 0))
				{
					case 5:
					xbow_pos_x = -0.1;
					xbow_pos_y = 0.60;
					xbow_pos_z = 0;

					xbow_roll = 80;
					xbow_pitch = 0;
					xbow_yaw = 20;
					break;

					case 4:
					xbow_pos_x = -0.20;
					xbow_pos_y = 1.15;
					xbow_pos_z = 0;

					xbow_roll = 80;
					xbow_pitch = 0;
					xbow_yaw = 35;
					break;

					case 3:
					xbow_pos_x = -0.55;
					xbow_pos_y = 0.30;
					xbow_pos_z = 0;

					xbow_roll = 80;
					xbow_pitch = 0;
					xbow_yaw = 105;
					break;

					case 2:
					xbow_pos_x = 0.50;
					xbow_pos_y = 0.30;
					xbow_pos_z = 0;

					xbow_roll = 80;
					xbow_pitch = 0;
					xbow_yaw = 75;
					break;

					case 1:
					xbow_pos_x = -0.90;
					xbow_pos_y = 0.90;
					xbow_pos_z = 0;

					xbow_roll = 80;
					xbow_pitch = 0;
					xbow_yaw = 105;
					break;

					case 0:
					xbow_pos_x = 0.90;
					xbow_pos_y = 0.90;
					xbow_pos_z = 0;

					xbow_roll = 80;
					xbow_pitch = 0;
					xbow_yaw = 75;
					break;

					default:
					xbow_pos_x = 0.90;
					xbow_pos_y = 0.90;
					xbow_pos_z = 0;

					xbow_roll = 80;
					xbow_pitch = 0;
					xbow_yaw = 75;
					break;
				}

				meditation_crossbow_position.X += xbow_pos_x;           
				meditation_crossbow_position.Y += xbow_pos_y;            
				meditation_crossbow_position.Z += xbow_pos_z;           	
				
				meditation_crossbow_rotation.Roll += xbow_roll;
				meditation_crossbow_rotation.Pitch += xbow_pitch;
				meditation_crossbow_rotation.Yaw += xbow_yaw;

				crossbowCopy.CreateAttachment( thePlayer,,meditation_crossbow_position, meditation_crossbow_rotation );

				pos_xbow_start = crossbowCopy.GetWorldPosition(); 		        	
				pos_xbow_start = TraceFloor(pos_xbow_start);
				
				pos_xbow_end = crossbowCopy.GetWorldPosition() + crossbowCopy.GetWorldUp()*0.4;
				pos_xbow_end = TraceFloor(pos_xbow_end);
				
				crossbowCopy.BreakAttachment();
				meditation_crossbow_rotation.Roll -= adjust_angle_meditation( pos_xbow_end, pos_xbow_start );
				crossbowCopy.CreateAttachment( thePlayer,,meditation_crossbow_position, meditation_crossbow_rotation );
			
				crossbowCopy.BreakAttachment();
				meditation_crossbow_position = TraceFloor(crossbowCopy.GetWorldPosition());
				meditation_crossbow_position.Z += 0.05;
				crossbowCopy.Teleport( meditation_crossbow_position );

				crossbowCopy.AddTag('ACS_Meditation_Item');

				crossbowCopy.AddTag('ACS_Meditation_Crossbow');	
			}
		}

		if ( thePlayer.GetInventory().GetItemEquippedOnSlot(EES_SteelSword, steelSwordId) )
		{
			steelSword = thePlayer.GetInventory().GetItemEntityUnsafe(steelSwordId);

			if ( !theGame.GetEntityByTag('ACS_Meditation_SteelSword') )
			{
				steelSwordCopy = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource(steelSword.GetReadableName(),true ),
				thePlayer.GetWorldPosition() + thePlayer.GetWorldUp() * -2, thePlayer.GetWorldRotation()  );
				steelSwordCopy.BreakAttachment();
				
				meditation_steel_position.X = 0;             
				meditation_steel_position.Y = 0;             
				meditation_steel_position.Z = 0;             
				
				meditation_steel_rotation.Roll = 0;
				meditation_steel_rotation.Pitch = 0;
				meditation_steel_rotation.Yaw = 0;

				switch(ACS_Settings_Main_Int('acs_meditation_settings','acs_meditation_steel_sword_positioning', 0))
				{
					case 3:
					steel_pos_x = 0.25;
					steel_pos_y = 0.70;
					steel_pos_z = 0;

					steel_roll = 0;
					steel_pitch = -90;
					steel_yaw = 90;
					break;

					case 2:
					steel_pos_x = 0.42;
					steel_pos_y = 0.40;
					steel_pos_z = 0;

					steel_roll = 0;
					steel_pitch = -90;
					steel_yaw = 0;
					break;

					case 1:
					steel_pos_x = -0.45;
					steel_pos_y = 0.40;
					steel_pos_z = 0;

					steel_roll = 0;
					steel_pitch = -90;
					steel_yaw = 0;
					break;

					case 0:
					steel_pos_x = 0.25;
					steel_pos_y = 1.45;
					steel_pos_z = 0;

					steel_roll = 0;
					steel_pitch = -90;
					steel_yaw = 90;
					break;

					default:
					steel_pos_x = 0.25;
					steel_pos_y = 1.45;
					steel_pos_z = 0;

					steel_roll = 0;
					steel_pitch = -90;
					steel_yaw = 90;
					break;
				}

				meditation_steel_position.X += steel_pos_x;            
				meditation_steel_position.Y += steel_pos_y;            
				meditation_steel_position.Z += steel_pos_z;            
				
				meditation_steel_rotation.Roll += steel_roll;
				meditation_steel_rotation.Pitch += steel_pitch;
				meditation_steel_rotation.Yaw += steel_yaw;

				steelSwordCopy.CreateAttachment( thePlayer,,meditation_steel_position, meditation_steel_rotation );

				pos_steel_start = steelSwordCopy.GetWorldPosition();
				pos_steel_start = TraceFloor(pos_steel_start);													
				
				
				steel_heights.Clear();
				for(steelswordi=0.1; steelswordi<=1.1; steelswordi+=0.1)
				{
					pos_steel_end = steelSwordCopy.GetWorldPosition() + steelSwordCopy.GetWorldUp()*steelswordi;
					pos_steel_end = TraceFloor(pos_steel_end);
					
					pos_steel_test = adjust_angle_meditation( pos_steel_end, pos_steel_start );
					steel_heights.PushBack(pos_steel_test);
				}
				
				steelSwordCopy.BreakAttachment();
				meditation_steel_rotation.Pitch += steel_heights[ ArrayFindMaxF(steel_heights) ];
				steelSwordCopy.CreateAttachment( thePlayer,,meditation_steel_position, meditation_steel_rotation );
							
				steelSwordCopy.BreakAttachment();
				meditation_steel_position = TraceFloor(steelSwordCopy.GetWorldPosition());
				steelSwordCopy.Teleport( meditation_steel_position );

				steelSwordCopy.AddTag('ACS_Meditation_Item');

				steelSwordCopy.AddTag('ACS_Meditation_SteelSword');
			}
		}

		if ( thePlayer.GetInventory().GetItemEquippedOnSlot(EES_SilverSword, silverSwordId) )
		{
			silverSword = thePlayer.GetInventory().GetItemEntityUnsafe(silverSwordId);

			if ( !theGame.GetEntityByTag('ACS_Meditation_SilverSword') )
			{
				silverSwordCopy = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource(silverSword.GetReadableName(),true ),
				thePlayer.GetWorldPosition() + thePlayer.GetWorldUp() * -2, thePlayer.GetWorldRotation()  );

				silverSwordCopy.BreakAttachment();
				
				meditation_silver_position.X = 0;             
				meditation_silver_position.Y = 0;
				meditation_silver_position.Z = 0;

				meditation_silver_rotation.Roll = 0;
				meditation_silver_rotation.Pitch = 0;
				meditation_silver_rotation.Yaw = 0;

				switch(ACS_Settings_Main_Int('acs_meditation_settings','acs_meditation_silver_sword_positioning', 0))
				{
					case 3:
					silver_pos_x = 0.40;
					silver_pos_y = 0.45;
					silver_pos_z = 0;

					silver_roll = 0;
					silver_pitch = -90;
					silver_yaw = 0;
					break;

					case 2:
					silver_pos_x = 0.58;
					silver_pos_y = 0.50;
					silver_pos_z = 0;

					silver_roll = 0;
					silver_pitch = -90;
					silver_yaw = 0;
					break;

					case 1:
					silver_pos_x = -0.62;
					silver_pos_y = 0.50;
					silver_pos_z = 0;

					silver_roll = 0;
					silver_pitch = -90;
					silver_yaw = 0;
					break;

					case 0:
					silver_pos_x = 0.40;
					silver_pos_y = 1.25;
					silver_pos_z = 0;

					silver_roll = 0;
					silver_pitch = -90;
					silver_yaw = 90;
					break;

					default:
					silver_pos_x = 0.40;
					silver_pos_y = 1.25;
					silver_pos_z = 0;

					silver_roll = 0;
					silver_pitch = -90;
					silver_yaw = 90;
					break;
				}
				
				meditation_silver_position.X += silver_pos_x;            
				meditation_silver_position.Y += silver_pos_y;
				meditation_silver_position.Z += silver_pos_z;

				meditation_silver_rotation.Roll += silver_roll;
				meditation_silver_rotation.Pitch += silver_pitch;
				meditation_silver_rotation.Yaw += silver_yaw;
				
				silverSwordCopy.CreateAttachment( thePlayer,,meditation_silver_position, meditation_silver_rotation );

				pos_silver_start = silverSwordCopy.GetWorldPosition();
				pos_silver_start = TraceFloor(pos_silver_start);													
				
				silver_heights.Clear();
				for(silverSwordi=0.1; silverSwordi<=1.1; silverSwordi+=0.1)
				{
					pos_silver_end = silverSwordCopy.GetWorldPosition() + silverSwordCopy.GetWorldUp()*silverSwordi;
					pos_silver_end = TraceFloor(pos_silver_end);
					
					pos_silver_test = adjust_angle_meditation( pos_silver_end, pos_silver_start );
					silver_heights.PushBack(pos_silver_test);
				}
				
				silverSwordCopy.BreakAttachment();
				meditation_silver_rotation.Pitch += silver_heights[ ArrayFindMaxF(silver_heights) ];
				silverSwordCopy.CreateAttachment( thePlayer,,meditation_silver_position, meditation_silver_rotation );
							
				silverSwordCopy.BreakAttachment();
				meditation_silver_position = TraceFloor(silverSwordCopy.GetWorldPosition());
				silverSwordCopy.Teleport( meditation_silver_position );

				silverSwordCopy.AddTag('ACS_Meditation_Item');

				silverSwordCopy.AddTag('ACS_Meditation_SilverSword');
			}
		}

		thePlayer.GetInventory().GetAllItems(scabbards);	

		for(sw=0; sw<scabbards.Size(); sw+=1)
		{	
			if ( thePlayer.GetInventory().GetItemCategory(scabbards[sw]) == 'steel_scabbards' )
			{
				if ( !theGame.GetEntityByTag('ACS_Meditation_SteelScabbard') )
				{
					steelscabcopy = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource(thePlayer.GetInventory().GetItemEntityUnsafe(scabbards[sw]).GetReadableName(),true ),
					thePlayer.GetWorldPosition() + thePlayer.GetWorldUp() * -2, thePlayer.GetWorldRotation()  );
					meshComponent = ( CMeshComponent ) steelscabcopy.GetComponentByClassName( 'CMeshComponent' );
					meshComponent.SetScale( Vector( 1.03, 1.03, 1.03 ) );

					steelscabcopy.BreakAttachment();
					
					meditation_steel_scab_postion.X = 0;           
					meditation_steel_scab_postion.Y = 0; 
					meditation_steel_scab_postion.Z = 0;

					meditation_steel_scab_postion.X += 0.61;       
					meditation_steel_scab_postion.Y -= 0.09;
					meditation_steel_scab_postion.Z -= -1.71;

					meditation_steel_scab_rotation.Roll = 0;
					meditation_steel_scab_rotation.Pitch = 0;
					meditation_steel_scab_rotation.Yaw = 0;
													
					meditation_steel_scab_rotation.Roll += -24.3; 
					meditation_steel_scab_rotation.Pitch += 180;
					meditation_steel_scab_rotation.Yaw += 14.4 + 0.41;   
					
					steelscabcopy.CreateAttachment( theGame.GetEntityByTag('ACS_Meditation_SteelSword'),,meditation_steel_scab_postion, meditation_steel_scab_rotation );
					
					steelscabcopy.AddTag('ACS_Meditation_Item');

					steelscabcopy.AddTag('ACS_Meditation_SteelScabbard');
				}
			}
			else if ( thePlayer.GetInventory().GetItemCategory(scabbards[sw]) == 'silver_scabbards' )
			{
				if ( !theGame.GetEntityByTag('ACS_Meditation_SilverScabbard') )
				{
					silverscabcopy = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource(thePlayer.GetInventory().GetItemEntityUnsafe(scabbards[sw]).GetReadableName(),true ),
					thePlayer.GetWorldPosition() + thePlayer.GetWorldUp() * -2, thePlayer.GetWorldRotation()  );
					meshComponent = ( CMeshComponent ) silverscabcopy.GetComponentByClassName( 'CMeshComponent' );
					meshComponent.SetScale( Vector( 1.03, 1.03, 1.03 ) );

					silverscabcopy.BreakAttachment();
					
					meditation_silver_scab_postion.X = 0;           
					meditation_silver_scab_postion.Y = 0; 
					meditation_silver_scab_postion.Z = 0; 

					meditation_silver_scab_postion.X += 0.61 + 0.025;       
					meditation_silver_scab_postion.Y -= 0.09 - 0.1; 
					meditation_silver_scab_postion.Z -= -1.71 + 0.07;

					meditation_silver_scab_rotation.Roll = 0;
					meditation_silver_scab_rotation.Pitch = 0;
					meditation_silver_scab_rotation.Yaw = 0;

					meditation_silver_scab_rotation.Roll += -24.3 - 5.5;
					meditation_silver_scab_rotation.Pitch += 180 - 1.5;
					meditation_silver_scab_rotation.Yaw += 14.4 + 4;
					
					silverscabcopy.CreateAttachment( theGame.GetEntityByTag('ACS_Meditation_SilverSword'),,meditation_silver_scab_postion, meditation_silver_scab_rotation );
					
					silverscabcopy.AddTag('ACS_Meditation_Item');

					silverscabcopy.AddTag('ACS_Meditation_SilverScabbard');
				}
			}
		}
	}

	function adjust_angle_meditation( from, to : Vector) : float
	{
		var slopeFlat	: Vector;
		var slope		: Vector;
		var angle		: float;

		slope		= VecNormalize( from - to );
		slopeFlat	= slope;
		slopeFlat.Z	= 0.0f;
		slopeFlat	= VecNormalize( slopeFlat );
		angle		= AngleNormalize180( VecGetAngleBetween ( slope, slopeFlat ) );
		if( slope.Z < 0.0f )
		{
			angle *= -1.0f;
		}
		return angle;
	}

	function UseKindling() : bool
	{
		var kindling, required_kindling : int;

		kindling = thePlayer.inv.GetItemQuantityByName('Timber') + thePlayer.inv.GetItemQuantityByName('Hardened timber');

		required_kindling = ACS_Settings_Main_Int('spectreAlchemyBrewing','spectreRequiredKindling', 3);

		if (required_kindling == 0
		|| !required_kindling
		)
		{
			return true;
		}

		if (kindling >= required_kindling)
		{	
			if (thePlayer.inv.RemoveItemByName('Timber', required_kindling) )
			{
				return true;
			}
			else if (thePlayer.inv.RemoveItemByName('Hardened timber', required_kindling) )
			{
				return true;
			}
			else
			{	
				kindling = thePlayer.inv.GetItemQuantityByName('Timber');
				thePlayer.inv.RemoveItemByName('Timber', kindling);
				thePlayer.inv.RemoveItemByName('Hardened timber', required_kindling - kindling);
				return true;
			}
		}
	
		return false;
	}

	function MeditateStart()
	{
		if (FactsQuerySum("ACS_In_Meditation") <= 0)
		{
			thePlayer.OnRangedForceHolster( true );

			ACS_Tutorial_Display_Check('ACS_QuickMeditation_Tutorial_Shown');

			storedHoursPerMinute = theGame.GetHoursPerMinute();

			theGame.CreateNoSaveLock( "ACS_Meditation_Active", ACS_Meditation_Savelock_ID, false, false );

			RemoveTimer('ACS_Meditation_Start_Delay');
			RemoveTimer('ACS_Meditate_Loop');

			if (thePlayer.HasTag('ACS_IsSwordWalking'))
			{
				thePlayer.RemoveTag('ACS_IsSwordWalking');
			}

			if (thePlayer.GetInventory().ItemHasTag( thePlayer.GetInventory().GetCurrentlyHeldSword(), 'Aerondight' ))
			{
				aerondight_sword_trail();
			}

			if (ACS_Settings_Main_Bool('acs_meditation_settings','acs_meditation_items_enabled', true)
			&& !thePlayer.IsInInterior()
			)
			{
				RemoveTimer('CreateMeditationItemsActionDelay');
				AddTimer('CreateMeditationItemsActionDelay', 0.125 , false);
			}

			thePlayer.RaiseEvent('ACS_SwordWalkAdditiveEnd');thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');RemoveTimer('CombatTauntDelay');thePlayer.RaiseEvent('ACS_SwordTauntEnd');

			if (thePlayer.IsAnyWeaponHeld() && !thePlayer.IsWeaponHeld('fist'))
			{
				PlayerPlayAnimation('man_knight_kneeling_with_sword_start_ACS');

				RemoveTimer('CombatTauntDelay');
				RemoveTimer('SwordTauntRunningSwitchSecondary'); 
				RemoveTimer('SwordTauntRunningSwitchSecondaryWeaponBlood'); 
				AddTimer('SwordTauntRunningSwitchSecondary', 0.01  , false); 

				AddTimer('ACS_Meditation_Start_Delay', 4 , false);
			}
			else
			{
				switch(ACS_Settings_Main_Int('acs_meditation_settings','acs_meditation_style', 0))
				{
					case 4:
					PlayerPlayAnimation('work_push_ups_start_ACS');
					AddTimer('ACS_Meditation_Start_Delay', 2.5 , false);
					meditationPushups = true;
					break;

					case 3:
					PlayerPlayAnimation('man_work_sleep_ground_start');
					AddTimer('ACS_Meditation_Start_Delay', 5.25 , false);
					meditationSleep = true;
					break;

					case 2:

					PlayerPlayAnimation('man_work_sit_squat_start');
					AddTimer('ACS_Meditation_Start_Delay', 1.5 , false);
					meditationSquat = true;
					break;

					case 1:
					PlayerPlayAnimation('meditation_start_long');
					AddTimer('ACS_Meditation_Start_Delay', 3 , false);
					meditationNormal = true;
					break;

					case 0:

					if( GetRainStrength() > 0 ) 
					{
						meditation_index_1 = RandDifferent(this.previous_meditation_index_1 , 2);

						switch (meditation_index_1) 
						{	
							case 1:
							PlayerPlayAnimation('man_work_sit_squat_start');
							AddTimer('ACS_Meditation_Start_Delay', 1.5 , false);
							meditationSquat = true;
							break;

							default:
							PlayerPlayAnimation('meditation_start_long');
							AddTimer('ACS_Meditation_Start_Delay', 3 , false);
							meditationNormal = true;
							break;
						}
				
						this.previous_meditation_index_1 = meditation_index_1;
					}
					else
					{
						meditation_index_1 = RandDifferent(this.previous_meditation_index_1 , 4);

						switch (meditation_index_1) 
						{	
							case 3:
							PlayerPlayAnimation('work_push_ups_start_ACS');
							AddTimer('ACS_Meditation_Start_Delay', 2.5 , false);
							meditationPushups = true;
							break;

							case 2:
							PlayerPlayAnimation('man_work_sleep_ground_start');
							AddTimer('ACS_Meditation_Start_Delay', 5.25 , false);
							meditationSleep = true;
							break;

							case 1:
							PlayerPlayAnimation('man_work_sit_squat_start');
							AddTimer('ACS_Meditation_Start_Delay', 1.5 , false);
							meditationSquat = true;
							break;

							default:
							PlayerPlayAnimation('meditation_start_long');
							AddTimer('ACS_Meditation_Start_Delay', 3 , false);
							meditationNormal = true;
							break;
						}
				
						this.previous_meditation_index_1 = meditation_index_1;
					}
					break;

					default:
					break;
				}
			}

			if (!thePlayer.IsInInterior() 
			&& ACS_Settings_Main_Bool('acs_meditation_settings','acs_meditation_start_with_campfire', true)
			&& !RoofCheck()
			&& !MeditationFireSourceCheck()
			)
			{
				if (theGame.GetEngineTimeAsSeconds() - last_meditation_campfire_pressed_time > 3)
				{
					last_meditation_campfire_pressed_time = theGame.GetEngineTimeAsSeconds();

					if (ACS_Is_DLC_Installed('dlc_spectre'))
					{
						if (UseKindling())
						{
							SpawnCampFire();

							RemoveTimer('LightCampFire');
							AddTimer('LightCampFire', 0.5 , false);
						}
						else
						{
							theGame.GetGuiManager().ShowNotification(GetLocStringByKey("spectre_fire_nomaterials") );
						}
					} 
					else
					{
						SpawnCampFire();

						RemoveTimer('LightCampFire');
						AddTimer('LightCampFire', 0.5 , false);
					}
				}
			}

			thePlayer.BlockAction( EIAB_Crossbow, 			'ACS_Meditation');
			thePlayer.BlockAction( EIAB_CallHorse,			'ACS_Meditation');
			thePlayer.BlockAction( EIAB_Signs, 				'ACS_Meditation');
			thePlayer.BlockAction( EIAB_DrawWeapon, 		'ACS_Meditation');
			thePlayer.BlockAction( EIAB_FastTravel, 		'ACS_Meditation');
			thePlayer.BlockAction( EIAB_Fists, 				'ACS_Meditation');
			thePlayer.BlockAction( EIAB_InteractionAction, 	'ACS_Meditation');
			thePlayer.BlockAction( EIAB_UsableItem,			'ACS_Meditation');
			thePlayer.BlockAction( EIAB_ThrowBomb,			'ACS_Meditation');
			thePlayer.BlockAction( EIAB_SwordAttack,		'ACS_Meditation');
			thePlayer.BlockAction( EIAB_LightAttacks,		'ACS_Meditation');
			thePlayer.BlockAction( EIAB_HeavyAttacks,		'ACS_Meditation');
			thePlayer.BlockAction( EIAB_SpecialAttackLight,	'ACS_Meditation');
			thePlayer.BlockAction( EIAB_SpecialAttackHeavy,	'ACS_Meditation');
			thePlayer.BlockAction( EIAB_Dodge,				'ACS_Meditation');
			thePlayer.BlockAction( EIAB_Roll,				'ACS_Meditation');
			thePlayer.BlockAction( EIAB_Parry,				'ACS_Meditation');
			thePlayer.BlockAction( EIAB_MeditationWaiting,	'ACS_Meditation');
			thePlayer.BlockAction( EIAB_OpenMeditation,		'ACS_Meditation');
			thePlayer.BlockAction( EIAB_RadialMenu,			'ACS_Meditation');
			thePlayer.BlockAction( EIAB_Movement,			'ACS_Meditation');
			thePlayer.BlockAction( EIAB_Interactions, 		'ACS_Meditation');
			thePlayer.BlockAction( EIAB_Jump, 				'ACS_Meditation');
			//thePlayer.BlockAction( EIAB_QuickSlots, 		'ACS_Meditation');

			if (!MeditationFireSourceCheck())
			{
				thePlayer.BlockAction( EIAB_OpenFastMenu, 		'ACS_Meditation');
				thePlayer.BlockAction( EIAB_OpenInventory,		'ACS_Meditation');
				thePlayer.BlockAction( EIAB_OpenPreparation, 	'ACS_Meditation');
				thePlayer.BlockAction( EIAB_OpenMap, 			'ACS_Meditation');
				thePlayer.BlockAction( EIAB_OpenCharacterPanel, 'ACS_Meditation');
				thePlayer.BlockAction( EIAB_OpenJournal, 		'ACS_Meditation');
				thePlayer.BlockAction( EIAB_OpenAlchemy, 		'ACS_Meditation');
				thePlayer.BlockAction( EIAB_OpenGlossary,		'ACS_Meditation');
			}
			else
			{
				FactsAdd("ACS_Meditation_Allow_Alchemy", 1, -1);
			}
			

			ChangeInteractionPriority();

			RemoveTimer('RemoveMeditationBlock');

			FactsAdd("ACS_In_Meditation", 1, -1);
		}
		else if (FactsQuerySum("ACS_In_Meditation") > 0)
		{
			if (FactsQuerySum("ACS_Meditation_Has_Refilled_Ammo") > 0)
			{
				FactsRemove("ACS_Meditation_Has_Refilled_Ammo");
			}

			RemoveTimer('ACS_Meditation_Start_Delay');
			RemoveTimer('ACS_Meditate_Loop');

			if (thePlayer.IsAnyWeaponHeld() && !thePlayer.IsWeaponHeld('fist'))
			{
				PlayerPlayAnimation('man_knight_kneeling_with_sword_stop_ACS');
			}
			else
			{
				if(meditationNormal)
				{
					if (!ACSGetCEntity('ACS_Meditation_Campfire'))
					{
						PlayerPlayAnimation('meditation_stop_long');
					}
					else
					{
						PlayerPlayAnimation('meditation_stop_long_2');
					}
				}

				if(meditationSquat)
				{
					PlayerPlayAnimation('man_work_sit_squat_stop');
				}

				if(meditationSleep)
				{
					PlayerPlayAnimation('man_work_sleep_ground_stop');
				}

				if(meditationPushups)
				{
					PlayerPlayAnimation('work_push_ups_stop_ACS');
				}
			}

			if (thePlayer.GetInventory().ItemHasTag( thePlayer.GetInventory().GetCurrentlyHeldSword(), 'Aerondight' ))
			{
				aerondight_sword_trail();
			}

			theGame.ReleaseNoSaveLock( ACS_Meditation_Savelock_ID );

			thePlayer.UnblockAction( EIAB_Crossbow, 			'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_CallHorse,			'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_Signs, 				'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_DrawWeapon, 			'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_FastTravel, 			'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_Fists, 				'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_InteractionAction, 	'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_UsableItem,			'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_ThrowBomb,			'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_SwordAttack,			'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_LightAttacks,			'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_HeavyAttacks,			'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_SpecialAttackLight,	'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_SpecialAttackHeavy,	'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_Dodge,				'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_Roll,					'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_Parry,				'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_MeditationWaiting,	'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_OpenMeditation,		'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_RadialMenu,			'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_Movement,				'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_Interactions, 		'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_Jump, 				'ACS_Meditation');
			//thePlayer.UnblockAction( EIAB_QuickSlots, 			'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_OpenFastMenu, 		'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_OpenInventory,		'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_OpenPreparation, 		'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_OpenMap, 				'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_OpenCharacterPanel, 	'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_OpenJournal, 			'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_OpenAlchemy, 			'ACS_Meditation');
			thePlayer.UnblockAction( EIAB_OpenGlossary,			'ACS_Meditation');

			theGame.SetHoursPerMinute( storedHoursPerMinute );

			if (ACSGetCEntity('ACS_Meditation_Campfire'))
			{
				RemoveTimer('AardLightIconSmall');
				AddTimer('AardLightIconSmall', 0.5 , false);

				thePlayer.RaiseEvent('ACS_AardLight');

				CampfireExtinguish();
			}

			if(meditationNormal)
			{
				meditationNormal = false;
			}

			if(meditationSquat)
			{
				meditationSquat = false;
			}

			if(meditationSleep)
			{
				meditationSleep = false;
			}

			if(meditationPushups)
			{
				meditationPushups = false;
			}

			if(showMeditationControls)
			{
				showMeditationControls = false;
			}

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Meditation_Controls_Display");

			MimicReset();

			RemoveTimer('CreateMeditationBase');

			RemoveTimer('CreateMeditationWeapons');

			RemoveTimer('CreateMeditationItemsActionDelay');

			if (meditationWeaponsOnGround)
			{
				if (ACS_CloakEquippedCheck() && (ACS_Settings_Main_Int ('acs_player_equipment_visual_settings','acs_swords_positioning_when_cloaked', 0, true) == 1 || FactsQuerySum("ACS_Force_Weapons_On_Hips") > 0))
				{
					thePlayer.RaiseEvent('ACS_HolsterSwordHip');
				}
				else if (ACS_Settings_Main_Int ('acs_player_equipment_visual_settings','acs_swords_positioning_when_cloaked', 0, true) == 0)
				{
					thePlayer.RaiseEvent('ACS_HolsterSwordAlt');
				}
				
				meditationWeaponsOnGround = false;
			}

			ACSGetCEntityDestroyAll('ACS_Meditation_Item');

			ResetInteractionPriority();

			if(!meditation_block)
			{
				meditation_block = true;
			}

			RemoveTimer('RemoveMeditationBlock');
			AddTimer('RemoveMeditationBlock', 0.5 , false);

			IdleAdditiveBlockTemp();

			if (FactsQuerySum("ACS_Meditation_Allow_Alchemy") > 0)
			{
				FactsRemove("ACS_Meditation_Allow_Alchemy");
			}

			FactsRemove("ACS_In_Meditation");

			RemoveTimer('SetScabbardFlag');
			AddTimer('SetScabbardFlag', 0.125 , false );
		}
	}

	var meditation_block : bool;

	timer function RemoveMeditationBlock ( dt : float, id : int )
	{
		meditation_block = false;
	}

	
	
	public timer function Air_Time_Movement_Adjust_Delay(deltaTime : float , id : int)
	{
		var targetPos 							: Vector;
		var player								: CR4Player;
		var ent, ent_1, ent_2 					: CEntity;
		var bone_vec, attach_vec, pPos			: Vector;
		var bone_rot, attach_rot				: EulerAngles;
		var rot                        			: EulerAngles;
		var pos									: Vector;

		ACSGetCEntity('ACS_Quen_Bubble').Destroy();
		
		ACSGetCEntity('ACS_Quen_Fx').Destroy();

		ACSGetCEntity('ACS_Sign_Icon').Destroy();

		ACSGetCEntity('ACS_Sign_Icon_Anchor').Destroy();

		ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
		"dlc\dlc_acs\data\fx\sign_icons.w2ent"
		, true ), GetWitcherPlayer().GetWorldPosition(), GetWitcherPlayer().GetWorldRotation() );

		ent_2 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
		"dlc\dlc_acs\data\fx\sign_icons.w2ent"
		, true ), GetWitcherPlayer().GetWorldPosition(), GetWitcherPlayer().GetWorldRotation() );

		GetWitcherPlayer().GetBoneWorldPositionAndRotationByIndex( GetWitcherPlayer().GetBoneIndex( 'l_handRoll' ), bone_vec, bone_rot );

		if ( GetWitcherPlayer().GetEquippedSign() == ST_Aard)
		{
			attach_rot.Roll = 0;
			attach_rot.Pitch = 0;
			attach_rot.Yaw = 0;
			attach_vec.X = 0.4;
			attach_vec.Y = 0;
			attach_vec.Z = -0.025;

			ent.CreateAttachmentAtBoneWS( GetWitcherPlayer(), 'l_handRoll', bone_vec, bone_rot );

			ent_2.CreateAttachment( ent, , attach_vec, attach_rot );

			if (ACS_Armor_Set_Check('forgotten_wolf', false) 
			|| ACS_Armor_Set_Check('acs_armor', false)
			|| ACS_Armor_Set_Check('volhikar', false)
			|| thePlayer.HasTag('acs_vampire_claws_equipped')
			|| ACS_Vampire_Claws_Access()
			)
			{
				ent_2.PlayEffectSingle('aard_icon_red');
			}
			else
			{
				ent_2.PlayEffectSingle('aard_icon');
			}

			ent_2.PlayEffectSingle('critical_aard');

			ent.DestroyAfter(0.5);
			ent_2.DestroyAfter(0.5);
		}

		ent.AddTag('ACS_Sign_Icon_Anchor');

		ent_2.AddTag('ACS_Sign_Icon');

		ACS_StaminaDrain(1, true);

		ACS_SlowMoAdjustable(0.3,0.5);

		thePlayer.SetImmortalityMode( AIM_None, AIC_Default, true ); 

		thePlayer.BlockAllActions( 'ACS_Air_Time_Init', false );

		thePlayer.EnableCollisions(false);

		thePlayer.RaiseEvent('ACS_ForceLegsFloatIdle');

		thePlayer.BlockAction( EIAB_CallHorse,			'ACS_Air_Time');
		thePlayer.BlockAction( EIAB_DrawWeapon, 		'ACS_Air_Time');
		thePlayer.BlockAction( EIAB_FastTravel, 		'ACS_Air_Time');
		thePlayer.BlockAction( EIAB_InteractionAction, 	'ACS_Air_Time');
		thePlayer.BlockAction( EIAB_UsableItem,			'ACS_Air_Time');
		thePlayer.BlockAction( EIAB_MeditationWaiting,	'ACS_Air_Time');
		thePlayer.BlockAction( EIAB_OpenMeditation,		'ACS_Air_Time');
		thePlayer.BlockAction( EIAB_RadialMenu,			'ACS_Air_Time');
		thePlayer.BlockAction( EIAB_Movement,			'ACS_Air_Time');
		thePlayer.BlockAction( EIAB_QuickSlots, 		'ACS_Air_Time');

		RemoveTimer('RemoveACSAirTime');
		AddTimer('RemoveACSAirTime', 2 , false);

		thePlayer.AddTag('ACS_Air_Time');
		

		thePlayer.DestroyEffect('dodge_acs_armor');
		thePlayer.PlayEffectSingle('dodge_acs_armor');

		thePlayer.DestroyEffect('bruxa_dash_trails');
		thePlayer.PlayEffectSingle('bruxa_dash_trails');

		thePlayer.StopEffect('shadowdash_shockwave');

		thePlayer.PlayEffectSingle('shadowdash_shockwave');

		thePlayer.StopEffect('shadowdash_shockwave');

		movementAdjustor = thePlayer.GetMovingAgentComponent().GetMovementAdjustor();
							
		movementAdjustor.CancelAll();

		MovementAdjust('default');

		movementAdjustor.AdjustmentDuration( ticket, 0.5 );

		movementAdjustor.AdjustLocationVertically( ticket, true );

		movementAdjustor.RotateTowards(ticket, ((CActor)thePlayer.GetTarget()) );

		targetPos = thePlayer.GetWorldPosition() + Vector(0,0,7.5);

		movementAdjustor.SlideTo( ticket, targetPos );
		

		rot = GetWitcherPlayer().GetWorldRotation();

		pos = GetWitcherPlayer().GetWorldPosition();

		if (ACS_Armor_Set_Check('forgotten_wolf', false) 
		|| ACS_Armor_Set_Check('acs_armor', false)
		|| ACS_Armor_Set_Check('volhikar', false)
		|| thePlayer.HasTag('acs_vampire_claws_equipped')
		|| ACS_Vampire_Claws_Access()
		)
		{
			ent_1 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

			"dlc\dlc_acs\data\fx\pc_aard.w2ent"

			, true ), pos, rot );
		}
		else
		{
			ent_1 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

			"gameplay\templates\signs\pc_aard.w2ent"

			, true ), pos, rot );
		}

		ent_1.PlayEffectSingle('blast_ground');

		if (ACS_Armor_Set_Check('forgotten_wolf', false) 
		|| ACS_Armor_Set_Check('acs_armor', false)
		|| ACS_Armor_Set_Check('volhikar', false)
		|| thePlayer.HasTag('acs_vampire_claws_equipped')
		|| ACS_Vampire_Claws_Access()
		)
		{
			ent_1.PlayEffectSingle('blast_lv3_red');
			ent_1.PlayEffectSingle('blast_lv3');
		}
		else
		{
			ent_1.PlayEffectSingle('blast_lv3');
		}

		ent_1.DestroyAfter(3);

		theGame.GetBehTreeReactionManager().CreateReactionEventIfPossible( thePlayer, 'CastSignAction', -1, 20.0f, -1.f, -1, true );
	}

	function Flying_Target_Check() : bool
	{
		var actors		    		: array<CActor>;
		var i 						: int;
		var targetDistance 			: float;

		actors.Clear();

		actors = thePlayer.GetNPCsAndPlayersInRange( 20, 5, , FLAG_OnlyAliveActors + FLAG_Attitude_Hostile + FLAG_ExcludePlayer);

		if( actors.Size() > 0 )
		{
			for (i = 0; i < actors.Size(); i += 1) 
			{
				targetDistance = VecDistanceSquared2D( actors[i].GetWorldPosition(), thePlayer.GetWorldPosition() ) ;

				if ((thePlayer.IsInCombat()
				&& (((CNewNPC)actors[i])).IsFlying() || !((CNewNPC)actors[i]).IsOnGround() || actors[i].HasTag('ACS_Simulated_In_Air'))
				&& targetDistance <= 20 * 20
				&& thePlayer.GetStat(BCS_Stamina) > 0
				)
				{
					return true;
				}
			}
		}

		return false;
	}

	public timer function Air_Time_Trigger_Delay(deltaTime : float , id : int)
	{
		if (Flying_Target_Check()
		&& !thePlayer.HasTag('ACS_Air_Time')
		&& !getIsInCombatSlide
		)
		{
			RemoveTimer('RollDelay');

			thePlayer.SetImmortalityMode( AIM_Invulnerable, AIC_Default, true ); 

			thePlayer.BlockAllActions( 'ACS_Air_Time_Init', true );

			movementAdjustor = thePlayer.GetMovingAgentComponent().GetMovementAdjustor();
				
			movementAdjustor.CancelAll();

			MovementAdjust('default');

			movementAdjustor.AdjustmentDuration( ticket, 1 );

			movementAdjustor.AdjustLocationVertically( ticket, true );

			movementAdjustor.RotateTowards(ticket, ((CActor)thePlayer.GetTarget()) );

			thePlayer.ACS_ClearAnimationSpeedMultipliers();

			if ( thePlayer.IsAnyWeaponHeld() 
			&& !thePlayer.IsWeaponHeld('fist') 
			)
			{
				if(RandF() < 0.5)
				{
					PlayerPlayAnimation('man_ger_sword_aard_ground_lp');
				}
				else
				{
					PlayerPlayAnimation('man_ger_sword_aard_ground_rp');
				}
			}
			else
			{
				PlayerPlayAnimation('man_geralt_aard_ground');
			}

			thePlayer.RaiseEvent('ACS_ForceLegsFloatIdle');

			RemoveTimer('Air_Time_Movement_Adjust_Delay');
			AddTimer('Air_Time_Movement_Adjust_Delay', 0.5 , false);

			thePlayer.AddTag('ACS_Air_Time');
		}
	}

	function FlipTargetCheckPre(dir : name) : bool
	{
		var actors : array <CActor>;
		var coneDir : float;
		var coneAngle : float;

		if (thePlayer.GetStat(BCS_Stamina) <= 0)
		{
			return false;
		}

		switch (dir)
		{
			case 'right':
			coneDir = theCamera.GetCameraHeading() - 90;
			coneAngle = 30;
			break;

			case 'left':
			coneDir = theCamera.GetCameraHeading() + 90;
			coneAngle = 30;
			break;

			case 'back':
			coneDir = theCamera.GetCameraHeading() + 180;
			coneAngle = 30;
			break;

			case 'front':
			coneDir = theCamera.GetCameraHeading();
			coneAngle = 30;
			break;

			default:
			coneDir = theCamera.GetCameraHeading();
			coneAngle = 30;
			break;
		}

		actors.Clear();

		actors = thePlayer.GetNPCsAndPlayersInCone(4, coneDir, coneAngle, 1, , FLAG_ExcludePlayer + FLAG_Attitude_Hostile + FLAG_OnlyAliveActors );

		if( actors.Size() > 0 )
		{
			for( i = 0; i < actors.Size(); i += 1 )
			{
				if(( thePlayer.IsActionAllowed(EIAB_Dodge) || thePlayer.IsActionAllowed(EIAB_Roll) )
				&& !((CNewNPC)actors[i]).IsHorse()
				&& !thePlayer.HasTag('ACS_Is_Currently_Flipping')
				&& !thePlayer.HasTag('ACS_Neutral_Flip')
				&& ACS_Rage_Process == false
				&& !ACSGetCActor('ACS_Enemy_Attacking_From_Behind')
				&& !ACSGetCActor('ACS_Flip_Target')
				&& !ACSGetCEntity('ACS_Enemy_Attacking_From_Behind_Marker')
				&& !thePlayer.HasTag('ACS_Player_Is_Attacking')
				&& !thePlayer.IsCastingSign()
				&& !ACS_Cast_Sign_Process
				&& !thePlayer.IsThrowingItem()
				&& !thePlayer.IsThrowingItemWithAim()
				&& !thePlayer.IsThrowHold()
				&& !thePlayer.HasTag('ACS_In_Combat_Art')
				&& ACS_Settings_Main_Float('acs_dodge_settings','acs_flip_dodge_cooldown', 4) > 0
				&& ACS_can_flip_dodge()
				)
				{
					return true;
				}
			}
		}

		return false;
	}

	function FlipTargetCheck(dir : name) : bool
	{
		var actors : array <CActor>;
		var coneDir : float;
		var coneAngle : float;

		if (thePlayer.GetStat(BCS_Stamina) <= 0)
		{
			return false;
		}

		switch (dir)
		{
			case 'right':
			coneDir = theCamera.GetCameraHeading() - 90;
			coneAngle = 30;
			break;

			case 'left':
			coneDir = theCamera.GetCameraHeading() + 90;
			coneAngle = 30;
			break;

			case 'back':
			coneDir = theCamera.GetCameraHeading() + 180;
			coneAngle = 30;
			break;

			case 'front':
			coneDir = theCamera.GetCameraHeading();
			coneAngle = 30;
			break;

			default:
			coneDir = theCamera.GetCameraHeading();
			coneAngle = 30;
			break;
		}

		actors.Clear();

		actors = thePlayer.GetNPCsAndPlayersInCone(4, coneDir, coneAngle, 1, , FLAG_ExcludePlayer + FLAG_Attitude_Hostile + FLAG_OnlyAliveActors );

		if( actors.Size() > 0 )
		{
			for( i = 0; i < actors.Size(); i += 1 )
			{
				if(( thePlayer.IsActionAllowed(EIAB_Dodge) || thePlayer.IsActionAllowed(EIAB_Roll) )
				&& !((CNewNPC)actors[i]).IsHorse()
				&& !thePlayer.HasTag('ACS_Is_Currently_Flipping')
				&& !thePlayer.HasTag('ACS_Neutral_Flip')
				&& ACS_Rage_Process == false
				&& !ACSGetCActor('ACS_Enemy_Attacking_From_Behind')
				&& !ACSGetCActor('ACS_Flip_Target')
				&& !ACSGetCEntity('ACS_Enemy_Attacking_From_Behind_Marker')
				&& !thePlayer.HasTag('ACS_Player_Is_Attacking')
				&& !thePlayer.IsCastingSign()
				&& !ACS_Cast_Sign_Process
				&& !thePlayer.IsThrowingItem()
				&& !thePlayer.IsThrowingItemWithAim()
				&& !thePlayer.IsThrowHold()
				&& !thePlayer.HasTag('ACS_In_Combat_Art')
				&& ACS_Settings_Main_Float('acs_dodge_settings','acs_flip_dodge_cooldown', 4) > 0
				&& ACS_can_flip_dodge()
				)
				{
					thePlayer.AddTag('ACS_Neutral_Flip');

					actors[i].AddTag('ACS_Flip_Target');

					//thePlayer.RaiseEvent('ACS_FrontFlip');

					GetACSWatcherSecondary().GotoState('ACS_Flip_Evade');
				}
			}

			return true;
		}

		return false;
	}

	event OnMovementDoubleTapW( action : SInputAction )
	{
		if (FactsQuerySum("acs_transformation_activated") > 0)
		{
			return false;
		}

		if( !thePlayer.IsActionAllowed(EIAB_Dodge)) 
		{
			return false;
		}

		if ( IsPressed( action ) )
		{	
			if ( !thePlayer.IsDodgeTimerRunning() || action.aName != lastACSMovementDoubleTapName )
			{
				thePlayer.StartDodgeTimer();
				lastACSMovementDoubleTapName = action.aName;
			}
			else
			{
				thePlayer.StopDodgeTimer();
				
				ACSGetCEntity('ACS_Quen_Bubble').Destroy();
		
				ACSGetCEntity('ACS_Quen_Fx').Destroy();

				ACSGetCEntity('ACS_Sign_Icon').Destroy();

				ACSGetCEntity('ACS_Sign_Icon_Anchor').Destroy();

				if (FlipTargetCheck('front'))
				{

				}
				else
				{
					if (ACS_Settings_Main_Bool('acs_dodge_settings','acs_bruxa_leap_attack', false))
					{
						JumpAttackCombat();
					}
					else
					{
						ACS_BruxaDodgeSlideBackInit();
					}
				}
			}
			
			if (thePlayer.HasTag('ACS_IsSwordWalking'))
			{
				thePlayer.RaiseEvent('ACS_SwordWalkAdditiveEnd');thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');RemoveTimer('CombatTauntDelay');thePlayer.RaiseEvent('ACS_SwordTauntEnd');

				thePlayer.RemoveTag('ACS_IsSwordWalking');
			}
		}
	}

	

	public timer function Hood_Include_Toggle_Delay(deltaTime : float , id : int)
	{
		hoodtoggle = true;
	}

	function Hood_Include()
	{
		var item : SItemUniqueId;

		GetWitcherPlayer().GetItemEquippedOnSlot(EES_Armor, item);

		if ( !GetWitcherPlayer().IsAnyItemEquippedOnSlot(EES_Armor) 
		|| StrContains( GetWitcherPlayer().inv.GetItemName(item), "body torso" ) 
		)
		{
			return;
		}

		vACS_Hood = new cACS_Hood in this;

		vACS_Hood.ACS_Hood_Enable_Engage();

		if ( FactsQuerySum("ACS_Hood_Normal_Equipped") <= 0 
		&& !GetWitcherPlayer().IsItemEquippedByName('KM Cloak') 
		&& !GetWitcherPlayer().IsItemEquippedByName('KM Cloak Lowered') 
		&& !GetWitcherPlayer().IsItemEquippedByName('KM Pointy Cloak') 
		)
		{
			thePlayer.DestroyEffect('demonic_possession');
			thePlayer.PlayEffect('demonic_possession');
			thePlayer.StopEffect('demonic_possession');
		}

		RemoveTimer('Hood_Include_Toggle_Delay');
		AddTimer('Hood_Include_Toggle_Delay', 0.5 , false);

		ACS_Tutorial_Display_Check('ACS_Hood_And_Mask_Tutorial_Shown');

		if ( FactsQuerySum("ACS_Hood_Enabled") <= 0 )
		{
			FactsAdd("ACS_Hood_Enabled", 1, -1);
		}
	}

	var vACS_Hood : cACS_Hood;

	function Hood_Exclude()
	{
		var item : SItemUniqueId;

		GetWitcherPlayer().GetItemEquippedOnSlot(EES_Armor, item);

		if ( !GetWitcherPlayer().IsAnyItemEquippedOnSlot(EES_Armor) 
		|| StrContains( GetWitcherPlayer().inv.GetItemName(item), "body torso" ) 
		)
		{
			return;
		}

		vACS_Hood = new cACS_Hood in this;

		if ( FactsQuerySum("ACS_Hood_Normal_Equipped") <= 0 
		&& !GetWitcherPlayer().IsItemEquippedByName('KM Cloak') 
		&& !GetWitcherPlayer().IsItemEquippedByName('KM Cloak Lowered') 
		&& !GetWitcherPlayer().IsItemEquippedByName('KM Pointy Cloak') 
		)
		{
			thePlayer.DestroyEffect('demonic_possession');
			thePlayer.PlayEffect('demonic_possession');
			thePlayer.StopEffect('demonic_possession');
		}

		vACS_Hood.ACS_Hood_Disable_Engage();

		RemoveTimer('Hood_Include_Toggle_Delay');

		hoodtoggle = false;

		ACS_Tutorial_Display_Check('ACS_Hood_And_Mask_Tutorial_Shown');

		if (FactsQuerySum("ACS_Hood_Enabled") > 0)
		{
			FactsRemove("ACS_Hood_Enabled");
		}
	}

	public timer function Hood_Include_Delay(deltaTime : float , id : int)
	{
		var dyeColor: name;
		var hoodId, dyeId: array<SItemUniqueId>;
		var equippedItemsId : array<SItemUniqueId>;
		var j : int;
		var inv : CInventoryComponent;
		var witcher : W3PlayerWitcher;
		var ids : array<SItemUniqueId>;
		var size : int;
		var i : int;

		if( GetWitcherPlayer().IsItemEquippedByName('KM Cloak') 
		|| GetWitcherPlayer().IsItemEquippedByName('KM Cloak Lowered') 
		|| GetWitcherPlayer().IsItemEquippedByName('KM Pointy Cloak') 
		)
		{
			//Hood_Exclude();

			if( GetWitcherPlayer().IsItemEquippedByName('KM Cloak Lowered') )
			{
				dyeColor = thePlayer.inv.GetItemColor( thePlayer.inv.GetItemId('KM Cloak Lowered') );

				thePlayer
					.GetInventory()
					.RemoveItemByName('KM Cloak', -1);

				thePlayer
					.GetInventory()
					.RemoveItemByName('KM Pointy Cloak', -1);

				thePlayer
					.GetInventory()
					.RemoveItemByName('KM Cloak Lowered', -1);

				if (FactsQuerySum("ACS_Player_Using_KM_Pointy_Cloak") > 0)
				{
					hoodId = thePlayer.inv.AddAnItem('KM Pointy Cloak', 1, true, true);
				}
				else if (FactsQuerySum("ACS_Player_Using_KM_Cloak") > 0)
				{
					hoodId = thePlayer.inv.AddAnItem('KM Cloak', 1, true, true);
				}
				
				dyeId = thePlayer.inv.AddAnItem(dyeColor, 1, true, true);
				thePlayer.inv.ColorItem(hoodId[0], dyeId[0]);
				thePlayer.inv.RemoveItem( dyeId[0], 1 );
				thePlayer.EquipItem( hoodId[0] );

				witcher = GetWitcherPlayer();
				inv = witcher.GetInventory();

				ids.Clear();

				ids = inv.GetItemsByCategory( 'hair' );

				size = ids.Size();
					
				if( size > 0 )
				{					
					for( i = 0; i < size; i+=1 )
					{
						if(inv.IsItemMounted( ids[i] ) )
						{
							inv.DespawnItem(ids[i]);
						}
					}				
				}
			}
		}
		else
		{
			Hood_Include();
		}
		
		RemoveTimer('HoodAnimProgressComplete');
		AddTimer('HoodAnimProgressComplete', 1.5 , false);
	}

	public timer function Hood_Exclude_Delay(deltaTime : float , id : int)
	{
		var dyeColor: name;
		var hoodId, dyeId: array<SItemUniqueId>;
		var equippedItemsId : array<SItemUniqueId>;
		var j : int;
		var l_actor : CActor;
		var l_comp 	: CComponent;
		var inv : CInventoryComponent;
		var ids : array<SItemUniqueId>;
		var size : int;
		var i : int;
	

		if( GetWitcherPlayer().IsItemEquippedByName('KM Cloak') 
		|| GetWitcherPlayer().IsItemEquippedByName('KM Cloak Lowered') 
		|| GetWitcherPlayer().IsItemEquippedByName('KM Pointy Cloak') 
		)
		{
			if( GetWitcherPlayer().IsItemEquippedByName('KM Cloak') )
			{
				if ( FactsQuerySum("ACS_Player_Using_KM_Cloak") <= 0 )
				{
					FactsAdd("ACS_Player_Using_KM_Cloak", 1, -1);
				}

				if (FactsQuerySum("ACS_Player_Using_KM_Pointy_Cloak") > 0)
				{
					FactsRemove("ACS_Player_Using_KM_Pointy_Cloak");
				}

				dyeColor = thePlayer.inv.GetItemColor( thePlayer.inv.GetItemId('KM Cloak') );

				thePlayer
					.GetInventory()
					.RemoveItemByName('KM Cloak', -1);

				thePlayer
					.GetInventory()
					.RemoveItemByName('KM Cloak Lowered', -1);

				hoodId = thePlayer.inv.AddAnItem('KM Cloak Lowered', 1, true, true);
				dyeId = thePlayer.inv.AddAnItem(dyeColor, 1, true, true);
				thePlayer.inv.ColorItem(hoodId[0], dyeId[0]);
				thePlayer.inv.RemoveItem( dyeId[0], 1 );

				thePlayer.GetInventory().AddItemTag( hoodId[0], 'NoShow' );
				thePlayer.GetInventory().AddItemTag( hoodId[0], 'NoDrop' );

				thePlayer.EquipItem( hoodId[0] );

				ids.Clear();

				l_actor = thePlayer;
				l_comp = l_actor.GetComponentByClassName( 'CAppearanceComponent' );

				inv = thePlayer.GetInventory();
			
				ids = inv.GetItemsByCategory( 'hair' );
				size = ids.Size();
				
				if( size > 0 )
				{					
					for( i = 0; i < size; i+=1 )
					{
						if(inv.IsItemMounted( ids[i] ) )
						{
							inv.MountItem(ids[i],,true);
						}
					}	
				}		

				ids.Clear();
		
			}
			else if( GetWitcherPlayer().IsItemEquippedByName('KM Pointy Cloak') )
			{
				if ( FactsQuerySum("ACS_Player_Using_KM_Pointy_Cloak") <= 0 )
				{
					FactsAdd("ACS_Player_Using_KM_Pointy_Cloak", 1, -1);
				}

				if (FactsQuerySum("ACS_Player_Using_KM_Cloak") > 0)
				{
					FactsRemove("ACS_Player_Using_KM_Cloak");
				}

				dyeColor = thePlayer.inv.GetItemColor( thePlayer.inv.GetItemId('KM Pointy Cloak') );

				thePlayer
					.GetInventory()
					.RemoveItemByName('KM Pointy Cloak', -1);

				thePlayer
					.GetInventory()
					.RemoveItemByName('KM Cloak Lowered', -1);

				hoodId = thePlayer.inv.AddAnItem('KM Cloak Lowered', 1, true, true);
				dyeId = thePlayer.inv.AddAnItem(dyeColor, 1, true, true);
				thePlayer.inv.ColorItem(hoodId[0], dyeId[0]);
				thePlayer.inv.RemoveItem( dyeId[0], 1 );

				thePlayer.GetInventory().AddItemTag( hoodId[0], 'NoShow' );
				thePlayer.GetInventory().AddItemTag( hoodId[0], 'NoDrop' );

				thePlayer.EquipItem( hoodId[0] );

				ids.Clear();

				l_actor = thePlayer;
				l_comp = l_actor.GetComponentByClassName( 'CAppearanceComponent' );

				inv = thePlayer.GetInventory();
			
				ids = inv.GetItemsByCategory( 'hair' );
				size = ids.Size();
				
				if( size > 0 )
				{					
					for( i = 0; i < size; i+=1 )
					{
						if(inv.IsItemMounted( ids[i] ) )
						{
							inv.MountItem(ids[i],,true);
						}
					}	
				}		

				ids.Clear();
		
			}
		}

		Hood_Exclude();
			
		RemoveTimer('HoodAnimProgressComplete');
		AddTimer('HoodAnimProgressComplete', 1.5 , false);
	}

	public timer function HoodAnimProgressComplete(deltaTime : float , id : int)
	{
		hoodaniminprogress = false;
	}

	var vACS_Additional_Helmets : cACS_Additional_Helmets;

	function Additional_Helmets_Destroy()
	{	
		var helm_destroy_1, helm_destroy_2, helm_destroy_3, helm_destroy_4, anchor_destroy	: CEntity;	

		thePlayer.PlayEffectSingle('demonic_possession');
		thePlayer.StopEffect('demonic_possession');

		ACSGetCEntity('acs_helm_1').Destroy();

		ACSGetCEntity('acs_helm_2').Destroy();

		ACSGetCEntity('acs_helm_3').Destroy();

		ACSGetCEntity('acs_helm_4').Destroy();
					
		ACSGetCEntity('acs_helm_anchor').Destroy();

		vACS_Additional_Helmets = new cACS_Additional_Helmets in this;

		vACS_Additional_Helmets.ACS_Additional_Helmets_Exclude_Engage();
	}

	public timer function ACS_AdditionalHelmetsSpawnDelay(deltaTime : float , id : int)
	{
		vACS_Additional_Helmets = new cACS_Additional_Helmets in this;

		thePlayer.PlayEffectSingle('demonic_possession');
		thePlayer.StopEffect('demonic_possession');

		vACS_Additional_Helmets.ACS_Additional_Helmets_Include_Engage();

		RemoveTimer('ACS_Embers_Timer');
		AddTimer('ACS_Embers_Timer', 0.004 , true);

		if (!thePlayer.IsEffectActive('acs_armor_effect_3', false))
		{
			thePlayer.PlayEffectSingle('acs_armor_effect_3');
		}

		RemoveTimer('ACSArmorBreathingTimer');
		AddTimer('ACSArmorBreathingTimer', 1 , true);

		if (!thePlayer.IsEffectActive('demon_cs', false))
		{
			thePlayer.PlayEffectSingle('demon_cs');
		}

		if (!thePlayer.IsEffectActive('him_smoke_red', false))
		{
			thePlayer.PlayEffectSingle('him_smoke_red');
		}

		if(thePlayer.IsAnyWeaponHeld())
		{
			if (!thePlayer.IsEffectActive('acs_armor_effect_1', false))
			{
				thePlayer.PlayEffectSingle('acs_armor_effect_1');
			}
		}

		//AddTimer('ACS_Embers_Particles_Timer', 2 , true);

		helmtoggle = true;
	}

	public timer function ACS_AdditionalHelmetsDespawnDelay(deltaTime : float , id : int)
	{
		Additional_Helmets_Destroy();

		RemoveTimer('ACS_Embers_Timer');

		RemoveTimer('ACSArmorBreathingTimer');

		//RemoveTimer('ACS_Embers_Particles_Timer');

		if (thePlayer.IsEffectActive('acs_armor_effect_1', false))
		{
			thePlayer.StopEffect('acs_armor_effect_1');
		}
		
		if (thePlayer.IsEffectActive('acs_armor_effect_2', false))
		{
			thePlayer.StopEffect('acs_armor_effect_2');
		}

		if (thePlayer.IsEffectActive('acs_armor_effect_3', false))
		{
			thePlayer.StopEffect('acs_armor_effect_3');
		}

		if (thePlayer.IsEffectActive('demon_cs', false))
		{
			thePlayer.StopEffect('demon_cs');
		}

		if (thePlayer.IsEffectActive('him_smoke_red', false))
		{
			thePlayer.StopEffect('him_smoke_red');
		}

		helmtoggle = false;
	}

	event OnACSHelmToggle( action : SInputAction )
	{
		if (FactsQuerySum("acs_transformation_activated") > 0)
		{
			return false;
		}

		if (!AnimProgressCheck())
		{
			return false;
		}

		if (IsPressed(action))
		{
			if (theInput.LastUsedGamepad() && theInput.GetActionValue('ACSToggleWearablesMode') < 0.5)
			{
				return false;
			} 

			if (ACS_Armor_Set_Check('acs_armor', false))
			{
				if (hoodtoggle)
				{
					return false;
				}

				if (!helmtoggle && FactsQuerySum("acs_transformation_activated") <= 0 && !hoodtoggle)
				{
					thePlayer.PlayEffectSingle('demonic_possession');
					thePlayer.StopEffect('demonic_possession');

					RemoveTimer('ACS_AdditionalHelmetsSpawnDelay');
					RemoveTimer('ACS_AdditionalHelmetsDespawnDelay');

					AddTimer('ACS_AdditionalHelmetsSpawnDelay', 0.75 , false);
				}
				else
				{
					thePlayer.PlayEffectSingle('demonic_possession');
					thePlayer.StopEffect('demonic_possession');

					RemoveTimer('ACS_AdditionalHelmetsSpawnDelay');
					RemoveTimer('ACS_AdditionalHelmetsDespawnDelay');

					AddTimer('ACS_AdditionalHelmetsDespawnDelay', 0.75 , false);
				}
			}
			else
			{
				if (helmtoggle)
				{
					return false;
				}

				if (FactsQuerySum("acs_transformation_activated") > 0)
				{
					return false;
				}

				RemoveTimer('Hood_Include_Delay');
				RemoveTimer('Hood_Exclude_Delay');

				if (thePlayer.HasTag('ACS_IsSwordWalking'))
				{
					thePlayer.RemoveTag('ACS_IsSwordWalking');
				}

				if ( thePlayer.IsHoldingItemInLHand() ) 
				{
					thePlayer.OnUseSelectedItem( true );
				}

				if ( thePlayer.IsCrossbowHeld() ) 
				{
					thePlayer.OnRangedForceHolster( false, true );
				}

				hoodaniminprogress = true;

				if( GetWitcherPlayer().IsItemEquippedByName('KM Cloak') 
				|| GetWitcherPlayer().IsItemEquippedByName('KM Cloak Lowered') 
				|| GetWitcherPlayer().IsItemEquippedByName('KM Pointy Cloak') 
				)
				{
					if( GetWitcherPlayer().IsItemEquippedByName('KM Cloak') || GetWitcherPlayer().IsItemEquippedByName('KM Pointy Cloak') )
					{
						thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');

						thePlayer.RaiseEvent('ACS_HoodDisabled');

						AddTimer('Hood_Exclude_Delay', 1.5 , false);
					}
					else if( GetWitcherPlayer().IsItemEquippedByName('KM Cloak Lowered') )
					{
						thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');

						thePlayer.RaiseEvent('ACS_HoodEnabled');

						AddTimer('Hood_Include_Delay', 0.75 , false);
					}
				}
				else
				{
					if (!helmtoggle && !hoodtoggle)
					{
						thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');

						thePlayer.RaiseEvent('ACS_HoodEnabled');

						AddTimer('Hood_Include_Delay', 0.45 , false);
					}
					else
					{
						thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');

						thePlayer.RaiseEvent('ACS_HoodDisabled');

						AddTimer('Hood_Exclude_Delay', 1.5 , false);
					}
				}
			}

			return false;
		}
	}

	function Facegear_Include_Startup()
	{
		vACS_Facegear = new cACS_Facegear in this;
				
		vACS_Facegear.cACS_Facegear_Include_Engage();

		facemasktoggle = true;

		if ( FactsQuerySum("ACS_Mask_Enabled") <= 0 )
		{
			FactsAdd("ACS_Mask_Enabled", 1, -1);
		}
	}

	function Facegear_Include_No_Anim()
	{
		if ( FactsQuerySum("ACS_Mask_Enabled") <= 0 )
		{
			vACS_Facegear = new cACS_Facegear in this;
				
			vACS_Facegear.cACS_Facegear_Include_Engage();

			facemasktoggle = true;

			FactsAdd("ACS_Mask_Enabled", 1, -1);
		}
	}

	function Facegear_Exclude_No_Anim()
	{
		if ( FactsQuerySum("ACS_Mask_Enabled") > 0 )
		{
			vACS_Facegear = new cACS_Facegear in this;
				
			vACS_Facegear.cACS_Facegear_Exclude_Engage();

			facemasktoggle = false;

			FactsRemove("ACS_Mask_Enabled");
		}
	}

	function Facegear_Include()
	{
		var item : SItemUniqueId;

		GetWitcherPlayer().GetItemEquippedOnSlot(EES_Armor, item);

		if ( !GetWitcherPlayer().IsAnyItemEquippedOnSlot(EES_Armor)
		|| StrContains( GetWitcherPlayer().inv.GetItemName(item), "body torso" ) 
		)
		{
			return;
		}

		if (theGame.IsDialogOrCutscenePlaying() 
		|| theGame.IsFading()
		|| theGame.IsBlackscreen()
		|| theGame.GetPhotomodeEnabled() 
		|| thePlayer.IsInCutsceneIntro() 
		)
		{
			if ( FactsQuerySum("ACS_Mask_Enabled") <= 0 )
			{
				vACS_Facegear = new cACS_Facegear in this;
				
				vACS_Facegear.cACS_Facegear_Include_Engage();

				facemasktoggle = true;

				FactsAdd("ACS_Mask_Enabled", 1, -1);
			}
		}
		else
		{
			if (!AnimProgressCheck())
			{
				return;
			}

			ACS_Tutorial_Display_Check('ACS_Hood_And_Mask_Tutorial_Shown');

			if (thePlayer.HasTag('ACS_IsSwordWalking'))
			{
				thePlayer.RemoveTag('ACS_IsSwordWalking');
			}

			if ( thePlayer.IsHoldingItemInLHand() ) 
			{
				thePlayer.OnUseSelectedItem( true );
			}

			if ( thePlayer.IsCrossbowHeld() ) 
			{
				thePlayer.OnRangedForceHolster( false, true );
			}
	
			maskaniminprogress = true;

			thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');

			thePlayer.RaiseEvent('ACS_MaskAnim');

			RemoveTimer('maskAnimInProgressSet');
			AddTimer('maskAnimInProgressSet', 1.25 , false);
		
			AddTimer('ACS_FaceGearIncludeDelay', 0.5 , false);
		}
	}

	function Facegear_Exclude()
	{
		var item : SItemUniqueId;

		GetWitcherPlayer().GetItemEquippedOnSlot(EES_Armor, item);

		if ( !GetWitcherPlayer().IsAnyItemEquippedOnSlot(EES_Armor) 
		|| StrContains( GetWitcherPlayer().inv.GetItemName(item), "body torso" ) 
		)
		{
			return;
		}

		if (theGame.IsDialogOrCutscenePlaying() 
		|| theGame.IsFading()
		|| theGame.IsBlackscreen()
		|| theGame.GetPhotomodeEnabled() 
		|| thePlayer.IsInCutsceneIntro() 
		)
		{
			if ( FactsQuerySum("ACS_Mask_Enabled") > 0 )
			{
				vACS_Facegear = new cACS_Facegear in this;
				
				vACS_Facegear.cACS_Facegear_Exclude_Engage();

				facemasktoggle = false;

				FactsRemove("ACS_Mask_Enabled");
			}
		}
		else
		{
			if (!AnimProgressCheck())
			{
				return;
			}

			ACS_Tutorial_Display_Check('ACS_Hood_And_Mask_Tutorial_Shown');

			if (thePlayer.HasTag('ACS_IsSwordWalking'))
			{
				thePlayer.RemoveTag('ACS_IsSwordWalking');
			}

			if ( thePlayer.IsHoldingItemInLHand() ) 
			{
				thePlayer.OnUseSelectedItem( true );
			}

			if ( thePlayer.IsCrossbowHeld() ) 
			{
				thePlayer.OnRangedForceHolster( false, true );
			}

			maskaniminprogress = true;

			RemoveTimer('maskAnimInProgressSet');
			AddTimer('maskAnimInProgressSet', 1 , false);

			thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');

			thePlayer.RaiseEvent('ACS_MaskAnim');

			AddTimer('ACS_FaceGearExcludeDelay', 0.5 , false);
		}
	}

	public timer function ACS_FaceGearIncludeDelay(deltaTime : float , id : int)
	{
		vACS_Facegear = new cACS_Facegear in this;
				
		vACS_Facegear.cACS_Facegear_Include_Engage();

		facemasktoggle = true;

		if ( FactsQuerySum("ACS_Mask_Enabled") <= 0 )
		{
			FactsAdd("ACS_Mask_Enabled", 1, -1);
		}
	}

	public timer function ACS_FaceGearExcludeDelay(deltaTime : float , id : int)
	{
		vACS_Facegear = new cACS_Facegear in this;
				
		vACS_Facegear.cACS_Facegear_Exclude_Engage();

		facemasktoggle = false;

		if ( FactsQuerySum("ACS_Mask_Enabled") > 0 )
		{
			FactsRemove("ACS_Mask_Enabled");
		}
	}

	public timer function maskAnimInProgressSet(deltaTime : float , id : int)
	{
		maskaniminprogress = false;
	}

	var vACS_Facegear : cACS_Facegear;

	event OnACSFacemaskToggle( action : SInputAction )
	{
		if (FactsQuerySum("acs_transformation_activated") > 0)
		{
			return false;
		}

		if (!AnimProgressCheck())
		{
			return false;
		}

		if ( IsPressed( action ) )
		{	
			if (theInput.LastUsedGamepad() && theInput.GetActionValue('ACSToggleWearablesMode') < 0.5) 
			{
				return false;
			}

			if (!facemasktoggle)
			{
				Facegear_Include();
			}
			else
			{
				Facegear_Exclude();
			}	
		}
	}


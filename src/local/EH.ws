	public timer function PrayDelay(deltaTime : float , id : int)
	{
		ForceSheathWeaponNoAnim();

		thePlayer.RaiseEvent('ACS_CombatExtraReset');

		IdleAdditiveBlockTemp();

		thePlayer.RaiseEvent('ACS_Pray');
	}

	function CombatArtSwitch(combatArt : name)
	{
		if (!thePlayer.IsAnyWeaponHeld() || thePlayer.IsWeaponHeld('fist') )
		{
			thePlayer.RaiseEvent('ACS_Pray');
		}

		GetACSStorage().acs_deleteOnelinerByTag("ACS_Combat_Art_Notification");

		switch(combatArt)
		{
			case 'wolven_flash':
				if (FactsQuerySum("ACS_Wolven_Flash_Activated") > 0)
				{
					if (FactsQuerySum("ACS_Combat_Art_Active") > 0)
					{
						FactsRemove("ACS_Combat_Art_Active");
					}
					
					ACS_Oneliner(
					(new ACS_Oneliner_TagBuilder in theGame)
					.tag("font")
					.attr("size", "26")
					.attr("color", "#ffffff")
					.text(GetLocStringById(2116581012) + "<br/>" + GetLocStringById(2116581041) + "<br/>" + GetLocStringById(2118449903))
					, thePlayer, "ACS_Combat_Art_Notification", Vector(0,0,1.5), 2);

					GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Combat_Art_Notification", 100);

					GetACSStorage().acs_setScaleForOnelinerByTag("ACS_Combat_Art_Notification", 100, 100, 100);

					FactsRemove("ACS_Wolven_Flash_Activated");
				}
				else 
				{
					if (FactsQuerySum("ACS_One_Mind_Activated") > 0)
					{
						FactsRemove("ACS_One_Mind_Activated");
					}

					if (FactsQuerySum("ACS_Spiral_Cloud_Passage_Activated") > 0)
					{
						FactsRemove("ACS_Spiral_Cloud_Passage_Activated");
					}

					if (FactsQuerySum("ACS_Feainnewedd_Dance_Activated") > 0)
					{
						FactsRemove("ACS_Feainnewedd_Dance_Activated");
					}

					if (FactsQuerySum("ACS_Mortal_Draw_Activated") > 0)
					{
						FactsRemove("ACS_Mortal_Draw_Activated");
					}

					if (FactsQuerySum("ACS_Wolven_Cross_Activated") > 0)
					{
						FactsRemove("ACS_Wolven_Cross_Activated");
					}

					if (FactsQuerySum("ACS_ShadowFall_Activated") > 0)
					{
						FactsRemove("ACS_ShadowFall_Activated");
					}

					if ( FactsQuerySum("ACS_Wolven_Flash_Activated") <= 0 )
					{
						ACS_Tutorial_Display_Check('ACS_Combat_Art_Tutorial_Shown');

						ACS_Oneliner(
						(new ACS_Oneliner_TagBuilder in theGame)
						.tag("font")
						.attr("size", "26")
						.attr("color", "#ffffff")

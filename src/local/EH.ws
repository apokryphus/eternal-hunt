		}
		else
		{
			if (ACSGetCActor('ACS_Transformation_Vampiress').HasTag('ACS_Transformation_Bruxa'))
			{
				attackRange = 1.5;

				attackAngle = 60;
			}
			else
			{
				attackRange = 2;

				attackAngle = 90;
			}

			targetNum = 20;
		}

		actors.Clear();

		actors = ACSGetCActor('ACS_Transformation_Vampiress').GetNPCsAndPlayersInCone(attackRange, VecHeading(ACSGetCActor('ACS_Transformation_Vampiress').GetHeadingVector()), attackAngle, targetNum, , FLAG_ExcludePlayer + FLAG_OnlyAliveActors);

		actors.Remove( ACSGetCActor('ACS_Transformation_Vampiress') );


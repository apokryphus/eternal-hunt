				GeraltHeavyAttackDefault(false);
			
			break;

			case 'geraltRandomGeraltHeavyAttack_Wolf_Silver':
			
				RemoveTimer('ACS_Combo_Counter_Reset_Timer'); AddTimer('ACS_Combo_Counter_Reset_Timer', 4 , false);

				thePlayer.RaiseEvent('ACS_TW1AnimsReset');
				
				GeraltHeavyAttackDefault(false);
			
			break;

			default:
			break;
		}
	}

	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	function Attack_Process_12( attack_name : name ) 
	{
		MovementAdjust('default');
		
		if( actor && ACS_AttitudeCheck ( actor ) && thePlayer.IsInCombat() )
		{	
			if ( ACS_Settings_Main_Int('acs_target_settings','acs_target_mode', 0) == 0 || ACS_Settings_Main_Int('acs_target_settings','acs_target_mode', 0) == 1 )
			{
				if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTowards( ticket, actor );}  
			}
			else if ( ACS_Settings_Main_Int('acs_target_settings','acs_target_mode', 0) == 2 )
			{
				if (thePlayer.IsHardLockEnabled())
				{
					if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTowards( ticket, actor );}  
				}
				else
				{
					if(!thePlayer.HasTag('ACS_Manual_Combat_Control')){thePlayer.AddTag('ACS_Manual_Combat_Control');} RemoveTimer('Manual_Combat_Control_Remove'); AddTimer('Manual_Combat_Control_Remove', 2 , false);//if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTo( ticket, VecHeading( theCamera.GetCameraDirection() ) );}
				}	
			}

			Attack_Process_12_Primary(attack_name);
			
			return;
		}
	
		Attack_Process_Direction();

		Attack_Process_12_Secondary(attack_name);
	}

	function Attack_Process_12_Primary( attack_name : name ) 
	{
		switch ( attack_name )
		{
			case 'geraltRandomGeraltHeavyAttackForward_Wolf_Silver':
			
				RemoveTimer('ACS_Combo_Counter_Reset_Timer'); AddTimer('ACS_Combo_Counter_Reset_Timer', 4 , false);

				if( targetDistance <= 4 * 4) 
				{
					thePlayer.RaiseEvent('ACS_TW1AnimsReset');

					GeraltHeavyAttackDefault(false);
				}
				else
				{
					GeraltHeavyAttackDefaultForward();
				}
			
			break;

			case 'geraltRandomGeraltLightAttack_Viper':
			
				RemoveTimer('ACS_Combo_Counter_Reset_Timer'); AddTimer('ACS_Combo_Counter_Reset_Timer', 4 , false);
				

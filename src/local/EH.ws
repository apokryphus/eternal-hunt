		vACS_Marker.ACS_Marker_Lightning_Engage();
	}

	var vACS_Ghost_Stance_Switch : cACS_Ghost_Stance_Switch;

	function Ghost_Stance_Control()
	{
		var moveTargets 												    : array<CActor>;
		var i 															    : int;
		var ent															    : CEntity;
		var rot                        						 				: EulerAngles;
		var pos																: Vector;
		
		if (thePlayer.HasTag('ACS_Ghost_Stance_Active')
		)
		{
			thePlayer.DrainStamina( ESAT_FixedValue,  thePlayer.GetStatMax( BCS_Stamina ), 0.5 );

			moveTargets.Clear();
			moveTargets = thePlayer.GetMoveTargets();
					
			for( i = 0; i < moveTargets.Size(); i += 1 )
			{
				moveTargets[i].SignalGameplayEvent( 'InterruptChargeAttack' );
			}

			if (!ACSGetCEntity('ACS_Ghost_Sword_Ent'))
			{
				ACS_Tutorial_Display_Check('ACS_Gwynbleidd_Stance_Tutorial_Shown');

				if (FactsQuerySum("ACS_Dual_Wield_Toggle_Enabled") > 0)
				{
					RemoveTimer('DualWieldToggleInitDelay'); 

					FactsRemove("ACS_Dual_Wield_Toggle_Enabled");
				}

				if (FactsQuerySum("ACS_Spear_Transform_Toggle_Enabled") > 0)
				{
					RemoveTimer('SpearTransformToggleInitDelay'); 

					FactsRemove("ACS_Spear_Transform_Toggle_Enabled");
				}

				DisableCatViewFx( 0 );

				EnableCatViewFx( 0.5f );

				SetTintColorsCatViewFx(Vector(0.1f,0.1f,0.1f,0.5f),Vector(1.0f,0.0f,0.0f,0.5f),0.95f);

				SetBrightnessCatViewFx(5.0f);

				SetViewRangeCatViewFx(5000.0f);

				SetPositionCatViewFx( Vector(0,0,0,0) , true );	

				SetHightlightCatViewFx( Vector(1.0f,0.1f,0.1f,0.5f),0.5f,500);

				SetFogDensityCatViewFx( 0 );

				vACS_Ghost_Stance_Switch = new cACS_Ghost_Stance_Switch in this;
	
				vACS_Ghost_Stance_Switch.ACS_Ghost_Stance_Switch_Activate_Engage();

				ACSGetCEntity('ACS_Ghost_Sword_Ent').Destroy();

				rot = thePlayer.GetWorldRotation();

				pos = thePlayer.GetWorldPosition();

				ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

				"dlc\dlc_acs\data\fx\acs_sword_slashes.w2ent"

				, true ), pos, rot );

				ent.CreateAttachment( thePlayer, 'r_weapon', Vector( 0, 0, 0.5 ), EulerAngles(0,0,0) );

				ent.PlayEffectSingle('sword_slash');

				ent.PlayEffectSingle('sword_slash_red');

				ent.AddTag('ACS_Ghost_Sword_Ent');
			}

			if( thePlayer.GetStat( BCS_Focus ) <= 0.01
			|| ghost_stance_active_kill_count >= 7
			|| theGame.IsDialogOrCutscenePlaying() 
			|| thePlayer.IsInNonGameplayCutscene() 
			|| thePlayer.IsInGameplayScene() 
			|| theGame.IsCurrentlyPlayingNonGameplayScene()
			|| theGame.GetPhotomodeEnabled() 
			|| thePlayer.IsInCutsceneIntro() 
			|| theGame.IsFading()
			|| theGame.IsBlackscreen()
			|| !thePlayer.IsThreatened()
			|| !thePlayer.IsAnyWeaponHeld() 
			|| thePlayer.IsWeaponHeld('fist') 
			|| thePlayer.HasTag('acs_vampire_claws_equipped')
			|| thePlayer.HasTag('acs_aard_sword_equipped') 
			|| thePlayer.HasTag('acs_aard_secondary_sword_equipped') 
			|| thePlayer.HasTag('acs_quen_secondary_sword_equipped') 
			|| thePlayer.HasTag('acs_yrden_sword_equipped') 
			|| thePlayer.HasTag('acs_yrden_secondary_sword_equipped') 
			|| thePlayer.HasTag('acs_quen_sword_equipped') 
			|| thePlayer.HasTag('acs_axii_sword_equipped') 
			|| thePlayer.HasTag('acs_axii_secondary_sword_equipped') 
			|| thePlayer.HasTag('acs_sorc_fists_equipped')
			|| thePlayer.IsUsingHorse() 
			|| thePlayer.IsUsingVehicle()
			|| thePlayer.IsSwimming()
			|| thePlayer.IsDiving()
			) 
			{
				if (ACSGetCEntity('ACS_Ghost_Sword_Ent'))
				{
					DisableCatViewFx( 2.5f );

					ACSGetCEntity('ACS_Ghost_Sword_Ent').Destroy();
				}

				vACS_Ghost_Stance_Switch = new cACS_Ghost_Stance_Switch in this;

				vACS_Ghost_Stance_Switch.ACS_Ghost_Stance_Switch_Deactivate_Engage();

				thePlayer.RemoveTag('ACS_Ghost_Stance_Active');
			}
		}
	}

	var vACS_Stance_Switch : cACS_Stance_Switch;

	var dualWieldGuarded, dualWieldGuardBlockEnabled : bool;

	function Dual_Wield_Control()
	{
		var bone_vec											: Vector;
		var bone_rot											: EulerAngles;
		var anchor_temp											: CEntityTemplate;
		var anchor1												: CEntity;

		if( 
		thePlayer.HasTag('acs_vampire_claws_equipped')
		|| thePlayer.HasTag('acs_aard_sword_equipped') 
		|| thePlayer.HasTag('acs_aard_secondary_sword_equipped') 
		|| thePlayer.HasTag('acs_quen_secondary_sword_equipped') 
		|| thePlayer.HasTag('acs_yrden_sword_equipped') 
		|| thePlayer.HasTag('acs_yrden_secondary_sword_equipped') 
		|| thePlayer.HasTag('acs_quen_sword_equipped') 
		|| thePlayer.HasTag('acs_axii_sword_equipped') 
		|| thePlayer.HasTag('acs_axii_secondary_sword_equipped') 
		|| thePlayer.HasTag('acs_sorc_fists_equipped')
		|| thePlayer.HasTag('ACS_Ghost_Stance_Active')
		|| FactsQuerySum("ACS_Wolf_Style_Activate") > 0
		|| FactsQuerySum("ACS_Bear_Style_Activate") > 0
		|| FactsQuerySum("ACS_Cat_Style_Activate") > 0
		|| FactsQuerySum("ACS_Griffin_Style_Activate") > 0
		|| FactsQuerySum("ACS_Manticore_Style_Activate") > 0
		|| FactsQuerySum("ACS_Viper_Style_Activate") > 0
		|| FactsQuerySum("ACS_Forgotten_Wolf_Style_Activate") > 0
		|| FactsQuerySum("ACS_Azkar_Active") > 0
		|| FactsQuerySum("ACS_Spear_Transform_Toggle_Enabled") > 0
		|| ( ACS_GetWeaponMode() == 0 && ACS_Settings_Main_Int('acs_combat_main_settings','acs_fist_mode', 0) == 1 )
		|| ( ACS_GetWeaponMode() == 1 && ACS_Settings_Main_Int('acs_combat_main_settings','acs_fist_mode', 0) == 1 )
		|| ( ACS_GetWeaponMode() == 2 && ACS_Settings_Main_Int('acs_combat_main_settings','acs_fist_mode', 0) == 1 )
		|| ( ACS_GetWeaponMode() == 3 && (ACS_GetItem_VampClaw('shades') || ACS_GetItem_VampClaw('default') ) )
		//|| ACS_Armor_Set_Check('acs_armor', false)
		) 
		{
			if (FactsQuerySum("ACS_Dual_Wield_Toggle_Enabled") > 0)
			{
				GetACSStorage().acs_deleteOnelinerByTag("ACS_Dual_Wield_Toggle_Notification");

				thePlayer.GetBoneWorldPositionAndRotationByIndex( thePlayer.GetBoneIndex( 'r_hand' ), bone_vec, bone_rot );

				anchor_temp = (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\entities\other\fx_ent.w2ent", true );
				anchor1 = (CEntity)theGame.CreateEntity( anchor_temp, thePlayer.GetWorldPosition() );
				anchor1.CreateAttachmentAtBoneWS( GetWitcherPlayer(), 'r_hand', bone_vec, bone_rot );

				anchor1.DestroyAfter(2);

				ACS_Oneliner(
				(new ACS_Oneliner_TagBuilder in theGame)
				.tag("font")
				.attr("size", "16")
				.attr("color", "#ffffff")
				.text(GetLocStringById(2118449908) + "<br/>" + GetLocStringById(2118449909) + "<br/>" + GetLocStringById(2118449903) + GetLocStringById(2118449904))
				, anchor1, "ACS_Dual_Wield_Toggle_Notification", Vector(0,0,0), 2);

				GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Dual_Wield_Toggle_Notification", 100);

				GetACSStorage().acs_setScaleForOnelinerByTag("ACS_Dual_Wield_Toggle_Notification", 100, 100, 100);

				RemoveTimer('DualWieldToggleInitDelay'); 

				FactsRemove("ACS_Dual_Wield_Toggle_Enabled");
			}

			if (thePlayer.HasTag('ACS_Dual_Wield_Active'))
			{
				if (ACSGetCEntity('ACS_Dual_Wield_L_Sword_Steel')
				|| ACSGetCEntity('ACS_Dual_Wield_L_Sword_Silver')
				)
				{
					vACS_Stance_Switch = new cACS_Stance_Switch in this;

					vACS_Stance_Switch.ACS_Dual_Wield_Switch_Deactivate_Engage();
				}

				if (dualWieldGuardBlockEnabled)
				{
					GetWitcherPlayer().UnblockAction( EIAB_Counter,			'acs_dual_wield');

					dualWieldGuardBlockEnabled = false;
				}

				dualWieldGuarded = false;

				if (!ACSGetCEntity('ACS_Viper_Dagger_L')){thePlayer.RaiseEvent('ACS_ForceHandClosedLEnd');}

				thePlayer.RemoveTag('ACS_Dual_Wield_Active');
			}

			return;
		}
		
		if (thePlayer.HasTag('ACS_Dual_Wield_Active')
		)
		{
			if (!dualWieldGuardBlockEnabled)
			{
				//GetWitcherPlayer().BlockAction( EIAB_Counter,			'acs_dual_wield');

				dualWieldGuardBlockEnabled = true;
			}

			if (dualWieldGuardBlockEnabled)
			{
				if (thePlayer.IsActionAllowed(EIAB_Counter))
				{
					//GetWitcherPlayer().BlockAction( EIAB_Counter,				'acs_dual_wield');
				}
			}

			if (combatExtraActive
			|| (!thePlayer.IsInCombat() && ACS_CombatToExplorationCheck())
			)
			{
				attach_rot.Roll = 180;
				attach_rot.Pitch = 0;
				attach_rot.Yaw = 0;
				attach_vec.X = 0;
				attach_vec.Y = 0;
				attach_vec.Z = -0.025;

				if (ACSGetCEntity('ACS_Dual_Wield_L_Sword_Steel')
				)
				{
					ACSGetCEntity('ACS_Dual_Wield_L_Sword_Steel').BreakAttachment();

					ACSGetCEntity('ACS_Dual_Wield_L_Sword_Steel').CreateAttachment(thePlayer, 'l_weapon', attach_vec, attach_rot);
				}

				if (ACSGetCEntity('ACS_Dual_Wield_L_Sword_Silver')
				)
				{
					ACSGetCEntity('ACS_Dual_Wield_L_Sword_Silver').BreakAttachment();

					ACSGetCEntity('ACS_Dual_Wield_L_Sword_Silver').CreateAttachment(thePlayer, 'l_weapon', attach_vec, attach_rot);
				}

				if (ACSGetCEntity('acs_sword_trail_1_dual_wield')
				)
				{
					attach_rot.Roll = 180;
					attach_rot.Pitch = 0;
					attach_rot.Yaw = 0;
					attach_vec.X = 0;
					attach_vec.Y = 0;
					attach_vec.Z = -0.025;

					ACSGetCEntity('acs_sword_trail_1_dual_wield').BreakAttachment();

					ACSGetCEntity('acs_sword_trail_1_dual_wield').CreateAttachment(thePlayer, 'l_weapon', attach_vec, attach_rot);
				}

				if (ACSGetCEntity('acs_sword_trail_2_dual_wield')
				)
				{
					attach_rot.Roll = 180;
					attach_rot.Pitch = 0;
					attach_rot.Yaw = 0;
					attach_vec.X = 0;
					attach_vec.Y = 0;
					attach_vec.Z = -0.225;

					ACSGetCEntity('acs_sword_trail_2_dual_wield').BreakAttachment();

					ACSGetCEntity('acs_sword_trail_2_dual_wield').CreateAttachment(thePlayer, 'l_weapon', attach_vec, attach_rot);
				}

				if (ACSGetCEntity('acs_sword_trail_3_dual_wield')
				)
				{
					attach_rot.Roll = 180;
					attach_rot.Pitch = 0;
					attach_rot.Yaw = 0;
					attach_vec.X = 0;
					attach_vec.Y = 0;
					attach_vec.Z = -0.425;

					ACSGetCEntity('acs_sword_trail_3_dual_wield').BreakAttachment();

					ACSGetCEntity('acs_sword_trail_3_dual_wield').CreateAttachment(thePlayer, 'l_weapon', attach_vec, attach_rot);
				}

				dualWieldGuarded = true;
			}
			else
			{
				attach_rot.Roll = 0;
				attach_rot.Pitch = 0;
				attach_rot.Yaw = 0;
				attach_vec.X = 0;
				attach_vec.Y = 0;
				attach_vec.Z = 0.025;

				if (ACSGetCEntity('ACS_Dual_Wield_L_Sword_Steel')
				)
				{
					ACSGetCEntity('ACS_Dual_Wield_L_Sword_Steel').BreakAttachment();

					ACSGetCEntity('ACS_Dual_Wield_L_Sword_Steel').CreateAttachment(thePlayer, 'l_weapon', attach_vec, attach_rot);
				}

				if (ACSGetCEntity('ACS_Dual_Wield_L_Sword_Silver')
				)
				{
					ACSGetCEntity('ACS_Dual_Wield_L_Sword_Silver').BreakAttachment();

					ACSGetCEntity('ACS_Dual_Wield_L_Sword_Silver').CreateAttachment(thePlayer, 'l_weapon', attach_vec, attach_rot);
				}

				if (ACSGetCEntity('acs_sword_trail_1_dual_wield')
				)
				{
					attach_rot.Roll = 0;
					attach_rot.Pitch = 0;
					attach_rot.Yaw = 0;
					attach_vec.X = 0;
					attach_vec.Y = 0;
					attach_vec.Z = 0.025;

					ACSGetCEntity('acs_sword_trail_1_dual_wield').BreakAttachment();

					ACSGetCEntity('acs_sword_trail_1_dual_wield').CreateAttachment(thePlayer, 'l_weapon', attach_vec, attach_rot);
				}

				if (ACSGetCEntity('acs_sword_trail_2_dual_wield')
				)
				{
					attach_rot.Roll = 0;
					attach_rot.Pitch = 0;
					attach_rot.Yaw = 0;
					attach_vec.X = 0;
					attach_vec.Y = 0;
					attach_vec.Z = 0.225;

					ACSGetCEntity('acs_sword_trail_2_dual_wield').BreakAttachment();

					ACSGetCEntity('acs_sword_trail_2_dual_wield').CreateAttachment(thePlayer, 'l_weapon', attach_vec, attach_rot);
				}

				if (ACSGetCEntity('acs_sword_trail_3_dual_wield')
				)
				{
					attach_rot.Roll = 0;
					attach_rot.Pitch = 0;
					attach_rot.Yaw = 0;
					attach_vec.X = 0;
					attach_vec.Y = 0;
					attach_vec.Z = 0.425;

					ACSGetCEntity('acs_sword_trail_3_dual_wield').BreakAttachment();

					ACSGetCEntity('acs_sword_trail_3_dual_wield').CreateAttachment(thePlayer, 'l_weapon', attach_vec, attach_rot);
				}

				dualWieldGuarded = false;
			}

			if (!ACSGetCEntity('ACS_Dual_Wield_L_Sword_Steel')
			&& !ACSGetCEntity('ACS_Dual_Wield_L_Sword_Silver')
			)
			{
				//ACS_Tutorial_Display_Check('ACS_Gwynbleidd_Stance_Tutorial_Shown');

				vACS_Stance_Switch = new cACS_Stance_Switch in this;
	
				vACS_Stance_Switch.ACS_Dual_Wield_Switch_Activate_Engage();
			}

			if( 
			(theGame.IsDialogOrCutscenePlaying() 
			|| thePlayer.IsInNonGameplayCutscene() 
			|| thePlayer.IsInGameplayScene() 
			|| theGame.IsCurrentlyPlayingNonGameplayScene()
			|| theGame.IsFading()
			|| theGame.IsBlackscreen()
			//|| theGame.IsPaused() 
			|| theGame.GetPhotomodeEnabled() 
			|| thePlayer.IsInCutsceneIntro() 
			//|| !thePlayer.IsInCombat()
			|| !thePlayer.IsAnyWeaponHeld() 
			|| thePlayer.IsWeaponHeld('fist') 
			|| thePlayer.IsUsingHorse() 
			|| thePlayer.IsUsingVehicle()
			|| thePlayer.IsSwimming()
			|| thePlayer.IsDiving())
			&& ACS_CombatToExplorationCheck()
			) 
			{
				vACS_Stance_Switch = new cACS_Stance_Switch in this;

				vACS_Stance_Switch.ACS_Dual_Wield_Switch_Deactivate_Engage();

				if (dualWieldGuardBlockEnabled)
				{
					GetWitcherPlayer().UnblockAction( EIAB_Counter,			'acs_dual_wield');

					dualWieldGuardBlockEnabled = false;
				}

				dualWieldGuarded = false;

				if (!ACSGetCEntity('ACS_Viper_Dagger_L')){thePlayer.RaiseEvent('ACS_ForceHandClosedLEnd');}

				thePlayer.RemoveTag('ACS_Dual_Wield_Active');
			}
		}
		else
		{
			if (ACSGetCEntity('ACS_Dual_Wield_L_Sword_Steel')
			|| ACSGetCEntity('ACS_Dual_Wield_L_Sword_Silver')
			)
			{
				vACS_Stance_Switch = new cACS_Stance_Switch in this;

				vACS_Stance_Switch.ACS_Dual_Wield_Switch_Deactivate_Engage();
			}

			if (dualWieldGuardBlockEnabled)
			{
				GetWitcherPlayer().UnblockAction( EIAB_Counter,			'acs_dual_wield');

				dualWieldGuardBlockEnabled = false;
			}

			dualWieldGuarded = false;
		}
	} 


					AddTimer('ACS_HeadbuttDamage', 0.3   , false);

					combo_counter_damage -= combo_counter_damage;

					combo_counter_push += 1;
					break;

					case 0: 
					PlayerPlayAnimation( 'man_geralt_sword_repel_rp_bash_ACS');

					thePlayer.AddTag('ACS_Player_Is_Attacking');

					RemoveTimer('RemovePlayerIsAttackingTag');

					AddTimer('RemovePlayerIsAttackingTag', 0.5 , false );

					AddTimer('ACS_HeadbuttDamage', 0.3   , false);

					combo_counter_damage -= combo_counter_damage;

					combo_counter_push += 1;
					break;

					case 1:
					PlayerPlayAnimation( 'man_npc_sword_1hand_push_1_ACS');	

					thePlayer.AddTag('ACS_Player_Is_Attacking');

					RemoveTimer('RemovePlayerIsAttackingTag');

					AddTimer('RemovePlayerIsAttackingTag', 0.5 , false );

					AddTimer('ACS_HeadbuttDamage', 0.2   , false);

					combo_counter_damage += 1;

					combo_counter_push += 1;
					break;

					case 2:
					PlayerPlayAnimation( 'man_geralt_sword_repel_lp_bash_ACS');

					thePlayer.AddTag('ACS_Player_Is_Attacking');

					RemoveTimer('RemovePlayerIsAttackingTag');

					AddTimer('RemovePlayerIsAttackingTag', 0.5 , false );

					AddTimer('ACS_HeadbuttDamage', 0.3   , false);

					combo_counter_damage += 1;

					combo_counter_push += 1;
					break;

					case 3:
					PlayerPlayAnimation( 'man_npc_sword_1hand_push_2_ACS');	

					thePlayer.AddTag('ACS_Player_Is_Attacking');

					RemoveTimer('RemovePlayerIsAttackingTag');

					AddTimer('RemovePlayerIsAttackingTag', 0.5 , false );

					AddTimer('ACS_HeadbuttDamage', 0.2   , false);

					combo_counter_damage += 1;

					combo_counter_push -= combo_counter_push;
					break;
				}
			break;

			case 'geraltRandomFistfightCounter':
				RemoveTimer('ACS_Combo_Counter_Reset_Timer'); AddTimer('ACS_Combo_Counter_Reset_Timer', 4 , false);

				switch ( combo_counter_push )
				{
					default:
					PlayerPlayAnimation( 'man_fistfight_repel_2_dmg');

					combo_counter_damage -= combo_counter_damage;

					combo_counter_push += 1;
					break;

					case 0: 
					PlayerPlayAnimation( 'man_fistfight_repel_2_dmg');

					combo_counter_damage -= combo_counter_damage;

					combo_counter_push += 1;
					break;

					case 1:
					PlayerPlayAnimation( 'man_fistfight_repel_1');	

					thePlayer.AddTag('ACS_Player_Is_Attacking');

					RemoveTimer('RemovePlayerIsAttackingTag');

					AddTimer('RemovePlayerIsAttackingTag', 0.5 , false );

					AddTimer('ACS_KickDamage', 0.2   , false);

					combo_counter_damage += 1;

					combo_counter_push += 1;
					break;

					case 2:
					PlayerPlayAnimation( 'man_fistfight_repel_2');

					thePlayer.AddTag('ACS_Player_Is_Attacking');

					RemoveTimer('RemovePlayerIsAttackingTag');

					AddTimer('RemovePlayerIsAttackingTag', 0.5 , false );

					AddTimer('ACS_KickDamage', 0.3   , false);

					combo_counter_damage += 1;

					combo_counter_push += 1;
					break;

					case 3:
					PlayerPlayAnimation( 'man_npc_sword_1hand_push_2_ACS');	

					thePlayer.AddTag('ACS_Player_Is_Attacking');

					RemoveTimer('RemovePlayerIsAttackingTag');

					AddTimer('RemovePlayerIsAttackingTag', 0.5 , false );

					AddTimer('ACS_KickDamage', 0.2   , false);

					combo_counter_damage += 1;

					combo_counter_push -= combo_counter_push;
					break;
				}
			break;

			default:
			break;
		}
	}


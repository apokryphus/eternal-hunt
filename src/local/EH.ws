	var last_air_strike_time 				: float;

	/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	
	function SneakyPlantBomb(  selectedItemId : SItemUniqueId, npc : CNewNPC)
	{
		var petard														: CEntity;
		var thrownEntityPath											: String;
		var plantedBomb, plantedBombSecondary							: W3Petard;
		var detonationTimer												: float;
		var bonePosition												: Vector;
		var boneRotation												: EulerAngles;
	
		thePlayer.RaiseEvent('ACS_CombatExtraPlantBomb');

		detonationTimer = RandRangeF(7,5);

		plantedBomb = (W3Petard)theGame.CreateEntity( (CEntityTemplate)LoadResource( 
		"dlc\dlc_acs\data\entities\projectiles\acs_shrapnel_bomb.w2ent"
		, true ), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );

		petard = (CThrowable)(thePlayer.GetInventory()).GetDeploymentItemEntity( selectedItemId,,,true );

		thrownEntityPath = petard.GetReadableName();

		if (StrContains( thrownEntityPath, "frost" ))
		{
			plantedBomb.AddTag('ACS_Bomb_Add_Frozen');
		}

		if (StrContains( thrownEntityPath, "virus" ))
		{
			plantedBomb.AddTag('ACS_Bomb_Add_Poison');
		}

		if (StrContains( thrownEntityPath, "dancing" ))
		{
			plantedBomb.AddTag('ACS_Bomb_Add_Knockdown');
		}

		if (StrContains( thrownEntityPath, "samum" ))
		{
			plantedBomb.AddTag('ACS_Bomb_Add_Blindness');
		}

		plantedBombSecondary = (W3Petard)theGame.CreateEntity( (CEntityTemplate)LoadResource( 
		thrownEntityPath
		, true ), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );

		theSound.SoundEvent("gui_inventory_bombs_attach");
		theSound.SoundEvent("gui_inventory_other_attach");

		plantedBomb.Init(thePlayer);

		plantedBombSecondary.Init(thePlayer);

		if ( npc.GetBoneIndex('torso') != -1 )
		{
			npc.GetBoneWorldPositionAndRotationByIndex( npc.GetBoneIndex( 'torso' ), bonePosition, boneRotation );

			plantedBomb.CreateAttachmentAtBoneWS(npc, 'torso', bonePosition, boneRotation);

			plantedBombSecondary.CreateAttachmentAtBoneWS(npc, 'torso', bonePosition, boneRotation);
		}
		else
		{
			if ( npc.GetBoneIndex('k_torso_g') != -1 )
			{
				npc.GetBoneWorldPositionAndRotationByIndex( npc.GetBoneIndex( 'k_torso_g' ), bonePosition, boneRotation );

				plantedBomb.CreateAttachmentAtBoneWS(npc, 'k_torso_g', bonePosition, boneRotation);

				plantedBombSecondary.CreateAttachmentAtBoneWS(npc, 'k_torso_g', bonePosition, boneRotation);
			}
			else
			{
				plantedBomb.CreateAttachment(npc, 'blood_point', Vector(0,0,0), npc.GetWorldRotation());

				plantedBombSecondary.CreateAttachment(npc, 'blood_point', Vector(0,0,0), npc.GetWorldRotation());
			}
		}

		plantedBomb.RemoveTimer('ACS_DetonationTimer');
		plantedBomb.AddTimer('ACS_DetonationTimer', detonationTimer , false );

		plantedBombSecondary.RemoveTimer('DetonationTimer');
		plantedBombSecondary.AddTimer('DetonationTimer', detonationTimer , false );

		plantedBomb.PlayEffect('fx_trail');
		plantedBomb.PlayEffect('sparks');

		plantedBombSecondary.PlayEffect('fx_trail');
		plantedBombSecondary.PlayEffect('sparks');

		plantedBomb.PlayEffect('tell');

		npc.AddTag('ACS_Bomb_Planted');
	}

	/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	function CustomFinishersBindTrigger(bind: ACS_CustomFinisherBind): bool 
	{
		return bind == ACS_CustomFinisherBind_None && theInput.GetActionValue('GI_AxisLeftY') == 0 && theInput.GetActionValue('GI_AxisLeftX') == 0
		|| bind == ACS_CustomFinisherBind_Forward && theInput.GetActionValue('GI_AxisLeftY') > 0.1 && theInput.GetActionValue('GI_AxisLeftX') == 0
		|| bind == ACS_CustomFinisherBind_Backward && theInput.GetActionValue('GI_AxisLeftY') < -0.1 && theInput.GetActionValue('GI_AxisLeftX') == 0
		|| bind == ACS_CustomFinisherBind_Left && theInput.GetActionValue('GI_AxisLeftX') < -0.1 && theInput.GetActionValue('GI_AxisLeftY') == 0
		|| bind == ACS_CustomFinisherBind_Right && theInput.GetActionValue('GI_AxisLeftX') > 0.1 && theInput.GetActionValue('GI_AxisLeftY') == 0
		|| bind == ACS_CustomFinisherBind_ForwardLeft && theInput.GetActionValue('GI_AxisLeftY') > 0.1 && theInput.GetActionValue('GI_AxisLeftX') < -0.1
		|| bind == ACS_CustomFinisherBind_ForwardRight && theInput.GetActionValue('GI_AxisLeftY') > 0.1 && theInput.GetActionValue('GI_AxisLeftX') > 0.1
		|| bind == ACS_CustomFinisherBind_BackwardLeft && theInput.GetActionValue('GI_AxisLeftX') < -0.1 && theInput.GetActionValue('GI_AxisLeftY') < -0.1
		|| bind == ACS_CustomFinisherBind_BackwardRight && theInput.GetActionValue('GI_AxisLeftX') > 0.1 && theInput.GetActionValue('GI_AxisLeftY') < -0.1;
	}

	/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	function ParrySkillsBindTrigger(bind: ACS_ParrySkillsBind): bool 
	{
		return (bind == ACS_ParrySkillsBind_Forward && theInput.GetActionValue('GI_AxisLeftY') > 0.85 && theInput.GetActionValue('GI_AxisLeftX') == 0)
		|| (bind == ACS_ParrySkillsBind_Left && theInput.GetActionValue('GI_AxisLeftX') < -0.85 && theInput.GetActionValue('GI_AxisLeftY') == 0)
		|| (bind == ACS_ParrySkillsBind_Backward && theInput.GetActionValue('GI_AxisLeftY') < -0.85 && theInput.GetActionValue('GI_AxisLeftX') == 0)
		|| (bind == ACS_ParrySkillsBind_Right && theInput.GetActionValue('GI_AxisLeftX') > 0.85 && theInput.GetActionValue('GI_AxisLeftY') == 0)
		|| (bind == ACS_ParrySkillsBindForwardOrBackward && theInput.GetActionValue('GI_AxisLeftY') != 0 && theInput.GetActionValue('GI_AxisLeftX') == 0)
		|| (bind == ACS_ParrySkillsBind_LeftOrRight && theInput.GetActionValue('GI_AxisLeftX') != 0  && theInput.GetActionValue('GI_AxisLeftY') == 0)
		|| (bind == ACS_ParrySkillsBind_LightAttack && (theInput.GetActionValue('AttackLight') > 0.1f || theInput.GetActionValue('AttackWithAlternateLight') > 0.1f) && theInput.GetActionValue('GI_AxisLeftY') == 0 && theInput.GetActionValue('GI_AxisLeftX') == 0)
		|| (bind == ACS_ParrySkillsBind_HeavyAttack && (theInput.GetActionValue('AttackHeavy') > 0.1f || theInput.GetActionValue('AttackWithAlternateHeavy') > 0.1f) && theInput.GetActionValue('GI_AxisLeftY') == 0 && theInput.GetActionValue('GI_AxisLeftX') == 0);
	}

	function GuardAttack()
	{
		if ( thePlayer.IsActionAllowed(EIAB_Parry) )
		{
			if (
			!thePlayer.IsInHitAnim()
			&& !thePlayer.HasTag('ACS_IsPerformingFinisher')
			&& !thePlayer.HasTag('ACS_IsPerformingCombatDismember')
			&& !thePlayer.IsCrossbowHeld()
			&& ACS_BuffCheck()
			&& !thePlayer.HasTag('ACS_Bruxa_Bite_Process')
			)
			{
				if (ACS_New_Replacers_Female_Active())
				{
					return;
				}

				DeactivateThings();

				ACS_ThingsThatShouldBeRemoved();

				ACS_ExplorationDelayHack(true, 2);

				RemoveTimer('ParrySkillsDelayTimer');

				AddTimer('ParrySkillsDelayTimer', 0.06125 , false);

				if(thePlayer.HasTag('acs_axii_sword_equipped'))
				{
					RemoveTimer('ACS_Shield_Spawn_Delay');

					if (theInput.GetActionValue('GI_AxisLeftX') != 0
					|| theInput.GetActionValue('GI_AxisLeftY') != 0
					)
					{
						AddTimer('ACS_Shield_Spawn_Delay', 0.56125 , false);
					}
					else
					{
						AddTimer('ACS_Shield_Spawn_Delay', 0.11125 , false);
					}
				}

				DeactivateThings();
			}
		}
	}

	timer function ParrySkillsDelayTimer(dt : float, id : int)
	{
		PerformKick();

		ParrySkills();
	}

	function ParrySkills() : bool
	{
		if (!ACS_Settings_Main_Bool('acs_parry_skills_settings','acs_parry_skills_enabled', true))
		{
			return false;
		}

		if (ACS_New_Replacers_Female_Active())
		{
			return false;
		}

		if ( !thePlayer.HasTag('acs_in_wraith') )
		{
			if (ACS_GetWeaponMode() == 0)
			{
				if ( ACS_Settings_Main_Bool('acs_stamina_settings','acs_stamina_block_action', false) 
				&& StaminaCheck('default')
				)
				{							 
					RemoveTimer('SwordTauntSwitch'); 
					
					RemoveTimer('SwordTauntRunningSwitch');   
					
					if (thePlayer.HasTag('ACS_IsSwordWalking'))
					{
						thePlayer.RemoveTag('ACS_IsSwordWalking');
					} 
					
					if(thePlayer.IsInCombat())
					{
						if(thePlayer.GetCombatIdleStance() <= 0.f )
						{
							thePlayer.RaiseEvent('ACS_CombatTauntLeft');
						}
						else
						{
							thePlayer.RaiseEvent('ACS_CombatTauntRight');
						}
					} 
					
					thePlayer.SoundEvent("gui_no_stamina");

					return false;
				}
				else
				{
					if (ParrySkillsBindTrigger(ACS_GetParrySkillsBind('parry')))
					{	
						if ( !thePlayer.IsWeaponHeld( 'fist' ) && !thePlayer.HasTag('acs_vampire_claws_equipped') )
						{
							if ( thePlayer.GetEquippedSign() == ST_Igni )
							{
								if (ACS_Settings_Main_Int('acs_armiger_mode_settings','acs_armiger_igni_sign_weapon', 0) == 0)
								{
									Attack_Setup_03('IgniCounterActual');
								}
								else if (ACS_Settings_Main_Int('acs_armiger_mode_settings','acs_armiger_igni_sign_weapon', 0) == 1)
								{
									Attack_Setup_02('QuenCounterActual');
								}
								else if (ACS_Settings_Main_Int('acs_armiger_mode_settings','acs_armiger_igni_sign_weapon', 0) == 2)
								{
									Attack_Setup_03('AxiiCounterActual');
								}
								else if (ACS_Settings_Main_Int('acs_armiger_mode_settings','acs_armiger_igni_sign_weapon', 0) == 3)
								{
									Attack_Setup_02('AardCounterActual');
								}
								else if (ACS_Settings_Main_Int('acs_armiger_mode_settings','acs_armiger_igni_sign_weapon', 0) == 4)
								{
									Attack_Setup_01('YrdenCounterActual');
								}
							}
							else if ( thePlayer.GetEquippedSign() == ST_Axii )
							{
								if (ACS_Settings_Main_Int('acs_armiger_mode_settings','acs_armiger_axii_sign_weapon', 2) == 0)
								{
									Attack_Setup_03('IgniCounterActual');
								}
								else if (ACS_Settings_Main_Int('acs_armiger_mode_settings','acs_armiger_axii_sign_weapon', 2) == 1)
								{
									Attack_Setup_02('QuenCounterActual');
								}
								else if (ACS_Settings_Main_Int('acs_armiger_mode_settings','acs_armiger_axii_sign_weapon', 2) == 2)
								{
									Attack_Setup_03('AxiiCounterActual');
								}
								else if (ACS_Settings_Main_Int('acs_armiger_mode_settings','acs_armiger_axii_sign_weapon', 2) == 3)
								{
									Attack_Setup_02('AardCounterActual');
								}
								else if (ACS_Settings_Main_Int('acs_armiger_mode_settings','acs_armiger_axii_sign_weapon', 2) == 4)
								{
									Attack_Setup_01('YrdenCounterActual');
								}
							}
							else if ( thePlayer.GetEquippedSign() == ST_Aard )
							{
								if (ACS_Settings_Main_Int('acs_armiger_mode_settings','acs_armiger_aard_sign_weapon', 3) == 0)
								{
									Attack_Setup_03('IgniCounterActual');
								}
								else if (ACS_Settings_Main_Int('acs_armiger_mode_settings','acs_armiger_aard_sign_weapon', 3) == 1)
								{
									Attack_Setup_02('QuenCounterActual');
								}

	function ProcessFinisherCamera( finisherAnimName_1 : name, optional finisherAnimName_2 : name, optional forced : bool, optional slowmo_disabled : bool )
	{
		var cameraAnimName : name;

		if ((thePlayer.IsLastEnemyKilled() && ACS_Settings_Main_Int('acs_custom_finishers_settings','acs_custom_finisher_camera_options', 0) == 1) 
			|| ACS_Settings_Main_Int('acs_custom_finishers_settings','acs_custom_finisher_camera_options', 0) == 2
			|| thePlayer.HasTag('ACS_Ghost_Stance_Active')
			|| forced
			)
		{
			if (ACS_Settings_Main_Float('acs_custom_finishers_settings','acs_custom_finisher_slow_mo_scale', 0.33) > 0)
			{
				ACS_SlowMoAdjustable(ACS_Settings_Main_Float('acs_custom_finishers_settings','acs_custom_finisher_slow_mo_scale', 0.33), 1.5, slowmo_disabled);
			}
			
			if (finisherAnimName_2)
			{
				if(thePlayer.GetCombatIdleStance() <= 0.f )
				{
					cameraAnimName = ProcessFinisherCameraAnimName( finisherAnimName_1 );
				}
				else
				{
					cameraAnimName = ProcessFinisherCameraAnimName( finisherAnimName_2 );
				}
			}
			else
			{
				cameraAnimName = ProcessFinisherCameraAnimName( finisherAnimName_1 );
			}

			if (slowmo_disabled)
			{
				PlayCustomCamAnim( cameraAnimName, 0.1f, 1.f, 1.f, 2.5f, false, CAP_Highest );
			}
			else
			{
				PlayCustomCamAnim( cameraAnimName, 0.1f, 0.5f, 1.f, 1.5f, false, CAP_Highest );
			}
		}
		else if (ACS_Settings_Main_Int('acs_custom_finishers_settings','acs_custom_finisher_camera_options', 0) == 0)
		{

		}
	}

	var backhandSwordWield : bool;

	public function ACS_SetupSyncAnimInternalHumanCombatDismember( syncAction : name, master, slave : CEntity ) : bool
	{
		var masterDef, slaveDef													: SAnimationSequenceDefinition;
		var masterSequencePart, slaveSequencePart								: SAnimationSequencePartDefinition;
		var syncInstance														: CAnimationManualSlotSyncInstance;
		
		var instanceIndex														: int;
		var sequenceIndex														: int;
		
		var temp 																: name; 
		var tempF 																: float;
		var rot 																: EulerAngles;
		
		var finisherAnim 														: bool;
		var pos 																: Vector;
		
		var syncAnimName, cameraAnimName										: name;
		
		var node, node1 														: CNode; 
		var rot0, rot1, slaveRot 												: EulerAngles;
		
		var masterAnim, slaveAnim 												: name;
		var syncAnimIndex														: int;
		var currentAnimInstance													: CAnimationManualSlotSyncInstance;
		var actorMaster, actorSlave 											: CActor;

		var k 																	: int;
		var movementAdjustorFinisher, movementAdjustorFinisherActor				: CMovementAdjustor;
		var ticketFinisher, ticketFinisherActor 								: SMovementAdjustmentRequestTicket;
		var dist																: float;

		var animatedComponentFearActor 											: CAnimatedComponent;
		var animatedComponentB													: CAnimatedComponent;

		if ( ((CActor)slave).HasTag('ACS_Hit_Lag'))
		{
			animatedComponentB = (CAnimatedComponent)(((CActor)slave).GetComponentByClassName( 'CAnimatedComponent' ));

			animatedComponentB.UnfreezePose();

			animatedComponentB.UnfreezePoseFadeOut(0.1);

			((CActor)slave).RemoveTag('ACS_Hit_Lag');
		}

		if (syncAction == 'combat_dismember_legs_rp'
		|| syncAction == 'combat_dismember_legs_lp'
		)
		{
			movementAdjustorFinisherActor = ((CActor)slave).GetMovingAgentComponent().GetMovementAdjustor();

			movementAdjustorFinisherActor.CancelAll();
			
			ticketFinisherActor = movementAdjustorFinisherActor.CreateNewRequest( 'ACS_Finisher_Rotate' );
				
			movementAdjustorFinisherActor.AdjustmentDuration( ticketFinisherActor, 0.25 );

			movementAdjustorFinisherActor.ShouldStartAt(ticketFinisherActor, slave.GetWorldPosition());
			movementAdjustorFinisherActor.MaxRotationAdjustmentSpeed( ticketFinisherActor, 5000000 );
			movementAdjustorFinisherActor.MaxLocationAdjustmentSpeed( ticketFinisherActor, 5000000 );

			movementAdjustorFinisherActor.RotateTowards( ticketFinisherActor, GetWitcherPlayer() );

			movementAdjustorFinisherActor.SlideTo(ticketFinisherActor, TraceFloor(slave.GetWorldPosition()));
		}
		
		
		
		syncInstance = theGame.GetSyncAnimManager().CreateNewSyncInstance( instanceIndex );
		syncAnimIndex = instanceIndex;
		currentAnimInstance = syncInstance;

		RemoveTimer('SwordTauntSwitch'); 
		RemoveTimer('SwordTauntRunningSwitch'); 
		 
		RemoveTimer('CombatTauntDelay');
		RemoveTimer('SwordTauntRunningSwitchSecondary'); 
		RemoveTimer('SwordTauntRunningSwitchSecondaryWeaponBlood'); 

		thePlayer.RaiseEvent('ACS_SwordTauntEnd');
		thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');

		if(ACSGetCEntity('ACS_Viper_Dagger_L'))
		{
			thePlayer.RaiseEvent('ACS_LHandAttack01');
		}

		backhandSwordWield = false;

		thePlayer.AddTag('ACS_Sword_Hit_Blood_Trigger');

		thePlayer.AddTag('ACS_IsPerformingCombatDismember');
		
		thePlayer.RaiseEvent('ACS_ForceHandClosedREnd');

		slave.AddTag('ACS_DisableDismemberment');

		((CActor)slave).SetCanPlayHitAnim(true);

		((CNewNPC)slave).SetUnstoppable(false);

		((CActor)slave).GetRootAnimatedComponent().PlaySlotAnimationAsync( '', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0, 0) );

		action_interrupt();

		thePlayer.BlockAllActions( 'ACS_Combat_Dismember_Action_Block', true );

		thePlayer.SetGuarded(false);
		thePlayer.OnGuardedReleased();

		ACS_Axii_Shield_Destroy_IMMEDIATE();

		thePlayer.SetImmortalityMode( AIM_Invulnerable, AIC_Default, true ); 
		thePlayer.SetCanPlayHitAnim(false); 
		//thePlayer.EnableCharacterCollisions(false); 
		thePlayer.AddBuffImmunity_AllNegative('ACS_Finisher_Immune_Negative', true); 
		thePlayer.AddBuffImmunity_AllCritical('ACS_Finisher_Immune_Critical', true); 

		//ChangeInteractionPriority();
		
		FreezeMoveTargets(6);
		
		if (thePlayer.HasTag('ACS_IsSwordWalking'))
		{
			thePlayer.RemoveTag('ACS_IsSwordWalking');
		}

		RemoveTimer('SwordTauntSwitch'); 
		RemoveTimer('SwordTauntRunningSwitch'); 
		 
		 
		if (thePlayer.IsInAir()
		|| thePlayer.IsFalling()
		)
		{
			//thePlayer.RaiseEvent('ACS_ForceLegsFloatIdle');
		}
		else
		{
			if (thePlayer.HasTag('ACS_IsSwordWalking'))
			{
				thePlayer.RaiseEvent('ACS_SwordWalkAdditiveEnd');thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');RemoveTimer('CombatTauntDelay');thePlayer.RaiseEvent('ACS_SwordTauntEnd');

				thePlayer.RemoveTag('ACS_IsSwordWalking');
			}
		}

		//animatedComponentFearActor = (CAnimatedComponent)((CActor)slave).GetComponentByClassName( 'CAnimatedComponent' );	
	
		//animatedComponentFearActor.PlaySlotAnimationAsync( '', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0, 0));

		if (thePlayer.IsWeaponHeld('steelsword'))
		{
			if ( ACS_GetItem_Sword_IsEquipped('olgierd_steel', 'steel') )
			{
				if (!GetWitcherPlayer().HasTag('ACS_Camo_Active')
				&& ACS_Settings_Main_Bool('acs_dodge_settings','acs_dodge_effects', false))
				{
					GetWitcherPlayer().PlayEffectSingle('special_attack_fx');
					GetWitcherPlayer().StopEffect('special_attack_fx');
				}
			}
		}
		else if (thePlayer.IsWeaponHeld('silversword'))
		{
			if ( ACS_GetItem_Sword_IsEquipped('olgierd_silver', 'silver') )
			{
				if (!GetWitcherPlayer().HasTag('ACS_Camo_Active')
				&& ACS_Settings_Main_Bool('acs_dodge_settings','acs_dodge_effects', false))
				{
					GetWitcherPlayer().PlayEffectSingle('special_attack_fx');
					GetWitcherPlayer().StopEffect('special_attack_fx');
				}
			}
		}

		switch( syncAction )
		{
			case 'combat_dismember_legs_rp':
			{
				AddTimer('ACS_Combat_Dismember_Unblock_Action', 2 , false);

				masterSequencePart.animation			= 'man_finisher_dlc_legs_rp';
				masterSequencePart.syncType				= AMST_SyncBeginning;
				masterSequencePart.useRefBone			= 'Reference';
				masterSequencePart.rotationTypeUsingRefBone = SRT_TowardsOtherEntity;
				masterSequencePart.shouldSlide			= true;
				masterSequencePart.shouldRotate			= true;
				
				masterSequencePart.blendInTime			= 0.5f;
				masterSequencePart.blendOutTime			= 0.25f;

				ProcessFinisherCamera( 'man_finisher_dlc_legs_rp' );

				if (ACS_Settings_Main_Float('acs_custom_finishers_settings','acs_active_counter_combat_dismemberment_slow_mo_scale', 0.33) > 0)
				{
					ACS_SlowMoAdjustable(ACS_Settings_Main_Float('acs_custom_finishers_settings','acs_active_counter_combat_dismemberment_slow_mo_scale', 0.33), 1.5);

					cameraAnimName = ProcessFinisherCameraAnimName( 'man_finisher_dlc_legs_rp' );

					PlayCustomCamAnim( cameraAnimName, 0.15f, 0.15f, 1.f, 1.0f, false, CAP_Highest );
				}

				slave.AddTag('ACS_man_finisher_dlc_legs_rp_combat_dismember');
				slaveSequencePart.animation				= 'man_finisher_dlc_legs_rp';	
				slaveSequencePart.syncType				= AMST_SyncBeginning;
				slaveSequencePart.useRefBone			= 'Reference';	
				slaveSequencePart.rotationTypeUsingRefBone = SRT_ToMatchOthersRotation;
				slaveSequencePart.shouldRotate			= true;
				slaveSequencePart.shouldSlide			= false;
				slaveSequencePart.finalHeading			= thePlayer.GetHeading();
				
				slaveSequencePart.blendInTime			= 0.5f;
				slaveSequencePart.blendOutTime			= 0.125f;
			
				break;		
			}

			case 'combat_dismember_legs_lp':
			{
				AddTimer('ACS_Combat_Dismember_Unblock_Action', 1 , false);

				masterSequencePart.animation			= 'man_finisher_dlc_legs_lp';
				masterSequencePart.syncType				= AMST_SyncBeginning;
				masterSequencePart.useRefBone			= 'Reference';
				masterSequencePart.rotationTypeUsingRefBone = SRT_TowardsOtherEntity;
				masterSequencePart.shouldSlide			= true;
				masterSequencePart.shouldRotate			= true;
				
				masterSequencePart.blendInTime			= 0.5f;
				masterSequencePart.blendOutTime			= 1.0f;
				
				if (ACS_Settings_Main_Float('acs_custom_finishers_settings','acs_dismember_slow_mo_scale', 0.33) > 0)
				{
					ACS_SlowMoAdjustable(ACS_Settings_Main_Float('acs_custom_finishers_settings','acs_dismember_slow_mo_scale', 0.33), 1.5);

					cameraAnimName = ProcessFinisherCameraAnimName( 'man_finisher_dlc_legs_lp' );

					PlayCustomCamAnim( cameraAnimName, 0.15f, 0.15f, 1.f, 1.0f, false, CAP_Highest );
				}

				slave.AddTag('ACS_man_finisher_dlc_legs_lp_combat_dismember');
				slaveSequencePart.animation				= 'man_finisher_dlc_legs_lp';	
				slaveSequencePart.syncType				= AMST_SyncBeginning;
				slaveSequencePart.useRefBone			= 'Reference';	
				slaveSequencePart.rotationTypeUsingRefBone = SRT_ToMatchOthersRotation;
				slaveSequencePart.shouldRotate			= true;
				slaveSequencePart.shouldSlide			= false;
				slaveSequencePart.finalHeading			= thePlayer.GetHeading();
				
				slaveSequencePart.blendInTime			= 0.5f;
				slaveSequencePart.blendOutTime			= 0.125f;

				break;		
			}

			case 'combat_dismember_arm_rp':
			{
				AddTimer('ACS_Combat_Dismember_Unblock_Action', 2 , false);

				masterSequencePart.animation			= 'man_finisher_dlc_arm_rp';
				masterSequencePart.syncType				= AMST_SyncBeginning;
				masterSequencePart.useRefBone			= 'Reference';
				masterSequencePart.rotationTypeUsingRefBone = SRT_TowardsOtherEntity;
				masterSequencePart.shouldSlide			= true;
				masterSequencePart.shouldRotate			= true;
				
				masterSequencePart.blendInTime			= 0.5f;
				masterSequencePart.blendOutTime			= 0.85f;

				if (ACS_Settings_Main_Float('acs_custom_finishers_settings','acs_dismember_slow_mo_scale', 0.33) > 0)
				{
					ACS_SlowMoAdjustable(ACS_Settings_Main_Float('acs_custom_finishers_settings','acs_dismember_slow_mo_scale', 0.33), 1.5);

					cameraAnimName = ProcessFinisherCameraAnimName( 'man_finisher_dlc_arm_rp' );

					PlayCustomCamAnim( cameraAnimName, 0.15f, 0.15f, 1.f, 1.0f, false, CAP_Highest );
				}

				slave.AddTag('ACS_man_finisher_dlc_arm_rp_combat_dismember');
				slaveSequencePart.animation				= 'man_finisher_dlc_arm_rp';	
				slaveSequencePart.syncType				= AMST_SyncBeginning;
				slaveSequencePart.useRefBone			= 'Reference';	
				slaveSequencePart.rotationTypeUsingRefBone = SRT_ToMatchOthersRotation;
				slaveSequencePart.shouldRotate			= true;
				slaveSequencePart.shouldSlide			= false;
				slaveSequencePart.finalHeading			= thePlayer.GetHeading();
				
				slaveSequencePart.blendInTime			= 0.25f;
				slaveSequencePart.blendOutTime			= 0.125f;

				break;		
			}

			case 'combat_dismember_arm_lp':
			{
				AddTimer('ACS_Combat_Dismember_Unblock_Action', 2 , false);

				((CActor)slave).DrainStamina( ESAT_FixedValue, ((CActor)slave).GetStatMax( BCS_Stamina ) * 0.9, 999 );

				masterSequencePart.animation			= 'man_finisher_dlc_arm_lp';
				masterSequencePart.syncType				= AMST_SyncBeginning;
				masterSequencePart.useRefBone			= 'Reference';
				masterSequencePart.rotationTypeUsingRefBone = SRT_TowardsOtherEntity;
				masterSequencePart.shouldSlide			= true;
				masterSequencePart.shouldRotate			= true;
				
				masterSequencePart.blendInTime			= 0.5f;
				masterSequencePart.blendOutTime			= 0.85f;

				if (ACS_Settings_Main_Float('acs_custom_finishers_settings','acs_dismember_slow_mo_scale', 0.33) > 0)
				{
					ACS_SlowMoAdjustable(ACS_Settings_Main_Float('acs_custom_finishers_settings','acs_dismember_slow_mo_scale', 0.33), 1.5);

					cameraAnimName = ProcessFinisherCameraAnimName( 'man_finisher_dlc_arm_lp' );

					PlayCustomCamAnim( cameraAnimName, 0.15f, 0.15f, 1.f, 1.0f, false, CAP_Highest );
				}

				slave.AddTag('ACS_man_finisher_dlc_arm_lp_combat_dismember');
				slaveSequencePart.animation				= 'man_finisher_dlc_arm_lp';	
				slaveSequencePart.syncType				= AMST_SyncBeginning;
				slaveSequencePart.useRefBone			= 'Reference';	
				slaveSequencePart.rotationTypeUsingRefBone = SRT_ToMatchOthersRotation;
				slaveSequencePart.shouldRotate			= true;
				slaveSequencePart.shouldSlide			= false;
				slaveSequencePart.finalHeading			= thePlayer.GetHeading();
				
				slaveSequencePart.blendInTime			= 0.25f;
				slaveSequencePart.blendOutTime			= 0.125f;

				break;		
			}

			default : 
			{
				//movementAdjustorFinisher.RotateTowards( ticketFinisher, slave );

				AddTimer('ACS_Combat_Dismember_Unblock_Action', 0.125 , false);
				return false;
			}
		}

		masterDef.parts.PushBack( masterSequencePart );
		masterDef.entity						= master;
		masterSequencePart.sequenceIndex		= 0;
		masterDef.manualSlotName			= 'GAMEPLAY_SLOT';
		masterDef.freezeAtEnd					= false;

		slaveSequencePart.sequenceIndex			= 0;
		slaveSequencePart.disableProxyCollisions = true;
		slave.SetKinematic( true );
		slaveDef.parts.PushBack( slaveSequencePart );
		slaveDef.entity							= slave;
		slaveDef.manualSlotName					= 'GAMEPLAY_SLOT';
		slaveDef.freezeAtEnd					= false;

		finisherAnim 							= false;
		
		sequenceIndex = syncInstance.RegisterMaster( masterDef );
		
		
		actorMaster = (CActor)master;
		actorSlave = (CActor)slave;
		
		if(actorMaster)
		{
			actorMaster.SignalGameplayEventParamInt( 'SetupSyncInstance', instanceIndex );
			actorMaster.SignalGameplayEventParamInt( 'SetupSequenceIndex', sequenceIndex );
			if ( finisherAnim )
				actorMaster.SignalGameplayEvent( 'PlayFinisherSyncedAnim' );
			else
				actorMaster.SignalGameplayEvent( 'PlaySyncedAnim' );
			
		}
		
		sequenceIndex = syncInstance.RegisterSlave( slaveDef );
		if( sequenceIndex == -1 ) 
		{
			return false;
		}
		
		if(actorSlave)
		{
			if( syncAction == 'Throat' )
				actorSlave.SignalGameplayEventParamCName( 'SetupEndEvent', 'CriticalState' );
				
			actorSlave.SignalGameplayEventParamInt( 'SetupSyncInstance', instanceIndex );
			actorSlave.SignalGameplayEventParamInt( 'SetupSequenceIndex', sequenceIndex );
			if ( finisherAnim )
				actorSlave.SignalGameplayEvent( 'PlayFinisherSyncedAnim' );
			else
				actorSlave.SignalGameplayEvent( 'PlaySyncedAnim' );
		}
		
		return true;
	}

	var vACS_Finisher_Chain : cACS_Finisher_Chain;

	function InitiateFinisherChain( unarmed : bool )
	{
		vACS_Finisher_Chain = new cACS_Finisher_Chain in this;

		RemoveTimer('SwordTauntSwitch'); 
		RemoveTimer('SwordTauntRunningSwitch'); 
		
		RemoveTimer('CombatTauntDelay');
		RemoveTimer('SwordTauntRunningSwitchSecondary'); 
		RemoveTimer('SwordTauntRunningSwitchSecondaryWeaponBlood'); 

		if (backhandSwordWield)
		{
			thePlayer.RaiseEvent('ACS_ForceHandClosedREnd');

			backhandSwordWield = false;
		}

		if (!thePlayer.IsAnyWeaponHeld()
		|| thePlayer.IsWeaponHeld('fist')
		)
		{
			//thePlayer.RaiseEvent('ACS_IdleAdditiveHeavyMeleeCheck');

			thePlayer.RaiseEvent('ACS_SwordTaunt10');

			ACSGetCEntityDestroyAll('acs_finisher_dagger');

			vACS_Dagger_Summon = new cACS_Dagger_Summon in this;
				
			vACS_Dagger_Summon.ACS_Finisher_Dagger_Summon_Engage();
		}

		thePlayer.RaiseEvent('ACS_SwordTauntEnd');
		thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');

		thePlayer.AddTag('ACS_Sword_Hit_Blood_Trigger');

		action_interrupt();

		if (unarmed)
		{
			vACS_Finisher_Chain.Unarmed_Finisher_Engage();

			PlayerCommentEnd();
		}
		else
		{
			vACS_Finisher_Chain.Armed_Finisher_Engage();
		}
	}

	function FreezeMoveTargets(blendout : float)
	{
		var j									: int;
		var animatedComponentFearActor			: CAnimatedComponent;
		var fear_actor							: CActor;
		var l_aiTree							: CAIPlayAnimationSlotAction;

		moveTargets.Clear();
		moveTargets = thePlayer.GetMoveTargets();
				
		for( j = 0; j < moveTargets.Size(); j += 1 )
		{
			fear_actor = ((CActor)(moveTargets[j]));

			animatedComponentFearActor = (CAnimatedComponent)fear_actor.GetComponentByClassName( 'CAnimatedComponent' );

			if ( fear_actor 
			&& !fear_actor.HasTag('ACS_Final_Fear_Stack')
			&& fear_actor.IsAlive()
			)
			{
				fear_actor.SignalGameplayEvent( 'InterruptChargeAttack' );

				animatedComponentFearActor.FreezePose();

				animatedComponentFearActor.UnfreezePose();

				animatedComponentFearActor.UnfreezePoseFadeOut(blendout);
			}	
		}
	}

	function PerformUnarmedFinisherCheck( npc : CNewNPC ) : bool
	{
		var voiceTagName 													: name;
		var voiceTagStr														: string;
		var finisher_anim_names												: array< name >;

		if(!ACS_Settings_Main_Bool('acs_custom_finishers_settings','acs_unarmed_finishers_enabled', true))
		{
			return false;
		}

		voiceTagName =  npc.GetVoicetag();

		voiceTagStr = NameToString( voiceTagName );

		if (npc.IsHuman()
		&& npc.IsMan()
		&& !npc.UsesEssence()
		&& ((CNewNPC)npc).GetNPCType() != ENGT_Quest
		&& !npc.HasTag( 'ethereal' )
		&& !npc.HasAbility( 'Boss' )
		&& !npc.HasTag( 'IsBoss' )
		&& !npc.HasTag( 'ACS_Berserkers_Human' )
		&& !npc.HasTag( 'ACS_Shades_Hunter' )
		&& !npc.HasTag( 'ACS_Shades_Crusader' )
		&& !npc.IsUsingHorse()
		&& !npc.IsUsingVehicle()
		&& !npc.HasTag('ACS_In_Rage')
		&& !npc.HasTag('ACS_Currently_In_Grapple_Anim')
		&& !npc.HasTag('ACS_Currently_In_Beh_Switch_Anim')
		&& !npc.HasTag('ACS_Pre_Rage')
		&& !npc.HasTag('ACS_Final_Fear_Stack')
		&& !((CNewNPC)npc).IsInFinisherAnim()
		&& !((CNewNPC)npc).IsRagdolled()
		&& ACS_Rage_Process == false
		&& npc.GetBehaviorGraphInstanceName() != 'Shield'
		&& !npc.HasTag('mq1060_witcher')
		&& StrFindFirst(voiceTagStr, "REINALD") < 0
		&& !thePlayer.HasTag('acs_vampire_claws_equipped')
		&& !thePlayer.IsInFistFightMiniGame()
		)
		{
			if ( !thePlayer.inv.IsThereItemOnSlot( EES_SteelSword )
			&& !thePlayer.inv.IsThereItemOnSlot( EES_SilverSword )
			)
			{
				return true;
			}

			if (StrContains( npc.I_GetDisplayName(), "Bandit" ) 
			|| StrContains( npc.I_GetDisplayName(), "Cannibal" )
			|| StrContains( npc.I_GetDisplayName(), "Thug" )

			|| StrContains( npc.I_GetDisplayName(), "Cannibale" )
			|| StrContains( npc.I_GetDisplayName(), "Voyou" )

			|| StrContains( npc.I_GetDisplayName(), "Bandito" ) 
			|| StrContains( npc.I_GetDisplayName(), "Delinquente" )

			|| StrContains( npc.I_GetDisplayName(), "Kannibale" )
			|| StrContains( npc.I_GetDisplayName(), "Schurke" )

			|| StrContains( npc.I_GetDisplayName(), "Bandido" ) 
			|| StrContains( npc.I_GetDisplayName(), "Caníbal" )
			|| StrContains( npc.I_GetDisplayName(), "Matón" )

			|| StrContains( npc.I_GetDisplayName(), "قاطع طريق" ) 
			|| StrContains( npc.I_GetDisplayName(), "آكلي لحوم البشر" )
			|| StrContains( npc.I_GetDisplayName(), "سفاح" )

			|| StrContains( npc.I_GetDisplayName(), "Bandita" ) 
			|| StrContains( npc.I_GetDisplayName(), "Kanibal" )

			|| StrContains( npc.I_GetDisplayName(), "Kannibál" )
			|| StrContains( npc.I_GetDisplayName(), "Orgyilkos" )

			|| StrContains( npc.I_GetDisplayName(), "山賊" ) 
			|| StrContains( npc.I_GetDisplayName(), "人食い人種" )
			|| StrContains( npc.I_GetDisplayName(), "ちんぴら" )

			|| StrContains( npc.I_GetDisplayName(), "적기" ) 
			|| StrContains( npc.I_GetDisplayName(), "식인종" )
			|| StrContains( npc.I_GetDisplayName(), "자객" )

			|| StrContains( npc.I_GetDisplayName(), "Bandyta" )

			|| StrContains( npc.I_GetDisplayName(), "Canibal" )

			|| StrContains( npc.I_GetDisplayName(), "Бандит" ) 
			|| StrContains( npc.I_GetDisplayName(), "Каннибал" )
			|| StrContains( npc.I_GetDisplayName(), "бандит" )

			|| StrContains( npc.I_GetDisplayName(), "土匪" ) 
			|| StrContains( npc.I_GetDisplayName(), "食人族" )
			|| StrContains( npc.I_GetDisplayName(), "暴徒" )
			|| StrContains( npc.GetReadableName(), "bandit" ) 
			|| StrContains( npc.GetReadableName(), "cannibal" ) )
			{
				return true;
			}
		}

		return false;
	}

	var grapple_target : CNewNPC;

	function AllowGrapple( npc : CActor ) : bool
	{
		if (npc.IsHuman()
		&& npc.IsMan())
		{
			return true;
		}

		if(
		(npc.GetSfxTag() == 'sfx_drowner'
		|| npc.HasAbility('mon_rotfiend')
		|| npc.HasAbility('mon_rotfiend_large')
		|| npc.HasAbility('mon_gravier')

		|| npc.GetSfxTag() == 'sfx_nekker'

		|| npc.HasAbility('mon_ghoul')

		|| npc.GetSfxTag() == 'sfx_fogling'
		|| npc.GetSfxTag() == 'sfx_gravehag'
		|| npc.GetSfxTag() == 'sfx_waterhag'

		|| npc.HasAbility('mon_erynia')
		|| npc.GetSfxTag() == 'sfx_harpy'

		|| npc.GetSfxTag() == 'sfx_siren'

		|| npc.HasAbility('mon_boar_base')

		|| npc.GetSfxTag() == 'sfx_wild_dog'
		|| npc.GetSfxTag() == 'sfx_wolf'

		|| npc.HasAbility('mon_panther_base')

		|| npc.HasAbility('mon_bruxa')
		) 
		&& (W3Potion_Thunderbolt)GetWitcherPlayer().GetBuff(EET_Thunderbolt)
		&& !npc.HasTag('ACS_Custom_Monster')
		)
		{
			return true;
		}

		return false;
	}

	public function ACS_SetupSyncAnimInternalGrapple( master, slave : CEntity ) : bool
	{
		var masterDef, slaveDef													: SAnimationSequenceDefinition;
		var masterSequencePart, slaveSequencePart								: SAnimationSequencePartDefinition;
		var syncInstance														: CAnimationManualSlotSyncInstance;
		
		var instanceIndex														: int;
		var sequenceIndex														: int;
		
		var temp 																: name; 
		var tempF 																: float;
		var rot 																: EulerAngles;
		
		var finisherAnim 														: bool;
		var pos 																: Vector;
		
		var syncAnimName, cameraAnimName										: name;
		
		var node, node1 														: CNode; 
		var rot0, rot1, slaveRot 												: EulerAngles;
		
		var masterAnim, slaveAnim 												: name;
		var syncAnimIndex														: int;
		var currentAnimInstance													: CAnimationManualSlotSyncInstance;
		var actorMaster, actorSlave 											: CActor;

		var fear_actors															: array<CActor>;
		var j, k 																: int;
		var fear_actor															: CActor;
		var animatedComponentFearActor											: CAnimatedComponent;
		var movementAdjustorFinisher, movementAdjustorFinisherActor				: CMovementAdjustor;
		var ticketFinisher, ticketFinisherActor 								: SMovementAdjustmentRequestTicket;
		var dist																: float;
		var animatedComponentB													: CAnimatedComponent;

		var dismembermentComp 													: CDismembermentComponent;
		var wounds																: array< name >;
		var usedWound															: name;
		var i 																	: int;
		var params 																: SCustomEffectParams;

		var dummycomp															: CEntity;
	

		GetWitcherPlayer().DrainStamina( ESAT_FixedValue, GetWitcherPlayer().GetStatMax( BCS_Stamina ) * 0.33f , 3 );

		RemoveTimer('AardLightIcon');
		AddTimer('AardLightIcon', 0.33  , false);

		thePlayer.SoundEvent("scene_cmb_fist_hit");

		grapple_target = ((CNewNPC)slave);

		if ( ((CActor)slave).HasTag('ACS_Hit_Lag'))
		{
			animatedComponentB = (CAnimatedComponent)(((CActor)slave).GetComponentByClassName( 'CAnimatedComponent' ));

			animatedComponentB.UnfreezePose();

			//animatedComponentB.UnfreezePoseFadeOut(0.1);

			((CActor)slave).RemoveTag('ACS_Hit_Lag');
		}

		action_interrupt();

		if (((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'wood_hollow'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'wood_debris'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'dirt_hard'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'dirt_soil'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'hay'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'stone_debris'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'stone_solid'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'clay_tile'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'gravel_large'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'gravel_small'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'sand'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'water_shallow'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'water_deep'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'grass_short'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'grass_long'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'carpet'
		)
		{

			thePlayer.StopEffect('jump_ground_fx1');
			thePlayer.PlayEffect('jump_ground_fx1');

			if (((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'dirt_hard'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'dirt_soil'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'hay'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'stone_debris'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'clay_tile'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'gravel_large'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'gravel_small'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'sand'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'grass_short'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'grass_long'
			)
			{
				//thePlayer.StopEffect('covered_dirt_ACS');
				//thePlayer.PlayEffect('covered_dirt_ACS');

				if( GetRainStrength() > 0 
				&& !thePlayer.IsInInterior()
				&& !RoofCheck()
				) 
				{

				}
				else if (ACS_Settings_Main_Bool('acs_player_misc_settings','acs_dirt_vfx_enabled', true))
				{
					thePlayer.StopEffect('covered_dirt_big_ACS');
					thePlayer.PlayEffect('covered_dirt_big_ACS');

					thePlayer.StopEffect('covered_dirt_small_ACS');
					thePlayer.PlayEffect('covered_dirt_small_ACS');
				}
			}
		}

		thePlayer.AddTag('ACS_IsPerformingFinisher');

		syncInstance = theGame.GetSyncAnimManager().CreateNewSyncInstance( instanceIndex );
		syncAnimIndex = instanceIndex;
		currentAnimInstance = syncInstance;

		if (((CActor)slave).GetInteractionPriority() != IP_Max_Unpushable )
		{
			((CActor)slave).SetInteractionPriority( IP_Max_Unpushable );
		}

		theInput.IgnoreGameInput( 'GI_AxisLeftX', true );
		theInput.IgnoreGameInput( 'GI_AxisLeftY', true );


		dist = (((CMovingPhysicalAgentComponent)((CActor)slave).GetMovingAgentComponent()).GetCapsuleRadius() 
		+ ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent()).GetCapsuleRadius()) * 0.5;

		movementAdjustorFinisher = GetWitcherPlayer().GetMovingAgentComponent().GetMovementAdjustor();

		movementAdjustorFinisher.CancelAll();
		
		ticketFinisher = movementAdjustorFinisher.CreateNewRequest( 'ACS_Finisher_Rotate' );
			
		movementAdjustorFinisher.AdjustmentDuration( ticketFinisher, 0.1 );

		movementAdjustorFinisher.ShouldStartAt(ticketFinisher, GetWitcherPlayer().GetWorldPosition());
		movementAdjustorFinisher.MaxRotationAdjustmentSpeed( ticketFinisher, 5000000 );
		movementAdjustorFinisher.MaxLocationAdjustmentSpeed( ticketFinisher, 5000000 );
		//movementAdjustorFinisher.Continuous(ticketFinisher);
		
		//movementAdjustorFinisher.SlideTowards( ticketFinisher, slave, dist, dist );

		//movementAdjustorFinisher.RotateTowards( ticketFinisher, slave );


		movementAdjustorFinisherActor = ((CActor)slave).GetMovingAgentComponent().GetMovementAdjustor();

		movementAdjustorFinisherActor.CancelAll();
		
		ticketFinisherActor = movementAdjustorFinisherActor.CreateNewRequest( 'ACS_Finisher_Rotate' );
			
		movementAdjustorFinisherActor.AdjustmentDuration( ticketFinisherActor, 0.1 );

		movementAdjustorFinisherActor.ShouldStartAt(ticketFinisherActor, slave.GetWorldPosition());
		movementAdjustorFinisherActor.MaxRotationAdjustmentSpeed( ticketFinisherActor, 5000000 );
		movementAdjustorFinisherActor.MaxLocationAdjustmentSpeed( ticketFinisherActor, 5000000 );

		movementAdjustorFinisherActor.RotateTowards( ticketFinisherActor, GetWitcherPlayer(), RandRangeF(225,135) );

		//movementAdjustorFinisher.SlideTo( ticketFinisherActor, thePlayer.GetWorldPosition() + thePlayer.GetWorldForward() * -4 );

		thePlayer.BlockAllActions( 'ACS_Finisher_Action_Block', true );

		thePlayer.SetGuarded(false);
		thePlayer.OnGuardedReleased();

		ACS_Axii_Shield_Destroy_IMMEDIATE();

		//weapon_blood_fx('red');

		thePlayer.SetImmortalityMode( AIM_Invulnerable, AIC_Default, true ); 
		thePlayer.SetCanPlayHitAnim(false); 
		//thePlayer.EnableCharacterCollisions(false); 
		thePlayer.AddBuffImmunity_AllNegative('ACS_Finisher_Immune_Negative', true); 
		thePlayer.AddBuffImmunity_AllCritical('ACS_Finisher_Immune_Critical', true); 

		//ChangeInteractionPriority();
		
		RemoveTimer('ACS_Finisher_Unblock_Action');

		RemoveTimer('ACS_Finisher_Unblock_Camera');

		FreezeMoveTargets(0.1);

		if (thePlayer.HasTag('ACS_IsSwordWalking'))
		{
			thePlayer.RemoveTag('ACS_IsSwordWalking');
		}

		RemoveTimer('SwordTauntSwitch'); 
		RemoveTimer('SwordTauntRunningSwitch'); 
		 
		if (thePlayer.IsInAir()
		|| thePlayer.IsFalling()
		)
		{
			//thePlayer.RaiseEvent('ACS_ForceLegsFloatIdle');
		}
		else
		{
			if (thePlayer.HasTag('ACS_IsSwordWalking'))
			{
				thePlayer.RaiseEvent('ACS_SwordWalkAdditiveEnd');thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');RemoveTimer('CombatTauntDelay');thePlayer.RaiseEvent('ACS_SwordTauntEnd');

				thePlayer.RemoveTag('ACS_IsSwordWalking');
			}
		}

		((CActor)slave).SetCanPlayHitAnim(true);

		((CNewNPC)slave).SetUnstoppable(false);

		rot = thePlayer.GetWorldRotation();
		rot.Yaw -= RandRangeF(225,135);

		slave.TeleportWithRotation(thePlayer.GetWorldPosition() + thePlayer.GetWorldForward() * 0.125f, rot);

		RemoveTimer('SwordTauntSwitch'); 
		RemoveTimer('SwordTauntRunningSwitch'); 
		 
		RemoveTimer('CombatTauntDelay');
		RemoveTimer('SwordTauntRunningSwitchSecondary'); 
		RemoveTimer('SwordTauntRunningSwitchSecondaryWeaponBlood'); 

		thePlayer.RaiseEvent('ACS_SwordTauntEnd');
		thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');

		if(ACSGetCEntity('ACS_Viper_Dagger_L'))
		{
			thePlayer.RaiseEvent('ACS_LHandAttack01');
		}

		if (backhandSwordWield)
		{
			backhandSwordWield = false;
		}

		//thePlayer.AddTag('ACS_Sword_Hit_Blood_Trigger');
		
		thePlayer.RaiseEvent('ACS_ForceHandClosedREnd');

		//animatedComponentFearActor = (CAnimatedComponent)((CActor)slave).GetComponentByClassName( 'CAnimatedComponent' );	
	
		//animatedComponentFearActor.PlaySlotAnimationAsync( '', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0, 0));

		pos = ACSGetCActorPosition( slave );

		thePlayer.EnableCharacterCollisions(false);
		((CActor)slave).EnableCharacterCollisions(false);

		AddTimer('ACS_Finisher_Unblock_Action', 2 , false);

		if( (W3Potion_Thunderbolt)GetWitcherPlayer().GetBuff(EET_Thunderbolt) )
		{
			thePlayer.SoundEvent("sign_aard_warmup");
			thePlayer.SoundEvent("sign_aard_warmup");
			thePlayer.SoundEvent("sign_aard_warmup");
			thePlayer.SoundEvent("sign_aard_warmup");

			if(RandF() < 0.5)
			{
				PlayerPlayAnimation('tw2_grapple_01_ACS');
			}
			else
			{
				PlayerPlayAnimation('tw2_grapple_02_ACS');
			}

			//animatedComponentB = (CAnimatedComponent)(((CActor)slave).GetComponentByClassName( 'CAnimatedComponent' ));

			//animatedComponentB.FreezePoseFadeIn(0.125f);

			ACSGetCEntity('ACS_Grapple_Dummy').Destroy();

			dummycomp = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource( 

			"dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent"

			,true ), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation());

			dummycomp.CreateAttachment(thePlayer,'l_weapon');

			((CNewNPC)slave).CreateAttachment(dummycomp);

			dummycomp.AddTag('ACS_Grapple_Dummy');

			((CActor)slave).AddTag('ACS_Grapple_Target');

			((CActor)slave).AddTag('ACS_Currently_In_Grapple_Anim');

			ProcessFinisherCamera('man_finisher_06_lp');

			((CActor)slave).ACS_GrappleVictimAnim();
		}
		else
		{
			masterSequencePart.animation			= 'man_fistfight_grapple_attacker_ACS';

			masterSequencePart.syncType				= AMST_SyncBeginning;
			masterSequencePart.useRefBone			= 'Reference';
			masterSequencePart.rotationTypeUsingRefBone = SRT_TowardsOtherEntity;
			masterSequencePart.shouldSlide			= false;
			masterSequencePart.shouldRotate			= true;
		
			masterSequencePart.finalPosition	= master.GetWorldPosition();
			masterSequencePart.finalHeading		= master.GetHeading();
			
			masterSequencePart.blendInTime			= 0;
			masterSequencePart.blendOutTime			= 0.5f;


			if (((CActor)slave).IsHuman())
			{
				slaveSequencePart.animation				= 'man_fistfight_grapple_victim_ACS';	
			}

			slaveSequencePart.syncType				= AMST_SyncBeginning;
			slaveSequencePart.useRefBone			= 'Reference';	
			slaveSequencePart.rotationTypeUsingRefBone = SRT_ToMatchOthersRotation;
			slaveSequencePart.shouldRotate			= true;
			slaveSequencePart.shouldSlide			= true;
			slaveSequencePart.finalHeading			= thePlayer.GetHeading() - RandRangeF(225,135);
			slaveSequencePart.finalPosition			= thePlayer.GetWorldPosition() + thePlayer.GetWorldForward();
			
			slaveSequencePart.blendInTime			= 0;
			slaveSequencePart.blendOutTime			= 0.1;

			masterDef.parts.PushBack( masterSequencePart );
			masterDef.entity						= master;
			masterSequencePart.sequenceIndex		= 0;
			masterDef.manualSlotName			= 'GAMEPLAY_SLOT';
			masterDef.freezeAtEnd					= false;

			slaveSequencePart.sequenceIndex			= 0;
			slaveSequencePart.disableProxyCollisions = true;
			slave.SetKinematic( true );
			slaveDef.parts.PushBack( slaveSequencePart );
			slaveDef.entity							= slave;
			slaveDef.manualSlotName					= 'GAMEPLAY_SLOT';
	
		
			slaveDef.freezeAtEnd					= true;
			finisherAnim 							= false;
			
			sequenceIndex = syncInstance.RegisterMaster( masterDef );
			
			
			actorMaster = (CActor)master;
			actorSlave = (CActor)slave;
			
			
			if(actorMaster)
			{
				actorMaster.SignalGameplayEventParamInt( 'SetupSyncInstance', instanceIndex );
				actorMaster.SignalGameplayEventParamInt( 'SetupSequenceIndex', sequenceIndex );
				if ( finisherAnim )
					actorMaster.SignalGameplayEvent( 'PlayFinisherSyncedAnim' );
				else
					actorMaster.SignalGameplayEvent( 'PlaySyncedAnim' );
				
			}
			
			sequenceIndex = syncInstance.RegisterSlave( slaveDef );
			if( sequenceIndex == -1 ) 
			{
				return false;
			}
			
			if(actorSlave)
			{
				actorSlave.SignalGameplayEventParamInt( 'SetupSyncInstance', instanceIndex );
				actorSlave.SignalGameplayEventParamInt( 'SetupSequenceIndex', sequenceIndex );
				if ( finisherAnim )
					actorSlave.SignalGameplayEvent( 'PlayFinisherSyncedAnim' );
				else
					actorSlave.SignalGameplayEvent( 'PlaySyncedAnim' );
			}
		}
		
		return true;
	}

	public function ACS_SetupSyncAnimInternalHuman( syncAction : name, master, slave : CEntity ) : bool
	{
		var masterDef, slaveDef													: SAnimationSequenceDefinition;
		var masterSequencePart, slaveSequencePart								: SAnimationSequencePartDefinition;
		var syncInstance														: CAnimationManualSlotSyncInstance;
		
		var instanceIndex														: int;
		var sequenceIndex														: int;
		
		var temp 																: name; 
		var tempF 																: float;
		var rot 																: EulerAngles;
		
		var finisherAnim 														: bool;
		var pos 																: Vector;
		
		var syncAnimName, cameraAnimName										: name;
		
		var node, node1 														: CNode; 
		var rot0, rot1, slaveRot 												: EulerAngles;
		
		var masterAnim, slaveAnim 												: name;
		var syncAnimIndex														: int;
		var currentAnimInstance													: CAnimationManualSlotSyncInstance;
		var actorMaster, actorSlave 											: CActor;

		var fear_actors															: array<CActor>;
		var j, k 																: int;
		var fear_actor															: CActor;
		var animatedComponentFearActor											: CAnimatedComponent;
		var movementAdjustorFinisher, movementAdjustorFinisherActor				: CMovementAdjustor;
		var ticketFinisher, ticketFinisherActor 								: SMovementAdjustmentRequestTicket;
		var dist																: float;
		var animatedComponentB													: CAnimatedComponent;

		if ( ((CActor)slave).HasTag('ACS_Hit_Lag'))
		{
			animatedComponentB = (CAnimatedComponent)(((CActor)slave).GetComponentByClassName( 'CAnimatedComponent' ));

			animatedComponentB.UnfreezePose();

			animatedComponentB.UnfreezePoseFadeOut(0.1);

			((CActor)slave).RemoveTag('ACS_Hit_Lag');
		}

		action_interrupt();

		if (((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'wood_hollow'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'wood_debris'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'dirt_hard'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'dirt_soil'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'hay'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'stone_debris'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'stone_solid'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'clay_tile'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'gravel_large'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'gravel_small'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'sand'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'water_shallow'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'water_deep'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'grass_short'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'grass_long'
		|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'carpet'
		)
		{

			thePlayer.StopEffect('jump_ground_fx1');
			thePlayer.PlayEffect('jump_ground_fx1');

			if (((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'dirt_hard'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'dirt_soil'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'hay'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'stone_debris'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'clay_tile'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'gravel_large'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'gravel_small'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'sand'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'grass_short'
			|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'grass_long'
			)
			{
				//thePlayer.StopEffect('covered_dirt_ACS');
				//thePlayer.PlayEffect('covered_dirt_ACS');

				if( GetRainStrength() > 0 
				&& !thePlayer.IsInInterior()
				&& !RoofCheck()
				) 
				{

				}
				else if (ACS_Settings_Main_Bool('acs_player_misc_settings','acs_dirt_vfx_enabled', true))
				{
					thePlayer.StopEffect('covered_dirt_big_ACS');
					thePlayer.PlayEffect('covered_dirt_big_ACS');

					thePlayer.StopEffect('covered_dirt_small_ACS');
					thePlayer.PlayEffect('covered_dirt_small_ACS');
				}
			}
		}

		thePlayer.AddTag('ACS_IsPerformingFinisher');

		if (!thePlayer.HasTag('ACS_HasPerformedFinisher'))
		{
			thePlayer.AddTag('ACS_HasPerformedFinisher');
		}

		syncInstance = theGame.GetSyncAnimManager().CreateNewSyncInstance( instanceIndex );
		syncAnimIndex = instanceIndex;
		currentAnimInstance = syncInstance;

		if (((CActor)slave).GetInteractionPriority() != IP_Max_Unpushable )
		{
			((CActor)slave).SetInteractionPriority( IP_Max_Unpushable );
		}

		theInput.IgnoreGameInput( 'GI_AxisLeftX', true );
		theInput.IgnoreGameInput( 'GI_AxisLeftY', true );


		dist = (((CMovingPhysicalAgentComponent)((CActor)slave).GetMovingAgentComponent()).GetCapsuleRadius() 
		+ ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent()).GetCapsuleRadius()) * 0.5;

		movementAdjustorFinisher = GetWitcherPlayer().GetMovingAgentComponent().GetMovementAdjustor();

		movementAdjustorFinisher.CancelAll();
		
		ticketFinisher = movementAdjustorFinisher.CreateNewRequest( 'ACS_Finisher_Rotate' );
			
		movementAdjustorFinisher.AdjustmentDuration( ticketFinisher, 0.001 );

		movementAdjustorFinisher.ShouldStartAt(ticketFinisher, GetWitcherPlayer().GetWorldPosition());
		movementAdjustorFinisher.MaxRotationAdjustmentSpeed( ticketFinisher, 5000000 );
		movementAdjustorFinisher.MaxLocationAdjustmentSpeed( ticketFinisher, 5000000 );
		movementAdjustorFinisher.Continuous(ticketFinisher);
		
		//movementAdjustorFinisher.SlideTowards( ticketFinisher, slave, dist, dist );


		movementAdjustorFinisherActor = ((CActor)slave).GetMovingAgentComponent().GetMovementAdjustor();

		movementAdjustorFinisherActor.CancelAll();
		
		ticketFinisherActor = movementAdjustorFinisherActor.CreateNewRequest( 'ACS_Finisher_Rotate' );
			
		movementAdjustorFinisherActor.AdjustmentDuration( ticketFinisherActor, 1 );

		movementAdjustorFinisherActor.ShouldStartAt(ticketFinisherActor, slave.GetWorldPosition());
		movementAdjustorFinisherActor.MaxRotationAdjustmentSpeed( ticketFinisherActor, 5000000 );
		movementAdjustorFinisherActor.MaxLocationAdjustmentSpeed( ticketFinisherActor, 5000000 );

		movementAdjustorFinisherActor.RotateTowards( ticketFinisherActor, GetWitcherPlayer() );

		thePlayer.BlockAllActions( 'ACS_Finisher_Action_Block', true );

		thePlayer.SetGuarded(false);
		thePlayer.OnGuardedReleased();

		ACS_Axii_Shield_Destroy_IMMEDIATE();

		weapon_blood_fx('red');

		thePlayer.SetImmortalityMode( AIM_Invulnerable, AIC_Default, true ); 
		thePlayer.SetCanPlayHitAnim(false); 
		//thePlayer.EnableCharacterCollisions(false); 
		thePlayer.AddBuffImmunity_AllNegative('ACS_Finisher_Immune_Negative', true); 
		thePlayer.AddBuffImmunity_AllCritical('ACS_Finisher_Immune_Critical', true); 

		//ChangeInteractionPriority();
		
		RemoveTimer('ACS_Finisher_Unblock_Action');

		RemoveTimer('ACS_Finisher_Unblock_Camera');

		FreezeMoveTargets(6);
		
		if (((CActor)slave).IsAlive())
		{
			((CActor)slave).Kill( 'ACS_Finisher', false, thePlayer );
		}

		if (thePlayer.HasTag('ACS_IsSwordWalking'))
		{
			thePlayer.RemoveTag('ACS_IsSwordWalking');
		}

		RemoveTimer('SwordTauntSwitch'); 
		RemoveTimer('SwordTauntRunningSwitch'); 
		 
		if (thePlayer.IsInAir()
		|| thePlayer.IsFalling()
		)
		{
			//thePlayer.RaiseEvent('ACS_ForceLegsFloatIdle');
		}
		else
		{
			if (thePlayer.HasTag('ACS_IsSwordWalking'))
			{
				thePlayer.RaiseEvent('ACS_SwordWalkAdditiveEnd');thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');RemoveTimer('CombatTauntDelay');thePlayer.RaiseEvent('ACS_SwordTauntEnd');

				thePlayer.RemoveTag('ACS_IsSwordWalking');
			}
		}

		((CActor)slave).SetCanPlayHitAnim(true);

		((CNewNPC)slave).SetUnstoppable(false);

		RemoveTimer('SwordTauntSwitch'); 
		RemoveTimer('SwordTauntRunningSwitch'); 
		 
		RemoveTimer('CombatTauntDelay');
		RemoveTimer('SwordTauntRunningSwitchSecondary'); 
		RemoveTimer('SwordTauntRunningSwitchSecondaryWeaponBlood'); 

		thePlayer.RaiseEvent('ACS_SwordTauntEnd');
		thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');

		if(ACSGetCEntity('ACS_Viper_Dagger_L'))
		{
			thePlayer.RaiseEvent('ACS_LHandAttack01');
		}

		if (backhandSwordWield)
		{
			backhandSwordWield = false;
		}

		thePlayer.AddTag('ACS_Sword_Hit_Blood_Trigger');
		
		thePlayer.RaiseEvent('ACS_ForceHandClosedREnd');

		//animatedComponentFearActor = (CAnimatedComponent)((CActor)slave).GetComponentByClassName( 'CAnimatedComponent' );	
	
		//animatedComponentFearActor.PlaySlotAnimationAsync( '', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0, 0));

		pos = ACSGetCActorPosition( slave );

		if (thePlayer.IsWeaponHeld('steelsword'))
		{
			if ( ACS_GetItem_Sword_IsEquipped('olgierd_steel', 'steel') )
			{
				if (!GetWitcherPlayer().HasTag('ACS_Camo_Active')
				&& ACS_Settings_Main_Bool('acs_dodge_settings','acs_dodge_effects', false))
				{
					GetWitcherPlayer().PlayEffectSingle('special_attack_fx');
					GetWitcherPlayer().StopEffect('special_attack_fx');
				}
			}
		}
		else if (thePlayer.IsWeaponHeld('silversword'))
		{
			if ( ACS_GetItem_Sword_IsEquipped('olgierd_silver', 'silver') )
			{
				if (!GetWitcherPlayer().HasTag('ACS_Camo_Active')
				&& ACS_Settings_Main_Bool('acs_dodge_settings','acs_dodge_effects', false))
				{
					GetWitcherPlayer().PlayEffectSingle('special_attack_fx');
					GetWitcherPlayer().StopEffect('special_attack_fx');
				}
			}
		}

		switch( syncAction )
		{
			case 'man_fistfight_finisher':
			{
				thePlayer.EnableCharacterCollisions(false);
				((CActor)slave).EnableCharacterCollisions(false);

				movementAdjustorFinisher.RotateTo( ticketFinisher, thePlayer.GetHeading() );

				AddTimer('ACS_Finisher_Unblock_Action', 2.5 , false);

				masterSequencePart.animation			= 'man_fistfight_finisher_1_winner_ACS';
				masterSequencePart.syncType				= AMST_SyncBeginning;
				masterSequencePart.useRefBone			= 'Reference';
				masterSequencePart.rotationTypeUsingRefBone = SRT_TowardsOtherEntity;
				masterSequencePart.shouldSlide			= false;
				masterSequencePart.shouldRotate			= true;
			
				masterSequencePart.finalPosition	= 1.5 * VecNormalize( master.GetWorldPosition() - pos ) + pos;
				masterSequencePart.finalHeading		= VecHeading( pos - master.GetWorldPosition() );
				
				masterSequencePart.blendInTime			= 0;
				masterSequencePart.blendOutTime			= 0.75f;

				ProcessFinisherCamera('man_finisher_06_lp');

				slave.AddTag('ACS_man_fistfight_finisher');
				slaveSequencePart.animation				= 'man_fistfight_finisher_1_loser_ACS';	
				slaveSequencePart.syncType				= AMST_SyncBeginning;
				slaveSequencePart.useRefBone			= 'Reference';	
				slaveSequencePart.rotationTypeUsingRefBone = SRT_ToMatchOthersRotation;
				slaveSequencePart.shouldRotate			= true;
				slaveSequencePart.shouldSlide			= true;
				slaveSequencePart.finalHeading			= thePlayer.GetHeading();
				slaveSequencePart.finalPosition			= thePlayer.GetWorldPosition() + thePlayer.GetWorldForward() * -2;
				
				slaveSequencePart.blendInTime			= 0;
				slaveSequencePart.blendOutTime			= 0;
				
				break;		
			}

			case 'man_igni_finisher':
			{
				//movementAdjustorFinisher.RotateTowards( ticketFinisher, slave );

				AddTimer('ACS_Finisher_Unblock_Action', 1.5 , false);

				if(thePlayer.GetCombatIdleStance() <= 0.f )
				{
					masterSequencePart.animation			= 'man_ger_sword_ignii_front_lp';
				}
				else
				{
					masterSequencePart.animation			= 'man_ger_sword_ignii_front_rp';
				}

				masterSequencePart.syncType				= AMST_SyncBeginning;
				masterSequencePart.useRefBone			= 'Reference';
				masterSequencePart.rotationTypeUsingRefBone = SRT_TowardsOtherEntity;
				masterSequencePart.shouldSlide			= true;
				masterSequencePart.shouldRotate			= true;
				
				masterSequencePart.blendInTime			= 0;
				masterSequencePart.blendOutTime			= 0.5f;

				ProcessFinisherCamera('man_finisher_04_lp', 'man_finisher_05_rp');

				slave.AddTag('ACS_man_burn_loop');
				slave.AddTag('ACS_Killed_By_Fire');

				((CNewNPC)slave).RemoveTimer('ACS_Finisher_Igni_Delay');
				((CNewNPC)slave).AddTimer('ACS_Finisher_Igni_Delay', 0.5 , false);

				RemoveTimer('IgniLightIcon');
				AddTimer('IgniLightIcon', 0.5 , false);

				((CAnimatedComponent)slave.GetComponentByClassName('CAnimatedComponent')).UnfreezePoseFadeOut(2.f);

				if (RandF() < 0.5)
				{
					if (RandF() < 0.5)
					{
						slaveSequencePart.animation			= 'mcat_attack_grab_left';
					}
					else
					{
						slaveSequencePart.animation			= 'mcat_attack_grab_right';
					}
				}
				else
				{
					if (RandF() < 0.5)
					{
						slaveSequencePart.animation			= 'man_npc_sword_1hand_burn_loop_right';
					}
					else
					{
						slaveSequencePart.animation			= 'man_npc_sword_1hand_burn_loop_left';
					}
				}
				

				slaveSequencePart.syncType				= AMST_SyncBeginning;
				slaveSequencePart.useRefBone			= 'Reference';	
				slaveSequencePart.rotationTypeUsingRefBone = SRT_ToMatchOthersRotation;
				slaveSequencePart.shouldRotate			= false;
				slaveSequencePart.shouldSlide			= false;
				slaveSequencePart.finalHeading			= thePlayer.GetHeading();
				
				slaveSequencePart.blendInTime			= 1.0f;
				slaveSequencePart.blendOutTime			= 0.125f;
				
				break;	
			}

			case 'man_aard_finisher':
			{

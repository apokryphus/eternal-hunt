	private var minimapAlpha : float;
	default minimapAlpha = 100;

	private var questAlpha : float;
	default questAlpha = 100;

	private var controlHintAlpha : float;
	default controlHintAlpha = 100;

	private var buffsAlpha : float;
	default buffsAlpha = 100;

	private var wolfsHeadHudAlpha : float;
	default wolfsHeadHudAlpha = 100;

	private var itemsHudAlpha : float;
	default itemsHudAlpha = 100;

	timer function MinimapModuleFadeFlashObjectOut(dt : float , id : int)
	{	
		var hud 															: CR4ScriptedHud;
		var module 															: CR4HudModuleMinimap2;	
		
		hud = (CR4ScriptedHud)theGame.GetHud();

		module = (CR4HudModuleMinimap2)hud.GetHudModule("Minimap2Module");

		module.GetModuleFlash().SetAlpha( minimapAlpha );

		if (minimapAlpha <= 0)
		{
			module.SetEnabled(false);

			minimapAlpha = 100;

			RemoveTimer('MinimapModuleFadeFlashObjectOut');
		}
		else
		{
			minimapAlpha -= 2.5;
		}
	}

	timer function QuestModuleFadeFlashObjectOut(dt : float , id : int)
	{	
		var hud 															: CR4ScriptedHud;
		var module 															: CR4HudModuleQuests;	
		
		hud = (CR4ScriptedHud)theGame.GetHud();

		module = (CR4HudModuleQuests)hud.GetHudModule("QuestsModule");

		module.GetModuleFlash().SetAlpha( questAlpha );

		if (questAlpha <= 0)
		{
			module.SetEnabled(false);

			questAlpha = 100;

			RemoveTimer('QuestModuleFadeFlashObjectOut');
		}
		else
		{
			questAlpha -= 2.5;
		}
	}

	timer function ControlHintModuleFadeFlashObjectOut(dt : float , id : int)
	{	
		var hud 															: CR4ScriptedHud;
		var module 															: CR4HudModuleControlsFeedback;	
		
		hud = (CR4ScriptedHud)theGame.GetHud();

		module = (CR4HudModuleControlsFeedback)hud.GetHudModule("ControlsFeedbackModule");

		module.GetModuleFlash().SetAlpha( controlHintAlpha );

		if (controlHintAlpha <= 0)
		{
			module.SetEnabled(false);

			controlHintAlpha = 100;

			RemoveTimer('ControlHintModuleFadeFlashObjectOut');
		}
		else
		{
			controlHintAlpha -= 2.5;
		}
	}

	timer function BuffsModuleFadeFlashObjectOut(dt : float , id : int)
	{	
		var hud 															: CR4ScriptedHud;
		var module 															: CR4HudModuleBuffs;	
		
		hud = (CR4ScriptedHud)theGame.GetHud();

		module = (CR4HudModuleBuffs)hud.GetHudModule("BuffsModule");

		module.GetModuleFlash().SetAlpha( buffsAlpha );

		if (buffsAlpha <= 0)
		{
			module.SetDisplayBuffs( false );

			module.SetEnabled(false);

			buffsAlpha = 100;

			RemoveTimer('BuffsModuleFadeFlashObjectOut');
		}
		else
		{
			buffsAlpha -= 2.5;
		}
	}

	timer function WolfHeadHudModuleFadeFlashObjectOut(dt : float , id : int)
	{	
		var hudWolfHeadModule 													: CR4HudModuleWolfHead;	
		var hud 																: CR4ScriptedHud;

		hud = (CR4ScriptedHud)theGame.GetHud();

		hudWolfHeadModule = (CR4HudModuleWolfHead)hud.GetHudModule( "WolfHeadModule" );

		hudWolfHeadModule.GetModuleFlash().SetAlpha( wolfsHeadHudAlpha );

		if (wolfsHeadHudAlpha <= 0)
		{
			hudWolfHeadModule.SetAlwaysDisplayed(false);
			hudWolfHeadModule.SetEnabled(false);

			wolfsHeadHudAlpha = 100;

			if (FactsQuerySum("ACS_WolfHeadHud_Module_Shown") > 0)
			{
				FactsRemove("ACS_WolfHeadHud_Module_Shown");
			}

			RemoveTimer('WolfHeadHudModuleFadeFlashObjectOut');
		}
		else
		{
			wolfsHeadHudAlpha -= 2.5;
		}
	}

	timer function ItemHudModuleFadeFlashObjectOut(dt : float , id : int)
	{	
		var hud 															: CR4ScriptedHud;
		var hudItemModule 													: CR4HudModuleItemInfo;	
		
		hud = (CR4ScriptedHud)theGame.GetHud();

		hudItemModule = (CR4HudModuleItemInfo)hud.GetHudModule("ItemInfoModule");

		hudItemModule.GetModuleFlash().SetAlpha( itemsHudAlpha );

		if (itemsHudAlpha <= 0)
		{
			hudItemModule.SetAlwaysDisplayed(false);
			hudItemModule.SetEnabled(false);

			itemsHudAlpha = 100;

			if (FactsQuerySum("ACS_ItemHud_Module_Shown") > 0)
			{
				FactsRemove("ACS_ItemHud_Module_Shown");
			}

			RemoveTimer('ItemHudModuleFadeFlashObjectOut');
		}
		else
		{
			itemsHudAlpha -= 2.5;
		}
	}


				{
					ACSGetCActor('ACS_Transformation_Giant').DestroyEffect('lugos_vision_burning_gp');
				}
			}
		}
		else
		{
			if (ACSGetCEntity('ACS_Transformation_Giant_Back_Weapons').IsEffectActive('lightning_hit_ascended'))
			{
				ACSGetCEntity('ACS_Transformation_Giant_Back_Weapons').StopEffect('lightning_hit_ascended');
			}

			if (ACSGetCEntity('ACS_Transformation_Giant_Back_Weapons').IsEffectActive('charge_ascended'))
			{
				ACSGetCEntity('ACS_Transformation_Giant_Back_Weapons').StopEffect('charge_ascended');
			}

			if (!ACSGetCEntity('ACS_Transformation_Giant_Back_Weapons').IsEffectActive('lightning_hit'))
			{
				ACSGetCEntity('ACS_Transformation_Giant_Back_Weapons').PlayEffect('lightning_hit');
			}

			if (!ACSGetCEntity('ACS_Transformation_Giant_Back_Weapons').IsEffectActive('charge'))

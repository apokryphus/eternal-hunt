				else if (combo_counter_geralt_light_attack_forward == 11)
				{
					PlayerPlayAnimation( 'tw2_long_attack_light_13_ACS');	

					combo_counter_damage += 1;

					combo_counter_geralt_light_attack_forward += 1;

	// Bow & Crossbow Stuff

	var vACS_Shoot_Bow : cACS_Shoot_Bow;

	public timer function ACS_ShootBowMoving ( dt : float, id : int)
	{ 
		MovementAdjust('default');

		if(thePlayer.HasTag('ACS_Manual_Combat_Control')){thePlayer.RemoveTag('ACS_Manual_Combat_Control');} RemoveTimer('Manual_Combat_Control_Remove');
		
		//PlayerPlayAnimation( 'man_npc_bow_idle_aiming_01_ACS');

		//thePlayer.RaiseEvent('ACS_ShootBowAiming');

		//ACSGetCEntity('acs_bow').BreakAttachment(); 
		//ACSGetCEntity('acs_bow').Teleport( GetWitcherPlayer().GetWorldPosition() + Vector( 0, 0, -200 ) );
		//ACSGetCEntity('acs_bow').DestroyAfter(0.00125);
		//ACSGetCEntity('acs_bow').RemoveTag('acs_bow');

		//AzkarBowCreateFake();

		//ACSGetCEntity('acs_bow').GetRootAnimatedComponent().PlaySkeletalAnimationAsync( 'man_npc_bow_idle_aiming_01' , true );

		thePlayer.SetSprintActionPressed( false );
		thePlayer.SetSprintToggle( false );
		thePlayer.SetWalkToggle( true );

		vACS_Arrow_Create = new cACS_Arrow_Create in this;
				
		vACS_Arrow_Create.ACS_Arrow_Create_Ready_Engage();

		thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( '', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(1.f, 1.f) );

		thePlayer.RaiseEvent('ACS_ShootBowToIdle');

		ACSGetCEntity('acs_bow').GetRootAnimatedComponent().PlaySkeletalAnimationAsync( 'man_npc_bow_shoot_to_idle_lp' , true );

		AddTimer('ACS_Arrow_Create_Delay', 0.5   , false);

		thePlayer.SetCombatIdleStance(1);

		if (FactsQuerySum("ACS_Azkar_Aiming") > 0)
		{
			thePlayer.RaiseEvent('ACS_BowOrientationPelvis');
			thePlayer.RaiseEvent('ACS_ShootBowOrientationR');

			AddTimer('ACS_Arrow_Shoot_Delay', 0.125   , false);
		}
		else
		{
			if( actor && ACS_AttitudeCheck ( actor, true ) && thePlayer.IsInCombat())
			{
				if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) 
				{
					movementAdjustor.RotateTowards( ticket, actor );
					movementAdjustor.Continuous(ticket);
				}

				if(targetDistance <= 20 * 20 || thePlayer.IsInInterior())
				{
					thePlayer.RaiseEvent('ACS_BowOrientationPelvis');
					thePlayer.RaiseEvent('ACS_ShootBowOrientationR');

					AddTimer('ACS_Arrow_Shoot_Delay', 0.125   , false);
				}
				else
				{
					thePlayer.RaiseEvent('ACS_BowOrientationPelvis');
					thePlayer.RaiseEvent('ACS_ShootBowOrientationRHigh');

					AddTimer('ACS_Arrow_Shoot_High_Delay', 0.125   , false);
				}
			}
			else
			{
				movementAdjustor.RotateTo( ticket, theCamera.GetCameraHeading() );

				thePlayer.RaiseEvent('ACS_BowOrientationPelvis');
				thePlayer.RaiseEvent('ACS_ShootBowOrientationR');

				AddTimer('ACS_Arrow_Shoot_Delay', 0.125   , false);
			}
		}
	} 

	public timer function ACS_Arrow_Create_Delay ( dt : float, id : int)
	{ 
		vACS_Arrow_Create = new cACS_Arrow_Create in this; 

		vACS_Arrow_Create.ACS_Arrow_Create_Engage(); 
		
		if (FactsQuerySum("ACS_Azkar_Aiming") > 0)
		{
			if (!thePlayer.IsGuarded())
			{
				thePlayer.SetGuarded(true);
				thePlayer.OnPerformGuard();
			}
		}

		ACSGetCEntity('acs_bow').GetRootAnimatedComponent().PlaySkeletalAnimationAsync( 'man_npc_bow_idle_lp_01' , true );
	} 

	public timer function ACS_Arrow_Shoot_Delay ( dt : float, id : int)
	{ 
		movementAdjustor.CancelAll();

		vACS_Shoot_Bow = new cACS_Shoot_Bow in this;

		if (FactsQuerySum("ACS_Azkar_Aiming") > 0)
		{		
			vACS_Shoot_Bow.ACS_Shoot_Bow_Aiming_Engage();
		}
		else
		{
			vACS_Shoot_Bow.ACS_Shoot_Bow_Engage();
		}
	} 


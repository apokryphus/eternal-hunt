					if (ACSGetCEntity('ACS_Armor_Ether_Sword').IsEffectActive('soul_edge_glow', false))
					{
						ACSGetCEntity('ACS_Armor_Ether_Sword').DestroyEffect('soul_edge_glow');
					}

					if (ACSGetCEntity('ACS_Armor_Ether_Sword').IsEffectActive('war_sword_glow', false))
					{
						ACSGetCEntity('ACS_Armor_Ether_Sword').DestroyEffect('war_sword_glow');
					}

					if(GetWitcherPlayer().IsWeaponHeld( 'silversword' ) )
					{
						if (ACSGetCEntity('ACS_Armor_Ether_Sword').IsEffectActive('andurial_glow', false))
						{
							ACSGetCEntity('ACS_Armor_Ether_Sword').DestroyEffect('andurial_glow');
						}

						if (ACSGetCEntity('ACS_Armor_Ether_Sword').IsEffectActive('pridefall_glow', false))
						{
							ACSGetCEntity('ACS_Armor_Ether_Sword').DestroyEffect('pridefall_glow');
						}

						if (thePlayer.GetStat(BCS_Focus) >= thePlayer.GetStatMax( BCS_Focus ) * 0.33
						|| thePlayer.IsDoingSpecialAttack(true)
						|| thePlayer.IsDoingSpecialAttack(false)
						)
						{
							if (ACSGetCEntity('ACS_Armor_Ether_Sword').IsEffectActive('dsd_closed_glow', false))
							{
								ACSGetCEntity('ACS_Armor_Ether_Sword').DestroyEffect('dsd_closed_glow');
							}

							if (!ACSGetCEntity('ACS_Armor_Ether_Sword').IsEffectActive('dsd_open_glow', false))
							{
								thePlayer.SoundEvent("fx_rune_activate_igni");
								thePlayer.SoundEvent("fx_rune_activate_igni");
								thePlayer.SoundEvent("fx_rune_activate_igni");

								ACSGetCEntity('ACS_Armor_Ether_Sword').DestroyEffect('fire_sparks_trail');
								ACSGetCEntity('ACS_Armor_Ether_Sword').PlayEffectSingle('fire_sparks_trail');

								ACSGetCEntity('ACS_Armor_Ether_Sword').DestroyEffect('red_fast_attack_buff');
								ACSGetCEntity('ACS_Armor_Ether_Sword').PlayEffectSingle('red_fast_attack_buff');

								ACSGetCEntity('ACS_Armor_Ether_Sword').DestroyEffect('red_fast_attack_buff_hit');
								ACSGetCEntity('ACS_Armor_Ether_Sword').PlayEffectSingle('red_fast_attack_buff_hit');

								ACSGetCEntity('ACS_Armor_Ether_Sword').PlayEffectSingle('dsd_open_glow');
							}
						}
						else
						{
							if (ACSGetCEntity('ACS_Armor_Ether_Sword').IsEffectActive('dsd_open_glow', false))
							{
								ACSGetCEntity('ACS_Armor_Ether_Sword').DestroyEffect('dsd_open_glow');
							}

							if (!ACSGetCEntity('ACS_Armor_Ether_Sword').IsEffectActive('dsd_closed_glow', false))
							{
								thePlayer.SoundEvent("fx_rune_activate_igni");
								thePlayer.SoundEvent("fx_rune_activate_igni");
								thePlayer.SoundEvent("fx_rune_activate_igni");

								ACSGetCEntity('ACS_Armor_Ether_Sword').DestroyEffect('fire_sparks_trail');
								ACSGetCEntity('ACS_Armor_Ether_Sword').PlayEffectSingle('fire_sparks_trail');

								ACSGetCEntity('ACS_Armor_Ether_Sword').DestroyEffect('red_fast_attack_buff');
								ACSGetCEntity('ACS_Armor_Ether_Sword').PlayEffectSingle('red_fast_attack_buff');

								ACSGetCEntity('ACS_Armor_Ether_Sword').DestroyEffect('red_fast_attack_buff_hit');
								ACSGetCEntity('ACS_Armor_Ether_Sword').PlayEffectSingle('red_fast_attack_buff_hit');

								ACSGetCEntity('ACS_Armor_Ether_Sword').PlayEffectSingle('dsd_closed_glow');
							}
						}
					}
					else if(GetWitcherPlayer().IsWeaponHeld( 'steelsword' ))
					{
						if (ACSGetCEntity('ACS_Armor_Ether_Sword').IsEffectActive('dsd_open_glow', false))
						{
							ACSGetCEntity('ACS_Armor_Ether_Sword').DestroyEffect('dsd_open_glow');
						}

						if (ACSGetCEntity('ACS_Armor_Ether_Sword').IsEffectActive('dsd_closed_glow', false))
						{
							ACSGetCEntity('ACS_Armor_Ether_Sword').DestroyEffect('dsd_closed_glow');
						}

						if (thePlayer.GetStat(BCS_Focus) >= thePlayer.GetStatMax( BCS_Focus ) * 0.33
						|| thePlayer.IsDoingSpecialAttack(true)
						|| thePlayer.IsDoingSpecialAttack(false)
						)
						{
							if (ACSGetCEntity('ACS_Armor_Ether_Sword').IsEffectActive('andurial_glow', false))
							{
								ACSGetCEntity('ACS_Armor_Ether_Sword').DestroyEffect('andurial_glow');
							}

							if (!ACSGetCEntity('ACS_Armor_Ether_Sword').IsEffectActive('pridefall_glow', false))
							{
								thePlayer.SoundEvent("fx_rune_activate_igni");

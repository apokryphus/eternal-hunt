	timer function GetACSGuidingLightAvailableQuestMarker_EffectStopDelay( time : float , id : int )
	{
		RemoveTimer('GetACSGuidingLightAvailableQuestMarker_EffectStoppingDelay');

		ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker_smaller');
		ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker_small');
		ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker');
		ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker_bigger');
		ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker_biggest');
		ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker_biggest_x2');
		ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').StopEffect('secondary_quest_marker_biggest_x4');

		availableQuestMarkerFadeOut = 100;
		RemoveTimer('availableQuestMarkerFadeOut');
		AddTimer('availableQuestMarkerFadeOut', 0.01 , true);

		GetACSStorage().acs_deleteOnelinerByTag("ACS_Available_Quest_Distance_GUI_Marker");

		if (ACS_Guiding_Light_Available_Quest_Marker_Distance_Available)
		{
			ACS_Guiding_Light_Available_Quest_Marker_Distance_Available = false;
		}

		if (ACS_Guiding_Light_Available_Quest_Marker_Stopped)
		{
			ACS_Guiding_Light_Available_Quest_Marker_Stopped = false;
		}
	}

	////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	function ACS_Guiding_Light_User_Marker_Distance_Actual()
	{
		var iconPath 							: string;
		var playerPosition, markerPosition 		: Vector;
		var distance 							: float;

		GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_User_Distance_GUI_Marker", 100);
		
		GetACSStorage().acs_deleteOnelinerByTag("ACS_User_Distance_GUI_Marker");

		if (!ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker'))
		{
			return;
		}

		playerPosition = thePlayer.GetWorldPosition();

		markerPosition = ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').GetWorldPosition();

		distance = VecDistance(playerPosition, markerPosition);

		if (distance <= 4.5 )
		{
			iconPath = "<br/><br/>" + "<font size = '16' color = '#029400'>" + "[" + GetLocStringByKeyExt("fake_key_1h78y_j") + "]" + "</font>";
		}
		else
		{
			iconPath = "<br/><br/>" + "<font size = '16' color = '#029400'>" + "[" + FloatToStringPrec(distance, 0) + "m" + "]" + "</font>";
		}

		ACS_Oneliner(iconPath, ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker'), "ACS_User_Distance_GUI_Marker");

		GetACSStorage().acs_setScaleForOnelinerByTag("ACS_User_Distance_GUI_Marker", 100, 100, 100);

		GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_User_Distance_GUI_Marker", 100);
	}

	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	private var userMarkerFadeOut : float;
	default userMarkerFadeOut = 100;

	timer function userMarkerFadeOut(dt : float , id : int)
	{	
		GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_User_GUI_Marker", userMarkerFadeOut);

		if (userMarkerFadeOut <= 0)
		{
			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_User_GUI_Marker", 100);

			GetACSStorage().acs_deleteOnelinerByTag("ACS_User_GUI_Marker");

			if (ACS_Guiding_Light_User_Marker_Distance_Available)
			{
				ACS_Guiding_Light_User_Marker_Distance_Available = false;
			}

			ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').Destroy();

			userMarkerFadeOut = 100;

			RemoveTimer('userMarkerFadeOut');
		}
		else
		{
			userMarkerFadeOut -= 1;
		}
	}

	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	
	var ACS_Guiding_Light_User_Pin_Marker_Stopping : bool;

	var ACS_Guiding_Light_User_Pin_Marker_Stopped : bool;

	function Guiding_Light_User_Pin_Display()
	{
		var id																													: int;
		var index																												: int;
		var x																													: float;
		var y																													: float;
		var type																												: int;
		var area																												: int;
		var position																											: Vector;
		var rot, newRot          																								: EulerAngles;
		var ent																													: CEntity;
		var temp																												: CEntityTemplate;
		var targetDistance																										: float;
		var mappins																												: array<SCommonMapPinInstance>;
		var size 																												: int;
		var compass_check 																										: bool;
	
		size = theGame.GetCommonMapManager().GetUserMapPinCount();

		if (size > 0)
		{
			theGame.GetCommonMapManager().GetUserMapPinByIndex( (size - 1), id, area, position.X, position.Y, type );	
		}

		if ( theGame.IsDialogOrCutscenePlaying() 
		|| theGame.IsFading()
		|| theGame.IsBlackscreen()
		|| theGame.IsPaused() 
		|| theGame.GetPhotomodeEnabled() 
		|| thePlayer.IsInCutsceneIntro() 
		|| size == 0
		|| area != theGame.GetCommonMapManager().GetCurrentArea()
		|| ACS_Settings_Main_Float('acs_hud_settings_markers','acs_user_pin_marker_despawn_delay', 7) == 0
		)
		{
			if(ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker'))
			{
				if (ACS_Guiding_Light_User_Pin_Marker_Stopping)
				{
					ACS_Guiding_Light_User_Pin_Marker_Stopping = false;
				}

				if (ACS_Guiding_Light_User_Pin_Marker_Stopped)
				{
					ACS_Guiding_Light_User_Pin_Marker_Stopped = false;
				}

				RemoveTimer('GetACSGuidingLightUserPinMarker_EffectStoppingDelay');

				RemoveTimer('GetACSGuidingLightUserPinMarker_EffectStopDelay');

				userMarkerFadeOut = 100;
				RemoveTimer('userMarkerFadeOut');

				GetACSStorage().acs_deleteOnelinerByTag("ACS_User_GUI_Marker");

				GetACSStorage().acs_deleteOnelinerByTag("ACS_User_Distance_GUI_Marker");

				if (ACS_Guiding_Light_User_Marker_Distance_Available)
				{
					ACS_Guiding_Light_User_Marker_Distance_Available = false;
				}

				ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').Destroy();
			}

			return;
		}

		playerPos = thePlayer.GetWorldPosition();

		position.Z = playerPos.Z;

		position.Z += 1;

		targetDistance = VecDistanceSquared2D( GetWitcherPlayer().GetWorldPosition(), ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').GetWorldPosition() ) ;

		rot = thePlayer.GetWorldRotation();

		rot.Pitch += 180;

		rot.Yaw += 180;

		if(!ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker'))
		{
			temp = (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\fx\guiding_light_marker_old.w2ent", true );

			ent = (CEntity)theGame.CreateEntity( temp, position, rot );

			ent.AddTag('ACS_Guiding_Light_User_Pin_Marker');

			ent.AddTag('ACS_HUD_Marker_Entity');

			ent.AddTag('ACS_POI_Trigger_Entity');
		}
		else
		{
			if(RadialMenuCheck()
			|| HudExceptionCheck() 
			|| ACS_GetNearbyEnemyLocation() != Vector(0,0,-200)
			|| ACS_MapPinsCheck()
			|| thePlayer.IsAnyWeaponHeld()
			)
			{
				
					if (ACS_Guiding_Light_User_Pin_Marker_Stopping)
					{
						ACS_Guiding_Light_User_Pin_Marker_Stopping = false;
					}

					if (ACS_Guiding_Light_User_Pin_Marker_Stopped)
					{
						ACS_Guiding_Light_User_Pin_Marker_Stopped = false;
					}

					ACS_Guiding_Light_User_Marker_Distance_Available = true;

					RemoveTimer('GetACSGuidingLightUserPinMarker_EffectStoppingDelay');

					RemoveTimer('GetACSGuidingLightUserPinMarker_EffectStopDelay');

					GetACSStorage().acs_deleteOnelinerByTag("ACS_User_GUI_Marker");

					ACS_Oneliner(FormatIconPath("icons/inventory/acs_marker_user.xbm"), ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker'), "ACS_User_GUI_Marker");

					GetACSStorage().acs_setScaleForOnelinerByTag("ACS_User_GUI_Marker", 100, 100, 100);

					GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_User_GUI_Marker", 100);

					if (ACS_Settings_Main_Bool('acs_hud_settings_markers','acs_marker_bubble_enabled', false))
					{
						if (targetDistance <= 10 * 10)
						{
							ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_small');
							ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker');
							ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_bigger');
							ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_biggest');
							ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_biggest_x2');
							ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_biggest_x4');

							if (!ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').IsEffectActive('user_marker_smaller', false))
							{
								ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').PlayEffectSingle('user_marker_smaller');
							}
						}
						else if (targetDistance > 10 * 10 && targetDistance <= 25 * 25)
						{
							ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_smaller');
							ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker');
							ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_bigger');
							ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_biggest');
							ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_biggest_x2');
							ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_biggest_x4');

							if (!ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').IsEffectActive('user_marker_small', false))
							{
								ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').PlayEffectSingle('user_marker_small');
							}
						}
						else if (targetDistance > 25 * 25 && targetDistance <= 50 * 50)
						{
							ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_smaller');
							ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_small');
							ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_bigger');
							ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_biggest');
							ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_biggest_x2');
							ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_biggest_x4');

							if (!ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').IsEffectActive('user_marker', false))
							{
								ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').PlayEffectSingle('user_marker');
							}
						}
						else if (targetDistance > 50 * 50 && targetDistance <= 100 * 100)
						{
							ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_smaller');
							ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_small');
							ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker');
							ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_biggest');
							ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_biggest_x2');
							ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_biggest_x4');

							if (!ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').IsEffectActive('user_marker_bigger', false))
							{
								ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').PlayEffectSingle('user_marker_bigger');
							}
						}
						else if (targetDistance > 100 * 100)
						{
							ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_smaller');
							ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_small');
							ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker');
							ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_bigger');
							ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_biggest_x2');
							ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_biggest_x4');

							if (!ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').IsEffectActive('user_marker_biggest', false))
							{
								ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').PlayEffectSingle('user_marker_biggest');
							}
						}
					}
				
			}
			else
			{
				if ( !ACS_Guiding_Light_User_Pin_Marker_Stopping )
				{
					if ( !ACS_Guiding_Light_User_Pin_Marker_Stopped )
					{
						AddTimer('GetACSGuidingLightUserPinMarker_EffectStoppingDelay', 0.00000000000000000001 , true);

						AddTimer('GetACSGuidingLightUserPinMarker_EffectStopDelay', ACS_Settings_Main_Float('acs_hud_settings_markers','acs_user_pin_marker_despawn_delay', 7) , false);

						ACS_Guiding_Light_User_Pin_Marker_Stopped = true;
					}

					ACS_Guiding_Light_User_Pin_Marker_Stopping = true;
				}
			}
		}
	}

	timer function GetACSGuidingLightUserPinMarker_EffectStoppingDelay( time : float , id : int )
	{
		var targetDistance						: float;

		targetDistance = VecDistanceSquared2D( GetWitcherPlayer().GetWorldPosition(), ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').GetWorldPosition() ) ;

		if (ACS_Settings_Main_Bool('acs_hud_settings_markers','acs_marker_bubble_enabled', false))
		{
			if (targetDistance <= 10 * 10)
			{
				ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_small');
				ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker');
				ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_bigger');
				ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_biggest');
				ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_biggest_x2');
				ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_biggest_x4');

				if (!ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').IsEffectActive('user_marker_smaller', false))
				{
					ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').PlayEffectSingle('user_marker_smaller');
				}
			}
			else if (targetDistance > 10 * 10 && targetDistance <= 25 * 25)
			{
				ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_smaller');
				ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker');
				ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_bigger');
				ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_biggest');
				ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_biggest_x2');
				ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_biggest_x4');

				if (!ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').IsEffectActive('user_marker_small', false))
				{
					ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').PlayEffectSingle('user_marker_small');
				}
			}
			else if (targetDistance > 25 * 25 && targetDistance <= 50 * 50)
			{
				ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_smaller');
				ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_small');
				ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_bigger');
				ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_biggest');
				ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_biggest_x2');
				ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_biggest_x4');

				if (!ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').IsEffectActive('user_marker', false))
				{
					ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').PlayEffectSingle('user_marker');
				}
			}
			else if (targetDistance > 50 * 50 && targetDistance <= 100 * 100)
			{
				ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_smaller');
				ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_small');
				ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker');
				ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_biggest');
				ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_biggest_x2');
				ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_biggest_x4');

				if (!ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').IsEffectActive('user_marker_bigger', false))
				{
					ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').PlayEffectSingle('user_marker_bigger');
				}
			}
			else if (targetDistance > 100 * 100)
			{
				ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_smaller');
				ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_small');
				ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker');
				ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_bigger');
				ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_biggest_x2');
				ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_biggest_x4');

				if (!ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').IsEffectActive('user_marker_biggest', false))
				{
					ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').PlayEffectSingle('user_marker_biggest');
				}
			}
		}
	}

	timer function GetACSGuidingLightUserPinMarker_EffectStopDelay( time : float , id : int )
	{
		RemoveTimer('GetACSGuidingLightUserPinMarker_EffectStoppingDelay');

		ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_smaller');
		ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_small');
		ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker');
		ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_bigger');
		ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_biggest');
		ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_biggest_x2');
		ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').StopEffect('user_marker_biggest_x4');

		userMarkerFadeOut = 100;
		AddTimer('userMarkerFadeOut', 0.01 , true);

		GetACSStorage().acs_deleteOnelinerByTag("ACS_User_Distance_GUI_Marker");

		if (ACS_Guiding_Light_User_Marker_Distance_Available)
		{
			ACS_Guiding_Light_User_Marker_Distance_Available = false;
		}

		if (ACS_Guiding_Light_User_Pin_Marker_Stopped)
		{
			ACS_Guiding_Light_User_Pin_Marker_Stopped = false;
		}
	}

	////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	function FormatCardinalIconPath( icon_path : String ) : string
	{
		return "<img src='img://" + icon_path + "' vspace='" + (7) + "' />&nbsp;";
	}

	////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	private var compassbarAlphaFadeOut : float;
	default compassbarAlphaFadeOut = 100;

	private var compassbarAvailable : bool;

	timer function CompassBarFadeOut(dt : float , id : int)
	{	
		GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Compass_Bar_1", compassbarAlphaFadeOut);

		GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Compass_Bar_2", compassbarAlphaFadeOut);

		GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Compass_Bar_3", compassbarAlphaFadeOut);

		GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Compass_Bar_Cardinal_North", compassbarAlphaFadeOut);

		GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Compass_Bar_Cardinal_South", compassbarAlphaFadeOut);

		GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Compass_Bar_Cardinal_East", compassbarAlphaFadeOut);

		GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Compass_Bar_Cardinal_West", compassbarAlphaFadeOut);

		GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Compass_Bar_Cardinal_NorthEast", compassbarAlphaFadeOut);

		GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Compass_Bar_Cardinal_NorthWest", compassbarAlphaFadeOut);

		GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Compass_Bar_Cardinal_SouthEast", compassbarAlphaFadeOut);

		GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Compass_Bar_Cardinal_SouthWest", compassbarAlphaFadeOut);

		if (compassbarAlphaFadeOut <= 0)
		{
			compassbarAlphaFadeOut = 100;

			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Compass_Bar_1", 100);
			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Compass_Bar_2", 100);
			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Compass_Bar_3", 100);

			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Compass_Bar_Cardinal_North", 100);
			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Compass_Bar_Cardinal_South", 100);
			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Compass_Bar_Cardinal_East", 100);
			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Compass_Bar_Cardinal_West", 100);
			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Compass_Bar_Cardinal_NorthEast", 100);
			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Compass_Bar_Cardinal_NorthWest", 100);
			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Compass_Bar_Cardinal_SouthEast", 100);
			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Compass_Bar_Cardinal_SouthWest", 100);

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Compass_Bar_1");
			GetACSStorage().acs_deleteOnelinerByTag("ACS_Compass_Bar_2");
			GetACSStorage().acs_deleteOnelinerByTag("ACS_Compass_Bar_3");

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Compass_Bar_Cardinal_North");
			GetACSStorage().acs_deleteOnelinerByTag("ACS_Compass_Bar_Cardinal_South");
			GetACSStorage().acs_deleteOnelinerByTag("ACS_Compass_Bar_Cardinal_East");
			GetACSStorage().acs_deleteOnelinerByTag("ACS_Compass_Bar_Cardinal_West");
			GetACSStorage().acs_deleteOnelinerByTag("ACS_Compass_Bar_Cardinal_NorthEast");
			GetACSStorage().acs_deleteOnelinerByTag("ACS_Compass_Bar_Cardinal_NorthWest");
			GetACSStorage().acs_deleteOnelinerByTag("ACS_Compass_Bar_Cardinal_SouthEast");
			GetACSStorage().acs_deleteOnelinerByTag("ACS_Compass_Bar_Cardinal_SouthWest");

			ACSGetCEntity('ACS_Compass_Bar_Entity').Destroy();
			ACSGetCEntity('ACS_Compass_Bar_Cardinal_North_Entity').Destroy();
			ACSGetCEntity('ACS_Compass_Bar_Cardinal_South_Entity').Destroy();
			ACSGetCEntity('ACS_Compass_Bar_Cardinal_East_Entity').Destroy();
			ACSGetCEntity('ACS_Compass_Bar_Cardinal_West_Entity').Destroy();

			ACSGetCEntity('ACS_Compass_Bar_Cardinal_NorthEast_Entity').Destroy();
			ACSGetCEntity('ACS_Compass_Bar_Cardinal_NorthWest_Entity').Destroy();
			ACSGetCEntity('ACS_Compass_Bar_Cardinal_SouthEast_Entity').Destroy();
			ACSGetCEntity('ACS_Compass_Bar_Cardinal_SouthWest_Entity').Destroy();

			RemoveTimer('CompassBarFadeOut');
		}
		else
		{
			compassbarAlphaFadeOut -= 1;
		}
	}

	////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	var ACS_Posture_Bar_Vanilla_Despawn_Activate : bool;

	var ACS_Grey_Health_Bar_Vanilla_Despawn_Activate : bool;

	function AdditionalStatBarControl( bar_name : name )
	{
		var iconPath_background_bar														: String;
		var iconPath_posture, iconPath_greyhealth										: String;

		if (bar_name == 'posture_bar')
		{
			if ( theGame.IsDialogOrCutscenePlaying() 
			|| theGame.IsFading()
			|| theGame.IsBlackscreen()
			|| theGame.IsPaused() 
			|| theGame.GetPhotomodeEnabled() 
			|| thePlayer.IsInCutsceneIntro() 
			|| thePlayer.IsUsingHorse()
			|| thePlayer.IsUsingVehicle()
			//|| !ACS_Settings_Main_Bool('acs_hud_settings_main','acs_wolfs_head_hud_module_enabled', false)
			|| !HudSettingsCheck('EnemyFocusModule')
			)
			{
				RemoveTimer('FadeInPostureBarVanilla');
				RemoveTimer('FadeOutPostureBarVanilla');

				if (ACS_Posture_Bar_Vanilla_Despawn_Activate)
				{
					ACS_Posture_Bar_Vanilla_Despawn_Activate = false;
				}

				posture_bars_alpha = 0;

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Posture_Bar_Background_Vanilla");

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Posture_Bar_Vanilla");

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Posture_Bar_Vanilla_Max_Indicator");

				return;
			}

			if(thePlayer.acs_player_posture > 0
			)
			{
				if (!ACS_Posture_Bar_Vanilla_Despawn_Activate)
				{
					RemoveTimer('FadeInPostureBarVanilla');
					RemoveTimer('FadeOutPostureBarVanilla');

					GetACSStorage().acs_deleteOnelinerByTag("ACS_Posture_Bar_Background_Vanilla");

					GetACSStorage().acs_deleteOnelinerByTag("ACS_Posture_Bar_Vanilla");

					GetACSStorage().acs_deleteOnelinerByTag("ACS_Posture_Bar_Vanilla_Max_Indicator");

					iconPath_background_bar = "<img src='img://" + "icons/inventory/acs_background_bar.xbm" + "' vspace='" + (1) + "' />&nbsp;";

					iconPath_posture = "<img src='img://" + "icons/inventory/acs_poise_bar.xbm" + "' vspace='" + (1) + "' />&nbsp;";

					iconPath_greyhealth = "<img src='img://" + "icons/inventory/acs_rally_health_bar.xbm" + "' vspace='" + (1) + "' />&nbsp;";

		
					ACS_Oneliner(
					iconPath_background_bar
					, 
					, 
					"ACS_Posture_Bar_Background_Vanilla"
					, 
					, 
					,
					,
					,
					,
					,
					,true,Vector(0.5, 1));

					GetACSStorage().acs_setScaleForOnelinerByTag("ACS_Posture_Bar_Background_Vanilla", 300, 75, 50);

					GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Posture_Bar_Background_Vanilla", 0);

					GetACSStorage().acs_setRotationForOnelinerByTag("ACS_Posture_Bar_Background_Vanilla", 0);


					ACS_Oneliner(
					iconPath_greyhealth
					, 
					, 
					"ACS_Posture_Bar_Vanilla_Max_Indicator"
					, 
					, 
					,
					,
					,
					,
					,
					,true,Vector(0.5, 1)).run_indicator('player_posture_bar_vanilla_max_indicator');

					GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Posture_Bar_Vanilla_Max_Indicator", 0);



					ACS_Oneliner(
					iconPath_posture
					, 
					, 
					"ACS_Posture_Bar_Vanilla"
					, 
					, 
					,
					,
					,
					,
					,
					,true,Vector(0.5, 1)).run_indicator('player_posture_bar_vanilla_indicator');

					GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Posture_Bar_Vanilla", 0);



					AddTimer('FadeInPostureBarVanilla', 0.01, true);

					ACS_Posture_Bar_Vanilla_Despawn_Activate = true;
				}
			}
			else
			{
				if (ACS_Posture_Bar_Vanilla_Despawn_Activate)
				{
					posture_bars_alpha = 75;

					RemoveTimer('FadeInPostureBarVanilla');
					RemoveTimer('FadeOutPostureBarVanilla');
					AddTimer('FadeOutPostureBarVanilla', 0.01, true);

					ACS_Posture_Bar_Vanilla_Despawn_Activate = false;
				}
			}
		}

		if (bar_name == 'grey_health_bar')
		{
			if ( theGame.IsDialogOrCutscenePlaying() 
			|| theGame.IsFading()
			|| theGame.IsBlackscreen()
			|| theGame.IsPaused() 
			|| theGame.GetPhotomodeEnabled() 
			|| thePlayer.IsInCutsceneIntro() 
			|| thePlayer.IsUsingHorse()
			|| thePlayer.IsUsingVehicle()
			|| !ACS_Settings_Main_Bool('acs_hud_settings_main','acs_wolfs_head_hud_module_enabled', false)
			|| !HudSettingsCheck('EnemyFocusModule')
			)
			{
				RemoveTimer('FadeInGreyHealthBarVanilla');
				RemoveTimer('FadeOutGreyHealthBarVanilla');

				if (ACS_Grey_Health_Bar_Vanilla_Despawn_Activate)
				{
					ACS_Grey_Health_Bar_Vanilla_Despawn_Activate = false;
				}

				grey_health_bars_alpha = 0;

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Grey_Health_Bar_Background_Vanilla");

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Grey_Health_Bar_Vanilla");

				return;
			}

			if(thePlayer.acs_grey_health_current > 0
			)
			{
				if (!ACS_Grey_Health_Bar_Vanilla_Despawn_Activate)
				{
					RemoveTimer('FadeInGreyHealthBarVanilla');
					RemoveTimer('FadeOutGreyHealthBarVanilla');
		
					GetACSStorage().acs_deleteOnelinerByTag("ACS_Grey_Health_Bar_Background_Vanilla");

					GetACSStorage().acs_deleteOnelinerByTag("ACS_Grey_Health_Bar_Vanilla");

					iconPath_background_bar = "<img src='img://" + "icons/inventory/acs_background_bar.xbm" + "' vspace='" + (1) + "' />&nbsp;";

					iconPath_greyhealth = "<img src='img://" + "icons/inventory/acs_rally_health_bar.xbm" + "' vspace='" + (1) + "' />&nbsp;";

					ACS_Oneliner(
					iconPath_background_bar
					, 
					, 
					"ACS_Grey_Health_Bar_Background_Vanilla"
					, 
					, 
					,
					,
					,
					,
					,
					,true,Vector(0.5, 0.95));

					GetACSStorage().acs_setScaleForOnelinerByTag("ACS_Grey_Health_Bar_Background_Vanilla", 250, 75, 50);

					GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Grey_Health_Bar_Background_Vanilla", 0);

					GetACSStorage().acs_setRotationForOnelinerByTag("ACS_Grey_Health_Bar_Background_Vanilla", 0);



					ACS_Oneliner(
					iconPath_greyhealth
					, 
					, 
					"ACS_Grey_Health_Bar_Vanilla"
					, 
					, 
					,
					,
					,
					,
					,
					,true,Vector(0.5, 0.95)).run_indicator('grey_health_bar_vanilla_indicator');

					GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Grey_Health_Bar_Vanilla", 0);

					GetACSStorage().acs_setRotationForOnelinerByTag("ACS_Grey_Health_Bar_Vanilla", 0);



					AddTimer('FadeInGreyHealthBarVanilla', 0.01, true);

					ACS_Grey_Health_Bar_Vanilla_Despawn_Activate = true;
				}
			}
			else
			{
				if (ACS_Grey_Health_Bar_Vanilla_Despawn_Activate)
				{
					grey_health_bars_alpha = 75;

					RemoveTimer('FadeInGreyHealthBarVanilla');

					RemoveTimer('FadeOutGreyHealthBarVanilla');

					AddTimer('FadeOutGreyHealthBarVanilla', 0.01, true);

					ACS_Grey_Health_Bar_Vanilla_Despawn_Activate = false;
				}
			}
		}
	}

	var grey_health_bars_alpha : float;

	default grey_health_bars_alpha = 0;

	var posture_bars_alpha : float;

	default posture_bars_alpha = 0;

	timer function FadeOutPostureBarVanilla( delta : float , id : int)
	{
		if (posture_bars_alpha <= 0)
		{
			GetACSStorage().acs_deleteOnelinerByTag("ACS_Posture_Bar_Background_Vanilla");

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Posture_Bar_Vanilla");

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Posture_Bar_Vanilla_Max_Indicator");

			RemoveTimer('FadeOutPostureBarVanilla');
		}
		else
		{
			posture_bars_alpha -= 1;

			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Posture_Bar_Background_Vanilla", posture_bars_alpha);

			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Posture_Bar_Vanilla", posture_bars_alpha);

			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Posture_Bar_Vanilla_Max_Indicator", posture_bars_alpha);
		}
	}

	timer function FadeInPostureBarVanilla( delta : float , id : int)
	{
		if (posture_bars_alpha >= 75)
		{
			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Posture_Bar_Background_Vanilla", 75);

			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Posture_Bar_Vanilla", 75);

			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Posture_Bar_Vanilla_Max_Indicator", 75);

			RemoveTimer('posture_bars_alpha');
		}
		else
		{
			posture_bars_alpha += 1;

			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Posture_Bar_Background_Vanilla", posture_bars_alpha);

			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Posture_Bar_Vanilla", posture_bars_alpha);

			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Posture_Bar_Vanilla_Max_Indicator", posture_bars_alpha);
		}
	}

	timer function FadeOutGreyHealthBarVanilla( delta : float , id : int)
	{
		if (grey_health_bars_alpha <= 0)
		{
			GetACSStorage().acs_deleteOnelinerByTag("ACS_Grey_Health_Bar_Background_Vanilla");

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Grey_Health_Bar_Vanilla");

			RemoveTimer('FadeOutGreyHealthBarVanilla');
		}
		else
		{
			grey_health_bars_alpha -= 1;

			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Grey_Health_Bar_Background_Vanilla", grey_health_bars_alpha);

			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Grey_Health_Bar_Vanilla", grey_health_bars_alpha);
		}
	}

	timer function FadeInGreyHealthBarVanilla( delta : float , id : int)
	{
		if (grey_health_bars_alpha >= 75)
		{
			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Grey_Health_Bar_Background_Vanilla", 75);

			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Grey_Health_Bar_Vanilla", 75);

			RemoveTimer('FadeInGreyHealthBarVanilla');
		}
		else
		{
			grey_health_bars_alpha += 1;

			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Grey_Health_Bar_Background_Vanilla", grey_health_bars_alpha);

			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Grey_Health_Bar_Vanilla", grey_health_bars_alpha);
		}
	}

	////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	var ACS_Compas_Bar_Despawn_Activate : bool;

	function Guiding_Light_Compass_Bar_Display()
	{
		var entCompass, ent_north, ent_south, ent_east, ent_west, ent_northEast, ent_northWest, ent_southEast, ent_southWest													: CEntity;
		var tempCompass																																							: CEntityTemplate;
		var targetpos, northPos, southPos, eastPos, westPos, northEastPos, northWestPos, southEastPos, southWestPos																: Vector;
		var hud									        																														: CR4ScriptedHud;
   		var screenMarginX 					  																																	: float; 
   		var screenMarginY 					  																																	: float = 0.000000000125; 
    	var currentWidth, currentHeight 																																		: int;
		var ratio, compass_x_size                      																															: float;

		if ( theGame.IsDialogOrCutscenePlaying() 
		|| theGame.IsFading()
		|| theGame.IsBlackscreen()
		|| theGame.IsPaused() 
		|| theGame.GetPhotomodeEnabled() 
		|| thePlayer.IsInCutsceneIntro() 
		|| ACS_Settings_Main_Float('acs_hud_settings_markers','acs_compass_or_floating_3d_markers', 0) == 1
		|| ACS_Settings_Main_Float('acs_hud_settings_markers','acs_compass_bar_despawn_delay', 7) == 0
		)
		{
			RemoveTimer('CompassBarDespawnDelay');

			if (ACS_Compas_Bar_Despawn_Activate)
			{
				ACS_Compas_Bar_Despawn_Activate = false;
			}

			if(ACSGetCEntity('ACS_Compass_Bar_Cardinal_North_Entity')
			)
			{
				GetACSStorage().acs_deleteOnelinerByTag("ACS_Compass_Bar_Cardinal_North");
				ACSGetCEntity('ACS_Compass_Bar_Cardinal_North_Entity').Destroy();
			}

			if(ACSGetCEntity('ACS_Compass_Bar_Cardinal_South_Entity')
			)
			{
				GetACSStorage().acs_deleteOnelinerByTag("ACS_Compass_Bar_Cardinal_South");
				ACSGetCEntity('ACS_Compass_Bar_Cardinal_South_Entity').Destroy();
			}

			if(ACSGetCEntity('ACS_Compass_Bar_Cardinal_East_Entity')
			)
			{
				GetACSStorage().acs_deleteOnelinerByTag("ACS_Compass_Bar_Cardinal_East");
				ACSGetCEntity('ACS_Compass_Bar_Cardinal_East_Entity').Destroy();
			}

			if(ACSGetCEntity('ACS_Compass_Bar_Cardinal_West_Entity')
			)
			{
				GetACSStorage().acs_deleteOnelinerByTag("ACS_Compass_Bar_Cardinal_West");
				ACSGetCEntity('ACS_Compass_Bar_Cardinal_West_Entity').Destroy();
			}

			if(ACSGetCEntity('ACS_Compass_Bar_Cardinal_NorthEast_Entity')
			)
			{
				GetACSStorage().acs_deleteOnelinerByTag("ACS_Compass_Bar_Cardinal_NorthEast");
				ACSGetCEntity('ACS_Compass_Bar_Cardinal_NorthEast_Entity').Destroy();
			}

			if(ACSGetCEntity('ACS_Compass_Bar_Cardinal_NorthWest_Entity')
			)
			{
				GetACSStorage().acs_deleteOnelinerByTag("ACS_Compass_Bar_Cardinal_NorthWest");
				ACSGetCEntity('ACS_Compass_Bar_Cardinal_NorthWest_Entity').Destroy();
			}

			if(ACSGetCEntity('ACS_Compass_Bar_Cardinal_SouthEast_Entity')
			)
			{
				GetACSStorage().acs_deleteOnelinerByTag("ACS_Compass_Bar_Cardinal_SouthEast");
				ACSGetCEntity('ACS_Compass_Bar_Cardinal_SouthEast_Entity').Destroy();
			}

			if(ACSGetCEntity('ACS_Compass_Bar_Cardinal_SouthWest_Entity')
			)
			{
				GetACSStorage().acs_deleteOnelinerByTag("ACS_Compass_Bar_Cardinal_SouthWest");
				ACSGetCEntity('ACS_Compass_Bar_Cardinal_SouthWest_Entity').Destroy();
			}

			if(ACSGetCEntity('ACS_Compass_Bar_Entity')
			)
			{
				GetACSStorage().acs_deleteOnelinerByTag("ACS_Compass_Bar_1");
				GetACSStorage().acs_deleteOnelinerByTag("ACS_Compass_Bar_2");
				GetACSStorage().acs_deleteOnelinerByTag("ACS_Compass_Bar_3");
				ACSGetCEntity('ACS_Compass_Bar_Entity').Destroy();
			}

			compassbarAvailable = false;

			return;
		}

		targetpos = theCamera.GetCameraPosition() + VecFromHeading(theCamera.GetCameraHeading()) * 10;

		northPos = thePlayer.GetWorldPosition() + Vector(0,100000,0);

		southPos = thePlayer.GetWorldPosition() + Vector(0,-100000,0);

		eastPos = thePlayer.GetWorldPosition() + Vector(100000,0,0);

		westPos = thePlayer.GetWorldPosition() + Vector(-100000,0,0);

		northEastPos = thePlayer.GetWorldPosition() + Vector(100000,100000,0);

		northWestPos = thePlayer.GetWorldPosition() + Vector(-100000,100000,0);

		southEastPos = thePlayer.GetWorldPosition() + Vector(100000,-100000,0);

		southWestPos = thePlayer.GetWorldPosition() + Vector(-100000,-100000,0);
	
		if(RadialMenuCheck()
		|| HudExceptionCheck() 
		|| ACS_GetNearbyEnemyLocation() != Vector(0,0,-200)
		|| ACS_MapPinsCheck()
		|| thePlayer.IsAnyWeaponHeld()
		)
		{
			tempCompass = (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\fx\guiding_light_marker_old.w2ent", true );

			if(!ACSGetCEntity('ACS_Compass_Bar_Entity')
			)
			{
				entCompass = (CEntity)theGame.CreateEntity( tempCompass, thePlayer.GetWorldPosition() + thePlayer.GetWorldForward() * 10, thePlayer.GetWorldRotation() );

				entCompass.AddTag('ACS_HUD_Marker_Entity');

				entCompass.AddTag('ACS_Compass_Bar_Entity');

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Compass_Bar_1");

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Compass_Bar_2");

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Compass_Bar_3");

				ACS_Oneliner(FormatCompassBarPath_1("icons/inventory/acs_compass_bar_1.xbm", "icons/inventory/acs_compass_bar_3.xbm" ,"icons/inventory/acs_compass_bar_2.xbm"), ACSGetCEntity('ACS_Compass_Bar_Entity'), "ACS_Compass_Bar_1").run_indicator('compass_bar');

				ACS_Oneliner(FormatCompassBarPath_2("icons/inventory/acs_compass_bar_1.xbm", "icons/inventory/acs_compass_bar_3.xbm" ,"icons/inventory/acs_compass_bar_2.xbm"), ACSGetCEntity('ACS_Compass_Bar_Entity'), "ACS_Compass_Bar_2").run_indicator('compass_bar');

				ACS_Oneliner(FormatCompassBarPath_1("icons/inventory/acs_compass_bar_1.xbm", "icons/inventory/acs_compass_bar_3.xbm" ,"icons/inventory/acs_compass_bar_2.xbm"), ACSGetCEntity('ACS_Compass_Bar_Entity'), "ACS_Compass_Bar_3").run_indicator('compass_bar');
			}
			else
			{
				(ACSGetCEntity('ACS_Compass_Bar_Entity')).TeleportWithRotation(targetpos, thePlayer.GetWorldRotation());
			}

			if(!ACSGetCEntity('ACS_Compass_Bar_Cardinal_North_Entity')
			)
			{
				ent_north = (CEntity)theGame.CreateEntity( tempCompass, northPos );


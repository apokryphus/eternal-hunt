		actors = ACSGetCActor('ACS_Transformation_Werewolf').GetNPCsAndPlayersInCone(attackRange, VecHeading(ACSGetCActor('ACS_Transformation_Werewolf').GetHeadingVector()), attackAngle, 20, , FLAG_ExcludePlayer + FLAG_OnlyAliveActors );


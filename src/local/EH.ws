	function Transformation_Giant_Light_Combo_Attack()
	{
		transformation_giant_light_attack_index_2 = RandDifferent(this.previous_transformation_giant_light_attack_index_2 , 18);

		switch (transformation_giant_light_attack_index_2) 
		{
			case 17:
			TransformationGiantAnchorSwitch(true, false, 0.1);
			ACSTransformationGiantPlayAnim( 'giant_combat_anchor_attack_far_fr_acs_ice_giant', 0.25f, 0.325f);
			break;

			case 16:
			TransformationGiantAnchorSwitch(true, false, 0.1);
			ACSTransformationGiantPlayAnim( 'giant_combat_anchor_attack_far_fl_acs_ice_giant', 0.25f, 0.325f);
			break;

			case 15:

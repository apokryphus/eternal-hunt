	///////////////////////////////////////////////////////////////////////////////////////////////////


	public timer function MinimapModuleDespawnDelay ( dt : float, id : int)
	{
		var module: CR4HudModuleBase;
		module = (CR4HudModuleBase)((CR4ScriptedHud)theGame.GetHud()).GetHudModule("Minimap2Module");

		if (!HudSettingsCheck('Minimap2Module') && module.GetEnabled())
		{
			minimapAlphaMin = 0;
			minimapAlphaMinProcess = false;
			RemoveTimer('MinimapModuleFadeFlashObjectIn');
			RemoveTimer('MinimapModuleFadeFlasOhbjectOut');
			AddTimer('MinimapModuleFadeFlashObjectOut', 0.01 , true);
			((CR4ScriptedHud)theGame.GetHud()).UpdateHUD();
		}
	}

	public timer function QuestModuleDespawnDelay ( dt : float, id : int)
	{
		var module: CR4HudModuleBase;
		module = (CR4HudModuleBase)((CR4ScriptedHud)theGame.GetHud()).GetHudModule("QuestsModule");

		if (!HudSettingsCheck('QuestsModule') && module.GetEnabled())
		{
			questAlphaMin = 0;
			questAlphaMinProcess = false;
			RemoveTimer('QuestModuleFadeFlashObjectIn');
			RemoveTimer('QuestModuleFadeFlashObjectOut');
			AddTimer('QuestModuleFadeFlashObjectOut', 0.01 , true);
			((CR4ScriptedHud)theGame.GetHud()).UpdateHUD();
		}
	}


	function PerformKick()
	{
		if (!ACS_Settings_Main_Bool('acs_parry_skills_settings','acs_parry_skills_enabled', true))
		{
			return;
		}

		if (ACS_New_Replacers_Female_Active())
		{
			return;
		}

		if( ParrySkillCallTime + DOUBLE_TAP_WINDOW_DODGE >= theGame.GetEngineTimeAsSeconds() )
		{
			ParrySkillDoubleTap = true;
		}
		else
		{
			ParrySkillDoubleTap = false;	
		}

		if ( !thePlayer.HasTag('acs_in_wraith') )
		{
			if ( ACS_Settings_Main_Bool('acs_stamina_settings','acs_stamina_block_action', false) 
			&& StaminaCheck('default')
			)
			{							 
				RemoveTimer('SwordTauntSwitch'); RemoveTimer('SwordTauntRunningSwitch');   if (thePlayer.HasTag('ACS_IsSwordWalking')){thePlayer.RemoveTag('ACS_IsSwordWalking');} if(thePlayer.IsInCombat()){if(thePlayer.GetCombatIdleStance() <= 0.f ){thePlayer.RaiseEvent('ACS_CombatTauntLeft');}else{thePlayer.RaiseEvent('ACS_CombatTauntRight');}} thePlayer.SoundEvent("gui_no_stamina");
			}
			else
			{
				if( ParrySkillDoubleTap )
				{
					if (ACS_can_perform_parry_skill_doubletap())
					{
						ACS_refresh_parry_skill_doubletap_cooldown();

						finisherActorTarget = (CActor)( thePlayer.GetTarget() );	
						ccomp = finisherActorTarget.GetComponent("Finish");
						ccompEnabled = ccomp.IsEnabled();

						if (
						ccompEnabled
						//&& ACS_AttitudeCheck (finisherActorTarget) 
						&& VecDistanceSquared2D( thePlayer.GetWorldPosition(), finisherActorTarget.GetNearestPointInBothPersonalSpaces( thePlayer.GetWorldPosition() ) ) < 2.75f * 2.75f
						)
						{
							ACS_Setup_Light_Attack_Internal();
						}
						else
						{
							if (thePlayer.HasTag('acs_axii_sword_equipped'))
							{
								RemoveTimer('ACS_Shield_Spawn_Delay');

								AddTimer('ACS_Shield_Spawn_Delay', 0.5 , false);
							}
																			
							Attack_Process_02('geraltRandomKick');

							ACS_StaminaDrain(1);

							RemoveTimer('ACS_Shout');

							RemoveTimer('ACS_Blood_Spray');

							thePlayer.AddTag('ACS_Player_Is_Attacking');

							RemoveTimer('RemovePlayerIsAttackingTag');

							AddTimer('RemovePlayerIsAttackingTag', 0.5 , false );

							AddTimer('ACS_KickDamage', 0.4 , false);
						}
					}
				}
		
				ParrySkillCallTime = theGame.GetEngineTimeAsSeconds();
			}
		}
	}

	var vACS_Beam_Attack : cACS_Beam_Attack;

	var vACS_TK : cACS_TK;

	

	function ACS_Setup_Light_Attack_Internal()
	{
		if ( ACS_Settings_Main_Bool('acs_stamina_settings','acs_stamina_block_action', false) 
		&& StaminaCheck('default')
		)
		{							 
			RemoveTimer('SwordTauntSwitch'); RemoveTimer('SwordTauntRunningSwitch');   if (thePlayer.HasTag('ACS_IsSwordWalking')){thePlayer.RemoveTag('ACS_IsSwordWalking');} if(thePlayer.IsInCombat()){if(thePlayer.GetCombatIdleStance() <= 0.f ){thePlayer.RaiseEvent('ACS_CombatTauntLeft');}else{thePlayer.RaiseEvent('ACS_CombatTauntRight');}} thePlayer.SoundEvent("gui_no_stamina");
			
			return;
		}

		vACS_Setup_Combat_Action_Vanilla = new cACS_Setup_Combat_Action_Vanilla in this; 

		vACS_Setup_Combat_Action_Vanilla.Setup_Combat_Action_Light_Engage();
	}

	function ACS_Setup_Heavy_Attack_Internal()
	{
		if ( ACS_Settings_Main_Bool('acs_stamina_settings','acs_stamina_block_action', false) 
		&& StaminaCheck('default')
		)
		{							 
			RemoveTimer('SwordTauntSwitch'); RemoveTimer('SwordTauntRunningSwitch');   if (thePlayer.HasTag('ACS_IsSwordWalking')){thePlayer.RemoveTag('ACS_IsSwordWalking');} if(thePlayer.IsInCombat()){if(thePlayer.GetCombatIdleStance() <= 0.f ){thePlayer.RaiseEvent('ACS_CombatTauntLeft');}else{thePlayer.RaiseEvent('ACS_CombatTauntRight');}} thePlayer.SoundEvent("gui_no_stamina");
			
			return;
		}
		
		vACS_Setup_Combat_Action_Vanilla = new cACS_Setup_Combat_Action_Vanilla in this; 

		vACS_Setup_Combat_Action_Vanilla.Setup_Combat_Action_Heavy_Engage();
	}

	

	var light_attack_combo_chain_counter					: float;
	var heavy_attack_combo_chain_counter 					: float;
	
	defaults
    {
        light_attack_combo_chain_counter = 0;

		heavy_attack_combo_chain_counter = 0;
    } 

	timer function ResetComboCounter(dt:float,id:int)
	{
		light_attack_combo_chain_counter = 0;

		heavy_attack_combo_chain_counter = 0;
	}

	
	
	function FistAttackSwitch()
	{
		var targetDistance 													: float;
		var distance														: float;
		var finisher_anim_names												: array< name >;

		if (ACS_New_Replacers_Female_Active())
		{
			ACS_Setup_Light_Attack_Internal();
			return;
		}

		if (!thePlayer.HasTag('ACS_IsPerformingFinisher')
		&& !thePlayer.HasTag('ACS_IsPerformingCombatDismember')
		&& !thePlayer.IsCrossbowHeld()
		&& ACS_BuffCheck()
		&& !thePlayer.HasTag('acs_in_wraith')
		&& !thePlayer.HasTag('ACS_Bruxa_Bite_Process')
		&& !thePlayer.IsInHitAnim()
		)
		{
			DeactivateThings();

			ACS_ThingsThatShouldBeRemoved();

			if (thePlayer.HasTag('ACS_IsSwordWalking'))
			{
				thePlayer.RemoveTag('ACS_IsSwordWalking');
			}

			RemoveTimer('SwordTauntSwitch'); 
			RemoveTimer('SwordTauntRunningSwitch'); 
			 
			if ( thePlayer.inv.IsItemCrossbow( thePlayer.inv.GetItemFromSlot( 'l_weapon' ) ) )
			{
				thePlayer.OnRangedForceHolster(false, true, false);
			}

			targetDistance = VecDistanceSquared2D( thePlayer.GetWorldPosition(), ((CNewNPC)(thePlayer.GetTarget())).GetWorldPosition() );

			if (((CMovingPhysicalAgentComponent)(((CNewNPC)(thePlayer.GetTarget())).GetMovingAgentComponent())).GetCapsuleHeight() >= 2
			|| ((CNewNPC)(thePlayer.GetTarget())).GetRadius() >= 0.7
			|| ((CNewNPC)(thePlayer.GetTarget())).HasAbility('Boss')
			|| ((CNewNPC)(thePlayer.GetTarget())).HasTag('IsBoss')
			|| ((CNewNPC)(thePlayer.GetTarget())).HasTag('ACS_Big_Boi')
			)
			{
				distance = 5;
			}
			else
			{
				distance = 3.5;
			}

			if (
			thePlayer.HasTag('ACS_Is_Sneaking')
			&& ACS_IS_SNEAKING
			&& ((CNewNPC)(thePlayer.GetTarget())).HasTag('ACS_Counter_Wound_Ready')
			&& ((CNewNPC)(thePlayer.GetTarget())).IsAlive()
			&& ((CNewNPC)(thePlayer.GetTarget())).GetCurrentHealth() > 0.01
			&& ((CNewNPC)(thePlayer.GetTarget())).acs_backstab_wound_fx
			&& targetDistance <= distance * distance
			)
			{
				if( 
				stab_hostage_enabled
				&& ACSGetCActor('ACS_Stab_Hostage')
				&& ACSGetCActor('ACS_Stab_Hostage').IsAlive()
				)
				{
					ReleaseStabHostage();

					RemoveTimer('ACS_Stab_Hostage_Process');

					((CNewNPC)(thePlayer.GetTarget())).RemoveTag('ACS_Counter_Wound_Ready');

					((CNewNPC)(thePlayer.GetTarget())).acs_backstab_wound_fx.AddTag('ACS_Counter_Wound_Disable');

					ACS_SetupSyncAnimInternalCounterWound(thePlayer, ((CNewNPC)(thePlayer.GetTarget())));
					
					return;
				}

				if( 
				StabHostageCheck()
				)
				{
					thePlayer.ACS_ClearAnimationSpeedMultipliers();

					thePlayer.RaiseEvent('ACS_StabHostageEnter03');
				}
				else
				{
					ReleaseStabHostage();

					RemoveTimer('ACS_Stab_Hostage_Process');

					((CNewNPC)(thePlayer.GetTarget())).RemoveTag('ACS_Counter_Wound_Ready');

					if ( ACS_Vampire_Claws_Access() )
					{
						action_interrupt();

						thePlayer.RemoveTag('ACS_Manual_Combat_Control');

					
						thePlayer.DestroyEffect( 'bruxa_dash_trails' );
						thePlayer.PlayEffectSingle( 'bruxa_dash_trails' );
						thePlayer.StopEffect( 'bruxa_dash_trails' );

						thePlayer.DestroyEffect('shadowdash_shockwave');
						thePlayer.PlayEffectSingle('shadowdash_shockwave');
						thePlayer.StopEffect('shadowdash_shockwave');

						thePlayer.DestroyEffect('shadowdash_short');
						thePlayer.PlayEffectSingle('shadowdash_short');
						thePlayer.StopEffect('shadowdash_short');

						finisher_anim_names.Clear();

						finisher_anim_names.PushBack('bruxa_attack_bite_front_lp_bruxa_ACS');
						finisher_anim_names.PushBack('bruxa_attack_bite_front_rp_bruxa_ACS');
						finisher_anim_names.PushBack('bruxa_attack_bite_back_lp_bruxa_ACS');
						finisher_anim_names.PushBack('bruxa_attack_bite_back_rp_bruxa_ACS');

						if (combatTarget.IsHuman())
						{
							ACS_SetupSyncAnimInternalHumanBruxaBite(finisher_anim_names[RandRange(finisher_anim_names.Size())], thePlayer, ((CNewNPC)(thePlayer.GetTarget())) );

							return;
						}
						else
						{
							ACS_SetupSyncAnimInternalMonsterBruxaBite(finisher_anim_names[RandRange(finisher_anim_names.Size())], thePlayer, ((CNewNPC)(thePlayer.GetTarget())) );

							return;
						}
					
					}

					((CNewNPC)(thePlayer.GetTarget())).acs_backstab_wound_fx.AddTag('ACS_Counter_Wound_Disable');

					ACS_SetupSyncAnimInternalCounterWound(thePlayer, ((CNewNPC)(thePlayer.GetTarget())));
				}

				return;
			}

			if (ACS_GetWeaponMode() == 0)
			{
				if (ACS_Settings_Main_Int('acs_combat_main_settings','acs_fist_mode', 0) == 0)
				{
					PrimaryWeaponSwitch();

					NormalFistLightAttack();
				}
				else if (ACS_Settings_Main_Int('acs_combat_main_settings','acs_fist_mode', 0) == 1)
				{
					VampClawLightAttack();
				}
				else if (ACS_Settings_Main_Int('acs_combat_main_settings','acs_fist_mode', 0) == 2)
				{
					PrimaryWeaponSwitch();

					SorcFistLightAttack();
				}
			}
			else if (ACS_GetWeaponMode() == 1)
			{
				if (ACS_Settings_Main_Int('acs_combat_main_settings','acs_fist_mode', 0) == 0)
				{
					PrimaryWeaponSwitch();

					NormalFistLightAttack();
				}
				else if (ACS_Settings_Main_Int('acs_combat_main_settings','acs_fist_mode', 0) == 1)
				{
					VampClawLightAttack();
				}
				else if (ACS_Settings_Main_Int('acs_combat_main_settings','acs_fist_mode', 0) == 2)
				{
					PrimaryWeaponSwitch();

					SorcFistLightAttack();
				}
			}
			else if (ACS_GetWeaponMode() == 2)
			{
				if (ACS_Settings_Main_Int('acs_combat_main_settings','acs_fist_mode', 0) == 0)
				{
					PrimaryWeaponSwitch();

					NormalFistLightAttack();
				}
				else if (ACS_Settings_Main_Int('acs_combat_main_settings','acs_fist_mode', 0) == 1)
				{
					VampClawLightAttack();
				}
				else if (ACS_Settings_Main_Int('acs_combat_main_settings','acs_fist_mode', 0) == 2)
				{
					PrimaryWeaponSwitch();

					SorcFistLightAttack();
				}
			}
			else if (ACS_GetWeaponMode() == 3)
			{
				if (ACS_GetItem_VampClaw('default') || ACS_GetItem_VampClaw('shades'))
				{
					VampClawLightAttack();
				}
				else if (GetWitcherPlayer().IsItemEquippedByName( 'ACS_Mage_Gloves'))
				{
					PrimaryWeaponSwitch();

					SorcFistLightAttack();
				}
				else
				{
					PrimaryWeaponSwitch();

					NormalFistLightAttack();
				}
			}

			light_attack_combo_chain_counter += 1;

			RemoveTimer('ResetComboCounter');

			AddTimer('ResetComboCounter', 4 , false );

			DeactivateThings();

			if ( AnimProgressCheck() )
			{
				if (thePlayer.IsInAir()
				|| thePlayer.IsFalling()
				)
				{
					if( ((CActor)thePlayer.GetTarget()) 
					&& ACS_AttitudeCheck ( ((CActor)thePlayer.GetTarget()) ) 
					&& thePlayer.IsInCombat() 
					&& theGame.GetEngineTimeAsSeconds() - last_air_strike_time > 1
					&& thePlayer.GetStat(BCS_Stamina) > 0
					)
					{
						last_air_strike_time = theGame.GetEngineTimeAsSeconds();

						if (!thePlayer.HasTag('ACS_Air_Time'))
						{
							thePlayer.EnableCollisions(false);

							movementAdjustor = thePlayer.GetMovingAgentComponent().GetMovementAdjustor();
								
							movementAdjustor.CancelAll();

							thePlayer.ACS_ClearAnimationSpeedMultipliers();

							if (thePlayer.IsAnyWeaponHeld() 
							&& !thePlayer.IsWeaponHeld('fist') 
							)
							{
								if(RandF() < 0.5)
								{
									PlayerPlayAnimation('aircollision_fwd_lf_land_sword');
								}
								else
								{
									PlayerPlayAnimation('aircollision_fwd_rf_land_sword');
								}
							}
							else
							{
								PlayerPlayAnimation('slide_trip_01');
							}

							thePlayer.RaiseEvent('ACS_ForceLegsFloatIdle');

							thePlayer.BlockAction( EIAB_CallHorse,			'ACS_Air_Time');
							thePlayer.BlockAction( EIAB_DrawWeapon, 		'ACS_Air_Time');
							thePlayer.BlockAction( EIAB_FastTravel, 		'ACS_Air_Time');
							thePlayer.BlockAction( EIAB_InteractionAction, 	'ACS_Air_Time');
							thePlayer.BlockAction( EIAB_UsableItem,			'ACS_Air_Time');
							thePlayer.BlockAction( EIAB_MeditationWaiting,	'ACS_Air_Time');
							thePlayer.BlockAction( EIAB_OpenMeditation,		'ACS_Air_Time');
							thePlayer.BlockAction( EIAB_RadialMenu,			'ACS_Air_Time');
							thePlayer.BlockAction( EIAB_Movement,			'ACS_Air_Time');
							thePlayer.BlockAction( EIAB_QuickSlots, 		'ACS_Air_Time');

							RemoveTimer('RemoveACSAirTime');
							AddTimer('RemoveACSAirTime', 2 , false);

							thePlayer.AddTag('ACS_Air_Time');
						}

						targetDistance = VecDistanceSquared2D( thePlayer.GetWorldPosition(), ((CActor)thePlayer.GetTarget()).GetWorldPosition() );

						if (targetDistance <= 25 * 25)
						{
							if (targetDistance > 5 * 5)
							{
								thePlayer.DestroyEffect('dodge_acs_armor');
								thePlayer.PlayEffectSingle('dodge_acs_armor');

								thePlayer.DestroyEffect('bruxa_dash_trails');
								thePlayer.PlayEffectSingle('bruxa_dash_trails');

								thePlayer.StopEffect('shadowdash_shockwave');

								thePlayer.PlayEffectSingle('shadowdash_shockwave');

								thePlayer.StopEffect('shadowdash_shockwave');
							}

							MovementAdjust('default');

							movementAdjustor.AdjustmentDuration( ticket, 0.25 );

							movementAdjustor.AdjustLocationVertically( ticket, true );

							movementAdjustor.RotateTowards(ticket, ((CActor)thePlayer.GetTarget()));

							movementAdjustor.SlideTowards( ticket, ((CActor)thePlayer.GetTarget()), distArmorSpecialDash, distArmorSpecialDash );

							ACS_StaminaDrain(1, true);
						}
					}
				}
				else
				{
					if (thePlayer.HasTag('ACS_Air_Time'))
					{
						RemoveTimer('Air_Time_Movement_Adjust_Delay');

						thePlayer.BlockAllActions( 'ACS_Air_Time_Init', false );

						thePlayer.EnableCollisions(true);

						thePlayer.RaiseEvent('ACS_FeetAdditiveEnd');

						thePlayer.UnblockAction( EIAB_CallHorse,			'ACS_Air_Time');
						thePlayer.UnblockAction( EIAB_DrawWeapon, 		'ACS_Air_Time');
						thePlayer.UnblockAction( EIAB_FastTravel, 		'ACS_Air_Time');
						thePlayer.UnblockAction( EIAB_InteractionAction, 	'ACS_Air_Time');
						thePlayer.UnblockAction( EIAB_UsableItem,			'ACS_Air_Time');
						thePlayer.UnblockAction( EIAB_MeditationWaiting,	'ACS_Air_Time');
						thePlayer.UnblockAction( EIAB_OpenMeditation,		'ACS_Air_Time');
						thePlayer.UnblockAction( EIAB_RadialMenu,			'ACS_Air_Time');
						thePlayer.UnblockAction( EIAB_Movement,			'ACS_Air_Time');
						thePlayer.UnblockAction( EIAB_QuickSlots, 		'ACS_Air_Time');

						thePlayer.RemoveTag('ACS_Air_Time');
					}
				}
			}
		}
	}

	

	function FistHeavyAttackSwitch()
	{
		var targetDistance 													: float;
		var selectedItemId 													: SItemUniqueId;
		var distance														: float;
		var finisher_anim_names												: array< name >;

		if (ACS_New_Replacers_Female_Active())
		{
			ACS_Setup_Heavy_Attack_Internal();
			return;
		}

		if (thePlayer.IsActionAllowed(EIAB_HeavyAttacks)
		&& !thePlayer.HasTag('ACS_IsPerformingFinisher')
		&& !thePlayer.HasTag('ACS_IsPerformingCombatDismember')
		&& !thePlayer.IsCrossbowHeld()
		&& ACS_BuffCheck()
		&& !thePlayer.HasTag('acs_in_wraith')
		&& !thePlayer.HasTag('ACS_Bruxa_Bite_Process')
		&& !thePlayer.IsInHitAnim()
		)
		{
			DeactivateThings();

			ACS_ThingsThatShouldBeRemoved_BASE(true); 

			if ( thePlayer.HasTag('ACS_HideWeaponOnDodge') 
			//&& !thePlayer.HasTag('ACS_Bruxa_Bite_Process')
			)
			{
				if (!thePlayer.HasTag('acs_aard_sword_equipped'))
				{
					ACS_Weapon_Respawn();
				}
				
				thePlayer.RemoveTag('ACS_HideWeaponOnDodge');

				thePlayer.RemoveTag('ACS_HideWeaponOnDodge_Claw_Effect');
			}

			ACS_ExplorationDelayHack(false, 3);

			if ( thePlayer.inv.IsItemCrossbow( thePlayer.inv.GetItemFromSlot( 'l_weapon' ) ) )
			{
				thePlayer.OnRangedForceHolster(false, true, false);
			}

			RemoveTimer('ACS_ResetAnimation');
			RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5   , false);

			if (thePlayer.HasTag('ACS_IsSwordWalking'))
			{
				thePlayer.RemoveTag('ACS_IsSwordWalking');
			}

			RemoveTimer('SwordTauntSwitch'); 
			RemoveTimer('SwordTauntRunningSwitch'); 

			targetDistance = VecDistanceSquared2D( thePlayer.GetWorldPosition(), ((CNewNPC)(thePlayer.GetTarget())).GetWorldPosition() );

			if (((CMovingPhysicalAgentComponent)(((CNewNPC)(thePlayer.GetTarget())).GetMovingAgentComponent())).GetCapsuleHeight() >= 2
			|| ((CNewNPC)(thePlayer.GetTarget())).GetRadius() >= 0.7
			|| ((CNewNPC)(thePlayer.GetTarget())).HasAbility('Boss')
			|| ((CNewNPC)(thePlayer.GetTarget())).HasTag('IsBoss')
			|| ((CNewNPC)(thePlayer.GetTarget())).HasTag('ACS_Big_Boi')
			)
			{
				distance = 5;
			}
			else
			{
				distance = 3.5;
			}

			if (
			thePlayer.HasTag('ACS_Is_Sneaking')
			&& ACS_IS_SNEAKING
			&& ((CNewNPC)(thePlayer.GetTarget())).HasTag('ACS_Counter_Wound_Ready')
			&& ((CNewNPC)(thePlayer.GetTarget())).IsAlive()
			&& ((CNewNPC)(thePlayer.GetTarget())).GetCurrentHealth() > 0.01
			&& ((CNewNPC)(thePlayer.GetTarget())).acs_backstab_wound_fx
			&& targetDistance <= distance * distance
			)
			{
				selectedItemId = thePlayer.GetSelectedItemId();

				if(thePlayer.inv.IsItemBomb(selectedItemId))
				{
					thePlayer.inv.SingletonItemRemoveAmmo(selectedItemId, 1);
					
					SneakyPlantBomb(selectedItemId, ((CNewNPC)(thePlayer.GetTarget())));

					return;
				}

				if( 
				stab_hostage_enabled
				&& ACSGetCActor('ACS_Stab_Hostage')
				&& ACSGetCActor('ACS_Stab_Hostage').IsAlive()
				)
				{
					ReleaseStabHostage();

					RemoveTimer('ACS_Stab_Hostage_Process');

					((CNewNPC)(thePlayer.GetTarget())).RemoveTag('ACS_Counter_Wound_Ready');

					((CNewNPC)(thePlayer.GetTarget())).acs_backstab_wound_fx.AddTag('ACS_Counter_Wound_Disable');

					ACS_SetupSyncAnimInternalCounterWound(thePlayer, ((CNewNPC)(thePlayer.GetTarget())));
					
					return;
				}

				if( 
				StabHostageCheck()
				)
				{
					thePlayer.ACS_ClearAnimationSpeedMultipliers();

					thePlayer.RaiseEvent('ACS_StabHostageEnter03');
				}
				else
				{
					ReleaseStabHostage();

					RemoveTimer('ACS_Stab_Hostage_Process');

					((CNewNPC)(thePlayer.GetTarget())).RemoveTag('ACS_Counter_Wound_Ready');

					if ( ACS_Vampire_Claws_Access() )
					{
						action_interrupt();

						thePlayer.RemoveTag('ACS_Manual_Combat_Control');

					
						thePlayer.DestroyEffect( 'bruxa_dash_trails' );
						thePlayer.PlayEffectSingle( 'bruxa_dash_trails' );
						thePlayer.StopEffect( 'bruxa_dash_trails' );

						thePlayer.DestroyEffect('shadowdash_shockwave');
						thePlayer.PlayEffectSingle('shadowdash_shockwave');
						thePlayer.StopEffect('shadowdash_shockwave');

						thePlayer.DestroyEffect('shadowdash_short');
						thePlayer.PlayEffectSingle('shadowdash_short');
						thePlayer.StopEffect('shadowdash_short');

						finisher_anim_names.Clear();

						finisher_anim_names.PushBack('bruxa_attack_bite_front_lp_bruxa_ACS');
						finisher_anim_names.PushBack('bruxa_attack_bite_front_rp_bruxa_ACS');
						finisher_anim_names.PushBack('bruxa_attack_bite_back_lp_bruxa_ACS');
						finisher_anim_names.PushBack('bruxa_attack_bite_back_rp_bruxa_ACS');

						if (combatTarget.IsHuman())
						{
							ACS_SetupSyncAnimInternalHumanBruxaBite(finisher_anim_names[RandRange(finisher_anim_names.Size())], thePlayer, ((CNewNPC)(thePlayer.GetTarget())) );

							return;
						}
						else
						{
							ACS_SetupSyncAnimInternalMonsterBruxaBite(finisher_anim_names[RandRange(finisher_anim_names.Size())], thePlayer, ((CNewNPC)(thePlayer.GetTarget())) );

							return;
						}
					
					}

					((CNewNPC)(thePlayer.GetTarget())).acs_backstab_wound_fx.AddTag('ACS_Counter_Wound_Disable');

					ACS_SetupSyncAnimInternalCounterWound(thePlayer, ((CNewNPC)(thePlayer.GetTarget())), true);
				}

				return;
			}

			if (ACS_GetWeaponMode() == 0)
			{
				if (ACS_Settings_Main_Int('acs_combat_main_settings','acs_fist_mode', 0) == 0)
				{
					PrimaryWeaponSwitch();

					NormalFistHeavyAttack();
				}
				else if (ACS_Settings_Main_Int('acs_combat_main_settings','acs_fist_mode', 0) == 1)
				{
					VampClawHeavyAttack();
				}
				else if (ACS_Settings_Main_Int('acs_combat_main_settings','acs_fist_mode', 0) == 2)
				{
					PrimaryWeaponSwitch();

					SorcFistHeavyAttack();
				}
			}
			else if (ACS_GetWeaponMode() == 1)
			{
				if (ACS_Settings_Main_Int('acs_combat_main_settings','acs_fist_mode', 0) == 0)
				{
					PrimaryWeaponSwitch();

					NormalFistHeavyAttack();
				}
				else if (ACS_Settings_Main_Int('acs_combat_main_settings','acs_fist_mode', 0) == 1)
				{
					VampClawHeavyAttack();
				}
				else if (ACS_Settings_Main_Int('acs_combat_main_settings','acs_fist_mode', 0) == 2)
				{
					PrimaryWeaponSwitch();

					SorcFistHeavyAttack();
				}
			}
			else if (ACS_GetWeaponMode() == 2)
			{
				if (ACS_Settings_Main_Int('acs_combat_main_settings','acs_fist_mode', 0) == 0)
				{
					PrimaryWeaponSwitch();

					NormalFistHeavyAttack();
				}
				else if (ACS_Settings_Main_Int('acs_combat_main_settings','acs_fist_mode', 0) == 1)
				{
					VampClawHeavyAttack();
				}
				else if (ACS_Settings_Main_Int('acs_combat_main_settings','acs_fist_mode', 0) == 2)
				{
					PrimaryWeaponSwitch();

					SorcFistHeavyAttack();
				}
			}
			else if (ACS_GetWeaponMode() == 3)
			{
				if (ACS_GetItem_VampClaw('default') || ACS_GetItem_VampClaw('shades'))
				{
					VampClawHeavyAttack();
				}
				else if (GetWitcherPlayer().IsItemEquippedByName( 'ACS_Mage_Gloves'))
				{
					PrimaryWeaponSwitch();

					SorcFistHeavyAttack();
				}
				else
				{
					PrimaryWeaponSwitch();

					NormalFistHeavyAttack();
				}
			}

			heavy_attack_combo_chain_counter += 1;

			RemoveTimer('ResetComboCounter');

			AddTimer('ResetComboCounter', 4 , false );

			DeactivateThings();

			if ( AnimProgressCheck() )
			{
				if (thePlayer.IsInAir()
				|| thePlayer.IsFalling()
				)
				{
					if( ((CActor)thePlayer.GetTarget()) 
					&& ACS_AttitudeCheck ( ((CActor)thePlayer.GetTarget()) ) 
					&& thePlayer.IsInCombat() 
					&& theGame.GetEngineTimeAsSeconds() - last_air_strike_time > 1
					&& thePlayer.GetStat(BCS_Stamina) > 0
					)
					{
						last_air_strike_time = theGame.GetEngineTimeAsSeconds();

						if (!thePlayer.HasTag('ACS_Air_Time'))
						{
							thePlayer.EnableCollisions(false);

							movementAdjustor = thePlayer.GetMovingAgentComponent().GetMovementAdjustor();
								
							movementAdjustor.CancelAll();

							thePlayer.ACS_ClearAnimationSpeedMultipliers();

							if (thePlayer.IsAnyWeaponHeld() 
							&& !thePlayer.IsWeaponHeld('fist') 
							)
							{
								if(RandF() < 0.5)
								{
									PlayerPlayAnimation('aircollision_fwd_lf_land_sword');
								}
								else
								{
									PlayerPlayAnimation('aircollision_fwd_rf_land_sword');
								}
							}
							else
							{
								PlayerPlayAnimation('slide_trip_01');
							}

							thePlayer.RaiseEvent('ACS_ForceLegsFloatIdle');

							thePlayer.BlockAction( EIAB_CallHorse,			'ACS_Air_Time');
							thePlayer.BlockAction( EIAB_DrawWeapon, 		'ACS_Air_Time');
							thePlayer.BlockAction( EIAB_FastTravel, 		'ACS_Air_Time');
							thePlayer.BlockAction( EIAB_InteractionAction, 	'ACS_Air_Time');
							thePlayer.BlockAction( EIAB_UsableItem,			'ACS_Air_Time');
							thePlayer.BlockAction( EIAB_MeditationWaiting,	'ACS_Air_Time');
							thePlayer.BlockAction( EIAB_OpenMeditation,		'ACS_Air_Time');
							thePlayer.BlockAction( EIAB_RadialMenu,			'ACS_Air_Time');
							thePlayer.BlockAction( EIAB_Movement,			'ACS_Air_Time');
							thePlayer.BlockAction( EIAB_QuickSlots, 		'ACS_Air_Time');

							RemoveTimer('RemoveACSAirTime');
							AddTimer('RemoveACSAirTime', 2 , false);

							thePlayer.AddTag('ACS_Air_Time');
						}

						targetDistance = VecDistanceSquared2D( thePlayer.GetWorldPosition(), ((CActor)thePlayer.GetTarget()).GetWorldPosition() );

						if (targetDistance <= 25 * 25)
						{
							if (targetDistance > 5 * 5)
							{
								thePlayer.DestroyEffect('dodge_acs_armor');
								thePlayer.PlayEffectSingle('dodge_acs_armor');

								thePlayer.DestroyEffect('bruxa_dash_trails');
								thePlayer.PlayEffectSingle('bruxa_dash_trails');

								thePlayer.StopEffect('shadowdash_shockwave');

								thePlayer.PlayEffectSingle('shadowdash_shockwave');

								thePlayer.StopEffect('shadowdash_shockwave');
							}

							MovementAdjust('default');

							movementAdjustor.AdjustmentDuration( ticket, 0.25 );

							movementAdjustor.AdjustLocationVertically( ticket, true );

							movementAdjustor.RotateTowards(ticket, ((CActor)thePlayer.GetTarget()));

							movementAdjustor.SlideTowards( ticket, ((CActor)thePlayer.GetTarget()), distArmorSpecialDash, distArmorSpecialDash );

							ACS_StaminaDrain(1, true);
						}
					}
				}
				else
				{
					if (thePlayer.HasTag('ACS_Air_Time'))
					{
						RemoveTimer('Air_Time_Movement_Adjust_Delay');

						thePlayer.BlockAllActions( 'ACS_Air_Time_Init', false );

						thePlayer.EnableCollisions(true);

						thePlayer.RaiseEvent('ACS_FeetAdditiveEnd');

						thePlayer.UnblockAction( EIAB_CallHorse,			'ACS_Air_Time');
						thePlayer.UnblockAction( EIAB_DrawWeapon, 		'ACS_Air_Time');
						thePlayer.UnblockAction( EIAB_FastTravel, 		'ACS_Air_Time');
						thePlayer.UnblockAction( EIAB_InteractionAction, 	'ACS_Air_Time');
						thePlayer.UnblockAction( EIAB_UsableItem,			'ACS_Air_Time');
						thePlayer.UnblockAction( EIAB_MeditationWaiting,	'ACS_Air_Time');
						thePlayer.UnblockAction( EIAB_OpenMeditation,		'ACS_Air_Time');
						thePlayer.UnblockAction( EIAB_RadialMenu,			'ACS_Air_Time');
						thePlayer.UnblockAction( EIAB_Movement,			'ACS_Air_Time');
						thePlayer.UnblockAction( EIAB_QuickSlots, 		'ACS_Air_Time');

						thePlayer.RemoveTag('ACS_Air_Time');
					}
				}
			}
		}
	}

	

	function LightAttackSwitch()
	{
		var targetDistance 													: float;
		var distance														: float;
		var finisher_anim_names												: array< name >;

		if (ACS_New_Replacers_Female_Active())
		{
			ACS_Setup_Light_Attack_Internal();
			return;
		}

		if ( !thePlayer.IsInHitAnim()
		&& !thePlayer.HasTag('ACS_IsPerformingFinisher')
		&& !thePlayer.HasTag('ACS_IsPerformingCombatDismember')
		&& !thePlayer.IsCrossbowHeld()
		&& ACS_BuffCheck()
		&& !thePlayer.HasTag('acs_in_wraith')
		&& !thePlayer.HasTag('ACS_Bruxa_Bite_Process')
		&& thePlayer.IsAnyWeaponHeld()
		&& !thePlayer.IsWeaponHeld( 'fist' )
		)
		{
			//ACS_Phantom_Combo_Mode_Reset();

			DeactivateThings();

			ACS_ThingsThatShouldBeRemoved();

			if (thePlayer.HasTag('ACS_IsSwordWalking'))
			{
				thePlayer.RemoveTag('ACS_IsSwordWalking');
			}

			RemoveTimer('SwordTauntSwitch'); 
			RemoveTimer('SwordTauntRunningSwitch'); 
			
			thePlayer.SendAttackReactionEvent();

			thePlayer.ManageAerondightBuff(true);

			if ( thePlayer.inv.IsItemCrossbow( thePlayer.inv.GetItemFromSlot( 'l_weapon' ) ) )
			{
				thePlayer.OnRangedForceHolster(false, true, false);
			}

			if ( !thePlayer.HasTag('acs_igni_sword_equipped') && !thePlayer.HasTag('acs_igni_secondary_sword_equipped') )
			{
				ACS_ExplorationDelayHack(false, 3);
			}

			targetDistance = VecDistanceSquared2D( thePlayer.GetWorldPosition(), ((CNewNPC)(thePlayer.GetTarget())).GetWorldPosition() );

			if (((CMovingPhysicalAgentComponent)(((CNewNPC)(thePlayer.GetTarget())).GetMovingAgentComponent())).GetCapsuleHeight() >= 2
			|| ((CNewNPC)(thePlayer.GetTarget())).GetRadius() >= 0.7
			|| ((CNewNPC)(thePlayer.GetTarget())).HasAbility('Boss')
			|| ((CNewNPC)(thePlayer.GetTarget())).HasTag('IsBoss')
			|| ((CNewNPC)(thePlayer.GetTarget())).HasTag('ACS_Big_Boi')
			)
			{
				distance = 5;
			}
			else
			{
				distance = 3.5;
			}

			if (
			thePlayer.HasTag('ACS_Is_Sneaking')
			&& ACS_IS_SNEAKING
			&& ((CNewNPC)(thePlayer.GetTarget())).HasTag('ACS_Counter_Wound_Ready')
			&& ((CNewNPC)(thePlayer.GetTarget())).IsAlive()
			&& ((CNewNPC)(thePlayer.GetTarget())).GetCurrentHealth() > 0.01
			&& ((CNewNPC)(thePlayer.GetTarget())).acs_backstab_wound_fx
			&& targetDistance <= distance * distance
			)
			{
				if( 
				stab_hostage_enabled
				&& ACSGetCActor('ACS_Stab_Hostage')
				&& ACSGetCActor('ACS_Stab_Hostage').IsAlive()
				)
				{
					ReleaseStabHostage();

					RemoveTimer('ACS_Stab_Hostage_Process');

					((CNewNPC)(thePlayer.GetTarget())).RemoveTag('ACS_Counter_Wound_Ready');

					((CNewNPC)(thePlayer.GetTarget())).acs_backstab_wound_fx.AddTag('ACS_Counter_Wound_Disable');

					ACS_SetupSyncAnimInternalCounterWound(thePlayer, ((CNewNPC)(thePlayer.GetTarget())));
					
					return;
				}

				if( 
				StabHostageCheck()
				)
				{
					thePlayer.ACS_ClearAnimationSpeedMultipliers();

					thePlayer.RaiseEvent('ACS_StabHostageEnter03');
				}
				else
				{
					ReleaseStabHostage();

					RemoveTimer('ACS_Stab_Hostage_Process');

					((CNewNPC)(thePlayer.GetTarget())).RemoveTag('ACS_Counter_Wound_Ready');

					if ( ACS_Vampire_Claws_Access() )
					{
						action_interrupt();

						thePlayer.RemoveTag('ACS_Manual_Combat_Control');

					
						thePlayer.DestroyEffect( 'bruxa_dash_trails' );
						thePlayer.PlayEffectSingle( 'bruxa_dash_trails' );
						thePlayer.StopEffect( 'bruxa_dash_trails' );

						thePlayer.DestroyEffect('shadowdash_shockwave');
						thePlayer.PlayEffectSingle('shadowdash_shockwave');
						thePlayer.StopEffect('shadowdash_shockwave');

						thePlayer.DestroyEffect('shadowdash_short');
						thePlayer.PlayEffectSingle('shadowdash_short');
						thePlayer.StopEffect('shadowdash_short');

						finisher_anim_names.Clear();

						finisher_anim_names.PushBack('bruxa_attack_bite_front_lp_bruxa_ACS');
						finisher_anim_names.PushBack('bruxa_attack_bite_front_rp_bruxa_ACS');
						finisher_anim_names.PushBack('bruxa_attack_bite_back_lp_bruxa_ACS');
						finisher_anim_names.PushBack('bruxa_attack_bite_back_rp_bruxa_ACS');

						if (combatTarget.IsHuman())
						{
							ACS_SetupSyncAnimInternalHumanBruxaBite(finisher_anim_names[RandRange(finisher_anim_names.Size())], thePlayer, ((CNewNPC)(thePlayer.GetTarget())) );

							return;
						}
						else
						{
							ACS_SetupSyncAnimInternalMonsterBruxaBite(finisher_anim_names[RandRange(finisher_anim_names.Size())], thePlayer, ((CNewNPC)(thePlayer.GetTarget())) );

							return;
						}
					
					}

					((CNewNPC)(thePlayer.GetTarget())).acs_backstab_wound_fx.AddTag('ACS_Counter_Wound_Disable');

					ACS_SetupSyncAnimInternalCounterWound(thePlayer, ((CNewNPC)(thePlayer.GetTarget())));
				}

				return;
			}

			if( 
			stab_hostage_enabled
			&& ACSGetCActor('ACS_Stab_Hostage')
			&& ACSGetCActor('ACS_Stab_Hostage').IsAlive()
			)
			{
				ReleaseStabHostage();

				RemoveTimer('ACS_Stab_Hostage_Process');
				
				return;
			}

			if ( FactsQuerySum("ACS_Azkar_Active") > 0)
			{
				if ( StaminaCheck('default')
				)
				{ 
					ACS_RangedWeaponSwitch();

					RemoveTimer('SwordTauntSwitch'); RemoveTimer('SwordTauntRunningSwitch');   if (thePlayer.HasTag('ACS_IsSwordWalking')){thePlayer.RemoveTag('ACS_IsSwordWalking');} if(thePlayer.IsInCombat()){if(thePlayer.GetCombatIdleStance() <= 0.f ){thePlayer.RaiseEvent('ACS_CombatTauntLeft');}else{thePlayer.RaiseEvent('ACS_CombatTauntRight');}} thePlayer.SoundEvent("gui_no_stamina");
				}
				else
				{
					if ( theGame.GetEngineTimeAsSeconds() - last_shoot_bow_moving_time > 1 )
					{
						last_shoot_bow_moving_time = theGame.GetEngineTimeAsSeconds();

						if (GetWitcherPlayer().HasTag('ACS_Special_Dodge'))
						{
							GetWitcherPlayer().RemoveTag('ACS_Special_Dodge');
						}

						ACS_RangedWeaponSwitch();

						//geraltShootBowMoving();

						RemoveTimer('ACS_ShootBowMoving');
						AddTimer('ACS_ShootBowMoving', 0.00001 , false);

						ACS_StaminaDrain(6, true);
					}
				}
			}
			else if ( FactsQuerySum("ACS_Slayer_Active") > 0 )
			{
				if ( theGame.GetEngineTimeAsSeconds() - last_shoot_shotgun_light_attack_time > 1.5 )
				{
					last_shoot_shotgun_light_attack_time = theGame.GetEngineTimeAsSeconds();

					if (GetWitcherPlayer().HasTag('ACS_Special_Dodge'))
					{
						GetWitcherPlayer().RemoveTag('ACS_Special_Dodge');
					}

					if (thePlayer.HasTag('ACS_Is_Currently_Dodging'))
					{
						RemoveTimer('ACS_dodge_timer_end');
						AddTimer('ACS_dodge_timer_end', 0.01     , false);
					}

					ACS_RangedWeaponSwitch();

					if ( thePlayer.GetStat(BCS_Focus) >= thePlayer.GetStatMax( BCS_Focus ) * 0.165 )
					{
						if (theInput.GetActionValue('Guard') > 0.1f
						|| thePlayer.IsGuarded()
						)
						{
							thePlayer.GainStat( BCS_Focus, thePlayer.GetStatMax( BCS_Focus) * 0.165 );

							thePlayer.RaiseEvent('ACS_ShotgunReload');

							ShotgunPositioningSwitch('in_combat');

							theSound.SoundEvent("doom_shotgun_reload_orig_acs");
						}
						else
						{
							geraltShootShotgun('light');
						}
					}
					else
					{
						thePlayer.GainStat( BCS_Focus, thePlayer.GetStatMax( BCS_Focus) * 0.165 );

						thePlayer.RaiseEvent('ACS_ShotgunReload');

						ShotgunPositioningSwitch('in_combat');

						theSound.SoundEvent("doom_shotgun_reload_orig_acs");
					}
				}
			}
			else if ( FactsQuerySum("ACS_Slayer_Active") <= 0 && FactsQuerySum("ACS_Azkar_Active") <= 0)

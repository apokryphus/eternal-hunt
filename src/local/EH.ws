	private var playerCamera 						: ACSPlayerCamera;

	public function SetPlayerCamera( a : ACSPlayerCamera )
	{
		this.playerCamera = a;
	}

	public function GetPlayerCamera() : ACSPlayerCamera
	{
		return this.playerCamera;
	}

	function PlayerCustomCamera()
	{
		var template	: CEntityTemplate;
		var ent			: CEntity;

		CamerasDestroy();

		template = (CEntityTemplate)LoadResource("dlc\dlc_acs\data\entities\other\acs_player_camera.w2ent", true);

		ent = (CStaticCamera)theGame.CreateEntity(template, theCamera.GetCameraPosition(), theCamera.GetCameraRotation());	

		ent.AddTag('ACS_Player_Custom_Camera');
	}

	function PlayerOverrideCamera()
	{
		var vehicle										: CEntity;

		if (thePlayer.IsUsingVehicle())
		{
			vehicle = thePlayer.GetUsedVehicle();
		}

		if ( (thePlayer.HasTag('ACS_In_Umbral_Slash_End') 
		|| FactsQuerySum("ACS_Mounted_Attack_Attachment_Active") > 0
		//|| thePlayer.HasTag('ACS_In_Dance_Of_Wrath')  
		//|| (thePlayer.HasTag('ACS_Ghost_Stance_Active') && !thePlayer.HasTag('ACS_IsPerformingFinisher') && !thePlayer.HasTag('ACS_IsPerformingCombatDismember'))
		//|| thePlayer.HasTag('ACS_Ghost_Stance_Active')
		|| thePlayer.HasTag('ACS_In_Ciri_Special_Attack')
		//|| (thePlayer.HasTag('ACS_IsPerformingFinisher') && ((thePlayer.IsLastEnemyKilled() && ACS_Settings_Main_Int('acs_custom_finishers_settings','acs_custom_finisher_camera_options', 0) == 1) || ACS_Settings_Main_Int('acs_custom_finishers_settings','acs_custom_finisher_camera_options', 0) == 2))
		|| (FactsQuerySum("ACS_Azkar_Active") > 0 && FactsQuerySum("ACS_Azkar_Aiming") > 0 && thePlayer.IsAnyWeaponHeld() && !thePlayer.IsWeaponHeld('fist'))
		|| thePlayer.HasTag('ACS_GrappleMovingPlayer')
		|| ACSGetCEntity('ACS_Wings_Entity')
		//|| (thePlayer.HasTag('ACS_Vampires_Claws_Sprinting') && !thePlayer.IsInInterior())
		//|| (thePlayer.HasTag('acs_vampire_claws_equipped') && (thePlayer.IsCurrentlyDodging() && !thePlayer.IsInInterior() && ACS_Settings_Main_Bool('acs_hud_settings_main','EHmodVampireDodgeCameraEnabled', true)))
		//|| (thePlayer.HasTag('acs_vampire_claws_equipped') && thePlayer.HasTag('ACS_IsPerformingFinisher'))
		|| FactsQuerySum("ACS_FP_Enabled") > 0
		|| (thePlayer.IsUsingVehicle() && !thePlayer.IsUsingHorse() && ACS_Settings_Main_Bool('acs_hud_camera_settings_main','acs_custom_vehicle_camera_positioning_enabled', false))
		|| (thePlayer.IsUsingVehicle() && (vehicle.HasTag('ACS_Player_Merchant_Ship') || vehicle.HasTag('ACS_Player_Ghost_Ship')))
		) 
		&& !thePlayer.IsInInterior()
		)
		{
			if(GetPlayerCamera() && GetPlayerCamera().HasTag('ACS_Player_Cam_Go_Back_Started'))
			{
				RemoveTimer('PlayerCameraDestroyDelay');

				GetPlayerCamera().RemoveTag('ACS_Player_Cam_Go_Back_Started');
			}

			if(!GetPlayerCamera()
			&& !GetTransformationCamera()
			&& !GetKestralCamera()
			)
			{
				PlayerCustomCamera();
			}
		}
		else
		{
			if(GetPlayerCamera() && !GetPlayerCamera().HasTag('ACS_Player_Cam_Go_Back_Started'))
			{
				RemoveTimer('PlayerCameraDestroyDelay');

				AddTimer('PlayerCameraDestroyDelay', 1.5 , false);

				GetPlayerCamera().AddTag('ACS_Player_Cam_Go_Back_Started');
			}
		}
	}

	timer function PlayerCameraDestroyDelay( deltaTime : float , id : int)
	{	
		GetPlayerCamera().Stop();

		GetPlayerCamera().DestroyAfter(1.1);
	}

	////////////////////////////////////////////////////////////////////////////////////////

	var vACS_Startup_Entity_Spawns : cACS_Startup_Entity_Spawns;

	var vACS_Fog_Assassin_Spawner : cACS_Fog_Assassin_Spawner;


	function ACS_FogAssassinManager()
	{
		var targetDistance													: float;

		if (!ACSGetCActor('ACS_Fog_Assassin') || !ACSGetCActor('ACS_Fog_Assassin').IsAlive())
		{
			return;
		}

		targetDistance = VecDistanceSquared2D( ACSGetCActor('ACS_Fog_Assassin').GetWorldPosition(), GetWitcherPlayer().GetWorldPosition() );

		if (
		ACSGetCActor('ACS_Fog_Assassin').IsAlive() 
		&& ACSGetCActor('ACS_Fog_Assassin').IsInCombat()
		&& ACSGetCActor('ACS_Fog_Assassin').IsEffectActive('disappear_fog')
		&& ACS_can_spawn_fogling()
		&& targetDistance <= 10
		)
		{
			ACS_refresh_fogling_cooldown();

			vACS_Fog_Assassin_Spawner = new cACS_Fog_Assassin_Spawner in this;

			vACS_Fog_Assassin_Spawner.Fog_Assassin_Doppleganger_Spawner_Engage();
		}
	}

	var vACS_XenoSwarm_Spawner: cACS_XenoSwarm_Spawner;

	var vACS_Duskwraith_Spawner : cACS_Duskwraith_Spawner;

	function ACS_DuskwraithManager()
	{
		var animatedComponentA																									: CAnimatedComponent;
		var movementAdjustorNPC																									: CMovementAdjustor; 
		var ticketNPC 																											: SMovementAdjustmentRequestTicket; 
		var targetDistance																										: float;

		animatedComponentA = (CAnimatedComponent)((CNewNPC)ACSGetCActor('ACS_Duskwraith')).GetComponentByClassName( 'CAnimatedComponent' );	

		movementAdjustorNPC = ACSGetCActor('ACS_Duskwraith').GetMovingAgentComponent().GetMovementAdjustor();

		targetDistance = VecDistanceSquared2D( ACSGetCActor('ACS_Duskwraith').GetWorldPosition(), GetWitcherPlayer().GetWorldPosition() );

		if (!ACSGetCActor('ACS_Duskwraith') || !ACSGetCActor('ACS_Duskwraith').IsAlive())
		{
			return;
		}

		if (ACSGetCActor('ACS_Duskwraith').ACS_IsInDimeritiumCloud()) 
		{
			return;
		}

		if (ACSGetCActor('ACS_Duskwraith')
		&& ACSGetCActor('ACS_Duskwraith').IsAlive()
		&& ACSGetCActor('ACS_Duskwraith').IsInCombat()
		)
		{
			if (ACS_duskwraith_abilities()
			)
			{
				ACS_refresh_duskwraith_abilities_cooldown();

				if ( targetDistance >= 2 * 2 && targetDistance < 15 * 15 )
				{
					ACSGetCActor('ACS_Duskwraith').StopEffect('shadows_form_banshee');
					ACSGetCActor('ACS_Duskwraith').StopEffect('shadows_form_noonwraith_test');
					ACSGetCActor('ACS_Duskwraith').PlayEffectSingle('shadows_form_noonwraith');

					RemoveTimer('ACS_Duskwraith_Shadowcloak');

					AddTimer('ACS_Duskwraith_Shadowcloak', 4 , false);

					ticketNPC = movementAdjustorNPC.GetRequest( 'ACS_Duskwraith_Rotate');
					movementAdjustorNPC.CancelByName( 'ACS_Duskwraith_Rotate' );
					movementAdjustorNPC.CancelAll();

					ticketNPC = movementAdjustorNPC.CreateNewRequest( 'ACS_Duskwraith_Rotate' );
					movementAdjustorNPC.AdjustmentDuration( ticketNPC, 0.25 );
					movementAdjustorNPC.MaxRotationAdjustmentSpeed( ticketNPC, 500000 );

					movementAdjustorNPC.RotateTowards( ticketNPC, thePlayer );

					ACSGetCActor('ACS_Duskwraith').SoundEvent("monster_banshee_combat_summoning");

					ACSGetCActor('ACS_Duskwraith').PlayEffectSingle('scream_summone');

					if( !ACSGetCActor('ACS_Duskwraith').HasTag('ACS_Summoned_Skeletons_Primary') )
					{

						ACSGetCActor('ACS_Duskwraith').AddTag('ACS_Summoned_Skeletons_Primary');
					}
					else
					{
						ACSGetCActor('ACS_Duskwraith').RemoveTag('ACS_Summoned_Skeletons_Primary');
					}

					RemoveTimer('ACS_Duskwraith_Skeletons_Spawner_Delay');
					AddTimer('ACS_Duskwraith_Skeletons_Spawner_Delay', 1 , false);
				}
			}

			if (ACS_duskwraith_break_yrden())
			{
				ACS_refresh_duskwraith_break_yrden_cooldown();

				if ( targetDistance <= 15 * 15 )
				{
					if (!ACSGetCActor('ACS_Duskwraith').IsEffectActive('shadows_form_banshee', false))
					{
						ACS_FindAndStopNearYrdenEntities(ACSGetCActor('ACS_Duskwraith'));
					}
					else
					{
						if(GetWitcherPlayer().IsAnyQuenActive())
						{
							ACSGetCActor('ACS_Duskwraith').StopEffect('scream_summone_orange');
							ACSGetCActor('ACS_Duskwraith').PlayEffectSingle('scream_summone_orange');

							GetWitcherPlayer().PlayEffectSingle('quen_lasting_shield_hit');

							GetWitcherPlayer().StopEffect('quen_lasting_shield_hit');

							GetWitcherPlayer().PlayEffectSingle('lasting_shield_discharge');

							GetWitcherPlayer().StopEffect('lasting_shield_discharge');

							GetWitcherPlayer().FinishQuen(false);
						}
					}
				}
			}
		}
	}

	timer function ACS_Duskwraith_Shadowcloak( time : float , id : int )
	{
		if (!ACSGetCActor('ACS_Duskwraith').IsEffectActive('shadows_form_banshee', false))
		{
			ACSGetCActor('ACS_Duskwraith').PlayEffectSingle('shadows_form_banshee');
		}

		if (!ACSGetCActor('ACS_Duskwraith').IsEffectActive('shadows_form_noonwraith_test', false))
		{
			ACSGetCActor('ACS_Duskwraith').PlayEffectSingle('shadows_form_noonwraith_test');
		}

		if (ACSGetCActor('ACS_Duskwraith').IsEffectActive('shadows_form_noonwraith', false))
		{
			ACSGetCActor('ACS_Duskwraith').StopEffect('shadows_form_noonwraith');
		}
	}

	timer function ACS_Duskwraith_Skeletons_Spawner_Delay( time : float , id : int )
	{
		vACS_Duskwraith_Spawner = new cACS_Duskwraith_Spawner in this;

		vACS_Duskwraith_Spawner.ACS_Duskwraith_Skeletons_Spawner_Engage();
	}

	timer function ACS_Duskwraith_Skeletons_Despawn( time : float , id : int )
	{
		var skele 											: array<CActor>;
		var i												: int;
		
		skele.Clear();

		theGame.GetActorsByTag( 'ACS_Duskwraith_Skeleton', skele );	
		
		for( i = 0; i < skele.Size(); i += 1 )
		{
			skele[i].PlayEffectSingle('death_glow');
			skele[i].PlayEffectSingle('suck_into_painting');
			skele[i].Kill('ACS_Duskwraith_Skeleton_Despawn', true);
		}
	}

	var vACS_Draug_Spawner : cACS_Draug_Spawner;

	function ACS_DraugManager()
	{
		var animatedComponentA																									: CAnimatedComponent;
		var movementAdjustorNPC																									: CMovementAdjustor; 
		var ticketNPC 																											: SMovementAdjustmentRequestTicket; 
		var targetDistance																										: float;
		var draugAnimatedComponentA																								: CAnimatedComponent;

		animatedComponentA = (CAnimatedComponent)((CNewNPC)ACSGetCActor('ACS_Draug')).GetComponentByClassName( 'CAnimatedComponent' );	

		movementAdjustorNPC = ACSGetCActor('ACS_Draug').GetMovingAgentComponent().GetMovementAdjustor();

		targetDistance = VecDistanceSquared2D( ACSGetCActor('ACS_Draug').GetWorldPosition(), ((CActor)(ACSGetCActor('ACS_Draug').GetTarget())).GetWorldPosition() );

		if (!ACSGetCActor('ACS_Draug') || !ACSGetCActor('ACS_Draug').IsAlive())
		{
			return;
		}

		if (ACSGetCActor('ACS_Draug')
		&& ACSGetCActor('ACS_Draug').IsAlive()
		&& ACSGetCActor('ACS_Draug').IsInCombat()
		)
		{
			if (ACS_draug_ability())
			{
				ACS_refresh_draug_ability_cooldown();

				ticketNPC = movementAdjustorNPC.GetRequest( 'ACS_Draug_Rotate');
				movementAdjustorNPC.CancelByName( 'ACS_Draug_Rotate' );
				movementAdjustorNPC.CancelAll();

				ticketNPC = movementAdjustorNPC.CreateNewRequest( 'ACS_Draug_Rotate' );
				movementAdjustorNPC.AdjustmentDuration( ticketNPC, 1 );
				movementAdjustorNPC.MaxRotationAdjustmentSpeed( ticketNPC, 500000 );

				movementAdjustorNPC.RotateTowards( ticketNPC, ((CActor)(ACSGetCActor('ACS_Draug').GetTarget())) );

				RemoveTimer('ACS_Draug_Anchor_Respawn');

				draugAnimatedComponentA = (CAnimatedComponent)((CNewNPC)ACSGetCActor('ACS_Draug')).GetComponentByClassName( 'CAnimatedComponent' );	

				if ( targetDistance <= 6 * 6 )
				{
					acs_draug_attack_index_1 = RandDifferent(this.previous_acs_draug_attack_index_1 , 5);

					vACS_Draug_Spawner = new cACS_Draug_Spawner in this;

					vACS_Draug_Spawner.ACS_Draug_Swap_To_Close_Range_Engage();

					switch (acs_draug_attack_index_1) 
					{	
						case 4:

						draugAnimatedComponentA.PlaySlotAnimationAsync ( 'giant_combat_attack_f_3_ACS', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));

						AddTimer('ACS_Draug_Anchor_Respawn', 2 , false);

						break;

						case 3:

						draugAnimatedComponentA.PlaySlotAnimationAsync ( 'giant_combat_attack_f_2_ACS', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));

						AddTimer('ACS_Draug_Anchor_Respawn', 2 , false);

						break;

						case 2:

						draugAnimatedComponentA.PlaySlotAnimationAsync ( 'giant_combat_attack_f_1_ACS', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));

						AddTimer('ACS_Draug_Anchor_Respawn', 2 , false);

						break;	

						case 1:

						draugAnimatedComponentA.PlaySlotAnimationAsync ( 'giant_whirlwind_attack_ACS', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));

						AddTimer('ACS_Draug_Anchor_Respawn', 3 , false);

						break;

						default:

						draugAnimatedComponentA.PlaySlotAnimationAsync ( 'giant_combat_attack_charge', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));

						AddTimer('ACS_Draug_Anchor_Respawn', 3 , false);

						break;
					}
						
					this.previous_acs_draug_attack_index_1 = acs_draug_attack_index_1;
				}
				else if ( targetDistance > 6 * 6 && targetDistance <= 25 * 25 )
				{
					acs_draug_attack_index_2 = RandDifferent(this.previous_acs_draug_attack_index_2 , 4);

					vACS_Draug_Spawner = new cACS_Draug_Spawner in this;

					vACS_Draug_Spawner.ACS_Draug_Swap_To_Close_Range_Engage();

					switch (acs_draug_attack_index_2) 
					{	
						case 3:

						draugAnimatedComponentA.PlaySlotAnimationAsync ( 'giant_combat_anchor_attack_far_f_ACS', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));

						AddTimer('ACS_Draug_Anchor_Respawn', 2 , false);

						break;

						case 2:

						draugAnimatedComponentA.PlaySlotAnimationAsync ( 'giant_combat_anchor_attack_distance_ACS', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));

						AddTimer('ACS_Draug_Anchor_Respawn', 3 , false);

						break;	

						case 1:

						draugAnimatedComponentA.PlaySlotAnimationAsync ( 'giant_whirlwind_attack_long_ACS', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));

						AddTimer('ACS_Draug_Anchor_Respawn', 4 , false);

						break;

						default:

						draugAnimatedComponentA.PlaySlotAnimationAsync ( 'giant_combat_attack_charge', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));

						AddTimer('ACS_Draug_Anchor_Respawn', 3 , false);

						break;
					}
						
					this.previous_acs_draug_attack_index_2 = acs_draug_attack_index_2;
				}
				else if ( targetDistance > 25 * 25 )
				{
					vACS_Draug_Spawner = new cACS_Draug_Spawner in this;

					vACS_Draug_Spawner.ACS_Draug_Swap_To_Close_Range_Engage();

					AddTimer('ACS_Draug_Anchor_Respawn', 3 , false);

					animatedComponentA.PlaySlotAnimationAsync ( 'giant_combat_attack_charge', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));
				}
			}
		}
	}

	timer function ACS_Draug_Anchor_Respawn( time : float , id : int )
	{
		vACS_Draug_Spawner = new cACS_Draug_Spawner in this;

		vACS_Draug_Spawner.ACS_Draug_Swap_To_Far_Range_Engage();
	}


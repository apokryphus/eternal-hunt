		"dlc\dlc_acs\data\fx\sword_slash_circular\acs_sword_slash_circular.w2ent"

		, true ), (thePlayer.GetWorldPosition() + thePlayer.GetWorldForward() * 2) + (Vector(0,0,1.5)), thePlayer.GetWorldRotation() );

		markerNPC_2.AddTag('ACS_Sword_Slash_Circular_Medium');

		markerNPC_2.AddTag('ACS_Sword_Slash_Wolven_Flash_Primary');

		markerNPC_2.AddTag('ACS_Sword_Slash_Circular_Deal_Damage');

		Sleep(0.25f);

		if (thePlayer.GetPlayerCombatStance() != PCS_AlertNear)
		{
			thePlayer.SetPlayerCombatStance(PCS_AlertNear, true);
			thePlayer.SetPlayerCombatStance(PCS_AlertNear, true);
			thePlayer.SetPlayerCombatStance(PCS_AlertNear, true);
		}

		position = GetWitcherPlayer().GetWorldPosition() + (GetWitcherPlayer().GetWorldForward() * 1.1) + GetWitcherPlayer().GetHeadingVector() * 1.1;
		
		targetPosition_1 = position + GetWitcherPlayer().GetHeadingVector() * 30;

		proj_1 = (W3ACSWolvenFlashProj)theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync( "dlc\dlc_acs\data\entities\projectiles\wolven_flash_proj.w2ent", true ), position );
		proj_1.Init(GetWitcherPlayer());
		proj_1.PlayEffectSingle('fire_line');
		proj_1.ShootProjectileAtPosition(0,	20, targetPosition_1, 30 );
		proj_1.DestroyAfter(5);

		movementAdjustorPlayer.CancelAll();
		ticketPlayer = movementAdjustorPlayer.CreateNewRequest( 'ACSMovAdj' );
		movementAdjustorPlayer.MaxRotationAdjustmentSpeed( ticketPlayer, 500000 );
		movementAdjustorPlayer.MaxLocationAdjustmentSpeed( ticketPlayer, 500000 );
		movementAdjustorPlayer.AdjustLocationVertically( ticketPlayer, true );
		movementAdjustorPlayer.ScaleAnimationLocationVertically( ticketPlayer, true );
		movementAdjustorPlayer.AdjustmentDuration( ticketPlayer, 0.125f );

		if (thePlayer.GetTarget())
		{
			movementAdjustorPlayer.RotateTowards(ticketPlayer, ((CActor)thePlayer.GetTarget()) );
		}
		else
		{
			movementAdjustorPlayer.RotateTo(ticketPlayer, VecHeading(theCamera.GetCameraDirection()));
		}

		markerNPC_3 = theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync( 

		"dlc\dlc_acs\data\fx\sword_slash_circular\acs_sword_slash_circular.w2ent"

		, true ), (thePlayer.GetWorldPosition() + thePlayer.GetWorldForward() * 6) + (Vector(0,0,1.5)), thePlayer.GetWorldRotation() );

		markerNPC_3.AddTag('ACS_Sword_Slash_Circular_Light');

		markerNPC_3.AddTag('ACS_Sword_Slash_Wolven_Flash_Secondary');

		markerNPC_3.AddTag('ACS_Sword_Slash_Circular_Deal_Damage');

		Sleep(0.125);

		markerNPC_4 = theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync( 

		"dlc\dlc_acs\data\fx\sword_slash_circular\acs_sword_slash_circular.w2ent"

		, true ), (thePlayer.GetWorldPosition() + thePlayer.GetWorldForward() * 10) + (Vector(0,0,1.5)), thePlayer.GetWorldRotation() );

		markerNPC_4.AddTag('ACS_Sword_Slash_Circular_Light');

		markerNPC_4.AddTag('ACS_Sword_Slash_Wolven_Flash_Secondary');

		markerNPC_4.AddTag('ACS_Sword_Slash_Circular_Deal_Damage');

		Sleep(0.125);

		markerNPC_5 = theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync( 

		"dlc\dlc_acs\data\fx\sword_slash_circular\acs_sword_slash_circular.w2ent"

		, true ), (thePlayer.GetWorldPosition() + thePlayer.GetWorldForward() * 14) + (Vector(0,0,1.5)), thePlayer.GetWorldRotation() );

		markerNPC_5.AddTag('ACS_Sword_Slash_Circular_Light');

		markerNPC_5.AddTag('ACS_Sword_Slash_Wolven_Flash_Secondary');

		markerNPC_5.AddTag('ACS_Sword_Slash_Circular_Deal_Damage');

		Sleep(0.125);

		markerNPC_6 = theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync( 

		"dlc\dlc_acs\data\fx\sword_slash_circular\acs_sword_slash_circular.w2ent"

		, true ), (thePlayer.GetWorldPosition() + thePlayer.GetWorldForward() * 18) + (Vector(0,0,1.5)), thePlayer.GetWorldRotation() );

		markerNPC_6.AddTag('ACS_Sword_Slash_Circular_Light');

		markerNPC_6.AddTag('ACS_Sword_Slash_Wolven_Flash_Secondary');

		markerNPC_6.AddTag('ACS_Sword_Slash_Circular_Deal_Damage');

		movementAdjustorPlayer.CancelAll();

		thePlayer.ACS_ClearAnimationSpeedMultipliers();

		thePlayer.ACS_SetAnimationSpeedMultiplier(1);

		thePlayer.RemoveTag('ACS_In_Combat_Art');

		thePlayer.RemoveTag('ACS_Wolven_Flash');

		thePlayer.BlockAllActions( 'ACS_Wolven_Flash', false );

		thePlayer.SetImmortalityMode( AIM_None, AIC_Default, true ); 
		thePlayer.SetCanPlayHitAnim(true); 
		if (!thePlayer.IsUsingHorse()&& !thePlayer.IsUsingVehicle()){thePlayer.EnableCharacterCollisions(true); }	
		thePlayer.RemoveBuffImmunity_AllNegative('acs_dodge'); 
		thePlayer.RemoveBuffImmunity_AllCritical('acs_dodge'); 
		thePlayer.SetIsCurrentlyDodging(false);

		parent.LockEntryFunction(false);

		parent.GotoState('ACS_ORTHANC');
	}
	
	event OnLeaveState( nextStateName : name )
	{
		super.OnLeaveState(nextStateName);
	}	
}

state ACS_Wolven_Cross in W3ACSWatcherSecondary 
{
	var camera 															: CCustomCamera;
	var evadeTarget														: CActor;
	var playerPos														: Vector;
	var markerNPC_1, markerNPC_2										: CEntity;
	var markerTemplate_1 												: CEntityTemplate;
	var movementAdjustorPlayer											: CMovementAdjustor;
	var ticketPlayer													: SMovementAdjustmentRequestTicket;
	var dist															: float;
	var animatedComponentPlayer											: CAnimatedComponent;
	var rot																: EulerAngles;
	var pos																: Vector;
	var torsoBoneIndex													: int;
	var interiorCameraDesiredPositionMult 								: float;
	default interiorCameraDesiredPositionMult 							= 10.f;


	event OnEnterState( prevStateName : name )
	{
		ACS_Wolven_Cross_Start();

		super.OnEnterState(prevStateName);
	}
	
	private entry function ACS_Wolven_Cross_Start()
	{
		parent.LockEntryFunction(true);

		thePlayer.BlockAllActions( 'ACS_Wolven_Cross', true );

		GetWitcherPlayer().DrainFocus( GetWitcherPlayer().GetStatMax( BCS_Focus ) * 0.33 );

		animatedComponentPlayer = (CAnimatedComponent)(thePlayer).GetComponentByClassName( 'CAnimatedComponent' );	

		movementAdjustorPlayer = GetWitcherPlayer().GetMovingAgentComponent().GetMovementAdjustor();

		playerPos = TraceFloor(thePlayer.GetWorldPosition());

		thePlayer.SetImmortalityMode( AIM_Invulnerable, AIC_Default, true ); 
		thePlayer.SetCanPlayHitAnim(false); 
		thePlayer.AddBuffImmunity_AllNegative('acs_dodge', true); 
		thePlayer.AddBuffImmunity_AllCritical('acs_dodge', true); 
		thePlayer.SetIsCurrentlyDodging(true);
		if (!thePlayer.IsUsingHorse()&& !thePlayer.IsUsingVehicle()){thePlayer.EnableCharacterCollisions(true); }	

		Sleep(0.1);

		thePlayer.AddTag('ACS_In_Combat_Art');

		thePlayer.AddTag('ACS_Wolven_Cross');

		GetACSWatcher().RemoveTimer('SwordTauntSwitch'); 
		GetACSWatcher().RemoveTimer('SwordTauntRunningSwitch'); 
		 
		thePlayer.RaiseEvent('ACS_SwordTauntEnd');
		thePlayer.RaiseEvent('ACS_CombatTauntEnd');
		
		GetACSWatcher().RemoveTimer('CombatTauntDelay');
		GetACSWatcher().RemoveTimer('SwordTauntRunningSwitchSecondary'); 
		GetACSWatcher().RemoveTimer('SwordTauntRunningSwitchSecondaryWeaponBlood'); 

		thePlayer.StopEffect('special_attack_break');

		thePlayer.PlayEffectSingle('special_attack_break');

		thePlayer.StopEffect('special_attack_break');

		thePlayer.StopEffect('jump_ground_fx1');
		thePlayer.PlayEffect('jump_ground_fx1');

		movementAdjustorPlayer.CancelAll();
		ticketPlayer = movementAdjustorPlayer.CreateNewRequest( 'ACSMovAdj' );
		movementAdjustorPlayer.MaxRotationAdjustmentSpeed( ticketPlayer, 500000 );
		movementAdjustorPlayer.MaxLocationAdjustmentSpeed( ticketPlayer, 500000 );
		movementAdjustorPlayer.AdjustLocationVertically( ticketPlayer, true );
		movementAdjustorPlayer.ScaleAnimationLocationVertically( ticketPlayer, true );
		movementAdjustorPlayer.AdjustmentDuration( ticketPlayer, 0.125f );

		if (thePlayer.GetTarget())
		{
			movementAdjustorPlayer.RotateTowards(ticketPlayer, ((CActor)thePlayer.GetTarget()) );
		}
		else
		{
			movementAdjustorPlayer.RotateTo(ticketPlayer, VecHeading(theCamera.GetCameraDirection()));
		}

		thePlayer.StopEffect('jump_ground_fx1');
		thePlayer.PlayEffect('jump_ground_fx1');

		thePlayer.StopEffect('special_attack_break');

		thePlayer.PlayEffectSingle('special_attack_break');

		thePlayer.StopEffect('special_attack_break');

		thePlayer.ACS_ClearAnimationSpeedMultipliers();

		thePlayer.ACS_SetAnimationSpeedMultiplier(1.5);

		markerNPC_1 = theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync( 

		"dlc\dlc_acs\data\fx\sword_slash_circular\acs_sword_slash_circular.w2ent"

			, true ), (thePlayer.GetWorldPosition() + thePlayer.GetWorldForward() * 2) + (Vector(0,0,1.5)), thePlayer.GetWorldRotation() );

		if(thePlayer.GetCombatIdleStance() <= 0.f )
		{
			thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( 'man_geralt_sword_repel_lp_ACS', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f) );

			markerNPC_1.AddTag('ACS_Sword_Slash_Wolven_Cross_02');

			thePlayer.AddTag('ACS_WolvenCrossRightSide');
		}
		else
		{
			thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( 'man_geralt_sword_repel_rp_ACS', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f) );

			markerNPC_1.AddTag('ACS_Sword_Slash_Wolven_Cross_01');
		}

		markerNPC_1.AddTag('ACS_Sword_Slash_Circular_Deal_Damage');

		Sleep(0.25);

		markerNPC_2 = theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync( 

		"dlc\dlc_acs\data\fx\sword_slash_circular\acs_sword_slash_circular.w2ent"

			, true ), (thePlayer.GetWorldPosition() + thePlayer.GetWorldForward() * 2) + (Vector(0,0,1.5)), thePlayer.GetWorldRotation() );

		if (thePlayer.HasTag('ACS_WolvenCrossRightSide'))
		{
			thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( 'man_geralt_sword_repel_rp_ACS', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f) );

			markerNPC_2.AddTag('ACS_Sword_Slash_Wolven_Cross_01');

			thePlayer.RemoveTag('ACS_WolvenCrossRightSide');
		}
		else
		{
			thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( 'man_geralt_sword_repel_lp_ACS', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f) );

			markerNPC_2.AddTag('ACS_Sword_Slash_Wolven_Cross_02');
		}

		markerNPC_2.AddTag('ACS_Sword_Slash_Circular_Deal_Damage');

		movementAdjustorPlayer.CancelAll();
		ticketPlayer = movementAdjustorPlayer.CreateNewRequest( 'ACSMovAdj' );
		movementAdjustorPlayer.MaxRotationAdjustmentSpeed( ticketPlayer, 500000 );
		movementAdjustorPlayer.MaxLocationAdjustmentSpeed( ticketPlayer, 500000 );
		movementAdjustorPlayer.AdjustLocationVertically( ticketPlayer, true );
		movementAdjustorPlayer.ScaleAnimationLocationVertically( ticketPlayer, true );
		movementAdjustorPlayer.AdjustmentDuration( ticketPlayer, 0.125f );

		if (thePlayer.GetTarget())
		{
			movementAdjustorPlayer.RotateTowards(ticketPlayer, ((CActor)thePlayer.GetTarget()) );
		}
		else
		{
			movementAdjustorPlayer.RotateTo(ticketPlayer, VecHeading(theCamera.GetCameraDirection()));
		}

		Sleep(0.125);

		if (thePlayer.GetPlayerCombatStance() != PCS_AlertNear)
		{
			thePlayer.SetPlayerCombatStance(PCS_AlertNear, true);
			thePlayer.SetPlayerCombatStance(PCS_AlertNear, true);
			thePlayer.SetPlayerCombatStance(PCS_AlertNear, true);
		}

		movementAdjustorPlayer.CancelAll();

		thePlayer.ACS_ClearAnimationSpeedMultipliers();

		thePlayer.ACS_SetAnimationSpeedMultiplier(1);

		thePlayer.RemoveTag('ACS_In_Combat_Art');

		thePlayer.RemoveTag('ACS_Wolven_Cross');

		thePlayer.BlockAllActions( 'ACS_Wolven_Cross', false );

		thePlayer.SetImmortalityMode( AIM_None, AIC_Default, true ); 
		thePlayer.SetCanPlayHitAnim(true); 
		if (!thePlayer.IsUsingHorse()&& !thePlayer.IsUsingVehicle()){thePlayer.EnableCharacterCollisions(true); }	
		thePlayer.RemoveBuffImmunity_AllNegative('acs_dodge'); 
		thePlayer.RemoveBuffImmunity_AllCritical('acs_dodge'); 
		thePlayer.SetIsCurrentlyDodging(false);

		parent.LockEntryFunction(false);

		parent.GotoState('ACS_ORTHANC');
	}
	
	event OnLeaveState( nextStateName : name )
	{
		super.OnLeaveState(nextStateName);
	}	
}


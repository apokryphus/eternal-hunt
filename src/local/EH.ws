				{
					l_flashModule.SetXScale( ACS_Settings_Main_Float('acs_hud_settings_positioning_horse_stamina_and_fear_bar','ACS_FearScale', 100) );
					l_flashModule.SetYScale( ACS_Settings_Main_Float('acs_hud_settings_positioning_horse_stamina_and_fear_bar','ACS_FearScale', 100) );
					l_flashModule.SetZScale( ACS_Settings_Main_Float('acs_hud_settings_positioning_horse_stamina_and_fear_bar','ACS_FearScale', 100) );

					l_flashModule.SetPosition( 

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

statemachine abstract class W3ACSWatcherSecondary extends CEntity
{
	event OnSpawned( spawnData : SEntitySpawnData )
	{
		this.CreateAttachment( thePlayer );	

		this.GotoState('ACS_ORTHANC');
	}
}

state ACS_ORTHANC in W3ACSWatcherSecondary 
{

}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

state ACS_Sword_Glint in W3ACSWatcherSecondary 
{
	var ent, ent_1, ent_2, ent_3, ent_4, ent_5, ent_6, ent_7            : CEntity;
	var rot, attach_rot                        						 	: EulerAngles;
    var pos, attach_vec													: Vector;
	var meshcomp														: CComponent;
	var animcomp 														: CAnimatedComponent;
	var h 																: float;
	var camera 															: CCustomCamera;
	var params             												: SCustomEffectParams;
    var target             												: CNewNPC;
	var actorVictims													: array<CActor>;
	var j 																: int;
	var targetToSourceAngle												: float;

	var interiorCameraDesiredPositionMult 								: float;
	default interiorCameraDesiredPositionMult 							= 10.f;

	event OnEnterState( prevStateName : name )
	{
		ACS_Sword_Glint_Start();

		super.OnEnterState(prevStateName);
	}
	
	private entry function ACS_Sword_Glint_Start()
	{
		parent.LockEntryFunction(true);

		thePlayer.SetGuarded(false);
		thePlayer.OnGuardedReleased();	

		GetWitcherPlayer().BlockAction( EIAB_Crossbow, 			'acs_sword_glint');
		GetWitcherPlayer().BlockAction( EIAB_CallHorse,			'acs_sword_glint');
		GetWitcherPlayer().BlockAction( EIAB_Signs, 				'acs_sword_glint');
		GetWitcherPlayer().BlockAction( EIAB_DrawWeapon, 			'acs_sword_glint'); 
		GetWitcherPlayer().BlockAction( EIAB_FastTravel, 			'acs_sword_glint');
		GetWitcherPlayer().BlockAction( EIAB_Fists, 				'acs_sword_glint');
		GetWitcherPlayer().BlockAction( EIAB_InteractionAction, 	'acs_sword_glint');
		GetWitcherPlayer().BlockAction( EIAB_UsableItem,			'acs_sword_glint');
		GetWitcherPlayer().BlockAction( EIAB_ThrowBomb,			'acs_sword_glint');
		GetWitcherPlayer().BlockAction( EIAB_SwordAttack,			'acs_sword_glint');
		GetWitcherPlayer().BlockAction( EIAB_Jump,				'acs_sword_glint');
		GetWitcherPlayer().BlockAction( EIAB_LightAttacks,		'acs_sword_glint');
		GetWitcherPlayer().BlockAction( EIAB_HeavyAttacks,		'acs_sword_glint');
		GetWitcherPlayer().BlockAction( EIAB_SpecialAttackLight,	'acs_sword_glint');
		GetWitcherPlayer().BlockAction( EIAB_SpecialAttackHeavy,	'acs_sword_glint');
		GetWitcherPlayer().BlockAction( EIAB_MeditationWaiting,	'acs_sword_glint');
		GetWitcherPlayer().BlockAction( EIAB_OpenMeditation,		'acs_sword_glint');
		GetWitcherPlayer().BlockAction( EIAB_RadialMenu,			'acs_sword_glint');
		GetWitcherPlayer().BlockAction( EIAB_Interactions, 		'acs_sword_glint');

		GetACSWatcher().ACS_StaminaDrain(3, true);

		if(thePlayer.GetCombatIdleStance() <= 0.f )
		{
			if (RandF() < 0.5)
			{
				thePlayer.RaiseEvent('ACS_SwordGlintL');
			}
			else
			{
				thePlayer.RaiseEvent('ACS_SwordGlintLAlt');
			}
		}
		else
		{
			if (RandF() < 0.5)
			{
				thePlayer.RaiseEvent('ACS_SwordGlintR');
			}
			else
			{
				thePlayer.RaiseEvent('ACS_SwordGlintRAlt');
			}
		}

		Sleep(0.25);

		if (RandF() < 0.5)
		{
			thePlayer.SoundEvent('souken_zankou_01_bb_acs');
		}
		else
		{
			thePlayer.SoundEvent('souken_zankou_02_bb_acs');
		}

		ACSGetEquippedSword().PlayEffectSingle('fast_attack_buff');

		ACSGetEquippedSword().PlayEffectSingle('fast_attack_buff_hit');

		ACSGetEquippedSword().StopEffect('fast_attack_buff');

		ACSGetEquippedSword().StopEffect('fast_attack_buff_hit');

		rot = thePlayer.GetWorldRotation();

		pos = thePlayer.GetWorldPosition();

		ent = theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync( 

		"dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent"

		, true ), pos, rot );

		ent.AddTag('ACS_Sword_Glint');

		ent.CreateAttachment( thePlayer, 'r_weapon', Vector( 0, 0, RandRangeF(0.75, 0.5) ), EulerAngles(0,0,0) );

		if (GetACSWatcher().LightSourceCheck())
		{
			ent.PlayEffectSingle('sword_glint_fire_source');
		}
		else
		{
			ent.PlayEffectSingle('sword_glint');
		}

		ent.DestroyAfter(0.5);

		GetWitcherPlayer().UnblockAction( EIAB_Crossbow, 			'acs_sword_glint');
		GetWitcherPlayer().UnblockAction( EIAB_CallHorse,			'acs_sword_glint');
		GetWitcherPlayer().UnblockAction( EIAB_Signs, 				'acs_sword_glint');
		GetWitcherPlayer().UnblockAction( EIAB_DrawWeapon, 			'acs_sword_glint'); 
		GetWitcherPlayer().UnblockAction( EIAB_FastTravel, 			'acs_sword_glint');
		GetWitcherPlayer().UnblockAction( EIAB_Fists, 				'acs_sword_glint');
		GetWitcherPlayer().UnblockAction( EIAB_InteractionAction, 	'acs_sword_glint');
		GetWitcherPlayer().UnblockAction( EIAB_UsableItem,			'acs_sword_glint');
		GetWitcherPlayer().UnblockAction( EIAB_ThrowBomb,			'acs_sword_glint');
		GetWitcherPlayer().UnblockAction( EIAB_SwordAttack,			'acs_sword_glint');
		GetWitcherPlayer().UnblockAction( EIAB_Jump,				'acs_sword_glint');
		GetWitcherPlayer().UnblockAction( EIAB_LightAttacks,		'acs_sword_glint');
		GetWitcherPlayer().UnblockAction( EIAB_HeavyAttacks,		'acs_sword_glint');
		GetWitcherPlayer().UnblockAction( EIAB_SpecialAttackLight,	'acs_sword_glint');
		GetWitcherPlayer().UnblockAction( EIAB_SpecialAttackHeavy,	'acs_sword_glint');
		GetWitcherPlayer().UnblockAction( EIAB_MeditationWaiting,	'acs_sword_glint');
		GetWitcherPlayer().UnblockAction( EIAB_OpenMeditation,		'acs_sword_glint');
		GetWitcherPlayer().UnblockAction( EIAB_RadialMenu,			'acs_sword_glint');
		GetWitcherPlayer().UnblockAction( EIAB_Interactions, 		'acs_sword_glint');


		actorVictims.Clear();
		
		actorVictims = GetWitcherPlayer().GetNPCsAndPlayersInRange( 50, 50, , FLAG_ExcludePlayer + FLAG_OnlyAliveActors + FLAG_Attitude_Hostile );

		if( actorVictims.Size() > 0 )
		{
			for( j = 0; j < actorVictims.Size(); j += 1 )
			{
				targetToSourceAngle = AbsF( NodeToNodeAngleDistance(thePlayer, actorVictims[j] ) );		

				if (actorVictims[j] 
				&& actorVictims[j].IsAlive()
				&& targetToSourceAngle < 30
				)
				{
					params.effectType = EET_Blindness;
					params.creator = thePlayer;
					params.sourceName = "ACS_Sword_Glint";
					params.duration = RandRangeF(3,1.5);

					actorVictims[j].AddEffectCustom( params );	

					SleepOneFrame();
				}
			}
		}

		parent.LockEntryFunction(false);

		parent.GotoState('ACS_ORTHANC');
	}
	
	event OnLeaveState( nextStateName : name )
	{
		super.OnLeaveState(nextStateName);
	}	
}

state ACS_ShadowFall in W3ACSWatcherSecondary 
{
	var camera 																																	: CCustomCamera;
	var target																																	: CActor;
	var playerPos																																: Vector;
	var markerNPC_1, markerNPC_2, markerNPC_3, markerNPC_4, markerNPC_5, markerNPC_6															: CEntity;
	var ent_tornado_01, ent_tornado_02, ent_tornado_03, ent_tornado_04, ent_tornado_05, ent_tornado_06, ent_tornado_07							: CEntity;
	var markerTemplate_1 																														: CEntityTemplate;
	var movementAdjustorPlayer																													: CMovementAdjustor;
	var ticketPlayer																															: SMovementAdjustmentRequestTicket;
	var dist																																	: float;
	var animatedComponentPlayer																													: CAnimatedComponent;
	var rot																																		: EulerAngles;
	var pos																																		: Vector;
	var torsoBoneIndex																															: int;
	var attach_vec																																: Vector;
	var attach_rot																																: EulerAngles;
	var meshcomp																																: CComponent;
	var animcomp 																																: CAnimatedComponent;
	var paramsFlip																																: SCustomEffectParams;
	var interiorCameraDesiredPositionMult 								: float;
	default interiorCameraDesiredPositionMult 							= 10.f;

	event OnEnterState( prevStateName : name )
	{
		ACS_ShadowFall_Start();

		super.OnEnterState(prevStateName);
	}
	
	private entry function ACS_ShadowFall_Start()
	{
		parent.LockEntryFunction(true);

		thePlayer.BlockAllActions( 'ACS_ShadowFall', true );

		GetWitcherPlayer().DrainFocus( GetWitcherPlayer().GetStatMax( BCS_Focus ) * 0.33 );

		animatedComponentPlayer = (CAnimatedComponent)(thePlayer).GetComponentByClassName( 'CAnimatedComponent' );	

		movementAdjustorPlayer = GetWitcherPlayer().GetMovingAgentComponent().GetMovementAdjustor();

		if (thePlayer.GetTarget())
		{
			target = ((CActor)thePlayer.GetTarget());
		}

		playerPos = TraceFloor(thePlayer.GetWorldPosition());

		thePlayer.SetImmortalityMode( AIM_Invulnerable, AIC_Default, true ); 
		thePlayer.SetCanPlayHitAnim(false); 
		thePlayer.AddBuffImmunity_AllNegative('acs_dodge', true); 
		thePlayer.AddBuffImmunity_AllCritical('acs_dodge', true); 
		thePlayer.SetIsCurrentlyDodging(true);
		if (!thePlayer.IsUsingHorse()&& !thePlayer.IsUsingVehicle()){thePlayer.EnableCharacterCollisions(true); }	

		Sleep(0.1);

		thePlayer.AddTag('ACS_In_Combat_Art');

		thePlayer.AddTag('ACS_ShadowFall');

		GetACSWatcher().RemoveTimer('SwordTauntSwitch'); 
		GetACSWatcher().RemoveTimer('SwordTauntRunningSwitch'); 
		 
		thePlayer.RaiseEvent('ACS_SwordTauntEnd');
		thePlayer.RaiseEvent('ACS_CombatTauntEnd');
		
		GetACSWatcher().RemoveTimer('CombatTauntDelay');
		GetACSWatcher().RemoveTimer('SwordTauntRunningSwitchSecondary'); 
		GetACSWatcher().RemoveTimer('SwordTauntRunningSwitchSecondaryWeaponBlood'); 

		thePlayer.StopEffect('special_attack_break');

		thePlayer.PlayEffectSingle('special_attack_break');

		thePlayer.StopEffect('special_attack_break');

		thePlayer.StopEffect('jump_ground_fx1');
		thePlayer.PlayEffect('jump_ground_fx1');

		if(RandF() < 0.5)
		{
			thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( 'woman_ciri_sword_special_heavy_attack_short_rp_ACS', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f) );
		}
		else
		{
			thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( 'woman_ciri_sword_special_heavy_attack_short_lp_ACS', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f) );
		}

		movementAdjustorPlayer.CancelAll();
		ticketPlayer = movementAdjustorPlayer.CreateNewRequest( 'ACSMovAdj' );
		movementAdjustorPlayer.AdjustmentDuration( ticketPlayer, 0.125 );
		movementAdjustorPlayer.MaxRotationAdjustmentSpeed( ticketPlayer, 5000 );
		movementAdjustorPlayer.MaxLocationAdjustmentSpeed( ticketPlayer, 5000 );

		if (target)
		{
			movementAdjustorPlayer.RotateTowards(ticketPlayer, target );
		}
		else
		{
			movementAdjustorPlayer.RotateTo(ticketPlayer, VecHeading(theCamera.GetCameraDirection()));
		}

		GetACSWatcher().Marker_Smoke();


		Sleep(0.2);

		thePlayer.StopEffect('special_attack_short_fx');
		thePlayer.PlayEffectSingle('special_attack_short_fx');

		thePlayer.StopEffect('shadowdash_shockwave');

		thePlayer.PlayEffectSingle('shadowdash_shockwave');

		thePlayer.StopEffect('shadowdash_shockwave');

		Sleep(0.2);

		movementAdjustorPlayer.CancelAll();
		ticketPlayer = movementAdjustorPlayer.CreateNewRequest( 'ACSMovAdj' );
		movementAdjustorPlayer.AdjustmentDuration( ticketPlayer, 0.125 );
		movementAdjustorPlayer.MaxRotationAdjustmentSpeed( ticketPlayer, 5000 );
		movementAdjustorPlayer.MaxLocationAdjustmentSpeed( ticketPlayer, 5000 );
		movementAdjustorPlayer.AdjustLocationVertically( ticketPlayer, true );
		movementAdjustorPlayer.ScaleAnimationLocationVertically( ticketPlayer, true );

		if (target)
		{
			dist = ((((CMovingPhysicalAgentComponent)(target).GetMovingAgentComponent()).GetCapsuleRadius())
			+ (((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent()).GetCapsuleRadius()) ) ;


			movementAdjustorPlayer.RotateTowards(ticketPlayer, target );
			movementAdjustorPlayer.SlideTowards( ticketPlayer, target, dist, dist );
		}
		else
		{
			movementAdjustorPlayer.RotateTo(ticketPlayer, VecHeading(theCamera.GetCameraDirection()));
			movementAdjustorPlayer.SlideTo( ticketPlayer, TraceFloor(thePlayer.GetWorldPosition() + thePlayer.GetWorldForward() * 7.5) );
		}

		Sleep(0.5);

		markerNPC_1.DestroyAfter(1);

		thePlayer.EnableCollisions(false);

		thePlayer.StopEffect('special_attack_short_fx');

		thePlayer.ACS_ClearAnimationSpeedMultipliers();

		thePlayer.ACS_SetAnimationSpeedMultiplier(2.5);

		movementAdjustorPlayer.CancelAll();
		ticketPlayer = movementAdjustorPlayer.CreateNewRequest( 'ACSMovAdj' );
		movementAdjustorPlayer.AdjustmentDuration( ticketPlayer, 0.125 );
		movementAdjustorPlayer.MaxRotationAdjustmentSpeed( ticketPlayer, 5000 );
		movementAdjustorPlayer.MaxLocationAdjustmentSpeed( ticketPlayer, 5000 );
		movementAdjustorPlayer.AdjustLocationVertically( ticketPlayer, true );
		movementAdjustorPlayer.ScaleAnimationLocationVertically( ticketPlayer, true );

		if (thePlayer.GetTarget())
		{
			paramsFlip.effectType = EET_Stagger;
			paramsFlip.creator = thePlayer;
			paramsFlip.sourceName = "ACS_ShadowFall";
			paramsFlip.duration = 1;

			target.AddEffectCustom( paramsFlip );	

			movementAdjustorPlayer.RotateTowards(ticketPlayer, target );

			movementAdjustorPlayer.SlideTo(ticketPlayer, TraceFloor((thePlayer.GetWorldPosition() + target.GetWorldPosition()) * 0.5 ) + Vector(0,0,2.75));
		}
		else
		{
			movementAdjustorPlayer.RotateTo(ticketPlayer, VecHeading(theCamera.GetCameraDirection()));

			movementAdjustorPlayer.SlideTo(ticketPlayer, TraceFloor(thePlayer.GetWorldPosition()) + Vector(0,0,2.75));
		}

		if (RandF() < 0.5)
		{
			thePlayer.RaiseEvent('ACS_FlipKick');
		}
		else
		{
			thePlayer.RaiseEvent('ACS_Backflip01');
		}

		if (RandF() < 0.5)
		{
			thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( 'man_npc_sword_1hand_charge_attack_rf_r_ACS', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0.125f, 0.125f) );
		}
		else
		{
			thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( 'man_npc_sword_1hand_charge_attack_lf_l_ACS', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0.125f, 0.125f) );
		}

		thePlayer.StopEffect('shadowdash_shockwave');

		thePlayer.PlayEffectSingle('shadowdash_shockwave');

		thePlayer.StopEffect('shadowdash_shockwave');

		Sleep(0.25);

		thePlayer.StopEffect('special_attack_short_fx');
		thePlayer.PlayEffectSingle('special_attack_short_fx');
		thePlayer.StopEffect('special_attack_short_fx');

		thePlayer.StopEffect('shadowdash_shockwave');

		thePlayer.PlayEffectSingle('shadowdash_shockwave');

		thePlayer.StopEffect('shadowdash_shockwave');

		thePlayer.ACS_ClearAnimationSpeedMultipliers();

		thePlayer.ACS_SetAnimationSpeedMultiplier(1);

		movementAdjustorPlayer.CancelAll();
		ticketPlayer = movementAdjustorPlayer.CreateNewRequest( 'ACSMovAdj' );
		movementAdjustorPlayer.AdjustmentDuration( ticketPlayer, 0.125 );
		movementAdjustorPlayer.MaxRotationAdjustmentSpeed( ticketPlayer, 5000 );
		movementAdjustorPlayer.MaxLocationAdjustmentSpeed( ticketPlayer, 5000 );
		movementAdjustorPlayer.AdjustLocationVertically( ticketPlayer, true );
		movementAdjustorPlayer.ScaleAnimationLocationVertically( ticketPlayer, true );

		if (target)
		{
			movementAdjustorPlayer.RotateTowards(ticketPlayer, target );

			movementAdjustorPlayer.SlideTo(ticketPlayer, TraceFloor((thePlayer.GetWorldPosition() + target.GetWorldPosition()) * 0.5 ) + Vector(0,0,1.75));
		}
		else
		{
			movementAdjustorPlayer.RotateTo(ticketPlayer, VecHeading(theCamera.GetCameraDirection()));

			movementAdjustorPlayer.SlideTo(ticketPlayer, TraceFloor(thePlayer.GetWorldPosition()) + Vector(0,0,1.75));
		}

		thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( 'man_geralt_feainnewedd_dance_02_ACS', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0.125f, 0.125f) );

		markerNPC_2 = theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync( 

		"dlc\dlc_acs\data\fx\sword_slash_circular\acs_sword_slash_circular.w2ent"

		, true ), (thePlayer.GetWorldPosition() + thePlayer.GetWorldForward() * 2) + (Vector(0,0,-1.75)), thePlayer.GetWorldRotation() );

		markerNPC_2.AddTag('ACS_Sword_Slash_Circular_Singular');

		markerNPC_2.AddTag('ACS_Sword_Slash_Circular_Deal_Damage');

		Sleep(0.75);

		thePlayer.StopEffect('special_attack_short_fx');
		thePlayer.PlayEffectSingle('special_attack_short_fx');
		thePlayer.StopEffect('special_attack_short_fx');

		thePlayer.StopEffect('shadowdash_shockwave');

		thePlayer.PlayEffectSingle('shadowdash_shockwave');

		thePlayer.StopEffect('shadowdash_shockwave');

		thePlayer.ACS_ClearAnimationSpeedMultipliers();

		thePlayer.ACS_SetAnimationSpeedMultiplier(2);

		markerNPC_3 = theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync( 

		"dlc\dlc_acs\data\fx\sword_slash_circular\acs_sword_slash_circular.w2ent"

		, true ), (thePlayer.GetWorldPosition() + thePlayer.GetWorldForward() * 4) + (Vector(0,0,1.5)), thePlayer.GetWorldRotation() );

		markerNPC_3.AddTag('ACS_Sword_Slash_Circular_Medium');

		markerNPC_3.AddTag('ACS_Sword_Slash_Wolven_Flash_Primary');

		markerNPC_3.AddTag('ACS_Sword_Slash_Circular_Deal_Damage');

		thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( 'man_geralt_sword_attack_heavy_special_rp_end', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.5f) );

		thePlayer.EnableCollisions(true);

		movementAdjustorPlayer.CancelAll();
		ticketPlayer = movementAdjustorPlayer.CreateNewRequest( 'ACSMovAdj' );
		movementAdjustorPlayer.AdjustmentDuration( ticketPlayer, 0.25 );
		movementAdjustorPlayer.MaxRotationAdjustmentSpeed( ticketPlayer, 5000 );
		movementAdjustorPlayer.MaxLocationAdjustmentSpeed( ticketPlayer, 5000 );
		movementAdjustorPlayer.AdjustLocationVertically( ticketPlayer, true );
		movementAdjustorPlayer.ScaleAnimationLocationVertically( ticketPlayer, true );

		if (target)
		{
			movementAdjustorPlayer.RotateTowards(ticketPlayer, target );
		}
		else
		{
			movementAdjustorPlayer.RotateTo(ticketPlayer, VecHeading(theCamera.GetCameraDirection()));
		}

		movementAdjustorPlayer.SlideTo(ticketPlayer, TraceFloor(thePlayer.GetWorldPosition()));

		Sleep(0.25);

		if (thePlayer.GetPlayerCombatStance() != PCS_AlertNear)
		{
			thePlayer.SetPlayerCombatStance(PCS_AlertNear, true);
			thePlayer.SetPlayerCombatStance(PCS_AlertNear, true);
			thePlayer.SetPlayerCombatStance(PCS_AlertNear, true);
		}

		thePlayer.ACS_ClearAnimationSpeedMultipliers();

		thePlayer.ACS_SetAnimationSpeedMultiplier(1);

		//thePlayer.SoundEvent("monster_nazair_guard_combat_hits_ground");

		thePlayer.SoundEvent("monster_cloud_giant_fx_rumble_crack");

		thePlayer.PlayEffect('sword_ground_hit');

		thePlayer.StopEffect('sword_ground_hit');

		thePlayer.RemoveTag('ACS_In_Combat_Art');

		thePlayer.RemoveTag('ACS_ShadowFall');

		thePlayer.BlockAllActions( 'ACS_ShadowFall', false );

		thePlayer.SetImmortalityMode( AIM_None, AIC_Default, true ); 
		thePlayer.SetCanPlayHitAnim(true); 
		if (!thePlayer.IsUsingHorse()&& !thePlayer.IsUsingVehicle()){thePlayer.EnableCharacterCollisions(true); }	
		thePlayer.RemoveBuffImmunity_AllNegative('acs_dodge'); 
		thePlayer.RemoveBuffImmunity_AllCritical('acs_dodge'); 
		thePlayer.SetIsCurrentlyDodging(false);

		parent.LockEntryFunction(false);

		parent.GotoState('ACS_ORTHANC');
	}
	
	event OnLeaveState( nextStateName : name )
	{
		super.OnLeaveState(nextStateName);
	}	
}

state ACS_Wolven_Flash in W3ACSWatcherSecondary 
{
	var camera 																									: CCustomCamera;
	var evadeTarget																								: CActor;
	var playerPos																								: Vector;
	var markerNPC_1, markerNPC_2, markerNPC_3, markerNPC_4, markerNPC_5, markerNPC_6							: CEntity;
	var markerTemplate_1 																						: CEntityTemplate;

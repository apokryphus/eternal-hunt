	protected var m_mapMenu : CR4MapMenu;
	protected var m_shownArea : EAreaName;
	private var m_questMapPinInstances : array<SCommonMapPinInstance>;
	private var m_questMapPins : array<ACSQuestMapPin>;

	private var m_currentTrackedQuest : CJournalQuest;
	private var m_currentHighlightedObjective : CJournalQuestObjective;

	function ACS_ProcessAllQuests()
	{
		var i, j, k : int;
		var questsList : array<CJournalBase>;
		var questItem : CJournalQuest;
		var questPhase : CJournalQuestPhase;
		var questObjective : CJournalQuestObjective;

		m_questMapPins.Clear();

		m_journalManager.GetActivatedOfType('CJournalQuest', questsList);

		for (i = 0; i < questsList.Size(); i += 1) 
		{
			questItem = (CJournalQuest) questsList[i];

			if (questItem 
			&& m_journalManager.GetEntryStatus(questItem) == JS_Active) 
			{
				for (j = 0; j < questItem.GetNumChildren(); j += 1) 
				{
					questPhase = (CJournalQuestPhase) questItem.GetChild(j);

					if (questPhase 
					&& m_journalManager.GetEntryStatus(questPhase) == JS_Active) 
					{
						for (k = 0; k < questPhase.GetNumChildren(); k += 1) 
						{
							questObjective = (CJournalQuestObjective) questPhase.GetChild(k);

							if (questObjective 
							&& m_journalManager.GetEntryStatus(questObjective) == JS_Active) 
							{
								ACS_ProcessQuestObjective(questObjective);
							}
						}
					}
				}	
			}
		}
	}

	private function ACS_ProcessQuestObjective(questObjective : CJournalQuestObjective)
	{
		var i : int;
		var questMapPin : CJournalQuestMapPin;

		for (i = 0; i < questObjective.GetNumChildren(); i += 1) 
		{
			questMapPin = (CJournalQuestMapPin) questObjective.GetChild(i);

			if (questMapPin) 
			{
				ACS_ProcessQuestMapPin(questObjective, questMapPin);
			}
		}
	}

	private function ACS_ProcessQuestMapPin(questObjective : CJournalQuestObjective, questMapPin : CJournalQuestMapPin)
	{
		var qpin : ACSQuestMapPin;

		qpin.tag = questMapPin.GetMapPinID();
		qpin.questArea = questObjective.GetWorld();
		qpin.questObjective = questObjective;
		qpin.titleStringId = questObjective.GetParentQuest().GetTitleStringId();
		qpin.descriptionStringId = questObjective.GetTitleStringId();

		ACS_SetAreaAndPositionForQuestMapPin(qpin);

		m_questMapPins.PushBack(qpin);
	}

	private function ACS_SetAreaAndPositionForQuestMapPin(out qpin : ACSQuestMapPin)
	{
		var i : int;
		var unknownArea : bool = (qpin.questArea == AN_Undefined);
		var pinForShownArea : bool = !unknownArea;
		var pinInstances : array<SCommonMapPinInstance>;
		var pos : Vector;

		if (pinForShownArea || unknownArea) 
		{
			for (i = 0; i < m_questMapPinInstances.Size(); i += 1) 
			{
				if (m_questMapPinInstances[i].tag == qpin.tag) 
				{
					pos = m_questMapPinInstances[i].position;

					qpin.position = pos;

					qpin.areaPosType = ACSAreaPos_Invalid;

					if (unknownArea) 
					{
						qpin.questArea = m_shownArea;
					}

					return;
				}
			}
		}


		if (qpin.questObjective.GetParentQuest().guid == m_currentTrackedQuest.guid) 
		{
			qpin.areaPosType = ACSAreaPos_Unknown;

			return;
		}

		for (i = 0; i < m_cachedQuestMapPins.Size(); i += 1)
		{
			if (m_cachedQuestMapPins[i].tag == qpin.tag) 
			{
				if (m_cachedQuestMapPins[i].areaPosType != ACSAreaPos_Unknown) 
				{
					pos = m_cachedQuestMapPins[i].position;

					qpin.position = pos;
					qpin.areaPosType = m_cachedQuestMapPins[i].areaPosType;

					if (unknownArea) 
					{
						qpin.questArea = m_cachedQuestMapPins[i].questArea;
					}

					return;
				}

				break;
			}
		}

		if (pinForShownArea || unknownArea) 
		{
			m_journalManager.SetTrackedQuest(qpin.questObjective.GetParentQuest());

			m_journalManager.SetHighlightedObjective(qpin.questObjective);

			//pinInstances = m_commonMapManager.GetMapPinInstances(m_commonMapManager.GetWorldPathFromAreaType(m_shownArea));

			pinInstances.Clear();

			pinInstances = theGame.GetCommonMapManager().GetMapPinInstances(theGame.GetWorld().GetPath());

			for (i = 0; i < pinInstances.Size(); i += 1) 
			{
				if (pinInstances[i].isDiscovered || pinInstances[i].isKnown) 
				{
					if ((pinInstances[i].tag == qpin.tag) 
					&& m_commonMapManager.IsQuestPinType(pinInstances[i].type)
					&& (pinInstances[i].guid == qpin.questObjective.guid)) 
					{
						pos = pinInstances[i].position;

						qpin.position = pos;
						qpin.areaPosType = ACSAreaPos_Valid;

						if (unknownArea) 
						{
							qpin.questArea = m_shownArea;
						}

						return;
					}
				}
			}
		}

		if (pinForShownArea || unknownArea)
		{
			qpin.areaPosType = ACSAreaPos_Invalid;
		} 
		else 
		{
			qpin.areaPosType = ACSAreaPos_Unknown;
		}
	}

	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	private var untrackedQuestMarkerFadeOut : float;
	default untrackedQuestMarkerFadeOut = 100;

	timer function untrackedQuestMarkerFadeOut(dt : float , id : int)
	{	
		var actors 											: array<CEntity>;
		var i												: int;

		GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Untracked_Quest_GUI_Marker", untrackedQuestMarkerFadeOut);

		if (untrackedQuestMarkerFadeOut <= 0)
		{
			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Untracked_Quest_GUI_Marker", 100);

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Untracked_Quest_GUI_Marker");

			if (ACS_Guiding_Light_Untracked_Quest_Marker_Distance_Available)
			{
				ACS_Guiding_Light_Untracked_Quest_Marker_Distance_Available = false;
			}
			
			actors.Clear();

			theGame.GetEntitiesByTag( 'ACS_All_Tracked_Quest_Entity', actors );	
			
			for( i = 0; i < actors.Size(); i += 1 )
			{
				actors[i].Destroy();
			}

			untrackedQuestMarkerFadeOut = 100;

			RemoveTimer('untrackedQuestMarkerFadeOut');
		}
		else
		{
			untrackedQuestMarkerFadeOut -= 1;
		}
	}

	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	function GuidingEntities()
	{
		var iconPath 							: string;
		var markers 							: array<CEntity>;
		var i, markerID							: int;
		var distance 							: float;

		m_commonMapManager = theGame.GetCommonMapManager();
		m_journalManager = theGame.GetJournalManager();

		m_currentTrackedQuest = m_journalManager.GetTrackedQuest();
		m_currentHighlightedObjective = m_journalManager.GetHighlightedObjective();

		if (!m_quickUpdateEntityPins) 
		{
			ACS_ProcessAllQuests();
		}

		if (m_currentTrackedQuest.guid != m_journalManager.GetTrackedQuest().guid) 
		{
			m_journalManager.SetTrackedQuest(m_currentTrackedQuest);
		}
		if (m_currentHighlightedObjective.guid != m_journalManager.GetHighlightedObjective().guid) 
		{
			m_journalManager.SetHighlightedObjective(m_currentHighlightedObjective);
		}

		CreateGuidingEntities();

		if (!m_quickUpdateEntityPins) 
		{
			m_cachedQuestMapPins = m_questMapPins;
		}

		GetACSStorage().acs_deleteOnelinerByTag("ACS_Untracked_Quest_GUI_Marker");

		iconPath = FormatIconPath("icons/inventory/acs_marker_quest_untracked.xbm");
		
		markers.Clear();

		theGame.GetEntitiesByTag( 'ACS_All_Tracked_Quest_Entity', markers );	

		for( i = 0; i < markers.Size(); i += 1 )
		{
			ACS_Oneliner(iconPath, markers[i], "ACS_Untracked_Quest_GUI_Marker");

			GetACSStorage().acs_setScaleForOnelinerByTag("ACS_Untracked_Quest_GUI_Marker", 100, 100, 100);
		}

		GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Untracked_Quest_GUI_Marker", 100);
	}

	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	var ACS_TrackedQuestEntsControl : bool;

	function Guiding_Light_Tracked_Quest_Scan()
	{
		var compass_check : bool;

		if (ACS_Settings_Main_Float('acs_hud_settings_markers','acs_untracked_quest_marker_despawn_delay', 7) != 0
		&& theGame.GetJournalManager().GetTrackedQuest().baseName != "ACS Exploration"
		)
		{
			ACSTrackedQuestsEntsTeleportRotate();
		}
		else
		{
			if (ACS_TrackedQuestEntsControl)
			{
				ACSTrackedQuestsEntsDestroy();

				ACS_TrackedQuestEntsControl = false;
			}

			return;
		}

		if(RadialMenuCheck()
		|| HudExceptionCheck() 
		|| ACS_GetNearbyEnemyLocation() != Vector(0,0,-200)
		|| ACS_MapPinsCheck()
		|| thePlayer.IsAnyWeaponHeld()
		)
		{
			
				if (!ACS_TrackedQuestEntsControl )
				{
					RemoveTimer('ACSTrackedQuestsEntsDestroyDelay');

					if (ACS_Settings_Main_Float('acs_hud_settings_markers','acs_untracked_quest_marker_despawn_delay', 7) != 0
					&& theGame.GetJournalManager().GetTrackedQuest().baseName != "ACS Exploration"
					)
					{
						GuidingEntities();

						ACS_Guiding_Light_Untracked_Quest_Marker_Distance_Available = true;
					}

					ACS_TrackedQuestEntsControl = true;
				}
			
		}
		else
		{
			if (ACS_TrackedQuestEntsControl)
			{
				RemoveTimer('ACSTrackedQuestsEntsDestroyDelay');
				AddTimer('ACSTrackedQuestsEntsDestroyDelay', ACS_Settings_Main_Float('acs_hud_settings_markers','acs_untracked_quest_marker_despawn_delay', 7) , false);

				ACS_TrackedQuestEntsControl = false;
			}
		}
	}

	function ACSTrackedQuestsEntsDestroy()
	{	
		var actors 											: array<CEntity>;
		var i												: int;

		RemoveTimer('ACSTrackedQuestsEntsDestroyDelay');

		untrackedQuestMarkerFadeOut = 100;
		RemoveTimer('untrackedQuestMarkerFadeOut');

		GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Untracked_Quest_GUI_Marker", 100);

		GetACSStorage().acs_deleteOnelinerByTag("ACS_Untracked_Quest_GUI_Marker");

		GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Untracked_Quest_Distance_GUI_Marker", 100);
		
		GetACSStorage().acs_deleteOnelinerByTag("ACS_Untracked_Quest_Distance_GUI_Marker");

		if (ACS_Guiding_Light_Untracked_Quest_Marker_Distance_Available)
		{
			ACS_Guiding_Light_Untracked_Quest_Marker_Distance_Available = false;
		}

		actors.Clear();

		theGame.GetEntitiesByTag( 'ACS_All_Tracked_Quest_Entity', actors );	

		if (actors.Size() <= 0)
		{
			return;
		}
		
		for( i = 0; i < actors.Size(); i += 1 )
		{
			actors[i].Destroy();
		}
	}

	function ACSTrackedQuestsEntsTeleportRotate()
	{	
		var actors 											: array<CEntity>;
		var i												: int;
		var rot, newRot          							: EulerAngles;
		var targetDistance									: float;
		
		actors.Clear();

		theGame.GetEntitiesByTag( 'ACS_All_Tracked_Quest_Entity', actors );	

		if (actors.Size() <= 0)
		{
			return;
		}
		
		for( i = 0; i < actors.Size(); i += 1 )
		{
			if ( theGame.IsDialogOrCutscenePlaying() 
			|| theGame.IsFading()
			|| theGame.IsBlackscreen()
			|| theGame.IsPaused() 
			|| theGame.GetPhotomodeEnabled() 
			|| thePlayer.IsInCutsceneIntro() 
			)
			{
				actors[i].DestroyEffect('untracked_quest_marker_small');
				actors[i].DestroyEffect('untracked_quest_marker_smaller');
				actors[i].DestroyEffect('untracked_quest_marker');
				actors[i].DestroyEffect('untracked_quest_marker_bigger');
				actors[i].DestroyEffect('untracked_quest_marker_biggest');
				actors[i].DestroyEffect('untracked_quest_marker_biggest_x2');
				actors[i].DestroyEffect('untracked_quest_marker_biggest_x4');
				actors[i].DestroyEffect('pridefall_marker');

				untrackedQuestMarkerFadeOut = 100;
				RemoveTimer('untrackedQuestMarkerFadeOut');

				GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Untracked_Quest_GUI_Marker", 100);

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Untracked_Quest_GUI_Marker");
				
				if (ACS_Guiding_Light_Untracked_Quest_Marker_Distance_Available)
				{
					GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Untracked_Quest_Distance_GUI_Marker", 100);

					GetACSStorage().acs_deleteOnelinerByTag("ACS_Untracked_Quest_Distance_GUI_Marker");

					ACS_Guiding_Light_Untracked_Quest_Marker_Distance_Available = false;
				}
			}
			else
			{
				targetDistance = VecDistanceSquared2D( GetWitcherPlayer().GetWorldPosition(), actors[i].GetWorldPosition() ) ;

				if (ACS_Settings_Main_Bool('acs_hud_settings_markers','acs_marker_bubble_enabled', false))
				{
					if (targetDistance <= 5 * 5)
					{
						actors[i].StopEffect('untracked_quest_marker_smaller');
						actors[i].StopEffect('untracked_quest_marker_small');
						actors[i].StopEffect('untracked_quest_marker');
						actors[i].StopEffect('untracked_quest_marker_bigger');
						actors[i].StopEffect('untracked_quest_marker_biggest');
						actors[i].StopEffect('untracked_quest_marker_biggest_x2');
						actors[i].StopEffect('untracked_quest_marker_biggest_x4');
					}
					else if (targetDistance > 5 * 5 && targetDistance <= 10 * 10)
					{
						actors[i].StopEffect('untracked_quest_marker_small');
						actors[i].StopEffect('untracked_quest_marker');
						actors[i].StopEffect('untracked_quest_marker_bigger');
						actors[i].StopEffect('untracked_quest_marker_biggest');
						actors[i].StopEffect('untracked_quest_marker_biggest_x2');
						actors[i].StopEffect('untracked_quest_marker_biggest_x4');

						if (!actors[i].IsEffectActive('untracked_quest_marker_smaller', false))
						{
							actors[i].PlayEffectSingle('untracked_quest_marker_smaller');
						}
					}
					else if (targetDistance > 10 * 10 && targetDistance <= 25 * 25)
					{
						actors[i].StopEffect('untracked_quest_marker_smaller');
						actors[i].StopEffect('untracked_quest_marker');
						actors[i].StopEffect('untracked_quest_marker_bigger');
						actors[i].StopEffect('untracked_quest_marker_biggest');
						actors[i].StopEffect('untracked_quest_marker_biggest_x2');
						actors[i].StopEffect('untracked_quest_marker_biggest_x4');

						if (!actors[i].IsEffectActive('untracked_quest_marker_small', false))
						{
							actors[i].PlayEffectSingle('untracked_quest_marker_small');
						}
					}
					else if (targetDistance > 25 * 25 && targetDistance <= 50 * 50)
					{
						actors[i].StopEffect('untracked_quest_marker_smaller');
						actors[i].StopEffect('untracked_quest_marker_small');
						actors[i].StopEffect('untracked_quest_marker_bigger');
						actors[i].StopEffect('untracked_quest_marker_biggest');
						actors[i].StopEffect('untracked_quest_marker_biggest_x2');
						actors[i].StopEffect('untracked_quest_marker_biggest_x4');

						if (!actors[i].IsEffectActive('untracked_quest_marker', false))
						{
							actors[i].PlayEffectSingle('untracked_quest_marker');
						}
					}
					else if (targetDistance > 50 * 50 && targetDistance <= 100 * 100)
					{
						actors[i].StopEffect('untracked_quest_marker_smaller');
						actors[i].StopEffect('untracked_quest_marker_small');
						actors[i].StopEffect('untracked_quest_marker');
						actors[i].StopEffect('untracked_quest_marker_biggest');
						actors[i].StopEffect('untracked_quest_marker_biggest_x2');
						actors[i].StopEffect('untracked_quest_marker_biggest_x4');

						if (!actors[i].IsEffectActive('untracked_quest_marker_bigger', false))
						{
							actors[i].PlayEffectSingle('untracked_quest_marker_bigger');
						}
					}
					else if (targetDistance > 100 * 100)
					{
						actors[i].StopEffect('untracked_quest_marker_smaller');
						actors[i].StopEffect('untracked_quest_marker_small');
						actors[i].StopEffect('untracked_quest_marker');
						actors[i].StopEffect('untracked_quest_marker_bigger');
						actors[i].StopEffect('untracked_quest_marker_biggest_x2');
						actors[i].StopEffect('untracked_quest_marker_biggest_x4');

						if (!actors[i].IsEffectActive('untracked_quest_marker_biggest', false))
						{
							actors[i].PlayEffectSingle('untracked_quest_marker_biggest');
						}
					}
				}
				else
				{
					actors[i].DestroyEffect('untracked_quest_marker_small');
					actors[i].DestroyEffect('untracked_quest_marker_smaller');
					actors[i].DestroyEffect('untracked_quest_marker');
					actors[i].DestroyEffect('untracked_quest_marker_bigger');
					actors[i].DestroyEffect('untracked_quest_marker_biggest');
					actors[i].DestroyEffect('untracked_quest_marker_biggest_x2');
					actors[i].DestroyEffect('untracked_quest_marker_biggest_x4');
					actors[i].DestroyEffect('pridefall_marker');
				}

				if (!ACS_Settings_Main_Bool('acs_hud_settings_main','acs_guiding_light_enabled', false))
				{
					actors[i].DestroyEffect('pridefall_marker');
				}
				else
				{
					if (!actors[i].IsEffectActive('pridefall_marker', false))
					{
						actors[i].PlayEffectSingle('pridefall_marker');
					}
				}
			}
		}
	}

	timer function ACSTrackedQuestsEntsDestroyDelay ( dt : float, id : int)
	{
		untrackedQuestMarkerFadeOut = 100;
		RemoveTimer('untrackedQuestMarkerFadeOut');
		AddTimer('untrackedQuestMarkerFadeOut', 0.01 , true);

		GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Untracked_Quest_Distance_GUI_Marker", 100);

		GetACSStorage().acs_deleteOnelinerByTag("ACS_Untracked_Quest_Distance_GUI_Marker");

		if (ACS_Guiding_Light_Untracked_Quest_Marker_Distance_Available)
		{
			ACS_Guiding_Light_Untracked_Quest_Marker_Distance_Available = false;
		}
	}

	function ACS_Guiding_Light_Untracked_Marker_Distance_Actual()
	{
		var iconPath, zPositioning				: string;
		var markers 							: array<CEntity>;
		var i, j, markerID						: int;
		var playerPosition, markerPosition 		: Vector;
		var distance 							: float;
		var qpin 								: String;
		var untracked_quest_names 				: array<String>;

		GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Untracked_Quest_Distance_GUI_Marker", 100);

		GetACSStorage().acs_deleteOnelinerByTag("ACS_Untracked_Quest_Distance_GUI_Marker");

		markers.Clear();

		theGame.GetEntitiesByTag( 'ACS_All_Tracked_Quest_Entity', markers );	

		untracked_quest_names = acs_untracked_quest_names;

		if (markers.Size() <= 0)
		{
			return;
		}

		if(RadialMenuCheck()
		|| HudExceptionCheck() 
		|| ACS_GetNearbyEnemyLocation() != Vector(0,0,-200)
		|| ACS_MapPinsCheck()
		|| thePlayer.IsAnyWeaponHeld()
		)
		{
			for( i = 0; i < markers.Size(); i += 1 )
			{
				playerPosition = thePlayer.GetWorldPosition();

				markerPosition = markers[i].GetWorldPosition();

				distance = VecDistance(playerPosition, markerPosition);

				if ((AbsF(playerPosition.Z - markerPosition.Z) <= 4)
				|| distance >= 50
				)
				{
					zPositioning = "";
				}
				else
				{
					if (playerPosition.Z > markerPosition.Z)
					{
						zPositioning = " - " + "[" + GetLocStringByKeyExt("fake_key_z98k3yl8") + "]";
					}
					else if (playerPosition.Z < markerPosition.Z)
					{
						zPositioning = " - " + "[" + GetLocStringByKeyExt("fake_key_dk0zqae") + "]";
					}
					else
					{
						zPositioning = "";
					}
				}

				qpin = untracked_quest_names[i];

				if (distance <= 4.5 )
				{
					iconPath = "<font size = '16' color = '#918c3f'>" + "[" + qpin + "]" + "<br/><br/><br/><br/>" + "[" + GetLocStringByKeyExt("fake_key_1h78y_j") + "]" + zPositioning + "</font>";
				}
				else
				{
					iconPath = "<font size = '16' color = '#918c3f'>" + "[" + qpin + "]" + "<br/><br/><br/><br/>" + "[" + FloatToStringPrec(distance, 0) + "m" + "]" + zPositioning + "</font>";
				}
				
				ACS_Oneliner(iconPath, markers[i], "ACS_Untracked_Quest_Distance_GUI_Marker");
			}

			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Untracked_Quest_Distance_GUI_Marker", 100);

			GetACSStorage().acs_setScaleForOnelinerByTag("ACS_Untracked_Quest_Distance_GUI_Marker", 100, 100, 100);
		}
		else
		{
			for( i = 0; i < markers.Size(); i += 1 )
			{
				playerPosition = thePlayer.GetWorldPosition();

				markerPosition = markers[i].GetWorldPosition();

				distance = VecDistance(playerPosition, markerPosition);

				if ((AbsF(playerPosition.Z - markerPosition.Z) <= 4)
				|| distance >= 50
				)
				{
					zPositioning = "";
				}
				else
				{
					if (playerPosition.Z > markerPosition.Z)
					{
						zPositioning = " - " + "[" + GetLocStringByKeyExt("fake_key_z98k3yl8") + "]";
					}
					else if (playerPosition.Z < markerPosition.Z)
					{
						zPositioning = " - " + "[" + GetLocStringByKeyExt("fake_key_dk0zqae") + "]";
					}
					else
					{
						zPositioning = "";
					}
				}

				if (distance <= 4.5 )
				{
					iconPath = "<br/><br/>" + "<font size = '16' color = '#918c3f'>" + "[" + GetLocStringByKeyExt("fake_key_1h78y_j") + "]" + zPositioning + "</font>";
				}
				else
				{
					iconPath = "<br/><br/>" + "<font size = '16' color = '#918c3f'>" + "[" + FloatToStringPrec(distance, 0) + "m" + "]" + zPositioning + "</font>";
				}

				ACS_Oneliner(iconPath, markers[i], "ACS_Untracked_Quest_Distance_GUI_Marker");
			}

			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Untracked_Quest_Distance_GUI_Marker", 100);

			GetACSStorage().acs_setScaleForOnelinerByTag("ACS_Untracked_Quest_Distance_GUI_Marker", 100, 100, 100);
		}
	}

	var acs_untracked_quest_names							: array<string>;

	private function CreateGuidingEntities()
	{
		var i, j, k 							: int;
		var qpin 								: ACSQuestMapPin;
		var skip 								: bool;
		var pinPos 								: Vector;
		var rot, newRot          				: EulerAngles;
		var ent									: CEntity;
		var temp								: CEntityTemplate;
		var targetDistance						: float;
		var pinTitleID							: int;
		var pinTag 								: name;
		var ents 								: array<CEntity>;

		ACSTrackedQuestsEntsDestroy();

		acs_untracked_quest_names.Clear();

		for (i = 0; i < m_questMapPins.Size(); i += 1) 
		{
			qpin = m_questMapPins[i];
			pinPos = qpin.position;
			pinTitleID = qpin.titleStringId;
			pinTag = qpin.tag;
	
	
			if ((qpin.areaPosType == ACSAreaPos_Valid)
			&& (qpin.questObjective.GetParentQuest().guid != m_currentTrackedQuest.guid)
			//&& !ACSGetCEntity(pinTag)
			) 
			{
				if (ACSGetCEntity(pinTag))
				{
					//ACSGetCEntity(pinTag).Destroy();
				}

				acs_untracked_quest_names.PushBack( GetLocStringById(pinTitleID) );

				rot = thePlayer.GetWorldRotation();

				rot.Pitch += 180;

				rot.Yaw += 180;

				temp = (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\fx\guiding_light_marker_old.w2ent", true );

				ent = (CEntity)theGame.CreateEntity( temp, pinPos, rot );

				ent.AddTag('ACS_All_Tracked_Quest_Entity');

				ent.AddTag('ACS_HUD_Marker_Entity');

				ent.AddTag('ACS_POI_Trigger_Entity');

				ent.AddTag(pinTag);
			}
		}
	}

	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


	function ACS_Guiding_Light_Quest_Marker_Distance_Actual()
	{
		var iconPath, zPositioning				: string;
		var playerPosition, markerPosition 		: Vector;
		var distance 							: float;
		var trackedQuests						: CJournalQuest;
		var trackedQuestName					: string;
		var curHighlightedObjective 			: CJournalQuestObjective;
		var curr_objective						: String;


		GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Quest_Distance_GUI_Marker", 100);

		GetACSStorage().acs_deleteOnelinerByTag("ACS_Quest_Distance_GUI_Marker");

		if (!ACSGetCEntity('ACS_Guiding_Light_Marker'))
		{
			return;
		}

		playerPosition = thePlayer.GetWorldPosition();

		markerPosition = ACSGetCEntity('ACS_Guiding_Light_Marker').GetWorldPosition();

		distance = VecDistance(playerPosition, markerPosition);

		if ((AbsF(playerPosition.Z - markerPosition.Z) <= 4)
		|| distance >= 50
		)
		{
			zPositioning = "";
		}
		else
		{
			if (playerPosition.Z > markerPosition.Z)
			{
				zPositioning = " - " + "[" + GetLocStringByKeyExt("fake_key_z98k3yl8") + "]";
			}
			else if (playerPosition.Z < markerPosition.Z)
			{
				zPositioning = " - " + "[" + GetLocStringByKeyExt("fake_key_dk0zqae") + "]";
			}
			else
			{
				zPositioning = "";
			}
		}

		if(RadialMenuCheck()
		|| HudExceptionCheck() 
		|| ACS_GetNearbyEnemyLocation() != Vector(0,0,-200)
		|| ACS_MapPinsCheck()
		|| thePlayer.IsAnyWeaponHeld()
		)
		{
			trackedQuests = theGame.GetJournalManager().GetTrackedQuest();

			trackedQuestName = GetLocStringById(trackedQuests.GetTitleStringId());

			if (distance <= 4.5 )
			{
				iconPath = "<font size = '16' color = '#B58D45'>" + "[" + trackedQuestName + "]" + "<br/><br/><br/><br/>" + "[" + GetLocStringByKeyExt("fake_key_1h78y_j") + "]" + zPositioning + "</font>";
			}
			else
			{
				iconPath = "<font size = '16' color = '#B58D45'>" + "[" + trackedQuestName + "]" + "<br/><br/><br/><br/>" + "[" + FloatToStringPrec(distance, 0) + "m" + "]" + zPositioning + "</font>";
			}
		}
		else
		{
			if (distance <= 4.5 )
			{
				iconPath = "<br/><br/>" + "<font size = '16' color = '#B58D45'>" + "[" + GetLocStringByKeyExt("fake_key_1h78y_j") + "]" + zPositioning + "</font>";
			}
			else
			{
				iconPath = "<br/><br/>" + "<font size = '16' color = '#B58D45'>" + "[" + FloatToStringPrec(distance, 0) + "m" + "]" + zPositioning + "</font>";
			}
		}

		ACS_Oneliner(iconPath, ACSGetCEntity('ACS_Guiding_Light_Marker'), "ACS_Quest_Distance_GUI_Marker");

		GetACSStorage().acs_setScaleForOnelinerByTag("ACS_Quest_Distance_GUI_Marker", 100, 100, 100);

		GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Quest_Distance_GUI_Marker", 100);
	}

	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	private var trackedQuestMarkerFadeOut : float;
	default trackedQuestMarkerFadeOut = 100;

	timer function trackedQuestMarkerFadeOut(dt : float , id : int)
	{	
		GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Quest_GUI_Marker", trackedQuestMarkerFadeOut);

		if (trackedQuestMarkerFadeOut <= 0)
		{
			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Quest_GUI_Marker", 100);

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Quest_GUI_Marker");

			if (ACS_Guiding_Light_Quest_Marker_Distance_Available)
			{
				ACS_Guiding_Light_Quest_Marker_Distance_Available = false;
			}
			
			ACSGetCEntity('ACS_Guiding_Light_Marker').Destroy();

			ACSGetCEntity('ACS_Guiding_Light_Navigation_Guide_Marker').Destroy();

			trackedQuestMarkerFadeOut = 100;

			RemoveTimer('trackedQuestMarkerFadeOut');
		}
		else
		{
			trackedQuestMarkerFadeOut -= 1;
		}
	}

	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	var ACS_Guiding_Light_Quest_Marker_Stopping : bool;

	var ACS_Guiding_Light_Quest_Marker_Stopped : bool;

	var guiding_light_tracked_quest_position	: Vector;

	function Guiding_Light()
	{
		var rot, newRot          																: EulerAngles;
		var ent, entNavigationGuide, entNavigationGuideMarker									: CEntity;
		var temp, tempNavigationGuide, tempNavigationGuideMarker								: CEntityTemplate;
		var targetDistance																		: float;
		var compass_check 																		: bool;

		if ( theGame.IsDialogOrCutscenePlaying() 
		|| thePlayer.IsInCutsceneIntro() 
		|| theGame.IsCurrentlyPlayingNonGameplayScene() 
		|| theGame.IsFading()
		|| theGame.IsBlackscreen()
		|| theGame.IsPaused()
		|| theGame.GetPhotomodeEnabled() 
		)
		{
			return;
		}

		if ( !ACS_GetQuestPoint() 
		|| ACS_Settings_Main_Float('acs_hud_settings_markers','acs_quest_marker_despawn_delay', 7) == 0
		|| theGame.GetJournalManager().GetTrackedQuest().baseName == "ACS Exploration"
		//|| theGame.IsFading()
		//|| theGame.IsBlackscreen()
		//|| theGame.IsPaused()
		//|| theGame.IsDialogOrCutscenePlaying() 
		//|| theGame.GetPhotomodeEnabled() 
		//|| thePlayer.IsInCutsceneIntro() 
		//|| theGame.IsCurrentlyPlayingNonGameplayScene() 
		)
		{
			if(ACSGetCEntity('ACS_Guiding_Light_Marker'))
			{
				if (ACS_Guiding_Light_Quest_Marker_Stopping)
				{
					ACS_Guiding_Light_Quest_Marker_Stopping = false;
				}

				if (ACS_Guiding_Light_Quest_Marker_Stopped)
				{
					ACS_Guiding_Light_Quest_Marker_Stopped = false;
				}

				RemoveTimer('GetACSGuidingLightQuestMarker_EffectStoppingDelay');

				RemoveTimer('GetACSGuidingLightQuestMarker_EffectStopDelay');

				trackedQuestMarkerFadeOut = 100;
				RemoveTimer('trackedQuestMarkerFadeOut');

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Quest_GUI_Marker");
				GetACSStorage().acs_deleteOnelinerByTag("ACS_Quest_Distance_GUI_Marker");

				if (ACS_Guiding_Light_Quest_Marker_Distance_Available)
				{
					ACS_Guiding_Light_Quest_Marker_Distance_Available = false;
				}

				ACSGetCEntity('ACS_Guiding_Light_Navigation_Guide_Marker').Destroy();

				ACSGetCEntity('ACS_Guiding_Light_Marker').Destroy();
			}

			return;
		}

		if(thePlayer.GetIsHorseRacing())
		{
			if (!ACSGetCEntity('ACS_Guiding_Light_Marker').IsEffectActive('horse_race_marker', false))
			{
				ACSGetCEntity('ACS_Guiding_Light_Marker').PlayEffectSingle('horse_race_marker');
			}
		}
		else
		{
			if (ACSGetCEntity('ACS_Guiding_Light_Marker').IsEffectActive('horse_race_marker', false))
			{
				ACSGetCEntity('ACS_Guiding_Light_Marker').DestroyEffect('horse_race_marker');
			}
		}

		if (!ACS_Settings_Main_Bool('acs_hud_settings_main','acs_guiding_light_enabled', false))
		{
			if (ACSGetCEntity('ACS_Guiding_Light_Marker').IsEffectActive('pridefall_marker_red', false))
			{
				ACSGetCEntity('ACS_Guiding_Light_Marker').DestroyEffect('pridefall_marker_red');
			}
		}
		else
		{
			if (!ACSGetCEntity('ACS_Guiding_Light_Marker').IsEffectActive('pridefall_marker_red', false))
			{
				ACSGetCEntity('ACS_Guiding_Light_Marker').PlayEffectSingle('pridefall_marker_red');
			}
		}

		targetDistance = VecDistanceSquared2D( GetWitcherPlayer().GetWorldPosition(), ACSGetCEntity('ACS_Guiding_Light_Marker').GetWorldPosition() ) ;

		ACS_GetQuestPointPosition(guiding_light_tracked_quest_position);	

		rot = thePlayer.GetWorldRotation();

		rot.Pitch += 180;

		rot.Yaw += 180;

		if(!ACSGetCEntity('ACS_Guiding_Light_Marker'))
		{
			temp = (CEntityTemplate)LoadResource( 
				
			"dlc\dlc_acs\data\fx\guiding_light_marker_old.w2ent"
			
			, true );

			ent = (CEntity)theGame.CreateEntity( temp, guiding_light_tracked_quest_position, rot );

			ent.AddTag('ACS_Guiding_Light_Marker');

			ent.AddTag('ACS_HUD_Marker_Entity');

			ent.AddTag('ACS_POI_Trigger_Entity');


			tempNavigationGuideMarker = (CEntityTemplate)LoadResource( 
				
			"dlc\dlc_acs\data\entities\other\navigation_guide_marker.w2ent"
			
			, true );

			entNavigationGuideMarker = (CEntity)theGame.CreateEntity( tempNavigationGuideMarker, guiding_light_tracked_quest_position, rot );

			entNavigationGuideMarker.AddTag('ACS_Guiding_Light_Navigation_Guide_Marker');

			return;
		}

		if(RadialMenuCheck()
		|| HudExceptionCheck() 
		|| ACS_GetNearbyEnemyLocation() != Vector(0,0,-200)
		|| ACS_MapPinsCheck()
		|| thePlayer.IsAnyWeaponHeld()
		)
		{
			if (ACS_Guiding_Light_Quest_Marker_Stopping)
			{
				ACS_Guiding_Light_Quest_Marker_Stopping = false;
			}

			if (ACS_Guiding_Light_Quest_Marker_Stopping )
			{
				ACS_Guiding_Light_Quest_Marker_Stopping = false;
			}

			ACS_Guiding_Light_Quest_Marker_Distance_Available = true;

			RemoveTimer('GetACSGuidingLightQuestMarker_EffectStoppingDelay');

			RemoveTimer('GetACSGuidingLightQuestMarker_EffectStopDelay');

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Quest_GUI_Marker");

			ACS_Oneliner(FormatIconPath("icons/inventory/acs_marker_quest_alt.xbm"), ACSGetCEntity('ACS_Guiding_Light_Marker'), "ACS_Quest_GUI_Marker");

			GetACSStorage().acs_setScaleForOnelinerByTag("ACS_Quest_GUI_Marker", 100, 100, 100);

			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Quest_GUI_Marker", 100);
			
			if (ACS_Settings_Main_Bool('acs_hud_settings_markers','acs_marker_bubble_enabled', false))
			{
				if (targetDistance <= 5 * 5)
				{
					ACSGetCEntity('ACS_Guiding_Light_Marker').StopEffect('quest_marker_smaller');
					ACSGetCEntity('ACS_Guiding_Light_Marker').StopEffect('quest_marker_small');
					ACSGetCEntity('ACS_Guiding_Light_Marker').StopEffect('quest_marker');
					ACSGetCEntity('ACS_Guiding_Light_Marker').StopEffect('quest_marker_bigger');
					ACSGetCEntity('ACS_Guiding_Light_Marker').StopEffect('quest_marker_biggest');
					ACSGetCEntity('ACS_Guiding_Light_Marker').StopEffect('quest_marker_biggest_x2');
					ACSGetCEntity('ACS_Guiding_Light_Marker').StopEffect('quest_marker_biggest_x4');
				}
				else if (targetDistance > 5 * 5 && targetDistance <= 10 * 10)
				{
					ACSGetCEntity('ACS_Guiding_Light_Marker').StopEffect('quest_marker_small');
					ACSGetCEntity('ACS_Guiding_Light_Marker').StopEffect('quest_marker');
					ACSGetCEntity('ACS_Guiding_Light_Marker').StopEffect('quest_marker_bigger');
					ACSGetCEntity('ACS_Guiding_Light_Marker').StopEffect('quest_marker_biggest');
					ACSGetCEntity('ACS_Guiding_Light_Marker').StopEffect('quest_marker_biggest_x2');
					ACSGetCEntity('ACS_Guiding_Light_Marker').StopEffect('quest_marker_biggest_x4');

					if (!ACSGetCEntity('ACS_Guiding_Light_Marker').IsEffectActive('quest_marker_smaller', false))
					{
						ACSGetCEntity('ACS_Guiding_Light_Marker').PlayEffectSingle('quest_marker_smaller');
					}
				}
				else if (targetDistance > 10 * 10 && targetDistance <= 25 * 25)
				{
					ACSGetCEntity('ACS_Guiding_Light_Marker').StopEffect('quest_marker_smaller');
					ACSGetCEntity('ACS_Guiding_Light_Marker').StopEffect('quest_marker');
					ACSGetCEntity('ACS_Guiding_Light_Marker').StopEffect('quest_marker_bigger');
					ACSGetCEntity('ACS_Guiding_Light_Marker').StopEffect('quest_marker_biggest');
					ACSGetCEntity('ACS_Guiding_Light_Marker').StopEffect('quest_marker_biggest_x2');
					ACSGetCEntity('ACS_Guiding_Light_Marker').StopEffect('quest_marker_biggest_x4');

					if (!ACSGetCEntity('ACS_Guiding_Light_Marker').IsEffectActive('quest_marker_small', false))
					{
						ACSGetCEntity('ACS_Guiding_Light_Marker').PlayEffectSingle('quest_marker_small');
					}
				}
				else if (targetDistance > 25 * 25 && targetDistance <= 50 * 50)
				{
					ACSGetCEntity('ACS_Guiding_Light_Marker').StopEffect('quest_marker_smaller');
					ACSGetCEntity('ACS_Guiding_Light_Marker').StopEffect('quest_marker_small');
					ACSGetCEntity('ACS_Guiding_Light_Marker').StopEffect('quest_marker_bigger');
					ACSGetCEntity('ACS_Guiding_Light_Marker').StopEffect('quest_marker_biggest');
					ACSGetCEntity('ACS_Guiding_Light_Marker').StopEffect('quest_marker_biggest_x2');
					ACSGetCEntity('ACS_Guiding_Light_Marker').StopEffect('quest_marker_biggest_x4');

					if (!ACSGetCEntity('ACS_Guiding_Light_Marker').IsEffectActive('quest_marker', false))
					{
						ACSGetCEntity('ACS_Guiding_Light_Marker').PlayEffectSingle('quest_marker');
					}
				}
				else if (targetDistance > 50 * 50 && targetDistance <= 100 * 100)
				{
					ACSGetCEntity('ACS_Guiding_Light_Marker').StopEffect('quest_marker_smaller');
					ACSGetCEntity('ACS_Guiding_Light_Marker').StopEffect('quest_marker_small');
					ACSGetCEntity('ACS_Guiding_Light_Marker').StopEffect('quest_marker');
					ACSGetCEntity('ACS_Guiding_Light_Marker').StopEffect('quest_marker_biggest');
					ACSGetCEntity('ACS_Guiding_Light_Marker').StopEffect('quest_marker_biggest_x2');
					ACSGetCEntity('ACS_Guiding_Light_Marker').StopEffect('quest_marker_biggest_x4');

					if (!ACSGetCEntity('ACS_Guiding_Light_Marker').IsEffectActive('quest_marker_bigger', false))
					{
						ACSGetCEntity('ACS_Guiding_Light_Marker').PlayEffectSingle('quest_marker_bigger');
					}
				}
				else if (targetDistance > 100 * 100 )
				{
					ACSGetCEntity('ACS_Guiding_Light_Marker').StopEffect('quest_marker_smaller');
					ACSGetCEntity('ACS_Guiding_Light_Marker').StopEffect('quest_marker_small');
					ACSGetCEntity('ACS_Guiding_Light_Marker').StopEffect('quest_marker');
					ACSGetCEntity('ACS_Guiding_Light_Marker').StopEffect('quest_marker_bigger');
					ACSGetCEntity('ACS_Guiding_Light_Marker').StopEffect('quest_marker_biggest_x2');
					ACSGetCEntity('ACS_Guiding_Light_Marker').StopEffect('quest_marker_biggest_x4');

					if (!ACSGetCEntity('ACS_Guiding_Light_Marker').IsEffectActive('quest_marker_biggest', false))
					{
						ACSGetCEntity('ACS_Guiding_Light_Marker').PlayEffectSingle('quest_marker_biggest');
					}
				}
			}
		}
		else
		{
			if ( !ACS_Guiding_Light_Quest_Marker_Stopping )
			{
				if ( !ACS_Guiding_Light_Quest_Marker_Stopping )
				{
					AddTimer('GetACSGuidingLightQuestMarker_EffectStoppingDelay', 0.00000000000000000001, true);

					AddTimer('GetACSGuidingLightQuestMarker_EffectStopDelay', ACS_Settings_Main_Float('acs_hud_settings_markers','acs_quest_marker_despawn_delay', 7) , false);

					ACS_Guiding_Light_Quest_Marker_Stopping = true;
				}

				ACS_Guiding_Light_Quest_Marker_Stopping = true;
			}
		}
	}


							if (theInput.IsActionPressed('DiveUp'))
							{
								if (theInput.GetActionValue('GI_AxisLeftY') > 0.1 )
								{
									if(thePlayer.IsSwimming())
									{
										dest1 = GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetHeadingVector() * (0.625 * mult);
									}
									else
									{
										dest1 = GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetWorldUp() * 0.5 + theCamera.GetCameraDirection() * (0.625 * mult);
									}
								}
								else
								{
									if(thePlayer.IsSwimming())
									{
										dest1 = GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetHeadingVector() * (0.625 * mult);
									}
									else
									{
										dest1 = GetWitcherPlayer().GetWorldPosition()  + GetWitcherPlayer().GetWorldUp() * 0.5 + GetWitcherPlayer().GetHeadingVector() * (0.625 * mult);
									}
								}
							}
							else if (theInput.IsActionPressed('DiveDown'))
							{
								if (theInput.GetActionValue('GI_AxisLeftY') > 0.1 )
								{
									if(thePlayer.IsSwimming())
									{
										dest1 = GetWitcherPlayer().GetWorldPosition()  + GetWitcherPlayer().GetWorldUp() * -0.5 + GetWitcherPlayer().GetHeadingVector() * (0.625 * mult);
									}
									else
									{
										dest1 = GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetWorldUp() * -0.5 + theCamera.GetCameraDirection() * (0.625 * mult);
									}
								}
								else
								{
									dest1 = GetWitcherPlayer().GetWorldPosition()  + GetWitcherPlayer().GetWorldUp() * -0.5 + GetWitcherPlayer().GetHeadingVector() * (0.625 * mult);
								}
							}
							else
							{
								if (theInput.GetActionValue('GI_AxisLeftY') > 0.1 )
								{
									if(thePlayer.IsSwimming())
									{
										dest1 = GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetHeadingVector() * (0.625 * mult);
									}
									else
									{
										dest1 = GetWitcherPlayer().GetWorldPosition() + theCamera.GetCameraDirection() * (0.625 * mult);
									}
								}
								else
								{
									dest1 = GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetHeadingVector() * (0.625 * mult);
								}
							}
						}
					}
					else
					{
						if (theInput.IsActionPressed('Sprint') || thePlayer.GetIsSprinting())
						{
							if (theInput.IsActionPressed('DiveUp'))
							{
								if (theInput.GetActionValue('GI_AxisLeftY') > 0.1 )
								{
									if(thePlayer.IsSwimming())
									{
										dest1 = GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetHeadingVector() * (2.5 * mult);
									}
									else
									{
										dest1 = GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetWorldUp() * 1 + theCamera.GetCameraDirection() * (2.5 * mult);
									}
								}
								else
								{
									if(thePlayer.IsSwimming())
									{
										dest1 = GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetHeadingVector() * (2.5 * mult);
									}
									else
									{
										dest1 = GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetWorldUp() * 1 + GetWitcherPlayer().GetHeadingVector() * (2.5 * mult);
									}
								}
							}
							else if (theInput.IsActionPressed('DiveDown'))
							{
								if (theInput.GetActionValue('GI_AxisLeftY') > 0.1  )
								{
									if(thePlayer.IsSwimming())
									{
										dest1 = GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetWorldUp() * -1 + GetWitcherPlayer().GetHeadingVector() * (2.5 * mult);
									}
									else
									{
										dest1 = GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetWorldUp() * -1 + theCamera.GetCameraDirection() * (2.5 * mult);
									}
								}
								else
								{
									dest1 = GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetWorldUp() * -1 + GetWitcherPlayer().GetHeadingVector() * (2.5 * mult);
								}
							}
							else
							{
								if (theInput.GetActionValue('GI_AxisLeftY') > 0.1 )
								{
									if(thePlayer.IsSwimming())
									{
										dest1 = GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetHeadingVector() * (2.5 * mult);
									}
									else
									{
										dest1 = GetWitcherPlayer().GetWorldPosition() + theCamera.GetCameraDirection() * (2.5 * mult);
									}
								}
								else
								{
									dest1 = GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetHeadingVector() * (2.5 * mult);
								}
							}
						}
						else
						{
							if (theInput.IsActionPressed('DiveUp'))
							{
								if (theInput.GetActionValue('GI_AxisLeftY') > 0.1 )
								{
									if(thePlayer.IsSwimming())
									{
										dest1 = GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetHeadingVector() * (1.25 * mult);
									}
									else
									{
										dest1 = GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetWorldUp() * 0.75 + theCamera.GetCameraDirection() * (1.25 * mult);
									}
								}
								else
								{
									if(thePlayer.IsSwimming())
									{
										dest1 = GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetHeadingVector() * (1.25 * mult);
									}
									else
									{
										dest1 = GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetWorldUp() * 0.75 + GetWitcherPlayer().GetHeadingVector() * (1.25 * mult);
									}
								}
							}
							else if (theInput.IsActionPressed('DiveDown'))
							{
								if (theInput.GetActionValue('GI_AxisLeftY') > 0.1 )
								{
									if(thePlayer.IsSwimming())
									{
										dest1 = GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetWorldUp() * -0.75 + GetWitcherPlayer().GetHeadingVector() * (1.25 * mult);
									}
									else
									{
										dest1 = GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetWorldUp() * -0.75 + theCamera.GetCameraDirection() * (1.25 * mult);
									}
								}
								else
								{
									dest1 = GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetWorldUp() * -0.75 + GetWitcherPlayer().GetHeadingVector() * (1.25 * mult);
								}
							}
							else
							{
								if (theInput.GetActionValue('GI_AxisLeftY') > 0.1 )
								{
									if(thePlayer.IsSwimming())
									{
										dest1 = GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetHeadingVector() * (1.25 * mult);
									}
									else
									{
										dest1 = GetWitcherPlayer().GetWorldPosition() + theCamera.GetCameraDirection() * (1.25 * mult);
									}
								}
								else
								{
									dest1 = GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetHeadingVector() * (1.25 * mult);
								}
							}
						}
					}

					if (theInput.GetActionValue('GI_AxisLeftY') > 0.1 )
					{
						movementAdjustor.RotateTo( ticket, VecHeading( theCamera.GetCameraDirection() ) );
					}

					movementAdjustor.SlideTo( ticket, dest1 );
				}
			}
		}
	}

	var playerIsDiving : bool;

	default playerIsDiving = false;

	var playerInWater : bool;

	default playerInWater = false;

	var playerInRain : bool;

	default playerInRain = false;

	function RoofCheck() : bool
	{
		var pos, target, hitPos, hitNormal : Vector;
		
		pos = thePlayer.GetWorldPosition();
		pos.Z += 1.8;
		
		target = pos;
		target.Z += 30.0;
		target += thePlayer.GetWorldForward() * 18.0;
		
		if(theGame.GetWorld().StaticTrace(pos, target, hitPos, hitNormal))
		{
			return true;
		}

		return false;
	}

	function DrippingWater()
	{
		var bonePosition									: Vector;
		var boneRotation									: EulerAngles;
		var dripping_water_ent								: CEntity;
		var boneNames										: array<CName>;
		var boneIndex, i, j									: int;

		if( 
		theGame.IsDialogOrCutscenePlaying() 
		|| !thePlayer.IsAlive()
		|| thePlayer.IsInCutsceneIntro()
		|| theGame.HasBlackscreenRequested()
		|| theGame.IsCurrentlyPlayingNonGameplayScene()
		|| theGame.GetGuiManager().IsAnyMenu()
		|| theGame.GetTutorialSystem().HasActiveTutorial()
		|| theGame.GetPhotomodeEnabled() 
		|| theGame.IsFading()
		|| theGame.IsBlackscreen()
		)
		{
			if(playerInRain)
			{
				ACSGetCEntityDestroyAll('ACS_Dripping_Water');

				playerInRain = false;
			}

			return;
		}

		if (thePlayer.IsAlive()
		&& !thePlayer.IsInInterior()
		&& !RoofCheck()
		&& ACS_Settings_Main_Bool('acs_visual_main_settings','acs_rain_water_droplets_enabled', true)
		&& (GetWeatherConditionName() == 'WT_Rain_Storm' 
		|| GetWeatherConditionName() == 'WT_Rain_Heavy' 
		|| GetWeatherConditionName() == 'WT_Rain_Dark' 
		)
		)
		{
			
			if (!playerInRain)
			{
				boneNames.Clear();

				boneNames.PushBack('torso');
				boneNames.PushBack('torso2');
				boneNames.PushBack('l_shoulder');
				boneNames.PushBack('l_forearm');
				boneNames.PushBack('l_hand');
				boneNames.PushBack('r_shoulder');
				boneNames.PushBack('r_forearm');
				boneNames.PushBack('r_hand');
				boneNames.PushBack('l_thigh');
				boneNames.PushBack('l_kneeRoll');
				boneNames.PushBack('r_thigh');
				boneNames.PushBack('r_kneeRoll');
				boneNames.PushBack('l_bicep2');
				boneNames.PushBack('l_legRoll2');
				boneNames.PushBack('l_forearmRoll2');
				boneNames.PushBack('r_elbowRoll');
				boneNames.PushBack('l_elbowRoll');
				boneNames.PushBack('r_forearmRoll2');
				boneNames.PushBack('r_legRoll2');
				boneNames.PushBack('r_bicep2');

				boneNames.PushBack('r_thumb3');
				boneNames.PushBack('r_index3');
				boneNames.PushBack('r_middle3');
				boneNames.PushBack('r_ring3');
				boneNames.PushBack('r_pinky3');

				boneNames.PushBack('l_thumb3');
				boneNames.PushBack('l_index3');
				boneNames.PushBack('l_middle3');
				boneNames.PushBack('l_ring3');
				boneNames.PushBack('l_pinky3');
				
				for( i = 0; i < boneNames.Size(); i += 1 )
				{
					if(RandF() < 0.75)
					{
						boneIndex = thePlayer.GetBoneIndex( boneNames[i] );	

						thePlayer.GetBoneWorldPositionAndRotationByIndex( boneIndex, bonePosition, boneRotation );

						dripping_water_ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

						"dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent"

						, true ), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );

						dripping_water_ent.CreateAttachmentAtBoneWS(thePlayer, boneNames[i], bonePosition, boneRotation );

						dripping_water_ent.PlayEffectSingle('dripping_water');

						//dripping_water_ent.PlayEffectSingle('water_drip');

						//dripping_water_ent.PlayEffectSingle('water_drops');

						dripping_water_ent.AddTag('ACS_Dripping_Water');
					}
				}

				playerInRain = true;
			}
		
		}
		else
		{
			if (playerInRain)
			{
				ACSGetCEntityDestroyAll('ACS_Dripping_Water');

				playerInRain = false;
			}
		}
	}
	

	function IncreaseSwimSpeed()
	{
		var boneNames													: array<CName>;
		var boneIndex, i												: int;
		var boneRotation												: EulerAngles;
		var bonePosition												: Vector;
		var bubble_ent                  								: CEntity;
		var idleTypes													: array<name>;	
		var cam_direction, lean_roll_modifier 							: float;


		var bonePositionDrippingWater									: Vector;
		var boneRotationDrippingWater									: EulerAngles;
		var dripping_water_ent											: CEntity;
		var boneNamesDrippingWater										: array<CName>;
		var boneIndexDrippingWater, j									: int;

		if( 
		theGame.IsDialogOrCutscenePlaying() 
		|| !thePlayer.IsAlive()
		|| thePlayer.IsInCutsceneIntro()
		|| theGame.HasBlackscreenRequested()
		|| theGame.IsCurrentlyPlayingNonGameplayScene()
		|| theGame.GetGuiManager().IsAnyMenu()
		|| theGame.GetTutorialSystem().HasActiveTutorial()
		|| theGame.GetPhotomodeEnabled() 
		|| theGame.IsFading()
		|| theGame.IsBlackscreen()
		)
		{
			if(playerInWater)
			{
				playerInWater = false;
			}

			if(playerIsDiving)
			{
				ACSGetCEntityDestroyAll('ACS_Bubble_Trail');

				playerIsDiving = false;
			}

			if (swimHackEnabled)
			{
				IdleAdditivesControl();
				
				RemoveTimer('Wraith_Swim_Timer');

				swimHackEnabled = false;
			}

			if (swimmingLeanCheck)
			{
				swimmingLeanCheck = false;
			}

			if(sLean.Roll < 0)
			{
				sLean.Roll += 0.25;
			}
			else if(sLean.Roll > 0)
			{
				sLean.Roll -= 0.25;
			}
			else
			{
				sLean.Roll = 0;
			}

			if (swimmingAardCheck)
			{
				RemoveTimer('SwimmingAard360DealDamage');

				swimmingAardCheck = false;
			}

			return;
		}

		if (ACS_Settings_Main_Bool('acs_visual_main_settings','acs_rain_water_droplets_enabled', true))
		{
			if (thePlayer.GetCurrentStateName() == 'Swimming'
			)
			{
				if(!playerInWater)
				{
					playerInWater = true;
				}
			}
			else if (thePlayer.GetCurrentStateName() != 'Swimming'
			&& thePlayer.substateManager.GetStateTimeF() > 3
			)
			{
				if(playerInWater)
				{
					boneNamesDrippingWater.Clear();

					boneNamesDrippingWater.PushBack('torso');
					boneNamesDrippingWater.PushBack('torso2');
					boneNamesDrippingWater.PushBack('l_shoulder');
					boneNamesDrippingWater.PushBack('l_forearm');
					boneNamesDrippingWater.PushBack('l_hand');
					boneNamesDrippingWater.PushBack('r_shoulder');
					boneNamesDrippingWater.PushBack('r_forearm');
					boneNamesDrippingWater.PushBack('r_hand');
					boneNamesDrippingWater.PushBack('l_thigh');
					boneNamesDrippingWater.PushBack('l_kneeRoll');
					boneNamesDrippingWater.PushBack('r_thigh');
					boneNamesDrippingWater.PushBack('r_kneeRoll');
					boneNamesDrippingWater.PushBack('l_bicep2');
					boneNamesDrippingWater.PushBack('l_legRoll2');
					boneNamesDrippingWater.PushBack('l_forearmRoll2');
					boneNamesDrippingWater.PushBack('r_elbowRoll');
					boneNamesDrippingWater.PushBack('l_elbowRoll');
					boneNamesDrippingWater.PushBack('r_forearmRoll2');
					boneNamesDrippingWater.PushBack('r_legRoll2');
					boneNamesDrippingWater.PushBack('r_bicep2');

					boneNamesDrippingWater.PushBack('r_thumb3');
					boneNamesDrippingWater.PushBack('r_index3');
					boneNamesDrippingWater.PushBack('r_middle3');
					boneNamesDrippingWater.PushBack('r_ring3');
					boneNamesDrippingWater.PushBack('r_pinky3');

					boneNamesDrippingWater.PushBack('l_thumb3');
					boneNamesDrippingWater.PushBack('l_index3');
					boneNamesDrippingWater.PushBack('l_middle3');
					boneNamesDrippingWater.PushBack('l_ring3');
					boneNamesDrippingWater.PushBack('l_pinky3');
					
					for( j = 0; j < boneNamesDrippingWater.Size(); j += 1 )
					{
						if(RandF() < 0.75)
						{
							boneIndex = thePlayer.GetBoneIndex( boneNamesDrippingWater[j] );	

							thePlayer.GetBoneWorldPositionAndRotationByIndex( boneIndexDrippingWater, bonePositionDrippingWater, boneRotationDrippingWater );

							dripping_water_ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

							"dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent"

							, true ), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );

							dripping_water_ent.CreateAttachmentAtBoneWS(thePlayer, boneNamesDrippingWater[j], bonePositionDrippingWater, boneRotationDrippingWater );

							dripping_water_ent.PlayEffectSingle('dripping_water');

							dripping_water_ent.DestroyAfter(10);
						}
					}

					playerInWater = false;
				}
			}
		}

		if(thePlayer.IsDiving())
		{
			if(!playerIsDiving)
			{
				ACSGetCEntityDestroyAll('ACS_Bubble_Trail');

				boneNames.Clear();

				boneNames.PushBack('torso');
				boneNames.PushBack('torso2');
				boneNames.PushBack('head');
				boneNames.PushBack('l_shoulder');
				boneNames.PushBack('l_forearm');
				boneNames.PushBack('l_hand');
				boneNames.PushBack('r_shoulder');
				boneNames.PushBack('r_forearm');
				boneNames.PushBack('r_hand');
				boneNames.PushBack('l_thigh');
				boneNames.PushBack('l_kneeRoll');
				boneNames.PushBack('l_foot');
				boneNames.PushBack('r_thigh');
				boneNames.PushBack('r_kneeRoll');
				boneNames.PushBack('r_foot');

				boneNames.PushBack('r_thumb3');
				boneNames.PushBack('r_index3');
				boneNames.PushBack('r_middle3');
				boneNames.PushBack('r_ring3');
				boneNames.PushBack('r_pinky3');

				boneNames.PushBack('l_thumb3');
				boneNames.PushBack('l_index3');
				boneNames.PushBack('l_middle3');
				boneNames.PushBack('l_ring3');
				boneNames.PushBack('l_pinky3');

				for( i = 0; i < boneNames.Size(); i += 1 )
				{
					if(RandF() < 0.5)
					{
						boneIndex = thePlayer.GetBoneIndex( boneNames[i] );	

						thePlayer.GetBoneWorldPositionAndRotationByIndex( boneIndex, bonePosition, boneRotation );

						bubble_ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

						"dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent"

						, true ), GetWitcherPlayer().GetWorldPosition(), GetWitcherPlayer().GetWorldRotation() );

						bubble_ent.CreateAttachmentAtBoneWS(thePlayer, boneNames[i], bonePosition, boneRotation );

						bubble_ent.PlayEffect('underwater_bubble_trail');

						bubble_ent.AddTag('ACS_Bubble_Trail');
					}
				}

				playerIsDiving = true;
			}
		}
		else
		{
			if(playerIsDiving)
			{
				ACSGetCEntityDestroyAll('ACS_Bubble_Trail');

				playerIsDiving = false;
			}
		}

		if (thePlayer.HasTag('acs_in_wraith'))
		{
			if (swimHackEnabled)
			{
				RemoveTimer('Wraith_Swim_Timer');

				swimHackEnabled = false;
			}

			if (swimmingLeanCheck)
			{
				swimmingLeanCheck = false;
			}

			if(sLean.Roll < 0)
			{
				sLean.Roll += 0.25;
			}
			else if(sLean.Roll > 0)
			{
				sLean.Roll -= 0.25;
			}
			else
			{
				sLean.Roll = 0;
			}

			if (swimmingAardCheck)
			{
				RemoveTimer('SwimmingAard360DealDamage');

				swimmingAardCheck = false;
			}

			return;
		}

		if(thePlayer.IsSwimming()
		|| thePlayer.IsDiving()
		)
		{
			ACS_Tutorial_Display_Check('ACS_Underwater_Aard_Tutorial_Shown');

			if (!swimHackEnabled)
			{
				if (idleAdditiveExtraActive)
				{
					thePlayer.RaiseEvent('ACS_IdleAdditiveReset');

					SetIdleAdditiveExtraStatus(false);
				}
				
				RemoveTimer('Wraith_Swim_Timer');

				AddTimer('Wraith_Swim_Timer', 0.000001 , true);

				swimHackEnabled = true;
			}

			if ( thePlayer.IsPCModeEnabled() )
			{
				cam_direction = theInput.GetActionValue( 'GI_MouseDampX' );
			}
			else
			{
				cam_direction = theInput.GetActionValue( 'GI_AxisRightX' );
			}

			lean_roll_modifier = 0.25f;

			if( cam_direction < 0 )
			{
				if (swimmingLeanCheck)
				{
					swimmingLeanCheck = false;
				}

				sLean.Roll -= lean_roll_modifier;

				if(sLean.Roll < -15)
				{
					sLean.Roll = -15;
				}
			}
			else if(theInput.GetActionValue('GI_AxisLeftX') > 0
			)
			{
				if(swimmingLeanCheck
				)
				{
					if(sLean.Roll < 0)
					{
						sLean.Roll += lean_roll_modifier;
					}
					
					if(sLean.Roll > 0)
					{
						sLean.Roll -= lean_roll_modifier;
					}
				}
				else
				{
					sLean.Roll += lean_roll_modifier;

					if(sLean.Roll > 15)
					{
						sLean.Roll = 15;

						if (!swimmingLeanCheck)
						{
							swimmingLeanCheck = true;
						}
					}
				}
			}

			if( cam_direction > 0)
			{
				if (swimmingLeanCheck)
				{
					swimmingLeanCheck = false;
				}

				sLean.Roll += lean_roll_modifier;

				if(sLean.Roll > 15)
				{
					sLean.Roll = 15;
				}
			}
			else if(theInput.GetActionValue('GI_AxisLeftX') < 0
			)
			{
				if(swimmingLeanCheck
				)
				{
					if(sLean.Roll < 0)
					{
						sLean.Roll += lean_roll_modifier;
					}
					
					if(sLean.Roll > 0)
					{
						sLean.Roll -= lean_roll_modifier;
					}
				}
				else
				{
					sLean.Roll -= lean_roll_modifier;

					if(sLean.Roll < -15)
					{
						sLean.Roll = -15;

						if (!swimmingLeanCheck)
						{
							swimmingLeanCheck = true;
						}
					}
				}
			}

			if(theInput.GetActionValue('GI_AxisLeftX') == 0
			&& cam_direction == 0
			)
			{
				if (swimmingLeanCheck)
				{
					swimmingLeanCheck = false;
				}

				if(sLean.Roll < 0)
				{
					sLean.Roll += lean_roll_modifier;
				}
				
				if(sLean.Roll > 0)
				{
					sLean.Roll -= lean_roll_modifier;
				}
			}

			if(theInput.LastUsedGamepad())
			{	
				if (theInput.GetActionValue('Spare') > 0.1
				&& theInput.GetActionValue('Interact') == 0
				&& theInput.GetActionValue('InteractHold') == 0
				&& theInput.GetActionValue('Use') == 0
				&& theInput.GetActionValue('DiveUp') == 0
				&& theInput.GetActionValue('DiveDown') == 0
				)
				{
					SwimmingCombat();
				}
			}
			else
			{
				if ((theInput.GetActionValue('Finish') > 0.1
				|| theInput.GetActionValue('Finisher') > 0.1)
				&& theInput.GetActionValue('Interact') == 0
				&& theInput.GetActionValue('InteractHold') == 0
				&& theInput.GetActionValue('Use') == 0
				&& theInput.GetActionValue('DiveUp') == 0
				&& theInput.GetActionValue('DiveDown') == 0
				)
				{
					SwimmingCombat();
				}
			}
		}
		else
		{
			if (swimHackEnabled)
			{
				IdleAdditivesControl();
				
				RemoveTimer('Wraith_Swim_Timer');

				swimHackEnabled = false;
			}

			if (swimmingLeanCheck)
			{
				swimmingLeanCheck = false;
			}

			if(sLean.Roll < 0)
			{
				sLean.Roll += 0.25;
			}
			else if(sLean.Roll > 0)
			{
				sLean.Roll -= 0.25;
			}
			else
			{
				sLean.Roll = 0;
			}

			if (swimmingAardCheck)
			{
				RemoveTimer('SwimmingAard360DealDamage');

				swimmingAardCheck = false;
			}
		}
	}

	var swimHackEnabled : bool;

	function WinGwent()
	{
		if ( ACS_Settings_Main_Bool('acs_misc_main_settings','acs_auto_win_gwent_enabled', false) )
		{
			if ( (CR4GwintGameMenu)((CR4GuiManager)theGame.GetGuiManager()).GetRootMenu() )
			{
				if (FactsQuerySum("ACS_Win_Gwent_Active") <= 0)
				{
					thePlayer.SetGwintMinigameState( EMS_End_PlayerWon );

					((CR4GwintGameMenu)((CR4GuiManager)theGame.GetGuiManager()).GetRootMenu()).CloseMenu();

					FactsAdd("ACS_Win_Gwent_Active", 1, -1);
				}
			}
			else
			{
				if (FactsQuerySum("ACS_Win_Gwent_Active") > 0)
				{
					FactsRemove("ACS_Win_Gwent_Active");
				}
			}
		}
		else
		{
			if (FactsQuerySum("ACS_Win_Gwent_Active") > 0)
			{
				FactsRemove("ACS_Win_Gwent_Active");
			}
		}
	}

	function Wisp_Levelup_Tutorial()
	{
		if (thePlayer.GetLevel() >= 5 && thePlayer.GetLevel() < 10)
		{
			ACS_Tutorial_Display_Check('ACS_Wisp_Level_05_Tutorial_Shown');
		}
		else if (thePlayer.GetLevel() >= 10 && thePlayer.GetLevel() < 15)
		{
			ACS_Tutorial_Display_Check('ACS_Wisp_Level_10_Tutorial_Shown');
		}
		else if (thePlayer.GetLevel() >= 15 && thePlayer.GetLevel() < 20)
		{
			ACS_Tutorial_Display_Check('ACS_Wisp_Level_15_Tutorial_Shown');
		}
		else if (thePlayer.GetLevel() >= 20 && thePlayer.GetLevel() < 25)
		{
			ACS_Tutorial_Display_Check('ACS_Wisp_Level_20_Tutorial_Shown');
		}
		else if (thePlayer.GetLevel() >= 25)
		{
			ACS_Tutorial_Display_Check('ACS_Wisp_Level_25_Tutorial_Shown');
		}
	}

	function CreateShadowdashBlood()
	{
		var ent_1									: CEntity;

		ent_1 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

		"dlc\dlc_acs\data\entities\other\fx_dummy_entity.w2ent"
			
		, true ), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );

		ent_1.CreateAttachment( thePlayer, , Vector( 0, 0.5, 0 ), EulerAngles(0,0,0 ));

		//ent_1.PlayEffect('shadowdash_body_blood_construct');

		ent_1.PlayEffect('shadowdash_construct');

		ent_1.AddTag('ACS_Vampire_Sprint_FX');
	}

	function CreateVampireRollBlood()
	{
		var actor							: CActor; 
		var actors		    				: array<CActor>;
		var ent_1							: CEntity;
		var i 								: int;
		var dmg								: W3DamageAction;
		var damageMax, damageMin			: float;
	

		ACSGetCEntity('ACS_Vampire_Roll_FX').Destroy();

		ent_1 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

		"dlc\dlc_acs\data\entities\other\fx_dummy_entity.w2ent"
			
		, true ), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );

		ent_1.CreateAttachment( thePlayer, , Vector( 0, 0.5, 0 ), EulerAngles(0,0,0 ));

		//ent_1.PlayEffect('shadowdash_body_blood_construct');

		ent_1.PlayEffect('shadowdash_construct');

		ent_1.AddTag('ACS_Vampire_Roll_FX');

		RemoveTimer('Vampire_Monster_Bat_Swarm_Small');
		AddTimer('Vampire_Monster_Bat_Swarm_Small', 0.5 , false);

		actors.Clear();

		actors = thePlayer.GetNPCsAndPlayersInRange( 3, 10, , FLAG_OnlyAliveActors + FLAG_Attitude_Hostile + FLAG_ExcludePlayer);

		if( actors.Size() > 0 )
		{
			for ( i=0; i<actors.Size(); i+= 1 )
			{
				dmg = new W3DamageAction in theGame.damageMgr;

				actor = actors[i];
					
				dmg.Initialize(GetWitcherPlayer(), actor, NULL, GetWitcherPlayer().GetName(), EHRT_Heavy, CPS_Undefined, false, false, true, false);
				
				dmg.SetProcessBuffsIfNoDamage(true);
				
				dmg.SetHitReactionType( EHRT_Heavy, true);

				if (actor.UsesVitality()) 
				{ 
					damageMax = actor.GetStat( BCS_Vitality ) * 0.025; 
					
					damageMin = actor.GetStat( BCS_Vitality ) * 0.0125; 
				} 
				else if (actor.UsesEssence()) 
				{ 
					damageMax = actor.GetStat( BCS_Essence ) * 0.025; 
					
					damageMin = actor.GetStat( BCS_Essence ) * 0.0125; 
				} 

				damageMax += damageMax * ACS_SignIntensityPercentage('total') * 0.5;

				damageMin += damageMin * ACS_SignIntensityPercentage('total') * 0.5;

				dmg.AddDamage( theGame.params.DAMAGE_NAME_PHYSICAL, 50 + RandRangeF(damageMax,damageMin) );

				dmg.AddDamage( theGame.params.DAMAGE_NAME_SILVER, 50 + RandRangeF(damageMax,damageMin) );

				dmg.AddEffectInfo( EET_Swarm, 3 );
					
				dmg.SetCriticalHit(); theGame.damageMgr.ProcessAction( dmg );
					
				delete dmg;
			}
		}
	}

	var last_vampire_sprint_damage_time : float;

	function VampireSprintDamage()
	{
		var actor							: CActor; 
		var actors		    				: array<CActor>;
		var enemyAnimatedComponent 			: CAnimatedComponent;
		var i								: int;
		var npc								: CNewNPC;
		var dmg								: W3DamageAction;
		var projDMG							: float;

		actors.Clear();

		actors = thePlayer.GetNPCsAndPlayersInRange( 2, 50, , FLAG_Attitude_Hostile + FLAG_ExcludePlayer + FLAG_OnlyAliveActors);

		if( actors.Size() > 0 )
		{
			for( i = 0; i < actors.Size(); i += 1 )
			{
				npc = (CNewNPC)actors[i];

				actor = actors[i];

				dmg =  new W3DamageAction in this;

				dmg.Initialize(GetWitcherPlayer(), actor, GetWitcherPlayer(), GetWitcherPlayer().GetName(), EHRT_None, CPS_Undefined, false, false, true, false);

				if (actor.UsesVitality()) 
				{ 
					if ( actor.GetStat( BCS_Vitality ) >= actor.GetStatMax( BCS_Vitality ) * 0.25 )
					{
						projDMG = actor.GetStat( BCS_Vitality ) * 0.06125; 
					}
					else if ( actor.GetStat( BCS_Vitality ) < actor.GetStatMax( BCS_Vitality ) * 0.25 )
					{
						projDMG = ( actor.GetStatMax( BCS_Vitality ) - actor.GetStat( BCS_Vitality ) ) * 0.06125; 
					}
				} 
				else if (actor.UsesEssence()) 
				{ 
					if (((CMovingPhysicalAgentComponent)(actor.GetMovingAgentComponent())).GetCapsuleHeight() >= 2
					|| actor.GetRadius() >= 0.7
					|| actor.HasAbility('Boss')
					|| actor.HasTag('IsBoss')
					|| actor.HasTag('ACS_Big_Boi')
					)
					{
						if ( actor.GetStat( BCS_Essence ) >= actor.GetStatMax( BCS_Essence ) * 0.25 )
						{
							projDMG = actor.GetStat( BCS_Essence ) * 0.030625; 
						}
						else if ( actor.GetStat( BCS_Essence ) < actor.GetStatMax( BCS_Essence ) * 0.25 )
						{
							projDMG = ( actor.GetStatMax( BCS_Essence ) - actor.GetStat( BCS_Essence ) ) * 0.030625; 
						}
					}
					else
					{
						if ( actor.GetStat( BCS_Essence ) >= actor.GetStatMax( BCS_Essence ) * 0.25 )
						{
							projDMG = actor.GetStat( BCS_Essence ) * 0.06125; 
						}
						else if ( actor.GetStat( BCS_Essence ) < actor.GetStatMax( BCS_Essence ) * 0.25 )
						{
							projDMG = ( actor.GetStatMax( BCS_Essence ) - actor.GetStat( BCS_Essence ) ) * 0.06125; 
						}
					}
				}

				projDMG += projDMG * ACS_SignIntensityPercentage('total') * 0.5;

				dmg.AddDamage( theGame.params.DAMAGE_NAME_PHYSICAL, 50 + projDMG );

				dmg.AddDamage( theGame.params.DAMAGE_NAME_SILVER, 50 + projDMG );

				dmg.SetHitAnimationPlayType(EAHA_ForceYes);

				dmg.AddEffectInfo(EET_Bleeding, 0.5);

				dmg.SetForceExplosionDismemberment();
				
				dmg.SetCriticalHit(); theGame.damageMgr.ProcessAction( dmg );
				
				delete dmg;
			}
		}
	}

	function VampireClawsSprintHide()
	{
		if( 
		theGame.IsDialogOrCutscenePlaying() 
		|| !thePlayer.IsAlive()
		|| thePlayer.IsInCutsceneIntro()
		|| theGame.HasBlackscreenRequested()
		|| theGame.IsCurrentlyPlayingNonGameplayScene()
		|| theGame.GetGuiManager().IsAnyMenu()
		|| theGame.GetTutorialSystem().HasActiveTutorial()
		|| theGame.GetPhotomodeEnabled() 
		|| !thePlayer.HasTag('acs_vampire_claws_equipped')
		)
		{
			if (thePlayer.HasTag('ACS_Vampires_Claws_Sprinting'))
			{
				thePlayer.ACS_ClearAnimationSpeedMultipliers();

				thePlayer.ACS_SetAnimationSpeedMultiplier(1);

				thePlayer.SoundEvent("monster_dettlaff_monster_combat_construct_dash_vfx");
					
				thePlayer.SoundEvent("magic_yennefer_necromancy_loop_stop");

				thePlayer.SoundEvent("q704_regis_mistform_LP_stop");
				thePlayer.SoundEvent("q704_regis_mistform_LP_stop");
				thePlayer.SoundEvent("q704_regis_mistform_LP_stop");

				thePlayer.StopEffect('shadowdash_body_blood_construct');

				thePlayer.StopEffect('shadowdash_ground_blood_construct');

				thePlayer.StopEffect('avatar_death_swollen_no_decal_construct');

				ACSGetCEntity('ACS_Vampire_Sprint_FX').StopEffect('shadowdash_construct');

				ACSGetCEntity('ACS_Vampire_Sprint_FX').DestroyAfter(3);

				ACSGetCEntity('ACS_Vampire_Sprint_FX').RemoveTag('ACS_Vampire_Sprint_FX');

				if(FactsQuerySum("acs_transformation_activated") <= 0)
				{
					if (!thePlayer.IsUsingHorse()&& !thePlayer.IsUsingVehicle()){thePlayer.EnableCharacterCollisions(true); } 

					thePlayer.SetVisibility(true);

					thePlayer.SetCanPlayHitAnim(true); 
				}

				thePlayer.RemoveBuffImmunity_AllNegative('ACS_Vampire_Claws_Sprint_Immunity_Negative'); 
				thePlayer.RemoveBuffImmunity_AllCritical('ACS_Vampire_Claws_Sprint_Immunity_Critical'); 

				thePlayer.SetImmortalityMode( AIM_None, AIC_Default, true );

				RemoveTimer('Vampire_Monster_Bat_Swarm_Small');

				thePlayer.RemoveTag('ACS_Vampires_Claws_Sprinting');
			}

			return;
		}

		if (thePlayer.HasTag('acs_vampire_claws_equipped'))
		{
			if (((thePlayer.GetIsSprinting() && thePlayer.GetSprintingTime() > 0.05))
			&& !thePlayer.IsCurrentlyDodging()
			&& !thePlayer.HasTag('ACS_Is_Currently_Dodging')
			&& !thePlayer.HasTag('ACS_Air_Time')
			)
			{
				thePlayer.DrainVitality(thePlayer.GetStat(BCS_Vitality) * 0.0001225);

				if (theGame.GetEngineTimeAsSeconds() - last_vampire_sprint_damage_time > 0.25)
				{
					last_vampire_sprint_damage_time = theGame.GetEngineTimeAsSeconds();

					VampireSprintDamage();
				}

				if (!thePlayer.HasTag('ACS_Vampires_Claws_Sprinting'))
				{
					thePlayer.ACS_ClearAnimationSpeedMultipliers();

					thePlayer.ACS_SetAnimationSpeedMultiplier(2);

					thePlayer.SoundEvent("monster_dettlaff_monster_combat_construct_dash_vfx");

					thePlayer.SoundEvent("magic_yennefer_necromancy_loop_start");

					thePlayer.SoundEvent( "q704_regis_mistform_activates" );

					thePlayer.SoundEvent( "q704_regis_mistform_LP" );
					thePlayer.SoundEvent( "q704_regis_mistform_LP" );
					thePlayer.SoundEvent( "q704_regis_mistform_LP" );

					//thePlayer.PlayEffect('avatar_death_swollen_no_decal_construct');

					thePlayer.PlayEffect('shadowdash_body_blood_construct');

					thePlayer.PlayEffect('shadowdash_ground_blood_construct');

					CreateShadowdashBlood();

					thePlayer.SetVisibility(false);

					thePlayer.SetCanPlayHitAnim(false); 

					thePlayer.EnableCharacterCollisions(false); 

					GetWitcherPlayer().AddBuffImmunity_AllNegative('ACS_Vampire_Claws_Sprint_Immunity_Negative', true); 
					GetWitcherPlayer().AddBuffImmunity_AllCritical('ACS_Vampire_Claws_Sprint_Immunity_Critical', true); 

					thePlayer.SetImmortalityMode( AIM_Invulnerable, AIC_Default, true );

					RemoveTimer('Vampire_Monster_Bat_Swarm_Small');
					AddTimer('Vampire_Monster_Bat_Swarm_Small', 0.5 , true);

					thePlayer.AddTag('ACS_Vampires_Claws_Sprinting');
				}
			}
			else
			{
				if (thePlayer.HasTag('ACS_Vampires_Claws_Sprinting'))
				{
					thePlayer.ACS_ClearAnimationSpeedMultipliers();

					thePlayer.ACS_SetAnimationSpeedMultiplier(1);

					thePlayer.SoundEvent("monster_dettlaff_monster_combat_construct_dash_vfx");

					thePlayer.SoundEvent("magic_yennefer_necromancy_loop_stop");

					thePlayer.SoundEvent("q704_regis_mistform_LP_stop");
					thePlayer.SoundEvent("q704_regis_mistform_LP_stop");
					thePlayer.SoundEvent("q704_regis_mistform_LP_stop");

					thePlayer.StopEffect('shadowdash_body_blood_construct');

					thePlayer.StopEffect('shadowdash_ground_blood_construct');

					thePlayer.StopEffect('avatar_death_swollen_no_decal_construct');

					ACSGetCEntity('ACS_Vampire_Sprint_FX').StopEffect('shadowdash_construct');

					ACSGetCEntity('ACS_Vampire_Sprint_FX').DestroyAfter(3);

					ACSGetCEntity('ACS_Vampire_Sprint_FX').RemoveTag('ACS_Vampire_Sprint_FX');

					if(FactsQuerySum("acs_transformation_activated") <= 0)
					{
						if (!thePlayer.IsUsingHorse()&& !thePlayer.IsUsingVehicle()){thePlayer.EnableCharacterCollisions(true); } 

						thePlayer.SetVisibility(true);

						thePlayer.SetCanPlayHitAnim(true); 
					}

					thePlayer.RemoveBuffImmunity_AllNegative('ACS_Vampire_Claws_Sprint_Immunity_Negative'); 
					thePlayer.RemoveBuffImmunity_AllCritical('ACS_Vampire_Claws_Sprint_Immunity_Critical'); 

					thePlayer.SetImmortalityMode( AIM_None, AIC_Default, true );

					RemoveTimer('Vampire_Monster_Bat_Swarm_Small');

					thePlayer.RemoveTag('ACS_Vampires_Claws_Sprinting');
				}
			}
		}
	}


								steel_fast_stance = false;

								steel_group_stance = true;
							}
							else if ( 
							steel_group_stance 
							&& !steel_strong_stance 
							&& !steel_fast_stance
							)
							{
								ShowSwordStanceNotification(ent,  GetLocStringById(2116581195));

								steel_group_stance = false;

								steel_strong_stance = true;
							}
							else if ( 

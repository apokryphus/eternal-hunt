				if ( !theGame.GetEntityByTag('ACS_Meditation_Primary_Bolt') )
				{
					bolt = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource(deployedEnt.GetReadableName(),true ), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation()  );

					bolt.BreakAttachment();
					

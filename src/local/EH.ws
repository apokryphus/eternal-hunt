		&& !thePlayer.IsUsingHorse()
		&& !thePlayer.IsUsingVehicle())
		{
			if (!thePlayer.HasTag('acs_vampire_claws_equipped'))
			{
				return false;
			}
			
			if( IsPressed(action) && thePlayer.IsInCombat())
			{
				if ( !thePlayer.HasTag('ACS_Bruxa_Bite_Process') )
				{
					ACS_BruxaBiteInit();
				}
				else
				{
					bruxa_blood_suck_end_actual();
				}
			}

			return false;
		}

		if ( GetWitcherPlayer().IsItemEquippedByName('acs_drowner_extract_item') 
		&& thePlayer.GetInventory().GetItemName( itemId ) == 'acs_drowner_extract_item' 
		&& !thePlayer.IsUsingHorse()
		&& !thePlayer.IsUsingVehicle())
		{
			if( IsPressed(action))
			{
				ACS_Player_Tentacles(1);

				RemoveTimer('ACS_Player_Tentacle_Damage_Delay');
				AddTimer('ACS_Player_Tentacle_Damage_Delay', 1 , false);
			}

			return false;
		}

		if ( GetWitcherPlayer().IsItemEquippedByName('Torch') 
		&& thePlayer.GetInventory().GetItemName( itemId ) == 'Torch' 
		)
		{
			ACS_Tutorial_Display_Check('ACS_Torch_Use_Tutorial_Shown');

			if ( thePlayer.IsHoldingItemInLHand()
			&& IsPressed(action) 
			&& !GetACSTorchProjectile()
			&& thePlayer.IsHardLockEnabled() 
			&& thePlayer.GetTarget()
			)
			{
				TorchUse();

				return false;
			}
		}

		if ( 
		(GetWitcherPlayer().IsItemEquippedByName('acs_wolf_medallion') 
		&& thePlayer.GetInventory().GetItemName( itemId ) == 'acs_wolf_medallion' )
		|| 
		(GetWitcherPlayer().IsItemEquippedByName('acs_forgotten_wolf_medallion') 
		&& thePlayer.GetInventory().GetItemName( itemId ) == 'acs_forgotten_wolf_medallion' )
		||
		(GetWitcherPlayer().IsItemEquippedByName('acs_manticore_medallion') 
		&& thePlayer.GetInventory().GetItemName( itemId ) == 'acs_manticore_medallion' )
		|| 
		(GetWitcherPlayer().IsItemEquippedByName('acs_griffin_medallion') 
		&& thePlayer.GetInventory().GetItemName( itemId ) == 'acs_griffin_medallion' )
		|| 
		(GetWitcherPlayer().IsItemEquippedByName('acs_cat_medallion') 
		&& thePlayer.GetInventory().GetItemName( itemId ) == 'acs_cat_medallion' )
		|| 
		(GetWitcherPlayer().IsItemEquippedByName('acs_bear_medallion') 
		&& thePlayer.GetInventory().GetItemName( itemId ) == 'acs_bear_medallion' )
		|| 
		(GetWitcherPlayer().IsItemEquippedByName('acs_viper_medallion') 
		&& thePlayer.GetInventory().GetItemName( itemId ) == 'acs_viper_medallion' )
		)
		{
			if( IsPressed(action) )
			{
				WitcherMedallionControl();
			}

			return false;
		}

		if(thePlayer.IsInAir() || thePlayer.GetWeaponHolster().IsOnTheMiddleOfHolstering())
			return false;
			
		if( thePlayer.IsSwimming() && !thePlayer.OnCheckDiving() && thePlayer.GetCurrentStateName() != 'AimThrow' )
			return false;
		
		if(!thePlayer.inv.IsIdValid(itemId))
			return false;
		
		isCrossbow = thePlayer.inv.IsItemCrossbow(itemId);
		if(!isCrossbow)
		{
			isBomb = thePlayer.inv.IsItemBomb(itemId);
			if(!isBomb)
			{
				isUsableItem = true;
			}
		}
		
		if( isCrossbow )
		{
			if ( thePlayer.IsActionAllowed(EIAB_Crossbow) )
			{
				if( IsPressed(action))
				{
					if ( thePlayer.IsHoldingItemInLHand() && !thePlayer.IsUsableItemLBlocked() )
					{

						
						thePlayer.SetPlayerActionToRestore ( PATR_Crossbow );
						thePlayer.OnUseSelectedItem( true );
						ret = true;						
					}
					else if ( thePlayer.GetBIsInputAllowed() && !thePlayer.IsCurrentlyUsingItemL() )
					{
						thePlayer.SetIsAimingCrossbow( true );
						thePlayer.SetupCombatAction( EBAT_ItemUse, BS_Pressed );
						
						if (ACSGetCEntity('ACS_Player_Merchant_Ship') || ACSGetCEntity('ACS_Player_Ghost_Ship'))
						{
							if(!bigShipAnimProcess)
							{
								RemoveTimer('BigShipAnimProcessReset');
								AddTimer('BigShipAnimProcessReset', 3 , false);

								BigShipLaunchProjectile();

								bigShipAnimProcess = true;
							}
						}
								
						
						ret = true;
					}
				}
				else
				{

					if ( thePlayer.GetIsAimingCrossbow() && !thePlayer.IsCurrentlyUsingItemL() )
					{
						thePlayer.SetupCombatAction( EBAT_ItemUse, BS_Released );
						thePlayer.SetIsAimingCrossbow( false );
						ret = true;
					}
				}
			}
			else
			{
				if ( !thePlayer.IsInShallowWater() )
					thePlayer.DisplayActionDisallowedHudMessage(EIAB_Crossbow);				
			}

			if (ret = true )
			{
				if( IsPressed(action))
				{
					action_interrupt();
				}
			}
			
			if ( IsPressed(action) )
				thePlayer.AddTimer( 'IsItemUseInputHeld', 0.00001 , true );
			else
				thePlayer.RemoveTimer('IsItemUseInputHeld');

			return ret;
		}
		else if(isBomb)
		{
			return OnThrowBomb(action);
		}
		else if(isUsableItem && !thePlayer.IsSwimming() )
		{
			if( thePlayer.IsActionAllowed(EIAB_UsableItem) )
			{
				if(IsPressed(action) && thePlayer.HasStaminaToUseAction(ESAT_UsableItem))
				{
					thePlayer.SetPlayerActionToRestore ( PATR_Default );
					thePlayer.OnUseSelectedItem();
					return true;
				}

			}
			else
			{
				thePlayer.DisplayActionDisallowedHudMessage(EIAB_UsableItem);
			}
		}
		
		return false;
	}
	
	event OnCbtThrowItemHold( action : SInputAction )
	{
		var isBomb, isCrossbow, isUsableItem 			: bool;
		var itemId 										: SItemUniqueId;

		if (thePlayer.HasTag('ACS_IsSwordWalking'))
		{
			thePlayer.RemoveTag('ACS_IsSwordWalking');
		}

		//SwordWalkAdditiveEnd(action);

		if (FactsQuerySum("acs_transformation_activated") > 0)
		{
			return false;
		}
		
		if(thePlayer.IsInAir() || thePlayer.GetWeaponHolster().IsOnTheMiddleOfHolstering() )
			return false;
			
		if( thePlayer.IsSwimming() && !thePlayer.OnCheckDiving() && thePlayer.GetCurrentStateName() != 'AimThrow' )
			return false;			
				
		itemId = thePlayer.GetSelectedItemId();
		
		if(!thePlayer.inv.IsIdValid(itemId))
			return false;
		
		isCrossbow = thePlayer.inv.IsItemCrossbow(itemId);
		if(!isCrossbow)
		{
			isBomb = thePlayer.inv.IsItemBomb(itemId);
			if(isBomb)
			{
				return OnThrowBombHold(action);
			}
			else
			{
				isUsableItem = true;
			}
		}
		
		
		if(IsPressed(action))
		{
			if( isCrossbow && !thePlayer.IsActionAllowed(EIAB_Crossbow) )
			{
				thePlayer.DisplayActionDisallowedHudMessage(EIAB_Crossbow);
				return false;
			}
			
			if( isUsableItem)
			{
				if(!thePlayer.IsActionAllowed(EIAB_UsableItem))
				{
					thePlayer.DisplayActionDisallowedHudMessage(EIAB_UsableItem);
					return false;
				}
				else if(thePlayer.IsSwimming())
				{
					thePlayer.DisplayActionDisallowedHudMessage(EIAB_Undefined, false, false, true);
					return false;
				}
			}
		}
	
		if( IsPressed(action) )
		{
			thePlayer.SetThrowHold( true );
			return true;
		}
		else if( IsReleased(action) && thePlayer.IsThrowHold())
		{
			thePlayer.SetupCombatAction( EBAT_ItemUse, BS_Released );
			thePlayer.SetThrowHold( false );
			return true;
		}
		
		return false;
	}

	var vACS_Sword_Array : cACS_Sword_Array;
	
	event OnCbtThrowCastAbort( action : SInputAction )
	{
		var player : W3PlayerWitcher;
		var throwStage : EThrowStage;

		if (FactsQuerySum("acs_transformation_activated") > 0)
		{
			return false;
		}
		
		if(thePlayer.inv.IsItemBomb(thePlayer.GetSelectedItemId()))
		{
			return OnThrowBombAbort(action);							
		}
		
		if( IsPressed(action) )
		{
			player = GetWitcherPlayer();
			if(player)
			{
				if( player.IsCastingSign() )
				{
					player.CastSignAbort();
				}
				else
				{
					if ( thePlayer.inv.IsItemCrossbow( thePlayer.inv.GetItemFromSlot( 'l_weapon' ) ) )
					{
						thePlayer.OnRangedForceHolster();
					}
					else
					{
						throwStage = (int)thePlayer.GetBehaviorVariable( 'throwStage', (int)TS_Stop);
						
						if(throwStage == TS_Start || throwStage == TS_Loop)
							player.ThrowingAbort();
					}
				}
			}
		}
	}

	event OnSpare( action : SInputAction )
	{

	}

	event OnSelectSign(action : SInputAction)
	{
		if(theGame.GetInGameConfigWrapper().GetVarValue('Gameplay', 'EnableAlternateSignCasting') == "1")
		{
			altSignCasting = true;
		}	
		else
		{
			altSignCasting = false;
		}

		if( IsPressed( action ) )
		{
			if(altSignCasting)
			{
				if (ACS_Settings_Main_Bool('acs_signs_settings','acs_alternate_quickcasting_controls_enabled', false))
				{
					return false;
				}

				switch( action.aName )
				{				
					case 'SelectAard' :
						AltCastSign(ST_Aard);
						break;
					case 'SelectYrden' :
						AltCastSign(ST_Yrden);
						break;
					case 'SelectIgni' :
						AltCastSign(ST_Igni);
						break;
					case 'SelectQuen' :
						AltCastSign(ST_Quen);
						break;
					case 'SelectAxii' :
						AltCastSign(ST_Axii);
						break;
					default :
						break;
				}
			}
			
			else
			{
				switch( action.aName )
				{
					case 'SelectAard' :
						GetWitcherPlayer().SetEquippedSign(ST_Aard);
						break;
					case 'SelectYrden' :
						GetWitcherPlayer().SetEquippedSign(ST_Yrden);
						break;
					case 'SelectIgni' :
						GetWitcherPlayer().SetEquippedSign(ST_Igni);
						break;
					case 'SelectQuen' :
						GetWitcherPlayer().SetEquippedSign(ST_Quen);
						break;
					case 'SelectAxii' :
						GetWitcherPlayer().SetEquippedSign(ST_Axii);
						break;
					default :
						break;
				}
			}
		}

		if (IsReleased(action) 
		&& altSignCasting 
		&& GetWitcherPlayer().IsCurrentSignChanneled())
		{
			ACSGetCEntity('ACS_Sign_Icon').StopEffect('burn');
			ACSGetCEntity('ACS_Sign_Icon').StopEffect('burn_upgrade');
			ACSGetCEntity('ACS_Sign_Icon').StopEffect('burn_1');
			ACSGetCEntity('ACS_Sign_Icon').StopEffect('burn_upgrade_1');

			ACSGetCEntity('ACS_Sign_Icon').StopEffect('burn_red');
			ACSGetCEntity('ACS_Sign_Icon').StopEffect('burn_upgrade_red');
			ACSGetCEntity('ACS_Sign_Icon').StopEffect('burn_1_red');
			ACSGetCEntity('ACS_Sign_Icon').StopEffect('burn_upgrade_1_red');

			if (ACSGetCEntity('ACS_Sign_Icon').IsEffectActive('electric_stream_normal', false))
			{
				ACSGetCEntity('ACS_Sign_Icon').SoundEvent("magic_sorceress_vfx_lightning_fx_loop_stop");

				ACSGetCEntity('ACS_Sign_Icon').SoundEvent("amb_dyn_bob_electric_cage_fx_stop");

				ACSGetCEntity('ACS_Sign_Icon').StopEffect('electric_stream_normal');
			}

			if (ACSGetCEntity('ACS_Sign_Icon').IsEffectActive('electric_stream_blue', false))
			{
				ACSGetCEntity('ACS_Sign_Icon').SoundEvent("magic_sorceress_vfx_lightning_fx_loop_stop");

				ACSGetCEntity('ACS_Sign_Icon').SoundEvent("amb_dyn_bob_electric_cage_fx_stop");

				ACSGetCEntity('ACS_Sign_Icon').StopEffect('electric_stream_blue');
			}

			RemoveTimer('SignIconDestroyDelay');

			if ( GetWitcherPlayer().GetEquippedSign() == ST_Aard
			|| GetWitcherPlayer().GetEquippedSign() == ST_Yrden
			)
			{
				AddTimer('SignIconDestroyDelay', 0.5 , false);
			}
			else
			{
				AddTimer('SignIconDestroyDelay', 0.25 , false);
			}

			thePlayer.AbortSign();
		}
	}

	

	function SetPlayerTarget()
	{
		var actor : CActor;

		if ( thePlayer.IsHardLockEnabled() && thePlayer.GetTarget() )
		{
			actor = (CActor)( thePlayer.GetDisplayTarget() );	
		}
		else
		{
			if (ACS_Settings_Main_Int('acs_target_settings','acs_target_mode', 0) == 1 
			|| FactsQuerySum("acs_transformation_activated") > 0
			|| ACS_IS_SNEAKING
			|| thePlayer.HasTag('ACS_Is_Sneaking')
			)
			{
				thePlayer.FindMoveTarget();

				if ( thePlayer.moveTarget && ACS_Settings_Main_Bool('acs_target_settings','acs_target_in_frame_check', true))
				{
					actor = (CActor)( thePlayer.moveTarget );	
				}	
			}
			else
			{
				if ( thePlayer.GetTarget() )
				{
					actor = (CActor)( thePlayer.GetTarget() );	
				}
				else
				{
					thePlayer.FindMoveTarget();

					if ( thePlayer.moveTarget 
					&& ACS_Settings_Main_Bool('acs_target_settings','acs_target_in_frame_check', true)
					&& ((CActor)(thePlayer.moveTarget)).GetGameplayVisibility()
					)
					{
						actor = (CActor)( thePlayer.moveTarget );	
					}
				}
			}
		}
	
		if( actor 
		&& ACS_AttitudeCheck ( actor )
		&& actor.IsInCombat()
		&& thePlayer.playerAiming.GetCurrentStateName() != 'Aiming'
		)
		{
			thePlayer.SetPlayerTarget( actor );

			thePlayer.SetPlayerCombatTarget( actor );

			thePlayer.UpdateDisplayTarget( true );

			//thePlayer.OnBecomeAwareAndCanAttack( actor );

			//thePlayer.OnCanFindPath( actor );

			//thePlayer.UpdateLookAtTarget();
		}
	}

	var player_animation_name : name;

	function PlayerPlayAnimation(animation_name: name, optional blendin, blendout : float)
	{
		var internalBlendin, internalBlendout : float;

		player_animation_name = animation_name;

		if (blendin)
		{
			internalBlendin = blendin;
		}
		else
		{
			internalBlendin = 0.25f;
		}

		if (blendout)
		{
			internalBlendout = blendout;
		}
		else
		{
			internalBlendout = 0.375f;
		}

		thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( animation_name, 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(internalBlendin, internalBlendout) );
	}

	function MovementAdjust( movmentAdjustName : CName )
	{		
		if (getIsInCombatSlide)
		{
			return;
		}

		if (ACS_Settings_Main_Int('acs_target_settings','acs_target_mode', 0) == 1)
		{
			if ( thePlayer.IsHardLockEnabled() && thePlayer.GetDisplayTarget() )
			{
				actor = (CActor)( thePlayer.GetDisplayTarget() );	
			}
			else
			{
				if (thePlayer.GetDisplayTarget())
				{
					actor = (CActor)( thePlayer.GetDisplayTarget() );	
				}
				else
				{
					if ( thePlayer.moveTarget )
					{
						actor = (CActor)( thePlayer.moveTarget );	
					}
				}
			}
		}
		else
		{
			if ( thePlayer.GetDisplayTarget() )
			{
				actor = (CActor)( thePlayer.GetDisplayTarget() );	
			}
			else
			{
				if ( thePlayer.moveTarget )
				{
					actor = (CActor)( thePlayer.moveTarget );	
				}
			}
		}

		targetDistance = VecDistanceSquared2D( thePlayer.GetWorldPosition(), actor.GetWorldPosition() ) ;
			
		dist = (((CMovingPhysicalAgentComponent)actor.GetMovingAgentComponent()).GetCapsuleRadius() 
		+ ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent()).GetCapsuleRadius()) * 1.25;
		
		distJump = (((CMovingPhysicalAgentComponent)actor.GetMovingAgentComponent()).GetCapsuleRadius() 
		+ ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent()).GetCapsuleRadius());
		
		distVampSpecialDash = (((CMovingPhysicalAgentComponent)actor.GetMovingAgentComponent()).GetCapsuleRadius() 
		+ ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent()).GetCapsuleRadius()) * 2;

		distClawWhirl = (((CMovingPhysicalAgentComponent)actor.GetMovingAgentComponent()).GetCapsuleRadius() 
		+ ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent()).GetCapsuleRadius()) * 1.5;

		distArmorSpecialDash = (((CMovingPhysicalAgentComponent)actor.GetMovingAgentComponent()).GetCapsuleRadius() * 1.25 
		+ ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent()).GetCapsuleRadius() * 1.25);
	
		movementAdjustor = thePlayer.GetMovingAgentComponent().GetMovementAdjustor();
		
		movementAdjustor.CancelAll();
		
		movementAdjustor.CancelByName('ACSMovAdj');
		ticket = movementAdjustor.CreateNewRequest( 'ACSMovAdj' );
		
		if( actor && ACS_AttitudeCheck ( actor ) && thePlayer.IsInCombat())
		{
			if (FactsQuerySum("ACS_Slayer_Active") > 0 || FactsQuerySum("ACS_Azkar_Active") > 0)
			{
				movementAdjustor.AdjustmentDuration( ticket, 0.125 );
			}
			else
			{
				if( targetDistance <= 3.5*3.5 ) 
				{
					movementAdjustor.AdjustmentDuration( ticket, 0.1 );
				}
				else if( targetDistance > 3.5*3.5 && targetDistance <= 4 * 4 ) 
				{
					movementAdjustor.AdjustmentDuration( ticket, 0.125 );
				}
				else
				{
					movementAdjustor.AdjustmentDuration( ticket, 0.25 );
				}
			}
		}
		else
		{
			movementAdjustor.AdjustmentDuration( ticket, 0.25 );
		}
		
		//movementAdjustor.ShouldStartAt(ticket, thePlayer.GetWorldPosition());
		movementAdjustor.MaxRotationAdjustmentSpeed( ticket, 50000 );
		movementAdjustor.MaxLocationAdjustmentSpeed( ticket, 50000 );

		if (ACS_Settings_Main_Float('acs_visual_main_settings','acs_player_scale', 1) > 1)
		{
			dist -= ACS_Settings_Main_Float('acs_visual_main_settings','acs_player_scale', 1) * 0.25;

			distJump -= ACS_Settings_Main_Float('acs_visual_main_settings','acs_player_scale', 1) * 0.25;

			distVampSpecialDash -= ACS_Settings_Main_Float('acs_visual_main_settings','acs_player_scale', 1) * 0.25;

			distClawWhirl -= ACS_Settings_Main_Float('acs_visual_main_settings','acs_player_scale', 1) * 0.25;

			targetDistance += ACS_Settings_Main_Float('acs_visual_main_settings','acs_player_scale', 1) * 0.25;
		}
		else if (ACS_Settings_Main_Float('acs_visual_main_settings','acs_player_scale', 1) < 1)
		{
			dist += ACS_Settings_Main_Float('acs_visual_main_settings','acs_player_scale', 1) * 0.5;

			distJump += ACS_Settings_Main_Float('acs_visual_main_settings','acs_player_scale', 1) * 0.5;

			distVampSpecialDash += ACS_Settings_Main_Float('acs_visual_main_settings','acs_player_scale', 1) * 0.5;

			distClawWhirl += ACS_Settings_Main_Float('acs_visual_main_settings','acs_player_scale', 1) * 0.5;

			targetDistance -= ACS_Settings_Main_Float('acs_visual_main_settings','acs_player_scale', 1) * 0.25;
		}

		if(thePlayer.HasTag('ACS_Manual_Combat_Control')){thePlayer.RemoveTag('ACS_Manual_Combat_Control');} RemoveTimer('Manual_Combat_Control_Remove');


		switch(movmentAdjustName)
		{
			case 'wraith':
			movementAdjustor.AdjustLocationVertically( ticket, true );
			movementAdjustor.ScaleAnimationLocationVertically( ticket, true );
			break;

			case 'bruxa_dash':
			if (thePlayer.IsSwimming())
			{
				movementAdjustor.AdjustLocationVertically( ticket, true );
				movementAdjustor.ScaleAnimationLocationVertically( ticket, true );
			}

			movementAdjustor.AdjustmentDuration( ticket, 0.5 );

			if(!thePlayer.HasTag('ACS_Camo_Active'))
			{
				//thePlayer.StopAllEffects();
			}
			
			if (thePlayer.HasTag('ACS_ember_particles_active'))
			{
				thePlayer.StopEffect('embers_particles_test');
				thePlayer.PlayEffectSingle('embers_particles_test');
			}
			break;

			case 'dash_attack':
			if (thePlayer.HasTag('ACS_ember_particles_active'))
			{
				thePlayer.StopEffect('embers_particles_test');
				thePlayer.PlayEffectSingle('embers_particles_test');
			}

			movementAdjustor.MaxRotationAdjustmentSpeed( ticket, 1250 );
			movementAdjustor.MaxLocationAdjustmentSpeed( ticket, 75 );
			movementAdjustor.AdjustLocationVertically( ticket, true );
			movementAdjustor.ScaleAnimationLocationVertically( ticket, true );
			movementAdjustor.Continuous(ticket);

			RemoveTimer('RemoveContinuousTicket');
			AddTimer('RemoveContinuousTicket', 1 , false);
			break;

			case 'default':
			if (thePlayer.HasTag('ACS_ember_particles_active'))
			{
				thePlayer.StopEffect('embers_particles_test');
				thePlayer.PlayEffectSingle('embers_particles_test');
			}

			movementAdjustor.MaxRotationAdjustmentSpeed( ticket, 1000 );
			movementAdjustor.MaxLocationAdjustmentSpeed( ticket, 75 );
			movementAdjustor.AdjustLocationVertically( ticket, true );
			movementAdjustor.ScaleAnimationLocationVertically( ticket, true );
			movementAdjustor.Continuous(ticket);

			RemoveTimer('RemoveContinuousTicket');
			AddTimer('RemoveContinuousTicket', 0.5 , false);
			break;

			default:
			if(!thePlayer.HasTag('ACS_Camo_Active'))
			{
				//thePlayer.StopAllEffects();
			}
			
			if (thePlayer.HasTag('ACS_ember_particles_active'))
			{
				thePlayer.StopEffect('embers_particles_test');
				thePlayer.PlayEffectSingle('embers_particles_test');
			}

			movementAdjustor.MaxRotationAdjustmentSpeed( ticket, 1000 );
			movementAdjustor.MaxLocationAdjustmentSpeed( ticket, 75 );
			movementAdjustor.AdjustLocationVertically( ticket, true );
			movementAdjustor.ScaleAnimationLocationVertically( ticket, true );
			movementAdjustor.Continuous(ticket);

			RemoveTimer('RemoveContinuousTicket');
			AddTimer('RemoveContinuousTicket', 0.5 , false);
			break;
		}
	}
	
	timer function RemoveContinuousTicket( time : float , id : int )
	{
		movementAdjustor.CancelByName('ACSMovAdj');
	}

	
	
	function DeactivateThings()
	{
		if ( thePlayer.IsInCombat() || thePlayer.IsCombatMusicEnabled() )
		{
			thePlayer.RemoveTag('ACS_Player_Is_Attacking_Bounce_Arrow');

			RemoveTimer('RemovePlayerIsAttackingBounceArrowTag');

			RemoveTimer('AddPlayerIsAttackingBounceArrowTag');

			if (!thePlayer.HasTag('ACS_Bruxa_Bite_Process'))
			{
				thePlayer.SetImmortalityMode( AIM_None, AIC_Default, true ); 

				thePlayer.SetCanPlayHitAnim(true); 
				
				if (!thePlayer.HasTag('ACS_HasPerformedFinisher'))
				{
					if (!thePlayer.IsUsingHorse()&& !thePlayer.IsUsingVehicle()){thePlayer.EnableCharacterCollisions(true); } 
				}

				if( thePlayer.IsAlive() ){ thePlayer.SetVisibility( true ); }		 
				thePlayer.RemoveBuffImmunity_AllNegative('acs_dodge'); 
				thePlayer.RemoveBuffImmunity_AllNegative('acs_finisher');
				thePlayer.SetIsCurrentlyDodging(false);

				if (thePlayer.HasTag('ACS_HideWeaponOnDodge') 
				//&& !thePlayer.HasTag('ACS_Bruxa_Bite_Process')
				)
				{
					if (!thePlayer.HasTag('acs_aard_sword_equipped'))
					{
						ACS_Weapon_Respawn();
					}

					thePlayer.RemoveTag('ACS_HideWeaponOnDodge');

					thePlayer.RemoveTag('ACS_HideWeaponOnDodge_Claw_Effect');
				}
			}
		}

		thePlayer.RemoveTimer('curio_script_watcher_whirl');

		thePlayer.UnblockAction(EIAB_SpecialAttackLight, 'curio_nowhirl_weapons');

		sword_destroy();

		if ( !thePlayer.HasTag('acs_axii_sword_equipped') || !thePlayer.IsGuarded() )
		{
			RemoveTimer('ACS_Shield_Spawn_Delay');

			ACS_Axii_Shield_Destroy_IMMEDIATE();
		}
		
		if ( !thePlayer.HasTag('acs_vampire_claws_equipped') || !thePlayer.HasTag('ACS_Camo_Active') )
		{
			ACS_Bruxa_Camo_Decoy_Deactivate();
		}
	}

	function DeactivateThings_BruxaDash()
	{
		camera = (CCustomCamera)theCamera.GetTopmostCameraObject();

		camera.StopAnimation('camera_shake_loop_lvl1_1');

		theGame.GetGameCamera().StopAnimation( 'camera_shake_loop_lvl1_1' );

		camera.StopAnimation('camera_shake_loop_lvl1_5');

		theGame.GetGameCamera().StopAnimation( 'camera_shake_loop_lvl1_5' );

		if (thePlayer.IsInCombat() || thePlayer.IsCombatMusicEnabled() )
		{
			if (!thePlayer.HasTag('ACS_Bruxa_Bite_Process'))
			{
				if( thePlayer.IsAlive() ){ thePlayer.SetVisibility( true ); }		
			}
		}

		thePlayer.RemoveTimer('curio_script_watcher_whirl');

		thePlayer.UnblockAction(EIAB_SpecialAttackLight, 'curio_nowhirl_weapons');

		

		sword_destroy();

		if ( !thePlayer.HasTag('acs_axii_sword_equipped') || !thePlayer.IsGuarded() )
		{
			RemoveTimer('ACS_Shield_Spawn_Delay');

			ACS_Axii_Shield_Destroy_IMMEDIATE();
		}

		if ( !thePlayer.HasTag('acs_vampire_claws_equipped') || !thePlayer.HasTag('ACS_Camo_Active') )
		{
			ACS_Bruxa_Camo_Decoy_Deactivate();
		}
	}

	var playerContactWithNpc : bool;

	function SetPlayerContactWithNpc ( b : bool )
	{
		b = playerContactWithNpc;
	}

	var dirt_counter : int;

	function ManageDirtCounter( b : bool )
	{
		if (b)
		{
			dirt_counter += 1;
		}
		else
		{
			dirt_counter -= dirt_counter;
		}
	}

	var aim_assist_cooldown			: float;

	timer function CloseRangeAimAssist(deltaTime : float , id : int)
	{
		var displayTarget, aimTarget : CActor;
		var dist					 : float;
		var movementAdjustor 		 : CMovementAdjustor;
		var ticket	 				 : SMovementAdjustmentRequestTicket;	

		displayTarget = (CActor)(thePlayer.GetDisplayTarget());

		aimTarget = (CActor)(thePlayer.GetTarget());

		if (thePlayer.HasTag('ACS_Manual_Combat_Control')
		|| ACS_ChainWeaponCheck() 
		|| ACSGetCActor('ACS_Gravehag_Tongue_Weapon_R')
		|| thePlayer.HasTag('ACS_In_Heavenly_Strike')
		|| !ACS_Settings_Main_Bool('acs_combat_main_settings','acs_aim_assist', true)
		|| !thePlayer.IsInCombat()
		|| !thePlayer.IsThreatened()
		|| !thePlayer.GetTarget()
		|| thePlayer.HasTag('ACS_Neutral_Flip')
		|| thePlayer.HasTag('ACS_In_Combat_Art')
		|| !displayTarget
		|| !aimTarget
		|| displayTarget != aimTarget
		|| thePlayer.IsSwimming()
		|| thePlayer.IsDiving()
		|| thePlayer.IsInAir()
		|| thePlayer.IsFalling()
		|| thePlayer.IsUsingHorse()
		|| thePlayer.IsPerformingFinisher() 
		|| thePlayer.HasTag('ACS_IsPerformingFinisher')
		|| thePlayer.HasTag('ACS_IsPerformingCombatDismember')
		|| !displayTarget.IsAlive()
		|| displayTarget.HasTag('ACS_Final_Fear_Stack')
		|| !ACS_AttitudeCheck ( displayTarget )
		|| ((CNewNPC)displayTarget).IsFlying()
		|| !displayTarget.IsOnGround()
		|| thePlayer.IsCurrentlyDodging()
		|| thePlayer.HasTag('ACS_Is_Currently_Dodging')
		|| !thePlayer.WasVisibleInScaledFrame( ((CNewNPC)displayTarget), 1.f, 1.f )
		)
		{
			return;
		}

		if (thePlayer.HasTag('acs_yrden_secondary_sword_equipped')
		|| thePlayer.HasTag('acs_yrden_sword_equipped')
		|| thePlayer.HasTag('acs_quen_secondary_sword_equipped')
		|| ACS_GetItem_Sword_IsEquipped('caretaker_shovel_steel', 'steel')
		|| thePlayer.HasTag('ACS_Spear_Transform_Active')
		)
		{
			if(theInput.GetActionValue('GI_AxisLeftX') == 0
			&& theInput.GetActionValue('GI_AxisLeftY') == 0)
			{
				return;
			}
		}

		if (((CMovingPhysicalAgentComponent)(displayTarget.GetMovingAgentComponent())).GetCapsuleHeight() >= 2
		|| displayTarget.GetRadius() >= 0.7
		|| displayTarget.HasTag('ACS_Big_Boi')
		|| ((CMovingPhysicalAgentComponent)(aimTarget.GetMovingAgentComponent())).GetCapsuleHeight() >= 2
		|| aimTarget.GetRadius() >= 0.7
		|| aimTarget.HasTag('ACS_Big_Boi')
		)
		{
			return;
		}

		dist = (((CMovingPhysicalAgentComponent)displayTarget.GetMovingAgentComponent()).GetCapsuleRadius() 
			+ ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent()).GetCapsuleRadius());

		if (((VecDistanceSquared2D( thePlayer.GetWorldPosition(), displayTarget.GetWorldPosition() ) > 2 * 2) 
		&& (VecDistanceSquared2D( thePlayer.GetWorldPosition(), displayTarget.GetWorldPosition() ) <= 5.5 * 5.5)
		&& theGame.GetEngineTimeAsSeconds() - aim_assist_cooldown > 0.25
		)
		)
		{
			aim_assist_cooldown = theGame.GetEngineTimeAsSeconds();

			thePlayer.RaiseEvent('ACS_AimAssistDodgeForwardR');
			
			if (VecDistanceSquared2D( thePlayer.GetWorldPosition(), displayTarget.GetWorldPosition() ) > 2 * 2)
			{
				if (((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'wood_hollow'
				|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'wood_debris'
				|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'dirt_hard'
				|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'dirt_soil'
				|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'hay'
				|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'stone_debris'
				|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'stone_solid'
				|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'clay_tile'
				|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'gravel_large'
				|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'gravel_small'
				|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'sand'
				|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'water_shallow'
				|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'water_deep'
				|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'grass_short'
				|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'grass_long'
				|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'carpet'
				)
				{

					thePlayer.StopEffect('jump_ground_fx1');
					thePlayer.PlayEffect('jump_ground_fx1');
				}
				

				thePlayer.PlayEffectSingle('acs_fast_sprint_trail');
				thePlayer.StopEffect('acs_fast_sprint_trail');
			}

			movementAdjustor = thePlayer.GetMovingAgentComponent().GetMovementAdjustor();
			movementAdjustor.CancelByName('ACSMovAdj');
			movementAdjustor.CancelAll();

			ticket = movementAdjustor.CreateNewRequest( 'ACSMovAdj' );
			
			movementAdjustor.ShouldStartAt(ticket, thePlayer.GetWorldPosition());
			movementAdjustor.AdjustmentDuration( ticket, 0.125 );
			
			movementAdjustor.MaxLocationAdjustmentSpeed( ticket, 5000000 );
			movementAdjustor.MaxRotationAdjustmentSpeed( ticket, 5000000 );
			movementAdjustor.RotateTowards(ticket, displayTarget);
			movementAdjustor.SlideTowards( ticket, displayTarget , dist, dist);

			if (playerContactWithNpc)
			{
				movementAdjustor.MaxLocationAdjustmentDistance( ticket, 0 );
			}
		}
	}

	function action_interrupt()
	{
		if (
		GetWitcherPlayer().IsActionBlockedBy(EIAB_Movement, 'Mutation11') 
		&& GetWitcherPlayer().IsMutationActive( EPMT_Mutation11 ) 
		&& !GetWitcherPlayer().HasBuff( EET_Mutation11Debuff )
		)
		{
			return;
		}	

		if ( thePlayer.HasTag('ACS_HideWeaponOnDodge') 
		)
		{
			if (!thePlayer.HasTag('acs_aard_sword_equipped'))
			{
				ACS_Weapon_Respawn();
			}
			
			thePlayer.RemoveTag('ACS_HideWeaponOnDodge');

			thePlayer.RemoveTag('ACS_HideWeaponOnDodge_Claw_Effect');
		}

		if( thePlayer.IsAlive()) 
		{
			thePlayer.ACS_ClearAnimationSpeedMultipliers();

			thePlayer.RaiseEvent('ACS_TW1AnimsReset');

			if(ACSGetCEntity('ACS_Viper_Dagger_L'))
			{
				thePlayer.RaiseEvent('ACS_LHandAttack01');
			}

			if (thePlayer.HasTag('acs_igni_sword_equipped') 
			|| thePlayer.HasTag('acs_igni_secondary_sword_equipped') 
			)
			{
				thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( '', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(1.f, 1.f) );
			}
			else
			{
				RemoveTimer('ACS_ResetAnimation');

				movementAdjustor = thePlayer.GetMovingAgentComponent().GetMovementAdjustor();

				movementAdjustor.CancelAll();

				ticket = movementAdjustor.CreateNewRequest( 'ACS_Action_Interrupt_Adjust' );

				actor = (CActor)( thePlayer.GetTarget() );
					
				movementAdjustor.AdjustmentDuration( ticket, 0.25 );

				movementAdjustor.ShouldStartAt(ticket, thePlayer.GetWorldPosition());
				movementAdjustor.MaxRotationAdjustmentSpeed( ticket, 50000 );
				movementAdjustor.MaxLocationAdjustmentSpeed( ticket, 50000 );

				if( actor && ACS_AttitudeCheck ( actor ) && thePlayer.IsInCombat())
				{	
					if ( ACS_Settings_Main_Int('acs_target_settings','acs_target_mode', 0) == 0 || ACS_Settings_Main_Int('acs_target_settings','acs_target_mode', 0) == 1 )
					{
						if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTowards( ticket, actor );}  
					}
					else if ( ACS_Settings_Main_Int('acs_target_settings','acs_target_mode', 0) == 2 )
					{
						if (thePlayer.IsHardLockEnabled())
						{
							if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTowards( ticket, actor );}  
						}
					}
				}

				thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( '', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(1.f, 1.f) );
			}
		}
	}

	function action_interrupt_on_jump()
	{
		if (
		GetWitcherPlayer().IsActionBlockedBy(EIAB_Movement, 'Mutation11') 
		&& GetWitcherPlayer().IsMutationActive( EPMT_Mutation11 ) 
		&& !GetWitcherPlayer().HasBuff( EET_Mutation11Debuff )
		)
		{
			return;
		}

		if (thePlayer.IsAlive() 
		&& !thePlayer.IsInAir()
		)
		{
			if ( thePlayer.HasTag('ACS_HideWeaponOnDodge') 
			//&& !thePlayer.HasTag('ACS_Bruxa_Bite_Process')
			)
			{
				if (!thePlayer.HasTag('acs_aard_sword_equipped'))
				{
					ACS_Weapon_Respawn();
				}
				
				thePlayer.RemoveTag('ACS_HideWeaponOnDodge');

				thePlayer.RemoveTag('ACS_HideWeaponOnDodge_Claw_Effect');
			}
			
			movementAdjustor = thePlayer.GetMovingAgentComponent().GetMovementAdjustor();
			movementAdjustor.CancelAll();
			thePlayer.ACS_ClearAnimationSpeedMultipliers();
			thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( '', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(1.f, 1.f) );
		}
	}

	function action_interrupt_on_movement()
	{
		if (
		GetWitcherPlayer().IsActionBlockedBy(EIAB_Movement, 'Mutation11') 
		&& GetWitcherPlayer().IsMutationActive( EPMT_Mutation11 ) 
		&& !GetWitcherPlayer().HasBuff( EET_Mutation11Debuff )
		)
		{
			return;
		}

		if ( thePlayer.HasTag('ACS_HideWeaponOnDodge') 
		&& !thePlayer.HasTag('ACS_Bruxa_Bite_Process')
		)
		{
			if (!thePlayer.HasTag('acs_aard_sword_equipped'))
			{
				ACS_Weapon_Respawn();
			}
			
			thePlayer.RemoveTag('ACS_HideWeaponOnDodge');

			thePlayer.RemoveTag('ACS_HideWeaponOnDodge_Claw_Effect');
		}

		if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}

		RemoveTimer('ACS_ResetAnimation');

		movementAdjustor = thePlayer.GetMovingAgentComponent().GetMovementAdjustor();

		movementAdjustor.CancelAll();

		ticket = movementAdjustor.CreateNewRequest( 'ACS_Action_Interrupt_On_Movement_Adjust' );

		actor = (CActor)( thePlayer.GetTarget() );
			
		movementAdjustor.AdjustmentDuration( ticket, 0.25 );

		movementAdjustor.ShouldStartAt(ticket, thePlayer.GetWorldPosition());
		movementAdjustor.MaxRotationAdjustmentSpeed( ticket, 50000 );
		movementAdjustor.MaxLocationAdjustmentSpeed( ticket, 50000 );

		if( actor && ACS_AttitudeCheck ( actor ) && thePlayer.IsInCombat())
		{	
			if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTowards( ticket, actor );}  
		}

		if (thePlayer.IsAlive())
		{
			thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( '', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(1.f, 1.f) );
		}

		if( !thePlayer.HasTag('acs_axii_sword_equipped') && !thePlayer.IsGuarded() )
		{
			//if(thePlayer.IsInCombat()){if(thePlayer.GetCombatIdleStance() <= 0.f ){thePlayer.RaiseEvent('ACS_CombatTauntLeft');}else{thePlayer.RaiseEvent('ACS_CombatTauntRight');}}
		}

		thePlayer.RemoveTag('ACS_Special_Dodge');
	}

	public timer function ACS_Finisher_Unblock_Action(deltaTime : float , id : int)
	{
		var actors		    									: array<CActor>;

		thePlayer.BreakAttachment();

		//thePlayer.GetMovingAgentComponent().SetUseExtractedMotion( true );

		((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent()).SetAnimatedMovement( false );

		if (thePlayer.IsInCutsceneIntro()
		|| theGame.IsDialogOrCutscenePlaying() 
		|| theGame.GetPhotomodeEnabled() 
		|| theGame.IsFading()
		|| theGame.IsBlackscreen()
		)
		{
			thePlayer.BlockAllActions( 'Mutation11', false );
			thePlayer.BlockAllActions( 'ACS_Finisher_Action_Block', false );	

			thePlayer.SetImmortalityMode( AIM_None, AIC_Default, true ); 
			thePlayer.SetCanPlayHitAnim(true);
			thePlayer.RemoveBuffImmunity_AllNegative('ACS_Finisher_Immune_Negative'); 
			thePlayer.RemoveBuffImmunity_AllCritical('ACS_Finisher_Immune_Critical'); 

			if (!thePlayer.IsUsingHorse()&& !thePlayer.IsUsingVehicle()){thePlayer.EnableCharacterCollisions(true); }
		}
		else
		{
			weapon_blood_fx('red');

			RemoveTimer('ACS_Finisher_Unblock_Camera');
			AddTimer('ACS_Finisher_Unblock_Camera', 1 , false);
			
			(GetWitcherPlayer().GetMovingAgentComponent().GetMovementAdjustor()).CancelAll();

			MovementAdjust('wraith');

			movementAdjustor.AdjustmentDuration( ticket, 0.1 );

			movementAdjustor.SlideTo( ticket, TraceFloor(thePlayer.GetWorldPosition()) );
			

			thePlayer.BlockAllActions( 'Mutation11', false );
			thePlayer.BlockAllActions( 'ACS_Finisher_Action_Block', false );	

			thePlayer.SetImmortalityMode( AIM_None, AIC_Default, true ); 
			thePlayer.SetCanPlayHitAnim(true);
			thePlayer.RemoveBuffImmunity_AllNegative('ACS_Finisher_Immune_Negative'); 
			thePlayer.RemoveBuffImmunity_AllCritical('ACS_Finisher_Immune_Critical'); 

			if ( theGame.GetDifficultyLevel() == EDM_Hardcore
			&& !thePlayer.HasTag('ACS_Ghost_Stance_Active')
			&& FactsQuerySum("ACS_Bloodsmoke_Active") <= 0
			&& !grapple_target
			&& !thePlayer.HasTag('ACS_IsPerformingCounterWound')
			)
			{
				actors.Clear();

				actors = thePlayer.GetNPCsAndPlayersInRange( 30, 100, , FLAG_ExcludePlayer + FLAG_Attitude_Hostile + FLAG_OnlyAliveActors );

				if( actors.Size() == 0 )
				{
					thePlayer.GainStat( BCS_Vitality, (thePlayer.GetStatMax( BCS_Vitality ) - thePlayer.GetStat( BCS_Vitality )) * 0.0125 );

					ShowHealFloatingValue((thePlayer.GetStatMax( BCS_Vitality ) - thePlayer.GetStat( BCS_Vitality )) * 0.0125, true);

					thePlayer.GainStat( BCS_Focus, thePlayer.GetStatMax( BCS_Focus) * 0.04125 );
				}
				else if( actors.Size() >= 1 && actors.Size() < 2 )
				{
					thePlayer.GainStat( BCS_Vitality, (thePlayer.GetStatMax( BCS_Vitality ) - thePlayer.GetStat( BCS_Vitality ))  * 0.025 );

					ShowHealFloatingValue((thePlayer.GetStatMax( BCS_Vitality ) - thePlayer.GetStat( BCS_Vitality )) * 0.025, true);

					thePlayer.GainStat( BCS_Focus, thePlayer.GetStatMax( BCS_Focus) * 0.0825 );
				}
				else if( actors.Size() >= 2 && actors.Size() < 3 )
				{
					thePlayer.GainStat( BCS_Vitality, (thePlayer.GetStatMax( BCS_Vitality ) - thePlayer.GetStat( BCS_Vitality ))  * 0.05 );

					ShowHealFloatingValue((thePlayer.GetStatMax( BCS_Vitality ) - thePlayer.GetStat( BCS_Vitality )) * 0.05, true);

					thePlayer.GainStat( BCS_Focus, thePlayer.GetStatMax( BCS_Focus) * 0.165 );
				}
				else if( actors.Size() >= 3 )
				{
					thePlayer.GainStat( BCS_Vitality, (thePlayer.GetStatMax( BCS_Vitality ) - thePlayer.GetStat( BCS_Vitality )) * 0.1 );

					ShowHealFloatingValue((thePlayer.GetStatMax( BCS_Vitality ) - thePlayer.GetStat( BCS_Vitality )) * 0.1, true);

					thePlayer.GainStat( BCS_Focus, thePlayer.GetStatMax( BCS_Focus ) * 0.33 );
				}
			}

			if (thePlayer.acs_grey_health_current > 0)
			{
				GetWitcherPlayer().GainStat( BCS_Vitality, thePlayer.acs_grey_health_current ); 

				ShowHealFloatingValue( thePlayer.acs_grey_health_current, true);

				thePlayer.ACS_ManageGreyHealth(false, thePlayer.acs_grey_health_current);
			}

			grapple_target = NULL;

			//ResetInteractionPriority();

			if (ACSGetCEntity('ACS_Bruxa_Bite_Finisher_Vampire_Head'))
			{
				PlayerPlayAnimation('utility_taunt_01_ACS');

				ACSGetCEntity('ACS_Bruxa_Bite_Finisher_Vampire_Head').BreakAttachment(); 
				ACSGetCEntity('ACS_Bruxa_Bite_Finisher_Vampire_Head').Teleport( GetWitcherPlayer().GetWorldPosition() + Vector( 0, 0, -200 ) );
				ACSGetCEntity('ACS_Bruxa_Bite_Finisher_Vampire_Head').DestroyAfter(0.00125);
				ACSGetCEntity('ACS_Bruxa_Bite_Finisher_Vampire_Head').RemoveTag('ACS_Bruxa_Bite_Finisher_Vampire_Head');
			}
			else
			{
				if ((thePlayer.IsLastEnemyKilled()
				|| thePlayer.HasTag('ACS_IsPerformingCounterWound'))
				&& !thePlayer.HasTag('ACS_Is_Sneaking')
				&& !ACS_IS_SNEAKING
				&& thePlayer.IsDeadlySwordHeld()
				)
				{
					if(thePlayer.GetCombatIdleStance() <= 0.f )
					{
						PlayerPlayAnimation('man_geralt_sword_alert_idle_right');
					}
					else
					{
						PlayerPlayAnimation('man_geralt_sword_alert_idle_left');
					}

					if (silver_fast_stance
					)
					{
						thePlayer.RaiseEvent('ACS_CombatExtraTW1SilverFastStart');
					}
					else if ( 
					silver_group_stance 
					)
					{
						thePlayer.RaiseEvent('ACS_CombatExtraTW1SilverGroupStart');
					}
					else if ( 
					silver_strong_stance 
					)
					{
						thePlayer.RaiseEvent('ACS_CombatExtraTW1SilverStrongStart');
					}
					else if (steel_fast_stance
					)
					{
						thePlayer.RaiseEvent('ACS_CombatExtraTW1SteelFastStart');
					}
					else if (steel_group_stance
					)
					{
						thePlayer.RaiseEvent('ACS_CombatExtraTW1SteelGroupStart');
					}
					else if ( 
					steel_strong_stance 
					)
					{
						thePlayer.RaiseEvent('ACS_CombatExtraTW1SteelStrongStart');
					}
					else
					{
						thePlayer.RaiseEvent('ACS_CombatExtraTW1SilverStrongStart');
					}
				}
			}
		}

		if (thePlayer.HasTag('ACS_Is_Sneaking')
		&& ACS_IS_SNEAKING)
		{
			if (silver_group_stance
			|| silver_strong_stance
			|| silver_fast_stance
			|| steel_group_stance
			|| steel_strong_stance
			|| steel_fast_stance
			|| ACS_Vampire_Claws_Access()
			)
			{

			}
			else
			{
				if (RandF() < 0.5)
				{
					thePlayer.RaiseEvent('ACS_SneakAnim');
				}
				else
				{
					thePlayer.RaiseEvent('ACS_SneakAnimAlt');
				}
			}
		}

		thePlayer.DestroyEffect('blood_start');
		thePlayer.DestroyEffect('blood');

		theInput.IgnoreGameInput( 'GI_AxisLeftX', false );
		theInput.IgnoreGameInput( 'GI_AxisLeftY', false );

		thePlayer.RemoveTag('ACS_IsPerformingCounterWound');
		
		thePlayer.RemoveTag('ACS_IsPerformingFinisher');

		if (ACSGetCEntity('acs_finisher_dagger'))
		{
			thePlayer.RaiseEvent('ACS_SwordTaunt10');
		}

		SetAdrenalineDrain(false);
		RemoveTimer('AdrenalineDrainResume');
		AddTimer('AdrenalineDrainResume', ACS_Settings_Main_Float('acs_combat_main_settings','acs_adrenaline_drain_delay', 3) , false );

		if (counter_wound_target.IsAlive()
		&& (
		((CMovingPhysicalAgentComponent)(counter_wound_target.GetMovingAgentComponent())).GetCapsuleHeight() >= 2
		|| counter_wound_target.GetRadius() >= 0.7
		|| counter_wound_target.HasAbility('Boss')
		|| counter_wound_target.HasTag('IsBoss')
		|| counter_wound_target.HasTag('ACS_Big_Boi')
		|| sneaking_initiated_in_combat
		)
		)
		{
			counter_wound_target = NULL;

			RemoveSneaking(true);
		}
		else
		{
			counter_wound_target = NULL;
		}
	}

	public timer function ACS_Finisher_Unblock_Camera(deltaTime : float , id : int)
	{
		if (ACSGetCEntity('acs_finisher_dagger'))
		{
			ACSGetCEntity('acs_finisher_dagger').BreakAttachment();

			ACSGetCEntity('acs_finisher_dagger').CreateAttachment( GetWitcherPlayer(), 'r_weapon', Vector(0,0,0), EulerAngles(180,0,-0.03125f) );

			thePlayer.SoundEvent("scene_geralt_unsheat_dagger");

			thePlayer.SoundEvent("scene_geralt_catch_dagger");
		}

		(GetWitcherPlayer().GetMovingAgentComponent().GetMovementAdjustor()).CancelAll();
		
		if (!thePlayer.IsUsingHorse()&& !thePlayer.IsUsingVehicle()){thePlayer.EnableCharacterCollisions(true); }

		if (thePlayer.IsAnyWeaponHeld()
		&& !thePlayer.IsWeaponHeld('fist')
		&& AnimProgressCheck()
		&& !thePlayer.HasTag('acs_aard_sword_equipped')
		)
		{
			weapon_blood_fx('red');

			if (thePlayer.IsInCombat()
			&& !thePlayer.IsLastEnemyKilled()
			)
			{
				RemoveTimer('CombatTauntDelay');RemoveTimer('SwordTauntRunningSwitchSecondary'); 
				AddTimer('SwordTauntRunningSwitchSecondary', 0.1 , false); 
			}
		}
	}

	public timer function ACS_Combat_Dismember_Unblock_Action(deltaTime : float , id : int)
	{
		//ACS_ExplorationDelayHack(false, 3);

		thePlayer.RemoveTag('ACS_IsPerformingCombatDismember');

		thePlayer.BlockAllActions( 'Mutation11', false );
		thePlayer.BlockAllActions( 'ACS_Combat_Dismember_Action_Block', false );	

		thePlayer.SetImmortalityMode( AIM_None, AIC_Default, true ); 
		thePlayer.SetCanPlayHitAnim(true);
		thePlayer.RemoveBuffImmunity_AllNegative('ACS_Finisher_Immune_Negative'); 
		thePlayer.RemoveBuffImmunity_AllCritical('ACS_Finisher_Immune_Critical'); 

		if (!thePlayer.IsUsingHorse()&& !thePlayer.IsUsingVehicle()){thePlayer.EnableCharacterCollisions(true); }
	}

	function ACS_PerformFinisherBruxaBite(combatTarget : CActor)
	{
		var finisher_anim_names												: array< name >;
		var targetPos, playerPos											: Vector;
		var posZDiff														: Float;
		var pos																: Vector;
		var rot																: EulerAngles;
		var ent																: CEntity;

		if(  thePlayer.IsDoingSpecialAttack( false )
		|| thePlayer.IsUsingHorse()
		|| thePlayer.IsUsingVehicle()
		|| thePlayer.HasTag('ACS_IsPerformingFinisher')
		|| thePlayer.HasTag('ACS_IsPerformingCombatDismember')
		|| !thePlayer.WasVisibleInScaledFrame( ((CNewNPC)combatTarget), 1.f, 1.f )
		)
		{
			return;
		}

		ACS_ExplorationDelayHack(false, 3);

		if (((CMovingPhysicalAgentComponent)(((CNewNPC)combatTarget).GetMovingAgentComponent())).GetCapsuleHeight() >= 2
		|| ((CNewNPC)combatTarget).GetRadius() >= 0.7
		|| ((CNewNPC)combatTarget).HasAbility('Boss')
		|| ((CNewNPC)combatTarget).HasTag('IsBoss')
		|| ((CNewNPC)combatTarget).HasTag('ACS_Big_Boi')
		)
		{
			finisherDist = 4;
		}
		else
		{
			finisherDist = 2;
		}

		if (ACS_Settings_Main_Float('acs_visual_main_settings','acs_player_scale', 1) > 1)
		{
			finisherDist += ACS_Settings_Main_Float('acs_visual_main_settings','acs_player_scale', 1) * 0.25;
		}

		targetPos = combatTarget.GetWorldPosition();

		playerPos = thePlayer.GetWorldPosition();

		posZDiff = targetPos.Z - playerPos.Z;

		if( 
		combatTarget 
		&& thePlayer.IsInCombat() 
		&& !thePlayer.HasTag('ACS_IsPerformingFinisher')
		&& !thePlayer.HasTag('ACS_IsPerformingCombatDismember')
		&& CanPerformFinisher()
		)
		{
			last_finisher_time = theGame.GetEngineTimeAsSeconds();

			if (VecDistanceSquared2D( thePlayer.GetWorldPosition(), combatTarget.GetNearestPointInBothPersonalSpaces( thePlayer.GetWorldPosition() ) ) < finisherDist * finisherDist)
			{
				if ( thePlayer.IsAnyWeaponHeld() )
				{
					action_interrupt();

					thePlayer.RemoveTag('ACS_Manual_Combat_Control');

					if (thePlayer.IsWeaponHeld('fist') )
					{
						thePlayer.DestroyEffect( 'bruxa_dash_trails' );
						thePlayer.PlayEffectSingle( 'bruxa_dash_trails' );
						thePlayer.StopEffect( 'bruxa_dash_trails' );

						thePlayer.DestroyEffect('shadowdash_shockwave');
						thePlayer.PlayEffectSingle('shadowdash_shockwave');
						thePlayer.StopEffect('shadowdash_shockwave');

						thePlayer.DestroyEffect('shadowdash_short');
						thePlayer.PlayEffectSingle('shadowdash_short');
						thePlayer.StopEffect('shadowdash_short');

						finisher_anim_names.Clear();

						finisher_anim_names.PushBack('bruxa_attack_bite_front_lp_bruxa_ACS');
						finisher_anim_names.PushBack('bruxa_attack_bite_front_rp_bruxa_ACS');
						finisher_anim_names.PushBack('bruxa_attack_bite_back_lp_bruxa_ACS');
						finisher_anim_names.PushBack('bruxa_attack_bite_back_rp_bruxa_ACS');

						if (combatTarget.IsHuman())
						{
							ACS_SetupSyncAnimInternalHumanBruxaBite(finisher_anim_names[RandRange(finisher_anim_names.Size())], thePlayer, combatTarget );

							return;
						}
						else
						{
							ACS_SetupSyncAnimInternalMonsterBruxaBite(finisher_anim_names[RandRange(finisher_anim_names.Size())], thePlayer, combatTarget );

							return;
						}
					}
				}
			}
		}
	}

	function FistFinisherSetup(combatTarget : CActor)
	{
		var finisher_anim_names												: array< name >;

		finisher_anim_names.Clear();

		if (combatTarget.IsHuman() 
		&& combatTarget.IsMan()
		&& combatTarget.UsesVitality()
		&& !combatTarget.UsesEssence()
		&& !combatTarget.HasTag( 'ethereal' )
		&& !combatTarget.HasAbility( 'Boss' )
		&& !combatTarget.HasTag( 'IsBoss' )
		&& !combatTarget.HasTag( 'ACS_Berserkers_Human' )
		&& !combatTarget.HasTag( 'ACS_Shades_Hunter' )
		&& !combatTarget.HasTag( 'ACS_Shades_Crusader' )
		&& !combatTarget.IsUsingHorse()
		&& !combatTarget.IsUsingVehicle()
		&& !combatTarget.HasTag('ACS_In_Rage')
		&& !combatTarget.HasTag('ACS_Currently_In_Grapple_Anim')
		&& !combatTarget.HasTag('ACS_Currently_In_Beh_Switch_Anim')
		&& !combatTarget.IsRagdolled()
		&& !combatTarget.HasTag('ACS_Pre_Rage')
		&& !((CNewNPC)combatTarget).IsInFinisherAnim()
		&& ACS_Rage_Process == false
		&& combatTarget.GetBehaviorGraphInstanceName() != 'Shield'
		&& !combatTarget.HasTag('mq1060_witcher')
		&& CanPlayFinisher(false)
		)
		{
			thePlayer.RaiseEvent('ACS_KickAttackReset');

			thePlayer.RaiseEvent('ACS_TW1AnimsReset');

			if (combatTarget.HasTag('ACS_Final_Fear_Stack'))
			{
				if (combatTarget.HasTag('ACS_Scared_On_Ground'))
				{
					finisher_anim_names.PushBack('man_trample');
				}
				else
				{
					if(GetWitcherPlayer().GetEquippedSign() == ST_Aard )
					{
						finisher_anim_names.PushBack('man_aard_finisher');
					}
					else if(GetWitcherPlayer().GetEquippedSign() == ST_Igni )
					{
						finisher_anim_names.PushBack('man_igni_finisher');
					}
					else if(GetWitcherPlayer().GetEquippedSign() == ST_Quen )
					{
						finisher_anim_names.PushBack('man_quen_finisher');
					}
					else if(GetWitcherPlayer().GetEquippedSign() == ST_Yrden )
					{
						finisher_anim_names.PushBack('man_yrden_finisher');
					}
					else if(GetWitcherPlayer().GetEquippedSign() == ST_Axii )
					{
						finisher_anim_names.PushBack('man_axii_finisher');
					}
					else
					{
						finisher_anim_names.PushBack('man_igni_finisher');
						finisher_anim_names.PushBack('man_aard_finisher');
						finisher_anim_names.PushBack('man_quen_finisher');
						finisher_anim_names.PushBack('man_yrden_finisher');
						finisher_anim_names.PushBack('man_axii_finisher');
					}
				}

				combatTarget.RemoveTag('ACS_Final_Fear_Stack');
			}
			else
			{
				if (RandF() < 0.75)
				{
					finisher_anim_names.PushBack('man_fistfight_finisher');
				}
				else
				{
					finisher_anim_names.PushBack('man_finisher_head');
					finisher_anim_names.PushBack('man_fistfight_finisher');
				}
			}

			ACS_SetupSyncAnimInternalHuman(finisher_anim_names[RandRange(finisher_anim_names.Size())], thePlayer, combatTarget );
		}
	}

	function WeaponFinisherSetup(combatTarget : CActor)
	{
		var finisher_anim_names												: array< name >;
		var targetPos, playerPos											: Vector;
		var posZDiff														: Float;

		thePlayer.RaiseEvent('ACS_KickAttackReset');

		thePlayer.RaiseEvent('ACS_TW1AnimsReset');

		targetPos = combatTarget.GetWorldPosition();

		playerPos = thePlayer.GetWorldPosition();

		posZDiff = AbsF(targetPos.Z - playerPos.Z);

		finisher_anim_names.Clear();

		vACS_Geralt_Phantom_Attack = new cACS_Geralt_Phantom_Attack in this;

		vACS_Geralt_Phantom_Attack.ACS_Geralt_Phantom_Finisher_Marked_Engage();

		finisher_anim_names.Clear();

		if (combatTarget.HasTag('ACS_Final_Fear_Stack') 
		&& combatTarget.IsHuman()
		)
		{
			if (combatTarget.HasTag('ACS_Scared_On_Ground')
			)
			{
				finisher_anim_names.PushBack('tw2_npc_sword1h_40_ACS');
				finisher_anim_names.PushBack('man_trample');

				ACS_SetupSyncAnimInternalHuman(finisher_anim_names[RandRange(finisher_anim_names.Size())], thePlayer, combatTarget );
			}

			combatTarget.RemoveTag('ACS_Final_Fear_Stack');
			
			return;
		}
		
		if (combatTarget.IsHuman()
		&& combatTarget.IsMan()
		&& combatTarget.UsesVitality()
		&& !combatTarget.UsesEssence()
		&& !combatTarget.HasTag( 'ethereal' )
		&& !combatTarget.HasAbility( 'Boss' )
		&& !combatTarget.HasTag( 'IsBoss' )
		&& !combatTarget.HasTag( 'ACS_Berserkers_Human' )
		&& !combatTarget.HasTag( 'ACS_Shades_Hunter' )
		&& !combatTarget.HasTag( 'ACS_Shades_Crusader' )
		&& !combatTarget.IsUsingHorse()
		&& !combatTarget.IsUsingVehicle()
		&& !combatTarget.HasTag('ACS_In_Rage')
		&& !combatTarget.HasTag('ACS_Currently_In_Grapple_Anim')
		&& !combatTarget.HasTag('ACS_Currently_In_Beh_Switch_Anim')
		&& !combatTarget.IsRagdolled()
		&& !combatTarget.HasTag('ACS_Pre_Rage')
		&& !((CNewNPC)combatTarget).IsInFinisherAnim()
		&& ACS_Rage_Process == false
		&& !combatTarget.HasTag('mq1060_witcher')
		&& CanPlayFinisher(false)
		)
		{
			if (combatTarget.HasTag('ACS_man_finisher_dlc_arm_lp_combat_dismember')
			|| combatTarget.HasTag('ACS_man_finisher_dlc_arm_rp_combat_dismember')
			|| combatTarget.HasTag('ACS_man_finisher_dlc_legs_lp_combat_dismember')
			|| combatTarget.HasTag('ACS_man_finisher_dlc_legs_rp_combat_dismember')
			)
			{
				if (!thePlayer.HasTag('ACS_Ghost_Stance_Active')
				)
				{
					if ((theInput.GetActionValue('Jump') > 0.5
					|| theInput.GetActionValue('Dodge') > 0.5
					|| theInput.GetActionValue('CbtRoll') > 0.5
					|| ((combatTarget.HasTag('ACS_Sign_Combo_Igni_Ready') || combatTarget.HasTag('ACS_Sign_Combo_Aard_Ready')) && !Attack_Directional_Press_Check())
					)
					&& ACS_Settings_Main_Bool('acs_custom_finishers_settings','acs_custom_finishers_sign_finishers_enabled', true)
					)
					{
						if (combatTarget.HasTag('ACS_Sign_Combo_Aard_Ready') || combatTarget.HasTag('ACS_Sign_Combo_Igni_Ready'))
						{
							if(combatTarget.HasTag('ACS_Sign_Combo_Aard_Ready'))
							{
								finisher_anim_names.PushBack('man_aard_finisher');
							}
							else if(combatTarget.HasTag('ACS_Sign_Combo_Igni_Ready'))
							{
								finisher_anim_names.PushBack('man_igni_finisher');
							}
						}
						else
						{
							if(GetWitcherPlayer().GetEquippedSign() == ST_Aard)
							{
								finisher_anim_names.PushBack('man_aard_finisher');
							}
							else if(GetWitcherPlayer().GetEquippedSign() == ST_Igni)
							{
								finisher_anim_names.PushBack('man_igni_finisher');
							}
							else if(GetWitcherPlayer().GetEquippedSign() == ST_Quen )
							{
								finisher_anim_names.PushBack('man_quen_finisher');
							}
							else if(GetWitcherPlayer().GetEquippedSign() == ST_Yrden )
							{
								finisher_anim_names.PushBack('man_yrden_finisher');
							}
							else if(GetWitcherPlayer().GetEquippedSign() == ST_Axii )
							{
								finisher_anim_names.PushBack('man_axii_finisher');
							}
							else
							{
								finisher_anim_names.PushBack('man_igni_finisher');
								finisher_anim_names.PushBack('man_aard_finisher');
								finisher_anim_names.PushBack('man_quen_finisher');
								finisher_anim_names.PushBack('man_yrden_finisher');
								finisher_anim_names.PushBack('man_axii_finisher');
							}
						}
					}
					else
					{
						//finisher_anim_names.PushBack('man_finisher_04_lp');
						finisher_anim_names.PushBack('man_finisher_05_rp');
						finisher_anim_names.PushBack('man_finisher_06_lp');
						finisher_anim_names.PushBack('man_finisher_03_rp');
					}
				}
				else
				{
					//finisher_anim_names.PushBack('man_finisher_04_lp');
					finisher_anim_names.PushBack('man_finisher_05_rp');
					finisher_anim_names.PushBack('man_finisher_06_lp');
					finisher_anim_names.PushBack('man_finisher_03_rp');
				}

				ACS_SetupSyncAnimInternalHuman(finisher_anim_names[RandRange(finisher_anim_names.Size())], thePlayer, combatTarget );

				return;
			}

			if (ACS_Settings_Main_Bool('acs_custom_finishers_settings','acs_custom_finishers_enabled', true)
			&& !thePlayer.HasTag('ACS_Ghost_Stance_Active')
			)
			{
				ACS_Tutorial_Display_Check('ACS_Finisher_Tutorial_Shown');

				if ((theInput.GetActionValue('Jump') > 0.5
				|| theInput.GetActionValue('Dodge') > 0.5
				|| theInput.GetActionValue('CbtRoll') > 0.5
				|| ((combatTarget.HasTag('ACS_Sign_Combo_Igni_Ready') || combatTarget.HasTag('ACS_Sign_Combo_Aard_Ready')) && !Attack_Directional_Press_Check())
				)
				&& ACS_Settings_Main_Bool('acs_custom_finishers_settings','acs_custom_finishers_sign_finishers_enabled', true)
				)
				{
					if (combatTarget.HasTag('ACS_Sign_Combo_Aard_Ready') || combatTarget.HasTag('ACS_Sign_Combo_Igni_Ready'))
					{
						if(combatTarget.HasTag('ACS_Sign_Combo_Aard_Ready'))
						{
							finisher_anim_names.PushBack('man_aard_finisher');
						}
						else if(combatTarget.HasTag('ACS_Sign_Combo_Igni_Ready'))
						{
							finisher_anim_names.PushBack('man_igni_finisher');
						}
					}
					else
					{
						if(GetWitcherPlayer().GetEquippedSign() == ST_Aard)
						{
							finisher_anim_names.PushBack('man_aard_finisher');
						}
						else if(GetWitcherPlayer().GetEquippedSign() == ST_Igni)
						{
							finisher_anim_names.PushBack('man_igni_finisher');
						}
						else if(GetWitcherPlayer().GetEquippedSign() == ST_Quen )
						{
							finisher_anim_names.PushBack('man_quen_finisher');
						}
						else if(GetWitcherPlayer().GetEquippedSign() == ST_Yrden )
						{
							finisher_anim_names.PushBack('man_yrden_finisher');
						}
						else if(GetWitcherPlayer().GetEquippedSign() == ST_Axii )
						{
							finisher_anim_names.PushBack('man_axii_finisher');
						}
						else
						{
							finisher_anim_names.PushBack('man_igni_finisher');
							finisher_anim_names.PushBack('man_aard_finisher');
							finisher_anim_names.PushBack('man_quen_finisher');
							finisher_anim_names.PushBack('man_yrden_finisher');
							finisher_anim_names.PushBack('man_axii_finisher');
						}
					}
				}
				else
				{
					if (CustomFinishersBindTrigger(ACS_GetFinishersBind('torso')))
					{
						finisher_anim_names.PushBack('man_finisher_dlc_torso_rp');
						finisher_anim_names.PushBack('man_finisher_dlc_torso_lp');

						ACS_Human_Death_Explode(combatTarget, combatTarget.GetWorldPosition(), 1);
					}

					if (CustomFinishersBindTrigger(ACS_GetFinishersBind('stab')))
					{
						if (posZDiff <= 0.25
						)
						{
							//finisher_anim_names.PushBack('man_finisher_04_lp');
							finisher_anim_names.PushBack('man_finisher_05_rp');

							finisher_anim_names.PushBack('man_finisher_06_lp');
							finisher_anim_names.PushBack('man_finisher_03_rp');
						}
						else
						{
							finisher_anim_names.PushBack('man_finisher_dlc_torso_rp');
							finisher_anim_names.PushBack('man_finisher_dlc_torso_lp');
						}
					}

					if (CustomFinishersBindTrigger(ACS_GetFinishersBind('neck')))
					{
						finisher_anim_names.PushBack('man_finisher_dlc_neck_rp');
						finisher_anim_names.PushBack('man_finisher_08_lp');
					}

					if (CustomFinishersBindTrigger(ACS_GetFinishersBind('head_left')))
					{
						finisher_anim_names.PushBack('man_finisher_02_lp');
						finisher_anim_names.PushBack('man_finisher_07_lp');
					}

					if (CustomFinishersBindTrigger(ACS_GetFinishersBind('head_right')))
					{
						finisher_anim_names.PushBack('man_finisher_01_rp');
						finisher_anim_names.PushBack('man_finisher_dlc_head_rp');
					}

					if (CustomFinishersBindTrigger(ACS_GetFinishersBind('arm_left')))
					{
						finisher_anim_names.PushBack('man_finisher_dlc_arm_lp');
					}

					if (CustomFinishersBindTrigger(ACS_GetFinishersBind('arm_right')))
					{
						finisher_anim_names.PushBack('man_finisher_dlc_arm_rp');
					}

					if (CustomFinishersBindTrigger(ACS_GetFinishersBind('leg_left')))
					{
						finisher_anim_names.PushBack('man_finisher_dlc_legs_lp');
					}

					if (CustomFinishersBindTrigger(ACS_GetFinishersBind('leg_right')))
					{
						finisher_anim_names.PushBack('man_finisher_dlc_legs_rp');
					}
				}
			}
			else
			{
				if (!thePlayer.HasTag('ACS_Ghost_Stance_Active'))
				{
					if (posZDiff <= 0.25
					)
					{
						//finisher_anim_names.PushBack('man_finisher_04_lp');
						finisher_anim_names.PushBack('man_finisher_05_rp');
						finisher_anim_names.PushBack('man_finisher_06_lp');
						finisher_anim_names.PushBack('man_finisher_03_rp');
					}

					if ((theInput.GetActionValue('Jump') > 0.5
					|| theInput.GetActionValue('Dodge') > 0.5
					|| theInput.GetActionValue('CbtRoll') > 0.5
					|| ((combatTarget.HasTag('ACS_Sign_Combo_Igni_Ready') || combatTarget.HasTag('ACS_Sign_Combo_Aard_Ready')) && !Attack_Directional_Press_Check())
					)
					&& ACS_Settings_Main_Bool('acs_custom_finishers_settings','acs_custom_finishers_sign_finishers_enabled', true)
					)
					{
						if (combatTarget.HasTag('ACS_Sign_Combo_Aard_Ready') || combatTarget.HasTag('ACS_Sign_Combo_Igni_Ready'))
						{
							if(combatTarget.HasTag('ACS_Sign_Combo_Aard_Ready'))
							{
								finisher_anim_names.PushBack('man_aard_finisher');
							}
							else if(combatTarget.HasTag('ACS_Sign_Combo_Igni_Ready'))
							{
								finisher_anim_names.PushBack('man_igni_finisher');
							}
						}
						else
						{
							if(GetWitcherPlayer().GetEquippedSign() == ST_Aard)
							{
								finisher_anim_names.PushBack('man_aard_finisher');
							}
							else if(GetWitcherPlayer().GetEquippedSign() == ST_Igni)
							{
								finisher_anim_names.PushBack('man_igni_finisher');
							}
							else if(GetWitcherPlayer().GetEquippedSign() == ST_Quen )
							{
								finisher_anim_names.PushBack('man_quen_finisher');
							}
							else if(GetWitcherPlayer().GetEquippedSign() == ST_Yrden )
							{
								finisher_anim_names.PushBack('man_yrden_finisher');
							}
							else if(GetWitcherPlayer().GetEquippedSign() == ST_Axii )
							{
								finisher_anim_names.PushBack('man_axii_finisher');
							}
							else
							{
								finisher_anim_names.PushBack('man_igni_finisher');
								finisher_anim_names.PushBack('man_aard_finisher');
								finisher_anim_names.PushBack('man_quen_finisher');
								finisher_anim_names.PushBack('man_yrden_finisher');
								finisher_anim_names.PushBack('man_axii_finisher');
							}
						}
					}
				}

				finisher_anim_names.PushBack('man_finisher_02_lp');
				finisher_anim_names.PushBack('man_finisher_07_lp');
				finisher_anim_names.PushBack('man_finisher_08_lp');
				finisher_anim_names.PushBack('man_finisher_dlc_arm_lp');
				finisher_anim_names.PushBack('man_finisher_dlc_legs_lp');
				finisher_anim_names.PushBack('man_finisher_dlc_torso_lp');
				finisher_anim_names.PushBack('man_finisher_dlc_arm_rp');
				finisher_anim_names.PushBack('man_finisher_dlc_legs_rp');
				finisher_anim_names.PushBack('man_finisher_dlc_torso_rp');
				finisher_anim_names.PushBack('man_finisher_01_rp');
				finisher_anim_names.PushBack('man_finisher_dlc_head_rp');
				finisher_anim_names.PushBack('man_finisher_dlc_neck_rp');
			}

			ACS_SetupSyncAnimInternalHuman(finisher_anim_names[RandRange(finisher_anim_names.Size())], thePlayer, combatTarget );

			return;
		}
		
		if (
		combatTarget.HasAbility('mon_rotfiend')
		|| combatTarget.HasAbility('mon_gravier')
		)
		{
			return;
		}
		
		if (CanPlayFinisher(true))
		{
			if (!thePlayer.HasTag('ACS_Ghost_Stance_Active'))
			{
				if (combatTarget.HasAbility('mon_wraith_base')
				|| combatTarget.HasAbility('mon_noonwraith_base')
				|| combatTarget.HasAbility('mon_nightwraith_banshee')
				|| combatTarget.HasAbility('mon_EP2_wraiths')
				|| combatTarget.HasAbility('mon_nightwraith_iris')
				|| combatTarget.HasAbility('q604_shades')
				|| combatTarget.HasAbility('mon_wraiths_ep1')
				|| combatTarget.HasAbility('mon_djinn')
				)
				{
					finisher_anim_names.PushBack('monster_yrden_finisher');
				}
				else
				{
					if ((theInput.GetActionValue('Jump') > 0.5
					|| theInput.GetActionValue('Dodge') > 0.5
					|| theInput.GetActionValue('CbtRoll') > 0.5
					|| ((combatTarget.HasTag('ACS_Sign_Combo_Igni_Ready') || combatTarget.HasTag('ACS_Sign_Combo_Aard_Ready')) && !Attack_Directional_Press_Check())
					)
					&& ACS_Settings_Main_Bool('acs_custom_finishers_settings','acs_custom_finishers_sign_finishers_enabled', true)
					)
					{

						if (combatTarget.HasTag('ACS_Sign_Combo_Aard_Ready') || combatTarget.HasTag('ACS_Sign_Combo_Igni_Ready'))
						{
							if(combatTarget.HasTag('ACS_Sign_Combo_Aard_Ready'))
							{
								finisher_anim_names.PushBack('monster_aard_finisher');
							}
							else if(combatTarget.HasTag('ACS_Sign_Combo_Igni_Ready'))
							{
								finisher_anim_names.PushBack('monster_igni_finisher');
							}
						}
						else
						{
							if(GetWitcherPlayer().GetEquippedSign() == ST_Aard)
							{
								finisher_anim_names.PushBack('monster_aard_finisher');
							}
							else if(GetWitcherPlayer().GetEquippedSign() == ST_Igni)
							{
								finisher_anim_names.PushBack('monster_igni_finisher');
							}
							else if(GetWitcherPlayer().GetEquippedSign() == ST_Quen )
							{
								finisher_anim_names.PushBack('monster_quen_finisher');
							}
							else if(GetWitcherPlayer().GetEquippedSign() == ST_Yrden )
							{
								finisher_anim_names.PushBack('monster_yrden_finisher');
							}
							else if(GetWitcherPlayer().GetEquippedSign() == ST_Axii )
							{
								finisher_anim_names.PushBack('monster_axii_finisher');
							}
							else
							{
								finisher_anim_names.PushBack('monster_yrden_finisher');
								finisher_anim_names.PushBack('monster_aard_finisher');
								finisher_anim_names.PushBack('monster_igni_finisher');
								finisher_anim_names.PushBack('monster_quen_finisher');
								finisher_anim_names.PushBack('monster_axii_finisher');
							}
						}
					}
					else
					{
						finisher_anim_names.PushBack('monster_slice_finisher');

						dismembermentComp = (CDismembermentComponent)(combatTarget.GetComponentByClassName( 'CDismembermentComponent' ));

						if(dismembermentComp)
						{
							dismembermentComp.GetWoundsNames( wounds );

							//for( i=0; i < wounds.Size(); i+=1 )

							for( i=wounds.Size()-1; i>=0; i-=1 )
							{
								if( !StrContains( wounds[ i ], "torso" ) 
								//|| !StrContains( wounds[ i ], "head" ) 
								)
								{
									wounds.EraseFast( i );
								}
							}

							if ( wounds.Size() > 0 )
							{
								usedWound = wounds[ RandRange( wounds.Size() ) ];
							}

							combatTarget.SoundEvent("bone_break_bb_acs");

							combatTarget.SoundEvent("breach_bb_acs");

							combatTarget.SetDismembermentInfo( usedWound, combatTarget.GetWorldPosition() - combatTarget.GetWorldPosition(), false, 0 );
						}

						combatTarget.AddTimer( 'ACS_DelayedDismemberTimer', 0.5f, false );
					}
				}
			}
			else
			{
				finisher_anim_names.PushBack('monster_slice_finisher');

				dismembermentComp = (CDismembermentComponent)(combatTarget.GetComponentByClassName( 'CDismembermentComponent' ));

				if(dismembermentComp)
				{
					dismembermentComp.GetWoundsNames( wounds );

					//for( i=0; i < wounds.Size(); i+=1 )

					for( i=wounds.Size()-1; i>=0; i-=1 )
					{
						if( !StrContains( wounds[ i ], "torso" ) 
						//|| !StrContains( wounds[ i ], "head" ) 
						)
						{
							wounds.EraseFast( i );
						}
					}

					if ( wounds.Size() > 0 )
					{
						usedWound = wounds[ RandRange( wounds.Size() ) ];
					}

					combatTarget.SoundEvent("bone_break_bb_acs");

					combatTarget.SoundEvent("breach_bb_acs");

					combatTarget.SetDismembermentInfo( usedWound, combatTarget.GetWorldPosition() - combatTarget.GetWorldPosition(), false, 0 );
				}

				combatTarget.AddTimer( 'ACS_DelayedDismemberTimer', 0.5f, false );
			}
			
			ACS_SetupSyncAnimInternalMonster(finisher_anim_names[RandRange(finisher_anim_names.Size())], thePlayer, combatTarget );
		}
	}

	function CanPlayFinisher(is_monster : bool) : bool
	{
		if (is_monster)
		{
			if (ACS_Settings_Main_Float('acs_custom_finishers_settings','acs_custom_finisher_monster_chance', 1) == 0 )
			{
				return false;
			}

			if (thePlayer.IsLastEnemyKilled() || ACS_LastEnemyInCombat())
			{
				action_interrupt();

				return true;
			}

			if(RandF() < ACS_Settings_Main_Float('acs_custom_finishers_settings','acs_custom_finisher_monster_chance', 1))
			{
				action_interrupt();

				return true;
			}
		}
		else
		{
			if (ACS_Settings_Main_Float('acs_custom_finishers_settings','acs_custom_finisher_human_chance', 1) == 0 )
			{
				return false;
			}

			if (thePlayer.IsLastEnemyKilled() || ACS_LastEnemyInCombat())
			{
				action_interrupt();

				return true;
			}

			if(RandF() < ACS_Settings_Main_Float('acs_custom_finishers_settings','acs_custom_finisher_human_chance', 1))
			{
				action_interrupt();

				return true;
			}
		}

		return false;
	}

	function ACS_PerformFinisher(combatTarget : CActor)
	{
		var finisherDist											: Float;

		if(  thePlayer.IsDoingSpecialAttack( false )
		|| thePlayer.IsUsingHorse()
		|| thePlayer.IsUsingVehicle()
		|| thePlayer.HasTag('ACS_IsPerformingFinisher')
		|| thePlayer.HasTag('ACS_IsPerformingCombatDismember')
		|| !thePlayer.WasVisibleInScaledFrame( ((CNewNPC)combatTarget), 1.f, 1.f )
		)
		{
			return;
		}

		ACS_ExplorationDelayHack(false, 3);

		if (((CMovingPhysicalAgentComponent)(((CNewNPC)combatTarget).GetMovingAgentComponent())).GetCapsuleHeight() >= 2
		|| ((CNewNPC)combatTarget).GetRadius() >= 0.7
		|| ((CNewNPC)combatTarget).HasAbility('Boss')
		|| ((CNewNPC)combatTarget).HasTag('IsBoss')
		|| ((CNewNPC)combatTarget).HasTag('ACS_Big_Boi')
		)
		{
			finisherDist = 4;
		}
		else
		{
			finisherDist = 2;
		}

		if (ACS_Settings_Main_Float('acs_visual_main_settings','acs_player_scale', 1) > 1)
		{
			finisherDist += ACS_Settings_Main_Float('acs_visual_main_settings','acs_player_scale', 1) * 0.25;
		}

		if( 
		combatTarget 
		&& thePlayer.IsInCombat() 
		&& !thePlayer.HasTag('ACS_IsPerformingFinisher')
		&& !thePlayer.HasTag('ACS_IsPerformingCombatDismember')
		&& CanPerformFinisher()
		)
		{
			last_finisher_time = theGame.GetEngineTimeAsSeconds();

			if (VecDistanceSquared2D( thePlayer.GetWorldPosition(), combatTarget.GetNearestPointInBothPersonalSpaces( thePlayer.GetWorldPosition() ) ) >= finisherDist * finisherDist)
			{
				if (combatTarget.HasTag('ACS_Final_Fear_Stack') && combatTarget.IsHuman())
				{
					return;
				}
				
				ACS_PhantomPerformFinisher(combatTarget);

				return;
			}

			if (VecDistanceSquared2D( thePlayer.GetWorldPosition(), combatTarget.GetNearestPointInBothPersonalSpaces( thePlayer.GetWorldPosition() ) ) < finisherDist * finisherDist)
			{
				if ( thePlayer.IsAnyWeaponHeld() )
				{
					thePlayer.RemoveTag('ACS_Manual_Combat_Control');

					ACSGetCActorDestroyAll('ACS_Geralt_Phantom');

					combatTarget.SignalGameplayEvent('DisableFinisher');

					if (!combatTarget.HasAbility('DisableFinishers'))
					{
						combatTarget.AddAbility( 'DisableFinishers', true);
					}

					if (combatTarget.HasAbility('ForceFinisher'))
					{
						combatTarget.RemoveAbility( 'ForceFinisher');
					} 

					if (thePlayer.IsWeaponHeld('fist') )
					{
						FistFinisherSetup(combatTarget);

						return;
					}

					if (!thePlayer.IsWeaponHeld('fist') )
					{
						WeaponFinisherSetup(combatTarget);
					}
				}
			}
		}
	}

	function ACS_PhantomPerformFinisher(combatTarget : CActor)
	{
		var finisher_anim_names												: array< name >;
		var pos																: Vector;
		var rot																: EulerAngles;
		var ent																: CEntity;

		if( 
		combatTarget 
		&& combatTarget.GetCurrentHealth() <= thePlayer.GetCurrentHealth()
		)
		{
			ACS_ExplorationDelayHack(false, 3);

			rot = thePlayer.GetWorldRotation();

			pos = combatTarget.GetWorldPosition();

			ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\entities\other\geralt_phantom_assassin.w2ent", true ), pos, rot );

			finisher_anim_names.Clear();

			if (combatTarget.IsHuman())
			{
				//finisher_anim_names.PushBack('man_finisher_04_lp');
				finisher_anim_names.PushBack('man_finisher_06_lp');
				finisher_anim_names.PushBack('man_finisher_03_rp');
				finisher_anim_names.PushBack('man_finisher_05_rp');
				finisher_anim_names.PushBack('man_finisher_02_lp');
				finisher_anim_names.PushBack('man_finisher_07_lp');
				finisher_anim_names.PushBack('man_finisher_08_lp');
				finisher_anim_names.PushBack('man_finisher_dlc_arm_lp');
				finisher_anim_names.PushBack('man_finisher_dlc_legs_lp');
				finisher_anim_names.PushBack('man_finisher_dlc_torso_lp');
				finisher_anim_names.PushBack('man_finisher_dlc_arm_rp');
				finisher_anim_names.PushBack('man_finisher_dlc_legs_rp');
				finisher_anim_names.PushBack('man_finisher_dlc_torso_rp');
				finisher_anim_names.PushBack('man_finisher_01_rp');
				finisher_anim_names.PushBack('man_finisher_dlc_head_rp');
				finisher_anim_names.PushBack('man_finisher_dlc_neck_rp');

				ACS_PhantomSetupSyncAnimInternalHuman(finisher_anim_names[RandRange(finisher_anim_names.Size())], ent, combatTarget );

				return;
			}

			combatTarget.RemoveTimer( 'ACS_DelayedDismemberTimer' );
			combatTarget.AddTimer( 'ACS_DelayedDismemberTimer', 0.5f, false );

			ACS_PhantomSetupSyncAnimInternalMonster('monster_slice_finisher', ent, combatTarget );
		}
	}

	function ACSGetCActorPosition( ent : CEntity ) : Vector
	{
		var pos 			: Vector;
		var actor			: CActor;
		var torsoBoneIndex	: int;
	
		pos = ent.GetWorldPosition();
		actor = (CActor)ent;
		if ( actor )
		{
			torsoBoneIndex = actor.GetTorsoBoneIndex();
			if ( torsoBoneIndex != -1 )
			{
				pos = MatrixGetTranslation( actor.GetBoneWorldMatrixByIndex( torsoBoneIndex ) );
			}
			else
			{
				pos = actor.GetWorldPosition();
			}
		}
		
		return pos;	
	}

	private function ProcessFinisherCameraAnimName( finisherAnimName : name ) : name
	{
		var camera 							: CCustomCamera;
		var playerToCamHeading 				: float;
		var playerTocamAnimInitialHeading 	: float;
		var angleDiffs						: array<float>;
		var i 								: int;	
		var finisherCameraAnimName			: name;

		camera = theGame.GetGameCamera();
		
		playerToCamHeading = VecHeading( camera.GetWorldPosition() - thePlayer.GetWorldPosition() ); 
		playerTocamAnimInitialHeading = thePlayer.GetHeading();
		
		for ( i = 0; i < 4; i += 1 )
		{
			angleDiffs.PushBack( AbsF( AngleDistance( playerToCamHeading, playerTocamAnimInitialHeading ) ) );
			playerTocamAnimInitialHeading += 90.f;
		}
		
		i = ArrayFindMinF( angleDiffs );	
		
		if ( i >= 3 )
		{
			switch ( finisherAnimName )
			{
				case 'man_finisher_02_lp':	finisherCameraAnimName = 'man_finisher_02_lp_camera_right'; break;
				case 'man_finisher_04_lp':	finisherCameraAnimName ='man_finisher_04_lp_camera_right'; break;
				case 'man_finisher_06_lp':	finisherCameraAnimName = 'man_finisher_06_lp_camera_right'; break;
				case 'man_finisher_07_lp':	finisherCameraAnimName = 'man_finisher_07_lp_camera_right'; break;
				case 'man_finisher_08_lp':	finisherCameraAnimName = 'man_finisher_08_lp_camera_right'; break;
				case 'man_finisher_dlc_arm_lp':	finisherCameraAnimName = 'man_finisher_dlc_arm_lp_camera_right'; break;
				case 'man_finisher_dlc_legs_lp':	finisherCameraAnimName = 'man_finisher_dlc_legs_lp_camera_right'; break;
				case 'man_finisher_dlc_torso_lp':	finisherCameraAnimName = 'man_finisher_dlc_torso_lp_camera_right'; break;

				case 'man_finisher_01_rp':	finisherCameraAnimName = 'man_finisher_01_rp_camera_right'; break;
				case 'man_finisher_03_rp':	finisherCameraAnimName = 'man_finisher_03_rp_camera_right'; break;
				case 'man_finisher_05_rp':	finisherCameraAnimName = 'man_finisher_05_rp_camera_right'; break;

				case 'man_finisher_dlc_arm_rp':	finisherCameraAnimName = 'man_finisher_dlc_arm_rp_camera_right'; break;
				case 'man_finisher_dlc_legs_rp':	finisherCameraAnimName = 'man_finisher_dlc_legs_rp_camera_right'; break;
				case 'man_finisher_dlc_torso_rp':	finisherCameraAnimName = 'man_finisher_dlc_torso_rp_camera_right'; break;
				case 'man_finisher_dlc_head_rp':	finisherCameraAnimName = 'man_finisher_dlc_head_rp_camera_right'; break;
				case 'man_finisher_dlc_neck_rp':	finisherCameraAnimName = 'man_finisher_dlc_neck_rp_camera_right'; break;

				case 'man_finisher_head_01_lp_ACS':	finisherCameraAnimName ='man_finisher_04_lp_camera_right'; break;
				case 'man_finisher_head_01_rp_ACS':	finisherCameraAnimName = 'man_finisher_03_rp_camera_right'; break;

				default : finisherCameraAnimName = 'man_finisher_02_lp_camera_right'; break;
			}
		}
		else if  ( i >= 2 )
		{
			switch ( finisherAnimName )
			{
				case 'man_finisher_02_lp':	finisherCameraAnimName = 'man_finisher_02_lp_camera_back'; break;
				case 'man_finisher_04_lp':	finisherCameraAnimName = 'man_finisher_04_lp_camera_back'; break;
				case 'man_finisher_06_lp':	finisherCameraAnimName = 'man_finisher_06_lp_camera_back'; break;
				case 'man_finisher_07_lp':	finisherCameraAnimName = 'man_finisher_07_lp_camera_back'; break;
				case 'man_finisher_08_lp':	finisherCameraAnimName = 'man_finisher_08_lp_camera_back'; break;
				case 'man_finisher_dlc_arm_lp':	finisherCameraAnimName = 'man_finisher_dlc_arm_lp_camera_back'; break;
				case 'man_finisher_dlc_legs_lp':	finisherCameraAnimName = 'man_finisher_dlc_legs_lp_camera_back'; break;
				case 'man_finisher_dlc_torso_lp':	finisherCameraAnimName = 'man_finisher_dlc_torso_lp_camera_back'; break;

				case 'man_finisher_01_rp':	finisherCameraAnimName = 'man_finisher_01_rp_camera_back'; break;
				case 'man_finisher_03_rp':	finisherCameraAnimName = 'man_finisher_03_rp_camera_back'; break;
				case 'man_finisher_05_rp':	finisherCameraAnimName = 'man_finisher_05_rp_camera_back'; break;

				case 'man_finisher_dlc_arm_rp':	finisherCameraAnimName = 'man_finisher_dlc_arm_rp_camera_back'; break;
				case 'man_finisher_dlc_legs_rp':	finisherCameraAnimName = 'man_finisher_dlc_legs_rp_camera_back'; break;
				case 'man_finisher_dlc_torso_rp':	finisherCameraAnimName = 'man_finisher_dlc_torso_rp_camera_back'; break;
				case 'man_finisher_dlc_head_rp':	finisherCameraAnimName = 'man_finisher_dlc_head_rp_camera_back'; break;
				case 'man_finisher_dlc_neck_rp':	finisherCameraAnimName = 'man_finisher_dlc_neck_rp_camera_back'; break;

				case 'man_finisher_head_01_lp_ACS':	finisherCameraAnimName ='man_finisher_04_lp_camera_back'; break;
				case 'man_finisher_head_01_rp_ACS':	finisherCameraAnimName = 'man_finisher_03_rp_camera_back'; break;

				default : finisherCameraAnimName = 'man_finisher_02_lp_camera_back'; break;
			}
		}
		else if  ( i >= 1 )
		{
			switch ( finisherAnimName )
			{
				case 'man_finisher_02_lp':	finisherCameraAnimName = 'man_finisher_02_lp_camera_left'; break;
				case 'man_finisher_04_lp':	finisherCameraAnimName = 'man_finisher_04_lp_camera_left'; break;
				case 'man_finisher_06_lp':	finisherCameraAnimName = 'man_finisher_06_lp_camera_left'; break;
				case 'man_finisher_07_lp':	finisherCameraAnimName = 'man_finisher_07_lp_camera_left'; break;
				case 'man_finisher_08_lp':	finisherCameraAnimName = 'man_finisher_08_lp_camera_left'; break;
				case 'man_finisher_dlc_arm_lp':	finisherCameraAnimName = 'man_finisher_dlc_arm_lp_camera_left'; break;
				case 'man_finisher_dlc_legs_lp':	finisherCameraAnimName = 'man_finisher_dlc_legs_lp_camera_left'; break;
				case 'man_finisher_dlc_torso_lp':	finisherCameraAnimName = 'man_finisher_dlc_torso_lp_camera_left'; break;

				case 'man_finisher_01_rp':	finisherCameraAnimName = 'man_finisher_01_rp_camera_left'; break;
				case 'man_finisher_03_rp':	finisherCameraAnimName = 'man_finisher_03_rp_camera_left'; break;
				case 'man_finisher_05_rp':	finisherCameraAnimName = 'man_finisher_05_rp_camera_left'; break;

				case 'man_finisher_dlc_arm_rp':	finisherCameraAnimName = 'man_finisher_dlc_arm_rp_camera_left'; break;
				case 'man_finisher_dlc_legs_rp':	finisherCameraAnimName = 'man_finisher_dlc_legs_rp_camera_left'; break;
				case 'man_finisher_dlc_torso_rp':	finisherCameraAnimName = 'man_finisher_dlc_torso_rp_camera_left'; break;
				case 'man_finisher_dlc_head_rp':	finisherCameraAnimName = 'man_finisher_dlc_head_rp_camera_left'; break;
				case 'man_finisher_dlc_neck_rp':	finisherCameraAnimName = 'man_finisher_dlc_neck_rp_camera_left'; break;

				case 'man_finisher_head_01_lp_ACS':	finisherCameraAnimName ='man_finisher_04_lp_camera_left'; break;
				case 'man_finisher_head_01_rp_ACS':	finisherCameraAnimName = 'man_finisher_03_rp_camera_left'; break;

				default : finisherCameraAnimName = 'man_finisher_02_lp_camera_left'; break;
			}
		}
		else
		{
			switch ( finisherAnimName )
			{
				case 'man_finisher_02_lp':	finisherCameraAnimName = 'man_finisher_02_lp_camera_front'; break;
				case 'man_finisher_04_lp':	finisherCameraAnimName = 'man_finisher_04_lp_camera_front'; break;
				case 'man_finisher_06_lp':	finisherCameraAnimName = 'man_finisher_06_lp_camera_front'; break;
				case 'man_finisher_07_lp':	finisherCameraAnimName = 'man_finisher_07_lp_camera_front'; break;
				case 'man_finisher_08_lp':	finisherCameraAnimName = 'man_finisher_08_lp_camera_front'; break;
				case 'man_finisher_dlc_arm_lp':	finisherCameraAnimName = 'man_finisher_dlc_arm_lp_camera_front'; break;
				case 'man_finisher_dlc_legs_lp':	finisherCameraAnimName = 'man_finisher_dlc_legs_lp_camera_front'; break;
				case 'man_finisher_dlc_torso_lp':	finisherCameraAnimName = 'man_finisher_dlc_torso_lp_camera_front'; break;

				case 'man_finisher_01_rp':	finisherCameraAnimName = 'man_finisher_01_rp_camera_front'; break;
				case 'man_finisher_03_rp':	finisherCameraAnimName = 'man_finisher_03_rp_camera_front'; break;
				case 'man_finisher_05_rp':	finisherCameraAnimName = 'man_finisher_05_rp_camera_front'; break;

				case 'man_finisher_dlc_arm_rp':	finisherCameraAnimName = 'man_finisher_dlc_arm_rp_camera_front'; break;
				case 'man_finisher_dlc_legs_rp':	finisherCameraAnimName = 'man_finisher_dlc_legs_rp_camera_front'; break;
				case 'man_finisher_dlc_torso_rp':	finisherCameraAnimName = 'man_finisher_dlc_torso_rp_camera_front'; break;
				case 'man_finisher_dlc_head_rp':	finisherCameraAnimName = 'man_finisher_dlc_head_rp_camera_front'; break;
				case 'man_finisher_dlc_neck_rp':	finisherCameraAnimName = 'man_finisher_dlc_neck_rp_camera_front'; break;

				case 'man_finisher_head_01_lp_ACS':	finisherCameraAnimName ='man_finisher_04_lp_camera_front'; break;
				case 'man_finisher_head_01_rp_ACS':	finisherCameraAnimName = 'man_finisher_03_rp_camera_front'; break;


				{
					iconPath = "<br/><br/>" + "<font size = '16' color = '#b9b9b9'>" + "[" + FloatToStringPrec(distance, 0) + "m" + "]" + zPositioning + "</font>";
				}
			}
		}
		else
		{
			if (distance <= 4.5 )
			{
				iconPath = "<br/><br/>" + "<font size = '16' color = '#b9b9b9'>" + "[" + GetLocStringByKeyExt("fake_key_1h78y_j") + "]" + zPositioning + "</font>";
			}
			else
			{
				iconPath = "<br/><br/>" + "<font size = '16' color = '#b9b9b9'>" + "[" + FloatToStringPrec(distance, 0) + "m" + "]" + zPositioning + "</font>";
			}
		}

		ACS_Oneliner(iconPath, ACSGetCEntity('ACS_Guiding_Light_Merchant_Marker'), "ACS_Merchant_Distance_GUI_Marker");

		GetACSStorage().acs_setScaleForOnelinerByTag("ACS_Merchant_Distance_GUI_Marker", 100, 100, 100);

		GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Merchant_Distance_GUI_Marker", 100);

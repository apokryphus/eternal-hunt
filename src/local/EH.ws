	event OnDrinkPotionHold( action : SInputAction )
	{
		if(RadialMenuCheck())
		{
			if( IsPressed(action) )
			{
				switch( action.aName )
				{
					case 'DrinkPotion1Hold' :
						GetWitcherPlayer().PotionSelectionPopup( EISPM_RadialMenuSlot1 );
					break;

					case 'DrinkPotion2Hold' :
						GetWitcherPlayer().PotionSelectionPopup( EISPM_RadialMenuSlot2 );
					break;

					case 'DrinkPotion3Hold' :
						GetWitcherPlayer().PotionSelectionPopup( EISPM_RadialMenuSlot3 );
					break;

					case 'DrinkPotion4Hold' :
						GetWitcherPlayer().PotionSelectionPopup( EISPM_RadialMenuSlot4 );
					break;

					default :
					break;
				}
			}
		}
	}

	public timer function ForceControlModuleHudUpdate( dt : float, id : int )
	{
		var hud 																			: CR4ScriptedHud;
		var controlsFeedbackModule 															: CR4HudModuleControlsFeedback;	

		hud = (CR4ScriptedHud)(theGame.GetHud());

		if (hud)
		{
			controlsFeedbackModule = (CR4HudModuleControlsFeedback)(hud.GetHudModule(NameToString('ControlsFeedbackModule')));

			if (controlsFeedbackModule)
			{
				controlsFeedbackModule.ACS_UpdateSwordDisplay();
				controlsFeedbackModule.ForceModuleUpdate();
			}
		}
	}
	
	private var processedSwordHold : bool;

	function ShowSwordStanceNotification( ent : CEntity, text : string )
	{
		var hud 															: CR4ScriptedHud;
		var moduleRadial													: CR4HudModuleRadialMenu;
		var swordTypeDesc													: string;
		var l_iconPath														: string;

		if (text == GetLocStringById(2116581193))
		{
			l_iconPath = "icons/inventory/acs_fast_style.xbm";
		}
		else if (text == GetLocStringById(2116581194))
		{
			l_iconPath = "icons/inventory/acs_group_style.xbm";
		}
		else if (text == GetLocStringById(2116581195))
		{
			l_iconPath = "icons/inventory/acs_strong_style.xbm";
		}
		else if (text == GetLocStringById(2116581198))
		{
			l_iconPath = "icons/inventory/acs_default_style.xbm";
		}

		ACS_Oneliner(
		(new ACS_Oneliner_TagBuilder in theGame)
		.tag("font")
		.attr("size", "26")
		.attr("color", "#ffffff")
		.text(FormatIconPath(l_iconPath) + "<br/>" + "-[" + text + "]-" )
		, ent, "ACS_Sword_Stance_Notification", Vector(0,0,-0.25), 3);

		GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Sword_Stance_Notification", 100);

		GetACSStorage().acs_setScaleForOnelinerByTag("ACS_Sword_Stance_Notification", 100, 100, 100);

		hud = (CR4ScriptedHud)theGame.GetHud();
		moduleRadial = (CR4HudModuleRadialMenu)hud.GetHudModule("RadialMenuModule");

		if( hud 
		&& moduleRadial 
		&& moduleRadial.IsRadialMenuOpened()
		)
		{
			if (thePlayer.IsWeaponHeld('steelsword'))
			{
				swordTypeDesc = GetLocStringByKeyExt("panel_inventory_paperdoll_slotname_steel") +  ": ";
			}
			else if (thePlayer.IsWeaponHeld('silversword'))
			{
				swordTypeDesc = GetLocStringByKeyExt("panel_inventory_paperdoll_slotname_silver") +  ": ";
			}

			moduleRadial.ACS_SetDescription(FormatIconPath(l_iconPath) + "<br/>" + swordTypeDesc + text);
		}
	}
	
	event OnCommSteelSword( action : SInputAction )
	{
		var duringCastSign 																	: bool;
		var ent            																	: CEntity; 
		var hud 																			: CR4ScriptedHud;
		var controlsFeedbackModule 															: CR4HudModuleControlsFeedback;	

		if (FactsQuerySum("acs_transformation_activated") > 0)
		{
			if(IsPressed(action))
			{
				ACS_ExplorationDelayHack(false, 3);

				if (FactsQuerySum("acs_vampireess_transformation_activated") > 0)
				{
					GetVampiressClass().ACS_VampiressBehSwitch_Engage();
				}

				if (FactsQuerySum("acs_giant_curse_activated") > 0 
				&& !ACSGetCActor('ACS_Transformation_Giant').HasTag('ACS_Transformation_Giant_Block_All_Actions')
				)
				{
					if (thePlayer.GetStat(BCS_Focus) >= thePlayer.GetStatMax( BCS_Focus ) * 0.9875)
					{
						GetTransformationGiantClass().TransformationGiantBehSwitch_Engage();

						GetTransformationGiantClass().TransformationGiantLightningStrike_Engage();
					}
				}

				if (FactsQuerySum("acs_vampire_monster_transformation_activated") > 0)
				{
					if(theInput.GetActionValue('Sprint'))
					{
						return false;
					}

					if(theGame.GetEngineTimeAsSeconds() - last_transformation_special_attack_time > transformation_special_attack_cooldown)
					{
						last_transformation_special_attack_time = theGame.GetEngineTimeAsSeconds();

						ACS_VampireMonsterBehSwitch();
					}
				}
			}

			return false;
		}

		if ( theInput.LastUsedGamepad() && (theInput.IsActionPressed('Alternate') || theInput.GetActionValue('ACSToggleWearablesMode') > 0.5) )
		{
			return false;
		}
		
		if(IsPressed(action))
		{
			RemoveTimer('DrawSteelSword');
			RemoveTimer('DrawSilverSword');

			if( !thePlayer.IsUsingHorse()
			&& !thePlayer.IsUsingVehicle()
			)
			{
				ACS_Tutorial_Display_Check('ACS_Stance_Switching_Tutorial_Shown');
			}
			
			processedSwordHold = false;
		}

		if ( theInput.LastUsedGamepad() && theInput.IsActionPressed('Alternate') )
		{
			return false;
		}
		
		if( IsPressed( action ) 
		&& thePlayer.IsWeaponHeld( 'steelsword' )
		&& !thePlayer.IsUsingHorse()
		&& !thePlayer.IsUsingVehicle()
		)
		{
			if( steelSwordSheatheCallTime + DOUBLE_TAP_WINDOW >= theGame.GetEngineTimeAsSeconds() )
			{
				steelSwordSheatheDoubleTap = true;
			}
			else
			{
				steelSwordSheatheDoubleTap = false;	
			}

			if( steelSwordSheatheDoubleTap )
			{
				ACS_Tutorial_Display_Check('ACS_Stance_Switching_Tutorial_Shown');

				RemoveTimer('DrawSteelSword');
				RemoveTimer('DrawSilverSword');

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Sword_Stance_Notification");

				ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

				"dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent"

				, true ), thePlayer.GetWorldPosition() );

				ent.CreateAttachment(thePlayer,'blood_point', Vector(0,0,0));

				ent.DestroyAfter(2);

				if (RandF() < 0.5)
				{
					thePlayer.SoundEvent('sprj_katana_iai_00_bb_acs');
				}
				else
				{
					thePlayer.SoundEvent('sprj_katana_iai_01_bb_acs');
				}

				vACS_Stance_Switch = new cACS_Stance_Switch in this;

				switch(ACS_Settings_Main_Int('acs_combat_main_settings','acs_steel_silver_moveset_switch', 0))
				{
					case 1:
					case 3:
						if (!silver_strong_stance 
						&& !silver_group_stance
						&& !silver_fast_stance
						)
						{
							ShowSwordStanceNotification(ent,  GetLocStringById(2116581193));

							silver_fast_stance = true;

							vACS_Stance_Switch.ACS_Silver_Fast_Switch_Activate_Engage();
						}
						else if ( !silver_strong_stance 
						&& !silver_group_stance
						&& silver_fast_stance
						)
						{
							ShowSwordStanceNotification(ent,  GetLocStringById(2116581194));

							silver_fast_stance = false;

							silver_group_stance = true;

							vACS_Stance_Switch.ACS_Silver_Group_Switch_Activate_Engage();
						}
						else if ( 
						silver_group_stance 
						&& !silver_strong_stance 
						&& !silver_fast_stance
						)
						{
							ShowSwordStanceNotification(ent,  GetLocStringById(2116581195));

							silver_group_stance = false;

							silver_strong_stance = true;

							vACS_Stance_Switch.ACS_Silver_Strong_Switch_Activate_Engage();
						}
						else if ( 
						silver_strong_stance 
						&& !silver_group_stance 
						&& !silver_fast_stance 
						)
						{
							ShowSwordStanceNotification(ent,  GetLocStringById(2116581198));

							silver_strong_stance = false;

							if (thePlayer.IsInCombat())
							{
								thePlayer.RaiseEvent('ACS_CombatExtraTW1SilverStrongStart');
							}
							else
							{
								RemoveTimer('SwordTauntSwitch'); 
								RemoveTimer('SwordTauntRunningSwitch'); 
								RemoveTimer('CombatTauntDelay');
								RemoveTimer('SwordTauntRunningSwitchSecondary'); 
								RemoveTimer('SwordTauntRunningSwitchSecondaryWeaponBlood'); 
								AddTimer('SwordTauntRunningSwitchSecondary', 0.01 , false); 
							}

							vACS_Stance_Switch.ACS_Stance_Switch_Deactivate_Engage();
						}
					break;

					case 0:
					case 2:
						if (!steel_strong_stance 
						&& !steel_group_stance
						&& !steel_fast_stance
						)
						{
							ShowSwordStanceNotification(ent,  GetLocStringById(2116581193));

							steel_fast_stance = true;

							vACS_Stance_Switch.ACS_Steel_Fast_Switch_Activate_Engage();
						}

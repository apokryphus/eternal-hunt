				RemoveTimer('ACS_Combo_Counter_Reset_Timer'); AddTimer('ACS_Combo_Counter_Reset_Timer', 4 , false);

				if( targetDistance <= 4 * 4) 
				{
					thePlayer.RaiseEvent('ACS_TW1AnimsReset');
					
					GeraltHeavyAttackDefault(false);
				}
				else
				{
					GeraltHeavyAttackDefaultForward();
				}
			
			break;

			default:
			break;
		}
	}


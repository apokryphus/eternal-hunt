							combo_counter_damage += 1;

							combo_counter_igni_counter += 1;
						break;

						case 0: 
							PlayerPlayAnimation( 'tw1_silver_fast_parry_counter_01_ACS');

							combo_counter_damage += 1;

							combo_counter_igni_counter += 1;

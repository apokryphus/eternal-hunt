	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	function Guiding_Light_Enemy_Scan()
	{
		var rot, newRot          				: EulerAngles;
		var ent									: CEntity;
		var temp								: CEntityTemplate;
		var targetDistance						: float;

		if ( theGame.IsDialogOrCutscenePlaying() 
		|| theGame.IsFading()
		|| theGame.IsBlackscreen()
		|| theGame.IsPaused() 
		|| theGame.GetPhotomodeEnabled() 
		|| thePlayer.IsInCutsceneIntro() 
		|| ACS_GetNearbyEnemyLocation() == Vector(0,0,-200)
		|| ACS_Settings_Main_Float('acs_hud_settings_markers','acs_enemy_marker_despawn_delay', 7) == 0
		)
		{
			if(ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker'))
			{
				GetACSStorage().acs_deleteOnelinerByTag("ACS_Enemy_GUI_Marker");

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Enemy_Distance_GUI_Marker");

				if (ACS_Guiding_Light_Enemy_Marker_Distance_Available)
				{
					ACS_Guiding_Light_Enemy_Marker_Distance_Available = false;
				}

				ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').Destroy();
			}

			return;
		}

		targetDistance = VecDistanceSquared2D( GetWitcherPlayer().GetWorldPosition(), ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').GetWorldPosition() ) ;

		rot = thePlayer.GetWorldRotation();

		rot.Pitch += 180;

		rot.Yaw += 180;

		if( ACS_GetNearbyEnemyLocation() != Vector(0,0,-200)
		)
		{
			if(!ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker'))
			{
				temp = (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\fx\guiding_light_marker_old.w2ent", true );

				ent = (CEntity)theGame.CreateEntity( temp, ACS_GetNearbyEnemyLocation(), rot );

				ent.AddTag('ACS_Guiding_Light_Enemy_Marker');

				ent.AddTag('ACS_HUD_Marker_Entity');

				ent.AddTag('ACS_POI_Trigger_Entity');
			}
			else
			{
				GetACSStorage().acs_deleteOnelinerByTag("ACS_Enemy_GUI_Marker");

				ACS_Oneliner(FormatIconPath("icons/inventory/acs_marker_enemy.xbm"), ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker'), "ACS_Enemy_GUI_Marker");

				GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Enemy_GUI_Marker", 100);

				GetACSStorage().acs_setScaleForOnelinerByTag("ACS_Enemy_GUI_Marker", 100, 100, 100);

				if (!ACS_Guiding_Light_Enemy_Marker_Distance_Available)
				{
					ACS_Guiding_Light_Enemy_Marker_Distance_Available = true;
				}

				if (ACS_Settings_Main_Bool('acs_hud_settings_markers','acs_marker_bubble_enabled', false))
				{
					if (targetDistance <= 5 * 5)
					{
						ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').StopEffect('enemy_marker_smaller');
						ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').StopEffect('enemy_marker_small');
						ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').StopEffect('enemy_marker');
						ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').StopEffect('enemy_marker_bigger');
						ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').StopEffect('enemy_marker_biggest');
						ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').StopEffect('enemy_marker_biggest_x2');
						ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').StopEffect('enemy_marker_biggest_x4');
					}
					else if (targetDistance > 5 * 5 && targetDistance <= 10 * 10)
					{
						ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').StopEffect('enemy_marker_small');
						ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').StopEffect('enemy_marker');
						ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').StopEffect('enemy_marker_bigger');
						ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').StopEffect('enemy_marker_biggest');
						ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').StopEffect('enemy_marker_biggest_x2');
						ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').StopEffect('enemy_marker_biggest_x4');

						if (!ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').IsEffectActive('enemy_marker_smaller', false))
						{
							ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').PlayEffectSingle('enemy_marker_smaller');
						}
					}
					else if (targetDistance > 10 * 10 && targetDistance <= 25 * 25)
					{
						ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').StopEffect('enemy_marker_smaller');
						ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').StopEffect('enemy_marker');
						ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').StopEffect('enemy_marker_bigger');
						ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').StopEffect('enemy_marker_biggest');
						ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').StopEffect('enemy_marker_biggest_x2');
						ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').StopEffect('enemy_marker_biggest_x4');

						if (!ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').IsEffectActive('enemy_marker_small', false))
						{
							ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').PlayEffectSingle('enemy_marker_small');
						}
					}
					else if (targetDistance > 25 * 25 && targetDistance <= 50 * 50)
					{
						ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').StopEffect('enemy_marker_smaller');
						ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').StopEffect('enemy_marker_small');
						ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').StopEffect('enemy_marker_bigger');
						ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').StopEffect('enemy_marker_biggest');
						ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').StopEffect('enemy_marker_biggest_x2');
						ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').StopEffect('enemy_marker_biggest_x4');

						if (!ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').IsEffectActive('enemy_marker', false))
						{
							ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').PlayEffectSingle('enemy_marker');
						}
					}
					else if (targetDistance > 50 * 50 && targetDistance <= 100 * 100)
					{
						ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').StopEffect('enemy_marker_smaller');
						ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').StopEffect('enemy_marker_small');
						ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').StopEffect('enemy_marker');
						ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').StopEffect('enemy_marker_biggest');
						ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').StopEffect('enemy_marker_biggest_x2');
						ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').StopEffect('enemy_marker_biggest_x4');

						if (!ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').IsEffectActive('enemy_marker_bigger', false))
						{
							ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').PlayEffectSingle('enemy_marker_bigger');
						}
					}
					else if (targetDistance > 100 * 100 )
					{
						ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').StopEffect('enemy_marker_smaller');
						ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').StopEffect('enemy_marker_small');
						ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').StopEffect('enemy_marker');
						ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').StopEffect('enemy_marker_bigger');
						ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').StopEffect('enemy_marker_biggest_x2');
						ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').StopEffect('enemy_marker_biggest_x4');

						if (!ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').IsEffectActive('enemy_marker_biggest', false))
						{
							ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').PlayEffectSingle('enemy_marker_biggest');
						}
					}
				}
			}
		}
	}


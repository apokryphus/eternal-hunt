					{ 
						quantity = 8; 
					}
					else 
					{ 
						quantity = thePlayer.GetInventory().GetItemQuantity( boltid ) - 1; 
					}

					row1 = Min( quantity,4 );
					row2 = Min( quantity - row1,3 );
					row3 = Min( quantity - row1 - row2,2 );
					
					if ( row1 > 0 )
					{
						for(row01i=1; row01i<=row1; row01i+=1)
						{
							boltRow01 = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource(deployedEnt.GetReadableName(),true ), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation()  );

						break;
						
						default:
						ACSTransformBlackWolfPlayAnim( 'wolf_attack_closer_from_run', 0.25f, 0.325f);
						AddTimer('BlackWolfHeavyAttackDamage', 0.25f   , false);
						AddTimer('BlackWolfHeavyAttackDamage_1', 0.75f   , false);
						break;
					}
			
					this.previous_black_wolf_heavy_attack_index_1 = black_wolf_heavy_attack_index_1;
				}
				else
				{
					ACSTransformBlackWolfPlayAnim( 'wolf_attack_closer', 0.25f, 0.325f);
					AddTimer('BlackWolfHeavyAttackDamage', 0.7f   , false);
					AddTimer('BlackWolfHeavyAttackDamage_1', 1.0f   , false);
				}
			}
			
			ACS_StaminaDrain(5, true);
		}
	}

	function ACS_Transformation_Black_Wolf_Special_Attack()
	{
		if (theGame.GetEngineTimeAsSeconds() - last_transformation_special_attack_time > transformation_special_attack_cooldown)
		{
			last_transformation_special_attack_time = theGame.GetEngineTimeAsSeconds();

			ACSTransformationBlackWolfRemoveMoveTimers();

			ACSTransformBlackWolfMovementAdjust('cancel', true);

			if (thePlayer.IsInCombat())
			{
				if (thePlayer.GetDisplayTarget())
				{
					if (ACS_IsDisplayTargetInFrontOfBlackWolf())
					{
						if
						(
							theInput.GetActionValue('GI_AxisLeftX') != 0
							|| theInput.GetActionValue( 'GI_AxisLeftY' ) != 0 
						)	
						{
							black_wolf_dodge_timer_actual();

							GetTransformationBlackWolfClass().Spawn_Wolf_Summons_Engage();

							ACSGetCActor('ACS_Transformation_Black_Wolf').PlayEffectSingle('shadows_form');

							ACSTransformBlackWolfPlayAnim( 'barghest_attack_jumping_through_faster', 0.25f, 0.325f);

							AddTimer('BlackWolfHeavyAttackDamageFire360', 0.5188322f   , false);
						}
						else
						{
							ACSTransformBlackWolfPlayAnim( 'barghest_attack_spitting_fire', 0.25f, 0.325f);

							AddTimer('BlackWolfHeavyAttackDamageFire', 1.13479f   , false);
						}
					}
					else
					{
						black_wolf_dodge_timer_actual();

						ACSTransformBlackWolfPlayAnim( 'wolf_dodge_back', 0.25f, 0.325f);

						if (thePlayer.GetStat( BCS_Focus ) == thePlayer.GetStatMax( BCS_Focus) )
						{
							//ACSGetCActor('ACS_Transformation_Black_Wolf').PlayEffectSingle('shadows_form');

							//AddTimer('BlackWolfHeavyAttackDamageFireIndependent', 0.5f   , false);
						}
						
						ACSTransformBlackWolfMovementAdjust('rotatetoenemy', true);
					}
				}
				else
				{
					if
					(
						theInput.GetActionValue('GI_AxisLeftX') != 0
						|| theInput.GetActionValue( 'GI_AxisLeftY' ) != 0 
					)	
					{
						black_wolf_dodge_timer_actual();

						GetTransformationBlackWolfClass().Spawn_Wolf_Summons_Engage();

						ACSGetCActor('ACS_Transformation_Black_Wolf').PlayEffectSingle('shadows_form');

						ACSTransformBlackWolfPlayAnim( 'barghest_attack_jumping_through_faster', 0.25f, 0.325f);

						AddTimer('BlackWolfHeavyAttackDamageFire360', 0.5188322f   , false);
					}
					else
					{
						ACSTransformBlackWolfPlayAnim( 'barghest_attack_spitting_fire', 0.25f, 0.325f);

						AddTimer('BlackWolfHeavyAttackDamageFire', 1.13479f   , false);
					}
				}
			}
			else
			{
				if
				(
					theInput.GetActionValue('GI_AxisLeftX') != 0
					|| theInput.GetActionValue( 'GI_AxisLeftY' ) != 0 
				)	
				{
					black_wolf_dodge_timer_actual();

					GetTransformationBlackWolfClass().Spawn_Wolf_Summons_Engage();

					ACSGetCActor('ACS_Transformation_Black_Wolf').PlayEffectSingle('shadows_form');

					ACSTransformBlackWolfPlayAnim( 'barghest_attack_jumping_through_faster', 0.25f, 0.325f);

					AddTimer('BlackWolfHeavyAttackDamageFire360', 0.5188322f   , false);
				}
				else
				{
					ACSTransformBlackWolfPlayAnim( 'barghest_attack_spitting_fire', 0.25f, 0.325f);

					AddTimer('BlackWolfHeavyAttackDamageFire', 1.13479f   , false);
				}
			}
			
			ACS_StaminaDrain(5, true);
		}
	}

	function ACS_Transformation_Black_Wolf_Dodge()
	{
		if (theGame.GetEngineTimeAsSeconds() - last_transformation_dodge_time > transformation_dodge_cooldown)
		{
			last_transformation_dodge_time = theGame.GetEngineTimeAsSeconds();

			ACSTransformationBlackWolfRemoveMoveTimers();

			black_wolf_dodge_timer_actual();

			if (thePlayer.IsInCombat())
			{
				ACSTransformBlackWolfMovementAdjust('rotatetoenemy', true);
			}
			else
			{
				ACSTransformBlackWolfMovementAdjust('forward', true);
			}

			if (theInput.GetActionValue('GI_AxisLeftY') > 0.5)
			{
				ACSTransformBlackWolfPlayAnim('wolf_attack_jump_forward', 0.25f, 0.325f);
			}
			else if (theInput.GetActionValue('GI_AxisLeftY') < -0.5)
			{
				ACSTransformBlackWolfPlayAnim('wolf_dodge_back', 0.25f, 0.875f);
			}
			else if (theInput.GetActionValue('GI_AxisLeftX') > 0.5)
			{
				if (RandF() < 0.5)
				{
					ACSTransformBlackWolfPlayAnim('wolf_attack_jump_back_right', 0.25f, 0.325f);
				}
				else
				{
					ACSTransformBlackWolfPlayAnim('wolf_attack_jump_back_right_low', 0.25f, 0.325f);
				}
			}
			else if (theInput.GetActionValue('GI_AxisLeftX') < -0.5)
			{
				if (RandF() < 0.5)
				{
					ACSTransformBlackWolfPlayAnim('wolf_attack_jump_back_left', 0.25f, 0.325f);
				}
				else
				{
					ACSTransformBlackWolfPlayAnim('wolf_attack_jump_back_left_low', 0.25f, 0.325f);
				}
			}
			else
			{
				ACSTransformBlackWolfPlayAnim('wolf_dodge_back', 0.25f, 0.325f);
			}

			if (thePlayer.GetStat( BCS_Focus ) == thePlayer.GetStatMax( BCS_Focus) )
			{
				//AddTimer('BlackWolfHeavyAttackDamageFireIndependent', 0.5f   , false);

				//ACSGetCActor('ACS_Transformation_Black_Wolf').PlayEffectSingle('shadows_form');
			}

			ACS_StaminaDrain(5, true);
		}
	}

	function black_wolf_dodge_timer_actual() 
	{
		RemoveTimer('ACS_black_wolf_dodge_timer_end');

		thePlayer.SetImmortalityMode( AIM_Invulnerable, AIC_Default, true ); 

		thePlayer.SetIsCurrentlyDodging(true);

		ACSGetCActor('ACS_Transformation_Black_Wolf').EnableCharacterCollisions(false);

		AddTimer('ACS_black_wolf_dodge_timer_end', 0.875     , false);
	}

	public timer function ACS_black_wolf_dodge_timer_end ( dt : float, id : int) 
	{ 
		thePlayer.SetImmortalityMode( AIM_None, AIC_Default, true ); 

		thePlayer.SetIsCurrentlyDodging(false);

		ACSGetCActor('ACS_Transformation_Black_Wolf').EnableCharacterCollisions(true);

		ACSGetCActor('ACS_Transformation_Black_Wolf').StopEffect('shadows_form');
	} 

	function ACS_Transformation_Black_Wolf_Move_Controls()
	{
		var event_names	: array<name>;
		var lookatPos : Vector;

		if (thePlayer.GetStat( BCS_Focus ) == thePlayer.GetStatMax( BCS_Focus) )
		{
			if (!ACSGetCActor('ACS_Transformation_Black_Wolf').IsEffectActive('critical_burning_red'))
			{
				ACSGetCActor('ACS_Transformation_Black_Wolf').PlayEffectSingle('critical_burning_red');
			}

			if (!ACSGetCActor('ACS_Transformation_Black_Wolf').IsEffectActive('critical_burning_red_alt'))
			{
				ACSGetCActor('ACS_Transformation_Black_Wolf').PlayEffectSingle('critical_burning_red_alt');
			}
		}
		else
		{
			if (ACSGetCActor('ACS_Transformation_Black_Wolf').IsEffectActive('critical_burning_red'))
			{
				ACSGetCActor('ACS_Transformation_Black_Wolf').StopEffect('critical_burning_red');
			}

			if (ACSGetCActor('ACS_Transformation_Black_Wolf').IsEffectActive('critical_burning_red_alt'))
			{
				ACSGetCActor('ACS_Transformation_Black_Wolf').StopEffect('critical_burning_red_alt');
			}
		}

		if (thePlayer.IsInCombat())
		{
			if (thePlayer.GetStat(BCS_Toxicity) < thePlayer.GetStatMax(BCS_Toxicity))
			{
				thePlayer.GainStat(BCS_Toxicity, (thePlayer.GetStatMax(BCS_Toxicity) - thePlayer.GetStat(BCS_Toxicity)) * 0.00006125);
			}
			
			thePlayer.DrainVitality(thePlayer.GetStat(BCS_Vitality) * 0.000030625);
		}
		else
		{
			if (thePlayer.GetStat(BCS_Toxicity) < thePlayer.GetStatMax(BCS_Toxicity))
			{
				thePlayer.GainStat(BCS_Toxicity, (thePlayer.GetStatMax(BCS_Toxicity) - thePlayer.GetStat(BCS_Toxicity)) * 0.000030625);
			}
			
			thePlayer.DrainVitality(thePlayer.GetStat(BCS_Vitality) * 0.0000153125);
		}

		ACSGetCActor('ACS_Transformation_Black_Wolf').GetMovingAgentComponent().EnableCombatMode( true );

		ACSGetCActor('ACS_Transformation_Black_Wolf').GetMovingAgentComponent().SetVirtualRadius( 'CombatCharacterRadius' );

		((CNewNPC)ACSGetCActor('ACS_Transformation_Black_Wolf')).SetBehaviorVariable( 'additiveTauntOn', 1, true );

		if (thePlayer.IsInCombat())
		{
			if (thePlayer.GetTarget())
			{
				lookatPos = ((CActor)(thePlayer.GetTarget())).GetWorldPosition();
			}
			else
			{
				lookatPos = ACSGetCEntity('acs_lookat_entity').GetWorldPosition();

				lookatPos.Z -= 10;
			}
		}
		else
		{
			lookatPos = ACSGetCEntity('acs_lookat_entity').GetWorldPosition();

			lookatPos.Z -= 10;
		}

		((CNewNPC)ACSGetCActor('ACS_Transformation_Black_Wolf')).SetBehaviorVectorVariable( 'lookAtTarget', lookatPos );

		if (((CNewNPC)ACSGetCActor('ACS_Transformation_Black_Wolf')).GetBehaviorVariable( 'lookatOn' ) != 1)
		{
			((CNewNPC)ACSGetCActor('ACS_Transformation_Black_Wolf')).SetBehaviorVariable( 'lookatOn', 1, true );
		}

		if (thePlayer.IsCurrentlyDodging() 
		)
		{
			ACSGetCActor('ACS_Transformation_Black_Wolf').GetMovingAgentComponent().ForceSetRelativeMoveSpeed( 0 );
			ACSGetCActor('ACS_Transformation_Black_Wolf').GetMovingAgentComponent().SetGameplayRelativeMoveSpeed( 0 );
			return;
		}

		if (theInput.GetActionValue('GI_AxisLeftX') == 0 && theInput.GetActionValue('GI_AxisLeftY') == 0 )
		{
			ACSGetCActor('ACS_Transformation_Black_Wolf').GetMovingAgentComponent().ForceSetRelativeMoveSpeed( 0 );
			ACSGetCActor('ACS_Transformation_Black_Wolf').GetMovingAgentComponent().SetGameplayRelativeMoveSpeed( 0 );

			if(!GetWitcherPlayer().IsInCombat())
			{
				if(theGame.IsFocusModeActive() || theInput.GetActionValue('Focus') > 0.1f)
				{
					if (!ACSGetCActor('ACS_Transformation_Black_Wolf').HasTag('ACS_Black_Wolf_Is_Idle_OOC'))
					{
						event_names.Clear();

						black_wolf_idle_action_index_1 = RandDifferent(this.previous_black_wolf_idle_action_index_1 , 5);

						switch (black_wolf_idle_action_index_1) 
						{
							case 4:
							event_names.PushBack('Sit');
							break;

							case 3:
							event_names.PushBack('Sleep');
							break;

							case 2:
							event_names.PushBack('Roll');
							break;

							case 1:
							event_names.PushBack('Howl');
							break;
							
							default:
							event_names.PushBack('OnGroundAndClean');
							break;
						}
				
						this.previous_black_wolf_idle_action_index_1 = black_wolf_idle_action_index_1;

						((CAnimatedComponent)((CNewNPC)ACSGetCActor('ACS_Transformation_Black_Wolf')).GetComponentByClassName( 'CAnimatedComponent' )).RaiseBehaviorForceEvent(event_names[RandRange(event_names.Size())]);
						
						ACSGetCActor('ACS_Transformation_Black_Wolf').RemoveTag('ACS_Black_Wolf_Is_Idle_IC');

						ACSGetCActor('ACS_Transformation_Black_Wolf').AddTag('ACS_Black_Wolf_Is_Idle_OOC');
					}
				}
			}
			/*
			else
			{
				if (!ACSGetCActor('ACS_Transformation_Black_Wolf').HasTag('ACS_Black_Wolf_Is_Idle_IC'))
				{
					((CAnimatedComponent)((CNewNPC)ACSGetCActor('ACS_Transformation_Black_Wolf')).GetComponentByClassName( 'CAnimatedComponent' )).RaiseBehaviorForceEvent('3StateTaunt');

					ACSGetCActor('ACS_Transformation_Black_Wolf').RemoveTag('ACS_Black_Wolf_Is_Idle_OOC');

					ACSGetCActor('ACS_Transformation_Black_Wolf').AddTag('ACS_Black_Wolf_Is_Idle_IC');
				}
			}
			*/
		}
		else
		{
			if (theInput.GetActionValue('GI_AxisLeftX') != 0 || theInput.GetActionValue('GI_AxisLeftY') != 0 )
			{
				if (ACSGetCActor('ACS_Transformation_Black_Wolf').HasTag('ACS_Black_Wolf_Is_Idle_OOC'))
				{
					//RemoveTimer('BlackWolfIdleSuccessDelay');

					if (!ACSGetCActor('ACS_Transformation_Black_Wolf').HasTag('ACS_Transformation_Black_Wolf_Spawned'))
					{
						((CAnimatedComponent)((CNewNPC)ACSGetCActor('ACS_Transformation_Black_Wolf')).GetComponentByClassName( 'CAnimatedComponent' )).RaiseBehaviorForceEvent('ShadowJump');
					}

					ACSGetCActor('ACS_Transformation_Black_Wolf').RemoveTag('ACS_Transformation_Black_Wolf_Spawned');
					
					ACSGetCActor('ACS_Transformation_Black_Wolf').RemoveTag('ACS_Black_Wolf_Is_Idle_OOC');
				}

				if (ACSGetCActor('ACS_Transformation_Black_Wolf').HasTag('ACS_Black_Wolf_Is_Idle_IC'))
				{
					//RemoveTimer('BlackWolfIdleSuccessDelay');

					if (!ACSGetCActor('ACS_Transformation_Black_Wolf').HasTag('ACS_Transformation_Black_Wolf_Spawned'))
					{
						((CAnimatedComponent)((CNewNPC)ACSGetCActor('ACS_Transformation_Black_Wolf')).GetComponentByClassName( 'CAnimatedComponent' )).RaiseBehaviorForceEvent('ShadowJump');
					}

					ACSGetCActor('ACS_Transformation_Black_Wolf').RemoveTag('ACS_Transformation_Black_Wolf_Spawned');
					
					ACSGetCActor('ACS_Transformation_Black_Wolf').RemoveTag('ACS_Black_Wolf_Is_Idle_IC');
				}
			}

			if (theInput.GetActionValue('GI_AxisLeftY') > 0.1 && theInput.GetActionValue('GI_AxisLeftX') == 0 )
			{
				ACSGetCActor('ACS_Transformation_Black_Wolf').GetMovingAgentComponent().SetGameplayMoveDirection(VecHeading(ACSGetCActor('ACS_Transformation_Black_Wolf').GetHeadingVector()));
				
				ACSTransformBlackWolfMovementAdjust('forward', false);

				if (
				theInput.IsActionPressed('Sprint')
				)
				{
					ACSGetCActor('ACS_Transformation_Black_Wolf').GetMovingAgentComponent().SetGameplayRelativeMoveSpeed(2); 
				}
				else
				{
					ACSGetCActor('ACS_Transformation_Black_Wolf').GetMovingAgentComponent().SetGameplayRelativeMoveSpeed(1); 
				}
			}
			else if (theInput.GetActionValue('GI_AxisLeftY') < -0.1 && theInput.GetActionValue('GI_AxisLeftX') == 0 )
			{
				ACSGetCActor('ACS_Transformation_Black_Wolf').GetMovingAgentComponent().SetGameplayMoveDirection(VecHeading(ACSGetCActor('ACS_Transformation_Black_Wolf').GetHeadingVector()));
						
				ACSTransformBlackWolfMovementAdjust('backward', false);

				if (
				theInput.IsActionPressed('Sprint')
				)
				{
					ACSGetCActor('ACS_Transformation_Black_Wolf').GetMovingAgentComponent().SetGameplayRelativeMoveSpeed(2); 
				}
				else
				{
					ACSGetCActor('ACS_Transformation_Black_Wolf').GetMovingAgentComponent().SetGameplayRelativeMoveSpeed(1); 
				}
			}
			else if (theInput.GetActionValue('GI_AxisLeftX') > 0.1 && theInput.GetActionValue('GI_AxisLeftY') == 0 )
			{
				ACSTransformBlackWolfMovementAdjust('right', false);

				ACSGetCActor('ACS_Transformation_Black_Wolf').GetMovingAgentComponent().SetGameplayMoveDirection(VecHeading(ACSGetCActor('ACS_Transformation_Black_Wolf').GetHeadingVector()));

				if (
				theInput.IsActionPressed('Sprint')
				)
				{
					ACSGetCActor('ACS_Transformation_Black_Wolf').GetMovingAgentComponent().SetGameplayRelativeMoveSpeed(2); 
				}
				else
				{
					ACSGetCActor('ACS_Transformation_Black_Wolf').GetMovingAgentComponent().SetGameplayRelativeMoveSpeed(1); 
				}
			}
			else if (theInput.GetActionValue('GI_AxisLeftX') < -0.1 && theInput.GetActionValue('GI_AxisLeftY') == 0 )
			{
				ACSTransformBlackWolfMovementAdjust('left', false);

				ACSGetCActor('ACS_Transformation_Black_Wolf').GetMovingAgentComponent().SetGameplayMoveDirection(VecHeading(ACSGetCActor('ACS_Transformation_Black_Wolf').GetHeadingVector()));

				if (
				theInput.IsActionPressed('Sprint')
				)
				{
					ACSGetCActor('ACS_Transformation_Black_Wolf').GetMovingAgentComponent().SetGameplayRelativeMoveSpeed(2); 
				}
				else
				{
					ACSGetCActor('ACS_Transformation_Black_Wolf').GetMovingAgentComponent().SetGameplayRelativeMoveSpeed(1); 
				}
			}
			else if (theInput.GetActionValue('GI_AxisLeftY') > 0.1 && theInput.GetActionValue('GI_AxisLeftX') > 0.1 )
			{
				ACSTransformBlackWolfMovementAdjust('forwardright', false);

				ACSGetCActor('ACS_Transformation_Black_Wolf').GetMovingAgentComponent().SetGameplayMoveDirection(VecHeading(ACSGetCActor('ACS_Transformation_Black_Wolf').GetHeadingVector()));

				if (
				theInput.IsActionPressed('Sprint')
				)
				{
					ACSGetCActor('ACS_Transformation_Black_Wolf').GetMovingAgentComponent().SetGameplayRelativeMoveSpeed(2); 
				}
				else
				{
					ACSGetCActor('ACS_Transformation_Black_Wolf').GetMovingAgentComponent().SetGameplayRelativeMoveSpeed(1); 
				}
			}
			else if (theInput.GetActionValue('GI_AxisLeftY') > 0.1 && theInput.GetActionValue('GI_AxisLeftX') < -0.1 )
			{
				ACSTransformBlackWolfMovementAdjust('forwardleft', false);

				ACSGetCActor('ACS_Transformation_Black_Wolf').GetMovingAgentComponent().SetGameplayMoveDirection(VecHeading(ACSGetCActor('ACS_Transformation_Black_Wolf').GetHeadingVector()));

				if (
				theInput.IsActionPressed('Sprint')
				)
				{
					ACSGetCActor('ACS_Transformation_Black_Wolf').GetMovingAgentComponent().SetGameplayRelativeMoveSpeed(2); 
				}
				else
				{
					ACSGetCActor('ACS_Transformation_Black_Wolf').GetMovingAgentComponent().SetGameplayRelativeMoveSpeed(1); 
				}
			}
			else if (theInput.GetActionValue('GI_AxisLeftY') < -0.1 && theInput.GetActionValue('GI_AxisLeftX') > 0.1 )
			{
				ACSTransformBlackWolfMovementAdjust('backright', false);

				ACSGetCActor('ACS_Transformation_Black_Wolf').GetMovingAgentComponent().SetGameplayMoveDirection(VecHeading(ACSGetCActor('ACS_Transformation_Black_Wolf').GetHeadingVector()));

				if (
				theInput.IsActionPressed('Sprint')
				)
				{
					ACSGetCActor('ACS_Transformation_Black_Wolf').GetMovingAgentComponent().SetGameplayRelativeMoveSpeed(2); 
				}
				else
				{
					ACSGetCActor('ACS_Transformation_Black_Wolf').GetMovingAgentComponent().SetGameplayRelativeMoveSpeed(1); 
				}
			}
			else if (theInput.GetActionValue('GI_AxisLeftX') < -0.1 && theInput.GetActionValue('GI_AxisLeftY') < -0.1 )
			{
				ACSTransformBlackWolfMovementAdjust('backleft', false);

				ACSGetCActor('ACS_Transformation_Black_Wolf').GetMovingAgentComponent().SetGameplayMoveDirection(VecHeading(ACSGetCActor('ACS_Transformation_Black_Wolf').GetHeadingVector()));

				if (
				theInput.IsActionPressed('Sprint')
				)
				{
					ACSGetCActor('ACS_Transformation_Black_Wolf').GetMovingAgentComponent().SetGameplayRelativeMoveSpeed(2); 
				}
				else
				{
					ACSGetCActor('ACS_Transformation_Black_Wolf').GetMovingAgentComponent().SetGameplayRelativeMoveSpeed(1); 
				}
			}
		}
	}

	function ACSTransformationBlackWolfRemoveMoveTimers()
	{
		ACSGetCActor('ACS_Transformation_Black_Wolf').EnableCharacterCollisions(true);

		ACSGetCActor('ACS_Transformation_Black_Wolf').ACS_ClearAnimationSpeedMultipliers();

		RemoveTimer('BlackWolfLightAttackDamage');

		RemoveTimer('BlackWolfLightAttackDamageOffsetLeft');

		RemoveTimer('BlackWolfLightAttackDamageOffsetRight');

		RemoveTimer('BlackWolfHeavyAttackDamage');

		RemoveTimer('BlackWolfHeavyAttackDamage_1');
		
		RemoveTimer('BlackWolfHeavyAttackDamageFire');

		RemoveTimer('BlackWolfHeavyAttackDamageFire360');

		RemoveTimer('BlackWolfHeavyAttackDamageFireIndependent');

		RemoveTimer('ACS_black_wolf_dodge_timer_end');

		thePlayer.SetImmortalityMode( AIM_None, AIC_Default, true ); 

		thePlayer.SetIsCurrentlyDodging(false);

		ACSGetCActor('ACS_Transformation_Black_Wolf').StopEffect('shadows_form');

		/*
		if (ACSGetCActor('ACS_Transformation_Black_Wolf').HasTag('ACS_Black_Wolf_Is_Idle_OOC'))
		{
			((CAnimatedComponent)((CNewNPC)ACSGetCActor('ACS_Transformation_Black_Wolf')).GetComponentByClassName( 'CAnimatedComponent' )).RaiseBehaviorForceEvent('ShadowJump');

			ACSGetCActor('ACS_Transformation_Black_Wolf').RemoveTag('ACS_Black_Wolf_Is_Idle_OOC');
		}

		if (thePlayer.IsInCombat())
		{
			if (!ACSGetCActor('ACS_Transformation_Black_Wolf').HasTag('ACS_Black_Wolf_Is_Idle_IC'))
			{
				((CAnimatedComponent)((CNewNPC)ACSGetCActor('ACS_Transformation_Black_Wolf')).GetComponentByClassName( 'CAnimatedComponent' )).RaiseBehaviorForceEvent('3StateTaunt');

				ACSGetCActor('ACS_Transformation_Black_Wolf').AddTag('ACS_Black_Wolf_Is_Idle_IC');
			}
		}
		*/
	}

	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	
	// Giant Transformation Stuff

	var vACS_Spawn_Transformation_Giant: cACS_Spawn_Transformation_Giant;

	function GetTransformationGiantClass() : cACS_Spawn_Transformation_Giant
	{
		vACS_Spawn_Transformation_Giant = new cACS_Spawn_Transformation_Giant in this;

		return vACS_Spawn_Transformation_Giant;
	}

	function ACSTransformationGiantPlayAnim(animation_name: name, blendIn, blendout : float)
	{
		var animatedComponentA			: CAnimatedComponent;

		animatedComponentA = (CAnimatedComponent)((CNewNPC)ACSGetCActor('ACS_Transformation_Giant')).GetComponentByClassName( 'CAnimatedComponent' );	

		animatedComponentA.PlaySlotAnimationAsync ( animation_name, 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(blendIn, blendout) );
	}

	public timer function TransformationGiantTeslaCoil(deltaTime : float , id : int)
	{
		GetTransformationGiantClass().TransformationGiantElectricProjectilesSingle_Engage();
	}

	public timer function TransformationGiantReveal ( dt : float, id : int) 
	{ 
		ACSGetCActor('ACS_Transformation_Giant').SetVisibility(true);
	} 

	public timer function DisableTransformationGiantStart(deltaTime : float , id : int)
	{
		DisableTransformationGiant_Actual();
	}

	function DisableTransformationGiant()
	{
		if ( theGame.IsDialogOrCutscenePlaying() 
		|| thePlayer.IsInNonGameplayCutscene() 
		|| thePlayer.IsInGameplayScene() 
		|| theGame.IsCurrentlyPlayingNonGameplayScene()
		|| theGame.GetPhotomodeEnabled() 
		|| thePlayer.IsInCutsceneIntro() 
		)
		{
			DisableTransformationGiant_Actual();
		}
		else
		{
			ACSGetCActor('ACS_Transformation_Giant').AddTag('ACS_Transformation_Giant_Block_All_Actions');

			ACSTransformationGiantPlayAnim( 'giant_idle_to_sleep_idle_acs_ice_giant', 0.25f, 0.325f);

			if (!ACSGetCActor('ACS_Transformation_Giant').HasTag('ACS_Transformation_Giant_Weapon_Mode'))
			{
				//((CNewNPC)ACSGetCActor('ACS_Transformation_Giant')).SetBehaviorVariable( 'targetAngleDiff', RandRange(1,9), true );
				
				//((CAnimatedComponent)((CNewNPC)ACSGetCActor('ACS_Transformation_Giant')).GetComponentByClassName( 'CAnimatedComponent' )).RaiseBehaviorForceEvent('AttackOverride');
			}

			RemoveTimer('DisableTransformationGiantStart');

			AddTimer('DisableTransformationGiantStart', 2   , false);
		}
	}

	function DisableTransformationGiant_Actual()
	{
		var playerAnimcomp					 : CAnimatedComponent;

		var playerPos, newPlayerPos			: Vector;

		playerAnimcomp = (CAnimatedComponent)thePlayer.GetComponentByClassName('CAnimatedComponent');

		if (
		FactsQuerySum("acs_transformation_activated") > 0
		&& FactsQuerySum("acs_giant_curse_activated") > 0
		)
		{
			FactsRemove("block_geralts_battlecries");

			RemoveTimer('Transformation_Werewolf_Fear');

			GetTransformationCamera().Stop();

			GetTransformationCamera().Destroy();

			theGame.ReleaseNoSaveLock( ACS_Transformation_Savelock_ID );

			thePlayer.BreakAttachment();

			FactsRemove("acs_transformation_activated");

			FactsRemove("acs_giant_curse_activated");
			
			thePlayer.PlayEffectSingle('smoke_explosion');
			thePlayer.StopEffect('smoke_explosion');

			thePlayer.PlayEffectSingle('teleport');
			thePlayer.StopEffect('teleport');

			thePlayer.RemoveBuffImmunity_AllNegative('ACS_Transformation_Immunity_Negative'); 
			thePlayer.RemoveBuffImmunity_AllCritical('ACS_Transformation_Immunity_Critical'); 

			thePlayer.SetVisibility(true);

			thePlayer.EnableCollisions(true);

			thePlayer.SetCanPlayHitAnim(true); 

			if (!thePlayer.IsUsingHorse()&& !thePlayer.IsUsingVehicle()){thePlayer.EnableCharacterCollisions(true); }

			playerAnimcomp.UnfreezePose();

			ACSTransformationGiantRemoveMoveTimers();

			//thePlayer.ACS_SetAnimationSpeedMultiplier( 1  );

			ACSGetCActor('ACS_Transformation_Giant').Teleport(thePlayer.GetWorldPosition() + Vector(0,0,-200));

			ACSGetCActor('ACS_Transformation_Giant').DestroyAfter(0.125);

			FactsRemove("ACS_Transformation_Attached");

			TransformationGiantScale -= TransformationGiantScale;
			TransformationGiantScale = 1;

			thePlayer.UnblockAction(EIAB_CallHorse,				'ACS_Transformation');
			thePlayer.UnblockAction(EIAB_DrawWeapon, 			'ACS_Transformation'); 
			thePlayer.UnblockAction(EIAB_FastTravel, 			'ACS_Transformation');
			thePlayer.UnblockAction(EIAB_InteractionAction, 	'ACS_Transformation');
			thePlayer.UnblockAction(EIAB_Crossbow,				'ACS_Transformation');
			thePlayer.UnblockAction(EIAB_UsableItem,			'ACS_Transformation');
			thePlayer.UnblockAction(EIAB_ThrowBomb,				'ACS_Transformation');
			thePlayer.UnblockAction(EIAB_Parry,					'ACS_Transformation');
			thePlayer.UnblockAction(EIAB_MeditationWaiting,		'ACS_Transformation');
			thePlayer.UnblockAction(EIAB_OpenMeditation,		'ACS_Transformation');
			thePlayer.UnblockAction(EIAB_RadialMenu,			'ACS_Transformation');
			thePlayer.UnblockAction(EIAB_Jump,					'ACS_Transformation');
			thePlayer.UnblockAction(EIAB_QuickSlots, 			'ACS_Transformation');

			playerPos = ACSFixZAxis(thePlayer.GetWorldPosition());

			if( !theGame.GetWorld().NavigationFindSafeSpot( playerPos, 0.3, 0.3 , newPlayerPos ) )
			{
				theGame.GetWorld().NavigationFindSafeSpot( playerPos, 0.3, 4 , newPlayerPos );
				playerPos = newPlayerPos;
			}

			thePlayer.TeleportWithRotation(ACSFixZAxis(playerPos), thePlayer.GetWorldRotation());
		}
	}

	///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	private var TransformationGiantMeshComp 																		: CComponent;
	private var TransformationGiantAnimComp 																		: CAnimatedComponent;

	private var TransformationGiantScale 																			: float;

	default TransformationGiantScale 																				= 1;

	public timer function GrowTransformationGiantTimer ( dt : float, id : int)
	{ 
		if (TransformationGiantScale >= 1.5)
		{
			TransformationGiantScale -= TransformationGiantScale;
			TransformationGiantScale = 1.5;
			ACSGetCActor('ACS_Transformation_Giant').AddTag('ACS_Transformation_Giant_Mega_Sized');
			RemoveTimer('GrowTransformationGiantTimer');
		}
		else
		{
			TransformationGiantMeshComp = ACSGetCActor('ACS_Transformation_Giant').GetComponentByClassName('CMeshComponent');

			TransformationGiantAnimComp = (CAnimatedComponent)ACSGetCActor('ACS_Transformation_Giant').GetComponentByClassName('CAnimatedComponent');

			if (TransformationGiantScale >= 1.5)
			{
				ACSGetCActor('ACS_Transformation_Giant').AddTag('ACS_Transformation_Giant_Mega_Sized');
				RemoveTimer('GrowTransformationGiantTimer');
			}
			else
			{
				TransformationGiantMeshComp.SetScale(Vector(
					
				TransformationGiantScale += 0.001,
				TransformationGiantScale += 0.001,
				TransformationGiantScale += 0.001
		
				));

				TransformationGiantAnimComp.SetScale(Vector(
					
				TransformationGiantScale += 0.001,
				TransformationGiantScale += 0.001,
				TransformationGiantScale += 0.001
		
				));
			}
		}	
	} 

	public timer function ShrinkTransformationGiantTimer ( dt : float, id : int)
	{ 
		if (TransformationGiantScale <= 1)
		{
			TransformationGiantScale -= TransformationGiantScale;
			TransformationGiantScale = 1;
			ACSGetCActor('ACS_Transformation_Giant').RemoveTag('ACS_Transformation_Giant_Mega_Sized');
			RemoveTimer('ShrinkTransformationGiantTimer');
		}
		else
		{
			TransformationGiantMeshComp = ACSGetCActor('ACS_Transformation_Giant').GetComponentByClassName('CMeshComponent');

			TransformationGiantAnimComp = (CAnimatedComponent)ACSGetCActor('ACS_Transformation_Giant').GetComponentByClassName('CAnimatedComponent');

			if (TransformationGiantScale <= 1)
			{
				ACSGetCActor('ACS_Transformation_Giant').RemoveTag('ACS_Transformation_Giant_Mega_Sized');
				RemoveTimer('ShrinkTransformationGiantTimer');
			}
			else
			{
				TransformationGiantMeshComp.SetScale(Vector(
					
				TransformationGiantScale -= 0.001,
				TransformationGiantScale -= 0.001,
				TransformationGiantScale -= 0.001
		
				));

				TransformationGiantAnimComp.SetScale(Vector(
					
				TransformationGiantScale -= 0.001,
				TransformationGiantScale -= 0.001,
				TransformationGiantScale -= 0.001
		
				));
			}
		}	
	} 

	///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	function ACSTransformationGiantMovementAdjust(direction : CName, overrideWhenMovespeedIsZero : bool)
	{
		var targetactor 									: CActor;
		var distGiantJump									: float;

		if (!overrideWhenMovespeedIsZero 
		&& ACSGetCActor('ACS_Transformation_Giant').GetMovingAgentComponent().GetRelativeMoveSpeed() == 0
		&& transformation_giant_position == ACSGetCActor('ACS_Transformation_Giant').GetWorldPosition()
		)
		{
			return;
		}

		movementAdjustorTransformationGiant = ACSGetCActor('ACS_Transformation_Giant').GetMovingAgentComponent().GetMovementAdjustor();

		ticketTransformationGiant = movementAdjustorTransformationGiant.GetRequest( 'ACS_Transformation_Giant_Rotate');
		movementAdjustorTransformationGiant.CancelByName( 'ACS_Transformation_Giant_Rotate' );
		movementAdjustorTransformationGiant.CancelAll();
		ticketTransformationGiant = movementAdjustorTransformationGiant.CreateNewRequest( 'ACS_Transformation_Giant_Rotate' );
		movementAdjustorTransformationGiant.AdjustmentDuration( ticketTransformationGiant, 0.5 );
		movementAdjustorTransformationGiant.MaxRotationAdjustmentSpeed( ticketTransformationGiant, 500000 );

		movementAdjustorTransformationGiantWitcher = thePlayer.GetMovingAgentComponent().GetMovementAdjustor();

		ticketTransformationGiantWitcher = movementAdjustorTransformationGiantWitcher.GetRequest( 'ACS_Transformation_Giant_Witcher_Rotate');
		movementAdjustorTransformationGiantWitcher.CancelByName( 'ACS_Transformation_Giant_Witcher_Rotate' );
		movementAdjustorTransformationGiantWitcher.CancelAll();
		ticketTransformationGiantWitcher = movementAdjustorTransformationGiantWitcher.CreateNewRequest( 'ACS_Transformation_Giant_Witcher_Rotate' );
		movementAdjustorTransformationGiantWitcher.AdjustmentDuration( ticketTransformationGiantWitcher, 0.5 );
		movementAdjustorTransformationGiantWitcher.MaxRotationAdjustmentSpeed( ticketTransformationGiantWitcher, 500000 );

		switch ( direction )
		{
			case 'forward':
			movementAdjustorTransformationGiant.RotateTo( ticketTransformationGiant, VecHeading( theCamera.GetCameraDirection() ) );
			movementAdjustorTransformationGiantWitcher.RotateTo( ticketTransformationGiantWitcher, VecHeading( theCamera.GetCameraDirection() ) );
			break;

			case 'backward':
			movementAdjustorTransformationGiant.RotateTo( ticketTransformationGiant, VecHeading( theCamera.GetCameraDirection() * -5 ) );
			movementAdjustorTransformationGiantWitcher.RotateTo( ticketTransformationGiantWitcher, VecHeading( theCamera.GetCameraDirection() * -5 ) );
			break;

			case 'right':
			movementAdjustorTransformationGiant.RotateTo( ticketTransformationGiant, VecHeading( (theCamera.GetCameraDirection() * 5) + (theCamera.GetCameraRight() * 5) ) );
			movementAdjustorTransformationGiantWitcher.RotateTo( ticketTransformationGiantWitcher, VecHeading( (theCamera.GetCameraDirection() * 5)  + (theCamera.GetCameraRight() * 5) ) );
			break;

			case 'left':
			movementAdjustorTransformationGiant.RotateTo( ticketTransformationGiant, VecHeading( (theCamera.GetCameraDirection() * 5) + (theCamera.GetCameraRight() * -5) ) );
			movementAdjustorTransformationGiantWitcher.RotateTo( ticketTransformationGiantWitcher, VecHeading( (theCamera.GetCameraDirection() * 5) + (theCamera.GetCameraRight() * -5) ) );
			break;

			case 'forwardright':
			movementAdjustorTransformationGiant.RotateTo( ticketTransformationGiant, VecHeading( (theCamera.GetCameraDirection() * 5) + (theCamera.GetCameraRight() * 5) ) );
			movementAdjustorTransformationGiantWitcher.RotateTo( ticketTransformationGiantWitcher, VecHeading( (theCamera.GetCameraDirection() * 5) + (theCamera.GetCameraRight() * 5) ) );
			break;

			case 'forwardleft':
			movementAdjustorTransformationGiant.RotateTo( ticketTransformationGiant, VecHeading( (theCamera.GetCameraDirection() * 5) + (theCamera.GetCameraRight() * -5) ) );
			movementAdjustorTransformationGiantWitcher.RotateTo( ticketTransformationGiantWitcher, VecHeading( (theCamera.GetCameraDirection() * 5) + (theCamera.GetCameraRight() * -5) ) );
			break;

			case 'backright':
			movementAdjustorTransformationGiant.RotateTo( ticketTransformationGiant, VecHeading( (theCamera.GetCameraDirection() * -5) + (theCamera.GetCameraRight() * 5) ) );
			movementAdjustorTransformationGiantWitcher.RotateTo( ticketTransformationGiantWitcher, VecHeading( (theCamera.GetCameraDirection() * -5) + (theCamera.GetCameraRight() * 5) ) );
			break;

			case 'backleft':
			movementAdjustorTransformationGiant.RotateTo( ticketTransformationGiant, VecHeading( (theCamera.GetCameraDirection() * -5) + (theCamera.GetCameraRight() * -5) ) );
			movementAdjustorTransformationGiantWitcher.RotateTo( ticketTransformationGiantWitcher, VecHeading( (theCamera.GetCameraDirection() * -5) + (theCamera.GetCameraRight() * -5) ) );
			break;

			case 'rotatetoenemy':
			if (thePlayer.GetTarget())
			{
				movementAdjustorTransformationGiant.RotateTowards( ticketTransformationGiant, thePlayer.GetTarget() );
			}
			else
			{
				movementAdjustorTransformationGiant.RotateTo( ticketTransformationGiant, VecHeading( theCamera.GetCameraDirection() ) );
			}
			break;

			case 'rotatetoenemyandslide':
			movementAdjustorTransformationGiant.AdjustLocationVertically( ticketTransformationGiant, true );
			movementAdjustorTransformationGiant.ScaleAnimationLocationVertically( ticketTransformationGiant, true );

			if (thePlayer.IsInCombat())
			{
				if (thePlayer.GetTarget())
				{
					movementAdjustorTransformationGiant.RotateTowards( ticketTransformationGiant, ((CActor)(thePlayer.GetTarget())) );

					distGiantJump = (((CMovingPhysicalAgentComponent)((CActor)(thePlayer.GetTarget())).GetMovingAgentComponent()).GetCapsuleRadius() 
					+ ((CMovingPhysicalAgentComponent)ACSGetCActor('ACS_Transformation_Giant').GetMovingAgentComponent()).GetCapsuleRadius());

					movementAdjustorTransformationGiant.RotateTowards( ticketTransformationGiant, ((CActor)(thePlayer.GetTarget())) );

					movementAdjustorTransformationGiant.SlideTowards( ticketTransformationGiant, ((CActor)(thePlayer.GetTarget())), distGiantJump, distGiantJump );
				}
				else
				{
					movementAdjustorTransformationGiant.RotateTo( ticketTransformationGiant, VecHeading( theCamera.GetCameraDirection() ) );

					movementAdjustorTransformationGiant.SlideTo( ticketTransformationGiant, ACSGetCActor('ACS_Transformation_Giant').GetWorldPosition() + ACSGetCActor('ACS_Transformation_Giant').GetWorldForward() * 5);
				}
			}
			else
			{
				movementAdjustorTransformationGiant.RotateTo( ticketTransformationGiant, VecHeading( theCamera.GetCameraDirection() ) );

				movementAdjustorTransformationGiant.SlideTo( ticketTransformationGiant, ACSGetCActor('ACS_Transformation_Giant').GetWorldPosition() + ACSGetCActor('ACS_Transformation_Giant').GetWorldForward() * 5);
			}
			break;

			case 'cancel':
			movementAdjustorTransformationGiant.CancelAll();
			movementAdjustorTransformationGiantWitcher.CancelAll();
			break;

			default:
			movementAdjustorTransformationGiant.CancelAll();
			movementAdjustorTransformationGiantWitcher.CancelAll();
			break;
		}
	}

	private var transformation_giant_light_attack_index_1																									: int;
	default transformation_giant_light_attack_index_1 																										= -1;

	private var previous_transformation_giant_light_attack_index_1																							: int;
	default previous_transformation_giant_light_attack_index_1 																								= -1;

	private var transformation_giant_light_attack_index_2																									: int;
	default transformation_giant_light_attack_index_2 																										= -1;

	private var previous_transformation_giant_light_attack_index_2																							: int;
	default previous_transformation_giant_light_attack_index_2 																								= -1;

	private var transformation_giant_light_attack_index_3																									: int;
	default transformation_giant_light_attack_index_3 																										= -1;

	private var previous_transformation_giant_light_attack_index_3																							: int;
	default previous_transformation_giant_light_attack_index_3 																								= -1;

	private var transformation_giant_heavy_attack_index_1																									: int;
	default transformation_giant_heavy_attack_index_1 																										= -1;


	event OnMoveForward ( action : SInputAction )
	{
		if (ACS_New_Replacers_Female_Active()
		|| thePlayer.HasTag('ACS_In_Ciri_Special_Attack')
		|| thePlayer.HasTag('ACS_In_Dance_Of_Wrath')
		|| thePlayer.IsInsideInteraction()
		|| FactsQuerySum("ACS_Enter_Unconscious_Start") > 0
		|| thePlayer.GetPlayerAction() != PEA_None
		|| !thePlayer.IsActionAllowed(EIAB_Movement)
		|| thePlayer.HasBuff(EET_AirDrain)
		|| thePlayer.HasBuff(EET_Choking)
		|| thePlayer.HasBuff(EET_Drowning)
		|| thePlayer.IsInGameplayScene()
		|| theGame.IsFading()
		|| theGame.IsBlackscreen()
		|| thePlayer.IsSwimming()
		|| thePlayer.IsDiving()
		|| thePlayer.GetBehaviorVariable('alternateWalk') != 0
		|| thePlayer.GetBehaviorVariable('proudWalk') != 0
		//|| !theInput.LastUsedPCInput()
		|| thePlayer.HasTag('ACS_IsPerformingFinisher')
		|| thePlayer.HasTag('ACS_IsPerformingCombatDismember')
		)
		{
			return false;
		}

		if (thePlayer.HasTag('ACS_Special_Dodge') && thePlayer.IsActionAllowed(EIAB_Movement) && !thePlayer.IsCurrentlyDodging() )
		{
			action_interrupt_on_movement(); //ACS
			
			thePlayer.RemoveTag('ACS_Special_Dodge');
		}

		if ( ACS_Settings_Main_Bool('acs_main_settings','acs_mod_enabled', true) 
		&& thePlayer.IsActionAllowed(EIAB_Movement) 
		)
		{
			if ( action.value > 0.1f )
			{
				if (FactsQuerySum("acs_transformation_activated") > 0
				|| thePlayer.IsUsingVehicle())
				{
					return false;
				}

				if 
				(
				(
				ACS_CombatToExplorationCheck()
				&& theInput.GetActionValue('Sprint') > 0.1f 
				&& theInput.GetActionValue('Jump') == 0 
				&& thePlayer.GetSprintingTime() <= 0.2f 
				&& thePlayer.substateManager.GetStateTimeF() > 1
				&& thePlayer.substateManager.GetStateCur() != 'Sprint'
				&& thePlayer.substateManager.GetStateCur() != 'Vault'
				&& thePlayer.substateManager.GetStateCur() != 'Climb' 
				&& thePlayer.substateManager.GetStateCur() != 'Jump' 
				&& thePlayer.substateManager.GetStateCur() != 'Ragdoll' 
				&& thePlayer.substateManager.GetStateCur() != 'Slide' 
				&& thePlayer.substateManager.GetStateCur() != 'StartFalling' 
				&& thePlayer.substateManager.GetStateCur() != 'IdleJump' 
				&& thePlayer.substateManager.GetStateCur() != 'AirCollision' 
				&& thePlayer.substateManager.GetStateCur() != 'PrepareJump' 
				&& thePlayer.substateManager.GetStateCur() != 'TransitionPrepareToJump' 
				&& thePlayer.substateManager.GetStateCur() != 'TurnToJump' 
				&& thePlayer.substateManager.GetStateCur() != 'Roll' 
				&& thePlayer.substateManager.GetStateCur() != 'CombatExploration' 
				&& thePlayer.substateManager.GetStateCur() != 'Land'
				&& thePlayer.IsActionAllowed(EIAB_Movement)
				&& !thePlayer.IsInCombat() 
				&& !thePlayer.IsInCombatState()
				&& !thePlayer.IsInCombatAction()
				&& !thePlayer.IsThreatened()
				)
				)
				{
					BruxaDash_NEW();
				}
				else
				{
					if (thePlayer.HasTag('ACS_Special_Dodge') && thePlayer.IsActionAllowed(EIAB_Movement) && !thePlayer.IsCurrentlyDodging() )
					{
						action_interrupt_on_movement(); //ACS
						
						thePlayer.RemoveTag('ACS_Special_Dodge');
					}

					if (!thePlayer.IsInCombat())
					{
						if(thePlayer.HasTag('ACS_Manual_Combat_Control'))
						{
							thePlayer.RemoveTag('ACS_Manual_Combat_Control');
						} 
						
						RemoveTimer('Manual_Combat_Control_Remove'); 
					}
				}
			}
			else if ( action.value < -0.1f )
			{
				if (FactsQuerySum("acs_transformation_activated") > 0
				|| thePlayer.IsUsingVehicle())
				{
					return false;
				}

				if (thePlayer.HasTag('ACS_Special_Dodge') && thePlayer.IsActionAllowed(EIAB_Movement) && !thePlayer.IsCurrentlyDodging() )
				{
					action_interrupt_on_movement(); //ACS
					
					thePlayer.RemoveTag('ACS_Special_Dodge');
				}

				if (!thePlayer.IsInCombat())
				{
					if(thePlayer.HasTag('ACS_Manual_Combat_Control'))
					{
						thePlayer.RemoveTag('ACS_Manual_Combat_Control');
					} 
					
					RemoveTimer('Manual_Combat_Control_Remove'); 
				}
			}
			else if ( action.value == 0 )
			{	
				if (FactsQuerySum("acs_transformation_activated") > 0
				|| thePlayer.IsUsingVehicle())
				{
					return false;
				}
			}
		}
	}

	event OnMoveSide ( action : SInputAction )
	{
		if(FactsQuerySum("ACS_AutoSail_Active") > 0)
		{
			theInput.IgnoreGameInput( 'GI_Accelerate', false );
			theInput.IgnoreGameInput( 'GI_Decelerate', false );
			theInput.IgnoreGameInput( 'GI_AxisLeftY', false );

			return false;
		}

		if (ACS_New_Replacers_Female_Active()
		|| thePlayer.HasTag('ACS_In_Ciri_Special_Attack')
		|| thePlayer.HasTag('ACS_In_Dance_Of_Wrath')
		|| thePlayer.IsInsideInteraction()
		|| FactsQuerySum("ACS_Enter_Unconscious_Start") > 0
		|| thePlayer.GetPlayerAction() != PEA_None
		|| !thePlayer.IsActionAllowed(EIAB_Movement)
		|| thePlayer.HasBuff(EET_AirDrain)
		|| thePlayer.HasBuff(EET_Choking)
		|| thePlayer.HasBuff(EET_Drowning)
		|| thePlayer.IsInGameplayScene()
		|| theGame.IsFading()
		|| theGame.IsBlackscreen()
		|| thePlayer.IsSwimming()
		|| thePlayer.IsDiving()
		|| thePlayer.GetBehaviorVariable('alternateWalk') != 0
		|| thePlayer.GetBehaviorVariable('proudWalk') != 0
		//|| !theInput.LastUsedPCInput()
		|| thePlayer.HasTag('ACS_IsPerformingFinisher')
		|| thePlayer.HasTag('ACS_IsPerformingCombatDismember')
		)
		{
			return false;
		}

		if (thePlayer.HasTag('ACS_Special_Dodge') && thePlayer.IsActionAllowed(EIAB_Movement) && !thePlayer.IsCurrentlyDodging() )
		{
			action_interrupt_on_movement(); //ACS
			
			thePlayer.RemoveTag('ACS_Special_Dodge');
		}

		if ( ACS_Settings_Main_Bool('acs_main_settings','acs_mod_enabled', true) 
		&& thePlayer.IsActionAllowed(EIAB_Movement) 
		&& thePlayer.IsAnyWeaponHeld()
		&& !thePlayer.IsWeaponHeld('fist')
		)
		{
			if ( action.value > 0.1f )
			{
				if (FactsQuerySum("acs_transformation_activated") > 0
				|| thePlayer.IsUsingVehicle())
				{
					return false;
				}

				if (thePlayer.HasTag('ACS_Special_Dodge') && thePlayer.IsActionAllowed(EIAB_Movement) && !thePlayer.IsCurrentlyDodging())
				{
					action_interrupt_on_movement(); //ACS

					thePlayer.RemoveTag('ACS_Special_Dodge');
				}

				if (!thePlayer.IsInCombat())
				{
					if(thePlayer.HasTag('ACS_Manual_Combat_Control'))
					{
						thePlayer.RemoveTag('ACS_Manual_Combat_Control');
					} 
					
					RemoveTimer('Manual_Combat_Control_Remove');
				}
			}
			else if ( action.value < -0.1f )
			{
				if (FactsQuerySum("acs_transformation_activated") > 0
				|| thePlayer.IsUsingVehicle())
				{
					return false;
				}

				if (thePlayer.HasTag('ACS_Special_Dodge') && thePlayer.IsActionAllowed(EIAB_Movement) && !thePlayer.IsCurrentlyDodging())
				{
					action_interrupt_on_movement(); //ACS
					
					thePlayer.RemoveTag('ACS_Special_Dodge');
				}

				if (!thePlayer.IsInCombat())
				{
					if(thePlayer.HasTag('ACS_Manual_Combat_Control'))
					{
						thePlayer.RemoveTag('ACS_Manual_Combat_Control');
					} 
					
					RemoveTimer('Manual_Combat_Control_Remove');
				}
			}
			else if ( action.value == 0 )
			{	
				if (FactsQuerySum("acs_transformation_activated") > 0
				|| thePlayer.IsUsingVehicle())
				{
					return false;
				}
			}
		}
	}

	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	timer function AutoSailToggle( time : float , id : int )
	{
		if (theInput.GetActionValue( 'GI_AxisLeftY' ) == 0 && theInput.GetActionValue( 'GI_AxisLeftX' ) == 0)
		{
			if(FactsQuerySum("ACS_AutoSail_Active") <= 0)
			{
				GetACSStorage().acs_deleteOnelinerByTag("ACS_AutoSailNotification");

				ACS_Oneliner(
				(new ACS_Oneliner_TagBuilder in theGame)
				.tag("font")
				.attr("size", "22")
				.attr("color", "#ffffff")
				.text(GetLocStringById(2116581133) + "<br/>" + GetLocStringById(2118449902))
				, thePlayer.GetUsedVehicle(), "ACS_AutoSailNotification", Vector(0,0,3), 1.5);

				GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_AutoSailNotification", 100);

				GetACSStorage().acs_setScaleForOnelinerByTag("ACS_AutoSailNotification", 100, 100, 100);

				theInput.IgnoreGameInput( 'GI_Accelerate', true );
				theInput.IgnoreGameInput( 'GI_Decelerate', true );
				theInput.IgnoreGameInput( 'GI_AxisLeftY', true );

				if(FactsQuerySum("ACS_Ship_Crew_Sing") <= 0)
				{
					FactsAdd("ACS_Ship_Crew_Sing", 1, -1);
				}
				else
				{
					FactsRemove("ACS_Ship_Crew_Sing");
				}

				FactsAdd("ACS_AutoSail_Active", 1, -1);
			}
		}
	}

	event OnAccelerate ( action : SInputAction )
	{
		if (!thePlayer.IsUsingVehicle()
		)
		{
			return false;
		}

		if ( IsPressed(action) )
		{
			RemoveTimer('AutoSailToggle');

			if(FactsQuerySum("ACS_AutoSail_Active") <= 0)
			{
				if (theInput.GetActionValue( 'GI_AxisLeftY' ) == 0 && theInput.GetActionValue( 'GI_AxisLeftX' ) == 0)
				{
					AddTimer('AutoSailToggle', 3 , false);
				}
			}
			else if(FactsQuerySum("ACS_AutoSail_Active") > 0)
			{
				GetACSStorage().acs_deleteOnelinerByTag("ACS_AutoSailNotification");

				ACS_Oneliner(
				(new ACS_Oneliner_TagBuilder in theGame)
				.tag("font")
				.attr("size", "22")
				.attr("color", "#ffffff")
				.text(GetLocStringById(2116581133) + "<br/>" + GetLocStringById(2118449903))
				, thePlayer.GetUsedVehicle(), "ACS_AutoSailNotification", Vector(0,0,3), 1.5);

				GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_AutoSailNotification", 100);

				GetACSStorage().acs_setScaleForOnelinerByTag("ACS_AutoSailNotification", 100, 100, 100);

				FactsRemove("ACS_AutoSail_Active");
			}
		}

		if ( IsReleased( action ) )
		{
			RemoveTimer('AutoSailToggle');

		}
	}

	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


	timer function RemoveACSAirTime( time : float , id : int )
	{
		if (thePlayer.HasTag('ACS_Air_Time'))
		{
			RemoveTimer('Air_Time_Movement_Adjust_Delay');

			thePlayer.BlockAllActions( 'ACS_Air_Time_Init', false );

			thePlayer.EnableCollisions(true);

			thePlayer.RaiseEvent('ACS_FeetAdditiveEnd');

			thePlayer.UnblockAction( EIAB_CallHorse,			'ACS_Air_Time');
			thePlayer.UnblockAction( EIAB_DrawWeapon, 		'ACS_Air_Time');
			thePlayer.UnblockAction( EIAB_FastTravel, 		'ACS_Air_Time');
			thePlayer.UnblockAction( EIAB_InteractionAction, 	'ACS_Air_Time');
			thePlayer.UnblockAction( EIAB_UsableItem,			'ACS_Air_Time');
			thePlayer.UnblockAction( EIAB_MeditationWaiting,	'ACS_Air_Time');
			thePlayer.UnblockAction( EIAB_OpenMeditation,		'ACS_Air_Time');
			thePlayer.UnblockAction( EIAB_RadialMenu,			'ACS_Air_Time');
			thePlayer.UnblockAction( EIAB_Movement,			'ACS_Air_Time');
			thePlayer.UnblockAction( EIAB_QuickSlots, 		'ACS_Air_Time');

			thePlayer.RemoveTag('ACS_Air_Time');
		}
	}

	function ClearJumpTypes()
	{
		if (FactsQuerySum("ACS_Jump_Type_Idle") > 0)
		{
			FactsRemove("ACS_Jump_Type_Idle");
		}

		if (FactsQuerySum("ACS_Jump_Type_Walk") > 0)
		{
			FactsRemove("ACS_Jump_Type_Walk");
		}

		if (FactsQuerySum("ACS_Jump_Type_Run") > 0)
		{
			FactsRemove("ACS_Jump_Type_Run");
		}

		if (FactsQuerySum("ACS_Jump_Type_Sprint") > 0)
		{
			FactsRemove("ACS_Jump_Type_Sprint");
		}
	}

	var last_glide_time									: float;

	timer function DoubleJumpSlowMo( time : float , id : int )
	{
		if ( FactsQuerySum("ACS_Double_Jump_SlowMo") <= 0 )
		{
			ACS_SlowMoAdjustable(0.125, 0.5);

			thePlayer.RaiseEvent('ACS_TorsoBend');

			if (RandF() < 0.5)
			{
				thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( 'man_geralt_sword_dodge_jump_rp_f_01', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0.375f, 1.0f) );

				//thePlayer.RaiseEvent('ACS_Dodge01');
			}
			else
			{
				thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( 'man_geralt_sword_dodge_jump_rp_f_02', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0.375f, 1.0f) );

				//thePlayer.RaiseEvent('ACS_Dodge02');
			}

			FactsAdd("ACS_Double_Jump_SlowMo", 1, -1);
		}
	}

	private timer function FastSprintFlipEnd ( dt : float, id : int )
	{
		var movementAdjustor: CMovementAdjustor;
		var ticket: SMovementAdjustmentRequestTicket;

		//thePlayer.RaiseEvent('ACS_RunningForwardFlip');

		movementAdjustor = thePlayer.GetMovingAgentComponent().GetMovementAdjustor();
		movementAdjustor.CancelAll();

		ticket = movementAdjustor.CreateNewRequest( 'ACS_Fast_Sprint_Flip_End' );
					
		movementAdjustor.AdjustmentDuration( ticket, 0.75 );

		movementAdjustor.ShouldStartAt(ticket, thePlayer.GetWorldPosition());
		movementAdjustor.MaxRotationAdjustmentSpeed( ticket, 5000000 );
		movementAdjustor.MaxLocationAdjustmentSpeed( ticket, 5000000 );

		movementAdjustor.RotateTo( ticket, VecHeading( theCamera.GetCameraDirection() ));

		movementAdjustor.SlideTo( ticket, ( ACSFixZAxis(GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetWorldForward() * 6 ) + theCamera.GetCameraDirection() + GetWorldForward() * 6) );
		
	}

	event OnJump ( action : SInputAction )
	{
		var movementAdjustor: CMovementAdjustor;
		var ticket_rotate: SMovementAdjustmentRequestTicket;
		var pos : Vector;
		var dist, double_jump_dist : float;
		var camera 	: CCustomCamera;

		if (FactsQuerySum("ACS_In_Meditation") > 0
		|| meditation_block
		)
		{
			return false;
		}

		if (thePlayer.IsInGameplayScene()
		|| theGame.IsFading()
		|| theGame.IsBlackscreen()
		)
		{
			return false;
		}

		if (thePlayer.HasBuff(EET_AirDrain)
		|| thePlayer.HasBuff(EET_Choking)
		|| thePlayer.HasBuff(EET_Drowning)
		)
		{
			return false;
		}

		if ( ACS_Settings_Main_Bool('acs_main_settings','acs_mod_enabled', true) )
		{
			if (FactsQuerySum("ACS_Enter_Unconscious_Start") > 0)
			{
				return false;
			}

			if (FactsQuerySum("ACS_In_Meditation") > 0)
			{
				return false;
			}

			if (FactsQuerySum("acs_transformation_activated") > 0)
			{
				return false;
			}

			if (ACSGetCEntity('ACS_Aim_Impact_Entity'))
			{
				ACSGetCEntity('ACS_Aim_Impact_Entity').Destroy();
			}

			if (fast_sprint_activated)
			{
				thePlayer.RaiseEvent('ACS_RunningForwardFlip');

				RemoveTimer('FastSprintFlipEnd');
				AddTimer('FastSprintFlipEnd', 0.25 , false);
			}

			thePlayer.ACS_ClearAnimationSpeedMultipliers();

			thePlayer.RemoveTag('ACS_Manual_Combat_Control');

			if ( IsReleased( action ) )
			{
				if (FactsQuerySum("ACS_Has_Double_Jumped") > 0)
				{
					RemoveTimer('DoubleJumpSlowMo');

					RemoveTimer('RemoveACSSlowmo');
			
					theGame.RemoveTimeScale( theGame.GetTimescaleSource(ETS_InstantKill) );

					(thePlayer.GetMovingAgentComponent()).SetEnabledFeetIK(false,0);
					(thePlayer.GetMovingAgentComponent()).SetEnabledSlidingOnSlopeIK( false );
				}

				if(FactsQuerySum("ACS_Is_Gliding") > 0)
				{
					Glide_Stop();
				}

				thePlayer.RaiseEvent('ACS_ForceHandClosedREnd');

				if (!thePlayer.HasTag('ACS_Dual_Wield_Active') && !ACSGetCEntity('ACS_Viper_Dagger_L')){thePlayer.RaiseEvent('ACS_ForceHandClosedLEnd');}
				
				RemoveTimer('Air_Time_Trigger_Delay');
			} 

			if ( IsPressed(action) )
			{
				if( Flying_Target_Check()
				&& !thePlayer.HasTag('ACS_Air_Time')
				&& ACS_Settings_Main_Bool('acs_combat_main_settings','acs_air_time', true)
				&& theInput.IsActionPressed('Sprint')
				&& !getIsInCombatSlide
				)
				{

					RemoveTimer('Air_Time_Trigger_Delay');
					AddTimer('Air_Time_Trigger_Delay', 0.5 , false);
				}
				else
				{
					RemoveTimer('Air_Time_Trigger_Delay');

					if (thePlayer.HasTag('ACS_Air_Time'))
					{
						RemoveTimer('Air_Time_Movement_Adjust_Delay');

						thePlayer.BlockAllActions( 'ACS_Air_Time_Init', false );

						thePlayer.RaiseEvent('ACS_FeetAdditiveEnd');

						thePlayer.EnableCollisions(true);

						thePlayer.UnblockAction( EIAB_CallHorse,			'ACS_Air_Time');
						thePlayer.UnblockAction( EIAB_DrawWeapon, 		'ACS_Air_Time');
						thePlayer.UnblockAction( EIAB_FastTravel, 		'ACS_Air_Time');
						thePlayer.UnblockAction( EIAB_InteractionAction, 	'ACS_Air_Time');
						thePlayer.UnblockAction( EIAB_UsableItem,			'ACS_Air_Time');
						thePlayer.UnblockAction( EIAB_MeditationWaiting,	'ACS_Air_Time');
						thePlayer.UnblockAction( EIAB_OpenMeditation,		'ACS_Air_Time');
						thePlayer.UnblockAction( EIAB_RadialMenu,			'ACS_Air_Time');
						thePlayer.UnblockAction( EIAB_Movement,			'ACS_Air_Time');
						thePlayer.UnblockAction( EIAB_QuickSlots, 		'ACS_Air_Time');

						thePlayer.RemoveTag('ACS_Air_Time');
					}

					if (!ACS_Settings_Main_Bool('acs_jump_settings','acs_double_jump', true) 
					)
					{
						if (
						ACS_Settings_Main_Bool('acs_jump_settings','acs_jump_glide', false) 
						|| ACS_Vampire_Claws_Access()
						|| ACS_Armor_Set_Check('acs_armor', false)
						)
						{
							if (thePlayer.IsInAir() 
							)
							{
								Glide_Start();
							}
						}

						return false;
					}
					
					if ( FactsQuerySum("ACS_Has_Double_Jumped_Glide_Init") > 0 )
					{
						if (
						ACS_Settings_Main_Bool('acs_jump_settings','acs_jump_glide', false) 
						|| ACS_Vampire_Claws_Access()
						|| ACS_Armor_Set_Check('acs_armor', false)
						)
						{
							Glide_Start();
						}

						FactsRemove("ACS_Has_Double_Jumped_Glide_Init");
					}
					else
					{
						if (ACS_Settings_Main_Bool('acs_jump_settings','acs_double_jump', true) 
						&& FactsQuerySum("ACS_Has_Double_Jumped") <= 0
						)
						{
							if (thePlayer.IsInAir() 
							&& FactsQuerySum("ACS_Is_Gliding") <= 0
							&& thePlayer.GetPlayerAction() == PEA_None
							&& thePlayer.GetBehaviorVariable('inJumpState') != 0
							)
							{
								RemoveTimer('DoubleJumpRollDelay');

								action_interrupt_on_jump(); //ACS

								if (thePlayer.IsAnyWeaponHeld())
								{
									RemoveTimer('CombatTauntDelay');
									RemoveTimer('SwordTauntRunningSwitchSecondary'); 
									RemoveTimer('SwordTauntRunningSwitchSecondaryWeaponBlood'); 
									AddTimer('SwordTauntRunningSwitchSecondary', 0.01  , false); 
								}
								else
								{
									thePlayer.RaiseEvent('ACS_ForceHandVampireClawsR');
								}

								ACS_Tutorial_Display_Check('ACS_Double_Jump_Tutorial_Shown');

								theGame.GetBehTreeReactionManager().CreateReactionEventIfPossible( thePlayer, 'CastSignAction', 1, 1.75f, -1.f, -1, true );

								if (ACS_Armor_Set_Check('acs_armor', false)
								|| thePlayer.HasTag('acs_vampire_claws_equipped')
								|| ACS_Vampire_Claws_Access()
								)
								{
									thePlayer.PlayEffectSingle('vampire_magic_step_r');
									thePlayer.StopEffect('vampire_magic_step_r');

									thePlayer.PlayEffectSingle('vampire_magic_step_l');
									thePlayer.StopEffect('vampire_magic_step_l');
								}
								else
								{
									thePlayer.PlayEffectSingle('odim_magic_step_r');
									thePlayer.StopEffect('odim_magic_step_r');

									thePlayer.PlayEffectSingle('odim_magic_step_l');
									thePlayer.StopEffect('odim_magic_step_l');
								}

								thePlayer.SoundEvent("monster_dettlaff_vampire_movement_whoosh_large");

								thePlayer.SoundEvent("sign_aard_warmup");

								RemoveTimer('DoubleJumpSlowMo');
								AddTimer('DoubleJumpSlowMo', 0.25f , false);

								AardLightIconFeet();

								movementAdjustor = thePlayer.GetMovingAgentComponent().GetMovementAdjustor();

								ticket_rotate = movementAdjustor.GetRequest( 'ACS_Double_Jump');
								movementAdjustor.CancelByName( 'ACS_Double_Jump' );
								movementAdjustor.CancelAll();
								
								ticket_rotate = movementAdjustor.CreateNewRequest( 'ACS_Double_Jump');
								movementAdjustor.MaxRotationAdjustmentSpeed( ticket_rotate, 5000000 );
								movementAdjustor.MaxLocationAdjustmentSpeed( ticket_rotate, 5000000 );
								movementAdjustor.AdjustmentDuration( ticket_rotate, 0.25f );
								movementAdjustor.AdjustLocationVertically( ticket_rotate, true );

								if (FactsQuerySum("ACS_Jump_Type_Idle") > 0)
								{
									double_jump_dist = 1;
								}
								else if (FactsQuerySum("ACS_Jump_Type_Walk") > 0)
								{
									double_jump_dist = 3;
								}
								else if (FactsQuerySum("ACS_Jump_Type_Run") > 0)
								{
									double_jump_dist = 5;
								}
								else if (FactsQuerySum("ACS_Jump_Type_Sprint") > 0)
								{
									double_jump_dist = 7;
								}
								else
								{
									double_jump_dist = 1;
								}

								camera = (CCustomCamera)theCamera.GetTopmostCameraObject();

								if(	AbsF(AngleDistance(camera.GetHeading(), thePlayer.GetHeading())) > 45)
								{
									movementAdjustor.RotateTo( ticket_rotate, VecHeading( thePlayer.GetHeadingVector() ) );

									pos = thePlayer.GetWorldPosition() + thePlayer.GetWorldForward() * double_jump_dist;
								}
								else
								{
									movementAdjustor.RotateTo( ticket_rotate, VecHeading( theCamera.GetCameraDirection() ) );
						
									pos = theCamera.GetCameraPosition() + theCamera.GetCameraDirection() * (double_jump_dist + 5);
								}

								pos.Z += 2.5 + double_jump_dist * 0.125;

								movementAdjustor.SlideTo(ticket_rotate, pos);

								//thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( 'bruxa_jump_up_start_ACS', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0, 1.0f) );

								if (thePlayer.IsAnyWeaponHeld())
								{
									if (RandF() < 0.5)
									{
										thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( 'jump_run_lf_sword', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0, 1.0f) );

										//thePlayer.RaiseEvent('ACS_Dodge01');
									}
									else
									{
										thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( 'jump_run_rf_sword', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0, 1.0f) );

										//thePlayer.RaiseEvent('ACS_Dodge02');
									}
								}
								else
								{
									if (RandF() < 0.5)
									{
										thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( 'jump_run_lf', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0, 1.0f) );

										//thePlayer.RaiseEvent('ACS_Dodge01');
									}
									else
									{
										thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( 'jump_run_rf', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0, 1.0f) );

										//thePlayer.RaiseEvent('ACS_Dodge02');
									}
								}
								

								thePlayer.SoundEvent("cmb_weapon_swoosh_light_slow");

								thePlayer.SoundEvent("monster_panther_movement_whoosh_jump");

								thePlayer.SoundEvent("scene_grunt_vo_attack_long_ALWAYS");
					
								thePlayer.PlayEffectSingle('acs_fast_sprint_trail');
								thePlayer.StopEffect('acs_fast_sprint_trail');

								ClearJumpTypes();

								FactsAdd("ACS_Has_Double_Jumped_Glide_Init", 1, -1);

								FactsAdd("ACS_Has_Double_Jumped", 1, -1);
							}
						}
					}
				}
			}
		}
	}

	function Glide_Start()
	{
		var ent, ent_1, ent_2, ent_3, ent_4, wings_torso_anchor_1					: CEntity;
		var anchor_temp																: CEntityTemplate;
		var bonePosition															: Vector;
		var boneRotation															: EulerAngles;

		if (FactsQuerySum("ACS_Is_Gliding") <= 0
		&& theGame.GetEngineTimeAsSeconds() - last_glide_time > 2
		)
		{
			last_glide_time = theGame.GetEngineTimeAsSeconds();

			((CAnimatedComponent)(thePlayer).GetComponentByClassName('CAnimatedComponent')).UnfreezePoseFadeOut(0.1);

			((CAnimatedComponent)(thePlayer).GetComponentByClassName('CAnimatedComponent')).UnfreezePose();

			ClearJumpTypes();

			thePlayer.RaiseEvent('ACS_DodgeAdditiveEnd');

			(thePlayer.GetMovingAgentComponent()).SetEnabledFeetIK(false,0);
			(thePlayer.GetMovingAgentComponent()).SetEnabledSlidingOnSlopeIK( false );
			
			if (thePlayer.IsAnyWeaponHeld()
			&& !thePlayer.IsWeaponHeld('fist')
			)
			{
				RemoveTimer('CombatTauntDelay');
				RemoveTimer('SwordTauntRunningSwitchSecondary'); 
				RemoveTimer('SwordTauntRunningSwitchSecondaryWeaponBlood'); 
				AddTimer('SwordTauntRunningSwitchSecondary', 0.01 , false); 
			}

			RemoveTimer('DoubleJumpSlowMo');

			RemoveTimer('RemoveACSSlowmo');

			theGame.RemoveTimeScale( theGame.GetTimescaleSource(ETS_InstantKill) );

			thePlayer.RaiseEvent('ACS_TorsoBendReset');

			if (!thePlayer.HasTag('ACS_Dual_Wield_Active') && !ACSGetCEntity('ACS_Viper_Dagger_L')){thePlayer.RaiseEvent('ACS_ForceHandClosedLEnd');}

			if (thePlayer.IsAnyWeaponHeld()
			&& !thePlayer.IsWeaponHeld('fist')
			)
			{
				thePlayer.RaiseEvent('ACS_ForceHandClosedR');
			}
			else
			{
				thePlayer.RaiseEvent('ACS_ForceHandClosedREnd');
			}

			FactsRemove("ACS_Double_Jump_SlowMo");

			FactsRemove("ACS_Has_Air_Dashed");

			FactsRemove("ACS_Has_Double_Jumped");

			FactsRemove("ACS_Has_Double_Jumped_Glide_Init");
			
			theGame.CreateNoSaveLock( "ACS_Glide_Active", ACS_Glide_Savelock_ID, false, false );

			ACS_Tutorial_Display_Check('ACS_Glide_Tutorial_Shown');

			thePlayer.BlockAction( EIAB_Crossbow, 			'ACS_Gliding');
			thePlayer.BlockAction( EIAB_CallHorse,			'ACS_Gliding');
			thePlayer.BlockAction( EIAB_Signs, 				'ACS_Gliding');
			thePlayer.BlockAction( EIAB_DrawWeapon, 		'ACS_Gliding');
			thePlayer.BlockAction( EIAB_FastTravel, 		'ACS_Gliding');
			thePlayer.BlockAction( EIAB_Fists, 				'ACS_Gliding');
			thePlayer.BlockAction( EIAB_InteractionAction, 	'ACS_Gliding');
			thePlayer.BlockAction( EIAB_UsableItem,			'ACS_Gliding');
			thePlayer.BlockAction( EIAB_ThrowBomb,			'ACS_Gliding');
			thePlayer.BlockAction( EIAB_SwordAttack,		'ACS_Gliding');
			thePlayer.BlockAction( EIAB_LightAttacks,		'ACS_Gliding');
			thePlayer.BlockAction( EIAB_HeavyAttacks,		'ACS_Gliding');
			thePlayer.BlockAction( EIAB_SpecialAttackLight,	'ACS_Gliding');
			thePlayer.BlockAction( EIAB_SpecialAttackHeavy,	'ACS_Gliding');
			thePlayer.BlockAction( EIAB_Dodge,				'ACS_Gliding');
			thePlayer.BlockAction( EIAB_Roll,				'ACS_Gliding');
			thePlayer.BlockAction( EIAB_Parry,				'ACS_Gliding');
			thePlayer.BlockAction( EIAB_MeditationWaiting,	'ACS_Gliding');
			thePlayer.BlockAction( EIAB_OpenMeditation,		'ACS_Gliding');
			thePlayer.BlockAction( EIAB_RadialMenu,			'ACS_Gliding');
			thePlayer.BlockAction( EIAB_Movement,			'ACS_Gliding');
			thePlayer.BlockAction( EIAB_Interactions, 		'ACS_Gliding');
			thePlayer.BlockAction( EIAB_Jump, 				'ACS_Gliding');
			thePlayer.BlockAction( EIAB_QuickSlots, 		'ACS_Gliding');

			AddTimer('ACS_Gliding', 0.00000000000000000000000001, true);

			thePlayer.DestroyEffect('acs_glide_disappear');

			thePlayer.RemoveTag('ACS_Wild_Hunt_Horse_Flying');

			thePlayer.RemoveTag('ACS_Vampire_Blood_Flight');

			thePlayer.SoundEvent("monster_dettlaff_monster_combat_construct_dash_vfx");

			thePlayer.SoundEvent("magic_yennefer_necromancy_loop_stop");

			thePlayer.SoundEvent("q704_regis_mistform_LP_stop");
			thePlayer.SoundEvent("q704_regis_mistform_LP_stop");
			thePlayer.SoundEvent("q704_regis_mistform_LP_stop");

			thePlayer.StopEffect('shadowdash_body_blood_construct');

			thePlayer.StopEffect('shadowdash_ground_blood_construct');

			thePlayer.StopEffect('avatar_death_swollen_no_decal_construct');

			ACSGetCEntity('ACS_Wings_Entity_Anchor').Destroy();

			ACSGetCEntity('ACS_Wings_Entity').Destroy();

			ACSGetCEntity('ACS_Igni_Glide_Entity_R').Destroy();

			ACSGetCEntity('ACS_Igni_Glide_Entity_L').Destroy();

			ACSGetCEntity('ACS_Igni_Glide_Entity_L_Leg').Destroy();

			ACSGetCEntity('ACS_Igni_Glide_Entity_R_Leg').Destroy();

			RemoveTimer('Fleder_Glide_Fear');

			RemoveTimer('Vampire_Monster_Bat_Swarm_Small');

			if (ACS_Armor_Set_Check('acs_armor', false))
			{
				thePlayer.SoundEvent("monster_dettlaff_monster_movement_wing_flap_long_massive");

				thePlayer.SoundEvent("monster_dettlaff_monster_movement_whoosh_large");

				thePlayer.StopEffect('glide_fx');
				thePlayer.PlayEffectSingle('glide_fx');	

				thePlayer.StopEffect( 'bruxa_dash_trails' );
				thePlayer.PlayEffectSingle( 'bruxa_dash_trails' );

				thePlayer.PlayEffectSingle('embers_particles_test');
				thePlayer.StopEffect('embers_particles_test');

				ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

				"dlc\dlc_acs\data\entities\other\custom_wings\custom_vampire_wings.w2ent"

				, true ), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );

				ent.CreateAttachment( thePlayer, 'blood_point', Vector( 
				-5, // + up - down
				0.3, // + forward - backward
				-0.02 // + left - right
				), 
				EulerAngles(
				0,
				0,
				90
				) );

				ent.PlayEffectSingle('wing_trail');

				ent.AddTag('ACS_Wings_Entity');

				AddTimer('Fleder_Glide_Fear', 0.001 , true);
			}
			else
			{
				if (
				( ACS_GetWeaponMode() == 0 && ACS_Settings_Main_Int('acs_combat_main_settings','acs_fist_mode', 0) == 1 )
				|| ( ACS_GetWeaponMode() == 1 && ACS_Settings_Main_Int('acs_combat_main_settings','acs_fist_mode', 0) == 1 )
				|| ( ACS_GetWeaponMode() == 2 && ACS_Settings_Main_Int('acs_combat_main_settings','acs_fist_mode', 0) == 1 )
				|| ( ACS_GetWeaponMode() == 3 && (ACS_GetItem_VampClaw('shades') || ACS_GetItem_VampClaw('default') ) )
				)
				{
					thePlayer.SoundEvent("monster_dettlaff_monster_combat_construct_dash_vfx");

					thePlayer.SoundEvent("magic_yennefer_necromancy_loop_start");

					thePlayer.SoundEvent( "q704_regis_mistform_activates" );

					thePlayer.SoundEvent( "q704_regis_mistform_LP" );
					thePlayer.SoundEvent( "q704_regis_mistform_LP" );
					thePlayer.SoundEvent( "q704_regis_mistform_LP" );

					thePlayer.PlayEffect('shadowdash_body_blood_construct');

					thePlayer.PlayEffect('shadowdash_ground_blood_construct');

					ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

					"dlc\dlc_acs\data\entities\other\fx_dummy_entity.w2ent"

					, true ), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );
					
					ent.CreateAttachment( thePlayer, , Vector( 0, 2, -0.5 ), EulerAngles(0,0,0 ));

					ent.PlayEffect('shadowdash_construct');

					//ent.PlayEffect('trail_bat_swarm');

					ent.PlayEffect('venom_bat_swarm');

					//ent.PlayEffect('venom_hit_bat_swarm');

					//ent.PlayEffect('bat_swarm_01');

					//ent.PlayEffect('bat_swarm_02');

					//ent.PlayEffect('bat_swarm_03');

					//ent.PlayEffect('bat_swarm_04');

					//ent.PlayEffect('bat_swarm_05');

					//ent.PlayEffect('bat_swarm_06');

					ent.AddTag('ACS_Wings_Entity');

					thePlayer.SetVisibility(false);

					thePlayer.AddTag('ACS_Vampire_Blood_Flight');

					AddTimer('Fleder_Glide_Fear', 0.001 , true);

					RemoveTimer('Vampire_Monster_Bat_Swarm_Small');
					AddTimer('Vampire_Monster_Bat_Swarm_Small', 0.5 , true);
				}
				else
				{

					if (ACS_Settings_Main_Int('acs_jump_settings','acs_jump_glide_form', 0) == 0)
					{
						thePlayer.StopEffect('glide_fx');
						thePlayer.PlayEffectSingle('glide_fx');	

						thePlayer.StopEffect( 'bruxa_dash_trails' );
						thePlayer.PlayEffectSingle( 'bruxa_dash_trails' );

						thePlayer.PlayEffectSingle('embers_particles_test');
						thePlayer.StopEffect('embers_particles_test');

						ent_1 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
						"dlc\dlc_acs\data\fx\slide_particles.w2ent"
						, true ), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );

						ent_1.CreateAttachment( thePlayer, 'blood_point', Vector( 0, 0, 0.75 ), EulerAngles(0,180,0) );

						ent_1.PlayEffectSingle('burn');
						ent_1.PlayEffectSingle('burn_2');
						ent_1.PlayEffectSingle('igni_reaction_djinn');

						ent_1.AddTag('ACS_Igni_Glide_Entity_R');


						ent_2 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
						"dlc\dlc_acs\data\fx\slide_particles.w2ent"
						, true ), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );

						ent_2.CreateAttachment( thePlayer, 'blood_point', Vector( 0, 0, -0.75 ), EulerAngles(0,180,0) );

						ent_2.PlayEffectSingle('burn');
						ent_2.PlayEffectSingle('burn_2');
						ent_2.PlayEffectSingle('igni_reaction_djinn');

						ent_2.AddTag('ACS_Igni_Glide_Entity_L');






						ent_3 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
						"dlc\dlc_acs\data\fx\slide_particles.w2ent"
						, true ), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );

						ent_3.CreateAttachment( thePlayer, 'blood_point', Vector( -1.6, -0.5, 0.25 ), EulerAngles(0,180,0) );

						ent_3.PlayEffectSingle('burn');
						ent_3.PlayEffectSingle('burn_2');
						ent_3.PlayEffectSingle('igni_reaction_djinn');

						ent_3.AddTag('ACS_Igni_Glide_Entity_R_Leg');


						ent_4 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
						"dlc\dlc_acs\data\fx\slide_particles.w2ent"
						, true ), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );

						ent_4.CreateAttachment( thePlayer, 'blood_point', Vector( -1.6, -0.5, -0.25 ), EulerAngles(0,180,0) );

						ent_4.PlayEffectSingle('burn');
						ent_4.PlayEffectSingle('burn_2');
						ent_4.PlayEffectSingle('igni_reaction_djinn');

						ent_4.AddTag('ACS_Igni_Glide_Entity_L_Leg');
					}
					else if (ACS_Settings_Main_Int('acs_jump_settings','acs_jump_glide_form', 0) == 1)
					{
						thePlayer.SoundEvent("monster_dettlaff_monster_movement_wing_flap_long_massive");

						thePlayer.SoundEvent("monster_dettlaff_monster_movement_whoosh_large");

						anchor_temp = (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\entities\other\fx_ent.w2ent", true );

						GetWitcherPlayer().GetBoneWorldPositionAndRotationByIndex( GetWitcherPlayer().GetBoneIndex( 'Trajectory' ), bonePosition, boneRotation );
						wings_torso_anchor_1 = (CEntity)theGame.CreateEntity( anchor_temp, GetWitcherPlayer().GetWorldPosition() + Vector( 0, 0, -10 ) );
						//wings_torso_anchor_1.CreateAttachmentAtBoneWS( GetWitcherPlayer(), 'Trajectory', bonePosition, boneRotation );
						wings_torso_anchor_1.AddTag('ACS_Wings_Entity_Anchor');

						ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

						"dlc\dlc_acs\data\entities\other\custom_wings\custom_crow_wings.w2ent"

						, true ), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );
						
						ent.CreateAttachment( wings_torso_anchor_1, , Vector( 0, 1, 0.75 ), EulerAngles(0,0,0) );

						ent.PlayEffect('summoning_burst');

						ent.PlayEffect('summoning_burst_2');

						ent.PlayEffect('crow_trail');

						ent.PlayEffect('feathers_fx');

						ent.AddTag('ACS_Wings_Entity');

						thePlayer.SetVisibility(false);
					}
					else if (ACS_Settings_Main_Int('acs_jump_settings','acs_jump_glide_form', 0) == 2)
					{
						thePlayer.SoundEvent("monster_dettlaff_monster_movement_wing_flap_long_massive");

						thePlayer.SoundEvent("monster_dettlaff_monster_movement_whoosh_large");

						anchor_temp = (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\entities\other\fx_ent.w2ent", true );

						GetWitcherPlayer().GetBoneWorldPositionAndRotationByIndex( GetWitcherPlayer().GetBoneIndex( 'Trajectory' ), bonePosition, boneRotation );
						wings_torso_anchor_1 = (CEntity)theGame.CreateEntity( anchor_temp, GetWitcherPlayer().GetWorldPosition() + Vector( 0, 0, -10 ) );
						wings_torso_anchor_1.AddTag('ACS_Wings_Entity_Anchor');

						ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

						"dlc\dlc_acs\data\entities\other\custom_wings\custom_owl_wings.w2ent"

						, true ), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );
						
						ent.CreateAttachment( wings_torso_anchor_1, , Vector( 0, 1, 0.75 ), EulerAngles(-5.625,0,0) );

						ent.PlayEffect('summoning_burst');

						ent.PlayEffect('summoning_burst_2');

						ent.PlayEffect('crow_trail');

						ent.PlayEffect('feathers_fx');

						ent.AddTag('ACS_Owl_Wing_Entity');
				
						ent.AddTag('ACS_Wings_Entity');

						thePlayer.SetVisibility(false);
					}
					else if (ACS_Settings_Main_Int('acs_jump_settings','acs_jump_glide_form', 0) == 3)
					{
						thePlayer.SoundEvent("monster_dettlaff_monster_movement_wing_flap_long_massive");

						thePlayer.SoundEvent("monster_dettlaff_monster_movement_whoosh_large");


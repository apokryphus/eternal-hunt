	var lyricsLineA, lyricsLineB : bool;

	default lyricsLineA = false;
	default lyricsLineB = false;

	public timer function PlayLuteLyrics( time : float , id : int )
	{
		var num : int;

		if (!lyricsLineA 
		&& !lyricsLineB )
		{
			num = 571413;

			lyricsLineA = true;
		}
		else if (lyricsLineA 
		&& !lyricsLineB )
		{
			num = 1040267;

			lyricsLineB = true;
		}
		else if (lyricsLineA 
		&& lyricsLineB )
		{
			num = 571424;

			lyricsLineA = false;
			lyricsLineB = false;
		}

		thePlayer.PlayLine( num, false);
	}


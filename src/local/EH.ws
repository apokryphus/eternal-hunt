	function Aard_Sword_On_Hit_Effects (action : W3DamageAction)
	{
		npc = (CActor)action.victim;

		playerAttacker = (CPlayer)action.attacker;

		npcPos = npc.GetWorldPosition();

		npcRot = npc.GetWorldRotation();
		
		curTargetVitality = npc.GetStat( BCS_Vitality );

		maxTargetVitality = npc.GetStatMax( BCS_Vitality );
		
		curTargetEssence = npc.GetStat( BCS_Essence );

		maxTargetEssence = npc.GetStatMax( BCS_Essence );

		maxAdrenaline = thePlayer.GetStatMax(BCS_Focus);
		
		curAdrenaline = thePlayer.GetStat(BCS_Focus);
		
		targetRotationNPC = npc.GetWorldRotation();
		targetRotationNPC.Yaw = RandRangeF(360,1);
		targetRotationNPC.Pitch = RandRangeF(45,-45);
		
		playerVitality = thePlayer.GetStatMax( BCS_Vitality );
		
		heal = playerVitality * 0.025;

		if (playerAttacker && npc && thePlayer.HasTag('acs_aard_sword_equipped') ) 
		{ 
			thePlayer.IncreaseUninterruptedHitsCount();	

			npc.SoundEvent("cmb_play_hit_heavy");
			
			//weapon_blood_fx('red');

			if( curAdrenaline >= maxAdrenaline/3
			&& curAdrenaline < maxAdrenaline * 2/3
			&& npc.HasTag('acs_aard_heavy_attack_mark') 
			) 
			{	
				Detonation_Weapon_Effects_Switch();

				Drain_Energy();

				actors.Clear();

				actors = thePlayer.GetNPCsAndPlayersInRange( 1.5, 20, , FLAG_ExcludePlayer + FLAG_Attitude_Hostile + FLAG_OnlyAliveActors);

				if( actors.Size() > 0 )
				{
					for( i = 0; i < actors.Size(); i += 1 )
					{
						actortarget = (CActor)actors[i];

						dmg = new W3DamageAction in theGame.damageMgr;
						dmg.Initialize(thePlayer, actortarget, thePlayer, thePlayer.GetName(), EHRT_None, CPS_Undefined, false, false, true, false);
						dmg.SetProcessBuffsIfNoDamage(true);

								
						dmg.AddEffectInfo( EET_Bleeding, 3 );

						dmg.AddEffectInfo( EET_Confusion, 0.5 );
			
						dmg.SetCriticalHit(); theGame.damageMgr.ProcessAction( dmg );
								
						delete dmg;	
					}
				}
					
				vACS_Armiger_Mode_On_Hit_Effects = new cACS_Armiger_Mode_On_Hit_Effects in this;
		
				vACS_Armiger_Mode_On_Hit_Effects.ACS_AOE_Bloodarc_LVL_1_Engage();
	
				Remove_On_Hit_Tags();
					
				npc.RemoveTag('acs_aard_heavy_attack_mark');
				thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) );

				thePlayer.GainStat( BCS_Vitality, heal * 4 ); 

				ShowHealFloatingValue(heal * 4, true);
			}
			else if( curAdrenaline >= maxAdrenaline * 2/3
			&& curAdrenaline < maxAdrenaline
			&& npc.HasTag('acs_aard_heavy_attack_mark') 
			) 
			{	
				Detonation_Weapon_Effects_Switch();

				Drain_Energy();

				actors.Clear();
					
				actors = thePlayer.GetNPCsAndPlayersInRange( 2.5, 20, , FLAG_ExcludePlayer + FLAG_Attitude_Hostile + FLAG_OnlyAliveActors);

				if( actors.Size() > 0 )
				{	
					for( i = 0; i < actors.Size(); i += 1 )
					{
						actortarget = (CActor)actors[i];

						dmg = new W3DamageAction in theGame.damageMgr;
						dmg.Initialize(thePlayer, actortarget, thePlayer, thePlayer.GetName(), EHRT_None, CPS_Undefined, false, false, true, false);
						dmg.SetProcessBuffsIfNoDamage(true);

								
						dmg.AddEffectInfo( EET_Bleeding, 5 );

						dmg.AddEffectInfo( EET_Confusion, 0.75 );
			
						dmg.SetCriticalHit(); theGame.damageMgr.ProcessAction( dmg );
								
						delete dmg;	
					}
				}
					
				vACS_Armiger_Mode_On_Hit_Effects = new cACS_Armiger_Mode_On_Hit_Effects in this;
		
				vACS_Armiger_Mode_On_Hit_Effects.ACS_AOE_Bloodarc_LVL_1_Engage();

				Remove_On_Hit_Tags();
					
				npc.RemoveTag('acs_aard_heavy_attack_mark');
				thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) * 1/3 );

				thePlayer.GainStat( BCS_Vitality, heal * 8 ); 

				ShowHealFloatingValue(heal * 8, true);
			}
			else if( curAdrenaline == maxAdrenaline
			&& npc.HasTag('acs_aard_heavy_attack_mark') 
			) 
			{	
				Detonation_Weapon_Effects_Switch();

				Drain_Energy();

				actors.Clear();
					
				actors = thePlayer.GetNPCsAndPlayersInRange( 5, 20, , FLAG_ExcludePlayer + FLAG_Attitude_Hostile + FLAG_OnlyAliveActors);

				if( actors.Size() > 0 )
				{
					for( i = 0; i < actors.Size(); i += 1 )
					{
						actortarget = (CActor)actors[i];

						dmg = new W3DamageAction in theGame.damageMgr;
						dmg.Initialize(thePlayer, actortarget, thePlayer, thePlayer.GetName(), EHRT_None, CPS_Undefined, false, false, true, false);
						dmg.SetProcessBuffsIfNoDamage(true);

								
						dmg.AddEffectInfo( EET_Bleeding, 10 );

						dmg.AddEffectInfo( EET_Confusion, 1 );
			
						dmg.SetCriticalHit(); theGame.damageMgr.ProcessAction( dmg );
								
						delete dmg;	
					}
				}
					
				vACS_Armiger_Mode_On_Hit_Effects = new cACS_Armiger_Mode_On_Hit_Effects in this;
		
				vACS_Armiger_Mode_On_Hit_Effects.ACS_AOE_Bloodarc_LVL_2_Engage();

				Remove_On_Hit_Tags();
					
				npc.RemoveTag('acs_aard_heavy_attack_mark');
				thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) * 1/3 );

				thePlayer.GainStat( BCS_Vitality, heal * 16 ); 

				ShowHealFloatingValue(heal * 16, true);
			}
			else
			{							
				if( curAdrenaline >= maxAdrenaline/3
				&& curAdrenaline < maxAdrenaline * 2/3)
				{
					if (thePlayer.IsGuarded())
					{
						thePlayer.GainStat( BCS_Vitality, heal * 0.25 ); 

						ShowHealFloatingValue(heal * 0.25, true);
					}
					else
					{
						thePlayer.GainStat( BCS_Vitality, heal * 0.5 ); 

						ShowHealFloatingValue(heal * 0.5, true);
					}

					Passive_Weapon_Effects_Switch();
					ACSSwordPlayEffects('aard');
				}
				else if( curAdrenaline >= maxAdrenaline * 2/3
				&& curAdrenaline < maxAdrenaline)
				{
					if (thePlayer.IsGuarded())
					{
						thePlayer.GainStat( BCS_Vitality, heal * 0.5 ); 

						ShowHealFloatingValue(heal * 0.5, true);
					}
					else
					{
						thePlayer.GainStat( BCS_Vitality, heal ); 

						ShowHealFloatingValue(heal, true);
					}

					Passive_Weapon_Effects_Switch();
					ACSSwordPlayEffects('aard');
				}
				else if( curAdrenaline == maxAdrenaline ) 
				{
					if (thePlayer.IsGuarded())
					{
						thePlayer.GainStat( BCS_Vitality, heal ); 

						ShowHealFloatingValue(heal , true);
					}
					else
					{
						thePlayer.GainStat( BCS_Vitality, heal * 2 ); 

						ShowHealFloatingValue(heal * 2, true);
					}

					Passive_Weapon_Effects_Switch();
					ACSSwordPlayEffects('aard');
				}

				if( !npc.HasTag('acs_aard_light_attack_mark') ) 
				{
					Marker_Switch();
					npc.AddTag('acs_aard_light_attack_mark');
				}
			}

			return;
		}	
	}

	function Aard_Secondary_Sword_On_Hit_Effects (action : W3DamageAction)
	{
		npc = (CActor)action.victim;

		playerAttacker = (CPlayer)action.attacker;

		npcPos = npc.GetWorldPosition();

		npcRot = npc.GetWorldRotation();
		
		curTargetVitality = npc.GetStat( BCS_Vitality );

		maxTargetVitality = npc.GetStatMax( BCS_Vitality );
		
		curTargetEssence = npc.GetStat( BCS_Essence );

		maxTargetEssence = npc.GetStatMax( BCS_Essence );

		maxAdrenaline = thePlayer.GetStatMax(BCS_Focus);
		
		curAdrenaline = thePlayer.GetStat(BCS_Focus);
		
		targetRotationNPC = npc.GetWorldRotation();
		targetRotationNPC.Yaw = RandRangeF(360,1);
		targetRotationNPC.Pitch = RandRangeF(45,-45);
		
		playerVitality = thePlayer.GetStatMax( BCS_Vitality );
		
		heal = playerVitality * 0.025;

		if (playerAttacker && npc && thePlayer.HasTag('acs_aard_secondary_sword_equipped') )
		{ 
			theSound.SoundEvent("cmb_play_hit_heavy");

			thePlayer.IncreaseUninterruptedHitsCount();	
			
			//weapon_blood_fx('red');

			if( curAdrenaline >= maxAdrenaline/3
			&& curAdrenaline < maxAdrenaline * 2/3
			&& npc.HasTag('acs_aard_light_attack_mark') ) 
			{	
				Detonation_Weapon_Effects_Switch();

				actors.Clear();

				actors = thePlayer.GetNPCsAndPlayersInRange( 1.5, 20, , FLAG_ExcludePlayer + FLAG_Attitude_Hostile + FLAG_OnlyAliveActors);

				if( actors.Size() > 0 )
				{
					for( i = 0; i < actors.Size(); i += 1 )
					{
						actortarget = (CActor)actors[i];

						dmg = new W3DamageAction in theGame.damageMgr;
						dmg.Initialize(thePlayer, actortarget, thePlayer, thePlayer.GetName(), EHRT_None, CPS_Undefined, false, false, true, false);
						dmg.SetProcessBuffsIfNoDamage(true);

								
						dmg.AddEffectInfo( EET_Confusion, 1 );
			
						dmg.SetCriticalHit(); theGame.damageMgr.ProcessAction( dmg );
								
						delete dmg;	
					}
				}
					
				vACS_Armiger_Mode_On_Hit_Effects = new cACS_Armiger_Mode_On_Hit_Effects in this;
		
				vACS_Armiger_Mode_On_Hit_Effects.ACS_AOE_Waterpillar_LVL_1_Engage();
					
				Remove_On_Hit_Tags();
					
				npc.RemoveTag('acs_aard_light_attack_mark');
				thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) );
			}
			else if( curAdrenaline >= maxAdrenaline * 2/3
			&& curAdrenaline < maxAdrenaline
			&& npc.HasTag('acs_aard_light_attack_mark') ) 
			{	
				Detonation_Weapon_Effects_Switch();

				actors.Clear();

				actors = thePlayer.GetNPCsAndPlayersInRange( 2.5, 20, , FLAG_ExcludePlayer + FLAG_Attitude_Hostile + FLAG_OnlyAliveActors);

				if( actors.Size() > 0 )
				{
					for( i = 0; i < actors.Size(); i += 1 )
					{
						actortarget = (CActor)actors[i];

						dmg = new W3DamageAction in theGame.damageMgr;
						dmg.Initialize(thePlayer, actortarget, thePlayer, thePlayer.GetName(), EHRT_None, CPS_Undefined, false, false, true, false);
						dmg.SetProcessBuffsIfNoDamage(true);

								
						dmg.AddEffectInfo( EET_Confusion, 2 );
			
						dmg.SetCriticalHit(); theGame.damageMgr.ProcessAction( dmg );
								
						delete dmg;	
					}
				}
					
				//ACS_AOE_Sandpillar_LVL_2();
				vACS_Armiger_Mode_On_Hit_Effects = new cACS_Armiger_Mode_On_Hit_Effects in this;
		
				vACS_Armiger_Mode_On_Hit_Effects.ACS_AOE_Waterpillar_LVL_1_Engage();
					
				Remove_On_Hit_Tags();
					
				npc.RemoveTag('acs_aard_light_attack_mark');
				thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) * 1/3 );
			}
			else if( curAdrenaline == maxAdrenaline
			&& npc.HasTag('acs_aard_light_attack_mark') ) 
			{	
				Detonation_Weapon_Effects_Switch();

				actors.Clear();

				actors = thePlayer.GetNPCsAndPlayersInRange( 5, 20, , FLAG_ExcludePlayer + FLAG_Attitude_Hostile + FLAG_OnlyAliveActors);

				if( actors.Size() > 0 )
				{
					for( i = 0; i < actors.Size(); i += 1 )
					{
						actortarget = (CActor)actors[i];

						dmg = new W3DamageAction in theGame.damageMgr;
						dmg.Initialize(thePlayer, actortarget, thePlayer, thePlayer.GetName(), EHRT_None, CPS_Undefined, false, false, true, false);
						dmg.SetProcessBuffsIfNoDamage(true);

								
						dmg.AddEffectInfo( EET_Confusion, 3 );
			
						dmg.SetCriticalHit(); theGame.damageMgr.ProcessAction( dmg );
								
						delete dmg;	
					}
				}
					
				vACS_Armiger_Mode_On_Hit_Effects = new cACS_Armiger_Mode_On_Hit_Effects in this;
		
				vACS_Armiger_Mode_On_Hit_Effects.ACS_AOE_Waterpillar_LVL_2_Engage();
					
				Remove_On_Hit_Tags();
					
				npc.RemoveTag('acs_aard_light_attack_mark');
				thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) * 1/3 );
			}
			else
			{									
				if( curAdrenaline >= maxAdrenaline/3
				&& curAdrenaline < maxAdrenaline * 2/3)
				{
					if( RandF() < 0.0625 ) 
					{ 
						if( !npc.IsImmuneToBuff( EET_Stagger ) && !npc.HasBuff( EET_Stagger ) ) 
						{ 	
							Passive_Weapon_Effects_Switch();
							ACSSwordPlayEffects('aard_secondary');	
							npc.AddEffectDefault( EET_Stagger, npc, 'console' );						
						}
					}		
				}
				else if( curAdrenaline >= maxAdrenaline * 2/3
				&& curAdrenaline < maxAdrenaline)
				{
					if( RandF() < 0.125 ) 
					{ 
						if( !npc.IsImmuneToBuff( EET_Stagger ) && !npc.HasBuff( EET_Stagger ) ) 
						{ 	
							Passive_Weapon_Effects_Switch();
							ACSSwordPlayEffects('aard_secondary');	
							npc.AddEffectDefault( EET_Stagger, npc, 'console' );							
						}
					}
				}
				else if( curAdrenaline == maxAdrenaline ) 
				{
					if( RandF() < 0.25 ) 
					{ 
						if( !npc.IsImmuneToBuff( EET_Stagger ) && !npc.HasBuff( EET_Stagger ) ) 
						{ 	
							Passive_Weapon_Effects_Switch();
							ACSSwordPlayEffects('aard_secondary');	
							npc.AddEffectDefault( EET_Stagger, npc, 'console' );					
						}
					}
				}

				if( !npc.HasTag('acs_aard_heavy_attack_mark') ) 
				{
					Marker_Switch();
					npc.AddTag('acs_aard_heavy_attack_mark');
				}
			}

			return;
		}
	}

	function Yrden_Sword_On_Hit_Effects (action : W3DamageAction)
	{
		npc = (CActor)action.victim;

		playerAttacker = (CPlayer)action.attacker;

		npcPos = npc.GetWorldPosition();

		npcRot = npc.GetWorldRotation();
		
		curTargetVitality = npc.GetStat( BCS_Vitality );

		maxTargetVitality = npc.GetStatMax( BCS_Vitality );
		
		curTargetEssence = npc.GetStat( BCS_Essence );

		maxTargetEssence = npc.GetStatMax( BCS_Essence );

		maxAdrenaline = thePlayer.GetStatMax(BCS_Focus);
		
		curAdrenaline = thePlayer.GetStat(BCS_Focus);
		
		targetRotationNPC = npc.GetWorldRotation();
		targetRotationNPC.Yaw = RandRangeF(360,1);
		targetRotationNPC.Pitch = RandRangeF(45,-45);
		
		playerVitality = thePlayer.GetStatMax( BCS_Vitality );
		
		heal = playerVitality * 0.025;

		if ( playerAttacker && npc && thePlayer.HasTag('acs_yrden_sword_equipped') ) 
		{ 
			thePlayer.IncreaseUninterruptedHitsCount();	

			if ( ACS_GetWeaponMode() == 0 )
			{
				if ( ACS_Settings_Main_Int('acs_armiger_mode_settings','acs_armiger_mode_weapon_type', 0) == 0 )
				{
					theSound.SoundEvent("cmb_play_hit_heavy");
				}
				else if ( ACS_Settings_Main_Int('acs_armiger_mode_settings','acs_armiger_mode_weapon_type', 0) == 1 )
				{
					npc.SoundEvent("monster_knight_giant_cmb_weapon_hit_add", 'head');
				}
			}
			else if ( ACS_GetWeaponMode() == 1 )
			{
				if ( ACS_Settings_Main_Int('acs_focus_mode_settings','acs_focus_mode_weapon_type', 0) == 0 )
				{
					theSound.SoundEvent("cmb_play_hit_heavy");
				}
				else if ( ACS_Settings_Main_Int('acs_focus_mode_settings','acs_focus_mode_weapon_type', 0) == 1 )
				{
					npc.SoundEvent("monster_knight_giant_cmb_weapon_hit_add", 'head');
				}
			}
			else if ( ACS_GetWeaponMode() == 2 )
			{
				if ( ACS_Settings_Main_Int('acs_hybrid_mode_settings','acs_hybrid_mode_weapon_type', 0) == 0 )
				{
					theSound.SoundEvent("cmb_play_hit_heavy");
				}
				else if ( ACS_Settings_Main_Int('acs_hybrid_mode_settings','acs_hybrid_mode_weapon_type', 0) == 1 )
				{
					npc.SoundEvent("monster_knight_giant_cmb_weapon_hit_add", 'head');
				}
			}
			else if ( ACS_GetWeaponMode() == 3 )
			{
				if ( ACS_GetItem_Sword_IsEquipped('imlerith_moveset_steel_for_slicing', 'steel') || ACS_GetItem_Sword_IsEquipped('imlerith_moveset_silver_for_slicing', 'silver'))
				{
					theSound.SoundEvent("cmb_play_hit_heavy");
				}
				else if ( ACS_GetItem_Sword_IsEquipped('caretaker_shovel_steel', 'steel') || ACS_GetItem_Sword_IsEquipped('imlerith_moveset_steel_for_thunking', 'steel') || ACS_GetItem_Sword_IsEquipped('imlerith_moveset_silver_for_thunking', 'silver'))
				{
					npc.SoundEvent("monster_cloud_giant_cmb_weapon_hit_add", 'head');
				}
			}
			
			//weapon_blood_fx('red');
		
			if( curAdrenaline >= maxAdrenaline/3
			&& curAdrenaline < maxAdrenaline * 2/3
			&& npc.HasTag('acs_yrden_heavy_attack_mark') ) 
			{
				Detonation_Weapon_Effects_Switch();

				actors.Clear();

				actors = thePlayer.GetNPCsAndPlayersInRange( 1.5, 20, , FLAG_ExcludePlayer + FLAG_Attitude_Hostile + FLAG_OnlyAliveActors);

				if( actors.Size() > 0 )
				{
					for( i = 0; i < actors.Size(); i += 1 )
					{
						actortarget = (CActor)actors[i];

						dmg = new W3DamageAction in theGame.damageMgr;
						dmg.Initialize(thePlayer, actortarget, thePlayer, thePlayer.GetName(), EHRT_None, CPS_Undefined, false, false, true, false);
						dmg.SetProcessBuffsIfNoDamage(true);

								
						dmg.AddEffectInfo( EET_YrdenHealthDrain, 1 );
			
						dmg.SetCriticalHit(); theGame.damageMgr.ProcessAction( dmg );
								
						delete dmg;	
					}

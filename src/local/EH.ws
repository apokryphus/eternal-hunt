	public timer function MegaWraithMinionDisppearEffect(deltaTime : float , id : int)
	{
		var actors 											: array<CActor>;
		var i												: int;
		var animatedComponentA								: CAnimatedComponent;
		var actor											: CActor; 
		var npc												: CNewNPC;

		actors.Clear();

		theGame.GetActorsByTag( 'ACS_MegaWraith_Minion', actors );	

		if (actors.Size() <= 0)
		{
			return;
		}
		
		for( i = 0; i < actors.Size(); i += 1 )
		{
			npc = (CNewNPC)actors[i];

			actor = actors[i];

			actor.StopAllEffects();
			//actor.PlayEffectSingle('appear');
			actor.PlayEffectSingle('disappear');

			actor.DestroyAfter(0.5);
		}
	}

	var naglfarProgres 										: float;

	function naglfarProgressReset()
	{
		naglfarProgres -= naglfarProgres;
	}

	timer function NaglfarMove ( dt : float, id : int)
	{
		if (ACSGetCEntity('ACS_Naglfar') && (ACSGetCEntity('ACS_Naglfar').GetWorldPosition() != ACSGetCEntity('ACS_Naglfar').GetWorldPosition() + ACSGetCEntity('ACS_Naglfar').GetWorldRight() * 100 ))
		{
			ACSGetCEntity('ACS_Naglfar').Teleport( LerpV(ACSGetCEntity('ACS_Naglfar').GetWorldPosition(), ACSGetCEntity('ACS_Naglfar').GetWorldPosition() + ACSGetCEntity('ACS_Naglfar').GetWorldRight() * 100 , naglfarProgres) );
			naglfarProgres += 0.00000075;
		
			if(naglfarProgres >= 1)
			{
				RemoveTimer( 'NaglfarMove' );
				
				naglfarProgressReset();
			}
		}
		else
		{
			RemoveTimer( 'NaglfarMove' );

			naglfarProgressReset();
		}
	}

	timer function NaglfarStop ( dt : float, id : int)
	{
		var temp, temp_2													: CEntityTemplate;
		var ent, ent_2														: CEntity;

		//RemoveTimer('NaglfarMove');

		temp_2 = (CEntityTemplate)LoadResource( 

		"dlc\dlc_acs\data\fx\test_rift.w2ent"
			
		, true );

		ent_2 = theGame.CreateEntity( temp_2, ACSGetCEntity('ACS_Naglfar').GetWorldPosition() + ACSGetCEntity('ACS_Naglfar').GetWorldRight() * 75, ACSGetCEntity('ACS_Naglfar').GetWorldRotation() );

		ent_2.PlayEffect('test_rift_2');

		ent_2.DestroyAfter(18);

		ACSGetCEntity('ACS_Naglfar').DestroyAfter(17);

		thePlayer.SoundEvent("magic_caranthil_teleport_fx_stop");

		thePlayer.SoundEvent("magic_caranthil_teleport_fx_start");
		
		AddTimer('NaglfarStopSound', 18   , false);
	}

	timer function NaglfarStopSound ( dt : float, id : int)
	{
		Custom_Env_Switch('naglfar', false);

		thePlayer.SoundEvent("magic_caranthil_teleport_fx_stop");
	}

	
	

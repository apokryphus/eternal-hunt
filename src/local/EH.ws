				}

				if (ACSGetCActor('ACS_Transformation_Giant').IsEffectActive('smokeman'))
				{
					ACSGetCActor('ACS_Transformation_Giant').DestroyEffect('smokeman');
				}

				if (ACSGetCActor('ACS_Transformation_Giant').IsEffectActive('him_smoke_red'))
				{
					ACSGetCActor('ACS_Transformation_Giant').DestroyEffect('him_smoke_red');
				}

				if (ACSGetCActor('ACS_Transformation_Giant').IsEffectActive('red_electricity_r_arm'))
				{
					ACSGetCActor('ACS_Transformation_Giant').DestroyEffect('red_electricity_r_arm');
				}

				if (ACSGetCActor('ACS_Transformation_Giant').IsEffectActive('critical_burning_ex'))
				{
					ACSGetCActor('ACS_Transformation_Giant').DestroyEffect('critical_burning_ex');
				}

				if (ACSGetCActor('ACS_Transformation_Giant').IsEffectActive('critical_burning_ex_r'))
				{
					ACSGetCActor('ACS_Transformation_Giant').DestroyEffect('critical_burning_ex_r');

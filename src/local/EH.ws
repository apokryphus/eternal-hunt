						AddTimer('ACS_Caranthir_Ice_Spear_Single_Fire_Delay_2', 3.5 , false);

						AddTimer('ACS_Caranthir_Ice_Spear_Single_Fire_Delay_3', 4 , false);

						break;

						case 4:


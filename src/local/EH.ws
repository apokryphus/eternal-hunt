		{
			horseTicket = horseMovementAdjust.GetRequest( 'ACS_Horse_Increase_Speed');
			horseMovementAdjust.CancelByName( 'ACS_Horse_Increase_Speed' );
			horseMovementAdjust.CancelAll();

			horseTicket = horseMovementAdjust.CreateNewRequest( 'ACS_Horse_Increase_Speed' );
			horseMovementAdjust.AdjustmentDuration( horseTicket, 0.1 );

			if ( cam_direction != 0
			&& theInput.GetActionValue('GI_AxisLeftY') > 0
			&& theInput.GetActionValue('GI_AxisLeftX') == 0
			&& ACS_Settings_Main_Bool('acs_horse_settings','acs_horse_rotate_towards_camera_enabled', true)
			)
			{
				if ((thePlayer.GetHorseCurrentlyMounted().GetHorseComponent()).inCanter)
				{
					horseMovementAdjust.MaxRotationAdjustmentSpeed( horseTicket, 500 );
				}
				else if ((thePlayer.GetHorseCurrentlyMounted().GetHorseComponent()).inGallop)
				{
					horseMovementAdjust.MaxRotationAdjustmentSpeed( horseTicket, 400 );
				}
				else
				{
					horseMovementAdjust.MaxRotationAdjustmentSpeed( horseTicket, 200 );
				}
					
				horseMovementAdjust.RotateTo( horseTicket, VecHeading( theCamera.GetCameraDirection() ) );
			}

			if (ACS_Settings_Main_Float('acs_horse_settings','acs_horse_speed_multiplier', 1) >= 1
			&& theInput.GetActionValue('Gallop') > 0.1
			&& (thePlayer.GetHorseCurrentlyMounted().GetHorseComponent()).inCanter
			)
			{
				if (!horseInFastSprint)
				{
					HorseSpeakController('save_my_strength');
					
					if (ACS_Settings_Main_Float('acs_horse_settings','acs_horse_speed_multiplier', 1) >= 2)
					{
						CreateFastSprintTrail('red');

						CreateHorseFastSprintTrail('red');

						if (!horseInFastSprintAnim)
						{
							horseAnimatedComponent.PlaySlotAnimationAsync( 'horse_rearing01', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.125, 0.5));
							
							RemoveTimer('ResetHorseInFastSprintAnim');
							AddTimer('ResetHorseInFastSprintAnim', 3.5 , false);
							
							horseInFastSprintAnim = true;
						}
					}
					else
					{
						CreateFastSprintTrail('white');

						CreateHorseFastSprintTrail('white');
					}
					
					if ( (thePlayer.GetHorseCurrentlyMounted().GetHorseComponent()).IsPlayerHorse() )
					{
						thePlayer.PlayVoiceset( 100,'FasterHorseRoach', true);
					}
					else
					{
						thePlayer.PlayVoiceset( 100,'FasterHorse', true );
					}

					thePlayer.RaiseEvent( 'spursKickHard' );

					thePlayer.RaiseEvent( 'ACS_TorsoBendSlow' );
						
					horseInFastSprint = true;
				}

				if (horseSpeed > 2 * ACS_Settings_Main_Float('acs_horse_settings','acs_horse_speed_multiplier', 1))
				{
					horseSpeed -= 0.005;
				}
				else if (horseSpeed < 2 * ACS_Settings_Main_Float('acs_horse_settings','acs_horse_speed_multiplier', 1))
				{
					horseSpeed += 0.005;
				}
				else
				{
					horseSpeed = 2 * ACS_Settings_Main_Float('acs_horse_settings','acs_horse_speed_multiplier', 1);
				}

				if (horseAnimSpeed > 1.125)
				{
					horseAnimSpeed -= 0.005;
				}
				else if (horseAnimSpeed < 1.125)
				{
					horseAnimSpeed += 0.005;
				}
				else
				{
					horseAnimSpeed = 1.125;
				}

				if (!horseInFastSprintAnim)
				{
					thePlayer.GetHorseCurrentlyMounted().ACS_SetAnimationSpeedMultiplier(horseAnimSpeed);

					dest1 = (thePlayer.GetHorseCurrentlyMounted()).GetWorldPosition() + (thePlayer.GetHorseCurrentlyMounted()).GetHeadingVector() * horseSpeed;

					horseMovementAdjust.MaxLocationAdjustmentDistance( horseTicket, true, 100 );

					horseMovementAdjust.MaxLocationAdjustmentSpeed( horseTicket, 500 );

					horseMovementAdjust.SlideTo( horseTicket, ACSFixZAxis(dest1) );

					(thePlayer.GetHorseCurrentlyMounted()).DrainStamina( ESAT_FixedValue, (thePlayer.GetHorseCurrentlyMounted()).GetStatMax( BCS_Stamina ) * 0.0005 );
				}
				else
				{
					thePlayer.GetHorseCurrentlyMounted().GainStat(BCS_Stamina, thePlayer.GetHorseCurrentlyMounted().GetStatMax(BCS_Stamina) * 0.0025);
				}
			}
			else
			{
				if (horseInFastSprint)
				{
					ACSGetCEntityDestroyAll('ACS_Player_Fast_Sprint_Trail');

					ACSGetCEntityDestroyAll('ACS_Horse_Fast_Sprint_Trail');

					thePlayer.RaiseEvent( 'ACS_TorsoBendSlow' );

					if ( (thePlayer.GetHorseCurrentlyMounted().GetHorseComponent()).IsPlayerHorse() )
					{
						thePlayer.PlayVoiceset( 100,'SlowerHorseRoach', true);
					}
					else
					{
						thePlayer.PlayVoiceset( 100,'SlowerHorse', true );
					}

					horseInFastSprint = false;
				}

				if (horseInFastSprintAnim)
				{
					RemoveTimer('ResetHorseInFastSprintAnim');
					
					horseInFastSprintAnim = false;
				}
				
				if (horseSpeed != 0)
				{
					horseSpeed = 0;
				}

				if (horseAnimSpeed != 1)
				{
					horseAnimSpeed = 1;
				}
			}
		}
		else
		{
			if (horseInFastSprint)
			{
				ACSGetCEntityDestroyAll('ACS_Player_Fast_Sprint_Trail');

				ACSGetCEntityDestroyAll('ACS_Horse_Fast_Sprint_Trail');

				thePlayer.RaiseEvent( 'ACS_TorsoBendSlow' );

				if ( (thePlayer.GetHorseCurrentlyMounted().GetHorseComponent()).IsPlayerHorse() )
				{
					thePlayer.PlayVoiceset( 100,'SlowerHorseRoach', true);
				}
				else
				{
					thePlayer.PlayVoiceset( 100,'SlowerHorse', true );
				}

				horseInFastSprint = false;
			}

			if (horseSpeed != 0)
			{
				horseSpeed = 0;
			}

			if (horseAnimSpeed != 1)
			{
				horseAnimSpeed = 1;
			}

			horseTicket = horseMovementAdjust.GetRequest( 'ACS_Horse_Increase_Speed');
			horseMovementAdjust.CancelByName( 'ACS_Horse_Increase_Speed' );
			horseMovementAdjust.CancelAll();

			thePlayer.GetHorseCurrentlyMounted().ACS_ClearAnimationSpeedMultipliers();
		}
	}

	var manticoreshieldenabled : bool;
	default manticoreshieldenabled = false;

	timer function CreateManticoreShield( dt : float, id : int )
	{
		var shield											: CEntity;

		ACSGetCEntity('ACS_ManticoreShield').DestroyEffect('igni_cone_hit');
		ACSGetCEntity('ACS_ManticoreShield').BreakAttachment();
		ACSGetCEntity('ACS_ManticoreShield').Teleport(thePlayer.GetWorldPosition() + Vector (0,0, -200));
		ACSGetCEntity('ACS_ManticoreShield').DestroyAfter(0.125);
		ACSGetCEntity('ACS_ManticoreShield').RemoveTag('ACS_ManticoreShield');

		shield = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource(

		"dlc\dlc_acs\data\entities\shields\acs_hakland_shield_01.w2ent"

		,true ), thePlayer.GetWorldPosition() -100, thePlayer.GetWorldRotation());

		shield.CreateAttachment(thePlayer, 'l_weapon', Vector(0,0,0), EulerAngles(0,0,90));

		shield.AddTag('ACS_ManticoreShield');

		shield.PlayEffectSingle('aard_cone_hit');
		shield.PlayEffectSingle('light_block');
		shield.PlayEffectSingle('heavy_block');
	}

	function ManticoreShieldControl()
	{
		if (!ACS_Armor_Set_Check('manticore', true)
		|| theGame.IsDialogOrCutscenePlaying() 
		|| !thePlayer.IsAlive()
		|| thePlayer.IsInCutsceneIntro()
		|| theGame.HasBlackscreenRequested()
		|| !thePlayer.IsAnyWeaponHeld()
		|| thePlayer.IsWeaponHeld('fist')
		|| theGame.GetPhotomodeEnabled() 
		|| thePlayer.IsInCutsceneIntro() 
		)
		{
			if(manticoreshieldenabled)
			{
				RemoveTimer('CreateManticoreShield');

				thePlayer.RaiseEvent('ACS_HolsterShield');

				if (!thePlayer.HasTag('ACS_Dual_Wield_Active') && !ACSGetCEntity('ACS_Viper_Dagger_L')){thePlayer.RaiseEvent('ACS_ForceHandClosedLEnd');}

				RemoveTimer('ManticoreShieldDestroyDelay');
				AddTimer('ManticoreShieldDestroyDelay', 0.75 , false);

				manticoreshieldenabled = false;
			}
			
			return;
		}

		if(!ACS_CombatToExplorationCheck() 
		|| thePlayer.IsInCombat() 
		|| thePlayer.IsThreatened()
		|| thePlayer.HasTag('ACS_Player_Is_Attacking')
		)
		{
			if(!manticoreshieldenabled)
			{
				RemoveTimer('ManticoreShieldDestroyDelay');

				thePlayer.RaiseEvent('ACS_ForceHandClosedLShield');

				thePlayer.RaiseEvent('ACS_DrawShield');

				ACSGetCEntity('ACS_ManticoreShield').DestroyEffect('igni_cone_hit');
				ACSGetCEntity('ACS_ManticoreShield').BreakAttachment();
				ACSGetCEntity('ACS_ManticoreShield').Teleport(thePlayer.GetWorldPosition() + Vector (0,0, -200));
				ACSGetCEntity('ACS_ManticoreShield').DestroyAfter(0.125);
				ACSGetCEntity('ACS_ManticoreShield').RemoveTag('ACS_ManticoreShield');

				RemoveTimer('CreateManticoreShield');
				AddTimer('CreateManticoreShield', 0.325 , false);

				manticoreshieldenabled = true;
			}
		}
		else
		{
			if(manticoreshieldenabled)
			{
				RemoveTimer('CreateManticoreShield');

				thePlayer.RaiseEvent('ACS_HolsterShield');
				
				if (!thePlayer.HasTag('ACS_Dual_Wield_Active') && !ACSGetCEntity('ACS_Viper_Dagger_L')){thePlayer.RaiseEvent('ACS_ForceHandClosedLEnd');}

				RemoveTimer('ManticoreShieldDestroyDelay');
				AddTimer('ManticoreShieldDestroyDelay', 0.75 , false);

				manticoreshieldenabled = false;
			}
		}
	}

	timer function ManticoreShieldDestroyDelay(deltaTime : float , id : int)
	{
		ACSGetCEntity('ACS_ManticoreShield').DestroyEffect('igni_cone_hit');
		ACSGetCEntity('ACS_ManticoreShield').BreakAttachment();
		ACSGetCEntity('ACS_ManticoreShield').Teleport(thePlayer.GetWorldPosition() + Vector (0,0, -200));
		ACSGetCEntity('ACS_ManticoreShield').DestroyAfter(0.125);
		ACSGetCEntity('ACS_ManticoreShield').RemoveTag('ACS_ManticoreShield');
	}

	function SkipDialogue() 
	{
		var cam_directionX		 : float;

		if ( !theGame.IsDialogOrCutscenePlaying() )
		{
			return;
		}

		if ( theInput.LastUsedPCInput() )
		{
			cam_directionX = theInput.GetActionValue( 'GI_MouseDampX' );
		}
		else if (theInput.LastUsedGamepad())
		{
			cam_directionX = theInput.GetActionValue( 'GI_AxisRightX' );
		}

		if (cam_directionX > AbsF(200))
		{
			theGame.GetStorySceneSystem().SendSignal( SSST_Skip, 1 );
		} 
	}

	///////////////////////////////////////////////////////////////////////

	function GravehagWeaponControl()
	{
		var sword_id 																								: SItemUniqueId;
		var ent_1																									: CEntity;
		var animatedComponent_R																						: CAnimatedComponent;

		if ( thePlayer.IsWeaponHeld( 'silversword' ) )
		{
			thePlayer.GetInventory().GetItemEquippedOnSlot(EES_SilverSword, sword_id);

			if( 
			thePlayer.GetInventory().GetItemName( sword_id ) == 'ACS_Gravehag_Tongue_Silver'
			|| thePlayer.GetInventory().GetItemName( sword_id ) == 'ACS_Mourntart_Silver'
			)
			{
				if (!ACSGetCActor('ACS_Gravehag_Tongue_Weapon_R') 
				&& thePlayer.GetWeaponHolster().IsMeleeWeaponReady() 
				&& !thePlayer.GetWeaponHolster().IsOnTheMiddleOfHolstering() 
				&& !thePlayer.HasTag('ACS_IsManagingSword')
				)
				{
					if (thePlayer.IsAnyWeaponHeld() && !thePlayer.IsWeaponHeld('fist'))
					{
						thePlayer.RaiseEvent('ACS_CombatExtraReset');
						
						if (RandF() < 0.5)
						{
							thePlayer.RaiseEvent('ACS_SwordRepair');
						}
						else
						{
							thePlayer.RaiseEvent('ACS_SwordBuff');
						}

						IdleAdditiveBlockTemp();

						thePlayer.AddTag('ACS_SwordBuffAnimationPlayed');
					}

					ent_1 = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource(

					"dlc\dlc_acs\data\entities\other\gravehag_tongue.w2ent"

					,true ), thePlayer.GetWorldPosition() + thePlayer.GetWorldForward() * 3, thePlayer.GetWorldRotation());

					ent_1.AddTag('ACS_Gravehag_Tongue_Weapon_R');

					if( 
					thePlayer.GetInventory().GetItemName( sword_id ) == 'ACS_Mourntart_Silver'
					)
					{
						ent_1.AddTag('ACS_Mourntart_Tongue');

						ent_1.CreateAttachment(thePlayer, 'r_weapon', Vector(1.275,0.45,-0.8), EulerAngles(90,0,-90));
					}
					else
					{
						ent_1.CreateAttachment(thePlayer, 'r_weapon', Vector(1.275,0.45,-0.5), EulerAngles(90,0,-90));
					}

					animatedComponent_R = (CAnimatedComponent)((CNewNPC)ACSGetCActor('ACS_Gravehag_Tongue_Weapon_R')).GetComponentByClassName( 'CAnimatedComponent' );	

					animatedComponent_R.PlaySlotAnimationAsync ( 'grave_attack_tounge_whip_slow_mid_ACS', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f) );

					animatedComponent_R.FreezePoseFadeIn(3.25);
				}
			}
		}
		else if ( thePlayer.IsWeaponHeld( 'steelsword' ) )
		{
			thePlayer.GetInventory().GetItemEquippedOnSlot(EES_SteelSword, sword_id);

			if( 
			thePlayer.GetInventory().GetItemName( sword_id ) == 'ACS_Gravehag_Tongue_Steel'
			|| thePlayer.GetInventory().GetItemName( sword_id ) == 'ACS_Mourntart_Steel'
			)
			{
				if (!ACSGetCActor('ACS_Gravehag_Tongue_Weapon_R') 
				&& thePlayer.GetWeaponHolster().IsMeleeWeaponReady() 
				&& !thePlayer.GetWeaponHolster().IsOnTheMiddleOfHolstering() 
				&& !thePlayer.HasTag('ACS_IsManagingSword')
				)
				{
					if (thePlayer.IsAnyWeaponHeld() && !thePlayer.IsWeaponHeld('fist'))
					{
						thePlayer.RaiseEvent('ACS_CombatExtraReset');

						if (RandF() < 0.5)
						{
							thePlayer.RaiseEvent('ACS_SwordRepair');
						}
						else
						{
							thePlayer.RaiseEvent('ACS_SwordBuff');
						}

						IdleAdditiveBlockTemp();

						thePlayer.AddTag('ACS_SwordBuffAnimationPlayed');
					}

					ent_1 = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource(

					"dlc\dlc_acs\data\entities\other\gravehag_tongue.w2ent"

					,true ), thePlayer.GetWorldPosition() + thePlayer.GetWorldForward() * 3, thePlayer.GetWorldRotation());

					ent_1.AddTag('ACS_Gravehag_Tongue_Weapon_R');

					if( 
					thePlayer.GetInventory().GetItemName( sword_id ) == 'ACS_Mourntart_Steel'
					)
					{
						ent_1.AddTag('ACS_Mourntart_Tongue');

						ent_1.CreateAttachment(thePlayer, 'r_weapon', Vector(1.275,0.45,-0.8), EulerAngles(90,0,-90));
					}
					else
					{
						ent_1.CreateAttachment(thePlayer, 'r_weapon', Vector(1.275,0.45,-0.5), EulerAngles(90,0,-90));
					}

					animatedComponent_R = (CAnimatedComponent)((CNewNPC)ACSGetCActor('ACS_Gravehag_Tongue_Weapon_R')).GetComponentByClassName( 'CAnimatedComponent' );	

					animatedComponent_R.PlaySlotAnimationAsync ( 'grave_attack_tounge_whip_slow_mid_ACS', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f) );

					animatedComponent_R.FreezePoseFadeIn(3.25);
				}
			}
		}
		else
		{
			if (ACSGetCActor('ACS_Gravehag_Tongue_Weapon_R'))
			{
				

				ACSGetCActorDestroyAll('ACS_Gravehag_Tongue_Weapon_R');
			}
		}
	}

	///////////////////////////////////////////////////////////////////////

	function PrimaryLoopControl()
	{
		var item												: SItemUniqueId;

		this.TeleportWithRotation(thePlayer.GetWorldPosition(), theCamera.GetCameraRotation());

		if ((thePlayer.GetHorseCurrentlyMounted().GetHorseComponent()).IsFullyMounted())
		{
			if(FactsQuerySum("ACS_Player_Is_Currently_Mounted") <= 0)
			{
				FactsAdd("ACS_Player_Is_Currently_Mounted", 1, -1);
			}
		}
		else
		{
			if(FactsQuerySum("ACS_Player_Is_Currently_Mounted") > 0)
			{
				FactsRemove("ACS_Player_Is_Currently_Mounted");
			}
		}

		if( 
		theGame.IsDialogOrCutscenePlaying() 
		//|| theGame.GetPhotomodeEnabled() 
		|| thePlayer.IsInCutsceneIntro() 
		|| !thePlayer.IsAlive()
		//|| theGame.HasBlackscreenRequested()
		//|| theGame.IsBlackscreenOrFading()
		)
		{
			if (theGame.GetEngineTimeAsSeconds() - last_destroy_monster_refresh_time > 0.5)
			{
				last_destroy_monster_refresh_time = theGame.GetEngineTimeAsSeconds();

				DestroyCustomMonsters();
			}
		}
	}

	///////////////////////////////////////////////////////////////////////

	function ACSMarkerTeleport()
	{	
		var ents 											: array<CEntity>;
		var i												: int;
		var rot, newRot          							: EulerAngles;
		var position										: Vector;
		var id												: int;
		var x												: float;
		var y												: float;
		var type											: int;
		var area											: int;
		var size 											: int;

		if ( !theGame.IsDialogOrCutscenePlaying() 
		&& !theGame.IsFading()
		&& !theGame.IsBlackscreen()
		&& !theGame.IsPaused() 
		&& !theGame.GetPhotomodeEnabled() 
		&& !thePlayer.IsInCutsceneIntro() 
		)
		{
			rot = thePlayer.GetWorldRotation();

			rot.Pitch += 180;

			rot.Yaw += 180;

			newRot = VecToRotation( theCamera.GetCameraDirection() );

			newRot.Yaw += 180;

			newRot.Pitch = rot.Pitch;

			newRot.Roll = rot.Roll;

			ents.Clear();

			theGame.GetEntitiesByTag( 'ACS_All_Tracked_Quest_Entity', ents );	

			if (ents.Size() > 0)
			{
				for( i = 0; i < ents.Size(); i += 1 )
				{
					ents[i].TeleportWithRotation(ents[i].GetWorldPosition(), newRot );
				}
			}


			if (ACSGetCEntity('ACS_Guiding_Light_Marker'))
			{
				if(thePlayer.GetIsHorseRacing())
				{
					ACSGetCEntity('ACS_Guiding_Light_Marker').TeleportWithRotation( guiding_light_tracked_quest_position, newRot );
				}
				else
				{
					ACSGetCEntity('ACS_Guiding_Light_Marker').TeleportWithRotation( LerpV(ACSGetCEntity('ACS_Guiding_Light_Marker').GetWorldPosition(), guiding_light_tracked_quest_position, 0.1f), newRot );
				}
			}

			if (ACSGetCEntity('ACS_Guiding_Light_Horse_Marker'))
			{
				ACSGetCEntity('ACS_Guiding_Light_Horse_Marker').TeleportWithRotation( LerpV(ACSGetCEntity('ACS_Guiding_Light_Horse_Marker').GetWorldPosition(), (thePlayer.GetHorseWithInventory()).GetWorldPosition(), 0.1f), newRot );
			}

			if (ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker'))
			{
				ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').TeleportWithRotation( LerpV(ACSGetCEntity('ACS_Guiding_Light_Enemy_Marker').GetWorldPosition(), ACS_GetNearbyEnemyLocation(), 0.1f), newRot );
			}

			if (ACSGetCEntity('ACS_Guiding_Light_Merchant_Marker'))
			{
				ACSGetCEntity('ACS_Guiding_Light_Merchant_Marker').TeleportWithRotation( LerpV(ACSGetCEntity('ACS_Guiding_Light_Merchant_Marker').GetWorldPosition(), ACS_GetNearbyMerchantLocation(merchant_name), 0.1f), newRot );
			}

			if (ACSGetCEntity('ACS_Guiding_Light_POI_Marker'))
			{
				ACSGetCEntity('ACS_Guiding_Light_POI_Marker').TeleportWithRotation( LerpV(ACSGetCEntity('ACS_Guiding_Light_POI_Marker').GetWorldPosition(), guiding_light_closest_poi_point_position, 0.1f), newRot );
			}

			if (ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker'))
			{
				ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').TeleportWithRotation( LerpV(ACSGetCEntity('ACS_Guiding_Light_Available_Quest_Marker').GetWorldPosition(), guiding_light_available_quest_position, 0.1f), newRot );
			}

			if (ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker'))
			{
				size = theGame.GetCommonMapManager().GetUserMapPinCount();

				if (size > 0)
				{
					theGame.GetCommonMapManager().GetUserMapPinByIndex( (size - 1), id, area, position.X, position.Y, type );	
				}

				ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').TeleportWithRotation( LerpV(ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').GetWorldPosition(), position, 0.1f), newRot );
			}
			
		}
	}

	///////////////////////////////////////////////////////////////////////

	var player_current_target : CActor;

	var target_switched : bool;

	default target_switched = false;

	timer function CameraTargetSwitchConfirm(deltaTime : float, id : int) 
	{
		player_current_target = thePlayer.GetTarget();
	}

	var y_offsetHeadbone : float;

	function CameraTargetTeleport()
	{
		var entity, targetHeadTracker						: CEntity;
		var pos, targetPosition								: Vector;
		var headingDiff										: float;
		var targetDistance 									: float;

		if (!ACSGetCEntity('ACS_Camera_Head_Tracker_Target'))
		{
			entity = theGame.CreateEntity( (CEntityTemplate)LoadResource("dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent", true), thePlayer.GetBoneWorldPosition( 'pelvis' ), thePlayer.GetWorldRotation() );

			entity.AddTag('ACS_Camera_Head_Tracker_Target');
		}
		else
		{
			headingDiff = AngleDistance( VecHeading( theCamera.GetCameraDirection() ), VecHeading( thePlayer.GetHeadingVector() ) );

			targetDistance = VecDistanceSquared2D( theCamera.GetCameraPosition(), ACSGetCEntity('ACS_Camera_Head_Tracker_Target').GetWorldPosition() ) ;

			if (thePlayer.IsPerformingFinisher()
			|| thePlayer.HasTag('ACS_IsPerformingFinisher')
			|| thePlayer.HasTag('ACS_IsPerformingCombatDismember')
			) 
			{
				if (y_offsetHeadbone <= 0)
				{
					y_offsetHeadbone = 0;
				}
				else
				{
					if (targetDistance <= 6 * 6)
					{
						y_offsetHeadbone -= 0.001;
					}
					else
					{
						y_offsetHeadbone -= 0.01;
					}
				}

				ACSGetCEntity('ACS_Camera_Head_Tracker_Target').TeleportWithRotation(LerpV(ACSGetCEntity('ACS_Camera_Head_Tracker_Target').GetWorldPosition(), thePlayer.GetBoneWorldPosition( 'pelvis' ), 0.1), thePlayer.GetWorldRotation());
			}
			else
			{
				if (thePlayer.GetTarget()
				&& ACS_AttitudeCheck ((CActor)thePlayer.GetTarget())
				&& (thePlayer.IsInCombat() || thePlayer.IsThreatened())
				&& ACS_Settings_Main_Bool('acs_hud_camera_settings_main','acs_dynamic_camera_positioning_enabled', true)
				)
				{
					if (!thePlayer.WasVisibleInScaledFrame( ACSGetCEntity('ACS_Camera_Head_Tracker_Target'), 1, 1 ))
					{
						if (targetDistance <= 6 * 6)
						{
							y_offsetHeadbone += 0.001;
						}
						else
						{
							y_offsetHeadbone += 0.01;
						}
					}
					else
					{
						if (y_offsetHeadbone <= 0)
						{
							y_offsetHeadbone = 0;
						}
						else
						{
							if (targetDistance <= 6 * 6)
							{
								y_offsetHeadbone -= 0.001;
							}
							else
							{
								y_offsetHeadbone -= 0.01;
							}
						}
					}

					if ( ((CActor)thePlayer.GetTarget()).GetBoneIndex('head') != -1 )
					{
						targetPosition = ((CActor)thePlayer.GetTarget()).GetBoneWorldPosition('head');
						targetPosition.Z += 1;
					}
					else
					{
						if ( ((CActor)thePlayer.GetTarget()).GetBoneIndex('k_head_g') != -1 )
						{
							targetPosition = ((CActor)thePlayer.GetTarget()).GetBoneWorldPosition('k_head_g');
							targetPosition.Z += 1;
						}
						else
						{
							targetPosition = ((CActor)thePlayer.GetTarget()).GetWorldPosition();
							targetPosition.Z += 1;
						}
					}

					ACSGetCEntity('ACS_Camera_Head_Tracker_Target').TeleportWithRotation(targetPosition, ((CActor)thePlayer.GetDisplayTarget()).GetWorldRotation());
				}
				else
				{
					if (y_offsetHeadbone <= 0)
					{
						y_offsetHeadbone = 0;
					}
					else
					{
						if (targetDistance <= 6 * 6)
						{
							y_offsetHeadbone -= 0.001;
						}
						else
						{
							y_offsetHeadbone -= 0.01;
						}
					}

					ACSGetCEntity('ACS_Camera_Head_Tracker_Target').TeleportWithRotation( thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );
				}
			}
		}

		if (!ACSGetCEntity('ACS_Camera_Target'))
		{
			entity = theGame.CreateEntity( (CEntityTemplate)LoadResource("dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent", true), thePlayer.GetBoneWorldPosition( 'pelvis' ), thePlayer.GetWorldRotation() );

			entity.AddTag('ACS_Camera_Target');
		}
		else
		{
			if (thePlayer.IsPerformingFinisher()
			|| thePlayer.HasTag('ACS_IsPerformingFinisher')
			|| thePlayer.HasTag('ACS_IsPerformingCombatDismember')
			) 
			{
				if (target_switched)
				{
					RemoveTimer('CameraTargetSwitchConfirm');
					
					target_switched = false;
				}

				if (player_current_target != thePlayer)
				{
					player_current_target = thePlayer;
				}

				ACSGetCEntity('ACS_Camera_Target').TeleportWithRotation(LerpV(ACSGetCEntity('ACS_Camera_Target').GetWorldPosition(), thePlayer.GetBoneWorldPosition( 'pelvis' ), 0.05), thePlayer.GetWorldRotation());
			}
			else
			{
				if (thePlayer.GetTarget()
				&& ACS_AttitudeCheck ((CActor)thePlayer.GetTarget())
				&& thePlayer.IsInCombat()
				&& !theGame.IsFocusModeActive()
				&& ACS_Settings_Main_Bool('acs_hud_camera_settings_main','acs_dynamic_camera_positioning_enabled', true)
				)
				{
					pos = TraceFloor( (thePlayer.GetWorldPosition() + ((thePlayer.GetTarget()).GetWorldPosition())) * 0.5 );

					if (player_current_target != thePlayer.GetTarget())
					{
						ACSGetCEntity('ACS_Camera_Target').TeleportWithRotation( LerpV(ACSGetCEntity('ACS_Camera_Target').GetWorldPosition(), pos, 0.01), thePlayer.GetWorldRotation() );

						if (!target_switched)
						{
							RemoveTimer('CameraTargetSwitchConfirm');
							AddTimer('CameraTargetSwitchConfirm', 2 , false);

							target_switched = true;
						}
					}
					else
					{
						if (target_switched)
						{
							RemoveTimer('CameraTargetSwitchConfirm');

							target_switched = false;
						}

						ACSGetCEntity('ACS_Camera_Target').TeleportWithRotation( LerpV(ACSGetCEntity('ACS_Camera_Target').GetWorldPosition(), pos, 0.1), thePlayer.GetWorldRotation() );
					}
				}
				else
				{
					if (target_switched)
					{
						RemoveTimer('CameraTargetSwitchConfirm');

						target_switched = false;
					}

					if (player_current_target != thePlayer)
					{
						player_current_target = thePlayer;
					}

					ACSGetCEntity('ACS_Camera_Target').TeleportWithRotation(LerpV(ACSGetCEntity('ACS_Camera_Target').GetWorldPosition(), thePlayer.GetBoneWorldPosition( 'pelvis' ), 0.05), thePlayer.GetWorldRotation());
				}
			}
		}
	}

	///////////////////////////////////////////////////////////////////////

	function THE_EYE()
	{
		PrimaryLoopControl();

		if (!ACS_Settings_Main_Bool('acs_main_settings','acs_mod_enabled', true))
		{
			return;
		}
		
		if ( !theGame.IsDialogOrCutscenePlaying() 
		&& !thePlayer.IsInCutsceneIntro() 
		&& !theGame.IsCurrentlyPlayingNonGameplayScene() 
		&& !theGame.IsFading()
		&& !theGame.IsBlackscreen()
		&& !theGame.IsPaused()
		&& !theGame.GetPhotomodeEnabled() 
		&& ACS_Settings_Main_Float('acs_hud_settings_markers','acs_3d_markers_refresh_rate', 0.1) > 0
		)
		{
			if (theGame.GetEngineTimeAsSeconds() - last_guiding_light_refresh_time > ACS_Settings_Main_Float('acs_hud_settings_markers','acs_3d_markers_refresh_rate', 0.1))
			{
				last_guiding_light_refresh_time = theGame.GetEngineTimeAsSeconds();

				Guiding_Light_Compass_Bar_Display();

				Guiding_Light_Merchant_Scan();

				Guiding_Light_Horse_Marker();

				Guiding_Light_POI_Scan();

				Guiding_Light_Tracked_Quest_Scan();

				Guiding_Light_Available_Quest_Scan();

				Guiding_Light();

				Guiding_Light_User_Pin_Display();

				Guiding_Light_Enemy_Scan();

				Guiding_Light_Distance_Controller();
			}

			if (theGame.GetEngineTimeAsSeconds() - last_guiding_light_distance_refresh_time > 0.75)
			{
				last_guiding_light_distance_refresh_time = theGame.GetEngineTimeAsSeconds();

				Guiding_Light_Distance_Controller();
			}

			ACSMarkerTeleport();
		}

		if (theGame.GetEngineTimeAsSeconds() - last_cutscene_functions_refresh_time > 1)
		{
			last_cutscene_functions_refresh_time = theGame.GetEngineTimeAsSeconds();
			
			Human_Ice_Breathe_Controller_Spawner();
			
			ACS_Ether_Sword_Control();
			
			ACS_Helm_Equip();

			Guiding_Light_Navigation_Guide();

			Rainbow_Control();

			ACS_Horse_Lamp_Control();

			ACS_Wild_Hunt_Armor_Equipped();

			ACS_Knight_Armor_Equipped();

			Sword_Hold_Forcer();

			HudModulesAutoHide();

			Wearable_Pocket_Items_Controller();

			register_extra_inputs();
		}

		if( 
		theGame.IsDialogOrCutscenePlaying() 
		|| thePlayer.IsInCutsceneIntro()
		)
		{
			if (theGame.GetEngineTimeAsSeconds() - last_cutscene_functions_secondary_refresh_time > 1)
			{
				last_cutscene_functions_secondary_refresh_time = theGame.GetEngineTimeAsSeconds();

				Scabbard_Thing();
			}
		}
		else
		{
			Scabbard_Thing();
		}

		AdditionalStatBarControl('posture_bar');

		AdditionalStatBarControl('grey_health_bar');

		SkipDialogue();

		ACS_Set_Player_Scale();

		ManticoreShieldControl();

		Hair_Thing();

		Ghost_Stance_Control();

		Dual_Wield_Control();

		Spear_Transform_Control();

		Starfall_Control();

		Lightning_Strike();

		ACS_Focus_Mode_Env_Control();

		ClueCheck();

		ACS_SpiralSkyControl();

		MutePlayerControl();

		DisableCatFallback();

		ACS_Armor_Effects();

		GravehagWeaponControl();

		ACS_Pause_Control();

		//

		BowAndCrossbowCheck();

		WinGwent();

		Transformation_Control();

		Motion_Leaning();

		VampireClawsSprintHide();

		IncreaseSwimSpeed();

		IncreaseHorseSpeed();

		DrippingWater();

		if(Glide_Collision_Check()
		&& FactsQuerySum("ACS_Is_Gliding") > 0
		)
		{
			Glide_Stop();
		}

		SprintAdditiveDelay();

		Player_In_Combat();

		if( 
		theGame.IsDialogOrCutscenePlaying() 
		|| !thePlayer.IsAlive()
		|| thePlayer.IsInCutsceneIntro()
		|| theGame.HasBlackscreenRequested()
		|| theGame.IsCurrentlyPlayingNonGameplayScene()
		|| theGame.GetGuiManager().IsAnyMenu()
		|| theGame.GetTutorialSystem().HasActiveTutorial()
		|| theGame.GetPhotomodeEnabled() 
		)
		{
			return;
		}
			
		if (theGame.GetEngineTimeAsSeconds() - last_out_of_cutscene_functions_refresh_time > 0.75f)
		{
			last_out_of_cutscene_functions_refresh_time = theGame.GetEngineTimeAsSeconds();

			HorseRiderFollowTargetTeleport();

			ACS_Fog_Generate();

			ACS_Bubbles_Generate();

			Wisp_Levelup_Tutorial();
			
			AllBlackControl();

			ACS_Armor_Functions();
			
			ACS_EnemyBehSwitch_Watcher();
			
			Durability_Always_Max();

			ACS_Never_Time_Out();

			ACS_BlockInteractionModule();

			ACS_Give_Stuff();
			
			QuenIndicator();

			SetPlayerTargetAcquire();

			ACSSignComboIconCheck();

			ACS_Phantom_Weapon_Manager();

			ACS_NPC_Add_Health();

			//ACS_MonsterHunt.refreshHunt();

			BotchlingResize();

			ACS_Human_Death_Fear();

			LightFiresAuto();

			/*
			if (thePlayer.HasTag('ACS_Is_Sneaking')
			)
			{
				ACS_Sneaking_For_Hostile();
			}
			else
			{
				ACS_Sneaking_Revert();
			}
			*/
		}

		//ACS_GetNearbyEnemies();

		SneakControl();

		SwordWalkControl();

		StudyTarget();

		WingEntityTeleport();

		Sword_Persistent_Effects();

		RemoveEffectsFromPlayer();

		PlayerOverrideCamera();

		ForceGuardedStance();

		Critical_Low_Health_Fix();

		WalkTypeControl();

		FUCKING_SECOND_LIFE_HACK();

		LookatLoop();

		Manual_Camera_Control();

		//ACS_QuestTrackControl();

		AltBurnStopFailsafe();

		Interact_Loop();

		HorseInteractionSignPost();

		RoachStashInteraction();

		LootItemPreview();

		HorseInteractionShowFleeNotice();

		Grass_Collision_Magnifier();

		LogoControl();

		DoubleJumpFinishControl();

		ShipControls();

		CameraTargetTeleport();

		if (
		ACS_GetItem_Sword_IsEquipped('longsword_steel', 'steel') 
		|| ACS_GetItem_Sword_IsEquipped('longsword_silver', 'silver') 
		)
		{
			if (ACSGetCEntity('ACS_SwordExtensionStream'))
			{
				if (thePlayer.IsWeaponHeld('silversword'))
				{
					ACSGetCEntity('ACS_SwordExtensionStream').StopEffect('fire_stream_blue');
					ACSGetCEntity('ACS_SwordExtensionStream').PlayEffect('fire_stream_blue', ACSGetCEntity('ACS_SwordExtensionStreamAnchor'));
				}
				else if (thePlayer.IsWeaponHeld('steelsword'))
				{
					ACSGetCEntity('ACS_SwordExtensionStream').StopEffect('fire_stream_red');
					ACSGetCEntity('ACS_SwordExtensionStream').PlayEffect('fire_stream_red', ACSGetCEntity('ACS_SwordExtensionStreamAnchor'));
				}
			}
		}
		else
		{
			if (ACSGetCEntity('ACS_SwordExtensionStream'))
			{
				ACSGetCEntity('ACS_SwordExtensionStream').Destroy();
			}

			if (ACSGetCEntity('ACS_SwordExtensionStreamAnchor'))
			{
				ACSGetCEntity('ACS_SwordExtensionStreamAnchor').Destroy();
			}
		}

		AimEntityControl();

		FastTravelCameraStartDelay();
	}

	function AimEntityControl()
	{
		var aimImpactEntity 												: CEntity;

		if (!thePlayer.IsThrowingItemWithAim()
		&& !thePlayer.IsThrowHold())
		{
			if (ACSGetCEntity('ACS_Aim_Impact_Entity'))
			{
				ACSGetCEntity('ACS_Aim_Impact_Entity').Destroy();
			}

			return;
		}

		if (thePlayer.IsThrowingItemWithAim()
		|| thePlayer.IsThrowHold())
		{
			if (thePlayer.rangedWeapon.IsWeaponBeingUsed()
			)
			{
				if (ACS_Settings_Main_Bool('acs_misc_main_settings','acs_hide_crossbow_aim_marker', false))
				{
					if (ACSGetCEntity('ACS_Aim_Impact_Entity'))
					{
						ACSGetCEntity('ACS_Aim_Impact_Entity').Destroy();
					}

					return;
				}
			}
			else
			{
				if (ACS_Settings_Main_Bool('acs_misc_main_settings','acs_hide_bomb_aim_marker', false) )
				{
					if (ACSGetCEntity('ACS_Aim_Impact_Entity'))
					{
						ACSGetCEntity('ACS_Aim_Impact_Entity').Destroy();
					}

					return;
				}
			}
		}

		if (thePlayer.IsThrowingItemWithAim()
		|| thePlayer.IsThrowHold()
		)
		{
			if (!ACSGetCEntity('ACS_Aim_Impact_Entity'))
			{
				if (!thePlayer.rangedWeapon.IsWeaponBeingUsed()
				)
				{
					aimImpactEntity = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

					"dlc\dlc_acs\data\fx\bomb_markers\bomb_impact_marker.w2ent"

					, true ), thePlayer.GetWorldPosition() + Vector(0,0,-200), thePlayer.GetWorldRotation() );
				}
				else
				{
					aimImpactEntity = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

					"dlc\dlc_acs\data\fx\aim_marker\aim_impact_marker.w2ent"

					, true ), thePlayer.GetWorldPosition() + Vector(0,0,-200), thePlayer.GetWorldRotation() );
				}

				aimImpactEntity.AddTag('ACS_Aim_Impact_Entity');
			}
			else
			{
				ACSGetCEntity('ACS_Aim_Impact_Entity').TeleportWithRotation( thePlayer.playerAiming.GetThrowPosition(), thePlayer.GetWorldRotation() );	
			}
		}
		else
		{
			if (ACSGetCEntity('ACS_Aim_Impact_Entity'))
			{
				ACSGetCEntity('ACS_Aim_Impact_Entity').Destroy();
			}
		}
	}

	var menuChanged : bool;

	function ACS_Pause_Control()
	{
		var hud 															: CR4ScriptedHud;
		var minimapModule 													: CR4HudModuleMinimap2;	
		var questModule 													: CR4HudModuleQuests;	

		if (theGame.IsPaused())
		{
			if ( FactsQuerySum("ACS_Game_Paused") <= 0 )
			{
				Custom_Env_Switch('dof', false);

				Custom_Env_Switch('flare', false);

				Custom_Env_Switch('red_grass', false);

				Custom_Env_Switch('red_water', false);

				RemoveTimer('SwordTauntSwitch'); 
				RemoveTimer('SwordTauntRunningSwitch'); 
				 
				 
				
				thePlayer.RaiseEvent('ACS_SwordWalkAdditiveEnd');thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');RemoveTimer('CombatTauntDelay');

				if (thePlayer.HasTag('ACS_IsSwordWalking'))
				{
					thePlayer.RemoveTag('ACS_IsSwordWalking');
				}

				menuChanged = false;

				RemoveTimer('Menu_Changed_Reset');

				if (clair_obscur_music_enabled
				|| doom_music_enabled
				|| witcher_1_music_enabled
				|| witcher_2_music_enabled
				|| gwent_music_enabled
				|| witcher_3_select_music_enabled
				)
				{
					RemoveTimer('VolumeSetDelay');
					theGame.GetInGameConfigWrapper().SetVarValue('acs_misc_main_settings', 'acs_custom_combat_music_volume', 0);
				}

				FactsAdd("ACS_Game_Paused", 1, -1);
			}
		}
		else
		{
			if ( FactsQuerySum("ACS_Game_Paused") > 0 )
			{
				Custom_Env_Switch('dof', true);

				Custom_Env_Switch('flare', true);

				Custom_Env_Switch('red_grass', true);

				Custom_Env_Switch('red_water', true);

				menuChanged = true;

				RemoveTimer('Menu_Changed_Reset');
				AddTimer('Menu_Changed_Reset', 1 , false);

				hud = (CR4ScriptedHud)theGame.GetHud();

				minimapModule = (CR4HudModuleMinimap2)hud.GetHudModule("Minimap2Module");

				questModule = (CR4HudModuleQuests)hud.GetHudModule("QuestsModule");

				if (hud && (thePlayer.IsInCombat() || thePlayer.IsThreatened()))
				{
					minimapModule.SetEnabled(true);

					questModule.SetEnabled(true);
				}

				if (clair_obscur_music_enabled
				|| doom_music_enabled
				|| witcher_1_music_enabled
				|| witcher_2_music_enabled
				|| gwent_music_enabled
				|| witcher_3_select_music_enabled
				)
				{
					RemoveTimer('VolumeSetDelay');
					AddTimer('VolumeSetDelay', 1, false);
				}
				
				FactsRemove("ACS_Game_Paused");
			}
		}

	}

	timer function VolumeSetDelay( dt : float, id : int )
	{
		var j									: int;
		var size 								: int;
		var increase 							: bool;

		if (ACS_Settings_Main_Int('acs_misc_main_settings','acs_custom_combat_music_volume', 0) == 0)
		{
			return;
		}
		
		if (ACS_Settings_Main_Int('acs_misc_main_settings','acs_custom_combat_music_volume', 0) > 0)
		{
			increase = true;
		}
		else
		{
			increase = false;
		}

		size = Abs(ACS_Settings_Main_Int('acs_misc_main_settings','acs_custom_combat_music_volume', 0));

		if (size > 0)
		{
			for ( j=0; j<size; j+= 1 )
			{
				if (increase)
				{
					theSound.SoundEvent("music_offset_increase_clair_obscure_acs");

					theSound.SoundEvent("music_offset_increase_gwent_acs");

					theSound.SoundEvent("music_offset_increase_metal_mix_acs");

					theSound.SoundEvent("music_offset_increase_witcher_1_acs");

					theSound.SoundEvent("music_offset_increase_witcher_2_acs");

					theSound.SoundEvent("music_offset_increase_witcher_3_acs");
				}
				else
				{
					theSound.SoundEvent("music_offset_decrease_clair_obscure_acs");

					theSound.SoundEvent("music_offset_decrease_gwent_acs");

					theSound.SoundEvent("music_offset_decrease_metal_mix_acs");

					theSound.SoundEvent("music_offset_decrease_witcher_1_acs");

					theSound.SoundEvent("music_offset_decrease_witcher_2_acs");

					theSound.SoundEvent("music_offset_decrease_witcher_3_acs");
				}
			}
		}

		theGame.GetInGameConfigWrapper().SetVarValue('acs_misc_main_settings', 'acs_custom_combat_music_volume', 0);
	}

	function DoubleJumpFinishControl()
	{
		var movAdj 			: CMovementAdjustor;
		var ticket 			: SMovementAdjustmentRequestTicket;

		if (
		((!thePlayer.IsFalling()
		&& !thePlayer.IsInAir()
		&& ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() != 'None')
		|| thePlayer.GetCurrentStateName() != 'Exploration')
		&& FactsQuerySum("ACS_Has_Double_Jumped") > 0
		)
		{
			((CAnimatedComponent)(thePlayer).GetComponentByClassName('CAnimatedComponent')).UnfreezePoseFadeOut(0);

			((CAnimatedComponent)(thePlayer).GetComponentByClassName('CAnimatedComponent')).UnfreezePose();

			thePlayer.RaiseEvent('ACS_DodgeAdditiveEnd');

			(thePlayer.GetMovingAgentComponent()).SetEnabledFeetIK(false,0);
			(thePlayer.GetMovingAgentComponent()).SetEnabledSlidingOnSlopeIK( false );
			
			if (thePlayer.IsAnyWeaponHeld()
			&& !thePlayer.IsWeaponHeld('fist')
			)
			{
				RemoveTimer('CombatTauntDelay');
				RemoveTimer('SwordTauntRunningSwitchSecondary'); 
				RemoveTimer('SwordTauntRunningSwitchSecondaryWeaponBlood'); 
				AddTimer('SwordTauntRunningSwitchSecondary', 0.01 , false); 
			}

			RemoveTimer('DoubleJumpSlowMo');

			RemoveTimer('RemoveACSSlowmo');

			theGame.RemoveTimeScale( theGame.GetTimescaleSource(ETS_InstantKill) );

			thePlayer.RaiseEvent('ACS_TorsoBendReset');

			thePlayer.RaiseEvent('ACS_ForceHandClosedREnd');

			if (!thePlayer.HasTag('ACS_Dual_Wield_Active') && !ACSGetCEntity('ACS_Viper_Dagger_L')){thePlayer.RaiseEvent('ACS_ForceHandClosedLEnd');}

			if (FactsQuerySum("ACS_Has_Air_Dashed") > 0)
			{
				if (thePlayer.IsOnGround())
				{
					if (thePlayer.IsAnyWeaponHeld()
					&& !thePlayer.IsWeaponHeld('fist')
					)
					{
						if (thePlayer.IsWeaponHeld('fist') )
						{
							PlayerPlayAnimation( 'man_geralt_sword_dodge_roll_rp_f_01_fist' );
						}
						else
						{
							PlayerPlayAnimation( 'man_geralt_sword_dodge_roll_rp_f_01' );
						}
					}
					else
					{
						PlayerPlayAnimation( 'man_geralt_sword_dodge_roll_rp_f_01_fist' );
					}
				}
				else
				{
					if (thePlayer.IsAnyWeaponHeld()
					&& !thePlayer.IsWeaponHeld('fist')
					)
					{
						if (RandF() < 0.5)
						{
							PlayerPlayAnimation( 'land_crouch_lf_to_idle_sword' );
						}
						else
						{
							PlayerPlayAnimation( 'land_crouch_rf_to_idle_sword' );
						}
					}
					else
					{
						if (RandF() < 0.5)
						{
							PlayerPlayAnimation( 'land_crouch_lf_to_idle' );
						}
						else
						{
							PlayerPlayAnimation( 'land_crouch_rf_to_idle' );
						}
					}

					thePlayer.substateManager.QueueStateExternal('Land');
				}
			}
			else
			{
				if (FactsQuerySum("ACS_Double_Jump_SlowMo") <= 0)
				{
					PlayerPlayAnimation( '' );
				}
				
				thePlayer.substateManager.QueueStateExternal('Land');
			}

			thePlayer.StopEffect('jump_ground_fx1');
			thePlayer.PlayEffectSingle('jump_ground_fx1');

			FactsRemove("ACS_Double_Jump_SlowMo");

			FactsRemove("ACS_Has_Air_Dashed");

			FactsRemove("ACS_Has_Double_Jumped_Glide_Init");

			FactsRemove("ACS_Has_Double_Jumped");
		}
	}

	timer function DoubleJumpRollDelay( dt : float, id : int )
	{
		thePlayer.substateManager.QueueStateExternal('Roll');
	}

	function LogoControl()
	{
		if ( FactsQuerySum("q001_nightmare_ended") <= 0 
		)
		{
			if (!thePlayer.IsSpeaking(1064993))
			{
				return;
			}
			
			if ( FactsQuerySum("ACS_Has_Seen_Logo") <= 0 )
			{
				ACS_ShowLogo(true, 1.5, 125, 125);

				RemoveTimer('HideLogo');
				AddTimer('HideLogo', 10 , false);

				FactsAdd("ACS_Has_Seen_Logo", 1, -1);
			}
		}
		else
		{
			if(thePlayer.IsInCombat()
			|| thePlayer.IsThreatened()
			|| !CutsceneDelayCheck()
			|| !ACS_CombatToExplorationCheck()
			|| theGame.IsPaused()
			|| theGame.IsBlackscreenOrFading()
			)
			{
				return;
			}

			if ( FactsQuerySum("q001_ghouls_dead") > 0 )
			{
				if ( FactsQuerySum("ACS_Has_Seen_Logo") <= 0 )
				{
					RemoveTimer('ShowLogo');
					AddTimer('ShowLogo', 7 , false);

					FactsAdd("ACS_Has_Seen_Logo", 1, -1);
				}
			}
		}
	}

	public timer function ShowLogo ( dt : float, id : int)
	{
		ACS_ShowLogo(true, 1.5, 125, 125);

		RemoveTimer('HideLogo');
		AddTimer('HideLogo', 10 , false);
	}

	public timer function HideLogo ( dt : float, id : int)
	{
		ACS_ShowLogo(false, 1.5, 125, 125);	
	}

	function Grass_Collision_Magnifier()
	{
		if (ACS_Armor_Set_Check('acs_armor', false) || FactsQuerySum("acs_transformation_activated") > 0)
		{
			if (!ACSGetCEntity('ACS_Grass_Collision').HasTag('ACS_Grass_Collision_Attached'))
			{
				ACSGetCEntity('ACS_Grass_Collision').CreateAttachment( thePlayer, , Vector( 0, 0, 0 ), EulerAngles(0,0,0) );

				ACSGetCEntity('ACS_Grass_Collision').AddTag('ACS_Grass_Collision_Attached');
			}
			
		}
		else
		{
			if (ACSGetCEntity('ACS_Grass_Collision').HasTag('ACS_Grass_Collision_Attached'))
			{
				ACSGetCEntity('ACS_Grass_Collision').BreakAttachment();

				ACSGetCEntity('ACS_Grass_Collision').Teleport(thePlayer.GetWorldPosition() + Vector(0,0,-200));

				ACSGetCEntity('ACS_Grass_Collision').RemoveTag('ACS_Grass_Collision_Attached');
			}
		}
	}

	var vACS_Bats_Summon : cACS_Bats_Summon;

	public timer function ACS_Bats_Summon_Repeat ( dt : float, id : int)
	{
		if (thePlayer.HasTag('ACS_AardPull_Active'))
		{
			vACS_Bats_Summon = new cACS_Bats_Summon in this;
			vACS_Bats_Summon.ACS_Bats_Summon_Engage();
		}	
	}

	public timer function ACS_Bruxa_Camo_Sonar_Timer ( dt : float, id : int)
	{
		if (ACSGetCEntity('ACS_Bruxa_Camo_Sonar_2'))
		{
			ACSGetCEntity('ACS_Bruxa_Camo_Sonar_2').DestroyEffect('fx_sonar');

			ACSGetCEntity('ACS_Bruxa_Camo_Sonar_2').PlayEffectSingle('fx_sonar');

			ACSGetCEntity('ACS_Bruxa_Camo_Sonar_2').StopEffect('fx_sonar');
		}
		
		if (ACSGetCEntity('ACS_Bruxa_Camo_Sonar'))
		{
			ACSGetCEntity('ACS_Bruxa_Camo_Sonar').DestroyEffect('sonar_mesh');

			ACSGetCEntity('ACS_Bruxa_Camo_Sonar').PlayEffectSingle('sonar_mesh');

			ACSGetCEntity('ACS_Bruxa_Camo_Sonar').StopEffect('sonar_mesh');

			ACSGetCEntity('ACS_Bruxa_Camo_Sonar').DestroyEffect('sonar');

			ACSGetCEntity('ACS_Bruxa_Camo_Sonar').PlayEffectSingle('sonar');

			ACSGetCEntity('ACS_Bruxa_Camo_Sonar').StopEffect('sonar');
		}

		ACS_Bruxa_Camo_Sonar_NPC_Play_Effect();
	}

	public timer function ACS_npc_fear_reaction ( dt : float, id : int)
	{
		actors.Clear();

		actors = thePlayer.GetNPCsAndPlayersInRange( 20, 20, , FLAG_ExcludePlayer + FLAG_Attitude_Hostile + FLAG_OnlyAliveActors);

		if( actors.Size() > 0 )
		{
			for( i = 0; i < actors.Size(); i += 1 )
			{
				npc = (CNewNPC)actors[i];

				actor = actors[i];
				
				curTargetVitality = npc.GetStat( BCS_Vitality );

				maxTargetVitality = npc.GetStatMax( BCS_Vitality );

				curTargetEssence = npc.GetStat( BCS_Essence );

				maxTargetEssence = npc.GetStatMax( BCS_Essence );

				animatedComponentA = (CAnimatedComponent)npc.GetComponentByClassName( 'CAnimatedComponent' );	
				
				if ( npc == thePlayer  )
					continue;
				
				if(!theGame.IsDialogOrCutscenePlaying()
				&& !thePlayer.IsUsingHorse() 
				&& !thePlayer.IsUsingVehicle()
				&& !theGame.GetPhotomodeEnabled() 
				&& !thePlayer.IsInCutsceneIntro() 
				&& !theGame.IsCurrentlyPlayingNonGameplayScene() 
				&& !npc.IsUsingHorse()
				&& !npc.IsUsingVehicle()
				&& npc.IsHuman()
				&& !npc.HasTag('ACS_Final_Fear_Stack')
				)
				{				
					actor.RemoveBuffImmunity_AllNegative();

					actor.RemoveBuffImmunity_AllCritical();

					npc.RemoveBuffImmunity_AllNegative();

					npc.RemoveBuffImmunity_AllCritical();

					targetDistance = VecDistanceSquared2D( thePlayer.GetWorldPosition(), npc.GetWorldPosition() ) ;

					if( targetDistance <= 4 * 4) 
					{
						if (!npc.HasTag('fear_end'))
						{
							animatedComponentA.PlaySlotAnimationAsync ( '', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0, 0) );

							npc.AddTag('fear_end');
						}	
					}
					else if( targetDistance > 4 * 4 && targetDistance <= 100 * 100 ) 
					{
						npc.RemoveTag('fear_end');
						
						if (curTargetVitality <= maxTargetVitality * 0.25)
						{
							animatedComponentA.PlaySlotAnimationAsync ( 'reaction_surrender_escape', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.9f, 0.9f));
						}
						else if (curTargetVitality > maxTargetVitality * 0.25 && curTargetVitality <= maxTargetVitality * 0.5)
						{
							fear_index_1 = RandDifferent(this.previous_fear_index_1 , 8);

							switch (fear_index_1) 
							{	
								case 7:
								animatedComponentA.PlaySlotAnimationAsync ( 'man_ex_scared_loop_turn_right_180_rp', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.9f, 0.9f));
								break;

								case 6:
								animatedComponentA.PlaySlotAnimationAsync ( 'man_ex_scared_loop_turn_right_180_lp', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.9f, 0.9f));
								break;

								case 5:
								animatedComponentA.PlaySlotAnimationAsync ( 'man_ex_scared_loop_turn_left_90_rp', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.9f, 0.9f));
								break;

								case 4:
								animatedComponentA.PlaySlotAnimationAsync ( 'man_ex_scared_loop_turn_left_90_lp', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.9f, 0.9f));
								break;

								case 3:
								animatedComponentA.PlaySlotAnimationAsync ( 'man_ex_scared_loop_turn_left_45_rp', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.9f, 0.9f));
								break;

								case 2:
								animatedComponentA.PlaySlotAnimationAsync ( 'man_ex_scared_loop_turn_left_45_lp', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.9f, 0.9f));
								break;

								case 1:
								animatedComponentA.PlaySlotAnimationAsync ( 'man_ex_scared_loop_2', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.9f, 0.9f));
								break;

								default:
								animatedComponentA.PlaySlotAnimationAsync ( 'man_ex_scared_loop_1', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.9f, 0.9f));
								break;		
							}
							
							this.previous_fear_index_1 = fear_index_1;
						}
						else
						{
							fear_index_1 = RandDifferent(this.previous_fear_index_1 , 5);

							switch (fear_index_1) 
							{	
								case 4:
								animatedComponentA.PlaySlotAnimationAsync ( 'man_work_standing_nervous_scarred_stop', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.9f, 0.9f));
								break;

								case 3:
								animatedComponentA.PlaySlotAnimationAsync ( 'man_work_standing_nervous_scarred_start', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.9f, 0.9f));
								break;

								case 2:
								animatedComponentA.PlaySlotAnimationAsync ( 'man_work_standing_nervous_scarred_loop_03', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.9f, 0.9f));
								break;

								case 1:
								animatedComponentA.PlaySlotAnimationAsync ( 'man_work_standing_nervous_scarred_loop_02', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.9f, 0.9f));
								break;

								default:
								animatedComponentA.PlaySlotAnimationAsync ( 'man_work_standing_nervous_scarred_loop_01', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.9f, 0.9f));
								break;		
							}
							
							this.previous_fear_index_1 = fear_index_1;
						}
					}
				}	
			}
		}
	}

	function ACS_Human_Death_Fear()
	{
		var movementAdjustorNPC											: CMovementAdjustor;
		var ticketNPC													: SMovementAdjustmentRequestTicket;

		actors.Clear();

		//actors = thePlayer.GetNPCsAndPlayersInRange( 100, 100, , FLAG_ExcludePlayer + FLAG_Attitude_Hostile + FLAG_OnlyAliveActors);

		//actors = thePlayer.GetNPCsAndPlayersInRange( 100, 100, , FLAG_ExcludePlayer + FLAG_Attitude_Hostile + FLAG_OnlyAliveActors);

		theGame.GetActorsByTag( 'ACS_Final_Fear_Stack', actors );	

		if( actors.Size() > 0 )
		{
			for( i = 0; i < actors.Size(); i += 1 )
			{
				npc = (CNewNPC)actors[i];

				actor = actors[i];
				
				curTargetVitality = npc.GetStat( BCS_Vitality );

				maxTargetVitality = npc.GetStatMax( BCS_Vitality );

				curTargetEssence = npc.GetStat( BCS_Essence );

				maxTargetEssence = npc.GetStatMax( BCS_Essence );

				animatedComponentA = (CAnimatedComponent)npc.GetComponentByClassName( 'CAnimatedComponent' );

				movementAdjustorNPC = npc.GetMovingAgentComponent().GetMovementAdjustor();

				targetDistance = VecDistanceSquared2D( thePlayer.GetWorldPosition(), npc.GetWorldPosition() ) ;
				
				if(!theGame.IsDialogOrCutscenePlaying()
				&& !thePlayer.IsUsingHorse() 
				&& !thePlayer.IsUsingVehicle()
				&& !theGame.GetPhotomodeEnabled() 
				&& !thePlayer.IsInCutsceneIntro() 
				//&& !theGame.IsCurrentlyPlayingNonGameplayScene() 
				&& !npc.IsUsingHorse()
				&& !npc.IsUsingVehicle()
				&& npc.IsHuman()
				&& npc.IsMan()
				//&& GetAttitudeBetween( thePlayer, npc ) == AIA_Hostile
				//&& !npc.HasTag('ACS_Swapped_To_Shield')
				//&& !thePlayer.IsInNonGameplayCutscene() 
				&& !thePlayer.IsInGameplayScene() 
				//&& !theGame.IsCurrentlyPlayingNonGameplayScene()
				&& !theGame.IsFading()
				&& !theGame.IsBlackscreen()
				&& !theGame.IsPaused() 
				&& npc.IsAlive()
				&& ((CNewNPC)npc).GetNPCType() != ENGT_Quest
				)								
				{
					ticketNPC = movementAdjustorNPC.GetRequest( 'ACS_NPC_Fear_Rotate');
					movementAdjustorNPC.CancelByName( 'ACS_NPC_Fear_Rotate' );
					movementAdjustorNPC.CancelAll();

					ticketNPC = movementAdjustorNPC.CreateNewRequest( 'ACS_NPC_Fear_Rotate' );
					movementAdjustorNPC.AdjustmentDuration( ticketNPC, 0.25 );
					movementAdjustorNPC.MaxRotationAdjustmentSpeed( ticketNPC, 500000 );

					npc.SetGuarded(false);

					npc.DrainStamina( ESAT_FixedValue, npc.GetStatMax( BCS_Stamina ), 60 );

					if (!npc.HasBuff(EET_Blindness))
					{
						npc.AddEffectDefault( EET_Blindness, npc, 'ACS_NPC_Fear' );
					}
					
					if (!npc.HasBuff(EET_BleedingTracking))
					{
						npc.AddEffectDefault( EET_BleedingTracking, npc, 'ACS_NPC_Fear' );
					}

					(npc.GetInventory().GetItemEntityUnsafe( npc.GetInventory().GetItemFromSlot( 'r_weapon' ) )).SetHideInGame(true);

					fear_anim_names.Clear();

					if (npc.HasTag('ACS_Scared_On_Ground'))
					{
						if (npc.HasTag('ACS_Scared_On_Ground_Loop'))
						{
							if( RandF() < 0.9 ) 
							{
								fear_anim_names.PushBack('man_ex_scared_ground_loop_1');
							}
							else
							{
								fear_anim_names.PushBack('man_ex_scared_ground_loop_2');
							}

							animatedComponentA.PlaySlotAnimationAsync ( fear_anim_names[RandRange(fear_anim_names.Size())], 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.75f, 0.75f));
						}
						else
						{
							if( targetDistance <= 4 * 4) 
							{
								if( RandF() < 0.125 ) 
								{
									fear_anim_names.PushBack('man_ex_scared_ground_loop_1');
									fear_anim_names.PushBack('man_ex_scared_ground_loop_2');

									animatedComponentA.PlaySlotAnimationAsync ( fear_anim_names[RandRange(fear_anim_names.Size())], 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(1.f, 1.f));
								}
								else
								{
									fear_anim_names.PushBack('man_ex_scared_ground_start_1');
									fear_anim_names.PushBack('man_ex_scared_ground_start_2');

									movementAdjustorNPC.RotateTowards( ticketNPC, thePlayer );

									animatedComponentA.PlaySlotAnimationAsync ( fear_anim_names[RandRange(fear_anim_names.Size())], 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.5f, 0.5f));
								}	
							}
							else if( targetDistance > 4 * 4 ) 
							{
								if( RandF() < 0.875 ) 
								{
									fear_anim_names.PushBack('man_ex_scared_ground_loop_1');
									fear_anim_names.PushBack('man_ex_scared_ground_loop_2');

									animatedComponentA.PlaySlotAnimationAsync ( fear_anim_names[RandRange(fear_anim_names.Size())], 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(1.f, 1.f));
								}
								else
								{
									fear_anim_names.PushBack('man_ex_scared_ground_start_1');
									fear_anim_names.PushBack('man_ex_scared_ground_start_2');

									movementAdjustorNPC.RotateTowards( ticketNPC, thePlayer );

									animatedComponentA.PlaySlotAnimationAsync ( fear_anim_names[RandRange(fear_anim_names.Size())], 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.5f, 0.5f));
								}
							}
							else
							{
								movementAdjustorNPC.RotateTowards( ticketNPC, thePlayer, RandRangeF(225,135) );

								animatedComponentA.PlaySlotAnimationAsync ( 'dialogue_man_ex_scared_run_loop', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));
							}
						}
					}
					else if (npc.HasTag('ACS_Scared_Standing'))
					{
						if( targetDistance <= 4 * 4) 
						{
							if( RandF() < 0.125 ) 
							{
								fear_anim_names.PushBack('scared_loop');
								fear_anim_names.PushBack('scared_loop_1');
								fear_anim_names.PushBack('scared_loop_2');
								fear_anim_names.PushBack('scared_loop_3');
								fear_anim_names.PushBack('man_ex_scared_loop_1');
								fear_anim_names.PushBack('man_ex_scared_loop_2');

								movementAdjustorNPC.RotateTowards( ticketNPC, thePlayer );

								animatedComponentA.PlaySlotAnimationAsync ( fear_anim_names[RandRange(fear_anim_names.Size())], 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(1.f, 1.f));
							}
							else
							{
								movementAdjustorNPC.RotateTowards( ticketNPC, thePlayer, RandRangeF(225,135) );

								animatedComponentA.PlaySlotAnimationAsync ( 'dialogue_man_ex_scared_run_loop', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));
							}
						}
						else if( targetDistance > 4 * 4 ) 
						{
							if( RandF() < 0.875 ) 
							{
								fear_anim_names.PushBack('scared_loop');
								fear_anim_names.PushBack('scared_loop_1');
								fear_anim_names.PushBack('scared_loop_2');
								fear_anim_names.PushBack('scared_loop_3');
								fear_anim_names.PushBack('man_ex_scared_loop_1');
								fear_anim_names.PushBack('man_ex_scared_loop_2');

								movementAdjustorNPC.RotateTowards( ticketNPC, thePlayer );

								animatedComponentA.PlaySlotAnimationAsync ( fear_anim_names[RandRange(fear_anim_names.Size())], 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(1.f, 1.f));
							}
							else
							{
								movementAdjustorNPC.RotateTowards( ticketNPC, thePlayer, RandRangeF(225,135) );

								animatedComponentA.PlaySlotAnimationAsync ( 'dialogue_man_ex_scared_run_loop', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));
							}
						}
						else
						{
							movementAdjustorNPC.RotateTowards( ticketNPC, thePlayer, RandRangeF(225,135) );

							animatedComponentA.PlaySlotAnimationAsync ( 'dialogue_man_ex_scared_run_loop', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));
						}
					}
					else 
					{
						movementAdjustorNPC.RotateTowards( ticketNPC, thePlayer, RandRangeF(225,135) );

						animatedComponentA.PlaySlotAnimationAsync ( 'dialogue_man_ex_scared_run_loop', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));
					}
				}	
			}
		}
	}


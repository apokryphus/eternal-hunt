			{
				ACSGetCEntity('ACS_Transformation_Giant_Back_Weapons').PlayEffect('lightning_hit_ascended');
			}

			if (!ACSGetCEntity('ACS_Transformation_Giant_Back_Weapons').IsEffectActive('charge_ascended'))
			{
				ACSGetCEntity('ACS_Transformation_Giant_Back_Weapons').PlayEffect('charge_ascended');
			}

			if (ACSGetCActor('ACS_Transformation_Giant').HasTag('ACS_Transformation_Giant_Weapon_Mode'))
			{

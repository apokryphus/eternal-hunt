	function WingEntityTeleport()
	{
		if (!ACSGetCEntity('ACS_Wings_Entity_Anchor'))
		{
			return;
		}

		ACSGetCEntity('ACS_Wings_Entity_Anchor').TeleportWithRotation(thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation());
	}

	function BotchlingResize()
	{
		var meshcomp														: CComponent;
		var animcomp														: CAnimatedComponent;
		var h 																: float;

		if (!ACSGetCActor('ACS_Botchling'))
		{
			return;
		}

		if (!ACSGetCActor('ACS_Botchling').HasTag('ACS_Botchling_Resize_Start'))
		{
			ACSGetCActor('ACS_Botchling').PlayEffect('fx_quest_q103');
			ACSGetCActor('ACS_Botchling').StopEffect('fx_quest_q103');

			ACSGetCActor('ACS_Botchling').PlayEffect('appear_fx');
			ACSGetCActor('ACS_Botchling').PlayEffect('morph_fx');

			ACSGetCActor('ACS_Botchling').StopEffect('appear_fx');
			ACSGetCActor('ACS_Botchling').StopEffect('morph_fx');

			ACSGetCActor('ACS_Botchling').SetVisibility( false );

			AddTimer('BotchlingGrowTimer', 0.01 , true);

			ACSGetCActor('ACS_Botchling').AddTag('ACS_Botchling_Resize_Start');
		}
	}

	private var botchlingScale 																		: float;

	default botchlingScale 																			= 1;

	public timer function BotchlingGrowTimer ( dt : float, id : int)
	{ 
		if (botchlingScale >= 2)
		{
			ACSGetCActor('ACS_Botchling').DestroyEffect('appear_fx');
			ACSGetCActor('ACS_Botchling').DestroyEffect('morph_fx');

			ACSGetCActor('ACS_Botchling').PlayEffect('appear_fx');
			ACSGetCActor('ACS_Botchling').PlayEffect('morph_fx');

			ACSGetCActor('ACS_Botchling').StopEffect('appear_fx');
			ACSGetCActor('ACS_Botchling').StopEffect('morph_fx');

			ACSGetCActor('ACS_Botchling').AddTag('ACS_Botchling_Resize_Complete');

			ACSGetCActor('ACS_Botchling').SetVisibility( true );

			RemoveTimer('BotchlingGrowTimer');
		}
		else
		{
			BotchlingGrowActual();
		}	
	}

	function BotchlingGrowActual()
	{
		var meshcomp														: CComponent;
		var animcomp														: CAnimatedComponent;

		animcomp = (CAnimatedComponent)ACSGetCActor('ACS_Botchling').GetComponentByClassName('CAnimatedComponent');
		meshcomp = ACSGetCActor('ACS_Botchling').GetComponentByClassName('CMeshComponent');

		if (botchlingScale >= 2)
		{
			ACSGetCActor('ACS_Botchling').DestroyEffect('appear_fx');
			ACSGetCActor('ACS_Botchling').DestroyEffect('morph_fx');

			ACSGetCActor('ACS_Botchling').PlayEffect('appear_fx');
			ACSGetCActor('ACS_Botchling').PlayEffect('morph_fx');

			ACSGetCActor('ACS_Botchling').StopEffect('appear_fx');
			ACSGetCActor('ACS_Botchling').StopEffect('morph_fx');

			ACSGetCActor('ACS_Botchling').AddTag('ACS_Botchling_Resize_Complete');

			ACSGetCActor('ACS_Botchling').SetVisibility( true );

			RemoveTimer('BotchlingGrowTimer');
		}
		else
		{
			meshcomp.SetScale(Vector(
				
			botchlingScale += 0.01,
			botchlingScale += 0.01,
			botchlingScale += 0.01

			));

			animcomp.SetScale(Vector(
				
			botchlingScale += 0.01,
			botchlingScale += 0.01,
			botchlingScale += 0.01

			));
		}
	}

	var vACS_EnemyBehSwitch 	: cACS_EnemyBehSwitch;

	function ACS_EnemyBehSwitch_Watcher()
	{
		if (!ACS_Settings_Main_Bool('acs_encounters_enhanced_abilities_settings','acs_one_handed_sword_behavior_swap_enabled', true) )
		{
			return;
		}

		vACS_EnemyBehSwitch = new cACS_EnemyBehSwitch in this;

		vACS_EnemyBehSwitch.EnemyBehSwitch();
	}

	function Interact_Loop()
	{
		var component 								: CInteractionComponent;
		var noticeboard								: W3NoticeBoard;
		var merchant								: W3MerchantNPC;
		var container								: W3Container;
		var action_name								: name;
		var newNpc									: CNewNPC;
		var stash									: W3Stash;
		var clueStash								: W3MonsterClue;
		var ladder 									: W3LadderInteraction;
		var illusion								: W3IllusionaryObstacle;
		var horseComponent							: W3HorseComponent;
		var horse 									: CActor;
		var boatComponent							: CBoatComponent;
		var boat									: W3Boat;
		var poster									: W3Poster;
		var collectiblePlaces						: W3CollectiblePlaces;
		var interactionSwitch						: W3InteractionSwitch;
		var lightEntity								: CLightEntitySimpleWithEffectImmunity;
		var scheduledUsableEntity					: CScheduledUsableEntity;
		var weatherShrine							: W3WeatherShrine;
		var leaderboardCustom						: W3LeaderboardCustom;
		var teleportEntity							: CTeleportEntity;
		var smartObject								: W3SmartObject;
		var signReactive							: CSignReactiveEntity;
		var newDoor									: W3NewDoor;
		var dismantlingTable						: W3MutagenDismantlingTable;
		var monsterNest								: CMonsterNestEntity;
		var acsNest									: CACSMonsterNestEntity;
		var houseDecoration							: W3HouseDecorationBase;
		var lockableEntity							: W3LockableEntity;
		var door									: W3Door;
		var beehiveStanding							: W3BeehiveStandingEntity;
		var beehive									: CBeehiveEntity;
		var animatedInteraction						: W3AnimationInteractionEntity;
		var alchemyTable							: W3AlchemyTable;
		var containerRemains						: W3ActorRemains;
		var vehicle									: CVehicleComponent;

		if (!ACS_Settings_Main_Bool('acs_misc_main_settings','acs_interaction_buffer_enabled', false))
		{
			return;
		}

		component = theGame.GetInteractionsManager().GetActiveInteraction();

		if (!component)
		{
			return;
		}
		
		if (!component.IsEnabled())
		{
			return;
		}

		if( thePlayer.GetPlayerAction() != PEA_None )
		{
			return;
		}

		if (
		theInput.GetActionValue('Interact') > 0.1
		|| theInput.GetActionValue('InteractHold') > 0.1
		) 
		{
			action_name = component.GetInputActionName();

			container = (W3Container)component.GetEntity();

			if (container) 
			{
				container.OnInteraction(action_name, (CEntity)thePlayer);
				return;
			}

			noticeboard = (W3NoticeBoard)component.GetEntity();

			if (noticeboard) 
			{
				noticeboard.OnInteraction(action_name, (CEntity)thePlayer);
				return;
			}

			merchant = (W3MerchantNPC)component.GetEntity();

			if (merchant && theInput.GetActionValue('Focus') > 0.1f) 
			{
				merchant.OnInteraction(action_name, (CEntity)thePlayer);
				return;
			}

			newNpc = (CNewNPC)component.GetEntity();

			if (newNpc && theInput.GetActionValue('Focus') > 0.1f) 
			{
				newNpc.OnInteraction(action_name, (CEntity)thePlayer);
				return;
			}

			stash = (W3Stash)component.GetEntity();

			if (stash) 
			{
				stash.OnInteraction(action_name, (CEntity)thePlayer);
				return;
			}
			
			clueStash = (W3MonsterClue)component.GetEntity();

			if (clueStash) 
			{
				clueStash.OnInteraction(action_name, (CEntity)thePlayer);
				return;
			}

			containerRemains = (W3ActorRemains)component.GetEntity();

			if (containerRemains) 
			{
				containerRemains.OnInteraction(action_name, (CEntity)thePlayer);
				return;
			}

			illusion = (W3IllusionaryObstacle)component.GetEntity();

			if (illusion) 
			{
				illusion.OnInteraction(action_name, (CEntity)thePlayer);
				return;
			}

			alchemyTable = (W3AlchemyTable)component.GetEntity();

			if (alchemyTable) 
			{
				alchemyTable.OnInteraction(action_name, (CEntity)thePlayer);
				return;
			}

			animatedInteraction = (W3AnimationInteractionEntity)component.GetEntity();

			if (animatedInteraction) 
			{
				animatedInteraction.OnInteraction(action_name, (CEntity)thePlayer);
				return;
			}

			beehive = (CBeehiveEntity)component.GetEntity();

			if (beehive) 
			{
				beehive.OnInteraction(action_name, (CEntity)thePlayer);
				return;
			}

			beehiveStanding = (W3BeehiveStandingEntity)component.GetEntity();

			if (beehiveStanding) 
			{
				beehiveStanding.OnInteraction(action_name, (CEntity)thePlayer);
				return;
			}

			door = (W3Door)component.GetEntity();

			if (door) 
			{
				door.OnInteraction(action_name, (CEntity)thePlayer);
				return;
			}

			lockableEntity = (W3LockableEntity)component.GetEntity();

			if (lockableEntity) 
			{
				lockableEntity.OnInteraction(action_name, (CEntity)thePlayer);
				return;
			}

			monsterNest = (CMonsterNestEntity)component.GetEntity();

			if (monsterNest) 
			{
				monsterNest.OnInteraction(action_name, (CEntity)thePlayer);
				return;
			}

			acsNest = (CACSMonsterNestEntity)component.GetEntity();

			if (acsNest) 
			{
				acsNest.OnInteraction(action_name, (CEntity)thePlayer);
				return;
			}

			dismantlingTable = (W3MutagenDismantlingTable)component.GetEntity();

			if (dismantlingTable) 
			{
				dismantlingTable.OnInteraction(action_name, (CEntity)thePlayer);
				return;
			}

			newDoor = (W3NewDoor)component.GetEntity();

			if (newDoor) 
			{
				newDoor.OnInteraction(action_name, (CEntity)thePlayer);
				return;
			}
			
			signReactive = (CSignReactiveEntity)component.GetEntity();

			if (signReactive) 
			{
				signReactive.OnInteraction(action_name, (CEntity)thePlayer);
				return;
			}

			teleportEntity = (CTeleportEntity)component.GetEntity();

			if (teleportEntity) 
			{
				teleportEntity.OnInteraction(action_name, (CEntity)thePlayer);
				return;
			}

			weatherShrine = (W3WeatherShrine)component.GetEntity();

			if (weatherShrine) 
			{
				weatherShrine.OnInteraction(action_name, (CEntity)thePlayer);
				return;
			}

			scheduledUsableEntity = (CScheduledUsableEntity)component.GetEntity();

			if (scheduledUsableEntity) 
			{
				scheduledUsableEntity.OnInteraction(action_name, (CEntity)thePlayer);
				return;
			}

			lightEntity = (CLightEntitySimpleWithEffectImmunity)component.GetEntity();

			if (lightEntity) 
			{
				lightEntity.OnInteraction(action_name, (CEntity)thePlayer);
				return;
			}

			interactionSwitch = (W3InteractionSwitch)component.GetEntity();

			if (interactionSwitch) 
			{
				interactionSwitch.OnInteraction(action_name, (CEntity)thePlayer);
				return;
			}

			collectiblePlaces = (W3CollectiblePlaces)component.GetEntity();

			if (collectiblePlaces) 
			{
				collectiblePlaces.OnInteraction(action_name, (CEntity)thePlayer);
				return;
			}
		}
	}

	var roach_stash_available : bool;

	function RoachStashInteraction()
	{
		var component 								: CInteractionComponent;
		var roach_stash								: W3ACSRoachStash;
		var action_name								: name;
		var l_iconPath								: string;

		component = theGame.GetInteractionsManager().GetActiveInteraction();

		if (!component)
		{
			if(roach_stash_available)
			{
				GetACSStorage().acs_deleteOnelinerByTag("ACS_Roach_Stash_Indicator");

				roach_stash_available = false;
			}

			return;
		}
		
		if (!component.IsEnabled())
		{
			if(roach_stash_available)
			{
				GetACSStorage().acs_deleteOnelinerByTag("ACS_Roach_Stash_Indicator");

				roach_stash_available = false;
			}

			return;
		}

		if( thePlayer.GetPlayerAction() != PEA_None )
		{
			if(roach_stash_available)
			{
				GetACSStorage().acs_deleteOnelinerByTag("ACS_Roach_Stash_Indicator");

				roach_stash_available = false;
			}

			return;
		}

		if( 
		theGame.IsDialogOrCutscenePlaying() 
		|| !thePlayer.IsAlive()
		|| thePlayer.IsInCutsceneIntro()
		|| theGame.HasBlackscreenRequested()
		|| theGame.IsCurrentlyPlayingNonGameplayScene()
		|| theGame.GetGuiManager().IsAnyMenu()
		|| theGame.GetTutorialSystem().HasActiveTutorial()
		|| theGame.GetPhotomodeEnabled() 
		|| thePlayer.IsInCutsceneIntro() 
		)
		{
			if(roach_stash_available)
			{
				GetACSStorage().acs_deleteOnelinerByTag("ACS_Roach_Stash_Indicator");

				roach_stash_available = false;
			}

			return;
		}

		roach_stash = (W3ACSRoachStash)component.GetEntity();

		if (roach_stash) 
		{
			if(!roach_stash_available)
			{
				roach_stash_available = true;
			}

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Roach_Stash_Indicator");

			l_iconPath = FormatIconPath("icons/inventory/acs_marker_poi.xbm");

			ACS_Oneliner(
			(new ACS_Oneliner_TagBuilder in theGame)
			.tag("font")
			.attr("size", "24")
			.attr("color", "#ffffffff")
			.text(l_iconPath + "<br/>" + "[" + GetLocStringById(2116581212) + "]")
			, roach_stash, "ACS_Roach_Stash_Indicator", Vector(0,0,0), 0.5);

			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Roach_Stash_Indicator", 100);

			GetACSStorage().acs_setScaleForOnelinerByTag("ACS_Roach_Stash_Indicator", 100, 100, 100);
		}
		else
		{
			if(roach_stash_available)
			{
				GetACSStorage().acs_deleteOnelinerByTag("ACS_Roach_Stash_Indicator");

				roach_stash_available = false;
			}
		}
	}

	function HorseInteractionSignPost()
	{
		var component 								: CInteractionComponent;
		var signpost								: W3FastTravelEntity;
		var action_name								: name;
		var mapManager 								: CCommonMapManager = theGame.GetCommonMapManager();
		var initData 								: W3MapInitData;
		var l_iconPath								: string;
		var horseAnimatedComponent 					: CAnimatedComponent;

		component = theGame.GetInteractionsManager().GetActiveInteraction();

		if (!component)
		{
			if(FactsQuerySum("ACS_Fast_Travel_Map_Enabled") > 0)
			{
				theGame.GetSecondScreenManager().SendFastTravelDisable();

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Horse_Fast_Travel_Indicator");

				FactsRemove("ACS_Fast_Travel_Map_Enabled");
			}

			return;
		}
		
		if (!component.IsEnabled())
		{
			if(FactsQuerySum("ACS_Fast_Travel_Map_Enabled") > 0)
			{
				theGame.GetSecondScreenManager().SendFastTravelDisable();

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Horse_Fast_Travel_Indicator");

				FactsRemove("ACS_Fast_Travel_Map_Enabled");
			}

			return;
		}

		if( thePlayer.GetPlayerAction() != PEA_None )
		{
			if(FactsQuerySum("ACS_Fast_Travel_Map_Enabled") > 0)
			{
				theGame.GetSecondScreenManager().SendFastTravelDisable();

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Horse_Fast_Travel_Indicator");

				FactsRemove("ACS_Fast_Travel_Map_Enabled");
			}

			return;
		}

		if( FactsQuerySum("ACS_Player_Is_Currently_Mounted") <= 0)
		{
			if(FactsQuerySum("ACS_Fast_Travel_Map_Enabled") > 0)
			{
				theGame.GetSecondScreenManager().SendFastTravelDisable();

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Horse_Fast_Travel_Indicator");

				FactsRemove("ACS_Fast_Travel_Map_Enabled");
			}

			return;
		}

		if( 
		theGame.IsDialogOrCutscenePlaying() 
		|| !thePlayer.IsAlive()
		|| thePlayer.IsInCutsceneIntro()
		|| theGame.HasBlackscreenRequested()
		|| theGame.IsCurrentlyPlayingNonGameplayScene()
		|| theGame.GetGuiManager().IsAnyMenu()
		|| theGame.GetTutorialSystem().HasActiveTutorial()
		|| theGame.GetPhotomodeEnabled() 
		|| thePlayer.IsInCutsceneIntro() 
		)
		{
			GetACSStorage().acs_deleteOnelinerByTag("ACS_Horse_Fast_Travel_Indicator");

			return;
		}

		signpost = (W3FastTravelEntity)component.GetEntity();

		if (signpost) 
		{
			GetACSStorage().acs_deleteOnelinerByTag("ACS_Horse_Fast_Travel_Indicator");

			l_iconPath = FormatIconPath("icons/inventory/acs_marker_quest_untracked.xbm");

			ACS_Oneliner(
			(new ACS_Oneliner_TagBuilder in theGame)
			.tag("font")
			.attr("size", "24")
			.attr("color", "#ffffae")
			.text(l_iconPath + "<br/>" + "[" + GetLocStringById(2118449725) + "]")
			, signpost, "ACS_Horse_Fast_Travel_Indicator", Vector(0,0,2.5), 0.5);

			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Horse_Fast_Travel_Indicator", 100);

			GetACSStorage().acs_setScaleForOnelinerByTag("ACS_Horse_Fast_Travel_Indicator", 100, 100, 100);
		}
		
		if (
		theInput.GetActionValue('HorseJump') > 0.1
		) 
		{
			action_name = component.GetInputActionName();

			signpost = (W3FastTravelEntity)component.GetEntity();

			if (signpost) 
			{
				if ( !thePlayer.IsActionAllowed( EIAB_OpenMap ))
				{
					thePlayer.DisplayActionDisallowedHudMessage(EIAB_OpenMap);

					return;
				}

				if(!thePlayer.IsActionAllowed( EIAB_FastTravel ) )
				{
					thePlayer.DisplayActionDisallowedHudMessage(EIAB_FastTravel);		

					return;	
				}

				if ( !theGame.IsBlackscreenOrFading() )
				{
					if(FactsQuerySum("ACS_Fast_Travel_Map_Enabled") <= 0)
					{
						theGame.GetSecondScreenManager().SendFastTravelEnable();

						initData = new W3MapInitData in this;
						initData.SetUsedFastTravelEntity( this );
						initData.ignoreSaveSystem = true;
						initData.setDefaultState('FastTravel');
				
						theGame.RequestMenuWithBackground( 'MapMenu', 'CommonMenu', initData );

						theInput.ForceDeactivateAction('HorseJump');
	
						//horseAnimatedComponent = (CAnimatedComponent)(thePlayer.GetHorseCurrentlyMounted()).GetComponentByClassName( 'CAnimatedComponent' );	
						
						//horseAnimatedComponent.PlaySlotAnimationAsync( 'horse_rearing01', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.125, 0.125));

						FactsAdd("ACS_Fast_Travel_Map_Enabled", 1, -1);
					}
				}
			}

			return;
		}

		if(FactsQuerySum("ACS_Fast_Travel_Map_Enabled") > 0)
		{
			theGame.GetSecondScreenManager().SendFastTravelDisable();

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Horse_Fast_Travel_Indicator");

			FactsRemove("ACS_Fast_Travel_Map_Enabled");
		}
	}

	var acs_lootDisplayProximityPopupPreviewCheck : bool; 

	var previewContainer						: W3Container;

	timer function LootPreviewShowDelay( time : float , id : int )
	{
		var allItems								: array< SItemUniqueId >;
		var i 										: int;
		var l_itemName, l_iconPath, fontSize 		: string;
		var qty, qlty								: int;

		if (previewContainer) 
		{
			GetACSStorage().acs_deleteOnelinerByTag("ACS_ItemPopupPreview");

			previewContainer.GetInventory().GetAllItems( allItems );

			for(i=0; i<allItems.Size(); i+=1)
			{						
				if( previewContainer.GetInventory().ItemHasTag(allItems[i], 'Lootable' ) || !previewContainer.GetInventory().ItemHasTag(allItems[i], 'NoDrop') && !previewContainer.GetInventory().ItemHasTag(allItems[i], theGame.params.TAG_DONT_SHOW))
				{
					fontSize = FloatToStringPrec(ACS_Settings_Main_Float('acs_hud_settings_markers','acs_3D_loot_popups_size', 27) * RandRangeF(1, 0.75), 0);

					l_itemName = GetLocStringByKeyExt(previewContainer.GetInventory().GetItemLocalizedNameByUniqueID(allItems[i]));

					l_iconPath = "<img src='img://" + previewContainer.GetInventory().GetItemIconPathByUniqueID(allItems[i]) + "' height='" + fontSize + "' width='" + fontSize + "' vspace='-5' />&nbsp;";

					l_itemName = l_iconPath + l_itemName;

					qlty = RoundMath(CalculateAttributeValue( previewContainer.GetInventory().GetItemAttributeValue(allItems[i], 'quality' ) ) );

					switch(qlty)
					{
						case 5:
						l_itemName = "<font color='#00b000'>" + l_itemName + "</font>";
						break;

						case 4:
						l_itemName = "<font color='#ff6c00'>" + l_itemName + "</font>";
						break;

						case 3:
						l_itemName = "<font color='#c9c900'>" + l_itemName + "</font>";
						break;

						case 2:
						l_itemName = "<font color='#1451ff'>" + l_itemName + "</font>";
						break;

						case 1:
						l_itemName = "<font color='#ffffff'>" + l_itemName + "</font>";
						break;

						default:
						l_itemName = "<font color='#ffffff'>" + l_itemName + "</font>";
						break;
					}

					qty = previewContainer.GetInventory().GetItemQuantity(allItems[i]);

					if (qty > 1) 
					{
						l_itemName += " x " + qty;
					}

					ACS_Oneliner(
					(new ACS_Oneliner_TagBuilder in theGame)
					.tag("font")
					.attr("size", fontSize)
					.attr("color", "#ffffff")
					.text(l_itemName)
					, previewContainer, "ACS_ItemPopupPreview", Vector(RandRangeF(0.75,-0.75),RandRangeF(0.75,-0.75),RandRangeF(1.75,0)), 999, 10).run_indicator('popup_static');
				}
			}
		}
	}

	function LootItemPreview()
	{
		var component 								: CInteractionComponent;

		if (!ACS_Settings_Main_Bool('acs_hud_settings_markers','acs_3D_loot_popups_enabled', true))
		{
			if(acs_lootDisplayProximityPopupPreviewCheck)
			{
				RemoveTimer('LootPreviewShowDelay');

				GetACSStorage().acs_deleteOnelinerByTag("ACS_ItemPopupPreview");

				acs_lootDisplayProximityPopupPreviewCheck = false;
			}
			
			return;
		}

		component = theGame.GetInteractionsManager().GetActiveInteraction();

		if (!component)
		{
			if(acs_lootDisplayProximityPopupPreviewCheck)
			{
				RemoveTimer('LootPreviewShowDelay');

				//GetACSStorage().acs_deleteOnelinerByTag("ACS_ItemPopupPreview");

				acs_lootDisplayProximityPopupPreviewCheck = false;
			}

			return;
		}
		
		if (!component.IsEnabled())
		{
			if(acs_lootDisplayProximityPopupPreviewCheck)
			{
				RemoveTimer('LootPreviewShowDelay');

				//GetACSStorage().acs_deleteOnelinerByTag("ACS_ItemPopupPreview");

				acs_lootDisplayProximityPopupPreviewCheck = false;
			}

			return;
		}

		if( 
		theGame.IsDialogOrCutscenePlaying() 
		|| !thePlayer.IsAlive()
		|| thePlayer.IsInCutsceneIntro()
		|| theGame.HasBlackscreenRequested()
		|| theGame.IsCurrentlyPlayingNonGameplayScene()
		|| theGame.GetGuiManager().IsAnyMenu()
		|| theGame.GetTutorialSystem().HasActiveTutorial()
		|| theGame.GetPhotomodeEnabled() 
		|| thePlayer.IsInCutsceneIntro() 
		)
		{
			if(acs_lootDisplayProximityPopupPreviewCheck)
			{
				RemoveTimer('LootPreviewShowDelay');

				GetACSStorage().acs_deleteOnelinerByTag("ACS_ItemPopupPreview");

				acs_lootDisplayProximityPopupPreviewCheck = false;
			}

			return;
		}

		previewContainer = (W3Container)component.GetEntity();

		if (previewContainer) 
		{
			if (theInput.GetActionValue('GI_AxisLeftY') != 0
			|| theInput.GetActionValue('GI_AxisLeftX') != 0
			|| AbsF(theInput.GetActionValue( 'GI_AxisRightX' )) > 0
			|| AbsF(theInput.GetActionValue( 'GI_MouseDampX' )) > 0
			|| AbsF(theInput.GetActionValue( 'GI_AxisRightY' )) > 0
			|| AbsF(theInput.GetActionValue( 'GI_MouseDampY' )) > 0
			)
			{
				if(acs_lootDisplayProximityPopupPreviewCheck)
				{
					RemoveTimer('LootPreviewShowDelay');

					GetACSStorage().acs_deleteOnelinerByTag("ACS_ItemPopupPreview");

					acs_lootDisplayProximityPopupPreviewCheck = false;
				}

				return;
			}

			if(!acs_lootDisplayProximityPopupPreviewCheck)
			{
				//GetACSStorage().acs_deleteOnelinerByTag("ACS_ItemPopupPreview");

				RemoveTimer('LootPreviewShowDelay');

				AddTimer('LootPreviewShowDelay', 0.5 , false);

				acs_lootDisplayProximityPopupPreviewCheck = true;
			}
		}
	}

	var horseIndicatorActive : bool;

	var last_horse_indicator_check : float;

	function HorseInteractionShowFleeNotice()
	{
		var controlsFeedbackModule 			: CR4HudModuleControlsFeedback;
		var hud 							: CR4ScriptedHud;
		var params 							: SCustomEffectParams;

		if(theGame.GetEngineTimeAsSeconds() - last_horse_indicator_check > 0.5)
		{
			last_horse_indicator_check = theGame.GetEngineTimeAsSeconds();

			if( (thePlayer.GetHorseWithInventory())
			&& (thePlayer.GetHorseWithInventory()).IsAlive()
			&& !thePlayer.IsSailing() 
			&& !thePlayer.IsUsingHorse() 
			&& !thePlayer.IsUsingVehicle() 
			)
			{
				if ( thePlayer.GetHorseWithInventory().HasTag('ACS_Roach_Is_Following') )
				{
					if (!horseIndicatorActive)
					{
						menuChanged = true;

						RemoveTimer('Menu_Changed_Reset');
						AddTimer('Menu_Changed_Reset', 1 , false);

						horseIndicatorActive = true;
					}

					RemoveTimer('ForceControlModuleHudUpdate');
					AddTimer('ForceControlModuleHudUpdate', 0.25f , false);
				}
				else
				{
					if( 
					VecDistanceSquared( thePlayer.GetWorldPosition(), (thePlayer.GetHorseWithInventory()).GetWorldPosition() ) <= 4 * 4 
					&& (thePlayer.IsSprintActionPressed() 
					|| thePlayer.GetIsSprintToggled()
					|| thePlayer.GetIsSprinting())
					)
					{
						if (!horseIndicatorActive)
						{
							menuChanged = true;

							RemoveTimer('Menu_Changed_Reset');
							AddTimer('Menu_Changed_Reset', 1 , false);

							horseIndicatorActive = true;
						}

						RemoveTimer('ForceControlModuleHudUpdate');
						AddTimer('ForceControlModuleHudUpdate', 0.25f , false);
					}
					else
					{
						if( VecDistanceSquared( thePlayer.GetWorldPosition(), (thePlayer.GetHorseWithInventory()).GetWorldPosition() ) <= 2 * 2 
						)
						{
							if (!horseIndicatorActive)
							{
								menuChanged = true;

								RemoveTimer('Menu_Changed_Reset');
								AddTimer('Menu_Changed_Reset', 1 , false);
								
								horseIndicatorActive = true;
							}

							RemoveTimer('ForceControlModuleHudUpdate');
							AddTimer('ForceControlModuleHudUpdate', 0.25f , false);
						}
						else if( VecDistanceSquared( thePlayer.GetWorldPosition(), (thePlayer.GetHorseWithInventory()).GetWorldPosition() ) > 2 * 2
						&& VecDistanceSquared( thePlayer.GetWorldPosition(), (thePlayer.GetHorseWithInventory()).GetWorldPosition() ) <= 4 * 4
						)
						{
							if (!horseIndicatorActive)
							{
								menuChanged = true;

								RemoveTimer('Menu_Changed_Reset');
								AddTimer('Menu_Changed_Reset', 1 , false);

								horseIndicatorActive = true;
							}

							RemoveTimer('ForceControlModuleHudUpdate');
							AddTimer('ForceControlModuleHudUpdate', 0.25f , false);
						} 
						else
						{
							if (horseIndicatorActive)
							{
								menuChanged = true;

								RemoveTimer('Menu_Changed_Reset');
								AddTimer('Menu_Changed_Reset', 1 , false);

								RemoveTimer('ForceControlModuleHudUpdate');
								AddTimer('ForceControlModuleHudUpdate', 0.25f , false);

								horseIndicatorActive = false;
							}
						}
					}
				}
			}
			else
			{
				if (horseIndicatorActive)
				{
					menuChanged = true;

					RemoveTimer('Menu_Changed_Reset');
					AddTimer('Menu_Changed_Reset', 1 , false);

					RemoveTimer('ForceControlModuleHudUpdate');
					AddTimer('ForceControlModuleHudUpdate', 0.25f , false);

					horseIndicatorActive = false;
				}
			}
		}
	}

	timer function StudyTargetRemoveTimer( time : float , id : int )
	{
		GetACSStorage().acs_deleteOnelinerByTag("ACS_Study_Target_Oneliner");

		theGame.RemoveTimeScale( theGame.GetTimescaleSource(ETS_InstantKill) );

		if( FactsQuerySum("ACS_Study_Target_Active") > 0)
		{
			FactsRemove("ACS_Study_Target_Active");
		}
	}

	function StudyTarget()
	{
		var strHealthColor, strHealth, strNpcCategory, strElemental, strPhysical 																													: string;
		var npc 																																		: CActor;
		var slashingResPts, piercingResPts, bludgeoningResPts, rendingResPts, elementalResPts, physicalResPts, bleedingResPts, poisonResPts, fireResPts, frostResPts, shockResPts, forceResPts, freezeResPts, willResPts, burningResPts, dotBurningDamageResPts, dotPoisonDamageResPts, dotBleedingDamageResPts 						: float;
		var slashingResPerc, piercingResPerc, bludgeoningResPerc, rendingResPerc, elementalResPerc, physicalResPerc, bleedingResPerc, poisonResPerc, fireResPerc, frostResPerc, shockReserc, forceResPerc, freezeResPerc, willResPerc, burningResPerc, dotBurningDamageResPerc, dotPoisonDamageResPerc, dotBleedingDamageResPerc		: float;
		var zAdjust, xAdjust : float;
		var targetDistance, targetdistanceAdjust 										: float;
		var fontsize1, fontsize2 : string;

		if( FactsQuerySum("ACS_Study_Target_Active") > 0 )
		{
			npc = (CActor)thePlayer.GetTarget();

			targetDistance = VecDistanceSquared2D( thePlayer.GetWorldPosition(), npc.GetWorldPosition() ) ;

			if (targetDistance <= 10 * 10)
			{
				targetdistanceAdjust = 10 * 10;
			}
			else if (targetDistance >= 17.5 * 17.5)
			{
				targetdistanceAdjust = 17.5 * 17.5;
			}
			else
			{
				targetdistanceAdjust = targetDistance;
			}

			if (!npc)
			{
				GetACSStorage().acs_deleteOnelinerByTag("ACS_Study_Target_Oneliner");

				return;
			}

			npc.GetResistValue(CDS_PhysicalRes, physicalResPts, physicalResPerc);
			npc.GetResistValue(CDS_SlashingRes, slashingResPts, slashingResPerc);
			npc.GetResistValue(CDS_PiercingRes, piercingResPts, piercingResPerc);
			npc.GetResistValue(CDS_BludgeoningRes, bludgeoningResPts, bludgeoningResPerc);

			npc.GetResistValue(CDS_RendingRes, rendingResPts, rendingResPerc);
			npc.GetResistValue(CDS_BleedingRes, bleedingResPts, bleedingResPerc);
			npc.GetResistValue(CDS_PoisonRes, poisonResPts, poisonResPerc);

			npc.GetResistValue(CDS_DoTBleedingDamageRes, dotBleedingDamageResPts, dotBleedingDamageResPerc);
			npc.GetResistValue(CDS_DoTPoisonDamageRes, dotPoisonDamageResPts, dotPoisonDamageResPerc);

			npc.GetResistValue(CDS_ElementalRes, elementalResPts, elementalResPerc);
			npc.GetResistValue(CDS_ShockRes, shockResPts, shockReserc);
			npc.GetResistValue(CDS_ForceRes, forceResPts, forceResPerc);
			npc.GetResistValue(CDS_WillRes, willResPts, willResPerc);

			npc.GetResistValue(CDS_FireRes, fireResPts, fireResPerc);
			npc.GetResistValue(CDS_FrostRes, frostResPts, frostResPerc);
			npc.GetResistValue(CDS_BurningRes, burningResPts, burningResPerc);
			npc.GetResistValue(CDS_FreezeRes, freezeResPts, freezeResPerc);

			npc.GetResistValue(CDS_DoTBurningDamageRes, dotBurningDamageResPts, dotBurningDamageResPerc);
			
			if ((npc.GetMovingAgentComponent().GetName() == "woman_base"
			|| npc.GetMovingAgentComponent().GetName() == "man_base")
			&& !npc.HasTag( 'ethereal' )
			&& !npc.HasAbility('q604_shades')
			)
			{
				strNpcCategory += GetLocStringById(397225); // human
			}
			else
			{
				if 
				(
					npc.HasAbility('mon_boar_base')
					|| npc.HasAbility('mon_bear_base')
					|| npc.GetSfxTag() == 'sfx_wild_dog'
					|| npc.GetSfxTag() == 'sfx_wolf'
					|| npc.GetSfxTag() == 'sfx_bear'
					|| npc.HasAbility('mon_panther_base')
					|| npc.HasAbility('mon_q704_ft_pigs_evil')
					|| npc.HasAbility('mon_boar_ep2_base')
				)
				{
					strNpcCategory += GetLocStringById(2116581260); // beasts
				}
				else if 
				(
					npc.HasAbility('mon_lycanthrope')
					|| npc.GetSfxTag() == 'sfx_werewolf'
					|| npc.HasAbility('mon_archespor_base')
					|| npc.HasAbility('mon_q704_ft_wilk')
					|| npc.HasAbility('mon_toad_base')
				)
				{
					strNpcCategory += GetLocStringById(338940); // cursed ones
				}
				else if 
				(
					npc.GetSfxTag() == 'sfx_cockatrice'
					|| npc.HasAbility('mon_basilisk')
					|| npc.HasAbility('mon_forktail_young')
					|| npc.HasAbility('mon_forktail')
					|| npc.HasAbility('mon_forktail_mh')
					|| npc.GetSfxTag() == 'sfx_wyvern'
					|| npc.HasAbility('mon_mq7010_dracolizard')
					|| npc.HasAbility('mon_draco_base')
					|| npc.HasAbility('mon_mq7018_basilisk')
					|| npc.HasAbility('mon_basilisk')
				)
				{
					strNpcCategory += GetLocStringById(338945); // draconids
				}
				else if 
				(
					npc.GetSfxTag() == 'sfx_elemental_dao' 	
					|| npc.GetSfxTag() == 'sfx_golem'
					|| npc.GetSfxTag() == 'sfx_elemental_ifryt'
					|| npc.GetSfxTag() == 'sfx_wildhunt_minion'
					|| npc.HasAbility('mon_ice_golem')
					|| npc.HasAbility('mon_gargoyle')
					|| npc.HasAbility('mon_dark_pixie_base')
					|| npc.HasAbility('mon_q704_ft_pixies')
					|| npc.HasAbility('mon_graveir')
				)
				{
					strNpcCategory += GetLocStringById(169144); // elementa
				}
				else if 
				(
					npc.GetSfxTag() == 'sfx_gryphon'
					|| npc.HasAbility('mon_erynia')
					|| npc.GetSfxTag() == 'sfx_harpy'
					|| npc.HasAbility('mon_erynia')
					|| npc.GetSfxTag() == 'sfx_siren'
					|| npc.HasAbility('mon_erynia')
				)

				}
			}
			break;

			case 'horsePanicBar':
			{
				baseHud = (CR4HudModuleBase)hud.GetHudModule("HorsePanicBarModule");

				horsePanicModule = (CR4HudModuleHorsePanicBar)hud.GetHudModule("HorsePanicBarModule");

				l_flashModule = horsePanicModule.GetModuleFlash();


			break;

			case 'geraltRandomMageCounter':
				PlayerPlayAnimation( 'man_mage_cast_shield_02_ACS');

				AddTimer('MageAttackCone', 0.5   , false);
			break;

			case 'geraltRandomYrdenCounter':

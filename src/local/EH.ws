						case 3:
						ACSTransformationGiantPlayAnim( 'giant_combat_anchor_attack_close_br_2_acs_ice_giant', 0.25f, 0.325f);
						//kick/stomp
						break;

						case 2:
						ACSTransformationGiantPlayAnim( 'giant_combat_anchor_attack_close_r_2_acs_ice_giant', 0.25f, 0.325f);
						//kick_stomp

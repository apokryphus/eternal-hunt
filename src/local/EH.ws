	function red_lightning_storm()
	{
		RemoveTimer('red_lightning_storm_timer');
		AddTimer('red_lightning_storm_timer', 0.001 , true);

		RemoveTimer('red_lightning_storm_disable');
		AddTimer('red_lightning_storm_disable', 15   , false);
	}

	timer function red_lightning_storm_timer ( dt : float, id : int){if(theGame.GetEngineTimeAsSeconds() - last_red_lightning_time > RandRangeF(2,1)){last_red_lightning_time = theGame.GetEngineTimeAsSeconds();ACS_Red_Lightning();}} 

	timer function red_lightning_storm_disable( dt : float , optional id : int)
	{
		RemoveTimer('red_lightning_storm_timer');
	}

	function sorcfxspawn( fxtag : name )
	{
		var temp															: CEntityTemplate;
		var ent																: CACSSorcFistAttacks;	
		var adjustedRot														: EulerAngles;
		var adjustedPos														: Vector;
		var actortarget														: CActor;
		var entities 														: array<CEntity>;
		var i																: int;
	
		entities.Clear();

		theGame.GetEntitiesByTag( 'ACS_Sorc_Attack', entities );	
		
		for( i = 0; i < entities.Size(); i += 1 )
		{
			entities[i].Destroy();
		}

		temp = (CEntityTemplate)LoadResource( 

		"dlc\dlc_acs\data\entities\other\acs_sorc_fist_attacks.w2ent"
			
		, true );

		if (thePlayer.IsInCombat())
		{
			if (thePlayer.GetTarget())
			{
				actortarget = (CActor)thePlayer.GetTarget();

				adjustedPos = actortarget.GetWorldPosition();
			}
			else
			{
				adjustedPos = thePlayer.GetWorldPosition() + thePlayer.GetWorldForward() * 10;
			}
		}
		else
		{
			adjustedPos = thePlayer.GetWorldPosition() + thePlayer.GetWorldForward() * 10;
		}

		adjustedPos.Z += 1.25;

		adjustedRot = thePlayer.GetWorldRotation();
		
		ent = (CACSSorcFistAttacks)theGame.CreateEntity( temp, adjustedPos, adjustedRot );

		ent.AddTag(fxtag);

		ent.AddTag('ACS_Sorc_Attack');

		ent.DestroyAfter(7);
	}

	var vACS_Dagger_Summon : cACS_Dagger_Summon;


	var vACS_Throw_Knife: cACS_Throw_Knife;

	public timer function Throw_Knife_Delay_Timer(deltaTime : float , id : int)
	{
		var itemIds 				: array<SItemUniqueId>;
		var l_iconPath, l_text		: string;

		MovementAdjust('default');

		if( actor && ACS_AttitudeCheck ( actor ) && thePlayer.IsInCombat())
		{	
			if ( ACS_Settings_Main_Int('acs_target_settings','acs_target_mode', 0) == 0 || ACS_Settings_Main_Int('acs_target_settings','acs_target_mode', 0) == 1 )
			{
				if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTowards( ticket, actor );}  
			}
			else if ( ACS_Settings_Main_Int('acs_target_settings','acs_target_mode', 0) == 2 )
			{
				if (thePlayer.IsHardLockEnabled())
				{
					if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTowards( ticket, actor );}  
				}
				else
				{
					if(!thePlayer.HasTag('ACS_Manual_Combat_Control')){thePlayer.AddTag('ACS_Manual_Combat_Control');} RemoveTimer('Manual_Combat_Control_Remove'); AddTimer('Manual_Combat_Control_Remove', 2 , false);//if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTo( ticket, VecHeading( theCamera.GetCameraDirection() ) );}
				}	
			}
		}
		else
		{
			Attack_Process_Direction();
		}

		itemIds.Clear();

		itemIds = thePlayer.inv.GetItemsByName('ACS_Knife');

		if (itemIds.Size() > 0)
		{
			knifeCount = thePlayer.inv.GetItemQuantityByName('ACS_Knife');
		}
		else
		{
			knifeCount = 0;
		}

		GetACSStorage().acs_deleteOnelinerByTag("ACS_Throw_Notification_Oneliner");

		if (knifeCount > 0)
		{
			l_iconPath = "<img src='img://" + thePlayer.inv.GetItemIconPathByUniqueID(itemIds[0]) + "' height='" + 60 + "' width='" + 60 + "' vspace='0' />&nbsp;";

			ACS_Oneliner(
			(new ACS_Oneliner_TagBuilder in theGame)
			.tag("font")
			.attr("size", "22")
			.attr("color", "#ffffff")
			.text(l_iconPath + "<br/>" + " [" + GetLocStringById(2118449925) + "]" + "<br/>" + "x" + IntToString(knifeCount))
			, ACSGetCEntity('ACS_Throw_Notification_Oneliner_Attachment_Dummy'), "ACS_Throw_Notification_Oneliner", Vector(0,0,-0.25), 2);
		}
		else
		{
			ACS_Oneliner(
			(new ACS_Oneliner_TagBuilder in theGame)
			.tag("font")
			.attr("size", "22")
			.attr("color", "#ffffff")
			.text("<br/>" + "[" + GetLocStringById(2118449926) + "]" + "<br/>")
			, ACSGetCEntity('ACS_Throw_Notification_Oneliner_Attachment_Dummy'), "ACS_Throw_Notification_Oneliner", Vector(0,0,-0.25), 1);
		}

		GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Throw_Notification_Oneliner", 100);

		GetACSStorage().acs_setScaleForOnelinerByTag("ACS_Throw_Notification_Oneliner", 100, 100, 100);

		if (GetACSKnifeProjectile())
		{
			vACS_Throw_Knife = new cACS_Throw_Knife in this;

			vACS_Throw_Knife.ACS_Throw_Knife_Engage();
		}
	}

	var knifeCount 																									: int; 

	function geraltThrowKnife()
	{
		var ent 					: CEntity;
		var bone_vec				: Vector;
		var bone_rot				: EulerAngles;
		var itemId 					: SItemUniqueId;
		var l_iconPath, l_text		: string;
		var itemIds 				: array<SItemUniqueId>;

		itemIds.Clear();

		itemIds = thePlayer.inv.GetItemsByName('ACS_Knife');

		if (itemIds.Size() > 0)
		{
			knifeCount = thePlayer.inv.GetItemQuantityByName('ACS_Knife');
		}
		else
		{
			knifeCount = 0;
		}

		ACSGetCEntity('ACS_Throw_Notification_Oneliner_Attachment_Dummy').Destroy();

		thePlayer.GetBoneWorldPositionAndRotationByIndex( thePlayer.GetBoneIndex( 'l_shoulderRoll' ), bone_vec, bone_rot );

		ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
		"dlc\dlc_acs\data\fx\sign_icons.w2ent"
		, true ), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );

		ent.CreateAttachmentAtBoneWS( thePlayer, 'l_shoulderRoll', bone_vec, bone_rot );

		ent.AddTag('ACS_Throw_Notification_Oneliner_Attachment_Dummy');

		ent.DestroyAfter(5);

		GetACSStorage().acs_deleteOnelinerByTag("ACS_Throw_Notification_Oneliner");

		if (knifeCount > 0)
		{
			l_iconPath = "<img src='img://" + thePlayer.inv.GetItemIconPathByUniqueID(itemIds[0]) + "' height='" + 60 + "' width='" + 60 + "' vspace='0' />&nbsp;";

			ACS_Oneliner(
			(new ACS_Oneliner_TagBuilder in theGame)
			.tag("font")
			.attr("size", "22")
			.attr("color", "#ffffff")
			.text(l_iconPath + "<br/>" + " [" + GetLocStringById(2118449925) + "]" + "<br/>" + "x" + IntToString(knifeCount))
			, ent, "ACS_Throw_Notification_Oneliner", Vector(0,0,-0.25), 1);

			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Throw_Notification_Oneliner", 100);

			GetACSStorage().acs_setScaleForOnelinerByTag("ACS_Throw_Notification_Oneliner", 100, 100, 100);

			vACS_Throw_Knife = new cACS_Throw_Knife in this;

			vACS_Throw_Knife.ACS_Prepare_Knife_Engage();

			if ( !theSound.SoundIsBankLoaded("mq_nml_1035.bnk") )
			{
				theSound.SoundLoadBank( "mq_nml_1035.bnk", false );
			}

			GetWitcherPlayer().SoundEvent("scene_weapon_sword_unsheat_fast");
			
			MovementAdjust('default');

			thePlayer.inv.RemoveItemByName('ACS_Knife', 1);

			RemoveTimer('Throw_Knife_Delay_Timer');

			//thePlayer.RaiseEvent('ACS_ThrowDagger');

			thePlayer.SoundEvent("q601_dagger_throw");

			if(thePlayer.GetCombatIdleStance() <= 0.f )
			{
				thePlayer.RaiseEvent('ACS_SwordGlintPocketSandL');
			}
			else
			{
				thePlayer.RaiseEvent('ACS_SwordGlintPocketSandR');
			}

			if (thePlayer.HasTag('ACS_IsSwordWalking')){thePlayer.RemoveTag('ACS_IsSwordWalking');}

			if( actor && ACS_AttitudeCheck ( actor ) && thePlayer.IsInCombat())
			{	
				if ( ACS_Settings_Main_Int('acs_target_settings','acs_target_mode', 0) == 0 || ACS_Settings_Main_Int('acs_target_settings','acs_target_mode', 0) == 1 )
				{
					if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTowards( ticket, actor );}  
				}
				else if ( ACS_Settings_Main_Int('acs_target_settings','acs_target_mode', 0) == 2 )
				{
					if (thePlayer.IsHardLockEnabled())
					{
						if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTowards( ticket, actor );}  
					}
					else
					{
						if(!thePlayer.HasTag('ACS_Manual_Combat_Control')){thePlayer.AddTag('ACS_Manual_Combat_Control');} RemoveTimer('Manual_Combat_Control_Remove'); AddTimer('Manual_Combat_Control_Remove', 2 , false);//if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTo( ticket, VecHeading( theCamera.GetCameraDirection() ) );}
					}	
				}
			}
			else
			{
				if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTo( ticket, VecHeading( theCamera.GetCameraDirection() ) );}
			}

			AddTimer('Throw_Knife_Delay_Timer', 0.375   , false);
		}
		else
		{
			secondaryWeaponIDs.Clear();

			itemIds.Clear();
			
			thePlayer.inv.GetAllItems(itemIds);

			for( i = 0; i < itemIds.Size() ; i+=1 )
			{
				if( thePlayer.inv.ItemHasTag( itemIds[i], 'SecondaryWeapon' ) )
				{
					secondaryWeaponIDs.PushBack(itemIds[i]);
				}
			}

			if (secondaryWeaponIDs.Size() > 0)
			{
				if (!thePlayer.inv.HasItem('acs_secondary_weapon_thrower_item'))
				{
					thePlayer.inv.AddAnItem('acs_secondary_weapon_thrower_item', 1);
				}

				thePlayer.EquipItem( thePlayer.inv.GetItemId('acs_secondary_weapon_thrower_item'));

				GetWitcherPlayer().SelectQuickslotItem( EES_Quickslot1 );
			}
			else
			{
				ACS_Oneliner(
				(new ACS_Oneliner_TagBuilder in theGame)
				.tag("font")
				.attr("size", "22")
				.attr("color", "#ffffff")
				.text("<br/>" + "[" + GetLocStringById(2118449926) + "]" + "<br/>")
				, ent, "ACS_Throw_Notification_Oneliner", Vector(0,0,-0.25), 1);

				GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Throw_Notification_Oneliner", 100);

				GetACSStorage().acs_setScaleForOnelinerByTag("ACS_Throw_Notification_Oneliner", 100, 100, 100);
			}
		}
	}

	var vACS_Throw_Secondary_Weapon: cACS_Throw_Secondary_Weapon;

	var secondary_weapon_prepare_for_explosion : bool;

	public timer function Throw_Secondary_Weapon_Delay_Timer(deltaTime : float , id : int)
	{
		var itemIds 									: array<SItemUniqueId>;
		var i 											: int;
		var l_iconPath, l_text, l_text_color			: string;

		MovementAdjust('default');

		if( actor && ACS_AttitudeCheck ( actor ) && thePlayer.IsInCombat())
		{	
			if ( ACS_Settings_Main_Int('acs_target_settings','acs_target_mode', 0) == 0 || ACS_Settings_Main_Int('acs_target_settings','acs_target_mode', 0) == 1 )
			{
				if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTowards( ticket, actor );}  
			}
			else if ( ACS_Settings_Main_Int('acs_target_settings','acs_target_mode', 0) == 2 )
			{
				if (thePlayer.IsHardLockEnabled())
				{
					if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTowards( ticket, actor );}  
				}
				else
				{
					if(!thePlayer.HasTag('ACS_Manual_Combat_Control')){thePlayer.AddTag('ACS_Manual_Combat_Control');} RemoveTimer('Manual_Combat_Control_Remove'); AddTimer('Manual_Combat_Control_Remove', 2 , false);//if (!thePlayer.IsUsingHorse() && !thePlayer.IsUsingVehicle() && !thePlayer.IsPerformingFinisher()) {movementAdjustor.RotateTo( ticket, VecHeading( theCamera.GetCameraDirection() ) );}
				}	
			}
		}
		else
		{
			Attack_Process_Direction();
		}

		secondaryWeaponIDs.Clear();

		itemIds.Clear();
		
		thePlayer.inv.GetAllItems(itemIds);

		for( i = 0; i < itemIds.Size() ; i+=1 )
		{
			if( thePlayer.inv.ItemHasTag( itemIds[i], 'SecondaryWeapon' ) )
			{
				secondaryWeaponIDs.PushBack(itemIds[i]);
			}
		}
		
		GetACSStorage().acs_deleteOnelinerByTag("ACS_Throw_Notification_Oneliner");

		if (secondaryWeaponIDs.Size() > 0)
		{
			if (secondary_weapon_prepare_for_explosion)
			{
				switch(GetWitcherPlayer().GetEquippedSign())
				{
					case ST_Aard:
					l_text_color = "#1997ff";
					break;

					case ST_Axii:
					l_text_color = "#19ff30";
					break;

					case ST_Igni:
					l_text_color = "#ff2a00";
					break;

					case ST_Quen:
					l_text_color = "#ebb134";
					break;

					case ST_Yrden:
					l_text_color = "#8634eb";
					break;

					default:
					l_text_color = "#ffffff";
					break;
				}

				secondary_weapon_prepare_for_explosion = false;
			}
			else
			{
				l_text_color = "#ffffff";
			}

			l_iconPath = "<img src='img://" + thePlayer.inv.GetItemIconPathByUniqueID(secondaryWeaponIDs[0]) + "' height='" + 60 + "' width='" + 60 + "' vspace='0' />&nbsp;";

			ACS_Oneliner(
			(new ACS_Oneliner_TagBuilder in theGame)
			.tag("font")
			.attr("size", "22")
			.attr("color", l_text_color)
			.text(l_iconPath + "<br/>" + " [" + GetLocStringById(2118449927) + "]" + "<br/>" + "x" + IntToString(secondaryWeaponIDs.Size()))
			, ACSGetCEntity('ACS_Throw_Notification_Oneliner_Attachment_Dummy'), "ACS_Throw_Notification_Oneliner", Vector(0,0,-0.25), 2);

			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Throw_Notification_Oneliner_Attachment_Dummy", 100);

			GetACSStorage().acs_setScaleForOnelinerByTag("ACS_Throw_Notification_Oneliner_Attachment_Dummy", 100, 100, 100);
		}
		else
		{
			itemIds.Clear();

			itemIds = thePlayer.inv.GetItemsByName('ACS_Knife');

			if (itemIds.Size() > 0)
			{
				if (!thePlayer.inv.HasItem('acs_knife_thrower_item'))
				{
					thePlayer.inv.AddAnItem('acs_knife_thrower_item', 1);
				}
				
				thePlayer.EquipItem( thePlayer.inv.GetItemId('acs_knife_thrower_item'));

				GetWitcherPlayer().SelectQuickslotItem( EES_Quickslot1 );
			}
			else
			{
				ACS_Oneliner(
				(new ACS_Oneliner_TagBuilder in theGame)
				.tag("font")
				.attr("size", "22")
				.attr("color", "#ffffff")
				.text("<br/>" + "[" + GetLocStringById(2118449928) + "]" + "<br/>")
				, ACSGetCEntity('ACS_Throw_Notification_Oneliner_Attachment_Dummy'), "ACS_Throw_Notification_Oneliner", Vector(0,0,-0.25), 1);

				GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Throw_Notification_Oneliner", 100);

				GetACSStorage().acs_setScaleForOnelinerByTag("ACS_Throw_Notification_Oneliner", 100, 100, 100);
			}
		}

		if (GetACSSecondaryWeaponProjectile())
		{
			vACS_Throw_Secondary_Weapon = new cACS_Throw_Secondary_Weapon in this;

			vACS_Throw_Secondary_Weapon.ACS_Throw_Secondary_Weapon_Engage();
		}
	}


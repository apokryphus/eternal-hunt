				//thePlayer.OnPerformAttack(theGame.params.ATTACK_NAME_LIGHT);
			}
			else
			{
				Attack_Setup_08('GeraltDefaultModeLightAttack');
			}
		}
	}

	function GeraltHeavyAttack()
	{			
		if (thePlayer.HasTag('acs_igni_sword_equipped_TAG'))
		{
			thePlayer.RemoveTag('acs_igni_sword_equipped_TAG');	
		}
		
		if (!thePlayer.HasTag('acs_igni_secondary_sword_equipped_TAG'))
		{
			thePlayer.AddTag('acs_igni_secondary_sword_equipped_TAG');	
		}

		if (thePlayer.HasTag('ACS_Dual_Wield_Active')
		)
		{
			Attack_Setup_03('DualWieldHeavyAttack');
			
			return;
		}

		if (thePlayer.HasTag('ACS_Spear_Transform_Active')
		)
		{
			Attack_Setup_16('FocusModeSpearHeavyAttack');

			return;
		}

		if (ACS_GetItem_Sword_IsEquipped('zireal_steel_held', 'steel') || ACS_GetItem_Sword_IsEquipped('zireal_silver_held', 'silver'))
		{
			Attack_Setup_08('GeraltCiriHeavyAttack');

			return;
		}

		if (ACS_Armor_Set_Check('wolf', true))
		{
			Attack_Setup_04('GeraltWolfHeavyAttack');
		}
		else if (ACS_Armor_Set_Check('acs_armor_alpha', false))
		{
			Attack_Setup_07('GeraltACSArmorAlphaHeavyAttack');
		}
		else if (ACS_Armor_Set_Check('bear', true))
		{
			Attack_Setup_04('GeraltBearHeavyAttack');
		}
		else if (ACS_Armor_Set_Check('cat', true))
		{
			Attack_Setup_05('GeraltCatHeavyAttack');
		}
		else if (ACS_Armor_Set_Check('griffin', true))
		{
			Attack_Setup_05('GeraltGriffinHeavyAttack');
		}
		else if (ACS_Armor_Set_Check('manticore', true))
		{
			Attack_Setup_06('GeraltManticoreHeavyAttack');
		}
		else if (ACS_Armor_Set_Check('forgotten_wolf', true))
		{
			Attack_Setup_07('GeraltForgottenWolfHeavyAttack');
		}
		else if (ACS_Armor_Set_Check('acs_armor_omega', false))
		{
			Attack_Setup_07('GeraltACSArmorOmegaHeavyAttack');
		}
		else if (ACS_Armor_Set_Check('viper', true))
		{
			Attack_Setup_06('GeraltViperHeavyAttack');
		}
		else
		{
			if (ACS_DefaultMovesetCombatAnimationOverrideMode_Enabled())
			{
				Attack_Setup_09('GeraltOverrideModeHeavyAttack');
			}
			else
			{
				Attack_Setup_08('GeraltDefaultModeHeavyAttack');
			}
		}
	}


	{
		RemoveTimer('Vampire_Monster_Bat_Swarm');
		AddTimer('Vampire_Monster_Bat_Swarm', 0.5 , true);

		//GetWitcherPlayer().SoundEvent("q704_bats");
		//GetWitcherPlayer().SoundEvent("q704_bats");
	}

	timer function TransformationVampireMonsterSwarmAdditionalEffects(deltaTime : float , id : int)
	{
		if (transformation_vampire_monster_swarm_process)
		{
			ACSGetCActor('ACS_Transformation_Vampire_Monster').StopEffect('swarm_gathers');
			ACSGetCActor('ACS_Transformation_Vampire_Monster').PlayEffectSingle('swarm_gathers');
		}
	}

	function ACS_Transformation_Vampire_Monster_Special_Light_Attack_Air()
	{
		var swarmattackent_1, swarmattackent_2, swarmattackent_3																: CEntity;

		if(theInput.GetActionValue('Sprint'))
		{
			return;
		}

		if (transformation_vampire_monster_dive_process)
		{
			return;
		}

		if (theGame.GetEngineTimeAsSeconds() - last_transformation_special_attack_time > transformation_special_attack_cooldown)
		{
			last_transformation_special_attack_time = theGame.GetEngineTimeAsSeconds();

			thePlayer.DrainVitality( thePlayer.GetStat( BCS_Vitality ) * 0.12 );

			ACSVampireMonsterRemoveMoveTimers();

			RemoveTimer('TransformationVampireMonsterAttackProcess_Restore');

			RemoveTimer('TransformationVampireMonsterSwarmProcess_Restore');

			transformation_vampire_monster_attack_process = true;

			transformation_vampire_monster_swarm_process = true;

			ACSGetCActor('ACS_Transformation_Vampire_Monster').DestroyEffect('swarm_light');

			ACSGetCActor('ACS_Transformation_Vampire_Monster').DestroyEffect('trap_light');

			ACSGetCActor('ACS_Transformation_Vampire_Monster').PlayEffectSingle('swarm_light');

			ACSGetCActor('ACS_Transformation_Vampire_Monster').PlayEffectSingle('trap_light');

			RemoveTimer('Vampire_Monster_Bat_Swarm');

			RemoveTimer('Vampire_Monster_Bats_Gatling');


								{	
									
									thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) * 1/3);
								}
								else if( thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus ) * 0.9875 ) 
								{
									thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) * 1/3);
								}
							}
							else if ((theInput.GetActionValue(TargetLockOrSpawnHorse()) > 0.1f || theInput.GetActionValue('CameraLockOrSpawnHorse') > 0.1f)
							&& thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus ) * 1/3 )
							{
								ACSHeavenlyStrike();
							}
							else
							{
								if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	

								RemoveTimer('ACS_ResetAnimation');

								Attack_Process_12('geraltRandomGeraltLightAttack_Viper');
							}

							ACS_StaminaDrain(1);
						
					}
					break;

					case 'GeraltViperHeavyAttack':
					if (ACS_can_perform_heavy_attack())
					{
						
							ACS_refresh_heavy_attack_cooldown();
																
							thePlayer.BreakPheromoneEffect();
																			
							PrimaryWeaponSwitch();
																			
							if (Attack_Directional_Press_Check())
							{
								if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	

								RemoveTimer('ACS_ResetAnimation');

								Attack_Process_13('geraltRandomGeraltHeavyAttackForward_Viper');
							}
							else if ((theInput.GetActionValue(TargetLockOrSpawnHorse()) > 0.1f || theInput.GetActionValue('CameraLockOrSpawnHorse') > 0.1f)
							&& thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus ) * 1/3 )
							{
								ACSDanceOfWrath();
							}
							else
							{
								if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	

								RemoveTimer('ACS_ResetAnimation');

								Attack_Process_13('geraltRandomGeraltHeavyAttack_Viper');
							}

							ACS_StaminaDrain(2);
						
					}
					break;

					case 'GeraltViperSpecialLightAttack':
					if ( ACS_can_perform_special_attack() )
					{
						
							ACS_refresh_special_attack_cooldown();
								
							thePlayer.BreakPheromoneEffect();	

							PrimaryWeaponSwitch(); 

							if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	

							if (thePlayer.IsGuarded()||thePlayer.HasBuff(EET_SlowdownFrost)||thePlayer.HasBuff(EET_Slowdown)||thePlayer.HasBuff(EET_Blizzard)){thePlayer.ACS_SetAnimationSpeedMultiplier( 1.5  ); }else{thePlayer.ACS_SetAnimationSpeedMultiplier( 1.75 ); }		

							RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.25   , false);	
								
							Attack_Process_13('geraltRandomGeraltSpecialAttack_Viper');

							ACS_StaminaDrain(3);
						
					}
					break;

					case 'GeraltForgottenWolfLightAttack':
					if (ACS_can_perform_light_attack())
					{
						
							ACS_refresh_light_attack_cooldown();
																
							thePlayer.BreakPheromoneEffect();
																			
							PrimaryWeaponSwitch();

							if( thePlayer.IsAlive()) {thePlayer.ACS_ClearAnimationSpeedMultipliers();}	

							RemoveTimer('ACS_ResetAnimation');

							if (Attack_Directional_Press_Check())
							{
								Attack_Process_12('geraltRandomGeraltLightAttackForward_Wolf');
							}
							else if (theInput.GetActionValue(DodgeOrRoll()) > 0.7
							&& thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus ) * 1/3 )
							{
								ACS_Tutorial_Display_Check('ACS_Weapon_Arts_Tutorial_Shown');

								RemoveTimer('RollDelay');

								FlammableOilEvent();

								if( thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus )/3
								&& thePlayer.GetStat( BCS_Focus ) < thePlayer.GetStatMax( BCS_Focus ) * 2/3) 
								{	
									
									thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) );
								}
								else if( thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus ) * 2/3
								&& thePlayer.GetStat( BCS_Focus ) < thePlayer.GetStatMax( BCS_Focus ) * 0.9875 )  
								{	
									
									thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) * 1/3);
								}
								else if( thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus ) * 0.9875 ) 
								{
									thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) * 1/3);
								}
							}
							else if ((theInput.GetActionValue(TargetLockOrSpawnHorse()) > 0.1f || theInput.GetActionValue('CameraLockOrSpawnHorse') > 0.1f)
							&& thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus ) * 1/3 )
							{
								ACSHeavenlyStrike();
							}
							else
							{
								Attack_Process_Stance('geraltRandomGeraltLightAttack_Wolf');
							}

							ACS_StaminaDrain(1);
						
					}
					break;

					
					default:
					break;
				}
				
			}
		}
	}

	function Attack_Setup_07( attack_name : name )
	{	
		ACS_ExplorationDelayHack(false, 3);

		finisherActorTarget = (CActor)( thePlayer.GetTarget() );	
		ccomp = finisherActorTarget.GetComponent("Finish");
		ccompEnabled = ccomp.IsEnabled();

		if (
		ccompEnabled
		&& ACS_AttitudeCheck (finisherActorTarget)
		&& VecDistanceSquared2D( thePlayer.GetWorldPosition(), finisherActorTarget.GetNearestPointInBothPersonalSpaces( thePlayer.GetWorldPosition() ) ) < 2.75f * 2.75f
		)
		{
			PrimarySecondaryWeaponSwitch ( attack_name );

			ACS_Setup_Light_Attack_Internal();
		}
		else
		{
			if ( ACS_Settings_Main_Bool('acs_stamina_settings','acs_stamina_block_action', false) 

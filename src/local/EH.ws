		npcRot = npc.GetWorldRotation();
		
		curTargetVitality = npc.GetStat( BCS_Vitality );

		maxTargetVitality = npc.GetStatMax( BCS_Vitality );
		
		curTargetEssence = npc.GetStat( BCS_Essence );

		maxTargetEssence = npc.GetStatMax( BCS_Essence );

		maxAdrenaline = thePlayer.GetStatMax(BCS_Focus);
		
		curAdrenaline = thePlayer.GetStat(BCS_Focus);
		
		targetRotationNPC = npc.GetWorldRotation();
		targetRotationNPC.Yaw = RandRangeF(360,1);
		targetRotationNPC.Pitch = RandRangeF(45,-45);
		
		playerVitality = thePlayer.GetStatMax( BCS_Vitality );
		
		if ( playerAttacker && npc && thePlayer.HasTag('acs_quen_secondary_sword_equipped')  )
		{
			thePlayer.IncreaseUninterruptedHitsCount();	

			npc.SoundEvent("cmb_play_hit_heavy");

			//weapon_blood_fx('red');

			if( curAdrenaline >= maxAdrenaline/3
			&& curAdrenaline < maxAdrenaline * 2/3
			&& npc.HasTag('acs_quen_light_attack_mark') ) 
			{	
				Detonation_Weapon_Effects_Switch();

				actors.Clear();

				actors = thePlayer.GetNPCsAndPlayersInRange( 1.5, 20, , FLAG_ExcludePlayer + FLAG_Attitude_Hostile + FLAG_OnlyAliveActors);

				if( actors.Size() > 0 )
				{
					for( i = 0; i < actors.Size(); i += 1 )
					{
						actortarget = (CActor)actors[i];

						dmg = new W3DamageAction in theGame.damageMgr;
						dmg.Initialize(thePlayer, actortarget, thePlayer, thePlayer.GetName(), EHRT_None, CPS_Undefined, false, false, true, false);
						dmg.SetProcessBuffsIfNoDamage(true);
			
						dmg.AddEffectInfo( EET_Paralyzed, 1 );
			
						dmg.SetCriticalHit(); theGame.damageMgr.ProcessAction( dmg );
								
						delete dmg;	
					}
				}

				vACS_Armiger_Mode_On_Hit_Effects = new cACS_Armiger_Mode_On_Hit_Effects in this;
		
				vACS_Armiger_Mode_On_Hit_Effects.ACS_AOE_Sandpillar_LVL_1_Engage();
					
				Remove_On_Hit_Tags();
					
				npc.RemoveTag('acs_quen_light_attack_mark');
				thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) );
			}
			else if( curAdrenaline >= maxAdrenaline * 2/3
			&& curAdrenaline < maxAdrenaline
			&& npc.HasTag('acs_quen_light_attack_mark') ) 
			{	
				Detonation_Weapon_Effects_Switch();

				actors.Clear();

				actors = thePlayer.GetNPCsAndPlayersInRange( 2.5, 20, , FLAG_ExcludePlayer + FLAG_Attitude_Hostile + FLAG_OnlyAliveActors);

				if( actors.Size() > 0 )
				{
					for( i = 0; i < actors.Size(); i += 1 )
					{
						actortarget = (CActor)actors[i];

						dmg = new W3DamageAction in theGame.damageMgr;
						dmg.Initialize(thePlayer, actortarget, thePlayer, thePlayer.GetName(), EHRT_None, CPS_Undefined, false, false, true, false);
						dmg.SetProcessBuffsIfNoDamage(true);
			
						dmg.AddEffectInfo( EET_Paralyzed, 2 );
			
						dmg.SetCriticalHit(); theGame.damageMgr.ProcessAction( dmg );
								
						delete dmg;	
					}
				}

				//ACS_AOE_Sandpillar_LVL_2();
				vACS_Armiger_Mode_On_Hit_Effects = new cACS_Armiger_Mode_On_Hit_Effects in this;
		
				vACS_Armiger_Mode_On_Hit_Effects.ACS_AOE_Sandpillar_LVL_1_Engage();
					
				Remove_On_Hit_Tags();
					
				npc.RemoveTag('acs_quen_light_attack_mark');
				thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) * 1/3 );
			}
			else if( curAdrenaline == maxAdrenaline
			&& npc.HasTag('acs_quen_light_attack_mark') ) 
			{	
				Detonation_Weapon_Effects_Switch();

				actors.Clear();

				actors = thePlayer.GetNPCsAndPlayersInRange( 5, 20, , FLAG_ExcludePlayer + FLAG_Attitude_Hostile + FLAG_OnlyAliveActors);

				if( actors.Size() > 0 )
				{
					for( i = 0; i < actors.Size(); i += 1 )
					{
						actortarget = (CActor)actors[i];

						dmg = new W3DamageAction in theGame.damageMgr;
						dmg.Initialize(thePlayer, actortarget, thePlayer, thePlayer.GetName(), EHRT_None, CPS_Undefined, false, false, true, false);
						dmg.SetProcessBuffsIfNoDamage(true);
			
						dmg.AddEffectInfo( EET_Paralyzed, 3 );
			
						dmg.SetCriticalHit(); theGame.damageMgr.ProcessAction( dmg );
								
						delete dmg;	
					}
				}

				vACS_Armiger_Mode_On_Hit_Effects = new cACS_Armiger_Mode_On_Hit_Effects in this;
		
				vACS_Armiger_Mode_On_Hit_Effects.ACS_AOE_Sandpillar_LVL_2_Engage();
					
				Remove_On_Hit_Tags();
					
				npc.RemoveTag('acs_quen_light_attack_mark');
				thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) * 1/3 );
			}
			else
			{									
				if( curAdrenaline >= maxAdrenaline/3
				&& curAdrenaline < maxAdrenaline * 2/3)
				{
					if( RandF() < 0.0625 ) 
					{ 
						if( !npc.IsImmuneToBuff( EET_Slowdown ) && !npc.HasBuff( EET_Slowdown ) ) 
						{ 	
							Passive_Weapon_Effects_Switch();
							ACSSwordPlayEffects('quen_secondary');	
							npc.AddEffectDefault( EET_Slowdown, npc, 'console' ); 						
						}
					}
				}
				else if( curAdrenaline >= maxAdrenaline * 2/3
				&& curAdrenaline < maxAdrenaline)
				{
					if( RandF() < 0.125 ) 
					{ 
						if( !npc.IsImmuneToBuff( EET_Slowdown ) && !npc.HasBuff( EET_Slowdown ) ) 
						{ 	
							Passive_Weapon_Effects_Switch();
							ACSSwordPlayEffects('quen_secondary');	
							npc.AddEffectDefault( EET_Slowdown, npc, 'console' ); 						
						}
					}
				}
				else if( curAdrenaline == maxAdrenaline ) 
				{
					if( RandF() < 0.25 ) 
					{ 
						if( !npc.IsImmuneToBuff( EET_Slowdown ) && !npc.HasBuff( EET_Slowdown ) ) 
						{ 	
							Passive_Weapon_Effects_Switch();
							ACSSwordPlayEffects('quen_secondary');	
							npc.AddEffectDefault( EET_Slowdown, npc, 'console' ); 						
						}
					}
				}

				if( !npc.HasTag('acs_quen_heavy_attack_mark') ) 
				{
					Marker_Switch();
					npc.AddTag('acs_quen_heavy_attack_mark');
				}
			}
		
			return;
		}
	}

	function Igni_Sword_On_Hit_Effects (action : W3DamageAction)
	{
		npc = (CActor)action.victim;

		playerAttacker = (CPlayer)action.attacker;

		if ( playerAttacker && npc && thePlayer.HasTag('acs_igni_sword_equipped_TAG') ) 
		{ 
			actortarget.SoundEvent("cmb_play_hit_heavy");

			if( !npc.HasTag('acs_igni_light_attack_mark') ) 
			{
				Passive_Weapon_Effects_Switch();
				Marker_Switch();
				npc.AddTag('acs_igni_light_attack_mark');
			}

			return;
		}
	}

	function Igni_Secondary_Sword_On_Hit_Effects (action : W3DamageAction)
	{
		npc = (CActor)action.victim;

		playerAttacker = (CPlayer)action.attacker;
	
		maxAdrenaline = thePlayer.GetStatMax(BCS_Focus);
		
		curAdrenaline = thePlayer.GetStat(BCS_Focus);

		if ( playerAttacker && npc && thePlayer.HasTag('acs_igni_secondary_sword_equipped_TAG') )
		{	
			actortarget.SoundEvent("cmb_play_hit_heavy");
			
			if( curAdrenaline >= maxAdrenaline/3
			&& curAdrenaline < maxAdrenaline * 2/3
			&& npc.HasTag('acs_igni_light_attack_mark'))
			{
				Detonation_Weapon_Effects_Switch();
						
				npc.OnIgniHit( NULL );

				actors.Clear();
						
				actors = thePlayer.GetNPCsAndPlayersInRange( 1.5, 20, , FLAG_ExcludePlayer + FLAG_Attitude_Hostile + FLAG_OnlyAliveActors);

				if( actors.Size() > 0 )
				{
					for( i = 0; i < actors.Size(); i += 1 )
					{
						actortarget = (CActor)actors[i];

						dmg = new W3DamageAction in theGame.damageMgr;
						dmg.Initialize(thePlayer, actortarget, thePlayer, thePlayer.GetName(), EHRT_None, CPS_Undefined, false, false, true, false);
						dmg.SetProcessBuffsIfNoDamage(true);
								
						dmg.SetForceExplosionDismemberment();
								
						dmg.AddEffectInfo( EET_Burning, 1 );
								
						dmg.AddEffectInfo( EET_Stagger, 1 );
								
						dmg.SetCriticalHit(); theGame.damageMgr.ProcessAction( dmg );
								
						delete dmg;	
					}
				}

				vACS_Armiger_Mode_On_Hit_Effects = new cACS_Armiger_Mode_On_Hit_Effects in this;
		
				vACS_Armiger_Mode_On_Hit_Effects.ACS_AOE_Igni_Blast_LVL_1_Engage();
						
				Remove_On_Hit_Tags();
				//ACS_Elemental_Combo_System_MarkDestroy();
				npc.RemoveTag('acs_igni_light_attack_mark');
					
				thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) );
			}
			else if (curAdrenaline >= maxAdrenaline * 2/3
			&& curAdrenaline < maxAdrenaline
			&& npc.HasTag('acs_igni_light_attack_mark'))
			{
				Detonation_Weapon_Effects_Switch();
						
				npc.OnIgniHit( NULL );

				actors.Clear();
						
				actors = thePlayer.GetNPCsAndPlayersInRange( 2.5, 20, , FLAG_ExcludePlayer + FLAG_Attitude_Hostile + FLAG_OnlyAliveActors);

				if( actors.Size() > 0 )
				{
					for( i = 0; i < actors.Size(); i += 1 )
					{
						actortarget = (CActor)actors[i];

						dmg = new W3DamageAction in theGame.damageMgr;
						dmg.Initialize(thePlayer, actortarget, thePlayer, thePlayer.GetName(), EHRT_None, CPS_Undefined, false, false, true, false);
						dmg.SetProcessBuffsIfNoDamage(true);
								
						dmg.SetForceExplosionDismemberment();
								
						dmg.AddEffectInfo( EET_Burning, 2 );

						if( !actortarget.IsImmuneToBuff( EET_HeavyKnockdown ) && !actortarget.IsImmuneToBuff( EET_Ragdoll ) && !actortarget.HasBuff( EET_HeavyKnockdown ) && !actortarget.HasBuff( EET_Ragdoll ) ) 
						{
							dmg.AddEffectInfo( EET_HeavyKnockdown, 2 );
						}		
	
						dmg.SetCriticalHit(); theGame.damageMgr.ProcessAction( dmg );
								
						delete dmg;	
					}
				}

				//ACS_AOE_Igni_Blast_LVL_2();
				vACS_Armiger_Mode_On_Hit_Effects = new cACS_Armiger_Mode_On_Hit_Effects in this;
		
				vACS_Armiger_Mode_On_Hit_Effects.ACS_AOE_Igni_Blast_LVL_1_Engage();

				Remove_On_Hit_Tags();
				//ACS_Elemental_Combo_System_MarkDestroy();
				npc.RemoveTag('acs_igni_light_attack_mark');
					
				thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) * 1/3 );
			}
			else if (curAdrenaline == maxAdrenaline 
			&& npc.HasTag('acs_igni_light_attack_mark'))
			{
				Detonation_Weapon_Effects_Switch();
						
				npc.OnIgniHit( NULL );

				actors.Clear();
						
				actors = thePlayer.GetNPCsAndPlayersInRange( 5, 20, , FLAG_ExcludePlayer + FLAG_Attitude_Hostile + FLAG_OnlyAliveActors);

				if( actors.Size() > 0 )
				{
					for( i = 0; i < actors.Size(); i += 1 )
					{
						actortarget = (CActor)actors[i];

						dmg = new W3DamageAction in theGame.damageMgr;
						dmg.Initialize(thePlayer, actortarget, thePlayer, thePlayer.GetName(), EHRT_None, CPS_Undefined, false, false, true, false);
						dmg.SetProcessBuffsIfNoDamage(true);
								
						dmg.SetForceExplosionDismemberment();
								
						dmg.AddEffectInfo( EET_Burning, 3 );
						
						if( !actortarget.IsImmuneToBuff( EET_HeavyKnockdown ) && !actortarget.IsImmuneToBuff( EET_Ragdoll ) && !actortarget.HasBuff( EET_HeavyKnockdown ) && !actortarget.HasBuff( EET_Ragdoll ) ) 
						{
							dmg.AddEffectInfo( EET_HeavyKnockdown, 3 );
						}
								
						dmg.SetCriticalHit(); theGame.damageMgr.ProcessAction( dmg );
								
						delete dmg;	
					}
				}

				vACS_Armiger_Mode_On_Hit_Effects = new cACS_Armiger_Mode_On_Hit_Effects in this;
		
				vACS_Armiger_Mode_On_Hit_Effects.ACS_AOE_Igni_Blast_LVL_2_Engage();

				Remove_On_Hit_Tags();
				//ACS_Elemental_Combo_System_MarkDestroy();
				npc.RemoveTag('acs_igni_light_attack_mark');
					
				thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) * 1/3 );
			}

			return;
		}
	}

	var vACS_Armiger_Mode_On_Hit_Effects : cACS_Armiger_Mode_On_Hit_Effects;

	var last_finisher_time : float;

	function CanPerformFinisher() : bool
	{
		if (thePlayer.HasTag('ACS_Neutral_Flip')
		|| !thePlayer.IsActionAllowed(EIAB_Movement)
		|| thePlayer.HasTag('ACS_In_Combat_Art')
		)
		{
			return false;
		}

		return theGame.GetEngineTimeAsSeconds() - last_finisher_time > 2.5;
	}

	function RefreshFinisherCooldown()
	{
		last_finisher_time = theGame.GetEngineTimeAsSeconds();
	}

	function ACS_Finisher_Or_Dismember (action : W3DamageAction)
	{
		var playerAttacker, playerVictim																								: CPlayer;
		var npc, npcAttacker 																											: CActor;
		var finisher_anim_names																											: array< name >;

		if (thePlayer.IsInCutsceneIntro()
		|| theGame.IsDialogOrCutscenePlaying() 
		|| theGame.GetPhotomodeEnabled() 
		)
		{
			return;
		}

		if ( ACS_New_Replacers_Female_Active()  )
		{
			return;
		}

		if (FactsQuerySum("acs_transformation_activated") > 0)
		{
			return;
		}

		npc = (CActor)action.victim;

		playerAttacker = (CPlayer)action.attacker;

		if (npc.IsUsingVehicle()
		|| npc.IsUsingHorse()
		|| npc.IsSwimming()
		|| ((CNewNPC)(npc)).IsFlying()
		)
		{
			return;
		}

		if ( npc.IsAlive()
		//&& !npc.HasTag('ACS_Counter_Wound_Ready')
		&& npc.GetCurrentHealth() > 0.01
		//&& thePlayer.IsAnyWeaponHeld()
		//&& !thePlayer.IsWeaponHeld('fist')
		&& AllowGrapple(npc)
		&& thePlayer.GetStat(BCS_Stamina) >= thePlayer.GetStatMax(BCS_Stamina) * 0.33f
		&& playerAttacker.IsLightAttack(((W3Action_Attack)action).GetAttackName())
		&& ((W3Action_Attack)action).GetAttackName() != 'counter_attack_light'
		&& ((W3Action_Attack)action).GetAttackName() != 'acs_attack_poison'
		&& theInput.GetActionValue('CbtRoll') > 0.1f 
		&& CanPerformFinisher()
		)
		{
			last_finisher_time = theGame.GetEngineTimeAsSeconds();
			
			thePlayer.ACS_ClearAnimationSpeedMultipliers();

			ACS_SetupSyncAnimInternalGrapple(thePlayer, npc);

			return;
		}

		if (npc.HasTag('ACS_Counter_Wound_Ready')
		&& ((CNewNPC)npc).acs_wound_fx
		&& ((CNewNPC)npc).acs_posture == ((CNewNPC)npc).acs_max_posture
		&& ACSGetCEntity('ACS_Counter_Wound')
		&& npc.IsAlive()
		&& npc.GetCurrentHealth() > 0.01
		&& thePlayer.IsAnyWeaponHeld()
		&& !thePlayer.IsWeaponHeld('fist')
		&& ((W3Action_Attack)action).GetAttackName() != 'counter_attack_light'
		&& ((W3Action_Attack)action).GetAttackName() != 'acs_attack_poison'
		&& (theInput.GetActionValue('LockAndGuard') > 0.1f 
		|| theInput.GetActionValue('Guard') > 0.1f)
		)
		{
			ACSGetCEntityDestroyAll('ACS_Counter_Wound'); ACSGetCEntityDestroyAll('ACS_Sneaking_Lure');

			ACSGetCActorRemoveTag('ACS_Counter_Wound_Ready');

			npc.RemoveTag('ACS_Counter_Wound_Ready');

			if ( ACS_Vampire_Claws_Access() )
			{
				action_interrupt();

				thePlayer.RemoveTag('ACS_Manual_Combat_Control');

			
				thePlayer.DestroyEffect( 'bruxa_dash_trails' );
				thePlayer.PlayEffectSingle( 'bruxa_dash_trails' );
				thePlayer.StopEffect( 'bruxa_dash_trails' );

				thePlayer.DestroyEffect('shadowdash_shockwave');
				thePlayer.PlayEffectSingle('shadowdash_shockwave');
				thePlayer.StopEffect('shadowdash_shockwave');

				thePlayer.DestroyEffect('shadowdash_short');
				thePlayer.PlayEffectSingle('shadowdash_short');
				thePlayer.StopEffect('shadowdash_short');

				finisher_anim_names.Clear();

				finisher_anim_names.PushBack('bruxa_attack_bite_front_lp_bruxa_ACS');
				finisher_anim_names.PushBack('bruxa_attack_bite_front_rp_bruxa_ACS');
				finisher_anim_names.PushBack('bruxa_attack_bite_back_lp_bruxa_ACS');
				finisher_anim_names.PushBack('bruxa_attack_bite_back_rp_bruxa_ACS');

				if (combatTarget.IsHuman())
				{
					ACS_SetupSyncAnimInternalHumanBruxaBite(finisher_anim_names[RandRange(finisher_anim_names.Size())], thePlayer, npc );

					return;
				}
				else
				{
					ACS_SetupSyncAnimInternalMonsterBruxaBite(finisher_anim_names[RandRange(finisher_anim_names.Size())], thePlayer, npc );

					return;
				}
			
			}

			if (playerAttacker.IsLightAttack(((W3Action_Attack)action).GetAttackName()))
			{
				ACS_SetupSyncAnimInternalCounterWound(playerAttacker, npc);
			}
			else if (playerAttacker.IsHeavyAttack(((W3Action_Attack)action).GetAttackName()))
			{
				if (StabHostageCheck())
				{
					thePlayer.ACS_ClearAnimationSpeedMultipliers();

					thePlayer.RaiseEvent('ACS_StabHostageEnter03');

					return;
				}

				ACS_SetupSyncAnimInternalCounterWound(playerAttacker, npc);
			}
		}

		if (npc.HasBuff( EET_Hypnotized )
		|| npc.HasBuff( EET_WitchHypnotized )
		|| npc.HasBuff( EET_Blindness )
		|| npc.HasBuff( EET_WraithBlindness )
		|| npc.HasBuff( EET_Paralyzed )
		|| npc.HasBuff( EET_Confusion )
		|| npc.HasBuff( EET_Choking )
		|| npc.HasBuff( EET_Immobilized )
		|| npc.HasBuff( EET_AxiiGuardMe )
		|| npc.HasBuff( EET_Weaken )
		)
		{
			if ( npc.IsAlive()
			&& npc.GetCurrentHealth() > 0.01
			&& thePlayer.IsAnyWeaponHeld()
			&& !thePlayer.IsWeaponHeld('fist')
			)
			{
				if (playerAttacker.IsHeavyAttack(((W3Action_Attack)action).GetAttackName())
				&& StabHostageCheck())
				{
					thePlayer.ACS_ClearAnimationSpeedMultipliers();

					thePlayer.RaiseEvent('ACS_StabHostageEnter03');

					return;
				}
				
			}
		}

		if (npc.HasTag('ACS_Wild_Hunt_Rider')
		|| npc.HasTag('ACS_caretaker_shade')
		|| npc.HasTag('ACS_Shades_Crusader')
		|| npc.HasTag('arena_support')
		|| ((CDettlaffColumn)(npc))
		|| ((CDettlaffConstruct)(npc))
		|| npc.HasTag('fogling_doppelganger')
		)
		{
			return;
		}

		if (playerAttacker 
		&& npc
		&& npc.GetMovingAgentComponent().GetName() != "dwarf_base"
		&& npc.GetMovingAgentComponent().GetName() != "woman_base"
		&& !npc.HasTag('ACS_Dwarf')
		)
		{
			if (thePlayer.IsDeadlySwordHeld() || thePlayer.IsWeaponHeld('fist'))
			{
				if (thePlayer.HasTag('ACS_Ghost_Stance_Active'))
				{
					ACS_Finisher_Internal(npc, action);

					return;
				}

				if (thePlayer.HasTag('acs_vampire_claws_equipped'))
				{
					ACS_Dismember_Internal(npc, action);

					return;
				}

				if (npc.HasTag('ACS_man_finisher_dlc_arm_lp_combat_dismember')
				|| npc.HasTag('ACS_man_finisher_dlc_arm_rp_combat_dismember')
				|| npc.HasTag('ACS_man_finisher_dlc_legs_lp_combat_dismember')
				|| npc.HasTag('ACS_man_finisher_dlc_legs_rp_combat_dismember')
				)
				{
					if(!npc.HasAbility('DisableDismemberment'))
					{
						npc.AddAbility('DisableDismemberment');
					}
				}

				if (
				( 
				thePlayer.HasTag('acs_axii_sword_equipped') 
				|| thePlayer.HasTag('acs_axii_secondary_sword_equipped') 
				) 
				)
				{
					if (npc.UsesVitality() 
					&& npc.IsHuman()
					)
					{
						if (
						//((CNewNPC)npc).GetNPCType() == ENGT_Guard
						//|| 
						npc.IsWoman()
						|| npc.HasTag('ACS_Scared_Standing')
						|| ACS_Armor_Set_Check('acs_armor_omega', false)
						)
						{
							ACS_Dismember_Internal(npc, action);

							return;
						}

						if (ACS_Settings_Main_Bool('acs_custom_finishers_settings','acs_auto_finisher_enabled', true))
						{
							if(  thePlayer.IsDoingSpecialAttack( false ) )
							{
								if (ACS_Settings_Main_Bool('acs_custom_finishers_settings','acs_experimental_dismemberment_enabled', true))
								{
									ACS_Dismember_Internal(npc, action);
								}

								return;
							}
							
							if (
							(npc.HasBuff(EET_Burning) && ACS_Settings_Main_Bool('acs_custom_finishers_settings','acs_burning_always_dismember_enabled', false))
							|| npc.HasBuff(EET_Frozen)
							)
							{
								ACS_Dismember_Internal(npc, action);

								return;
							}

							if (!thePlayer.WasVisibleInScaledFrame( ((CNewNPC)npc), 1.f, 1.f ))
							{
								ACS_Dismember_Internal(npc, action);

								return;
							}

							if (thePlayer.IsAttackerAtBack(((CNewNPC)npc)))
							{
								ACS_Dismember_Internal(npc, action);

								return;
							}

							if (RandF() < ACS_Settings_Main_Float('acs_custom_finishers_settings','acs_custom_finisher_chance', 1))
							{
								ACS_Finisher_Internal(npc, action);

								return;
							}
								
						
							if (ACS_Settings_Main_Bool('acs_custom_finishers_settings','acs_experimental_dismemberment_enabled', true))
							{
								ACS_Dismember_Internal(npc, action);
							}
								
							return;
						}
		
						if (ACS_Settings_Main_Bool('acs_custom_finishers_settings','acs_experimental_dismemberment_enabled', true))
						{
							ACS_Dismember_Internal(npc, action);
						}
						
						return;
					}

					if (ACS_Settings_Main_Bool('acs_custom_finishers_settings','acs_experimental_dismemberment_enabled', true))
					{
						ACS_Dismember_Internal(npc, action);
					}
					
					return;
				}

				if (
				( 
				thePlayer.HasTag('acs_quen_sword_equipped') 
				) 
				)
				{
					if (npc.UsesVitality() && npc.IsHuman())
					{
						if (
						//((CNewNPC)npc).GetNPCType() == ENGT_Guard
						//|| 
						npc.IsWoman()
						|| npc.HasTag('ACS_Scared_Standing')
						|| ACS_Armor_Set_Check('acs_armor_omega', false)
						)
						{
							ACS_Dismember_Internal(npc, action);

							return;
						}

						if (ACS_Settings_Main_Bool('acs_custom_finishers_settings','acs_auto_finisher_enabled', true))
						{
							if(  thePlayer.IsDoingSpecialAttack( false ) )
							{
								if (ACS_Settings_Main_Bool('acs_custom_finishers_settings','acs_experimental_dismemberment_enabled', true))
								{
									ACS_Dismember_Internal(npc, action);
								}

								return;
							}

							if ((playerAttacker.IsHeavyAttack(((W3Action_Attack)action).GetAttackName()) && ACS_Settings_Main_Bool('acs_custom_finishers_settings','acs_heavy_attack_always_dismember_enabled', true) && !silver_strong_stance)
							|| (npc.HasBuff(EET_Burning) && ACS_Settings_Main_Bool('acs_custom_finishers_settings','acs_burning_always_dismember_enabled', false))
							|| npc.HasBuff(EET_Frozen)
							|| thePlayer.HasTag('ACS_In_Dance_Of_Wrath')
							)
							{
								ACS_Dismember_Internal(npc, action);

								return;
							}
		
							if (ACSGetCActor('ACS_Gravehag_Tongue_Weapon_R')
							)
							{
								ACS_Dismember_Internal(npc, action);

								return;
							}

							if (!thePlayer.WasVisibleInScaledFrame( ((CNewNPC)npc), 1.f, 1.f ))
							{
								ACS_Dismember_Internal(npc, action);

								return;
							}

							if (thePlayer.IsAttackerAtBack(((CNewNPC)npc)))
							{
								ACS_Dismember_Internal(npc, action);

								return;
							}

							if (RandF() < ACS_Settings_Main_Float('acs_custom_finishers_settings','acs_custom_finisher_chance', 1))
							{
								ACS_Finisher_Internal(npc, action);

								return;
							}

							if (ACS_Settings_Main_Bool('acs_custom_finishers_settings','acs_experimental_dismemberment_enabled', true))
							{
								ACS_Dismember_Internal(npc, action);
							}
				
							return;
						}

						if (ACS_Settings_Main_Bool('acs_custom_finishers_settings','acs_experimental_dismemberment_enabled', true))
						{
							ACS_Dismember_Internal(npc, action);
						}
						
						return;
					}

					if (ACS_Settings_Main_Bool('acs_custom_finishers_settings','acs_experimental_dismemberment_enabled', true))
					{
						ACS_Dismember_Internal(npc, action);
					}
					
					return;
				}

				if (
				( 
				thePlayer.HasTag('acs_igni_sword_equipped') 
				|| thePlayer.HasTag('acs_igni_secondary_sword_equipped') 
				|| thePlayer.HasTag('acs_igni_sword_equipped_TAG') 
				|| thePlayer.HasTag('acs_igni_secondary_sword_equipped_TAG') 
				) 
				)
				{
					if (thePlayer.HasTag('ACS_In_Ciri_Special_Attack') 
					|| thePlayer.HasTag('ACS_In_Dance_Of_Wrath') 
					|| ACS_Armor_Set_Check('acs_armor_omega', false)
					)
					{
						ACS_Dismember_Internal(npc, action);

						return;
					}

					if (npc.UsesVitality() && npc.IsHuman())
					{
						if (
						//((CNewNPC)npc).GetNPCType() == ENGT_Guard
						//|| 
						npc.IsWoman()
						|| npc.HasTag('ACS_Scared_Standing')
						)
						{
							ACS_Dismember_Internal(npc, action);

							return;
						}
					
						if( theGame.GetInGameConfigWrapper().GetVarValue( 'Gameplay', 'AutomaticFinishersEnabled' ) == "true" )
						{
							if (ACS_Settings_Main_Bool('acs_custom_finishers_settings','acs_auto_finisher_enabled', true))
							{
								if(  thePlayer.IsDoingSpecialAttack( false ) )
								{
									if (ACS_Settings_Main_Bool('acs_custom_finishers_settings','acs_experimental_dismemberment_enabled', true))
									{
										ACS_Dismember_Internal(npc, action);
									}

									return;
								}
								
								if ((playerAttacker.IsHeavyAttack(((W3Action_Attack)action).GetAttackName()) && ACS_Settings_Main_Bool('acs_custom_finishers_settings','acs_heavy_attack_always_dismember_enabled', true) && !silver_strong_stance)
								|| (npc.HasBuff(EET_Burning) && ACS_Settings_Main_Bool('acs_custom_finishers_settings','acs_burning_always_dismember_enabled', false))
								|| npc.HasBuff(EET_Frozen)
								|| thePlayer.HasTag('ACS_In_Dance_Of_Wrath')
								)
								{
									ACS_Dismember_Internal(npc, action);

									return;
								}

								if (!thePlayer.WasVisibleInScaledFrame( ((CNewNPC)npc), 1.f, 1.f ))
								{
									ACS_Dismember_Internal(npc, action);

									return;
								}

								if (thePlayer.IsAttackerAtBack(((CNewNPC)npc)))
								{
									ACS_Dismember_Internal(npc, action);

									return;
								}
		
								if (RandF() < ACS_Settings_Main_Float('acs_custom_finishers_settings','acs_custom_finisher_chance', 1))
								{
									ACS_Finisher_Internal(npc, action);

									return;
								}

								if (ACS_Settings_Main_Bool('acs_custom_finishers_settings','acs_experimental_dismemberment_enabled', true))
								{
									ACS_Dismember_Internal(npc, action);
								}
								
								return;
							}
			
							if (ACS_Settings_Main_Bool('acs_custom_finishers_settings','acs_experimental_dismemberment_enabled', true))
							{
								ACS_Dismember_Internal(npc, action);
							}

							return;
						}

						if (ACS_Settings_Main_Bool('acs_custom_finishers_settings','acs_experimental_dismemberment_enabled', true))
						{
							ACS_Dismember_Internal(npc, action);
						}

						return;
					}

					if (ACS_Settings_Main_Bool('acs_custom_finishers_settings','acs_experimental_dismemberment_enabled', true))
					{
						ACS_Dismember_Internal(npc, action);
					}
					
					return;
				}

				if 
				(
				( 
				thePlayer.HasTag('acs_aard_sword_equipped') 
				|| thePlayer.HasTag('acs_aard_secondary_sword_equipped') 
				|| thePlayer.HasTag('acs_quen_secondary_sword_equipped') 
				|| thePlayer.HasTag('acs_yrden_sword_equipped') 
				|| thePlayer.HasTag('acs_yrden_secondary_sword_equipped') 
				)
				)
				{
					if (ACS_Settings_Main_Bool('acs_custom_finishers_settings','acs_experimental_dismemberment_enabled', true))
					{
						ACS_Dismember_Internal(npc, action);
					}

					return;
				}

				if ((thePlayer.IsAnyWeaponHeld()
				&& thePlayer.IsWeaponHeld('fist'))
				|| thePlayer.IsInFistFightMiniGame()
				)
				{
					ACS_Finisher_Internal(npc, action);

					return;
				}

				if (ACS_Settings_Main_Bool('acs_custom_finishers_settings','acs_experimental_dismemberment_enabled', true))
				{
					ACS_Dismember_Internal(npc, action);
				}
			}

			if (ACS_Settings_Main_Bool('acs_custom_finishers_settings','acs_experimental_dismemberment_enabled', true)
			&& ACS_Settings_Main_Bool('acs_custom_finishers_settings','acs_non_deadly_weapon_dismemberment_enabled', false)
			)
			{
				ACS_Dismember_Internal(npc, action);
			}
		}
	}
	
	function ACS_Shadow_Dash_On_Hit_Effects (action : W3DamageAction)
	{
		npc = (CActor)action.victim;

		playerAttacker = (CPlayer)action.attacker;

		npcPos = npc.GetWorldPosition();

		npcRot = npc.GetWorldRotation();
		
		curTargetVitality = npc.GetStat( BCS_Vitality );

		maxTargetVitality = npc.GetStatMax( BCS_Vitality );
		
		curTargetEssence = npc.GetStat( BCS_Essence );

		maxTargetEssence = npc.GetStatMax( BCS_Essence );

		maxAdrenaline = thePlayer.GetStatMax(BCS_Focus);
		
		curAdrenaline = thePlayer.GetStat(BCS_Focus);
		
		targetRotationNPC = npc.GetWorldRotation();
		targetRotationNPC.Yaw = RandRangeF(360,1);
		targetRotationNPC.Pitch = RandRangeF(45,-45);
		
		playerVitality = thePlayer.GetStatMax( BCS_Vitality );
		
		heal = playerVitality * 0.025;

		if ( playerAttacker && npc && thePlayer.HasTag('ACS_Shadow_Dash_Empowered') )
		{
			ACSGetEquippedSword().DestroyEffect( 'special_attack_block' );
			ACSGetEquippedSword().PlayEffectSingle( 'special_attack_block' );

			actors.Clear();

			actors = thePlayer.GetNPCsAndPlayersInCone(2.5, VecHeading(thePlayer.GetHeadingVector()), 360, 20, , FLAG_ExcludePlayer + FLAG_Attitude_Hostile + FLAG_OnlyAliveActors );

			if( actors.Size() > 0 )
			{
				for( i = 0; i < actors.Size(); i += 1 )
				{
					actortarget = (CActor)actors[i];

					actortarget.SoundEvent("cmb_play_hit_heavy");

					//damageMax = maxTargetVitality * 1/30; 

					dmg = new W3DamageAction in theGame.damageMgr;
					
					dmg.Initialize(thePlayer, actortarget, thePlayer, thePlayer.GetName(), EHRT_Heavy, CPS_Undefined, false, false, true, false);
					
					dmg.SetProcessBuffsIfNoDamage(true);
					
					dmg.SetHitReactionType( EHRT_Heavy, true);
					
					//dmg.AddDamage( theGame.params.DAMAGE_NAME_DIRECT, damageMax );

					if( !actortarget.IsImmuneToBuff( EET_Stagger ) ) 
					{ 
						if( !actortarget.IsImmuneToBuff( EET_Stagger ) && !actortarget.IsImmuneToBuff( EET_Ragdoll ) && !actortarget.HasBuff( EET_Stagger ) && !actortarget.HasBuff( EET_Ragdoll ) ) 
						{
							if (thePlayer.HasTag('ACS_Shadowstep_Long_Buff'))
							{
								dmg.AddEffectInfo( EET_Stagger, 1 );
							}
							else
							{
								dmg.AddEffectInfo( EET_Stagger, 0.5 );
							}
						}
						else
						{
							if( !actortarget.IsImmuneToBuff( EET_Bleeding ) ) 
							{ 
								dmg.AddEffectInfo( EET_Bleeding, 3 );
							}
						}	
					}
						
					dmg.SetCriticalHit(); theGame.damageMgr.ProcessAction( dmg );
						
					delete dmg;	
				}
			}

			thePlayer.RemoveTag('ACS_Shadowstep_Long_Buff');

			thePlayer.RemoveTag('ACS_Shadow_Dash_Empowered');

			return;
		}
		else if ( playerAttacker && npc && (thePlayer.HasTag('acs_yrden_sword_equipped') || thePlayer.HasTag('acs_yrden_secondary_sword_equipped')) )
		{
			actors.Clear();

			actors = thePlayer.GetNPCsAndPlayersInCone(2.5, VecHeading(thePlayer.GetHeadingVector()), 360, 20, , FLAG_ExcludePlayer + FLAG_Attitude_Hostile + FLAG_OnlyAliveActors );

			if( actors.Size() > 1 )
			{
				for( i = 0; i < actors.Size(); i += 1 )
				{
					actortarget = (CActor)actors[i];

					actortarget.SoundEvent("cmb_play_hit_heavy");

					//damageMax = maxTargetVitality * 1/30; 

					dmg = new W3DamageAction in theGame.damageMgr;
					
					dmg.Initialize(thePlayer, actortarget, thePlayer, thePlayer.GetName(), EHRT_Heavy, CPS_Undefined, false, false, true, false);
					
					dmg.SetProcessBuffsIfNoDamage(true);
					
					dmg.SetHitReactionType( EHRT_Heavy, true);
					
					//dmg.AddDamage( theGame.params.DAMAGE_NAME_DIRECT, damageMax );

					if( !actortarget.IsImmuneToBuff( EET_Stagger ) ) 
					{ 
						if( !actortarget.IsImmuneToBuff( EET_Stagger ) && !actortarget.IsImmuneToBuff( EET_Ragdoll ) && !actortarget.HasBuff( EET_Stagger ) && !actortarget.HasBuff( EET_Ragdoll ) ) 
						{
							dmg.AddEffectInfo( EET_Stagger, 0.5 );
						}
						else
						{
							if( !actortarget.IsImmuneToBuff( EET_Bleeding ) ) 
							{ 
								dmg.AddEffectInfo( EET_Bleeding, 3 );
							}
						}	
					}
						
					dmg.SetCriticalHit(); theGame.damageMgr.ProcessAction( dmg );
						
					delete dmg;	
				}
			}

			return;
		}
	}

	var vACS_Blood_Spatter_Switch : cACS_Blood_Spatter_Switch;

	var last_blood_spatter_spawn_time					: float;

	function Blood_Spatter_Switch()
	{
		if (!ACS_Settings_Main_Bool('acs_visual_main_settings','acs_additional_blood_spatter_enabled', true))
		{
			return;
		}

		if (theGame.GetEngineTimeAsSeconds() - last_blood_spatter_spawn_time > 0.125)
		{
			last_blood_spatter_spawn_time = theGame.GetEngineTimeAsSeconds();

			vACS_Blood_Spatter_Switch = new cACS_Blood_Spatter_Switch in this;
					
			vACS_Blood_Spatter_Switch.ACS_Blood_Spatter_Switch_Engage();
		}
	}

	function ACS_On_Hit_Effects (action : W3DamageAction)
	{
		var playerAttacker, playerVictim																								: CPlayer;
		var npc, npcAttacker 																											: CActor;
		var attackName 																													: name;
		var temp																														: CEntityTemplate;
		var ent																															: CEntity;
		var enemyAnimatedComponent 																										: CAnimatedComponent;

		if (FactsQuerySum("acs_transformation_activated") > 0)
		{
			return;
		}

		npc = (CActor)action.victim;
	
		npcAttacker = (CActor)action.attacker;
		
		playerAttacker = (CPlayer)action.attacker;
		
		playerVictim = (CPlayer)action.victim;

		if ( action.IsDoTDamage() 
		|| !action.IsActionMelee()
		|| npc.GetImmortalityMode() == AIM_Immortal
		|| npc.GetImmortalityMode() == AIM_Invulnerable
		|| npc.GetAttitude( thePlayer ) != AIA_Hostile
		)
		{
			return;
		}

		if (playerAttacker
		&& npc)
		{
			if (npc.GetCurrentHealth() <= 0.01
			&& GetWitcherPlayer().IsAnyWeaponHeld() 
			&& !GetWitcherPlayer().IsWeaponHeld('fist')
			)
			{
				if(!npc.HasTag('ACS_Death_Recorded'))
				{
					GetACSStorage().acs_Killcount_Increment('total');

					ACS_Persistent_Killcount();

					Fear_Stack();

					if 
					(
					!thePlayer.HasTag('ACS_Ghost_Stance_Active')
					&& FactsQuerySum("acs_transformation_activated") <= 0
					)
					{
						Ghost_Stance_Kill_Increment(false, 1);
					}

					if (!npc.HasAbility('mon_wraith_base')
					&& !npc.HasAbility('mon_noonwraith_base')
					&& !npc.HasAbility('mon_nightwraith_banshee')
					&& !npc.HasAbility('mon_EP2_wraiths')
					&& !npc.HasAbility('mon_nightwraith_iris')
					&& !npc.HasAbility('q604_shades')
					&& !npc.HasAbility('mon_wraiths_ep1')
					&& !npc.HasAbility('mon_djinn')
					&& !thePlayer.IsInFistFightMiniGame()
					&& !theGame.IsDialogOrCutscenePlaying() 
					&& !thePlayer.IsInNonGameplayCutscene() 
					&& !thePlayer.IsInGameplayScene()
					&& !theGame.GetPhotomodeEnabled() 
					&& !thePlayer.IsInCutsceneIntro() 
					&& !theGame.IsCurrentlyPlayingNonGameplayScene() 
					&& !theGame.IsBlackscreen()
					&& !theGame.IsFading()
					&& !theGame.HasBlackscreenRequested()
					&& !theGame.IsCurrentlyPlayingNonGameplayScene()
					&& !theGame.GetGuiManager().IsAnyMenu()
					&& !theGame.GetTutorialSystem().HasActiveTutorial()
					&& !thePlayer.IsInAir()
					&& !thePlayer.IsCiri()
					&& !thePlayer.GetIsHorseRacing()
					&& !ACS_Player_Near_Quest_Marker()
					&& RandF() < ACS_AdditionalWorldEncountersSpawnChance('acs_shade_encounter_enabled',1)
					&& !ACSGetCEntity('ACS_Cursed_Ground')
					&& RandF() < 0.01
					)
					{
						temp = (CEntityTemplate)LoadResource( 

						"dlc\dlc_acs\data\entities\other\acs_cursed_ground.w2ent"
							
						, true );

						ent = theGame.CreateEntity( temp, npc.GetWorldPosition(), npc.GetWorldRotation() );

						ent.AddTag('ACS_Cursed_Ground');
					}

					ACS_KillCount_Manager(npc);

					npc.AddTag('ACS_Death_Recorded');
				}
			}

			if (!action.WasDodged())
			{
				adrenalineDrain = false;
				RemoveTimer('AdrenalineDrainResume');
				AddTimer('AdrenalineDrainResume', ACS_Settings_Main_Float('acs_combat_main_settings','acs_adrenaline_drain_delay', 3) , false);
			}

			if(
			(thePlayer.HasTag('ACS_Horse_Dismount_Jump_Attack'))
			)
			{
				((CNewNPC)npc).AddEffectDefault( EET_HeavyKnockdown, thePlayer, 'acs_buff_effects' );	
			}

			if (
			thePlayer.GetInventory().ItemHasTag( thePlayer.GetInventory().GetCurrentlyHeldSword(), 'Aerondight' ))
			{
				if( ((CNewNPC)npc).IsShielded( thePlayer ) && !npc.HasAbility('WildHunt_Imlerith') )
				{
					((CNewNPC)npc).DrainStamina(ESAT_FixedValue, ((CNewNPC)npc).GetStatMax( BCS_Stamina ) * 0.33);
				}
			}
			else
			{
				if (playerAttacker.IsHeavyAttack(((W3Action_Attack)action).GetAttackName()))
				{
					if( ((CNewNPC)npc).IsShielded( thePlayer ) && !npc.HasAbility('WildHunt_Imlerith') )
					{
						((CNewNPC)npc).DrainStamina(ESAT_FixedValue, ((CNewNPC)npc).GetStatMax( BCS_Stamina ) * 0.125);
					}
				}
			}
		
			ACS_Shadow_Dash_On_Hit_Effects(action);

			ACS_Weapon_Art_Effects(action);

			ACS_Finisher_Or_Dismember(action);

			if (theGame.GetEngineTimeAsSeconds() - last_on_hit_time > 0.125)
			{
				last_on_hit_time = theGame.GetEngineTimeAsSeconds();

				On_Hit_Trigger_Switch(action);

				if (ACS_Settings_Main_Bool('acs_combat_main_settings','acs_on_hit_effects', false)
				&& ACS_GetWeaponMode() == 0)
				{
					Aard_Sword_On_Hit_Effects(action);

					Aard_Secondary_Sword_On_Hit_Effects(action);

					Yrden_Sword_On_Hit_Effects(action);

					Yrden_Secondary_Sword_On_Hit_Effects(action);

					Axii_Sword_On_Hit_Effects(action);

					Axii_Secondary_Sword_On_Hit_Effects(action);

					Quen_Sword_On_Hit_Effects(action);

					Quen_Secondary_Sword_On_Hit_Effects(action);

					Igni_Sword_On_Hit_Effects(action);

					Igni_Secondary_Sword_On_Hit_Effects(action);
				}
				else
				{
					Passive_Weapon_Effects_Switch();
				}
			}

			if ((action.WasDodged() 
			|| !action.DealtDamage()
			|| (((W3Action_Attack)action).IsParried()))
			)
			{
				thePlayer.ResetUninterruptedHitsCount();

				return;
			}

			if (!thePlayer.HasTag('ACS_Sword_Hit_Blood_Trigger'))
			{
				Sword_Hit_Blood_Trigger(action);

				thePlayer.AddTag('ACS_Sword_Hit_Blood_Trigger');
			}
		}
	}

	var last_on_hit_time : float;

	function On_Hit_Trigger_Switch (action : W3DamageAction)
	{
		var maxTargetVitality, maxTargetEssence, damageMax			: float;
		var entPhysics                  							: CEntity;
		var rot                        								: EulerAngles;
		var pos														: Vector;
		var player													: CR4Player;
		var bPos 													: Vector;
		var bRot 													: EulerAngles;
		var markerNPC_1												: CEntity;
		var itemEntity 												: CEntity;
		var weaponId 												: SItemUniqueId;

		weaponId = thePlayer.GetInventory().GetItemFromSlot( 'r_weapon');
		
		itemEntity = thePlayer.GetInventory().GetItemEntityUnsafe(weaponId);
		
		npc = (CActor)action.victim;

		playerAttacker = (CPlayer)action.attacker;

		maxAdrenaline = thePlayer.GetStatMax(BCS_Focus);
		
		curAdrenaline = thePlayer.GetStat(BCS_Focus);

		if ( playerAttacker 
		&& npc 
		&& npc.IsAlive()
		) 
		{ 
			if (playerAttacker.IsLightAttack(((W3Action_Attack)action).GetAttackName()) || ((W3Action_Attack)action).GetAttackName() == 'acs_attack_poison')
			{
				if (npc.HasTag('acs_heavy_attack_mark'))
				{
					if (curAdrenaline >= maxAdrenaline * 0.165)
					{
						if (thePlayer.HasTag('ACS_Flammable_Oil_Enabled'))
						{
							vACS_Armiger_Mode_On_Hit_Effects = new cACS_Armiger_Mode_On_Hit_Effects in this;

							if (ACS_GetItem_SwordHeldSwitchBasedUponStat('frost_sword'))
							{
								Detonation_Weapon_Effects_Switch();

								ACS_Ice_Blast();
							}
							else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('poison_sword'))
							{
								Detonation_Weapon_Effects_Switch();

								ACS_Poison_Cloud();
							}
							else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('bleed_sword'))
							{
								Detonation_Weapon_Effects_Switch();

								vACS_Armiger_Mode_On_Hit_Effects.ACS_AOE_Bloodarc_LVL_1_Engage();

								actors.Clear();
										
								actors = thePlayer.GetNPCsAndPlayersInRange( 3, 20, , FLAG_ExcludePlayer + FLAG_Attitude_Hostile + FLAG_OnlyAliveActors);


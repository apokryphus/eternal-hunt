		if (thePlayer.HasTag('ACS_SwordBuffAnimationPlayed'))
		{
			thePlayer.RaiseEvent('ACS_BothHandsAdditiveEnd');

			thePlayer.RemoveTag('ACS_SwordBuffAnimationPlayed');
		}

		RemoveSneaking(false);

		animatedComponentA = (CAnimatedComponent)thePlayer.GetComponentByClassName( 'CAnimatedComponent' );

		animatedComponentA.UnfreezePose(); animatedComponentA.UnfreezePoseFadeOut(0.01f);
	}

	function ACS_can_perform_special_attack(): bool 
	{
		var cooldown : float;

		cooldown = ACS_Settings_Main_Float('acs_combat_main_settings','acs_special_attack_cooldown', 1);

		if( thePlayer.GetStat( BCS_Focus ) < thePlayer.GetStatMax( BCS_Focus )/3) 
		{
			cooldown -= 0;
		}
		else if( thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus )/3
		&& thePlayer.GetStat( BCS_Focus ) < thePlayer.GetStatMax( BCS_Focus ) * 2/3) 
		{	
			cooldown -= 0.1;
		}
		else if( thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus ) * 2/3)
		{	
			cooldown -= 0.2;
		}

		if (!ACS_Settings_Main_Bool('acs_dodge_settings','acs_allow_attacking_while_in_dodge_animation', true))
		{
			if (thePlayer.IsCurrentlyDodging() 
			|| thePlayer.HasTag('ACS_Is_Currently_Dodging')
			)
			{
				return false;
			}
		}

		return (theGame.GetEngineTimeAsSeconds() - last_special_attack_time > cooldown) ;
	}

	function ACS_refresh_special_attack_cooldown() 
	{
		var animatedComponentA 	: CAnimatedComponent;

		last_special_attack_time = theGame.GetEngineTimeAsSeconds();

		if (GetWitcherPlayer().HasTag('ACS_Special_Dodge'))
		{
			GetWitcherPlayer().RemoveTag('ACS_Special_Dodge');
		}

		if(!ACS_GetItem_Sword_IsEquipped('jingubang_steel', 'steel') || ACS_GetItem_Sword_IsEquipped('jingubang_silver', 'silver'))
		{
			thePlayer.RaiseEvent('ACS_SwordWalkAdditiveEnd');thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');RemoveTimer('CombatTauntDelay');thePlayer.RaiseEvent('ACS_SwordTauntEnd');
		}

		if (combatExtraActive)
		{
			RemoveTimer('combatExtraReset');
			
			thePlayer.RaiseEvent('ACS_CombatExtraReset');

			combatExtraActive = false;
		}

		if (idleAdditiveExtraActive)
		{
			thePlayer.RaiseEvent('ACS_IdleAdditiveReset');

			SetIdleAdditiveExtraStatus(false);
		}

		if (thePlayer.HasTag('ACS_SwordBuffAnimationPlayed'))
		{
			thePlayer.RaiseEvent('ACS_BothHandsAdditiveEnd');

			thePlayer.RemoveTag('ACS_SwordBuffAnimationPlayed');
		}

		RemoveSneaking(false);

		animatedComponentA = (CAnimatedComponent)thePlayer.GetComponentByClassName( 'CAnimatedComponent' );

		animatedComponentA.UnfreezePose(); animatedComponentA.UnfreezePoseFadeOut(0.01f);
		
	}

	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	function ACS_can_perform_parry_skill(): bool 
	{
		var cooldown : float;

		cooldown = ACS_Settings_Main_Float('acs_parry_skills_settings','acs_parry_skills_cooldown', 0.5);

		if (!ACS_Settings_Main_Bool('acs_dodge_settings','acs_allow_attacking_while_in_dodge_animation', true))
		{
			if (thePlayer.IsCurrentlyDodging() 
			|| thePlayer.HasTag('ACS_Is_Currently_Dodging')
			)
			{
				return false;
			}
		}

		return (theGame.GetEngineTimeAsSeconds() - last_parry_skill_time > cooldown) ;
	}

	function ACS_refresh_parry_skill_cooldown() 
	{
		var animatedComponentA 	: CAnimatedComponent;

		last_parry_skill_time = theGame.GetEngineTimeAsSeconds();

		if (GetWitcherPlayer().HasTag('ACS_Special_Dodge'))
		{
			GetWitcherPlayer().RemoveTag('ACS_Special_Dodge');
		}

		RemoveSneaking(false);

		animatedComponentA = (CAnimatedComponent)thePlayer.GetComponentByClassName( 'CAnimatedComponent' );

		animatedComponentA.UnfreezePose(); animatedComponentA.UnfreezePoseFadeOut(0.01f);
	}


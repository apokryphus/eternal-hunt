						//ent.CreateAttachment( wings_torso_anchor_1, , Vector( 0, 0.25, 0.125 ), EulerAngles(10,0,0) );

						ent.CreateAttachment( thePlayer, 'blood_point', Vector( 0, 0.4, -0.03 ), EulerAngles(0,-90,90) );

						ent.PlayEffect('summoning_burst');

						ent.PlayEffect('summoning_burst_2');

						ent.PlayEffect('crow_trail');

						ent.PlayEffect('feathers_fx');

						ent.AddTag('ACS_Wings_Entity');

						if (RandF() < 0.5)
						{
							thePlayer.SoundEvent("monster_cockatrice_wing_flap");
						}
						else
						{
							thePlayer.SoundEvent("monster_griffon_wing_flap");
						}

						AddTimer('Fleder_Glide_Fear', 0.001 , true);
					}
					else if (ACS_Settings_Main_Int('acs_jump_settings','acs_jump_glide_form', 0) == 6)
					{
						thePlayer.SoundEvent("monster_dettlaff_monster_combat_construct_dash_vfx");

						thePlayer.SoundEvent("magic_yennefer_necromancy_loop_start");

						thePlayer.SoundEvent( "q704_regis_mistform_activates" );

						thePlayer.SoundEvent( "q704_regis_mistform_LP" );
						thePlayer.SoundEvent( "q704_regis_mistform_LP" );
						thePlayer.SoundEvent( "q704_regis_mistform_LP" );

						ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

						"dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent"

						, true ), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );
						
						ent.CreateAttachment( thePlayer, , Vector( 0, 2, -0.5 ), EulerAngles(0,0,0 ));

						//ent.PlayEffect('trail_bat_swarm');

						ent.PlayEffect('venom_bat_swarm');

						//ent.PlayEffect('venom_hit_bat_swarm');

						//ent.PlayEffect('bat_swarm_01');

						//ent.PlayEffect('bat_swarm_02');

						//ent.PlayEffect('bat_swarm_03');

						//ent.PlayEffect('bat_swarm_04');

						//ent.PlayEffect('bat_swarm_05');

						//ent.PlayEffect('bat_swarm_06');

						ent.AddTag('ACS_Wings_Entity');

						thePlayer.SetVisibility(false);

						thePlayer.AddTag('ACS_Vampire_Blood_Flight');

						AddTimer('Fleder_Glide_Fear', 0.001 , true);

						RemoveTimer('Vampire_Monster_Bat_Swarm_Small');
						AddTimer('Vampire_Monster_Bat_Swarm_Small', 0.5 , true);
					}
				}
			}
			
			thePlayer.EnableCollisions(false);
			thePlayer.EnableCharacterCollisions(false);

			thePlayer.SetImmortalityMode( AIM_Invulnerable, AIC_Default, true ); 

			if (thePlayer.HasTag('ACS_Wild_Hunt_Horse_Flying'))
			{
				if (thePlayer.IsAnyWeaponHeld() && !thePlayer.IsWeaponHeld('fist'))
				{
					thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( 'horse_speed_walk_right_pose_loop', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 1.0f) );

					((CAnimatedComponent)thePlayer.GetComponentByClassName('CAnimatedComponent')).FreezePoseFadeIn(0.75f);
				}
				else
				{
					thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( 'horse_gallop', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 1.0f) );

					((CAnimatedComponent)thePlayer.GetComponentByClassName('CAnimatedComponent')).FreezePoseFadeIn(0.3f);
				}
			}
			else
			{
				if (!wraith_pose
				)
				{
					wraith_pose = true;
				}

				if ( thePlayer.IsAnyWeaponHeld() )
				{
					if (thePlayer.IsWeaponHeld('fist') )
					{
						PlayerPlayAnimation( 'man_geralt_sword_dodge_roll_rp_f_01_fist' );
					}
					else
					{
						PlayerPlayAnimation( 'man_geralt_sword_dodge_roll_rp_f_01' );
					}
				}
				else
				{
					PlayerPlayAnimation( 'man_geralt_sword_dodge_roll_rp_f_01_fist' );
				}

				RemoveTimer('GlideAnimInitiate');
				AddTimer('GlideAnimInitiate', 0.25 , false);
			}

			if (!thePlayer.HasTag('ACS_Wild_Hunt_Horse_Flying'))
			{
				if (!thePlayer.HasTag('ACS_HideWeaponOnDodge'))
				{
					thePlayer.AddTag('ACS_HideWeaponOnDodge');
				}
			}

			FactsAdd("ACS_Is_Gliding", 1, -1);
		}
	}

	timer function GlideAnimInitiate( time : float , id : int )
	{
		if (FactsQuerySum("ACS_Is_Gliding") > 0)
		{
			thePlayer.RaiseEvent('ACS_FlyPoseF');
		}
	}
	
	function Glide_Collision_Check(): bool
	{
		var tempEndPoint_1, tempEndPoint_2, normal_1, normal_2			: Vector;
		var collisionGroupsNames										: array<name>;	

		collisionGroupsNames.Clear();

		collisionGroupsNames.PushBack( 'Terrain');
		collisionGroupsNames.PushBack( 'Static');
		collisionGroupsNames.PushBack( 'Water'); 
        collisionGroupsNames.PushBack( 'Door' );
        collisionGroupsNames.PushBack( 'Dangles' );
        collisionGroupsNames.PushBack( 'Foliage' );
        collisionGroupsNames.PushBack( 'Destructible' );
        collisionGroupsNames.PushBack( 'RigidBody' );
        collisionGroupsNames.PushBack( 'Boat' );
        collisionGroupsNames.PushBack( 'BoatDocking' );
        collisionGroupsNames.PushBack( 'Platforms' );
       	//collisionGroupsNames.PushBack( 'Corpse' );
        //collisionGroupsNames.PushBack( 'Projectile' );
       	//collisionGroupsNames.PushBack( 'ParticleCollider' ); 
        //collisionGroupsNames.PushBack( 'Ragdoll' ); 

		if ( 
		theGame.GetWorld().StaticTrace( thePlayer.GetWorldPosition(), thePlayer.GetWorldPosition() + thePlayer.GetHeadingVector() * 2, tempEndPoint_1, normal_1, collisionGroupsNames ) 
		|| theGame.GetWorld().StaticTrace( thePlayer.GetWorldPosition(), thePlayer.GetWorldPosition() + thePlayer.GetWorldUp() * -0.5, tempEndPoint_2, normal_2, collisionGroupsNames )
		)		
		{
			return true;
		}
		
		return false;
	}

	function Glide_Stop()
	{
		RemoveTimer('GlideAnimInitiate');

		theGame.ReleaseNoSaveLock( ACS_Glide_Savelock_ID );

		thePlayer.UnblockAction( EIAB_Crossbow, 			'ACS_Gliding');
		thePlayer.UnblockAction( EIAB_CallHorse,			'ACS_Gliding');
		thePlayer.UnblockAction( EIAB_Signs, 				'ACS_Gliding');
		thePlayer.UnblockAction( EIAB_DrawWeapon, 			'ACS_Gliding');
		thePlayer.UnblockAction( EIAB_FastTravel, 			'ACS_Gliding');
		thePlayer.UnblockAction( EIAB_Fists, 				'ACS_Gliding');
		thePlayer.UnblockAction( EIAB_InteractionAction, 	'ACS_Gliding');
		thePlayer.UnblockAction( EIAB_UsableItem,			'ACS_Gliding');
		thePlayer.UnblockAction( EIAB_ThrowBomb,			'ACS_Gliding');
		thePlayer.UnblockAction( EIAB_SwordAttack,			'ACS_Gliding');
		thePlayer.UnblockAction( EIAB_LightAttacks,			'ACS_Gliding');
		thePlayer.UnblockAction( EIAB_HeavyAttacks,			'ACS_Gliding');
		thePlayer.UnblockAction( EIAB_SpecialAttackLight,	'ACS_Gliding');
		thePlayer.UnblockAction( EIAB_SpecialAttackHeavy,	'ACS_Gliding');
		thePlayer.UnblockAction( EIAB_Dodge,				'ACS_Gliding');
		thePlayer.UnblockAction( EIAB_Roll,					'ACS_Gliding');
		thePlayer.UnblockAction( EIAB_Parry,				'ACS_Gliding');
		thePlayer.UnblockAction( EIAB_MeditationWaiting,	'ACS_Gliding');
		thePlayer.UnblockAction( EIAB_OpenMeditation,		'ACS_Gliding');
		thePlayer.UnblockAction( EIAB_RadialMenu,			'ACS_Gliding');
		thePlayer.UnblockAction( EIAB_Movement,				'ACS_Gliding');
		thePlayer.UnblockAction( EIAB_Interactions, 		'ACS_Gliding');
		thePlayer.UnblockAction( EIAB_Jump, 				'ACS_Gliding');
		thePlayer.UnblockAction( EIAB_QuickSlots, 			'ACS_Gliding');

		RemoveTimer('ACS_Gliding');

		thePlayer.RaiseEvent('ACS_ForceHandClosedREnd');

		if (!thePlayer.HasTag('ACS_Dual_Wield_Active') && !ACSGetCEntity('ACS_Viper_Dagger_L')){thePlayer.RaiseEvent('ACS_ForceHandClosedLEnd');}

		thePlayer.StopEffect('glide_fx');
		thePlayer.PlayEffectSingle('glide_fx');
		thePlayer.StopEffect('glide_fx');

		thePlayer.StopEffect( 'bruxa_dash_trails' );
		thePlayer.PlayEffectSingle( 'bruxa_dash_trails' );
		thePlayer.StopEffect( 'bruxa_dash_trails' );

		thePlayer.PlayEffectSingle('embers_particles_test');
		thePlayer.StopEffect('embers_particles_test');

		thePlayer.EnableCollisions(true);
		if (!thePlayer.IsUsingHorse()&& !thePlayer.IsUsingVehicle()){thePlayer.EnableCharacterCollisions(true); }

		thePlayer.SetImmortalityMode( AIM_None, AIC_Default, true ); 

		thePlayer.RemoveTag('ACS_Wild_Hunt_Horse_Flying');

		if (thePlayer.HasTag('ACS_Vampire_Blood_Flight'))
		{
			thePlayer.RemoveTag('ACS_Vampire_Blood_Flight');

			thePlayer.SoundEvent("magic_yennefer_necromancy_loop_stop");

			thePlayer.SoundEvent("q704_regis_mistform_LP_stop");
			thePlayer.SoundEvent("q704_regis_mistform_LP_stop");
			thePlayer.SoundEvent("q704_regis_mistform_LP_stop");

			thePlayer.SoundEvent("monster_dettlaff_monster_combat_construct_dash_vfx");

			thePlayer.StopEffect('shadowdash_body_blood_construct');

			thePlayer.StopEffect('shadowdash_ground_blood_construct');

			thePlayer.StopEffect('avatar_death_swollen_no_decal_construct');

			ACSGetCEntity('ACS_Wings_Entity').StopEffect('shadowdash_construct');

			ACSGetCEntity('ACS_Wings_Entity').DestroyAfter(3);

			ACSGetCEntity('ACS_Wings_Entity').RemoveTag('ACS_Wings_Entity');

		}
		else
		{
			ACSGetCEntity('ACS_Wings_Entity_Anchor').BreakAttachment();

			ACSGetCEntity('ACS_Wings_Entity_Anchor').CreateAttachment(thePlayer,,Vector(0,0,-200));

			ACSGetCEntity('ACS_Wings_Entity_Anchor').DestroyAfter(0.5);

			ACSGetCEntity('ACS_Wings_Entity_Anchor').RemoveTag('ACS_Wings_Entity_Anchor');

			ACSGetCEntity('ACS_Wings_Entity').BreakAttachment();

			ACSGetCEntity('ACS_Wings_Entity').CreateAttachment(thePlayer,,Vector(0,0,-200));

			ACSGetCEntity('ACS_Wings_Entity').DestroyAfter(0.5);

			ACSGetCEntity('ACS_Wings_Entity').RemoveTag('ACS_Wings_Entity');
		}

		thePlayer.DestroyEffect('acs_glide_disappear');

		ACSGetCEntity('ACS_Igni_Glide_Entity_R').Destroy();

		ACSGetCEntity('ACS_Igni_Glide_Entity_L').Destroy();

		ACSGetCEntity('ACS_Igni_Glide_Entity_L_Leg').Destroy();

		ACSGetCEntity('ACS_Igni_Glide_Entity_R_Leg').Destroy();

		RemoveTimer('Fleder_Glide_Fear');

		RemoveTimer('Vampire_Monster_Bat_Swarm_Small');

		thePlayer.SetVisibility( true );

		((CAnimatedComponent)thePlayer.GetComponentByClassName('CAnimatedComponent')).UnfreezePoseFadeOut(0);

		((CAnimatedComponent)thePlayer.GetComponentByClassName('CAnimatedComponent')).UnfreezePose();

		if (thePlayer.IsInAir())
		{
			PlayerPlayAnimation( 'ex_fall_start' );
		}
		else
		{
			if ( thePlayer.IsAnyWeaponHeld() )
			{
				if (thePlayer.IsWeaponHeld('fist') )
				{
					PlayerPlayAnimation( 'man_geralt_sword_dodge_roll_rp_f_01_fist' );
				}
				else
				{
					PlayerPlayAnimation( 'man_geralt_sword_dodge_roll_rp_f_01' );
				}
			}
			else
			{
				PlayerPlayAnimation( 'man_geralt_sword_dodge_roll_rp_f_01_fist' );
			}
		}

		thePlayer.SoundEvent("monster_dettlaff_monster_movement_wing_flap_long_hard");

		thePlayer.SoundEvent("monster_dettlaff_monster_movement_land");

		if ( thePlayer.HasTag('ACS_HideWeaponOnDodge') 
		//&& !thePlayer.HasTag('ACS_Bruxa_Bite_Process')
		)
		{
			if (!thePlayer.HasTag('acs_aard_sword_equipped'))
			{
				ACS_Weapon_Respawn();
			}
			
			thePlayer.RemoveTag('ACS_HideWeaponOnDodge');

			thePlayer.RemoveTag('ACS_HideWeaponOnDodge_Claw_Effect');
		}

		if (wraith_pose)
		{
			wraith_pose = false;
		}

		if (wraith_pose_switch
		)
		{
			wraith_pose_switch = false;
		}

		thePlayer.RaiseEvent('ACS_FlyPoseReset');

		FactsRemove("ACS_Is_Gliding");
	}

	event OnCbtDodge( action : SInputAction )
	{
		var targetDistance : float;

		if (FactsQuerySum("acs_transformation_activated") > 0)
		{
			ACS_ExplorationDelayHack(false, 3);

			if( thePlayer.IsActionAllowed(EIAB_Dodge)  )
			{
				if (thePlayer.GetBIsInputAllowed())
				{
					if (FactsQuerySum("acs_wolven_curse_activated") > 0)
					{
						if ( IsPressed(action) )
						{
							ACS_Transformation_Werewolf_Dodge();
						}
					}

					if (FactsQuerySum("acs_vampireess_transformation_activated") > 0)
					{
						if ( IsPressed(action) )
						{
							if (!ACSGetCActor('ACS_Transformation_Vampiress').HasTag('ACS_Vampiress_Sorceress_Mode'))
							{
								ACS_Transformation_Vampiress_Dodge_Melee();
							}
							else
							{
								ACS_Transformation_Vampiress_Dodge_Ranged();
							}
						}
					}

					if (FactsQuerySum("acs_vampire_monster_transformation_activated") > 0)
					{
						if ( IsPressed(action) )
						{
							if (ACSGetCActor('ACS_Transformation_Vampire_Monster').HasTag('ACS_Vampire_Monster_Ground_Mode'))
							{
								ACS_Transformation_Vampire_Monster_Teleport_Dodge();
							}
						}
					}

					if (FactsQuerySum("acs_red_miasmal_curse_activated") > 0)
					{
						if ( IsPressed(action) )
						{
							if (!thePlayer.IsInInterior())
							{
								ACS_Transformation_Red_Miasmal_Dodge();
							}
						}
					}

					if (FactsQuerySum("acs_sharley_curse_activated") > 0)
					{
						if ( IsPressed(action) )
						{
							ACS_Transformation_Sharley_Dodge();
						}
					}

					if (FactsQuerySum("acs_black_wolf_curse_activated") > 0)
					{
						if ( IsPressed(action) )
						{
							ACS_Transformation_Black_Wolf_Dodge();
						}
					}

					if (FactsQuerySum("acs_giant_curse_activated") > 0&& !ACSGetCActor('ACS_Transformation_Giant').HasTag('ACS_Transformation_Giant_Block_All_Actions'))
					{
						if ( IsPressed(action) )
						{
							ACS_Transformation_Giant_Dodge();
						}
					}
				}
			}

			return false;
		}

		if(theGame.GetInGameConfigWrapper().GetVarValue('Gameplay', 'EnableAlternateSignCasting') == "1")
		{
			altSignCasting = true;
		}	
		else
		{
			altSignCasting = false;
		}

		if(altSignCasting
		&& !theInput.LastUsedPCInput() && !thePlayer.IsCastingSign() && theInput.GetActionValue('CastSign') > 0.1f && !GetWitcherPlayer().IsCurrentSignChanneled())
		{
			return false;
		}

		if( !thePlayer.IsActionAllowed(EIAB_Dodge)) 
		{
			return false;
		}

		if(thePlayer.HasTag('ACS_Manual_Combat_Control')){thePlayer.RemoveTag('ACS_Manual_Combat_Control');} RemoveTimer('Manual_Combat_Control_Remove');

		if (thePlayer.HasTag('ACS_IsSwordWalking'))
		{
			thePlayer.RemoveTag('ACS_IsSwordWalking');
		}

		SwordWalkAdditiveEnd(action);

		if (ACSGetCEntity('ACS_Aim_Impact_Entity'))
		{
			ACSGetCEntity('ACS_Aim_Impact_Entity').Destroy();
		}
		
		if ( theInput.LastUsedPCInput() )
		{		
			if ( IsPressed(action) )
			{
				Rage_Counter_Manager(3);

				ACSGetCEntity('ACS_Quen_Bubble').Destroy();
		
				ACSGetCEntity('ACS_Quen_Fx').Destroy();

				ACSGetCEntity('ACS_Sign_Icon').Destroy();

				ACSGetCEntity('ACS_Sign_Icon_Anchor').Destroy();

				if ( ACS_Settings_Main_Bool('acs_main_settings','acs_mod_enabled', true) ) 
				{
					
					if( BruxaDashCallTime + DOUBLE_TAP_WINDOW_DODGE >= theGame.GetEngineTimeAsSeconds() )
					{
						BruxaDashDoubleTap = true;
					}
					else
					{
						BruxaDashDoubleTap = false;	
					}

					if
					(theInput.IsActionPressed('Sprint') )
					{
						if( Flying_Target_Check()
						&& !thePlayer.HasTag('ACS_Air_Time')
						&& ACS_Settings_Main_Bool('acs_combat_main_settings','acs_air_time', true)
						&& !getIsInCombatSlide
						)
						{
							RemoveTimer('Air_Time_Trigger_Delay');
							AddTimer('Air_Time_Trigger_Delay', 0.5 , false);
						}
						else
						{
							RemoveTimer('Air_Time_Trigger_Delay');

							if (thePlayer.HasTag('ACS_Air_Time'))
							{
								RemoveTimer('Air_Time_Movement_Adjust_Delay');

								thePlayer.BlockAllActions( 'ACS_Air_Time_Init', false );

								thePlayer.EnableCollisions(true);

								thePlayer.RaiseEvent('ACS_FeetAdditiveEnd');

								thePlayer.UnblockAction( EIAB_CallHorse,			'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_DrawWeapon, 		'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_FastTravel, 		'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_InteractionAction, 	'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_UsableItem,			'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_MeditationWaiting,	'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_OpenMeditation,		'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_RadialMenu,			'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_Movement,			'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_QuickSlots, 		'ACS_Air_Time');

								thePlayer.RemoveTag('ACS_Air_Time');
							}
						}
					}

				
					if (BruxaDashDoubleTap)
					{
						if (theInput.GetActionValue('LockAndGuard') > 0.1 
						&& (FlipTargetCheckPre('front') || FlipTargetCheckPre('back') || FlipTargetCheckPre('right') || FlipTargetCheckPre('left'))
						)
						{
							if (theInput.GetActionValue('GI_AxisLeftY') > 0.1 
							&& theInput.GetActionValue('GI_AxisLeftX') == 0
							&& FlipTargetCheckPre('front')
							)
							{
								FlipTargetCheck('front');
							}
							else if (theInput.GetActionValue('GI_AxisLeftY') < -0.1 
							&& theInput.GetActionValue('GI_AxisLeftX') == 0  
							&& FlipTargetCheckPre('back')
							)
							{
								FlipTargetCheck('back');
							}
							else if (theInput.GetActionValue('GI_AxisLeftX') > 0.1 
							&& theInput.GetActionValue('GI_AxisLeftY') == 0 
							&& FlipTargetCheckPre('right')
							)
							{
								FlipTargetCheck('right');
							}
							else if (theInput.GetActionValue('GI_AxisLeftX') < -0.1 
							&& theInput.GetActionValue('GI_AxisLeftY') == 0
							&& FlipTargetCheckPre('left')
							) 
							{
								FlipTargetCheck('left');
							}
							else if (theInput.GetActionValue('GI_AxisLeftY') > 0.1 
							&& theInput.GetActionValue('GI_AxisLeftX') > 0.1 
							&& FlipTargetCheckPre('front')
							)
							{
								FlipTargetCheck('front');
							}
							else if (theInput.GetActionValue('GI_AxisLeftY') > 0.1 
							&& theInput.GetActionValue('GI_AxisLeftX') < -0.1 
							&& FlipTargetCheckPre('front')
							)
							{
								FlipTargetCheck('front');
							}
							else if (theInput.GetActionValue('GI_AxisLeftY') < -0.1 
							&& theInput.GetActionValue('GI_AxisLeftX') > 0.1 
							&& FlipTargetCheckPre('back')
							)
							{
								FlipTargetCheck('back');
							}
							else if (theInput.GetActionValue('GI_AxisLeftX') < -0.1 
							&& theInput.GetActionValue('GI_AxisLeftY') < -0.1 
							&& FlipTargetCheckPre('back')
							)
							{
								FlipTargetCheck('back');
							}
						}
						else
						{
							if (Attack_Directional_Press_Check())
							{
								if (ACS_Settings_Main_Bool('acs_dodge_settings','acs_bruxa_leap_attack', false) && thePlayer.IsInCombat())
								{
									JumpAttackCombat();
								}
								else if ( ACS_Settings_Main_Bool('acs_bruxa_dash_settings','acs_bruxa_dash', false) )
								{
									BruxaDash_Combat();
								}
								else
								{
									if (thePlayer.HasTag('ACS_Bruxa_Bite_Process'))
									{
										bruxa_blood_suck_end_actual();
									}

									if (ACS_CombatSlide_Enabled()
									&& !getIsInCombatSlide
									)
									{
										if (thePlayer.GetIsSprinting()
										&& (thePlayer.IsActionAllowed( EIAB_RunAndSprint ) || thePlayer.IsActionAllowed( EIAB_Sprint ))
										&& thePlayer.GetSprintingTime() > 0.25
										&& thePlayer.substateManager.GetStateTimeF() > 0.25
										&& thePlayer.GetMovingAgentComponent().GetSpeed() >= 3 
										&& !thePlayer.IsCurrentlyDodging()
										&& !thePlayer.HasTag('ACS_Is_Currently_Dodging')
										&& !thePlayer.HasTag('ACS_Player_Is_Attacking')
										&& !thePlayer.IsInHitAnim()
										&& !thePlayer.HasTag('ACS_IsPerformingFinisher')
										&& !thePlayer.HasTag('ACS_IsPerformingCombatDismember')
										&& !thePlayer.IsCrossbowHeld()
										&& ACS_BuffCheck()
										&& thePlayer.IsActionAllowed(EIAB_Movement)
										&& thePlayer.GetStat( BCS_Stamina ) > 0
										&& !thePlayer.IsSwimming()
										&& !thePlayer.IsDiving()
										)
										{
											vACS_CombatSlide = new cACS_CombatSlide in this;

											vACS_CombatSlide.Combat_Slide_Engage();
										}
										else
										{
											thePlayer.AddTag('ACS_Player_Flip_Window');

											RemoveTimer('Flip_Ticket_Removal');
											AddTimer('Flip_Ticket_Removal', 0.33   , false);

											ACS_BruxaDodgeSlideBackInit();

											DodgeSneaking();
										}
									}
									else
									{
										thePlayer.AddTag('ACS_Player_Flip_Window');

										RemoveTimer('Flip_Ticket_Removal');
										AddTimer('Flip_Ticket_Removal', 0.33   , false);
										
										ACS_BruxaDodgeSlideBackInit();

										DodgeSneaking();
									}
								}
							}
							else
							{
								if ( ACS_Settings_Main_Bool('acs_bruxa_dash_settings','acs_bruxa_dash', false) )
								{
									BruxaDash_Combat();
								}
								else
								{
									if (thePlayer.HasTag('ACS_Bruxa_Bite_Process'))
									{
										bruxa_blood_suck_end_actual();
									}

									if (ACS_CombatSlide_Enabled()
									&& !getIsInCombatSlide
									)
									{
										if (thePlayer.GetIsSprinting()
										&& (thePlayer.IsActionAllowed( EIAB_RunAndSprint ) || thePlayer.IsActionAllowed( EIAB_Sprint ))
										&& thePlayer.GetSprintingTime() > 0.25
										&& thePlayer.substateManager.GetStateTimeF() > 0.25
										&& thePlayer.GetMovingAgentComponent().GetSpeed() >= 3 
										&& !thePlayer.IsCurrentlyDodging()
										&& !thePlayer.HasTag('ACS_Is_Currently_Dodging')
										&& !thePlayer.HasTag('ACS_Player_Is_Attacking')
										&& !thePlayer.IsInHitAnim()
										&& !thePlayer.HasTag('ACS_IsPerformingFinisher')
										&& !thePlayer.HasTag('ACS_IsPerformingCombatDismember')
										&& !thePlayer.IsCrossbowHeld()
										&& ACS_BuffCheck()
										&& thePlayer.IsActionAllowed(EIAB_Movement)
										&& thePlayer.GetStat( BCS_Stamina ) > 0
										&& !thePlayer.IsSwimming()
										&& !thePlayer.IsDiving()
										)
										{
											vACS_CombatSlide = new cACS_CombatSlide in this;

											vACS_CombatSlide.Combat_Slide_Engage();
										}
										else
										{
											thePlayer.AddTag('ACS_Player_Flip_Window');

											RemoveTimer('Flip_Ticket_Removal');
											AddTimer('Flip_Ticket_Removal', 0.33   , false);

											ACS_BruxaDodgeSlideBackInit();

											DodgeSneaking();
										}
									}
									else
									{
										thePlayer.AddTag('ACS_Player_Flip_Window');

										RemoveTimer('Flip_Ticket_Removal');
										AddTimer('Flip_Ticket_Removal', 0.33   , false);

										ACS_BruxaDodgeSlideBackInit();

										DodgeSneaking();
									}
								}
							}
						}
					}
					else
					{
						if (thePlayer.HasTag('ACS_Bruxa_Bite_Process'))
						{
							bruxa_blood_suck_end_actual();
						}

						if (ACS_CombatSlide_Enabled()
						&& !getIsInCombatSlide
						)
						{
							if (thePlayer.GetIsSprinting()
							&& (thePlayer.IsActionAllowed( EIAB_RunAndSprint ) || thePlayer.IsActionAllowed( EIAB_Sprint ))
							&& thePlayer.GetSprintingTime() > 0.25
							&& thePlayer.substateManager.GetStateTimeF() > 0.25
							&& thePlayer.GetMovingAgentComponent().GetSpeed() >= 3 
							&& !thePlayer.IsCurrentlyDodging()
							&& !thePlayer.HasTag('ACS_Is_Currently_Dodging')
							&& !thePlayer.HasTag('ACS_Player_Is_Attacking')
							&& !thePlayer.IsInHitAnim()
							&& !thePlayer.HasTag('ACS_IsPerformingFinisher')
							&& !thePlayer.HasTag('ACS_IsPerformingCombatDismember')
							&& !thePlayer.IsCrossbowHeld()
							&& ACS_BuffCheck()
							&& thePlayer.IsActionAllowed(EIAB_Movement)
							&& thePlayer.GetStat( BCS_Stamina ) > 0
							&& !thePlayer.IsSwimming()
							&& !thePlayer.IsDiving()
							)
							{
								vACS_CombatSlide = new cACS_CombatSlide in this;

								vACS_CombatSlide.Combat_Slide_Engage();
							}
							else
							{
								thePlayer.AddTag('ACS_Player_Flip_Window');

								RemoveTimer('Flip_Ticket_Removal');
								AddTimer('Flip_Ticket_Removal', 0.33   , false);
								
								ACS_BruxaDodgeSlideBackInit();

								DodgeSneaking();
							}
						}
						else
						{
							thePlayer.AddTag('ACS_Player_Flip_Window');

							RemoveTimer('Flip_Ticket_Removal');
							AddTimer('Flip_Ticket_Removal', 0.33   , false);
							
							ACS_BruxaDodgeSlideBackInit();

							DodgeSneaking();
						}
					}
				

					BruxaDashCallTime = theGame.GetEngineTimeAsSeconds();
				

					return true;
				}
				else
				{
					thePlayer.EvadePressed(EBAT_Dodge);
				}
			}

			if (IsReleased( action ))
			{
				RemoveTimer('Air_Time_Trigger_Delay');

				RemoveTimer('RollDelay');

				RemoveTimer('SneakingInitiate');RemoveTimer('SneakingCombatInitiate');
			}
		}
		else if ( !theInput.LastUsedPCInput() )
		{
			if(altSignCasting && (thePlayer.IsCastingSign() || theInput.GetActionValue('CastSign') > 0.1f))
			{
				return false;
			}

			if (ACS_Cast_Sign_Process)
			{
				return false;
			}

			if ( IsPressed(action) )
			{
				if(altSignCasting && !theInput.LastUsedPCInput() && theInput.GetActionValue('CastSign') > 0.1f)
				{
					
					
				}			
				else
				{
					Rage_Counter_Manager(3);

					ACSGetCEntity('ACS_Quen_Bubble').Destroy();
		
					ACSGetCEntity('ACS_Quen_Fx').Destroy();

					ACSGetCEntity('ACS_Sign_Icon').Destroy();

					ACSGetCEntity('ACS_Sign_Icon_Anchor').Destroy();

					if
					(theInput.IsActionPressed('Sprint') )
					{
						if( Flying_Target_Check()
						&& !thePlayer.HasTag('ACS_Air_Time')
						&& ACS_Settings_Main_Bool('acs_combat_main_settings','acs_air_time', true)
						&& !getIsInCombatSlide
						)
						{

							RemoveTimer('Air_Time_Trigger_Delay');
							AddTimer('Air_Time_Trigger_Delay', 0.5 , false);
						}
						else
						{
							RemoveTimer('Air_Time_Trigger_Delay');

							if (thePlayer.HasTag('ACS_Air_Time'))
							{
								RemoveTimer('Air_Time_Movement_Adjust_Delay');

								thePlayer.BlockAllActions( 'ACS_Air_Time_Init', false );

								thePlayer.EnableCollisions(true);

								thePlayer.RaiseEvent('ACS_FeetAdditiveEnd');

								thePlayer.UnblockAction( EIAB_CallHorse,			'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_DrawWeapon, 		'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_FastTravel, 		'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_InteractionAction, 	'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_UsableItem,			'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_MeditationWaiting,	'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_OpenMeditation,		'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_RadialMenu,			'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_Movement,			'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_QuickSlots, 		'ACS_Air_Time');

								thePlayer.RemoveTag('ACS_Air_Time');
							}
						}
					}

					if ( ACS_Settings_Main_Bool('acs_main_settings','acs_mod_enabled', true) ) 
					{
						
						if (thePlayer.HasTag('ACS_Bruxa_Bite_Process'))
						{
							bruxa_blood_suck_end_actual();
						}

						if( BruxaDashCallTime + DOUBLE_TAP_WINDOW_DODGE >= theGame.GetEngineTimeAsSeconds() )
						{
							BruxaDashDoubleTap = true;
						}
						else
						{
							BruxaDashDoubleTap = false;	
						}

						if (BruxaDashDoubleTap)
						{
							if (theInput.GetActionValue('LockAndGuard') > 0.1 
							&& (FlipTargetCheckPre('front') || FlipTargetCheckPre('back') || FlipTargetCheckPre('right') || FlipTargetCheckPre('left'))
							)
							{
								if (theInput.GetActionValue('GI_AxisLeftY') > 0.1 
								&& theInput.GetActionValue('GI_AxisLeftX') == 0
								&& FlipTargetCheckPre('front')
								)
								{
									FlipTargetCheck('front');
								}
								else if (theInput.GetActionValue('GI_AxisLeftY') < -0.1 
								&& theInput.GetActionValue('GI_AxisLeftX') == 0  
								&& FlipTargetCheckPre('back')
								)
								{
									FlipTargetCheck('back');
								}
								else if (theInput.GetActionValue('GI_AxisLeftX') > 0.1 
								&& theInput.GetActionValue('GI_AxisLeftY') == 0 
								&& FlipTargetCheckPre('right')
								)
								{
									FlipTargetCheck('right');
								}
								else if (theInput.GetActionValue('GI_AxisLeftX') < -0.1 
								&& theInput.GetActionValue('GI_AxisLeftY') == 0
								&& FlipTargetCheckPre('left')
								) 
								{
									FlipTargetCheck('left');
								}
								else if (theInput.GetActionValue('GI_AxisLeftY') > 0.1 
								&& theInput.GetActionValue('GI_AxisLeftX') > 0.1 
								&& FlipTargetCheckPre('front')
								)
								{
									FlipTargetCheck('front');
								}
								else if (theInput.GetActionValue('GI_AxisLeftY') > 0.1 
								&& theInput.GetActionValue('GI_AxisLeftX') < -0.1 
								&& FlipTargetCheckPre('front')
								)
								{
									FlipTargetCheck('front');
								}
								else if (theInput.GetActionValue('GI_AxisLeftY') < -0.1 
								&& theInput.GetActionValue('GI_AxisLeftX') > 0.1 
								&& FlipTargetCheckPre('back')
								)
								{
									FlipTargetCheck('back');
								}
								else if (theInput.GetActionValue('GI_AxisLeftX') < -0.1 
								&& theInput.GetActionValue('GI_AxisLeftY') < -0.1 
								&& FlipTargetCheckPre('back')
								)
								{
									FlipTargetCheck('back');
								}
							}
							else
							{
								if (Attack_Directional_Press_Check())
								{
									if (ACS_Settings_Main_Bool('acs_dodge_settings','acs_bruxa_leap_attack', false) && thePlayer.IsInCombat())
									{
										JumpAttackCombat();
									}
									else if ( ACS_Settings_Main_Bool('acs_bruxa_dash_settings','acs_bruxa_dash', false) )
									{
										BruxaDash_Combat();
									}
									else
									{
										ACS_BruxaDodgeSlideBackInit();

										if ((thePlayer.HasTag('ACS_Is_Sneaking')
										&& ACS_IS_SNEAKING)
										|| PreventSneaking()
										)
										{

										}
										else
										{
											

											RemoveTimer('SneakingInitiate');RemoveTimer('SneakingCombatInitiate');
											AddTimer('SneakingCombatInitiate', 0.25f , false);
										}
									}
								}
								else
								{
									
									if ( ACS_Settings_Main_Bool('acs_bruxa_dash_settings','acs_bruxa_dash', false) )
									{
										BruxaDash_Combat();
									}
									else
									{
										ACS_BruxaDodgeSlideBackInit();

										if ((thePlayer.HasTag('ACS_Is_Sneaking')
										&& ACS_IS_SNEAKING)
										|| PreventSneaking()
										)
										{

										}
										else
										{
											

											RemoveTimer('SneakingInitiate');RemoveTimer('SneakingCombatInitiate');
											AddTimer('SneakingCombatInitiate', 0.25f , false);
										}
									}
								}
							}
						}
						else
						{
							if (ACS_CombatSlide_Enabled()
							&& !getIsInCombatSlide
							)
							{
								if (thePlayer.GetIsSprinting()
								&& (thePlayer.IsActionAllowed( EIAB_RunAndSprint ) || thePlayer.IsActionAllowed( EIAB_Sprint ))
								&& thePlayer.GetSprintingTime() > 0.25
								&& thePlayer.substateManager.GetStateTimeF() > 0.25
								&& thePlayer.GetMovingAgentComponent().GetSpeed() >= 3 
								&& !thePlayer.IsCurrentlyDodging()
								&& !thePlayer.HasTag('ACS_Is_Currently_Dodging')
								&& !thePlayer.HasTag('ACS_Player_Is_Attacking')
								&& !thePlayer.IsInHitAnim()
								&& !thePlayer.HasTag('ACS_IsPerformingFinisher')
								&& !thePlayer.HasTag('ACS_IsPerformingCombatDismember')
								&& !thePlayer.IsCrossbowHeld()
								&& ACS_BuffCheck()
								&& thePlayer.IsActionAllowed(EIAB_Movement)
								&& thePlayer.GetStat( BCS_Stamina ) > 0
								&& !thePlayer.IsSwimming()
								&& !thePlayer.IsDiving()
								)
								{
									vACS_CombatSlide = new cACS_CombatSlide in this;

									vACS_CombatSlide.Combat_Slide_Engage();
								}
								else
								{
									thePlayer.AddTag('ACS_Player_Flip_Window');

									RemoveTimer('Flip_Ticket_Removal');
									AddTimer('Flip_Ticket_Removal', 0.33   , false);
									
									ACS_BruxaDodgeSlideBackInit();

									if ((thePlayer.HasTag('ACS_Is_Sneaking')
									&& ACS_IS_SNEAKING)
									|| PreventSneaking()
									)
									{

									}
									else
									{
										
										
										RemoveTimer('SneakingInitiate');RemoveTimer('SneakingCombatInitiate');
										AddTimer('SneakingCombatInitiate', 0.25f , false);
									}
								}
							}
							else
							{
								thePlayer.AddTag('ACS_Player_Flip_Window');

								RemoveTimer('Flip_Ticket_Removal');
								AddTimer('Flip_Ticket_Removal', 0.33   , false);
								
								ACS_BruxaDodgeSlideBackInit();

								if ((thePlayer.HasTag('ACS_Is_Sneaking')
								&& ACS_IS_SNEAKING)
								|| PreventSneaking()
								)
								{

								}
								else
								{
									
									
									RemoveTimer('SneakingInitiate');RemoveTimer('SneakingCombatInitiate');
									AddTimer('SneakingCombatInitiate', 0.25f , false);
								}
							}
						}
						
						BruxaDashCallTime = theGame.GetEngineTimeAsSeconds();
					

						return true;
					}
					else
					{
						thePlayer.EvadePressed(EBAT_Dodge);
					}
				}
			}

			
			if (IsReleased( action ))
			{
				RemoveTimer('Air_Time_Trigger_Delay');

				RemoveTimer('SneakingInitiate');RemoveTimer('SneakingCombatInitiate');
			}
		}
	}

	var vACS_RollInit : cACS_RollInit;

	function ACS_RollInit()
	{
		vACS_RollInit = new cACS_RollInit in this;
		
		if ( ACS_Settings_Main_Bool('acs_main_settings','acs_mod_enabled', true)
		&& !GetWitcherPlayer().IsPerformingFinisher()
		&& !GetWitcherPlayer().HasTag('acs_in_wraith')
		&& !GetWitcherPlayer().HasTag('ACS_Bruxa_Bite_Process')
		&& ACS_BuffCheck()
		&& GetWitcherPlayer().IsActionAllowed(EIAB_Roll)
		)
		{
			vACS_RollInit.ACS_RollInit_Engage();
		}
	}

	timer function RollDelay( time : float , id : int )
	{
		ACS_Tutorial_Display_Check('ACS_Hold_To_Roll_Tutorial_Shown');
		ACS_RollInit();
	}

	var getIsInCombatSlide : bool;

	function SetCombatSlideStatus( b : bool)
	{
		getIsInCombatSlide = b;
	}

	var vACS_CombatSlide : cACS_CombatSlide;

	event OnCbtRoll( action : SInputAction )
	{
		var targetDistance : float;

		if (FactsQuerySum("acs_transformation_activated") > 0)
		{
			ACS_ExplorationDelayHack(false, 3);

			if( thePlayer.IsActionAllowed(EIAB_Roll)  )
			{
				if (thePlayer.GetBIsInputAllowed())
				{
					if (FactsQuerySum("acs_wolven_curse_activated") > 0)
					{
						if ( IsPressed(action) )
						{
							ACS_Transformation_Werewolf_Dodge();
						}
					}

					if (FactsQuerySum("acs_vampireess_transformation_activated") > 0)
					{
						if ( IsPressed(action) )
						{
							if (!ACSGetCActor('ACS_Transformation_Vampiress').HasTag('ACS_Vampiress_Sorceress_Mode'))
							{
								if (thePlayer.IsInInterior())
								{
									ACS_Transformation_Vampiress_Dodge_Melee();
								}
								else
								{
									ACS_Transformation_Vampiress_Roll_Melee();
								}
							}
							else
							{
								if (thePlayer.IsInInterior())
								{
									ACS_Transformation_Vampiress_Dodge_Ranged();
								}
								else
								{
									ACS_Transformation_Vampiress_Roll_Ranged();
								}
								
							}
						}
					}

					if (FactsQuerySum("acs_vampire_monster_transformation_activated") > 0)
					{
						if ( IsPressed(action) )
						{
							if (ACSGetCActor('ACS_Transformation_Vampire_Monster').HasTag('ACS_Vampire_Monster_Ground_Mode'))
							{
								ACS_Transformation_Vampire_Monster_Teleport_Dodge();
							}
						}
					}

					if (FactsQuerySum("acs_red_miasmal_curse_activated") > 0)
					{
						if ( IsPressed(action) )
						{
							if (!thePlayer.IsInInterior())
							{
								ACS_Transformation_Red_Miasmal_Dodge();
							}
						}
					}

					if (FactsQuerySum("acs_sharley_curse_activated") > 0)
					{
						if ( IsPressed(action) )
						{
							ACS_Transformation_Sharley_Dodge();
						}
					}

					if (FactsQuerySum("acs_black_wolf_curse_activated") > 0)
					{
						if ( IsPressed(action) )
						{
							ACS_Transformation_Black_Wolf_Dodge();
						}
					}

					if (FactsQuerySum("acs_giant_curse_activated") > 0&& !ACSGetCActor('ACS_Transformation_Giant').HasTag('ACS_Transformation_Giant_Block_All_Actions'))
					{
						if ( IsPressed(action) )
						{
							ACS_Transformation_Giant_Dodge();
						}
					}
				}
			}

			return false;
		}

		if(theGame.GetInGameConfigWrapper().GetVarValue('Gameplay', 'EnableAlternateSignCasting') == "1")
		{
			altSignCasting = true;
		}	
		else
		{
			altSignCasting = false;
		}

		if(altSignCasting
		&& !theInput.LastUsedPCInput() && !thePlayer.IsCastingSign() && theInput.GetActionValue('CastSign') > 0.1f && !GetWitcherPlayer().IsCurrentSignChanneled())
		{
			return false;
		}

		if( !thePlayer.IsActionAllowed(EIAB_Roll)) 
		{
			return false;
		}

		if(thePlayer.HasTag('ACS_Manual_Combat_Control')){thePlayer.RemoveTag('ACS_Manual_Combat_Control');} RemoveTimer('Manual_Combat_Control_Remove');

		if (thePlayer.HasTag('ACS_IsSwordWalking'))
		{
			thePlayer.RemoveTag('ACS_IsSwordWalking');
		}

		if (ACSGetCEntity('ACS_Aim_Impact_Entity'))
		{
			ACSGetCEntity('ACS_Aim_Impact_Entity').Destroy();
		}

		SwordWalkAdditiveEnd(action);
		
		if ( theInput.LastUsedPCInput() )
		{
			if ( IsPressed( action ) )
			{
				Rage_Counter_Manager(3);

				ACSGetCEntity('ACS_Quen_Bubble').Destroy();
		
				ACSGetCEntity('ACS_Quen_Fx').Destroy();

				ACSGetCEntity('ACS_Sign_Icon').Destroy();

				ACSGetCEntity('ACS_Sign_Icon_Anchor').Destroy();

				if
				(theInput.IsActionPressed('Sprint') )
				{
					if( Flying_Target_Check()
					&& !thePlayer.HasTag('ACS_Air_Time')
					&& ACS_Settings_Main_Bool('acs_combat_main_settings','acs_air_time', true)
					&& !getIsInCombatSlide
					)
					{

						RemoveTimer('Air_Time_Trigger_Delay');
						AddTimer('Air_Time_Trigger_Delay', 0.5 , false);
					}
					else
					{
						RemoveTimer('Air_Time_Trigger_Delay');

						if (thePlayer.HasTag('ACS_Air_Time'))
						{
							RemoveTimer('Air_Time_Movement_Adjust_Delay');

							thePlayer.BlockAllActions( 'ACS_Air_Time_Init', false );

							thePlayer.EnableCollisions(true);

							thePlayer.RaiseEvent('ACS_FeetAdditiveEnd');

							thePlayer.UnblockAction( EIAB_CallHorse,			'ACS_Air_Time');
							thePlayer.UnblockAction( EIAB_DrawWeapon, 		'ACS_Air_Time');
							thePlayer.UnblockAction( EIAB_FastTravel, 		'ACS_Air_Time');
							thePlayer.UnblockAction( EIAB_InteractionAction, 	'ACS_Air_Time');
							thePlayer.UnblockAction( EIAB_UsableItem,			'ACS_Air_Time');
							thePlayer.UnblockAction( EIAB_MeditationWaiting,	'ACS_Air_Time');
							thePlayer.UnblockAction( EIAB_OpenMeditation,		'ACS_Air_Time');
							thePlayer.UnblockAction( EIAB_RadialMenu,			'ACS_Air_Time');
							thePlayer.UnblockAction( EIAB_Movement,			'ACS_Air_Time');
							thePlayer.UnblockAction( EIAB_QuickSlots, 		'ACS_Air_Time');

							thePlayer.RemoveTag('ACS_Air_Time');
						}
					}
				}

				if ( ACS_Settings_Main_Bool('acs_main_settings','acs_mod_enabled', true) ) 
				{
					if (thePlayer.HasTag('ACS_Bruxa_Bite_Process'))
					{
						bruxa_blood_suck_end_actual();
					}

					if( TeleportCallTime + DOUBLE_TAP_WINDOW_DODGE >= theGame.GetEngineTimeAsSeconds() )
					{
						TeleportDoubleTap = true;
					}
					else
					{
						TeleportDoubleTap = false;	
					}

					if (TeleportDoubleTap)
					{
						if (theInput.GetActionValue('LockAndGuard') > 0.1 
						&& (FlipTargetCheckPre('front') || FlipTargetCheckPre('back') || FlipTargetCheckPre('right') || FlipTargetCheckPre('left'))
						)
						{
							if (theInput.GetActionValue('GI_AxisLeftY') > 0.1 
							&& theInput.GetActionValue('GI_AxisLeftX') == 0
							&& FlipTargetCheckPre('front')
							)
							{
								FlipTargetCheck('front');
							}
							else if (theInput.GetActionValue('GI_AxisLeftY') < -0.1 
							&& theInput.GetActionValue('GI_AxisLeftX') == 0  
							&& FlipTargetCheckPre('back')
							)
							{
								FlipTargetCheck('back');
							}
							else if (theInput.GetActionValue('GI_AxisLeftX') > 0.1 
							&& theInput.GetActionValue('GI_AxisLeftY') == 0 
							&& FlipTargetCheckPre('right')
							)
							{
								FlipTargetCheck('right');
							}
							else if (theInput.GetActionValue('GI_AxisLeftX') < -0.1 
							&& theInput.GetActionValue('GI_AxisLeftY') == 0
							&& FlipTargetCheckPre('left')
							) 
							{
								FlipTargetCheck('left');
							}
							else if (theInput.GetActionValue('GI_AxisLeftY') > 0.1 
							&& theInput.GetActionValue('GI_AxisLeftX') > 0.1 
							&& FlipTargetCheckPre('front')
							)
							{
								FlipTargetCheck('front');
							}
							else if (theInput.GetActionValue('GI_AxisLeftY') > 0.1 
							&& theInput.GetActionValue('GI_AxisLeftX') < -0.1 
							&& FlipTargetCheckPre('front')
							)
							{
								FlipTargetCheck('front');
							}
							else if (theInput.GetActionValue('GI_AxisLeftY') < -0.1 
							&& theInput.GetActionValue('GI_AxisLeftX') > 0.1 
							&& FlipTargetCheckPre('back')
							)
							{
								FlipTargetCheck('back');
							}
							else if (theInput.GetActionValue('GI_AxisLeftX') < -0.1 
							&& theInput.GetActionValue('GI_AxisLeftY') < -0.1 
							&& FlipTargetCheckPre('back')
							)
							{
								FlipTargetCheck('back');
							}
						}
						else
						{
							if (thePlayer.HasTag('ACS_Bruxa_Bite_Process'))
							{
								bruxa_blood_suck_end_actual();
							}

							if ( ACS_Settings_Main_Bool('acs_dodge_settings','acs_wild_hunt_blink', false) 
							|| thePlayer.GetInventory().ItemHasTag( thePlayer.GetInventory().GetCurrentlyHeldSword(), 'acsmagestaff' ) 
							|| ACS_Armor_Set_Check('acs_armor', false)
							|| ACS_Armor_Set_Check('wh_armor', false)
							|| ACS_Armor_Set_Check('eredin_armor', false)
							|| ACS_Armor_Set_Check('imlerith_armor', false)
							|| ACS_Armor_Set_Check('caranthir_armor', false)
							|| ACS_Armor_Set_Check('vgx_eredin_armor', false)
							|| thePlayer.HasTag('acs_vampire_claws_equipped')
							)
							{
								ACS_WildHuntBlinkInit();
							}
							else
							{
								if (ACS_CombatSlide_Enabled()
								&& !getIsInCombatSlide
								)
								{
									if (thePlayer.GetIsSprinting()
									&& (thePlayer.IsActionAllowed( EIAB_RunAndSprint ) || thePlayer.IsActionAllowed( EIAB_Sprint ))
									&& thePlayer.GetSprintingTime() > 0.25
									&& thePlayer.substateManager.GetStateTimeF() > 0.25
									&& thePlayer.GetMovingAgentComponent().GetSpeed() >= 3 
									&& !thePlayer.IsCurrentlyDodging()
									&& !thePlayer.HasTag('ACS_Is_Currently_Dodging')
									&& !thePlayer.HasTag('ACS_Player_Is_Attacking')
									&& !thePlayer.IsInHitAnim()
									&& !thePlayer.HasTag('ACS_IsPerformingFinisher')
									&& !thePlayer.HasTag('ACS_IsPerformingCombatDismember')
									&& !thePlayer.IsCrossbowHeld()
									&& ACS_BuffCheck()
									&& thePlayer.IsActionAllowed(EIAB_Movement)
									&& thePlayer.GetStat( BCS_Stamina ) > 0
									&& !thePlayer.IsSwimming()
									&& !thePlayer.IsDiving()
									)
									{
										vACS_CombatSlide = new cACS_CombatSlide in this;

										vACS_CombatSlide.Combat_Slide_Engage();
									}
									else
									{
										if (ACS_HoldToRoll_Enabled())
										{
											ACS_BruxaDodgeSlideBackInit();

											RemoveTimer('RollDelay');
											AddTimer('RollDelay', 0.75f , false);
										}
										else
										{
											ACS_RollInit();
										}
									}
								}
								else
								{
									if (ACS_HoldToRoll_Enabled())
									{
										ACS_BruxaDodgeSlideBackInit();

										RemoveTimer('RollDelay');
										AddTimer('RollDelay', 0.75f , false);
									}
									else
									{
										ACS_RollInit();
									}
								}
							}
						}
					}
					else
					{
						if (ACS_CombatSlide_Enabled()
						&& !getIsInCombatSlide
						)
						{
							if (thePlayer.GetIsSprinting()
							&& (thePlayer.IsActionAllowed( EIAB_RunAndSprint ) || thePlayer.IsActionAllowed( EIAB_Sprint ))
							&& thePlayer.GetSprintingTime() > 0.25
							&& thePlayer.substateManager.GetStateTimeF() > 0.25
							&& thePlayer.GetMovingAgentComponent().GetSpeed() >= 3 
							&& !thePlayer.IsCurrentlyDodging()
							&& !thePlayer.HasTag('ACS_Is_Currently_Dodging')
							&& !thePlayer.HasTag('ACS_Player_Is_Attacking')
							&& !thePlayer.IsInHitAnim()
							&& !thePlayer.HasTag('ACS_IsPerformingFinisher')
							&& !thePlayer.HasTag('ACS_IsPerformingCombatDismember')
							&& !thePlayer.IsCrossbowHeld()
							&& ACS_BuffCheck()
							&& thePlayer.IsActionAllowed(EIAB_Movement)
							&& thePlayer.GetStat( BCS_Stamina ) > 0
							&& !thePlayer.IsSwimming()
							&& !thePlayer.IsDiving()
							)
							{
								vACS_CombatSlide = new cACS_CombatSlide in this;

								vACS_CombatSlide.Combat_Slide_Engage();
							}
							else
							{
								if (ACS_HoldToRoll_Enabled())
								{
									ACS_BruxaDodgeSlideBackInit();

									RemoveTimer('RollDelay');
									AddTimer('RollDelay', 0.75f , false);
								}
								else
								{
									ACS_RollInit();
								}
							}
						}
						else
						{
							if (ACS_HoldToRoll_Enabled())
							{
								ACS_BruxaDodgeSlideBackInit();

								RemoveTimer('RollDelay');
								AddTimer('RollDelay', 0.75f , false);
							}
							else
							{
								ACS_RollInit();
							}
						}
					}
				
					TeleportCallTime = theGame.GetEngineTimeAsSeconds();

					return true;
				}
				else
				{
					thePlayer.EvadePressed(EBAT_Roll);
				}
			}

			if (IsReleased( action ))
			{
				RemoveTimer('Air_Time_Trigger_Delay');

				RemoveTimer('RollDelay');
			}
		}
		else if ( !theInput.LastUsedPCInput() )
		{
			if(altSignCasting && (thePlayer.IsCastingSign() || theInput.GetActionValue('CastSign') > 0.1f))
			{
				return false;
			}

			if (ACS_Cast_Sign_Process)
			{
				return false;
			}

			if ( IsPressed( action ) )
			{
				if(altSignCasting && theInput.IsActionPressed('CastSign'))
				{
					return false;					
				}
				else
				{
					Rage_Counter_Manager(3);

					ACSGetCEntity('ACS_Quen_Bubble').Destroy();
		
					ACSGetCEntity('ACS_Quen_Fx').Destroy();

					ACSGetCEntity('ACS_Sign_Icon').Destroy();

					ACSGetCEntity('ACS_Sign_Icon_Anchor').Destroy();

					if
					(theInput.IsActionPressed('Sprint') )
					{
						if( Flying_Target_Check()
						&& !thePlayer.HasTag('ACS_Air_Time')
						&& ACS_Settings_Main_Bool('acs_combat_main_settings','acs_air_time', true)
						&& !getIsInCombatSlide
						)
						{

							RemoveTimer('Air_Time_Trigger_Delay');
							AddTimer('Air_Time_Trigger_Delay', 0.5 , false);
						}
						else
						{
							RemoveTimer('Air_Time_Trigger_Delay');

							if (thePlayer.HasTag('ACS_Air_Time'))
							{
								RemoveTimer('Air_Time_Movement_Adjust_Delay');

								thePlayer.BlockAllActions( 'ACS_Air_Time_Init', false );

								thePlayer.EnableCollisions(true);

								thePlayer.RaiseEvent('ACS_FeetAdditiveEnd');

								thePlayer.UnblockAction( EIAB_CallHorse,			'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_DrawWeapon, 		'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_FastTravel, 		'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_InteractionAction, 	'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_UsableItem,			'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_MeditationWaiting,	'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_OpenMeditation,		'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_RadialMenu,			'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_Movement,			'ACS_Air_Time');
								thePlayer.UnblockAction( EIAB_QuickSlots, 		'ACS_Air_Time');

								thePlayer.RemoveTag('ACS_Air_Time');
							}
						}
					}

					if ( ACS_Settings_Main_Bool('acs_main_settings','acs_mod_enabled', true) ) 
					{
						if (thePlayer.HasTag('ACS_Bruxa_Bite_Process'))
						{
							bruxa_blood_suck_end_actual();
						}

						if( TeleportCallTime + DOUBLE_TAP_WINDOW_DODGE >= theGame.GetEngineTimeAsSeconds() )
						{
							TeleportDoubleTap = true;
						}
						else
						{
							TeleportDoubleTap = false;	
						}

						if (TeleportDoubleTap)
						{
							if (theInput.GetActionValue('LockAndGuard') > 0.1 
							&& (FlipTargetCheckPre('front') || FlipTargetCheckPre('back') || FlipTargetCheckPre('right') || FlipTargetCheckPre('left'))
							)
							{
								if (theInput.GetActionValue('GI_AxisLeftY') > 0.1 
								&& theInput.GetActionValue('GI_AxisLeftX') == 0
								&& FlipTargetCheckPre('front')
								)
								{
									FlipTargetCheck('front');
								}
								else if (theInput.GetActionValue('GI_AxisLeftY') < -0.1 
								&& theInput.GetActionValue('GI_AxisLeftX') == 0  
								&& FlipTargetCheckPre('back')
								)
								{
									FlipTargetCheck('back');
								}
								else if (theInput.GetActionValue('GI_AxisLeftX') > 0.1 
								&& theInput.GetActionValue('GI_AxisLeftY') == 0 
								&& FlipTargetCheckPre('right')
								)
								{
									FlipTargetCheck('right');
								}
								else if (theInput.GetActionValue('GI_AxisLeftX') < -0.1 
								&& theInput.GetActionValue('GI_AxisLeftY') == 0
								&& FlipTargetCheckPre('left')
								) 
								{
									FlipTargetCheck('left');
								}
								else if (theInput.GetActionValue('GI_AxisLeftY') > 0.1 
								&& theInput.GetActionValue('GI_AxisLeftX') > 0.1 
								&& FlipTargetCheckPre('front')
								)
								{
									FlipTargetCheck('front');
								}
								else if (theInput.GetActionValue('GI_AxisLeftY') > 0.1 
								&& theInput.GetActionValue('GI_AxisLeftX') < -0.1 
								&& FlipTargetCheckPre('front')
								)
								{
									FlipTargetCheck('front');
								}
								else if (theInput.GetActionValue('GI_AxisLeftY') < -0.1 
								&& theInput.GetActionValue('GI_AxisLeftX') > 0.1 
								&& FlipTargetCheckPre('back')
								)
								{
									FlipTargetCheck('back');
								}
								else if (theInput.GetActionValue('GI_AxisLeftX') < -0.1 
								&& theInput.GetActionValue('GI_AxisLeftY') < -0.1 
								&& FlipTargetCheckPre('back')
								)
								{
									FlipTargetCheck('back');
								}
							}
							else
							{
								if ( ACS_Settings_Main_Bool('acs_dodge_settings','acs_wild_hunt_blink', false) 
								|| thePlayer.GetInventory().ItemHasTag( thePlayer.GetInventory().GetCurrentlyHeldSword(), 'acsmagestaff' ) 
								|| ACS_Armor_Set_Check('acs_armor', false)
								|| ACS_Armor_Set_Check('wh_armor', false)
								|| ACS_Armor_Set_Check('eredin_armor', false)
								|| ACS_Armor_Set_Check('imlerith_armor', false)
								|| ACS_Armor_Set_Check('caranthir_armor', false)
								|| ACS_Armor_Set_Check('vgx_eredin_armor', false)
								|| thePlayer.HasTag('acs_vampire_claws_equipped')
								)
								{
									ACS_WildHuntBlinkInit();
								}
								else
								{
									ACS_RollInit();
								}
							}
						}
						else
						{
							if (ACS_CombatSlide_Enabled()
							&& !getIsInCombatSlide
							)
							{
								if (thePlayer.GetIsSprinting()
								&& (thePlayer.IsActionAllowed( EIAB_RunAndSprint ) || thePlayer.IsActionAllowed( EIAB_Sprint ))
								&& thePlayer.GetSprintingTime() > 0.25
								&& thePlayer.substateManager.GetStateTimeF() > 0.25
								&& thePlayer.GetMovingAgentComponent().GetSpeed() >= 3 
								&& !thePlayer.IsCurrentlyDodging()
								&& !thePlayer.HasTag('ACS_Is_Currently_Dodging')
								&& !thePlayer.HasTag('ACS_Player_Is_Attacking')
								&& !thePlayer.IsInHitAnim()
								&& !thePlayer.HasTag('ACS_IsPerformingFinisher')
								&& !thePlayer.HasTag('ACS_IsPerformingCombatDismember')
								&& !thePlayer.IsCrossbowHeld()
								&& ACS_BuffCheck()
								&& thePlayer.IsActionAllowed(EIAB_Movement)
								&& thePlayer.GetStat( BCS_Stamina ) > 0
								&& !thePlayer.IsSwimming()
								&& !thePlayer.IsDiving()
								)
								{
									vACS_CombatSlide = new cACS_CombatSlide in this;

									vACS_CombatSlide.Combat_Slide_Engage();
								}
								else
								{
									ACS_RollInit();
								}
							}
							else
							{
								ACS_RollInit();
							}
						}

						TeleportCallTime = theGame.GetEngineTimeAsSeconds();

						return true;
					} 
					else
					{
						thePlayer.StartDodgeTimer();
					}
				}
			}

			if ( IsReleased( action ) )
			{
				RemoveTimer('Air_Time_Trigger_Delay');

				if ( thePlayer.IsDodgeTimerRunning() )
				{
					thePlayer.StopDodgeTimer();

					if ( !thePlayer.IsInsideInteraction() )
					{
						thePlayer.EvadePressed(EBAT_Roll);
					}	
				}
			}
		}
	}


	event OnThrowBomb(action : SInputAction)
	{
		var selectedItemId : SItemUniqueId;

		if (FactsQuerySum("acs_transformation_activated") > 0)
		{
			return false;
		}
	
		selectedItemId = thePlayer.GetSelectedItemId();
		if(!thePlayer.inv.IsItemBomb(selectedItemId))
			return false;
		
		if( thePlayer.inv.SingletonItemGetAmmo(selectedItemId) == 0 && !thePlayer.inv.ItemHasTag(selectedItemId, 'ThrowingKnife'))
		{
			
			if(IsPressed(action))
			{			
				thePlayer.SoundEvent( "gui_ingame_low_stamina_warning" );
			}
			
			return false;
		}
		
		if ( IsReleased(action) )
		{
			if ( thePlayer.IsThrowHold() )
			{
				if ( thePlayer.playerAiming.GetAimedTarget() )
				{
					if ( thePlayer.AllowAttack( thePlayer.playerAiming.GetAimedTarget(), EBAT_ItemUse ) )
					{
						thePlayer.PushCombatActionOnBuffer( EBAT_ItemUse, BS_Released );
						thePlayer.ProcessCombatActionBuffer();
					}
					else
						thePlayer.BombThrowAbort();
				}
				else
				{
					thePlayer.PushCombatActionOnBuffer( EBAT_ItemUse, BS_Released );
					thePlayer.ProcessCombatActionBuffer();				
				}
				
				thePlayer.SetThrowHold( false );
	
				return true;
		
			}
			else
			{
				if(!thePlayer.IsActionAllowed(EIAB_ThrowBomb))
				{
					thePlayer.DisplayActionDisallowedHudMessage(EIAB_ThrowBomb);
					return false;
				}

				if ( thePlayer.IsHoldingItemInLHand() && !thePlayer.IsUsableItemLBlocked() )
				{
					thePlayer.SetPlayerActionToRestore ( PATR_ThrowBomb );
					thePlayer.OnUseSelectedItem( true );
					return true;
				}
				if(thePlayer.CanSetupCombatAction_Throw() && theInput.GetLastActivationTime( action.aName ) < 0.3f )	
				{
					
					thePlayer.SetupCombatAction( EBAT_ItemUse, BS_Pressed );
					return true;
				}		
			
				thePlayer.SetupCombatAction( EBAT_ItemUse, BS_Released );
				return true;
			}
		}
		
		return false;
	}
	
	event OnThrowBombHold(action : SInputAction)
	{
		var locks : array<SInputActionLock>;
		var ind : int;

		var selectedItemId : SItemUniqueId;

		if (FactsQuerySum("acs_transformation_activated") > 0)
		{
			return false;
		}
	
		selectedItemId = thePlayer.GetSelectedItemId();
		if(!thePlayer.inv.IsItemBomb(selectedItemId))
			return false;
		
		if( thePlayer.inv.SingletonItemGetAmmo(selectedItemId) == 0 && !thePlayer.inv.ItemHasTag(selectedItemId, 'ThrowingKnife'))
		{
			
			if(IsPressed(action))
			{			
				thePlayer.SoundEvent( "gui_ingame_low_stamina_warning" );
			}
			
			return false;
		}
			
		if( IsPressed(action) )
		{
			if(!thePlayer.IsActionAllowed(EIAB_ThrowBomb))
			{
				thePlayer.DisplayActionDisallowedHudMessage(EIAB_ThrowBomb);
				return false;
			}
			else if(GetWitcherPlayer().GetBombDelay(GetWitcherPlayer().GetItemSlot(selectedItemId)) > 0 )
			{
				
				return false;
			}
			if ( thePlayer.IsHoldingItemInLHand() && !thePlayer.IsUsableItemLBlocked() )
			{
				thePlayer.SetPlayerActionToRestore ( PATR_ThrowBomb );
				thePlayer.OnUseSelectedItem( true );
				return true;
			}
			if(thePlayer.CanSetupCombatAction_Throw() && theInput.GetLastActivationTime( action.aName ) < 0.3f )	
			{
				if( thePlayer.GetBIsCombatActionAllowed() )
				{
					thePlayer.PushCombatActionOnBuffer( EBAT_ItemUse, BS_Pressed );
					thePlayer.ProcessCombatActionBuffer();
				}
			}		
		
			
			
			locks = thePlayer.GetActionLocks(EIAB_ThrowBomb);
			ind = thePlayer.GetInputHandler().FindActionLockIndex(EIAB_ThrowBomb, 'BombThrow');
			if(ind >= 0)
				locks.Erase(ind);
			
			if(locks.Size() != 0)
				return false;
			
			thePlayer.SetThrowHold( true );
			return true;
		}

		return false;
	}
	
	event OnThrowBombAbort(action : SInputAction)
	{		
		if( IsPressed(action) )
		{	
			if (FactsQuerySum("acs_transformation_activated") > 0)
			{
				return false;
			}

			thePlayer.BombThrowAbort();
		}
	}
	
	private var vACS_Shield_Summon 																											: cACS_Shield_Summon;

	timer function ACS_Player_Tentacle_Damage_Delay( time : float , id : int )
	{
		var actortarget						: CActor;
		var victims			 				: array<CActor>;
		var dmg								: W3DamageAction;
		var i								: int;
		var params 							: SCustomEffectParams;

		victims.Clear();

		victims = thePlayer.GetNPCsAndPlayersInCone(3, VecHeading(thePlayer.GetHeadingVector()), 35, 20, , FLAG_OnlyAliveActors + FLAG_Attitude_Hostile + FLAG_ExcludePlayer );

		if( victims.Size() > 0)
		{
			for( i = 0; i < victims.Size(); i += 1 )
			{
				actortarget = (CActor)victims[i];

				if (actortarget != thePlayer
				&& actortarget != ACSGetCActor('ACS_Necrofiend_Tentacle_1')
				&& actortarget != ACSGetCActor('ACS_Necrofiend_Tentacle_2')
				&& actortarget != ACSGetCActor('ACS_Necrofiend_Tentacle_3')
				&& actortarget != ACSGetCActor('ACS_Necrofiend_Tentacle_4')
				&& actortarget != ACSGetCActor('ACS_Necrofiend_Tentacle_5')
				&& actortarget != ACSGetCActor('ACS_Necrofiend_Tentacle_6')
				&& actortarget != ACSGetCEntity('acs_necrofiend_tentacle_anchor')
				)
				{
					movementAdjustor = actortarget.GetMovingAgentComponent().GetMovementAdjustor();

					ticket = movementAdjustor.GetRequest( 'ACS_Player_Tentacle_Hit_Rotate');
					movementAdjustor.CancelByName( 'ACS_Player_Tentacle_Hit_Rotate' );
					movementAdjustor.CancelAll();

					ticket = movementAdjustor.CreateNewRequest( 'ACS_Player_Tentacle_Hit_Rotate' );
					movementAdjustor.AdjustmentDuration( ticket, 0.1 );
					movementAdjustor.MaxRotationAdjustmentSpeed( ticket, 50000 );

					movementAdjustor.RotateTowards( ticket, thePlayer );

					actortarget.SoundEvent("cmb_play_hit_heavy");

					params.effectType = EET_Knockdown;
					params.creator = thePlayer;
					params.sourceName = "ACS_Tentacle_Knockdown";
					params.duration = 1;

					actortarget.AddEffectCustom( params );	

					params.effectType = EET_Poison;
					params.creator = thePlayer;
					params.sourceName = "ACS_Tentacle_Poison";
					params.duration = 1;

					actortarget.AddEffectCustom( params );	
				}
			}
		}
	}

	function IceBlastEvade()
	{
		var teleport_fx				: CEntity;

		if (thePlayer.HasTag('ACS_Ice_Giant_Mode'))
		{
			if (ACSGetCEntity('ACS_Frost_Sword_Ent'))
			{
				ACSGetCEntity('ACS_Frost_Sword_Ent').Destroy();
			}

			GetWitcherPlayer().DestroyEffect('suck_out');
			GetWitcherPlayer().PlayEffectSingle('suck_out');
			GetWitcherPlayer().StopEffect('suck_out');

			ACS_Ice_Blast();

			teleport_fx = theGame.CreateEntity( (CEntityTemplate)LoadResource( "fx\characters\eredin\eredin_teleport.w2ent", true ), GetWitcherPlayer().GetWorldPosition(), EulerAngles(0,0,0) );
			teleport_fx.CreateAttachment(GetWitcherPlayer());
			teleport_fx.PlayEffectSingle('disappear');
			teleport_fx.DestroyAfter(5);

			thePlayer.RemoveTag('ACS_Ice_Giant_Mode');
			RemoveTimer('ACS_Ice_Giant_Armor_Timer');

			thePlayer.DestroyEffect('ice_armor_no_smoke');

			GetWitcherPlayer().SoundEvent("magic_canaris_teleport_short");

			if (ACSGetCEntity('ACS_Imlerith_Skirt'))
			{
				ACSGetCEntity('ACS_Imlerith_Skirt').DestroyEffect('ice_armor_no_smoke');
			}

			if (ACSGetCEntity('ACS_Eredin_Cloak'))
			{
				ACSGetCEntity('ACS_Eredin_Cloak').DestroyEffect('ice_armor_no_smoke');
			}

			if (ACSGetCEntity('ACS_Eredin_Skirt'))
			{
				ACSGetCEntity('ACS_Eredin_Skirt').DestroyEffect('ice_armor_no_smoke');
			}
		}
		else
		{
			if ( thePlayer.GetTarget() )
			{
				thePlayer.GotoState('ACS_Ice_Blast_Evade');
			}
			else
			{
				GetWitcherPlayer().DestroyEffect('suck_out');
				GetWitcherPlayer().PlayEffectSingle('suck_out');
				GetWitcherPlayer().StopEffect('suck_out');

				ACS_Ice_Blast();

				teleport_fx = theGame.CreateEntity( (CEntityTemplate)LoadResource( "fx\characters\eredin\eredin_teleport.w2ent", true ), GetWitcherPlayer().GetWorldPosition(), EulerAngles(0,0,0) );
				teleport_fx.CreateAttachment(GetWitcherPlayer());
				teleport_fx.PlayEffectSingle('disappear');
				teleport_fx.DestroyAfter(5);

				RemoveTimer('ACS_Ice_Giant_Armor_Timer');
				AddTimer('ACS_Ice_Giant_Armor_Timer', 0.004 , true);

				ACS_Quen();

				thePlayer.AddTag('ACS_Ice_Giant_Mode');
			}
		}
	}

	function RedLightningManager()
	{
		if (thePlayer.HasTag('ACS_Red_Lightning_Enabled'))
		{
			PlayerPlayAnimation( 'man_geralt_yrden_ground');	

			RemoveTimer('ACS_Red_Lightning_Timer');

			thePlayer.RemoveTag('ACS_Red_Lightning_Enabled');
		}
		else
		{
			RemoveTimer('ACS_Red_Lightning_Timer');
			AddTimer('ACS_Red_Lightning_Timer', 0.001 , true);

			PlayerPlayAnimation( 'man_geralt_yrden_ground');	

			thePlayer.AddTag('ACS_Red_Lightning_Enabled');
		}
	}

	timer function ItemUseProgressComplete( time : float , id : int )
	{
		itemuseanimprogress = false;
	}

	function ACS_SaveAppearance(fitslot:int)
	{
		var inv : CInventoryComponent;
		var id	: SItemUniqueId;
		var i : int;
		var slotnames : array<EEquipmentSlots>;
		var hair : array<SItemUniqueId>;
		var beardstage : int;
		var acs : array< CComponent >;
		var head : name;
		var headnames : array<CName>;
		var selectedslotid : int;
		var notificationBuildSlot : string;

		CheckItems('armor', fitslot, true);
		CheckItems('boots', fitslot, true);
		CheckItems('pants', fitslot, true);
		CheckItems('gloves', fitslot, true);
		CheckItems('mask', fitslot, true);
		CheckItems('silversword', fitslot, true); 
		CheckItems('steelsword', fitslot, true);
		CheckItems('crossbow', fitslot, true);
		CheckItems('usable', fitslot, true);
		CheckItems('petard', fitslot, true);
		CheckItems('potion', fitslot, true);
		CheckItems('edibles', fitslot, true);
		CheckEmpty(fitslot, true);
		CheckHair(fitslot, true);
		CheckBeard(fitslot, true);
		CheckItems('hood', fitslot, true);
		CheckItems('cloak', fitslot, true);
		CheckItems('cape', fitslot, true);
		CheckItems('ring', fitslot, true);
		CheckItems('helmet', fitslot, true);
		CheckItems('Decorations', fitslot, true);
		CheckItems('decorations', fitslot, true);
		CheckItems('ArdHood', fitslot, true);
		CheckItems('ArdCape', fitslot, true);
		CheckItems('ArdHat', fitslot, true);
		
		if (ACS_Settings_Main_Bool('acs_cbs_settings','acs_cbs_apparel', true))
		{
			slotnames.PushBack(EES_Armor);
			slotnames.PushBack(EES_Boots);
			slotnames.PushBack(EES_Pants);
			slotnames.PushBack(EES_Gloves);
			slotnames.PushBack(EES_Mask);
		}

		if (ACS_Settings_Main_Bool('acs_cbs_settings','acs_cbs_wep', true)
		)
		{
			slotnames.PushBack(EES_SilverSword);
			slotnames.PushBack(EES_SteelSword);
			slotnames.PushBack(EES_RangedWeapon);
		}
		
		inv = thePlayer.GetInventory();
		hair = inv.GetItemsByCategory( 'hair' );
		
		for ( i=0 ; i < slotnames.Size() ; i+=1 )
		{
			if ( inv.GetItemEquippedOnSlot( slotnames[i], id ) ) 
			{
				FactsSet( 'ACS_CBS'+IntToString(fitslot)+inv.GetItemName(id), 1);
			}
			else 
			{
				FactsSet( 'ACS_CBS'+IntToString(fitslot)+slotnames[i]+'empty', 1);
			}
		}
		
		if (ACS_Settings_Main_Bool('acs_cbs_settings','acs_cbs_qs', true)
		) //save pockets
		{
			if ( inv.GetItemEquippedOnSlot( EES_Quickslot1, id ) ) FactsSet( 'ACS_CBS'+IntToString(fitslot)+inv.GetItemName(id), 1);
			else FactsSet( 'ACS_CBS'+IntToString(fitslot)+EES_Quickslot1+'empty', 1);
			if ( inv.GetItemEquippedOnSlot( EES_Quickslot2, id ) ) FactsSet( 'ACS_CBS'+IntToString(fitslot)+inv.GetItemName(id), 2);
			else FactsSet( 'ACS_CBS'+IntToString(fitslot)+EES_Quickslot2+'empty', 2);
		}
		
		if (ACS_Settings_Main_Bool('acs_cbs_settings','acs_cbs_bomb', true)
		) //save bombs
		{
			if ( inv.GetItemEquippedOnSlot( EES_Petard1, id ) ) FactsSet( 'ACS_CBS'+IntToString(fitslot)+inv.GetItemName(id), 1);
			else FactsSet( 'ACS_CBS'+IntToString(fitslot)+EES_Petard1+'empty', 1);
			if ( inv.GetItemEquippedOnSlot( EES_Petard2, id ) ) FactsSet( 'ACS_CBS'+IntToString(fitslot)+inv.GetItemName(id), 2);
			else FactsSet( 'ACS_CBS'+IntToString(fitslot)+EES_Petard2+'empty', 2);
		}
		
		if ( ACS_Settings_Main_Bool('acs_cbs_settings','acs_cbs_qs', true) || ACS_Settings_Main_Bool('acs_cbs_settings','acs_cbs_bomb', true) ) //save selected item slot
		{
			switch ( GetWitcherPlayer().GetItemSlot(GetWitcherPlayer().GetSelectedItemId()) )
			{
				case EES_Quickslot1: selectedslotid=1; break;
				case EES_Quickslot2: selectedslotid=2; break;
				case EES_Petard1: selectedslotid=3; break;
				case EES_Petard2: selectedslotid=4; break;
			}
			FactsSet( 'ACS_CBS'+IntToString(fitslot)+'selectedslot', selectedslotid ); 
		}
		
		if ( ACS_Settings_Main_Bool('acs_cbs_settings','acs_cbs_pot', true) ) //save potions
		{
			if ( inv.GetItemEquippedOnSlot( EES_Potion1, id ) ) FactsSet( 'ACS_CBS'+IntToString(fitslot)+inv.GetItemName(id), 1); //save potions with slot numbers
			else FactsSet( 'ACS_CBS'+IntToString(fitslot)+EES_Potion1+'empty', 1);
			if ( inv.GetItemEquippedOnSlot( EES_Potion2, id ) ) FactsSet( 'ACS_CBS'+IntToString(fitslot)+inv.GetItemName(id), 2);
			else FactsSet( 'ACS_CBS'+IntToString(fitslot)+EES_Potion2+'empty', 1);
			if ( inv.GetItemEquippedOnSlot( EES_Potion3, id ) ) FactsSet( 'ACS_CBS'+IntToString(fitslot)+inv.GetItemName(id), 3);
			else FactsSet( 'ACS_CBS'+IntToString(fitslot)+EES_Potion3+'empty', 1);
			if ( inv.GetItemEquippedOnSlot( EES_Potion4, id ) ) FactsSet( 'ACS_CBS'+IntToString(fitslot)+inv.GetItemName(id), 4);
			else FactsSet( 'ACS_CBS'+IntToString(fitslot)+EES_Potion4+'empty', 1);
		}
		
		if (ACS_Settings_Main_Bool('acs_cbs_settings','acs_cbs_hair', false))  //save hair
		{
			for( i = 0; i < hair.Size(); i+=1 ) 
			{
				if(inv.IsItemMounted( hair[i] ) ) FactsSet( 'ACS_CBS'+IntToString(fitslot)+inv.GetItemName(hair[i]), 1);
			}
		}
		
		if ( ACS_Settings_Main_Bool('acs_cbs_settings','acs_cbs_beard', false) ) //save beard
		{
			headnames.PushBack('head_0');
			headnames.PushBack('head_0_tattoo');
			headnames.PushBack('head_0_mark');
			headnames.PushBack('head_0_mark_tattoo');
			headnames.PushBack('head_1');
			headnames.PushBack('head_1_tattoo');
			headnames.PushBack('head_1_mark');
			headnames.PushBack('head_1_mark_tattoo');
			headnames.PushBack('head_2');
			headnames.PushBack('head_2_tattoo');
			headnames.PushBack('head_2_mark');
			headnames.PushBack('head_2_mark_tattoo');
			headnames.PushBack('head_3');
			headnames.PushBack('head_3_tattoo');
			headnames.PushBack('head_3_mark');
			headnames.PushBack('head_3_mark_tattoo');
			headnames.PushBack('head_4');
			headnames.PushBack('head_4_tattoo');
			headnames.PushBack('head_4_mark');
			headnames.PushBack('head_4_mark_tattoo');
	
			acs = thePlayer.GetComponentsByClassName( 'CHeadManagerComponent' );
			head = ( ( CHeadManagerComponent ) acs[0] ).GetCurHeadName();
			
			for( i = 0; i < headnames.Size(); i+=1 ) 
			{
				if(head == headnames[i]) 
				{
					switch(i)
					{
						case 0: case 1: case 2: case 3: beardstage = 1; break;
						case 4: case 5: case 6: case 7: beardstage = 2; break;
						case 8: case 9: case 10: case 11: beardstage = 3; break;
						case 12: case 13: case 14: case 15: beardstage = 4; break;
						case 16: case 17: case 18: case 19: beardstage = 5; break; 
						default: beardstage = 1; break;
					}
					FactsSet( 'ACS_CBS'+IntToString(fitslot)+'beard', beardstage);
				}
			}
		}
		
		if ( ACS_Settings_Main_Bool('acs_cbs_settings','acs_cbs_notif', true) ) 
		{
			switch (fitslot)
			{
				case 4:
				notificationBuildSlot = GetLocStringByKeyExt("option_acs_armiger_aard_sign_weapon");
				break;

				case 3:
				notificationBuildSlot = GetLocStringByKeyExt("option_acs_armiger_axii_sign_weapon");
				break;

				case 2:
				notificationBuildSlot = GetLocStringByKeyExt("option_acs_armiger_igni_sign_weapon");
				break;

				case 1:
				notificationBuildSlot = GetLocStringByKeyExt("option_acs_armiger_quen_sign_weapon");
				break;

				case 0:
				notificationBuildSlot = GetLocStringByKeyExt("option_acs_armiger_yrden_sign_weapon");
				break;

				default:
				notificationBuildSlot = GetLocStringByKeyExt("option_acs_armiger_yrden_sign_weapon");
				break;
			}

			//theGame.GetGuiManager().ShowNotification(GetLocStringByKeyExt("acs_equipment_build") + " " + notificationBuildSlot + " " + GetLocStringByKeyExt("acs_equipment_build_saved"), 1000 );

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Equipment_Build_Switch_Notification");

			ACS_Oneliner(
			(new ACS_Oneliner_TagBuilder in theGame)
			.tag("font")
			.attr("size", "26")
			.attr("color", "#ffffff")
			.text(GetLocStringByKeyExt("acs_equipment_build") + "<br/>" + notificationBuildSlot + "<br/>" + GetLocStringByKeyExt("acs_equipment_build_saved"))
			, thePlayer, "ACS_Equipment_Build_Switch_Notification", Vector(0,0,0.5), 1.5);

			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Equipment_Build_Switch_Notification", 100);

			GetACSStorage().acs_setScaleForOnelinerByTag("ACS_Equipment_Build_Switch_Notification", 100, 100, 100);
		}
		
	}

	function ACS_LoadAppearance(fitslot:int)
	{
		var notificationBuildSlot : string;

		if (ACS_Settings_Main_Bool('acs_dodge_settings','acs_dodge_effects', false))
		{
			thePlayer.PlayEffectSingle('ethereal_appear');
			thePlayer.StopEffect('ethereal_appear');

			thePlayer.PlayEffectSingle('special_attack_only_black_fx');
			thePlayer.StopEffect('special_attack_only_black_fx');
		}

		CheckItems('armor', fitslot, false); 
		CheckItems('boots', fitslot, false);
		CheckItems('pants', fitslot, false);
		CheckItems('gloves', fitslot, false);
		CheckItems('mask', fitslot, false);
		CheckItems('silversword', fitslot, false);
		CheckItems('steelsword', fitslot, false);
		CheckItems('crossbow', fitslot, false);
		CheckItems('usable', fitslot, false);
		CheckItems('petard', fitslot, false);
		CheckItems('potion', fitslot, false);
		CheckItems('edibles', fitslot, false);
		CheckEmpty(fitslot, false);
		CheckHair(fitslot, false);
		CheckBeard(fitslot, false);
		CheckItems('hood', fitslot, false);
		CheckItems('cape', fitslot, false);
		CheckItems('cloak', fitslot, false);
		CheckItems('ring', fitslot, false);
		CheckItems('helmet', fitslot, false);
		CheckItems('Decorations', fitslot, false);
		CheckItems('decorations', fitslot, false);
		CheckItems('ArdHood', fitslot, false);
		CheckItems('ArdCape', fitslot, false);
		CheckItems('ArdHat', fitslot, false);
		
		switch ( FactsQuerySum( 'ACS_CBS'+IntToString(fitslot)+'selectedslot') )
		{
			case 4: GetWitcherPlayer().SelectQuickslotItem(EES_Petard2); break;
			case 3: GetWitcherPlayer().SelectQuickslotItem(EES_Petard1); break;
			case 2: GetWitcherPlayer().SelectQuickslotItem(EES_Quickslot2); break;
			default: GetWitcherPlayer().SelectQuickslotItem(EES_Quickslot1); break;
		}

		if ( ACS_Settings_Main_Bool('acs_cbs_settings','acs_cbs_notif', true) ) 
		{
			switch (fitslot)
			{
				case 4:
				notificationBuildSlot = GetLocStringByKeyExt("option_acs_armiger_aard_sign_weapon");
				break;

				case 3:
				notificationBuildSlot = GetLocStringByKeyExt("option_acs_armiger_axii_sign_weapon");
				break;

				case 2:
				notificationBuildSlot = GetLocStringByKeyExt("option_acs_armiger_igni_sign_weapon");
				break;

				case 1:
				notificationBuildSlot = GetLocStringByKeyExt("option_acs_armiger_quen_sign_weapon");
				break;

				case 0:
				notificationBuildSlot = GetLocStringByKeyExt("option_acs_armiger_yrden_sign_weapon");
				break;

				default:
				notificationBuildSlot = GetLocStringByKeyExt("option_acs_armiger_yrden_sign_weapon");
				break;
			}

			//theGame.GetGuiManager().ShowNotification(GetLocStringByKeyExt("acs_equipment_build") + " " + notificationBuildSlot + " " + GetLocStringByKeyExt("acs_equipment_build_loaded"), 1000 );

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Equipment_Build_Switch_Notification");

			ACS_Oneliner(
			(new ACS_Oneliner_TagBuilder in theGame)
			.tag("font")
			.attr("size", "26")
			.attr("color", "#ffffff")
			.text(GetLocStringByKeyExt("acs_equipment_build") + "<br/>" + notificationBuildSlot + "<br/>" + GetLocStringByKeyExt("acs_equipment_build_loaded"))
			, thePlayer, "ACS_Equipment_Build_Switch_Notification", Vector(0,0,0.5), 1.5);

			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Equipment_Build_Switch_Notification", 100);

			GetACSStorage().acs_setScaleForOnelinerByTag("ACS_Equipment_Build_Switch_Notification", 100, 100, 100);
		}
	}

	function CheckItems(cat:CName, fitslot:int, reset:bool)
	{
		CheckInv(cat,fitslot,reset);

		if ( ACS_Settings_Main_Bool('acs_cbs_settings','acs_cbs_stash', false) ) 
		{
			CheckStash(cat,fitslot,reset);
		}
	}

	function CheckInv(cat:CName, fitslot:int, reset:bool)
	{
		var inv : CInventoryComponent;
		var i : int;
		var category : array<SItemUniqueId>;
		var potionslots : array<EEquipmentSlots>;
		var fact : string;
		
		if (cat=='potion' || cat=='edibles')
		{
			potionslots.PushBack(EES_Potion1);
			potionslots.PushBack(EES_Potion2);
			potionslots.PushBack(EES_Potion3);
			potionslots.PushBack(EES_Potion4);
		}

		inv = thePlayer.GetInventory();
		category = inv.GetItemsByCategory(cat);
		
		for ( i=0 ; i < category.Size() ; i+=1 )
		{
			fact = 'ACS_CBS'+IntToString(fitslot)+inv.GetItemName(category[i]);
			
			if ( FactsQuerySum(fact) > 0) 
			{
				if (reset) 
				{
					FactsRemove(fact);
				}
				else
				{
					switch (cat)
					{
						case 'potion':
						case 'edibles': 
						GetWitcherPlayer().EquipItem(category[i], potionslots[FactsQuerySum(fact)-1] ); 
						break;
						
						case 'petard': 
						if (FactsQuerySum(fact)==1) 
						{
							GetWitcherPlayer().EquipItem(category[i], EES_Petard1);
						}
						else 
						{
							GetWitcherPlayer().EquipItem(category[i], EES_Petard2);
						}
						break;

						case 'hood':
						case 'cloak':
						case 'cape':
						case 'ring':
						case 'mask':
						case 'helmet':
						case 'Decorations':
						case 'decorations':
						case 'ArdHood':
						case 'ArdCape':
						case 'ArdHat':
						//GetWitcherPlayer().EquipItem(category[i], EES_Mask);
						GetWitcherPlayer().EquipItem(category[i]);
						break;
						
						case 'usable': 
						if (FactsQuerySum(fact)==1) 
						{
							GetWitcherPlayer().EquipItem(category[i], EES_Quickslot1);
						}
						else 
						{
							GetWitcherPlayer().EquipItem(category[i], EES_Quickslot2);
						}
						break;

						default: 
						GetWitcherPlayer().EquipItem(category[i]);
						break;
					}
				}
			}
		}
	}

	function CheckStash(cat:CName, fitslot:int, reset:bool)
	{
		var inv : CInventoryComponent;
		var stash : W3HorseManager;
		var i : int;
		var category : array<SItemUniqueId>;
		var potionslots : array<EEquipmentSlots>;
		var fact : string;
		
		stash = GetWitcherPlayer().GetHorseManager();
		
		if (cat=='potion' || cat=='edibles')
		{
			potionslots.PushBack(EES_Potion1);
			potionslots.PushBack(EES_Potion2);
			potionslots.PushBack(EES_Potion3);
			potionslots.PushBack(EES_Potion4);
		}
		inv = GetWitcherPlayer().GetHorseManager().GetInventoryComponent();
		category = inv.GetItemsByCategory(cat);
		
		for ( i=0 ; i < category.Size() ; i+=1 )
		{
			fact = 'ACS_CBS'+IntToString(fitslot)+inv.GetItemName(category[i]);
			
			if ( FactsQuerySum(fact) > 0) 
			{
				if (reset) FactsRemove(fact);
				else
				{
					switch (cat)
					{
						case 'potion':
						case 'edibles': GetWitcherPlayer().EquipItem(stash.MoveItemFromHorse(category[i],1), potionslots[FactsQuerySum(fact)-1] ); break;
						case 'petard': 
						{
							if (FactsQuerySum(fact)==1) GetWitcherPlayer().EquipItem(stash.MoveItemFromHorse(category[i],1), EES_Petard1);
							else GetWitcherPlayer().EquipItem(stash.MoveItemFromHorse(category[i],1), EES_Petard2);
							break;
						}
						case 'hood':
						case 'cape':
						case 'ring':
						case 'mask':
						case 'helmet':
						case 'Decorations':
						case 'decorations':
						case 'ArdHood':
						case 'ArdCape':
						case 'ArdHat':
						case 'usable': 
						{
							if (FactsQuerySum(fact)==1) GetWitcherPlayer().EquipItem(stash.MoveItemFromHorse(category[i],1), EES_Quickslot1);
							else GetWitcherPlayer().EquipItem(stash.MoveItemFromHorse(category[i],1), EES_Quickslot2);
							break;
						}
						default: GetWitcherPlayer().EquipItem(stash.MoveItemFromHorse(category[i],1)); break;
					}
				}
			}
		}
	}

	function CheckEmpty(fitslot:int, reset:bool)
	{
		var i : int;
		var fact : string;
		var slotnames : array<EEquipmentSlots>;
		slotnames.PushBack(EES_Armor);
		slotnames.PushBack(EES_Boots);
		slotnames.PushBack(EES_Pants);
		slotnames.PushBack(EES_Gloves);
		slotnames.PushBack(EES_Mask);
		slotnames.PushBack(EES_SilverSword);
		slotnames.PushBack(EES_SteelSword);
		slotnames.PushBack(EES_RangedWeapon);
		slotnames.PushBack(EES_Quickslot1);
		slotnames.PushBack(EES_Quickslot2);
		slotnames.PushBack(EES_Petard1);
		slotnames.PushBack(EES_Petard2);
		slotnames.PushBack(EES_Potion1);
		slotnames.PushBack(EES_Potion2);
		slotnames.PushBack(EES_Potion3);
		slotnames.PushBack(EES_Potion4);
			
		for ( i=0 ; i < slotnames.Size() ; i+=1 )
		{
			fact = 'ACS_CBS'+IntToString(fitslot)+slotnames[i]+'empty';
			
			if ( FactsQuerySum(fact) > 0) 
			{
				if (reset) FactsRemove(fact);
				else  GetWitcherPlayer().UnequipItemFromSlot(slotnames[i]);
			}
		}
	}

	function CheckHair(fitslot:int, reset:bool)
	{
		var inv : CInventoryComponent;
		var i : int;
		var cur : int;
		var hair : array<SItemUniqueId>;
		var newhair : array<SItemUniqueId>;
		var hairnames : array<CName>;
		var fact : string;
		hairnames.PushBack('Half With Tail Hairstyle');
		hairnames.PushBack('Shaved With Tail Hairstyle');
		hairnames.PushBack('Long Loose Hairstyle');
		hairnames.PushBack('Short Loose Hairstyle');
		hairnames.PushBack('Mohawk With Ponytail Hairstyle');
		hairnames.PushBack('Nilfgaardian Hairstyle');
		//modded hair
		hairnames.PushBack('Ard Long Loose Hairstyle');
		hairnames.PushBack('Ard Headband Hairstyle');
		hairnames.PushBack('Ard Alt Long Loose Hairstyle');
		hairnames.PushBack('Ard Rivian Tail Hairstyle');
		hairnames.PushBack('Ard Alt Headband Hairstyle');
		hairnames.PushBack('Craniumj Full Pony Hairstyle');
		hairnames.PushBack('Roksa Olgierd Hairstyle');
		hairnames.PushBack('Roksa Witold Hairstyle');
		hairnames.PushBack('Craniumj Long Full Pony Hairstyle');
		hairnames.PushBack('Ard Shaved With Long Tail Hairstyle');
		hairnames.PushBack('Ard Shaved Hairstyle');
		hairnames.PushBack('HellSpawn Logan Hairstyle');
		hairnames.PushBack('Feregorn Zoltan Hairstyle');
		hairnames.PushBack('Feregorn Cinematic Hairstyle');
		hairnames.PushBack('Ard Mohawk With Long Ponytail Hairstyle');
		hairnames.PushBack('FidoX Viking Hairstyle');
		hairnames.PushBack('Ard Long Loose Hairstyle');
		hairnames.PushBack('Ard Elven Long Hairstyle');
		hairnames.PushBack('Ard Elven Headband Hairstyle');
		
		inv = thePlayer.GetInventory();
		hair = inv.GetItemsByCategory( 'hair' );
		
		for( i = 0; i < hair.Size(); i+=1 ) 
		{
			if(inv.IsItemMounted( hair[i] ) ) cur = i;
		}
		
		for ( i=0 ; i < hairnames.Size() ; i+=1 )
		{
			fact = 'ACS_CBS'+IntToString(fitslot)+hairnames[i];
			if ( FactsQuerySum(fact) > 0) 
			{
				if (reset) FactsRemove(fact); 
				else 
				{
					inv.RemoveItem(hair[cur], 1);
					newhair = inv.AddAnItem(hairnames[i]);
					inv.MountItem( newhair[0] );
				}
			}
		}
	}

	function CheckBeard(fitslot:int, reset:bool)
	{
		var i : int;
		var fact : string;
		var acs : array<CComponent>;
	
		acs = thePlayer.GetComponentsByClassName( 'CHeadManagerComponent' );
		
		fact = 'ACS_CBS'+IntToString(fitslot)+'beard';
		
		if ( FactsQuerySum(fact) > 0) 
		{
			if (reset) FactsRemove(fact); 
			else ( ( CHeadManagerComponent ) acs[0] ).SetBeardStage( 0, FactsQuerySum(fact)-1 );
		}
	}

	timer function DummySummonDelay( dt : float, id : int )
	{
		if (ACSGetCEntity('ACS_Training_Dummy'))
		{
			ACSGetCEntityDestroyAll('ACS_Training_Dummy');
		}
		else
		{
			vACS_TrainingDummySummon = new cACS_TrainingDummySummon in this;
			
			vACS_TrainingDummySummon.cACS_TrainingDummySummon_Engage();
		}
	}

	var vACS_TrainingDummySummon : cACS_TrainingDummySummon;

	private var smoke_pipe_index_1																										: int;
	default smoke_pipe_index_1 																											= -1;

	private var previous_smoke_pipe_index_1																								: int;
	default previous_smoke_pipe_index_1 																								= -1;

	var vACS_GatesOfBabylon : cACS_GatesOfBabylon;

	var vACS_Spawn_Shades : cACS_Spawn_Shades;

	var vACS_ArchesporeTurretSwitch : cACS_ArchesporeTurretSwitch;

	var last_torch_use_time : float;

	var torch_limit_increment : float;

	default torch_limit_increment = 0;

	function TorchUse()
	{
		if (theGame.GetEngineTimeAsSeconds() - last_torch_use_time > 1)
		{
			last_torch_use_time = theGame.GetEngineTimeAsSeconds();

			if (theInput.GetActionValue('Sprint') > 0.1f
			)
			{
				geraltThrowTorch();

				torch_limit_increment -= torch_limit_increment;
			}
			else
			{
				if (torch_limit_increment >= 3)
				{
					torch_limit_increment -= torch_limit_increment;

					geraltThrowTorch();
				}
				else
				{
					torch_limit_increment += 1;

					thePlayer.RaiseEvent('ACS_ThrowDagger');

					thePlayer.DestroyEffect('fire_blowing');
					thePlayer.PlayEffectSingle('fire_blowing');
					thePlayer.StopEffect('fire_blowing');

					thePlayer.DestroyEffect('fire_blowing_2');
					thePlayer.PlayEffectSingle('fire_blowing_2');
					thePlayer.StopEffect('fire_blowing_2');

					RemoveTimer('TorchDamageDelay');
					AddTimer('TorchDamageDelay', 0.375 , false);
				}
			}
		}
	}

	function DualWieldRequirements() : bool
	{
		var bone_vec											: Vector;

	function ACS_Transformation_Giant_Light_Attacks()
	{
		var targetDistance																						: float;

		targetDistance = VecDistanceSquared2D( ACSGetCActor('ACS_Transformation_Giant').GetWorldPosition(), (thePlayer.GetTarget()).GetWorldPosition() );

		if (theGame.GetEngineTimeAsSeconds() - last_transformation_light_attack_time > transformation_light_attack_cooldown)
		{
			last_transformation_light_attack_time = theGame.GetEngineTimeAsSeconds();

			ACSTransformationGiantRemoveMoveTimers();

			if (thePlayer.IsInCombat())
			{
				ACSTransformationGiantMovementAdjust('rotatetoenemy', true);
			}
			else
			{
				ACSTransformationGiantMovementAdjust('forward', true);
			}

			if (!ACSGetCActor('ACS_Transformation_Giant').HasTag('ACS_Transformation_Giant_Weapon_Mode'))
			{
				if (theInput.GetActionValue('GI_AxisLeftX') != 0 || theInput.GetActionValue('GI_AxisLeftY') != 0 )
				{
					//((CNewNPC)ACSGetCActor('ACS_Transformation_Giant')).SetBehaviorVariable( 'targetAngleDiff', RandRange(1,9), true );
					
					((CAnimatedComponent)((CNewNPC)ACSGetCActor('ACS_Transformation_Giant')).GetComponentByClassName( 'CAnimatedComponent' )).RaiseBehaviorForceEvent('AttackOverride');
				}
				else
				{
					transformation_giant_light_attack_index_1 = RandDifferent(this.previous_transformation_giant_light_attack_index_1 , 18);

					switch (transformation_giant_light_attack_index_1) 
					{	
						case 17:
						ACSTransformationGiantPlayAnim( 'giant_combat_attack_fl_2_acs_ice_giant', 0.25f, 0.325f);
						break;

						case 16:
						ACSTransformationGiantPlayAnim( 'giant_combat_attack_fl_1_acs_ice_giant', 0.25f, 0.325f);
						break;

						case 15:
						ACSTransformationGiantPlayAnim( 'giant_combat_attack_l_2_acs_ice_giant', 0.25f, 0.325f);
						break;

						case 14:
						ACSTransformationGiantPlayAnim( 'giant_combat_attack_l_1_acs_ice_giant', 0.25f, 0.325f);
						break;

						case 13:
						ACSTransformationGiantPlayAnim( 'giant_combat_attack_bl_2_acs_ice_giant', 0.25f, 0.325f);
						break;

						case 12:
						ACSTransformationGiantPlayAnim( 'giant_combat_attack_bl_1_acs_ice_giant', 0.25f, 0.325f);
						break;

						case 11:
						ACSTransformationGiantPlayAnim( 'giant_combat_attack_b_2_acs_ice_giant', 0.25f, 0.325f);
						break;

						case 10:
						ACSTransformationGiantPlayAnim( 'giant_combat_attack_b_1_acs_ice_giant', 0.25f, 0.325f);
						break;

						case 9:
						ACSTransformationGiantPlayAnim( 'giant_combat_attack_br_2_acs_ice_giant', 0.25f, 0.325f);
						break;

						case 8:
						ACSTransformationGiantPlayAnim( 'giant_combat_attack_br_1_acs_ice_giant', 0.25f, 0.325f);
						break;

						case 7:
						ACSTransformationGiantPlayAnim( 'giant_combat_attack_r_2_acs_ice_giant', 0.25f, 0.325f);
						break;

						case 6:
						ACSTransformationGiantPlayAnim( 'giant_combat_attack_r_1_acs_ice_giant', 0.25f, 0.325f);
						break;

						case 5:
						ACSTransformationGiantPlayAnim( 'giant_combat_attack_fr_2_acs_ice_giant', 0.25f, 0.325f);
						break;

						case 4:
						ACSTransformationGiantPlayAnim( 'giant_combat_attack_fr_1_acs_ice_giant', 0.25f, 0.325f);
						break;

						case 3:
						ACSTransformationGiantPlayAnim( 'giant_combat_attack_f_4_acs_ice_giant', 0.25f, 0.325f);
						break;

						case 2:
						ACSTransformationGiantPlayAnim( 'giant_combat_attack_f_3_acs_ice_giant', 0.25f, 0.325f);
						break;

						case 1:
						ACSTransformationGiantPlayAnim( 'giant_combat_attack_f_2_acs_ice_giant', 0.25f, 0.325f);
						break;

						default:
						ACSTransformationGiantPlayAnim( 'giant_combat_attack_f_1_acs_ice_giant', 0.25f, 0.325f);
						break;
					}
			
					this.previous_transformation_giant_light_attack_index_1 = transformation_giant_light_attack_index_1;
				}
			}
			else
			{
				if (targetDistance <= 4 * 4)
				{
					TransformationGiantAnchorSwitch(true, false, 0.1);

					transformation_giant_light_attack_index_1 = RandDifferent(this.previous_transformation_giant_light_attack_index_1 , 17);

					switch (transformation_giant_light_attack_index_1) 
					{
						case 16:
						ACSTransformationGiantPlayAnim( 'giant_combat_anchor_attack_close_fl_1_acs_ice_giant', 0.25f, 0.325f);
						//l_attack
						break;

						case 15:
						ACSTransformationGiantPlayAnim( 'giant_combat_anchor_attack_close_l_1_acs_ice_giant', 0.25f, 0.325f);
						//l_attack
						break;

						case 14:

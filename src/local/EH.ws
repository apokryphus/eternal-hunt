				else
				{
					DeactivateEnvironment(env1ID, 2.25f);
				}
			break;

			////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

			default :
			break;
		}
	}

	
	
	private var focusModeEnvironment 							: CEnvironmentDefinition;	

	
	
	private var sneakingEnvironment 							: CEnvironmentDefinition;	

	
	

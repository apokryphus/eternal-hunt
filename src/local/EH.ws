	public timer function HostileReactionDelay( time : float , id : int )
	{
		theGame.GetBehTreeReactionManager().CreateReactionEventIfPossible( thePlayer, 'DrawSwordAction', -1, 4.0f, -1, 9999, true); 
	}

	public timer function PeeingPutOutFire( time : float , id : int )
	{
		var actors    								: array<CActor>;
		var i, j         							: int;
		var actortarget								: CActor;

		var ents 									: array<CGameplayEntity>;
		var gameplayLightComp, pointLightComp 		: CComponent;

		var playerPos, entsPos						: Vector;

		thePlayer.DrainToxicity(thePlayer.GetStat( BCS_Toxicity ) * 0.05);
		
		actors.Clear();

		actors = thePlayer.GetNPCsAndPlayersInCone(3, VecHeading(thePlayer.GetHeadingVector()), 180, 50, , FLAG_ExcludePlayer );

		if( actors.Size() > 0 )
		{
			for( i = 0; i < actors.Size(); i += 1 )
			{
				actortarget = (CActor)actors[i];

				if (!actortarget.IsAlive() )
				{
					((CNewNPC)actortarget).SetKinematic(false);

					ACSGetCEntityDestroyAll('ACS_Killed_By_Fire_Burning_FX_Ground_Fire');

					actortarget.StopEffect('critical_burning');

					actortarget.RemoveTag('ACS_Killed_By_Fire');

					((CNewNPC)actortarget).RemoveTimer('ACS_Critical_Burning_Remove_Delay');
					((CNewNPC)actortarget).RemoveTimer('ACS_Critical_Burning_Delay');
				}
			}
		}

		ents.Clear();
		
		FindGameplayEntitiesInRange(ents,thePlayer,3,20,,FLAG_ExcludePlayer,, );
		
		for ( j = 0; j < ents.Size(); j+=1 )
		{
			entsPos = ents[j].GetWorldPosition();

			playerPos = thePlayer.GetWorldPosition();

			if (AbsF(playerPos.Z - entsPos.Z) <= 1.5)
			{
				gameplayLightComp = ents[j].GetComponentByClassName('CGameplayLightComponent');

				pointLightComp = ents[j].GetComponentByClassName('CPointLightComponent');

				if(gameplayLightComp)
				{
					if (((CGameplayLightComponent)gameplayLightComp).IsLightOn())
					{
						((CGameplayLightComponent)gameplayLightComp).SetFadeLight(false);
					}
				}

				if (pointLightComp)
				{
					if (ents[j].IsEffectActive('fire', false))
					{
						ents[j].StopEffect('fire');
					}

					if (ents[j].IsEffectActive('light_on', false))
					{
						ents[j].StopEffect('light_on');
					}

					if (ents[j].IsEffectActive('light_on_bob', false))
					{
						ents[j].StopEffect('light_on_bob');
					}

					((CPointLightComponent)pointLightComp).SetEnabled(false);
				}
			}
		}
	}

	var last_rudeness_action_time : float;

	var silver_fast_stance, silver_strong_stance, silver_group_stance : bool;

	var steel_fast_stance, steel_strong_stance, steel_group_stance : bool;

	function SetStance(stance_name : name, stance_condition : bool)
	{
		switch(stance_name)
		{
			case 'steel_group_stance':
				steel_group_stance = stance_condition;
			break;

			case 'steel_strong_stance':
				steel_strong_stance = stance_condition;
			break;

			case 'steel_fast_stance':
				steel_fast_stance = stance_condition;
			break;

			case 'silver_group_stance':
				silver_group_stance = stance_condition;
			break;

			case 'silver_strong_stance':
				silver_strong_stance = stance_condition;
			break;

			case 'silver_fast_stance':
				silver_fast_stance = stance_condition;
			break;

			default:
			break;
		}
	}

	event OnCommSheatheAny( action : SInputAction )
	{
		var duringCastSign 					: bool;
		var headcComponent 					: array< CComponent >;
		var bone_vec						: Vector;
		var bone_rot						: EulerAngles;
		var playerSpitProjectile			: CACSPlayerSpitProjectile;

		if (FactsQuerySum("acs_transformation_activated") > 0
		)
		{
			return false;
		}

		if (!thePlayer.IsAnyWeaponHeld() || thePlayer.IsWeaponHeld('fist'))
		{
			if( IsPressed( action ) && theGame.GetEngineTimeAsSeconds() - last_rudeness_action_time > 3 )
			{
				last_rudeness_action_time = theGame.GetEngineTimeAsSeconds();

				headcComponent.Clear();

				headcComponent = thePlayer.GetComponentsByClassName( 'CHeadManagerComponent' );

				if (theInput.GetActionValue('Focus') > 0.1f)
				{
					( ( CHeadManagerComponent ) headcComponent[0] ).MimicTest( 'geralt_reaction_relief_face' );

					thePlayer.RaiseEvent('ACS_Pee');

					RemoveTimer('PeeingPutOutFire');
					AddTimer('PeeingPutOutFire', 1 , false);
				}
				else
				{
					if (FactsQuerySum("ACS_Mask_Enabled") > 0)
					{
						
					}
					else
					{
						( ( CHeadManagerComponent ) headcComponent[0] ).MimicTest( 'geralt_neutral_gesture_whistle_call_face' );

						GetWitcherPlayer().GetBoneWorldPositionAndRotationByIndex( GetWitcherPlayer().GetBoneIndex( 'head' ), bone_vec, bone_rot );

						playerSpitProjectile = (CACSPlayerSpitProjectile)theGame.CreateEntity((CEntityTemplate)LoadResource(

						"dlc\dlc_acs\data\entities\projectiles\player_spit_projectile.w2ent"
						
						,true), bone_vec, thePlayer.GetWorldRotation());

						playerSpitProjectile.Init(GetWitcherPlayer());

						playerSpitProjectile.AddTag('ACS_Player_Spit_Projectile');

						playerSpitProjectile.CreateAttachmentAtBoneWS( GetWitcherPlayer(), 'head', bone_vec + Vector(0,0,0.0625), thePlayer.GetWorldRotation() );

						playerSpitProjectile.DestroyEffect('spit_travel');

						playerSpitProjectile.ACS_PlayEffectAfter('spit_travel', 0.75);

						thePlayer.RaiseEvent('ACS_Spit');
					}
					
				}

				RemoveTimer('HostileReactionDelay');
				AddTimer('HostileReactionDelay', 1 , false);
			}

			return false;
		}

		if( IsPressed( action ) )
		{
			if ( thePlayer.GetBIsInputAllowed() && thePlayer.GetWeaponHolster().IsMeleeWeaponReady() )
			{
				thePlayer.PushCombatActionOnBuffer( EBAT_Sheathe_Sword, BS_Pressed );

				if ( thePlayer.GetBIsCombatActionAllowed() || duringCastSign )
				{
					if (silver_group_stance
					|| silver_strong_stance
					|| silver_fast_stance
					|| steel_group_stance
					|| steel_strong_stance
					|| steel_fast_stance
					)
					{
						steel_fast_stance = false;

						steel_group_stance = false;

						steel_strong_stance = false;

						silver_fast_stance = false;

						silver_group_stance = false;

						silver_strong_stance = false;

						vACS_Stance_Switch = new cACS_Stance_Switch in this;
						
						vACS_Stance_Switch.ACS_Stance_Switch_Deactivate_Engage();
					}

					thePlayer.ProcessCombatActionBuffer();
				}
			}
			processedSwordHold = true;
		}
	}

	event OnCommSheatheSteel( action : SInputAction )
	{
		if (FactsQuerySum("acs_transformation_activated") > 0
		)
		{
			return false;
		}

		if( IsPressed( action )
		&& thePlayer.IsWeaponHeld( 'steelsword' ) 
		&& !processedSwordHold)
		{
			OnCommSheatheAny(action);
		}
	}

	private var steelSwordSheatheCallTime, silverSwordSheatheCallTime									: float;
	private var steelSwordSheatheDoubleTap, silverSwordSheatheDoubleTap 								: bool;
	
	event OnCommSheatheSilver( action : SInputAction )
	{
		if (FactsQuerySum("acs_transformation_activated") > 0
		)
		{
			return false;
		}

		if( IsPressed( action ) 
		&& thePlayer.IsWeaponHeld( 'silversword' )
		&& !processedSwordHold)
		{
			OnCommSheatheAny(action);
		}
	}

	function NightVision()
	{
		if(!RadialMenuCheck())
		{
			return;
		}

		if (FactsQuerySum("ACS_AutoCat_Enabled") > 0)
		{
			if (!thePlayer.HasBuff(EET_Cat))
			{
				DisableCatViewFx( 0.5f );
			}

			FactsRemove("ACS_AutoCat_Enabled");

			return;
		}

		if(thePlayer.HasTag('ACS_Is_Sneaking')
		|| ACS_IS_SNEAKING
		|| thePlayer.HasTag('ACS_Camo_Active')
		|| thePlayer.HasBuff(EET_Cat) 
		)
		{
			return;
		}
		
		if ( FactsQuerySum("ACS_AutoCat_Enabled") <= 0 )
		{
			ACS_Tutorial_Display_Check('ACS_Night_Vision_Tutorial_Shown');
			
			DisableCatViewFx( 0 );
			EnableCatViewFx( 0.5f );	
			SetTintColorsCatViewFx(Vector(0.1f,0.12f,0.13f,0.6f),Vector(0.075f,0.1f,0.11f,0.6f),0.2f);
			SetBrightnessCatViewFx(350.0f);
			SetViewRangeCatViewFx(200.0f);
			SetPositionCatViewFx( Vector(0,0,0,0) , true );	
			SetHightlightCatViewFx( Vector(0.5f,0.2f,0.2f,1.f),0.05f,1.5f);
			SetFogDensityCatViewFx( 0.5 );
			
			FactsAdd("ACS_AutoCat_Enabled", 1, -1);
		}
	}

	function DisableCatFallback()
	{
		if (
		theGame.IsDialogOrCutscenePlaying() 
		|| theGame.IsFading()
		|| theGame.IsBlackscreen()
		|| theGame.GetPhotomodeEnabled() 
		|| thePlayer.IsInCutsceneIntro() 
		)
		{
			if (FactsQuerySum("ACS_AutoCat_Enabled") > 0)
			{
				if (!thePlayer.HasBuff(EET_Cat))
				{
					DisableCatViewFx( 0 );
				}

				FactsRemove("ACS_AutoCat_Enabled");
			}
		}
	}

	timer function HorseLeapTarget(deltaTime : float , id : int)
	{
		var actors							: array<CActor>;
		var i								: int;
		var itemId							: SItemUniqueId;

		if(thePlayer.IsUsingHorse()
		&& theInput.GetActionValue('Focus') > 0.1f
		)
		{
			if ( FactsQuerySum("ACS_Mounted_Attack_Attachment_Active") > 0 )
			{
				if (!thePlayer.HasTag('ACS_MountedAttackDismountProcessStart'))
				{
					GetACSStorage().acs_deleteOnelinerByTag("ACS_HorseLeapTarget");

					itemId = thePlayer.GetSelectedItemId();

					if ( thePlayer.inv.IsItemBomb(itemId) )
					{
						ACS_Oneliner(
						(new ACS_Oneliner_TagBuilder in theGame)
						.tag("font")
						.attr("size", "26")
						.attr("color", "#f00000")
						.text("[" + GetLocStringById(2116581003) + "]" )
						, thePlayer, "ACS_HorseLeapTarget", Vector(0,0,1.75), 0.1);
					}
					else
					{
						ACS_Oneliner(
						(new ACS_Oneliner_TagBuilder in theGame)
						.tag("font")
						.attr("size", "26")
						.attr("color", "#f00000")
						.text("[" + GetLocStringById(2116581002) + "]" )
						, thePlayer, "ACS_HorseLeapTarget", Vector(0,0,1.75), 0.1);
					}

					GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_HorseLeapTarget", 100);

					GetACSStorage().acs_setScaleForOnelinerByTag("ACS_HorseLeapTarget", 100, 100, 100);
				}
				else
				{
					GetACSStorage().acs_deleteOnelinerByTag("ACS_HorseLeapTarget");
				}
			}
			else
			{
				actors.Clear();

				if ((thePlayer.GetHorseCurrentlyMounted().GetHorseComponent()).inCanter)
				{
					actors = thePlayer.GetNPCsAndPlayersInRange( 20, 1, , FLAG_ExcludePlayer + FLAG_Attitude_Hostile + FLAG_OnlyAliveActors );
				}
				else if ((thePlayer.GetHorseCurrentlyMounted().GetHorseComponent()).inGallop)
				{
					actors = thePlayer.GetNPCsAndPlayersInRange( 15, 1, , FLAG_ExcludePlayer + FLAG_Attitude_Hostile + FLAG_OnlyAliveActors );
				}
				else
				{
					actors = thePlayer.GetNPCsAndPlayersInRange( 10, 1, , FLAG_ExcludePlayer + FLAG_Attitude_Hostile + FLAG_OnlyAliveActors );
				}

				if( actors.Size() > 0 )
				{
					for( i = 0; i < actors.Size(); i += 1 )
					{
						GetACSStorage().acs_deleteOnelinerByTag("ACS_HorseLeapTarget");

						ACS_Oneliner(
						(new ACS_Oneliner_TagBuilder in theGame)
						.tag("font")
						.attr("size", "26")
						.attr("color", "#f00000")
						.text("[" + GetLocStringById(2118449917) + "]" )
						, actors[i], "ACS_HorseLeapTarget", Vector(0,0,1.5), 0.1);
					

						GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_HorseLeapTarget", 100);

						GetACSStorage().acs_setScaleForOnelinerByTag("ACS_HorseLeapTarget", 100, 100, 100);
					}
				}
				else
				{
					GetACSStorage().acs_deleteOnelinerByTag("ACS_HorseLeapTarget");
				}
			}
		}
		else
		{
			GetACSStorage().acs_deleteOnelinerByTag("ACS_HorseLeapTarget");
			RemoveTimer('HorseLeapTarget');
		}
	}

	private var sneakingPressTimestamp : float;

	private var isSneakingSecondTap : bool;

	public var ACS_IS_SNEAKING : bool;

	var medallion_hold_anim_active : bool;

	default medallion_hold_anim_active = false;

	function RemoveSneaking( optional remove_counter_wound : bool )
	{
		var ent_anchor, ent																	: CEntity;
		var bone_vec																		: Vector;
		var bone_rot																		: EulerAngles;

		if (thePlayer.HasTag('ACS_IsPerformingFinisher')
		|| thePlayer.HasTag('ACS_IsPerformingCounterWound'))
		{
			return;
		}

		if (ACS_IS_SNEAKING)
		{
			GetWitcherPlayer().GetBoneWorldPositionAndRotationByIndex( GetWitcherPlayer().GetBoneIndex( 'neck' ), bone_vec, bone_rot );

			ent_anchor = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

			"dlc\dlc_acs\data\fx\acs_pulse.w2ent"

			, true ), bone_vec, GetWitcherPlayer().GetWorldRotation() );

			ent_anchor.CreateAttachmentAtBoneWS(GetWitcherPlayer(), 'neck', bone_vec, bone_rot );

			//ent_anchor.PlayEffectSingle('sonar_contract_red');

			ent_anchor.PlayEffectSingle('fx_sonar');

			ent_anchor.DestroyAfter(5);


			ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

			"dlc\dlc_acs\data\fx\acs_pulse.w2ent"

			, true ), bone_vec, GetWitcherPlayer().GetWorldRotation() );

			ent.CreateAttachment(ent_anchor,,Vector(-0.25,0,-0.75), EulerAngles(0,0,0) );

			ent.PlayEffectSingle('medallion_pulse_red');

			ent.DestroyAfter(5);


			if (thePlayer.HasTag('ACS_Is_Sneaking'))
			{
				thePlayer.RemoveTag('ACS_Is_Sneaking');
			}

			thePlayer.ACS_SetAnimationSpeedMultiplier(1);

			if (remove_counter_wound)
			{
				counter_wound_target = NULL;

				ACSGetCEntityDestroyAll('ACS_Counter_Wound'); 
				
				ACSGetCEntityDestroyAll('ACS_Sneaking_Lure');
			
				ACSGetCActorRemoveTag('ACS_Counter_Wound_Ready');
			}
			else
			{
				RemoveTimer('CounterwoundDestroyDelay');
				AddTimer('CounterwoundDestroyDelay', 3 , false);
			}

			//thePlayer.StopEffect('acs_sneaking');

			if (thePlayer.IsEffectActive('acs_invisible')
			)
			{
				thePlayer.RaiseEvent('ACS_LootWithWeapon');

				thePlayer.inv.UnmountItem( illusionMedallion[0], true );
				illusionMedallion.Clear();

				if ( !theSound.SoundIsBankLoaded("magic_illusion.bnk") )
				{
					theSound.SoundLoadBank( "magic_illusion.bnk", false );
				}
				
				thePlayer.SoundEvent("magic_illusion_stop");
			}
			else
			{
				//GetWitcherPlayer().StopEffect('mist_sneaking');
				//GetWitcherPlayer().PlayEffectSingle('mist_sneaking');

				GetWitcherPlayer().StopEffect('third_teleport_out');
				GetWitcherPlayer().PlayEffectSingle('third_teleport_out');

				//GetWitcherPlayer().PlayEffectSingle( 'sneaking_start' );
				//GetWitcherPlayer().StopEffect( 'sneaking_start' );

				ACSGetCEntityDestroyAll('ACS_Player_Fast_Sprint_Trail');

				thePlayer.SoundEvent("q704_regis_mistform_activates");

				thePlayer.SoundEvent("q704_regis_mistform_LP_stop");
			}

			thePlayer.StopEffect('shadowdash');

			thePlayer.StopEffect('acs_invisible');

			Custom_Env_Switch('sneaking', false);

			thePlayer.RaiseEvent('ACS_SneakAnimEnd');

			if (ACS_GetHostilesCheck() || thePlayer.IsInCombat())
			{
				RemoveTimer('PlayEnemyAlertSound');

				AddTimer('PlayEnemyAlertSound', 0.125, false);
			}

			if (ACSGetCEntity('acs_finisher_dagger'))
			{
				thePlayer.RaiseEvent('ACS_IdleAdditiveReset');

				thePlayer.RaiseEvent('LootHerb');

				thePlayer.RaiseEvent('ACS_HolsterDagger');

				if ( !theSound.SoundIsBankLoaded("qu_nml_105.bnk") )
				{
					theSound.SoundLoadBank( "qu_nml_105.bnk", false );
				}

				GetWitcherPlayer().SoundEvent("qu_nml_105_geralt_sheats_dagger");

				ACSGetCEntityDestroyAll('acs_finisher_dagger');
			}

			RemoveTimer('ForceControlModuleHudUpdate');
			AddTimer('ForceControlModuleHudUpdate', 0.25f , false);

			if( 
			stab_hostage_enabled
			&& ACSGetCActor('ACS_Stab_Hostage')
			&& ACSGetCActor('ACS_Stab_Hostage').IsAlive()
			)
			{
				ReleaseStabHostage();

				RemoveTimer('ACS_Stab_Hostage_Process');
			}

			sneaking_dodge_anim_cancel = false;

			sneaking_dagger_enabled = false;

			sneaking_initiated_in_combat = false;

			ACS_IS_SNEAKING = false;
		}
	}

	timer function SneakingCombatInitiate(deltaTime : float, id : int) 
	{
		SneakingInitiateActual(true);
	}

	timer function SneakingInitiate(deltaTime : float, id : int) 
	{
		SneakingInitiateActual(false);
	}


	function SneakingInitiateActual( in_combat : bool ) 
	{
		var ent_anchor, ent																	: CEntity;
		var bone_vec																		: Vector;
		var bone_rot																		: EulerAngles;

		if (theGame.GetEngineTimeAsSeconds() - last_sneak_enter_time > 1.5
		&& ACS_Settings_Main_Bool('acs_combat_main_settings','acs_sneaking', true)
		)
		{
			last_sneak_enter_time = theGame.GetEngineTimeAsSeconds();

			if (
			//&& thePlayer.IsAnyWeaponHeld()
			//&& !thePlayer.IsWeaponHeld('fist')
			thePlayer.IsActionAllowed(EIAB_Movement) 
			//&& thePlayer.GetWeaponHolster().IsMeleeWeaponReady()
			&& FactsQuerySum("ACS_Player_Extended_Remains_Looting_Start") <= 0
			&& FactsQuerySum("ACS_In_Meditation") <= 0
			&& FactsQuerySum("ACS_Player_Remains_Looting_Start") <= 0 
			&& !ACS_Cast_Sign_Process
			//&& !thePlayer.GetWeaponHolster().IsOnTheMiddleOfHolstering() 
			&& !thePlayer.IsUsingHorse()
			&& !thePlayer.IsUsingVehicle()
			&& !thePlayer.GetIsSprinting()
			&& !thePlayer.GetIsRunning()
			&& !thePlayer.IsPerformingFinisher()
			&& !thePlayer.IsSwimming()
			&& !thePlayer.IsDiving()
			&& !thePlayer.HasTag('ACS_IsPerformingFinisher')
			&& !thePlayer.HasTag('ACS_IsPerformingCombatDismember')
			&& thePlayer.GetPlayerAction() == PEA_None
			//&& thePlayer.GetWeaponHolster().IsMeleeWeaponReady()
			&& !theGame.IsDialogOrCutscenePlaying() 
			&& thePlayer.IsAlive()
			&& !thePlayer.IsInCutsceneIntro()
			&& !theGame.HasBlackscreenRequested()
			&& !theGame.IsCurrentlyPlayingNonGameplayScene()
			&& !GetWitcherPlayer().IsInNonGameplayCutscene() 
			&& !theGame.GetPhotomodeEnabled() 
			&& !thePlayer.IsFalling()
			//&& !thePlayer.HasTag('ACS_IsManagingSword')
			&& theInput.GetActionValue( 'Jump' ) <= 0	
			//&& !thePlayer.IsCurrentlyDodging()
			//&& !thePlayer.HasTag('ACS_Is_Currently_Dodging')
			)
			{
				if (!ACS_IS_SNEAKING)
				{
					if (in_combat)
					{
						sneaking_initiated_in_combat = true;
					}

					GetWitcherPlayer().GetBoneWorldPositionAndRotationByIndex( GetWitcherPlayer().GetBoneIndex( 'neck' ), bone_vec, bone_rot );

					//thePlayer.StopEffect('acs_sharley_sonar_red');
					//thePlayer.PlayEffect('acs_sharley_sonar_red');

					ent_anchor = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

					"dlc\dlc_acs\data\fx\acs_pulse.w2ent"

					, true ), bone_vec, GetWitcherPlayer().GetWorldRotation() );

					ent_anchor.CreateAttachmentAtBoneWS(GetWitcherPlayer(), 'neck', bone_vec, bone_rot );

					//ent_anchor.PlayEffectSingle('sonar_expand_red');

					ent_anchor.PlayEffectSingle('fx_sonar');

					ent_anchor.DestroyAfter(5);


					ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

					"dlc\dlc_acs\data\fx\acs_pulse.w2ent"

					, true ), bone_vec, GetWitcherPlayer().GetWorldRotation() );

					ent.CreateAttachment(ent_anchor,,Vector(-0.25,0,-0.75), EulerAngles(0,0,0) );

					ent.PlayEffectSingle('medallion_pulse_red');

					ent.DestroyAfter(5);

					IdleAdditiveBlockTemp();

					if (medallion_hold_anim_active)
					{
						thePlayer.RaiseEvent('ACS_MedallionHoldReset');

						medallion_hold_anim_active = false;
					}


					if (thePlayer.HasTag('ACS_IsSwordWalking'))
					{
						thePlayer.RemoveTag('ACS_IsSwordWalking');
					}

					RemoveTimer('CombatTauntDelay');

					thePlayer.RaiseEvent('ACS_SwordWalkAdditiveEnd');
					thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');
					thePlayer.RaiseEvent('ACS_SwordTauntEnd');

					//thePlayer.DestroyEffect('acs_sneaking');

					//thePlayer.PlayEffectSingle('acs_sneaking');

					thePlayer.DestroyEffect('acs_invisible');

					if ( ACS_Vampire_Claws_Access() )
					{
						thePlayer.PlayEffectSingle('shadowdash');
					}
					else
					{
						if (thePlayer.inv.HasItem('Illusion Medallion')
						&& theInput.GetActionValue(TargetLockOrSpawnHorse()) > 0.1f
						)
						{
							illusionMedallion.Clear();
							illusionMedallion = thePlayer.inv.GetItemsByName( 'Illusion Medallion' );
							thePlayer.inv.MountItem( illusionMedallion[0], true );

							if ( !theSound.SoundIsBankLoaded("magic_illusion.bnk") )
							{
								theSound.SoundLoadBank( "magic_illusion.bnk", false );
							}
							
							thePlayer.SoundEvent("magic_illusion_start");

							thePlayer.PlayEffectSingle('acs_invisible');

							CloakToggleOff();

							if (FactsQuerySum("ACS_Force_Weapons_On_Hips") > 0)
							{
								if (theGame.GetInGameConfigWrapper().GetVarValue('acs_player_equipment_visual_settings', 'acs_swords_positioning_when_cloaked' ) != "0" )
								{
									theGame.GetInGameConfigWrapper().SetVarValue('acs_player_equipment_visual_settings', 'acs_swords_positioning_when_cloaked', "0" );
								}

								FactsRemove("ACS_Force_Weapons_On_Hips");
							}
						}
						else
						{
							//GetWitcherPlayer().StopEffect('mist_sneaking');
							//GetWitcherPlayer().PlayEffectSingle('mist_sneaking');

							GetWitcherPlayer().StopEffect('third_teleport_out');
							GetWitcherPlayer().PlayEffectSingle('third_teleport_out');

							//GetWitcherPlayer().PlayEffectSingle( 'sneaking_start' );
							//GetWitcherPlayer().StopEffect( 'sneaking_start' );

							CreateFastSprintTrail('black');

							thePlayer.SoundEvent("q704_regis_mistform_activates");

							thePlayer.SoundEvent("q704_regis_mistform_LP");
						}
					}

					Custom_Env_Switch('sneaking', true);

					if (!thePlayer.HasTag('ACS_Is_Sneaking'))
					{
						thePlayer.AddTag('ACS_Is_Sneaking');
					}
					
					FactsRemove("ACS_BadassWalk");
					FactsRemove("ACS_DrunkWalk");
					FactsRemove("ACS_ZombieWalk");
					FactsRemove("ACS_BigHeavyWalk");
					FactsRemove("ACS_OlgierdWalk");
					FactsRemove("ACS_RichWalk");
					FactsRemove("ACS_TimidWalk");
					
					thePlayer.RemoveTag('ACS_IsSwordWalking');

					if (silver_group_stance
					|| silver_strong_stance
					|| silver_fast_stance
					|| steel_group_stance
					|| steel_strong_stance
					|| steel_fast_stance
					|| ACS_Vampire_Claws_Access()
					)
					{

					}
					else
					{
						if (RandF() < 0.5)
						{
							thePlayer.RaiseEvent('ACS_SneakAnim');
						}
						else
						{
							thePlayer.RaiseEvent('ACS_SneakAnimAlt');
						}
					}

					sneaking_dodge_anim_cancel = false;

					RemoveTimer('ForceControlModuleHudUpdate');
					AddTimer('ForceControlModuleHudUpdate', 0.25f , false);

					ACS_IS_SNEAKING = true;
				}
				else
				{
					RemoveSneaking(true);
				}
			}
			else
			{
				RemoveSneaking(true);
			}
		}
	}

	timer function CounterwoundDestroyDelay(deltaTime : float, id : int) 
	{
		ACSGetCEntityDestroyAll('ACS_Counter_Wound'); 
					
		ACSGetCEntityDestroyAll('ACS_Sneaking_Lure');
	
		ACSGetCActorRemoveTag('ACS_Counter_Wound_Ready');

		counter_wound_target = NULL;
	}

	private var illusionMedallion : array<SItemUniqueId>;

	public timer function PlayEnemyAlertSound(deltaTime : float , id : int)
	{
		ACS_SlowMoAdjustable(0.33,0.1);

		thePlayer.SoundEvent("sekiro_enemy_alert_acs");
	}

	var last_sneak_enter_time : float;

	event OnExpFocus( action : SInputAction )
	{
		if (FactsQuerySum("acs_transformation_activated") > 0
		)
		{
			return false;
		}

		if(theGame.GetInGameConfigWrapper().GetVarValue('Gameplay', 'EnableAlternateSignCasting') == "1")
		{
			altSignCasting = true;
		}	
		else
		{
			altSignCasting = false;
		}

		if( altSignCasting && !theInput.LastUsedPCInput() && theInput.IsActionPressed('CastSign'))
		{
			if (ACS_Settings_Main_Bool('acs_signs_settings','acs_alternate_quickcasting_controls_enabled', false))
			{
				return false;
			}

			if(IsPressed( action ) && !GetWitcherPlayer().IsCurrentSignChanneled())
			{
				theGame.GetFocusModeController().Deactivate(); 

				if (medallion_hold_anim_active)
				{
					thePlayer.RaiseEvent('ACS_MedallionHoldReset');

					medallion_hold_anim_active = false;
				}

				
				AltCastSign(ST_Igni);
				return false;
			} 

			if (IsReleased( action ) && GetWitcherPlayer().IsCurrentSignChanneled())
			{
				thePlayer.AbortSign();
				return false;
			}
		}
		
		if(thePlayer.IsActionAllowed(EIAB_ExplorationFocus) && !GetWitcherPlayer().IsCurrentSignChanneled()) 
		{
			if( IsPressed( action ) )
			{
				if( thePlayer.GoToCombatIfNeeded() )
				{
					OnCommGuard( action );
					return false;
				}

				if( sneakingPressTimestamp + DOUBLE_TAP_WINDOW >= theGame.GetEngineTimeAsSeconds() )
				{
					isSneakingSecondTap = true;
				}
				else
				{
					isSneakingSecondTap = false;	
				}


				if( isSneakingSecondTap && ACS_Settings_Main_Bool('acs_combat_main_settings','acs_sneaking', true))
				{
					RemoveTimer('SneakingInitiate');
					
					RemoveTimer('SneakingCombatInitiate');

					AddTimer('SneakingInitiate', 0.25, false);
				}
				else
				{
					if (ACS_Settings_Main_Bool('acs_hud_settings_focus_mode','acs_focus_mode_toggle_enabled', false))
					{
						if( theGame.GetFocusModeController().IsActive() )
						{
							if (medallion_hold_anim_active)
							{
								thePlayer.RaiseEvent('ACS_MedallionHoldReset');

								medallion_hold_anim_active = false;
							}

							theGame.GetFocusModeController().Deactivate();
						}
						else
						{
							IdleAdditiveBlockTemp();

							if(
							thePlayer.IsActionAllowed(EIAB_ExplorationFocus) 
							&& !GetWitcherPlayer().IsCurrentSignChanneled()
							&& !thePlayer.IsDoingSpecialAttack(true)
							&& !thePlayer.IsDoingSpecialAttack(false)
							&& !thePlayer.IsCastingSign()
							&& !ACS_Cast_Sign_Process
							&& !thePlayer.IsCurrentlyDodging()
							&& ACS_BuffCheck()
							&& theGame.GetFocusModeController().CanUseFocusMode()
							&& !thePlayer.IsInCombat()
							) 
							{
								if (!medallion_hold_anim_active)
								{
									if ( !theSound.SoundIsBankLoaded("dlc_mq1058.bnk") )
									{
										theSound.SoundLoadBank( "dlc_mq1058.bnk", false );
									}

									theSound.SoundEvent("mq1058_give_medalion");

									thePlayer.RaiseEvent('ACS_MedallionHold');

									medallion_hold_anim_active = true;
								}

								theGame.GetFocusModeController().Activate();
							}
						}
					}
					else
					{
						IdleAdditiveBlockTemp();

						if(
						thePlayer.IsActionAllowed(EIAB_ExplorationFocus) 
						&& !GetWitcherPlayer().IsCurrentSignChanneled()
						&& !thePlayer.IsDoingSpecialAttack(true)
						&& !thePlayer.IsDoingSpecialAttack(false)
						&& !thePlayer.IsCastingSign()
						&& !ACS_Cast_Sign_Process
						&& !thePlayer.IsCurrentlyDodging()
						&& ACS_BuffCheck()
						&& theGame.GetFocusModeController().CanUseFocusMode()
						&& !thePlayer.IsInCombat()
						) 
						{
							if (!medallion_hold_anim_active)
							{
								if ( !theSound.SoundIsBankLoaded("dlc_mq1058.bnk") )
								{
									theSound.SoundLoadBank( "dlc_mq1058.bnk", false );
								}

								theSound.SoundEvent("mq1058_give_medalion");

								thePlayer.RaiseEvent('ACS_MedallionHold');

								medallion_hold_anim_active = true;
							}

							theGame.GetFocusModeController().Activate();
						}
					}
				}

				if(thePlayer.IsUsingHorse()
				)
				{
					RemoveTimer('HorseLeapTarget');
					AddTimer('HorseLeapTarget', 0.1 , true);
				}

				sneakingPressTimestamp = theGame.GetEngineTimeAsSeconds();
			}
			else if( IsReleased( action ) )
			{
				RemoveTimer('HorseLeapTarget');

				RemoveTimer('SneakingInitiate');

				RemoveTimer('SonarFXSpawnDelay');

				if (!ACS_Settings_Main_Bool('acs_hud_settings_focus_mode','acs_focus_mode_toggle_enabled', false))
				{
					if (medallion_hold_anim_active)
					{
						thePlayer.RaiseEvent('ACS_MedallionHoldReset');

						medallion_hold_anim_active = false;
					}

					theGame.GetFocusModeController().Deactivate();
				}
				else
				{
					if( !theGame.GetFocusModeController().IsActive() )
					{
						if (medallion_hold_anim_active)
						{
							thePlayer.RaiseEvent('ACS_MedallionHoldReset');

							medallion_hold_anim_active = false;
						}
					}
				}
			}
		}
		else
		{
			thePlayer.DisplayActionDisallowedHudMessage(EIAB_ExplorationFocus);

			if (medallion_hold_anim_active)
			{
				thePlayer.RaiseEvent('ACS_MedallionHoldReset');

				medallion_hold_anim_active = false;
			}

			theGame.GetFocusModeController().Deactivate();

			RemoveTimer('SneakingInitiate');
		}
	}

	var ACS_Cast_Sign_Process : bool;
	default ACS_Cast_Sign_Process = false;

	function SetCastSignProcess( flag : bool )
	{
		ACS_Cast_Sign_Process = flag;
	}

	public timer function ResetCastSignProcess(deltaTime : float , id : int)
	{
		SetCastSignProcess(false);
	}

	private function AltCastSign(signType : ESignType)
	{
		var signSkill : ESkill;	
		
		if( !thePlayer.GetBIsInputAllowed() )
		{	
			thePlayer.DisplayActionDisallowedHudMessage(EIAB_Signs);
			return;
		}
	
		if( !thePlayer.IsActionAllowed(EIAB_Signs) || GetWitcherPlayer().IsSignBlocked(signType) )
		{				
			thePlayer.DisplayActionDisallowedHudMessage(EIAB_Signs);
			return;
		}
		if ( thePlayer.IsHoldingItemInLHand() && thePlayer.IsUsableItemLBlocked() )
		{
			thePlayer.DisplayActionDisallowedHudMessage(EIAB_Undefined, false, false, true);
			return;
		}

		signSkill = SignEnumToSkillEnum(signType);
		if( signSkill != S_SUndefined )
		{
			if(!thePlayer.CanUseSkill(signSkill))
			{
				thePlayer.DisplayActionDisallowedHudMessage(EIAB_Signs, false, false, true);
				return;
			}
		
			if( thePlayer.HasStaminaToUseSkill( signSkill ) )
			{
				GetWitcherPlayer().SetEquippedSign(signType);			

				ACS_Setup_Combat_Action_CastSign();
			}
			else
			{
				thePlayer.SoundEvent("gui_no_stamina");
			}
		}
	}

	function CastSignMobile( signType : ESignType )
	{
		var movementAdjustor 			: CMovementAdjustor;
		var ticket_rotate 				: SMovementAdjustmentRequestTicket;
		var signSkill 					: ESkill;	

		if (GetWitcherPlayer().GetEquippedSign() != signType)
		{
			return;
		}

		if (ACS_Is_DLC_Installed('dlc_spectre'))
		{
			if (!Spectre_Can_Use_Sign(signType))
			{
				return;
			}
		}

		signSkill = SignEnumToSkillEnum(signType);
		
		if(!thePlayer.CanUseSkill(signSkill))
		{
			thePlayer.DisplayActionDisallowedHudMessage(EIAB_Signs, false, false, true);
			return;
		}

		if( !thePlayer.HasStaminaToUseSkill( signSkill ) )
		{
			return;
		}

		if (thePlayer.IsInCombat())
		{
			//thePlayer.GotoState('Combat');

			ACS_ExplorationDelayHack(false, 3);
		}

		thePlayer.RaiseEvent('ACS_TW1AnimsReset');

		SetCastSignProcess(true);

		RemoveTimer('ResetCastSignProcess');
		AddTimer('ResetCastSignProcess', 2 , false);

		if ( FactsQuerySum("ACS_Wisp_Attack_Enable") <= 0 )
		{
			RemoveTimer('TurnOffWispAttack');
			AddTimer('TurnOffWispAttack', 7 , false);
			FactsAdd("ACS_Wisp_Attack_Enable", 1, -1);
		}

		if ( thePlayer.inv.IsItemCrossbow( thePlayer.inv.GetItemFromSlot( 'l_weapon' ) ) )
		{
			thePlayer.OnRangedForceHolster(false, true, false);
		}

		if (!thePlayer.HasTag('ACS_Player_Casted_Sign'))
		{
			thePlayer.AddTag('ACS_Player_Casted_Sign');
		}

		RemoveTimer('Player_Casted_Sign_Reset');
		AddTimer('Player_Casted_Sign_Reset', ACS_Settings_Main_Float('acs_hud_settings_main','acs_hud_elements_despawn_delay', 7) , false);

		//thePlayer.SetCombatIdleStance(1);

		switch(signType)
		{
			case ST_Yrden:
				thePlayer.RaiseEvent( 'ACS_CastYrdenIdleFast' );

				//thePlayer.RaiseEvent( 'ACS_CastYrdenIdle' );

				RemoveTimer('YrdenHeldDownCheck');
				AddTimer('YrdenHeldDownCheck', 0.375 , false);
			break;

			case ST_Aard:
				movementAdjustor = thePlayer.GetMovingAgentComponent().GetMovementAdjustor();
				movementAdjustor.CancelAll();

				ticket_rotate = movementAdjustor.GetRequest( 'ACSMovAdj');
				movementAdjustor.CancelByName( 'ACSMovAdj' );
				
				ticket_rotate = movementAdjustor.CreateNewRequest( 'ACSMovAdj');
				movementAdjustor.MaxRotationAdjustmentSpeed( ticket_rotate, 5000000 );
				movementAdjustor.MaxLocationAdjustmentSpeed( ticket_rotate, 5000000 );
				movementAdjustor.AdjustmentDuration( ticket_rotate, 0.125 );

				if (thePlayer.GetTarget())
				{
					movementAdjustor.RotateTowards( ticket_rotate, thePlayer.GetTarget() );
				}
				thePlayer.RaiseEvent( 'ACS_CastAardIdleFast' );

				RemoveTimer('AardHeldDownCheck');
				AddTimer('AardHeldDownCheck', 0.375 , false);
			break;

			case ST_Igni:
				movementAdjustor = thePlayer.GetMovingAgentComponent().GetMovementAdjustor();
				movementAdjustor.CancelAll();

				ticket_rotate = movementAdjustor.GetRequest( 'ACSMovAdj');
				movementAdjustor.CancelByName( 'ACSMovAdj' );
				
				ticket_rotate = movementAdjustor.CreateNewRequest( 'ACSMovAdj');
				movementAdjustor.MaxRotationAdjustmentSpeed( ticket_rotate, 5000000 );
				movementAdjustor.MaxLocationAdjustmentSpeed( ticket_rotate, 5000000 );
				movementAdjustor.AdjustmentDuration( ticket_rotate, 0.125 );

				if (thePlayer.GetTarget())
				{
					movementAdjustor.RotateTowards( ticket_rotate, thePlayer.GetTarget() );
				}
				thePlayer.RaiseEvent( 'ACS_CastIgniIdleFast' );

				RemoveTimer('IgniHeldDownCheck');
				AddTimer('IgniHeldDownCheck', 0.375 , false);
			break;

			case ST_Quen:
				if (ACS_Armor_Set_Check('acs_armor', false))
				{
					thePlayer.SoundEvent("magic_eredin_appear_disappear");
					thePlayer.PlayEffectSingle('eredin_disappear');
					thePlayer.StopEffect('eredin_disappear');
				}

				RemoveTimer('QuenHeldDownCheck');

				thePlayer.RaiseEvent( 'ACS_CastQuenIdleFast' );

				AddTimer('QuenHeldDownCheck', 0.375 , false);
				
			break;

			default:

			break;
		}

		
	}

	public timer function YrdenHeldDownCheck(deltaTime : float , id : int)
	{
		if (GetWitcherPlayer().GetEquippedSign() != ST_Yrden)
		{
			GetWitcherPlayer().SetEquippedSign(ST_Yrden);
		}

		if(!theInput.LastUsedPCInput())
		{
			if(theGame.GetInGameConfigWrapper().GetVarValue('Gameplay', 'EnableAlternateSignCasting') == "1")
			{
				if (theInput.IsActionPressed('AttackHeavy'))
				{
					vACS_Setup_Combat_Action_Vanilla = new cACS_Setup_Combat_Action_Vanilla in this;

					vACS_Setup_Combat_Action_Vanilla.Setup_Combat_Action_CastSign_Engage();
				}
				else
				{
					ACS_Yrden();
				}
			}
			else
			{
				if (theInput.IsActionPressed('CastSign')
				|| theInput.IsActionPressed('SelectYrden')
				)
				{
					vACS_Setup_Combat_Action_Vanilla = new cACS_Setup_Combat_Action_Vanilla in this;

					vACS_Setup_Combat_Action_Vanilla.Setup_Combat_Action_CastSign_Engage();
				}
				else
				{
					ACS_Yrden();
				}
			}
		}
		else
		{
			if (theInput.IsActionPressed('CastSign')
			|| theInput.IsActionPressed('SelectYrden')
			)
			{
				vACS_Setup_Combat_Action_Vanilla = new cACS_Setup_Combat_Action_Vanilla in this;

				vACS_Setup_Combat_Action_Vanilla.Setup_Combat_Action_CastSign_Engage();
			}
			else
			{
				ACS_Yrden();
			}
		}
	}
	

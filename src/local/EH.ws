		GetWitcherPlayer().DrainVitality( thePlayer.GetStat( BCS_Vitality ) * 0.25 );

		movementAdjustorPlayer = GetWitcherPlayer().GetMovingAgentComponent().GetMovementAdjustor();

		thePlayer.SetImmortalityMode( AIM_Invulnerable, AIC_Default, true ); 

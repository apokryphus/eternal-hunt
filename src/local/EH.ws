			ACSTransformationGiantPlayAnim( 'giant_combat_anchor_attack_far_r_acs_ice_giant', 0.25f, 0.325f);
			break;

			case 14:
			TransformationGiantAnchorSwitch(true, false, 0.1);
			ACSTransformationGiantPlayAnim( 'giant_combat_anchor_attack_far_l_acs_ice_giant', 0.25f, 0.325f);
			break;

			case 13:
			TransformationGiantAnchorSwitch(true, false, 0.1);
			ACSTransformationGiantPlayAnim( 'giant_combat_anchor_attack_far_bl_acs_ice_giant', 0.25f, 0.325f);
			break;


		ACS_Oneliner(
		(new ACS_Oneliner_TagBuilder in theGame)
		.tag("font")
		.attr("size", "20")
		.attr("color", "#ffffff")
		.text(GetLocStringById(player_line_number))
		, player_line_dummycomp, "ACS_PlayerSpeakMessage", Vector(0,0,0.5), 30);

		GetACSStorage().acs_setScaleForOnelinerByTag("ACS_PlayerSpeakMessage", 100, 100, 100);

		GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_PlayerSpeakMessage", 100);

		RemoveTimer('PlayerSpeakMessageRemove');
		AddTimer('PlayerSpeakMessageRemove', 0.0001, true);
	}

	timer function PlayerSpeakMessageRemove( dt : float, id : int )
	{
		if (!thePlayer.IsSpeaking(player_line_number))
		{
			thePlayer.EndLine();

			player_line_dummycomp.Destroy();

			GetACSStorage().acs_deleteOnelinerByTag("ACS_PlayerSpeakMessage");

			if (!thePlayer.IsSpeaking(player_line_number))
			{
				if (player_line_number == 1170592)
				{
					HorseSpeakController('what_the_fuck', true);

					player_line_number = 0;
				}
				else if (player_line_number == 1170608)
				{
					HorseSpeakController('dont_recall', true);
				}
				else if (player_line_number == 1117442)
				{
					HorseSpeakController('youre_my_human', true);
				}
				else if (player_line_number == 1142909)
				{
					HorseSpeakController('everyones_got_limits', true);

					player_line_number = 0;
				}

				if (player_line_number == 1170588
				|| player_line_number == 1170622
				|| player_line_number == 1170594
				)
				{
					horse_convo_lock = false;
				}
			}

			RemoveTimer('PlayerSpeakMessageRemove');
		}
	}



	///////////////////////////////////////////////////////////////////////

	timer function HorseRidingAard360DealDamage( dt : float, id : int )
	{
		var actors    							: array<CActor>;
		var i         							: int;
		var actortarget							: CActor;
		var dmg									: W3DamageAction;
		var damageMax, range					: float;
		var sp 									: SAbilityAttributeValue;
		var witcher 							: W3PlayerWitcher;
		var component 							: CInteractionComponent;
		var ent                  				: CEntity;
		var ent_1, ent_2, ent_3, ent_4 			: CEntity;
		var bone_vec, attach_vec, pPos			: Vector;
		var bone_rot, attach_rot				: EulerAngles;

		thePlayer.DrainStamina( ESAT_FixedValue, thePlayer.GetStatMax( BCS_Stamina ), 2 );

		if ((ACS_Armor_Set_Check('forgotten_wolf', false) 
		|| ACS_Armor_Set_Check('acs_armor', false)
		|| ACS_Armor_Set_Check('volhikar', false)
		))
		{
			range = 12;
		}
		else
		{
			range = 8;
		}

		ACSGetCEntity('ACS_Quen_Bubble').Destroy();

		ACSGetCEntity('ACS_Quen_Fx').Destroy();

		ACSGetCEntity('ACS_Sign_Icon').Destroy();

		ACSGetCEntity('ACS_Sign_Icon_Anchor').Destroy();

		ent_1 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
		"dlc\dlc_acs\data\fx\sign_icons.w2ent"
		, true ), GetWitcherPlayer().GetWorldPosition(), GetWitcherPlayer().GetWorldRotation() );

		ent_2 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
		"dlc\dlc_acs\data\fx\sign_icons.w2ent"
		, true ), GetWitcherPlayer().GetWorldPosition(), GetWitcherPlayer().GetWorldRotation() );

		GetWitcherPlayer().GetBoneWorldPositionAndRotationByIndex( GetWitcherPlayer().GetBoneIndex( 'l_handRoll' ), bone_vec, bone_rot );

		attach_rot.Roll = 0;
		attach_rot.Pitch = 0;
		attach_rot.Yaw = 0;
		attach_vec.X = 0.4;
		attach_vec.Y = 0;
		attach_vec.Z = -0.025;

		ent_1.CreateAttachmentAtBoneWS( GetWitcherPlayer(), 'l_handRoll', bone_vec, bone_rot );

		ent_2.CreateAttachment( ent_1, , attach_vec, attach_rot );
		
		if (ACS_Armor_Set_Check('forgotten_wolf', false) 
		|| ACS_Armor_Set_Check('acs_armor', false)
		|| ACS_Armor_Set_Check('volhikar', false)
		|| thePlayer.HasTag('acs_vampire_claws_equipped')
		|| ACS_Vampire_Claws_Access()
		)
		{
			ent_2.PlayEffectSingle('aard_icon_red');
		}
		else
		{
			ent_2.PlayEffectSingle('aard_icon');
		}

		ent_2.PlayEffectSingle('critical_aard');

		ent_1.DestroyAfter(0.5);
		ent_2.DestroyAfter(0.5);

		ent_1.AddTag('ACS_Sign_Icon_Anchor');

		ent_2.AddTag('ACS_Sign_Icon');
	
		actors.Clear();

		actors = thePlayer.GetNPCsAndPlayersInCone(range, VecHeading(thePlayer.GetHeadingVector()), 360, 50, , FLAG_ExcludePlayer );

		if( actors.Size() > 0 )
		{
			for( i = 0; i < actors.Size(); i += 1 )
			{
				actortarget = (CActor)actors[i];

				if (actortarget.IsAlive() && actortarget.GetAttitude( thePlayer ) == AIA_Hostile )
				{
					dmg = new W3DamageAction in theGame.damageMgr;
					
					dmg.Initialize(thePlayer, actortarget, thePlayer, thePlayer.GetName(), EHRT_Heavy, CPS_Undefined, false, false, true, false);
					
					dmg.SetProcessBuffsIfNoDamage(true);

					damageMax = actortarget.GetMaxHealth() * 0.125;
					
					dmg.SetCanPlayHitParticle(false);
					
					dmg.SetSuppressHitSounds(true);

					dmg.SetHitReactionType( EHRT_Heavy, true);

					dmg.SetHitAnimationPlayType(EAHA_ForceYes);

					dmg.AddDamage( theGame.params.DAMAGE_NAME_PHYSICAL, 50 + damageMax );

					dmg.AddDamage( theGame.params.DAMAGE_NAME_SILVER, 50 + damageMax );

					dmg.AddEffectInfo( EET_Knockdown, 2 );

					

					if(GetWitcherPlayer().IsAnyQuenActive())
					{
						dmg.AddEffectInfo( EET_Paralyzed, 3 );

						dmg.AddDamage( theGame.params.DAMAGE_NAME_SHOCK, damageMax );
					}

					dmg.SetForceExplosionDismemberment();
						
					dmg.SetCriticalHit(); theGame.damageMgr.ProcessAction( dmg );
						
					delete dmg;	
				}
				else
				{
					if (!actortarget.IsAlive() )
					{
						((CNewNPC)actortarget).SetKinematic(false);

						ACSGetCEntityDestroyAll('ACS_Killed_By_Fire_Burning_FX_Ground_Fire');
						
						actortarget.StopEffect('critical_burning');
	
						actortarget.RemoveTag('ACS_Killed_By_Fire');

						((CNewNPC)actortarget).RemoveTimer('ACS_Critical_Burning_Remove_Delay');
						((CNewNPC)actortarget).RemoveTimer('ACS_Critical_Burning_Delay');
					}
				}
			}
		}

		if ((ACS_Armor_Set_Check('forgotten_wolf', false) 
		|| ACS_Armor_Set_Check('acs_armor', false)
		|| ACS_Armor_Set_Check('volhikar', false)
		|| thePlayer.HasTag('acs_vampire_claws_equipped')
		|| ACS_Vampire_Claws_Access())
		&& ACS_Settings_Main_Bool('acs_signs_settings','acs_aard_extra_effects_enabled', true)
		)
		{
			ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

			"dlc\dlc_acs\data\fx\pc_aard.w2ent"

			, true ), (GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetWorldForward() * 2) + Vector(0,0,3.5), GetWitcherPlayer().GetWorldRotation() );
		}
		else
		{
			ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

			"gameplay\templates\signs\pc_aard.w2ent"

			, true ), (GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetWorldForward() * 2) + Vector(0,0,3.5), GetWitcherPlayer().GetWorldRotation() );
		}

		ent.PlayEffectSingle('blast_cutscene');

		ent.PlayEffectSingle('blast');

		ent.PlayEffectSingle('blast_ground');

		ent.PlayEffectSingle('blast_lv0');

		ent.PlayEffectSingle('blast_lv0_power');

		ent.PlayEffectSingle('blast_lv1_power');

		ent.PlayEffectSingle('blast_lv2_power');

		ent.PlayEffectSingle('blast_lv3_power');

		ent.PlayEffectSingle('blast_lv3_damage');

		ent.PlayEffectSingle('blast_lv1');

		ent.PlayEffectSingle('blast_lv2');

		if ((ACS_Armor_Set_Check('forgotten_wolf', false) 
		|| ACS_Armor_Set_Check('acs_armor', false)
		|| ACS_Armor_Set_Check('volhikar', false)
		|| thePlayer.HasTag('acs_vampire_claws_equipped')
		|| ACS_Vampire_Claws_Access())
		&& ACS_Settings_Main_Bool('acs_signs_settings','acs_aard_extra_effects_enabled', true)
		)
		{
			ent.PlayEffectSingle('blast_lv3_red');
		}
		else
		{
			ent.PlayEffectSingle('blast_lv3');
		}

		if(GetWitcherPlayer().IsAnyQuenActive()
		&& ACS_Settings_Main_Bool('acs_signs_settings','acs_quen_extra_effects_enabled', true)
		)
		{
			thePlayer.SoundEvent("magic_sorceress_vfx_hit_electric");
			thePlayer.SoundEvent("magic_sorceress_vfx_lightning_bolt");

			if (ACS_Is_DLC_Installed('dlcquen')
			|| ACS_Armor_Set_Check('acs_armor', false)
			|| ACS_Armor_Set_Check('wh_armor', false)
			|| ACS_Armor_Set_Check('eredin_armor', false)
			|| ACS_Armor_Set_Check('imlerith_armor', false)
			|| ACS_Armor_Set_Check('caranthir_armor', false)
			|| ACS_Armor_Set_Check('vgx_eredin_armor', false)
			)
			{
				ent.PlayEffectSingle('blast_lv2_electric_blue');
				ent.PlayEffectSingle('blast_lv1_electric_blue');
				ent.PlayEffectSingle('blast_lv0_electric_blue');
			}
			else
			{
				ent.PlayEffectSingle('blast_lv2_electric_normal');
				ent.PlayEffectSingle('blast_lv1_electric_normal');
				ent.PlayEffectSingle('blast_lv0_electric_normal');
			}
		}

		ent.DestroyAfter(7);

		if( !(thePlayer.GetHorseCurrentlyMounted()).HasAbility( 'DisableHorsePanic' ) && !thePlayer.HasBuff( EET_Mutagen25 ) )
		{
			thePlayer.GetHorseCurrentlyMounted().AddPanic(30);
		}

		if ((thePlayer.GetHorseCurrentlyMounted()).GetStat( BCS_Panic ) <= 5 )
		{
			HorseSpeakController('sorry');

			(thePlayer.GetHorseCurrentlyMounted().GetHorseComponent()).ShakeOffRider( DT_shakeOff );
		}
		else
		{
			if (RandF() < 0.5)
			{
				HorseSpeakController('hocus_pocus');
			}
		}

		if (FactsQuerySum("ACS_Is_Casting_Horse_Sign") > 0)
		{
			FactsRemove("ACS_Is_Casting_Horse_Sign");
		}

		theGame.GetBehTreeReactionManager().CreateReactionEventIfPossible( thePlayer, 'CastSignAction', -1, 20.0f, -1.f, -1, true );
	}

	timer function HorseRidingIgni360DealDamage( dt : float, id : int )
	{
		var actors    							: array<CActor>;
		var i         							: int;
		var actortarget							: CActor;
		var dmg									: W3DamageAction;
		var damageMax, range					: float;
		var sp 									: SAbilityAttributeValue;
		var witcher 							: W3PlayerWitcher;
		var component 							: CInteractionComponent;
		var ent                  				: CEntity;
		var ent_1, ent_2, ent_3, ent_4 			: CEntity;
		var bone_vec, attach_vec, pPos			: Vector;
		var bone_rot, attach_rot				: EulerAngles;
		var template 							: CEntityTemplate;
		var ent_wide1, ent_wide2, ent_wide3     : CEntity;

		if ((ACS_Armor_Set_Check('forgotten_wolf', false) 
		|| ACS_Armor_Set_Check('acs_armor', false)
		|| ACS_Armor_Set_Check('volhikar', false)
		))
		{
			thePlayer.DrainStamina( ESAT_FixedValue, thePlayer.GetStatMax( BCS_Stamina ), 2 );

			range = 12;
		}
		else
		{
			thePlayer.DrainStamina( ESAT_FixedValue, thePlayer.GetStatMax( BCS_Stamina ), 2 );

			range = 8;
		}

		ACSGetCEntity('ACS_Quen_Bubble').Destroy();

		ACSGetCEntity('ACS_Quen_Fx').Destroy();

		ACSGetCEntity('ACS_Sign_Icon').Destroy();

		ACSGetCEntity('ACS_Sign_Icon_Anchor').Destroy();

		ent_1 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
		"dlc\dlc_acs\data\fx\sign_icons.w2ent"
		, true ), GetWitcherPlayer().GetWorldPosition(), GetWitcherPlayer().GetWorldRotation() );

		ent_2 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
		"dlc\dlc_acs\data\fx\sign_icons.w2ent"
		, true ), GetWitcherPlayer().GetWorldPosition(), GetWitcherPlayer().GetWorldRotation() );

		GetWitcherPlayer().GetBoneWorldPositionAndRotationByIndex( GetWitcherPlayer().GetBoneIndex( 'l_handRoll' ), bone_vec, bone_rot );

		attach_rot.Roll = 0;
		attach_rot.Pitch = 0;
		attach_rot.Yaw = 0;
		attach_vec.X = 0.4;
		attach_vec.Y = 0;
		attach_vec.Z = -0.025;

		ent_1.CreateAttachmentAtBoneWS( GetWitcherPlayer(), 'l_handRoll', bone_vec, bone_rot );

		ent_2.CreateAttachment( ent_1, , attach_vec, attach_rot );
		
		if (ACS_Armor_Set_Check('forgotten_wolf', false) 
		|| ACS_Armor_Set_Check('acs_armor', false)
		|| ACS_Armor_Set_Check('volhikar', false)
		|| thePlayer.HasTag('acs_vampire_claws_equipped')
		|| ACS_Vampire_Claws_Access()
		)
		{
			ent_2.PlayEffectSingle('igni_icon_red');
		}
		else
		{
			ent_2.PlayEffectSingle('igni_icon');
		}

		ent_2.PlayEffectSingle('critical_igni');

		ent_1.DestroyAfter(0.5);
		ent_2.DestroyAfter(0.5);

		ent_1.AddTag('ACS_Sign_Icon_Anchor');

		ent_2.AddTag('ACS_Sign_Icon');
	
		actors.Clear();

		actors = thePlayer.GetNPCsAndPlayersInCone(range, VecHeading(thePlayer.GetHeadingVector()), 360, 50, , FLAG_ExcludePlayer );

		if( actors.Size() > 0 )
		{
			for( i = 0; i < actors.Size(); i += 1 )
			{
				actortarget = (CActor)actors[i];

				if (actortarget.IsAlive() && actortarget.GetAttitude( thePlayer ) == AIA_Hostile )
				{
					dmg = new W3DamageAction in theGame.damageMgr;
					
					dmg.Initialize(thePlayer, actortarget, thePlayer, thePlayer.GetName(), EHRT_Heavy, CPS_Undefined, false, false, true, false);
					
					dmg.SetProcessBuffsIfNoDamage(true);

					damageMax = actortarget.GetMaxHealth() * 0.125;
					
					dmg.SetCanPlayHitParticle(false);
					
					dmg.SetSuppressHitSounds(true);

					dmg.SetHitReactionType( EHRT_Heavy, true);

					dmg.SetHitAnimationPlayType(EAHA_ForceYes);

					dmg.AddDamage( theGame.params.DAMAGE_NAME_PHYSICAL, 50 + damageMax );

					dmg.AddDamage( theGame.params.DAMAGE_NAME_SILVER, 50 + damageMax );

					dmg.AddEffectInfo( EET_Burning, 3 );

					if(GetWitcherPlayer().IsAnyQuenActive())
					{
						dmg.AddEffectInfo( EET_Paralyzed, 3 );

						dmg.AddDamage( theGame.params.DAMAGE_NAME_SHOCK, 50 + damageMax );
					}

					

					dmg.SetForceExplosionDismemberment();
						
					dmg.SetCriticalHit(); theGame.damageMgr.ProcessAction( dmg );
						
					delete dmg;	
				}
				else
				{
					if (!actortarget.IsAlive() )
					{
						((CNewNPC)actortarget).SetKinematic(false);

						ACSGetCEntityDestroyAll('ACS_Killed_By_Fire_Burning_FX_Ground_Fire');
						
						actortarget.StopEffect('critical_burning');
	
						actortarget.RemoveTag('ACS_Killed_By_Fire');

						((CNewNPC)actortarget).RemoveTimer('ACS_Critical_Burning_Remove_Delay');
						((CNewNPC)actortarget).RemoveTimer('ACS_Critical_Burning_Delay');
					}
				}
			}
		}

		
		ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

		"dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent"

		, true ), GetWitcherPlayer().GetWorldPosition(), GetWitcherPlayer().GetWorldRotation() );

		ent.CreateAttachment( thePlayer, , Vector( 0, 1, 4 ), EulerAngles(0,0,0) );

		ent.PlayEffectSingle('cone_fire_ACS');

		ent.DestroyAfter(3);
		

		template = (CEntityTemplate)LoadResource("dlc\dlc_acs\data\fx\pc_igni_mq1060.w2ent", true);

		ent_wide1 = theGame.CreateEntity( template, thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );

		ent_wide1.CreateAttachment( thePlayer, , Vector( 0, 1, 3 ), EulerAngles(0,30,0) );

		ent_wide2 = theGame.CreateEntity( template, thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );

		ent_wide2.CreateAttachment( thePlayer, , Vector( 0, 1, 3 ), EulerAngles(0,150,0) );

		ent_wide3 = theGame.CreateEntity( template, thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );

		ent_wide3.CreateAttachment( thePlayer, , Vector( 0, 1, 3 ), EulerAngles(0,0,0) );

		if ((ACS_Armor_Set_Check('forgotten_wolf', false) 
		|| ACS_Armor_Set_Check('acs_armor', false)
		|| ACS_Armor_Set_Check('volhikar', false)
		|| thePlayer.HasTag('acs_vampire_claws_equipped')
		|| ACS_Vampire_Claws_Access()
		))
		{
			ent_wide1.PlayEffectSingle('cone_1_red');
			ent_wide1.PlayEffectSingle('cone_2_red');
			ent_wide1.PlayEffectSingle('cone_melt_1_red');
			ent_wide1.PlayEffectSingle('cone_melt_2_red');
			ent_wide1.PlayEffectSingle('cone_power_2_red');
			ent_wide1.PlayEffectSingle('cone_superpower_1_red');

			ent_wide2.PlayEffectSingle('cone_1_red');
			ent_wide2.PlayEffectSingle('cone_2_red');
			ent_wide2.PlayEffectSingle('cone_melt_1_red');
			ent_wide2.PlayEffectSingle('cone_melt_2_red');
			ent_wide2.PlayEffectSingle('cone_power_2_red');
			ent_wide2.PlayEffectSingle('cone_superpower_1_red');
		}
		else
		{
			ent_wide1.PlayEffectSingle('cone_1');
			ent_wide1.PlayEffectSingle('cone_2');
			ent_wide1.PlayEffectSingle('cone_melt_1');
			ent_wide1.PlayEffectSingle('cone_melt_2');
			ent_wide1.PlayEffectSingle('cone_power_2');
			ent_wide1.PlayEffectSingle('cone_superpower_1');

			ent_wide2.PlayEffectSingle('cone_1');
			ent_wide2.PlayEffectSingle('cone_2');
			ent_wide2.PlayEffectSingle('cone_melt_1');
			ent_wide2.PlayEffectSingle('cone_melt_2');
			ent_wide2.PlayEffectSingle('cone_power_2');
			ent_wide2.PlayEffectSingle('cone_superpower_1');
		}

		if 
		(
			GetWitcherPlayer().IsAnyQuenActive()
			&& ACS_Settings_Main_Bool('acs_signs_settings','acs_quen_extra_effects_enabled', true)
		)
		{
			thePlayer.SoundEvent("magic_sorceress_vfx_hit_electric");
			thePlayer.SoundEvent("magic_sorceress_vfx_lightning_bolt");

			if (ACS_Is_DLC_Installed('dlcquen')
			|| ACS_Armor_Set_Check('acs_armor', false)
			|| ACS_Armor_Set_Check('wh_armor', false)
			|| ACS_Armor_Set_Check('eredin_armor', false)
			|| ACS_Armor_Set_Check('imlerith_armor', false)
			|| ACS_Armor_Set_Check('caranthir_armor', false)
			|| ACS_Armor_Set_Check('vgx_eredin_armor', false)
			)
			{
				ent_wide1.PlayEffectSingle('electric_fire_cone_blue');
				ent_wide2.PlayEffectSingle('electric_fire_cone_blue');
				ent_wide3.PlayEffectSingle('electric_fire_cone_blue');
			}
			else
			{
				ent_wide1.PlayEffectSingle('electric_fire_cone_normal');
				ent_wide2.PlayEffectSingle('electric_fire_cone_normal');
				ent_wide3.PlayEffectSingle('electric_fire_cone_normal');
			}
		}

		ent_wide1.DestroyAfter(3);

		ent_wide2.DestroyAfter(3);

		ent_wide3.DestroyAfter(3);

		if( !(thePlayer.GetHorseCurrentlyMounted()).HasAbility( 'DisableHorsePanic' ) && !thePlayer.HasBuff( EET_Mutagen25 ) )
		{
			thePlayer.GetHorseCurrentlyMounted().AddPanic(30);
		}

		if ((thePlayer.GetHorseCurrentlyMounted()).GetStat( BCS_Panic ) <= 5 )
		{
			HorseSpeakController('sorry');

			(thePlayer.GetHorseCurrentlyMounted().GetHorseComponent()).ShakeOffRider( DT_shakeOff );
		}
		else
		{
			if (RandF() < 0.5)
			{
				HorseSpeakController('hocus_pocus');
			}
		}

		if (FactsQuerySum("ACS_Is_Casting_Horse_Sign") > 0)
		{
			FactsRemove("ACS_Is_Casting_Horse_Sign");
		}

		theGame.GetBehTreeReactionManager().CreateReactionEventIfPossible( thePlayer, 'CastSignAction', -1, 20.0f, -1.f, -1, true );
	}

	timer function HorseRidingQuen( dt : float, id : int )
	{
		var player							: CR4Player;
		var ent, ent_2, ent_3, ent_4 		: CEntity;
		var bone_vec, attach_vec, pPos		: Vector;
		var bone_rot, attach_rot			: EulerAngles;

		thePlayer.DrainStamina( ESAT_FixedValue, thePlayer.GetStatMax( BCS_Stamina ), 2 );

		ACSGetCEntity('ACS_Quen_Bubble').Destroy();
		
		ACSGetCEntity('ACS_Quen_Fx').Destroy();

		ACSGetCEntity('ACS_Sign_Icon').Destroy();

		ACSGetCEntity('ACS_Sign_Icon_Anchor').Destroy();

		ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
		"dlc\dlc_acs\data\fx\sign_icons.w2ent"
		, true ), GetWitcherPlayer().GetWorldPosition(), GetWitcherPlayer().GetWorldRotation() );

		ent_2 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
		"dlc\dlc_acs\data\fx\sign_icons.w2ent"
		, true ), GetWitcherPlayer().GetWorldPosition(), GetWitcherPlayer().GetWorldRotation() );

		GetWitcherPlayer().GetBoneWorldPositionAndRotationByIndex( GetWitcherPlayer().GetBoneIndex( 'l_handRoll' ), bone_vec, bone_rot );

		attach_rot.Roll = 0;
		attach_rot.Pitch = 0;
		attach_rot.Yaw = 0;
		attach_vec.X = 0.35;
		attach_vec.Y = 0.125;
		attach_vec.Z = 0;

		ent.CreateAttachmentAtBoneWS( GetWitcherPlayer(), 'l_handRoll', bone_vec, bone_rot );

		ent_2.CreateAttachment( ent, , attach_vec, attach_rot );

		if ((ACS_Armor_Set_Check('forgotten_wolf', false) 
		|| ACS_Armor_Set_Check('acs_armor', false)
		|| ACS_Armor_Set_Check('volhikar', false)
		|| thePlayer.HasTag('acs_vampire_claws_equipped')
		|| ACS_Vampire_Claws_Access())
		&& ACS_Settings_Main_Bool('acs_signs_settings','acs_quen_extra_effects_enabled', true)
		)
		{
			ent_2.PlayEffectSingle('quen_icon_red');

			ent_3 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
			"dlc\dlc_acs\data\fx\pc_quen_mq1060.w2ent"
			, true ), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );

			ent_3.CreateAttachment( thePlayer, , Vector( 0, 0, 0.75 ), EulerAngles(0,0,0) );

			ent_3.PlayEffect('default_fx');
			ent_3.DestroyAfter(0.5);


			ent_4 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
			"dlc\dlc_acs\data\fx\pc_quen_hit_mq1060.w2ent"
			, true ), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );

			ent_4.CreateAttachment( thePlayer, , Vector( 0, 0, 0.75 ), EulerAngles(0,0,0) );

			ent_4.PlayEffect('discharge');
			ent_4.DestroyAfter(3);
		}
		else
		{
			if (ACS_Settings_Main_Bool('acs_signs_settings','acs_enhanced_quen_enabled', true))
			{
				if (ACS_Is_DLC_Installed('dlcquen')
				|| ACS_Armor_Set_Check('acs_armor', false)
				|| ACS_Armor_Set_Check('wh_armor', false)
				|| ACS_Armor_Set_Check('eredin_armor', false)
				|| ACS_Armor_Set_Check('imlerith_armor', false)
				|| ACS_Armor_Set_Check('caranthir_armor', false)
				|| ACS_Armor_Set_Check('vgx_eredin_armor', false)
				)
				{
					ent_2.PlayEffectSingle('quen_icon_blue');

					ent_2.PlayEffectSingle('critical_aard');
				}
				else
				{
					ent_2.PlayEffectSingle('quen_icon');

					ent_2.PlayEffectSingle('critical_quen');
				}
			}
		}

		ent.DestroyAfter(0.5);
		ent_2.DestroyAfter(0.5);

		ACS_Quen();

		if( !(thePlayer.GetHorseCurrentlyMounted()).HasAbility( 'DisableHorsePanic' ) && !thePlayer.HasBuff( EET_Mutagen25 ) )
		{
			thePlayer.GetHorseCurrentlyMounted().AddPanic(30);
		}

		if ((thePlayer.GetHorseCurrentlyMounted()).GetStat( BCS_Panic ) <= 5 )
		{
			HorseSpeakController('sorry');

			(thePlayer.GetHorseCurrentlyMounted().GetHorseComponent()).ShakeOffRider( DT_shakeOff );
		}
		else
		{
			if (RandF() < 0.5)
			{
				HorseSpeakController('hocus_pocus');
			}
		}

		if (FactsQuerySum("ACS_Is_Casting_Horse_Sign") > 0)
		{
			FactsRemove("ACS_Is_Casting_Horse_Sign");
		}

		theGame.GetBehTreeReactionManager().CreateReactionEventIfPossible( thePlayer, 'CastSignAction', -1, 20.0f, -1.f, -1, true );
	}

	///////////////////////////////////////////////////////////////////////

	var last_fog_ent_spawn_time							: float;

	var vACS_Fog_Generate : cACS_Fog_Generate;

	function ACS_Fog_Generate()
	{
		var currentHour: int;

		vACS_Fog_Generate = new cACS_Fog_Generate in this;

		currentHour = GameTimeHours(theGame.GetGameTime());
		
		if ((
		GetWeatherConditionName() != 'WT_Rain_Heavy' 
		&& GetWeatherConditionName() != 'WT_Rain_Dark' 
		&& GetWeatherConditionName() != 'WT_Rain_Storm' 
		&& ACS_Settings_Main_Bool('acs_world_visual_settings','acs_fog_spawn_enabled', true)
		)
		&& !thePlayer.IsInInterior()
		&& (currentHour > 16 || currentHour < 11)
		&& theGame.GetWorld().GetDepotPath() != "dlc\bob\data\levels\bob\bob.w2w"
		)
		{
			if ((theGame.GetEngineTimeAsSeconds() - last_fog_ent_spawn_time > 10)
			&& !thePlayer.IsInCombat() 
			&& !thePlayer.IsThreatened())
			{
				last_fog_ent_spawn_time = theGame.GetEngineTimeAsSeconds();

				vACS_Fog_Generate.Fog_Generate_Engage();
			}
		}
		else
		{
			ACSGetCEntityDestroyAll('ACS_Fog_Ent');
		}
	}

	///////////////////////////////////////////////////////////////////////

	var last_bubble_ent_spawn_time							: float;

	var vACS_Bubbles_Generate : cACS_Bubbles_Generate;

	function ACS_Bubbles_Generate()
	{
		var waterDepth 																																					: float;
		var mac																																							: CMovingPhysicalAgentComponent;

		if (
		thePlayer.IsDiving()
		)
		{
			mac = ((CMovingPhysicalAgentComponent)(thePlayer).GetMovingAgentComponent());

			waterDepth = mac.GetSubmergeDepth();
		
			if (
			thePlayer.IsDiving()
			&& waterDepth <= -3
			)
			{
				if (theGame.GetEngineTimeAsSeconds() - last_bubble_ent_spawn_time > 10)
				{
					last_bubble_ent_spawn_time = theGame.GetEngineTimeAsSeconds();

					vACS_Bubbles_Generate = new cACS_Bubbles_Generate in this;

					vACS_Bubbles_Generate.Bubbles_Generate_Engage();
				}
			}
		}
		else
		{
			if(ACSGetCEntity('ACS_UnderWater_Bubbles'))
			{
				ACSGetCEntityDestroyAll('ACS_UnderWater_Bubbles');
			}
		}
	}

	var horseSpeed : float;

	default horseSpeed = 0;

	var horseAnimSpeed : float;

	default horseAnimSpeed = 1;

	var hLean, hRotation : EulerAngles;

	var horseMotionLeaningActive, horseMotionLeaningActiveReset, horseInFastSprint, horseInFastSprintAnim : bool;

	timer function ResetHorseInFastSprintAnim(deltaTime : float , id : int)
	{
		horseInFastSprintAnim = false;
	}


	function ResetHorseMotionLeaningExternal()
	{
		hLean.Roll = 0;

		((CMovingPhysicalAgentComponent)((thePlayer.GetHorseCurrentlyMounted()).GetMovingAgentComponent())).SetRotation(hLean);

		((CMovingPhysicalAgentComponent)(thePlayer.GetMovingAgentComponent())).SetRotation(hLean);
	}

	var controllerVibrateOn : bool;

	var controllerLastVibrationTime : float;

	var controllerCooldown : float;

	private				var m_SlideNormalV				: Vector;
	private				var m_SlideNormalRealV			: Vector; 
	private				var m_SlideDirV					: Vector;
	private				var m_SlideRealangleF			: float;
	private 			var slidingDirDot				: float;
	private 			var slidingDirRightDot			: float;
	private				var m_SlideComputedThisFrameB	: bool;

	private function HorseComputeTerrainPitch() : float
	{	
		m_SlideNormalV		= ((CMovingPhysicalAgentComponent)(((thePlayer.GetHorseCurrentlyMounted()).GetMovingAgentComponent()))).GetTerrainNormal( true ); 
		m_SlideNormalRealV	= ((CMovingPhysicalAgentComponent)(((thePlayer.GetHorseCurrentlyMounted()).GetMovingAgentComponent()))).GetTerrainNormal( false ); 
		
		m_SlideDirV	= VecCross( m_SlideNormalV, Vector( 0, 0, 1 ) );
		m_SlideDirV	= VecCross( m_SlideNormalV, m_SlideDirV );
		
		m_SlideRealangleF	=	ComputeRealSlideCoefFromNormal( m_SlideNormalRealV.Z );
		m_SlideRealangleF	=	ConvertCoefToAngleDegree( m_SlideRealangleF );

		return m_SlideRealangleF;
	}

	private function HorseSlideForward() : float
	{
		m_SlideNormalV		= ((CMovingPhysicalAgentComponent)(((thePlayer.GetHorseCurrentlyMounted()).GetMovingAgentComponent()))).GetTerrainNormal( true ); 
		m_SlideNormalRealV	= ((CMovingPhysicalAgentComponent)(((thePlayer.GetHorseCurrentlyMounted()).GetMovingAgentComponent()))).GetTerrainNormal( false ); 
		
		m_SlideDirV	= VecCross( m_SlideNormalV, Vector( 0, 0, 1 ) );
		m_SlideDirV	= VecCross( m_SlideNormalV, m_SlideDirV );

		slidingDirDot	= VecDot( m_SlideDirV, (thePlayer.GetHorseCurrentlyMounted()).GetWorldForward() );

		return slidingDirDot;
	}

	private function HorseSlideRight() : float
	{
		m_SlideNormalV		= ((CMovingPhysicalAgentComponent)(((thePlayer.GetHorseCurrentlyMounted()).GetMovingAgentComponent()))).GetTerrainNormal( true ); 
		m_SlideNormalRealV	= ((CMovingPhysicalAgentComponent)(((thePlayer.GetHorseCurrentlyMounted()).GetMovingAgentComponent()))).GetTerrainNormal( false ); 
		
		m_SlideDirV	= VecCross( m_SlideNormalV, Vector( 0, 0, 1 ) );
		m_SlideDirV	= VecCross( m_SlideNormalV, m_SlideDirV );

		slidingDirRightDot	= VecDot( m_SlideDirV, (thePlayer.GetHorseCurrentlyMounted()).GetWorldRight() );

		return slidingDirRightDot;
	}

	private function ComputeRealSlideCoefFromNormal( normalZ : float ) : float
	{	
		var	coef : float;
		
		coef = AcosF( normalZ ) * 2.0f / Pi();
		
		return coef;
	}

	private function ConvertCoefToAngleDegree( coef : float ) : float
	{
		coef	 *= 90.0f;
		
		return coef;
	}

	var injured_horse_riding_anim : bool;

	var horse_mounted_check : bool;

	var horse_gallop_speak_cooldown, horse_canter_speak_cooldown, horse_jump_speak_cooldown : float;

	var horse_combat_spoke					: bool;

	function IncreaseHorseSpeed()
	{
		var horseMovementAdjust											: CMovementAdjustor;
		var horseTicket													: SMovementAdjustmentRequestTicket;
		var dest1 														: Vector;
		var waterDepth													: float;
		var mac															: CMovingPhysicalAgentComponent;
		var horseAnimatedComponent 										: CAnimatedComponent;
		var cam_direction, lean_roll_modifier 							: float;
		var playerState 												: name;
		var velocity, lowfreq, highfreq									: float;
		var boneNames													: array<CName>;
		var boneIndex, i												: int;
		var boneRotation												: EulerAngles;
		var bonePosition												: Vector;
		var trail_ent                  									: CEntity;
		var horse_heading_dir_match										: bool;

		if( 
		theGame.IsDialogOrCutscenePlaying() 
		|| !thePlayer.IsAlive()
		|| thePlayer.IsInCutsceneIntro()
		|| theGame.HasBlackscreenRequested()
		|| theGame.IsCurrentlyPlayingNonGameplayScene()
		|| theGame.GetGuiManager().IsAnyMenu()
		|| theGame.GetTutorialSystem().HasActiveTutorial()
		|| theGame.GetPhotomodeEnabled() 
		)
		{
			if (injured_horse_riding_anim)
			{
				thePlayer.RaiseEvent('ACS_InjuredExtrasAdditiveEnd');

				injured_horse_riding_anim = false;
			}

			if (horse_mounted_check)
			{
				if (!thePlayer.IsUsingHorse()&& !thePlayer.IsUsingVehicle()){thePlayer.EnableCharacterCollisions(true); }
				
				horse_mounted_check = false;
			}


			if (horseMotionLeaningActive
			)
			{
				hLean.Roll = 0;

				((CMovingPhysicalAgentComponent)((thePlayer.GetHorseCurrentlyMounted()).GetMovingAgentComponent())).SetRotation(hLean);

				((CMovingPhysicalAgentComponent)(thePlayer.GetMovingAgentComponent())).SetRotation(hLean);

				horseMotionLeaningActive = false;
			}

			if (horseMotionLeaningActiveReset)
			{
				horseMotionLeaningActiveReset = false;
			}

			if (horseInFastSprint)
			{
				ACSGetCEntityDestroyAll('ACS_Player_Fast_Sprint_Trail');

				ACSGetCEntityDestroyAll('ACS_Horse_Fast_Sprint_Trail');

				horseInFastSprint = false;
			}

			if (horseInFastSprintAnim)
			{
				RemoveTimer('ResetHorseInFastSprintAnim');

				horseInFastSprintAnim = false;
			}

			if (horseSpeed != 0)
			{
				horseSpeed = 0;
			}

			if (horseAnimSpeed != 1)
			{
				horseAnimSpeed = 1;
			}

			thePlayer.GetHorseCurrentlyMounted().ACS_ClearAnimationSpeedMultipliers();

			return;
		}

		if(FactsQuerySum("ACS_Mount_Active") > 0
		|| FactsQuerySum("ACS_Mounted_Attack_Attachment_Active") > 0
		|| !thePlayer.IsUsingHorse()
		|| !(thePlayer.GetHorseCurrentlyMounted().GetHorseComponent()).IsFullyMounted()
		|| thePlayer.GetHorseCurrentlyMounted().HasTag('ACS_Horse_Is_Swimming')
		)
		{
			if (horseMotionLeaningActive
			)
			{
				hLean.Roll = 0;

				((CMovingPhysicalAgentComponent)((thePlayer.GetHorseCurrentlyMounted()).GetMovingAgentComponent())).SetRotation(hLean);

				((CMovingPhysicalAgentComponent)(thePlayer.GetMovingAgentComponent())).SetRotation(hLean);

				horseMotionLeaningActive = false;
			}

			if (horseMotionLeaningActiveReset)
			{
				horseMotionLeaningActiveReset = false;
			}

			if (horseInFastSprint)
			{
				ACSGetCEntityDestroyAll('ACS_Player_Fast_Sprint_Trail');

				ACSGetCEntityDestroyAll('ACS_Horse_Fast_Sprint_Trail');

				horseInFastSprint = false;
			}

			if (horseInFastSprintAnim)
			{
				RemoveTimer('ResetHorseInFastSprintAnim');

				horseInFastSprintAnim = false;
			}

			if (horseSpeed != 0)
			{
				horseSpeed = 0;
			}

			if (horseAnimSpeed != 1)
			{
				horseAnimSpeed = 1;
			}

			thePlayer.GetHorseCurrentlyMounted().ACS_ClearAnimationSpeedMultipliers();

			return;
		}

		if(FactsQuerySum("ACS_Mount_Active") > 0
		|| FactsQuerySum("ACS_Mounted_Attack_Attachment_Active") > 0
		|| !thePlayer.IsUsingHorse()
		|| !(thePlayer.GetHorseCurrentlyMounted().GetHorseComponent()).IsFullyMounted()
		)
		{
			if (injured_horse_riding_anim)
			{
				thePlayer.RaiseEvent('ACS_InjuredExtrasAdditiveEnd');

				injured_horse_riding_anim = false;
			}
		}

		if (thePlayer.GetHorseCurrentlyMounted())
		{
			ACS_Tutorial_Display_Check('ACS_Horse_Controls_Tutorial_Shown');

			(thePlayer.GetMovingAgentComponent().GetMovementAdjustor()).CancelAll();

			if (!horse_mounted_check)
			{
				thePlayer.EnableCharacterCollisions(false);
				
				horse_mounted_check = true;
			}

			horseAnimatedComponent = (CAnimatedComponent)(thePlayer.GetHorseCurrentlyMounted()).GetComponentByClassName( 'CAnimatedComponent' );	

			horseMovementAdjust = (thePlayer.GetHorseCurrentlyMounted()).GetMovingAgentComponent().GetMovementAdjustor();

			mac = ((CMovingPhysicalAgentComponent)(thePlayer.GetHorseCurrentlyMounted()).GetMovingAgentComponent());

			waterDepth = mac.GetSubmergeDepth();

			if ( thePlayer.IsActionBlockedBy(EIAB_UsableItem,'UsableItem') )
			{
				thePlayer.UnblockAction(EIAB_UsableItem, 'UsableItem');	
			}

			if (thePlayer.GetStat(BCS_Vitality) <= thePlayer.GetStatMax(BCS_Vitality) * 0.3
			&& !thePlayer.IsAnyWeaponHeld()
			)
			{
				if (!injured_horse_riding_anim)
				{
					thePlayer.RaiseEvent('ACS_InjuredOverrideHorseRiding');

					injured_horse_riding_anim = true;
				}
			}
			else
			{
				if (injured_horse_riding_anim)
				{
					thePlayer.RaiseEvent('ACS_InjuredExtrasAdditiveEnd');

					injured_horse_riding_anim = false;
				}
			}

			if ( thePlayer.GetUsedHorseComponent().OnCheckHorseJump() )
			{
				
			}
			else
			{
				if ( thePlayer.GetHorseCurrentlyMounted().IsInAir()
				|| !thePlayer.GetHorseCurrentlyMounted().IsOnGround()
				)
				{
					if (((thePlayer.GetHorseCurrentlyMounted()).GetMovingAgentComponent()).GetEnabledFeetIK())
					{
						((thePlayer.GetHorseCurrentlyMounted()).GetMovingAgentComponent()).SetEnabledFeetIK(false,0);
					}
				}
				else
				{
					if (HorseComputeTerrainPitch() <= 25)
					{
						if (!((thePlayer.GetHorseCurrentlyMounted()).GetMovingAgentComponent()).GetEnabledFeetIK())
						{
							((thePlayer.GetHorseCurrentlyMounted()).GetMovingAgentComponent()).SetEnabledFeetIK(true,0);
						}
					}
					else
					{
						if (((thePlayer.GetHorseCurrentlyMounted()).GetMovingAgentComponent()).GetEnabledFeetIK())
						{
							((thePlayer.GetHorseCurrentlyMounted()).GetMovingAgentComponent()).SetEnabledFeetIK(false,0);
						}
					}
				}
			}
		}

		if((thePlayer.GetHorseCurrentlyMounted().GetHorseComponent()).IsDismounted()
		)
		{
			if (controllerVibrateOn)
			{
				theGame.StopVibrateController();

				theGame.VibrateControllerLight(0.2);

				controllerVibrateOn = false;
			}

			if (horseInFastSprint)
			{
				ACSGetCEntityDestroyAll('ACS_Player_Fast_Sprint_Trail');

				ACSGetCEntityDestroyAll('ACS_Horse_Fast_Sprint_Trail');

				horseInFastSprint = false;
			}

			if (horseInFastSprintAnim)
			{
				RemoveTimer('ResetHorseInFastSprintAnim');
				
				horseInFastSprintAnim = false;
			}

			if (horseMotionLeaningActive
			)
			{
				hLean.Pitch = 0;
				hLean.Roll = 0;
				hLean.Yaw = 0;

				((CMovingPhysicalAgentComponent)((thePlayer.GetHorseCurrentlyMounted()).GetMovingAgentComponent())).SetRotation(hLean);

				((CMovingPhysicalAgentComponent)(thePlayer.GetMovingAgentComponent())).SetRotation(hLean);

				horseMotionLeaningActive = false;
			}

			if (horseSpeed != 0)
			{
				horseSpeed = 0;
			}

			if (horseAnimSpeed != 1)
			{
				horseAnimSpeed = 1;
			}

			horseTicket = horseMovementAdjust.GetRequest( 'ACS_Horse_Increase_Speed');
			horseMovementAdjust.CancelByName( 'ACS_Horse_Increase_Speed' );
			horseMovementAdjust.CancelAll();

			thePlayer.GetHorseCurrentlyMounted().ACS_ClearAnimationSpeedMultipliers();

			return;
		}

		if ((thePlayer.GetHorseCurrentlyMounted().GetHorseComponent()).IsFullyMounted())
		{
			if (ACS_Settings_Main_Bool('acs_horse_settings','acs_horse_vibrations_enabled', true))
			{
				velocity = (thePlayer.GetHorseCurrentlyMounted().GetHorseComponent()).GetHorseVelocitySpeed();

				if (velocity < 1)
				{
					if (controllerVibrateOn)
					{
						theGame.StopVibrateController();

						theGame.VibrateControllerLight(0.2);

						controllerVibrateOn = false;
					}
				}
				else if (velocity >= 1)
				{
					if (!controllerVibrateOn)
					{
						theGame.StopVibrateController();

						theGame.VibrateControllerLight(0.2);

						controllerVibrateOn = true;
					}

					if (velocity > 1 && velocity <= 1.5)
					{
						controllerCooldown = 1;

						lowfreq = 0.0;

						highfreq = 0.075;
					}
					else if (velocity > 1.5 && velocity <= 3)
					{
						controllerCooldown = 0.5;

						lowfreq = 0.05;

						highfreq = 0.15;
					}
					else if (velocity > 3 && velocity <= 5)
					{
						controllerCooldown = 0.4;

						lowfreq = 0.15;

						highfreq = 0.3;
					}
					else if (velocity > 5 && velocity <= 8)
					{
						controllerCooldown = 0.5;

						lowfreq = 0.3;

						highfreq = 0.45;
					}
					else if (velocity > 8 && velocity <= 13)
					{
						controllerCooldown = 0.5;

						lowfreq = 0.5;

						highfreq = 0.7;
					}
					else if (velocity > 13)
					{
						controllerCooldown = 0.5;

						lowfreq = 0.7;

						highfreq = 0.9;
					}

					if ((theGame.GetEngineTimeAsSeconds() - controllerLastVibrationTime > controllerCooldown))
					{
						controllerLastVibrationTime = theGame.GetEngineTimeAsSeconds();

						lowfreq += ACS_Settings_Main_Float('acs_horse_settings','acs_horse_vibrations_high_freq_adjustment', 0);

						highfreq += ACS_Settings_Main_Float('acs_horse_settings','acs_horse_vibrations_low_freq_adjustment', 0);

						if (lowfreq >= 1)
						{
							lowfreq = 1;
						}

						if (highfreq >= 1)
						{
							highfreq = 1;
						}

						if (lowfreq <= 0)
						{
							lowfreq = 0;
						}

						if (highfreq <= 0)
						{
							highfreq = 0;
						}

						theGame.OverrideRumbleDuration(lowfreq, highfreq, 0.3);
					}
				}
			}
			else
			{
				if (controllerVibrateOn)
				{
					theGame.StopVibrateController();

					theGame.VibrateControllerLight(0.2);

					controllerVibrateOn = false;
				}
			}

			if (thePlayer.HasBuff(EET_Drunkenness) 
			|| thePlayer.HasTag('ACS_TalkingAnimalsEnabled')
			|| pipe_smoke_effect_enabled
			)
			{

				if (thePlayer.IsThreatened() || thePlayer.IsInCombat())
				{
					if (!horse_combat_spoke)
					{
						HorseSpeakController('watch_out');

						horse_combat_spoke = true;
					}
				}
				else
				{
					if (horse_combat_spoke)
					{
						horse_combat_spoke = false;
					}

					if ((thePlayer.GetHorseCurrentlyMounted()).GetStat(BCS_Stamina) <= 0)
					{
						HorseSpeakController('slowing_down');
					}
					else
					{
						if((!(thePlayer.GetHorseCurrentlyMounted()).IsOnGround()))
						{
							if (theGame.GetEngineTimeAsSeconds() - horse_jump_speak_cooldown > 30)
							{
								horse_jump_speak_cooldown = theGame.GetEngineTimeAsSeconds();

								if(FactsQuerySum("ACS_Horse_Jump_Comment_Switch") <= 0)
								{
									HorseSpeakController('twerk');

									FactsAdd("ACS_Horse_Jump_Comment_Switch", 1, -1);
								}
								else
								{
									HorseSpeakController('joke_01');

									FactsRemove("ACS_Horse_Jump_Comment_Switch");
								}
							}
						}
						else
						{
							if (
							(thePlayer.GetHorseCurrentlyMounted().GetHorseComponent()).inCanter)
							{
								if (theGame.GetEngineTimeAsSeconds() - horse_canter_speak_cooldown > 30)
								{
									horse_canter_speak_cooldown = theGame.GetEngineTimeAsSeconds();

									if (!horseInFastSprint)
									{
										if(FactsQuerySum("ACS_Horse_Canter_Comment_Switch") <= 0)
										{
											PlayerSpeakController('run_roach');

											FactsAdd("ACS_Horse_Canter_Comment_Switch", 1, -1);
										}
										else
										{
											PlayerSpeakController('candid');

											FactsRemove("ACS_Horse_Canter_Comment_Switch");
										}
									}
								}
							}
							else
							{
								velocity = (thePlayer.GetHorseCurrentlyMounted().GetHorseComponent()).GetHorseVelocitySpeed();

								if (velocity >= 1)
								{
									if (theGame.GetEngineTimeAsSeconds() - horse_gallop_speak_cooldown > 30)
									{
										horse_gallop_speak_cooldown = theGame.GetEngineTimeAsSeconds();

										if(FactsQuerySum("ACS_Horse_Gallop_Comment_Switch") <= 0)
										{
											HorseSpeakController('surer_hand');

											FactsAdd("ACS_Horse_Gallop_Comment_Switch", 1, -1);
										}
										else
										{
											HorseSpeakController('riding_skills');

											FactsRemove("ACS_Horse_Gallop_Comment_Switch");
										}
									}
								}
							}
						}
					}
				}
			}
		}

		/*
		if ((thePlayer.GetHorseCurrentlyMounted().GetHorseComponent()).IsFullyMounted())
		{
			if (!horseMotionLeaningActive
			)
			{
				horseMotionLeaningActive = true;
			}

			if (hLean.Pitch < RoundF(HorseComputeTerrainPitch()))
			{
				hLean.Pitch += 0.5;
			}
			else if (hLean.Pitch > RoundF(HorseComputeTerrainPitch()))
			{
				hLean.Pitch -= 0.5;
			}
			else
			{
				hLean.Pitch =  RoundF(HorseComputeTerrainPitch());
			}
			

			((CMovingPhysicalAgentComponent)((thePlayer.GetHorseCurrentlyMounted()).GetMovingAgentComponent())).SetRotation(hLean);

			((CMovingPhysicalAgentComponent)(thePlayer.GetMovingAgentComponent())).SetRotation(hLean);
		}
		*/

		if ( thePlayer.IsPCModeEnabled() )
		{
			cam_direction = theInput.GetActionValue( 'GI_MouseDampX' );
		}
		else
		{
			cam_direction = theInput.GetActionValue( 'GI_AxisRightX' );
		}

		if (
		HorseComputeTerrainPitch() > 25
		)
		{
			lean_roll_modifier = 0.5f;
		}
		else
		{
			lean_roll_modifier = 0.25f;
		}
		
		if((!(thePlayer.GetHorseCurrentlyMounted()).IsOnGround()
		&& (thePlayer.GetHorseCurrentlyMounted().GetHorseComponent()).IsFullyMounted())
		|| waterDepth < -0.25 

						{
							ACSGetCEntity('ACS_Armor_Ether_Sword').DestroyEffect('soul_edge_glow');
						}

						if (!ACSGetCEntity('ACS_Armor_Ether_Sword').IsEffectActive('war_sword_glow', false))
						{
							thePlayer.SoundEvent("fx_rune_activate_igni");

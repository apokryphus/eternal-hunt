		//newIgni = (W3SignEntity)theGame.CreateEntity( GetWitcherPlayer().GetSignTemplate( ST_Igni ), GetWitcherPlayer().GetWorldPosition(), VecToRotation(GetWitcherPlayer().GetHeadingVector()) );

		newIgni = (W3SignEntity)theGame.CreateEntity( GetWitcherPlayer().GetSignTemplate( ST_Igni ), GetWitcherPlayer().GetWorldPosition(), GetWitcherPlayer().GetWorldRotation() );

		newIgni.Init( signOwner, GetWitcherPlayer().GetSignEntity( ST_Igni ), true );
		newIgni.OnStarted();
		newIgni.OnThrowing();
		newIgni.OnEnded();
	}

	function ACS_Igni_Blast_Ent()
	{
		var template 							: CEntityTemplate;
		var entPhysics                  		: CEntity;
	
		theGame.GetSurfacePostFX().AddSurfacePostFXGroup( TraceFloor( thePlayer.GetWorldPosition() ), 0.125f, 3, 0.125f, 10.f, 1);

		template = (CEntityTemplate)LoadResource("dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent", true);

		entPhysics = theGame.CreateEntity( template, thePlayer.GetWorldPosition() + Vector(0,0,1), thePlayer.GetWorldRotation() );

		entPhysics.PlayEffect('blast_fire_ACS');

		entPhysics.DestroyAfter(1);
	}


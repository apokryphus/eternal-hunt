	public timer function PipeSmokeHallucinationEnd( time : float , id : int )
	{
		theGame.GetGameCamera().StopEffect('hallucinations_sq209');

		theGame.GetGameCamera().StopEffect('hallucinations');

		thePlayer.RemoveTag('ACS_TalkingAnimalsEnabled');

		ACSGetCEntityDestroyAll('ACS_Talking_Animal');
	}

	var pipe_smoke_effect_enabled : bool;

	public timer function PipeSmokeEffectDisable( time : float , id : int )
	{
		pipe_smoke_effect_enabled = false;
	}

	public timer function PipeSmoke( time : float , id : int )
	{
		var params 										: SCustomEffectParams;

		RemoveTimer('ACS_Pipe_Disappear');

		thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');

		RemoveTimer('CombatTauntDelay');

		thePlayer.RaiseEvent('ACS_IgniLight');

		RemoveTimer('IgniLightIconSmall');

		AddTimer('IgniLightIconSmall', 0.5 , false);

		GetWitcherPlayer().SetCanPlayHitAnim(false);
		GetWitcherPlayer().AddBuffImmunity_AllNegative('acs_weed_pipe', true);
		GetWitcherPlayer().AddBuffImmunity_AllCritical('acs_weed_pipe', true);

		EnableDrunkFx(2.0f);

		pipe_smoke_effect_enabled = true;

		RemoveTimer('PipeSmokeEffectDisable');
		AddTimer('PipeSmokeEffectDisable', 30, false);

		ACSGetCEntity('ACS_Pipe').StopEffect('breath');
		ACSGetCEntity('ACS_Pipe').StopEffect('smoke');
		ACSGetCEntity('ACS_Pipe').StopEffect('smoke_looped');

		ACSGetCEntity('ACS_Pipe').PlayEffect('breath');
		ACSGetCEntity('ACS_Pipe').PlayEffect('smoke');
		ACSGetCEntity('ACS_Pipe').PlayEffect('smoke_looped');

		RemoveTimer('PipeSmokeRepeat');
		AddTimer('PipeSmokeRepeat', 1.5 , true);

		if (thePlayer.inv.HasItem('Bag of weed')
		)
		{
			RemoveTimer('HallucinationBegin');
			AddTimer('HallucinationBegin', 1.5 , false);
		}
		else
		{
			if (thePlayer.inv.HasItem('Fisstech')
			|| thePlayer.inv.HasItem('FT_Fisstech')
			)
			{
				RemoveTimer('HallucinationBegin');
				AddTimer('HallucinationBegin', 1.5 , false);

				if (thePlayer.inv.HasItem('Fisstech')
				)
				{
					thePlayer.inv.RemoveItemByName('Fisstech', 1);
				}
				else if (thePlayer.inv.HasItem('FT_Fisstech')
				)
				{
					thePlayer.inv.RemoveItemByName('FT_Fisstech', 1);
				}

				thePlayer.GainStat(BCS_Toxicity, thePlayer.GetStatMax(BCS_Toxicity) * 0.25);
			}
			else
			{
				thePlayer.GainStat(BCS_Toxicity, thePlayer.GetStatMax(BCS_Toxicity) * 0.0625);
			}
		}
	}

	public timer function HallucinationBegin( time : float , id : int )
	{
		thePlayer.GainStat(BCS_Toxicity, thePlayer.GetStatMax(BCS_Toxicity) * 0.25);

		theGame.GetGameCamera().PlayEffectSingle('hallucinations_sq209');

		theGame.GetGameCamera().PlayEffectSingle('hallucinations');

		if(!thePlayer.HasTag('ACS_TalkingAnimalsEnabled'))
		{
			thePlayer.AddTag('ACS_TalkingAnimalsEnabled');
		}
	}

	public timer function PipeSmokeRepeat( time : float , id : int )
	{
		ACSGetCEntity('ACS_Pipe').StopEffect('breath');
		ACSGetCEntity('ACS_Pipe').StopEffect('smoke');

		ACSGetCEntity('ACS_Pipe').PlayEffect('breath');
		ACSGetCEntity('ACS_Pipe').PlayEffect('smoke');
	}

	var playerHasDanced : bool;
	default playerHasDanced = false;

	///////////////////////////////////////////////////////////////////////////

	public timer function RemovePlayerIsAttackingTag( time : float , id : int )
	{
		ShotgunPositioningSwitch('in_combat');

		thePlayer.RemoveTag('ACS_Player_Is_Attacking');
	}

	public timer function AddPlayerIsAttackingBounceArrowTag( time : float , id : int )
	{
		thePlayer.AddTag('ACS_Player_Is_Attacking_Bounce_Arrow');
	}

	public timer function RemovePlayerIsAttackingBounceArrowTag( time : float , id : int )
	{
		thePlayer.RemoveTag('ACS_Player_Is_Attacking_Bounce_Arrow');
	}

	////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	function MimicReset()
	{
		var headcComponent 	: array< CComponent >;
			
		headcComponent.Clear();

		headcComponent = thePlayer.GetComponentsByClassName( 'CHeadManagerComponent' );

		( ( CHeadManagerComponent ) headcComponent[0] ).MimicTest( 'gameplay_focused_anim_combined_face' );
	}

	var playerIsInsideDisableLookat, playerIsOutsideDisableLookat, playerIsInCombatLookat, playerIsOutOfCombatLookat, playerLookatFollowCameraDirection, playerLookatFollowCameraDirectionReset : bool;
	
	default playerIsInsideDisableLookat = false;
	default playerIsOutsideDisableLookat = false;
	default playerIsInCombatLookat = false;
	default playerIsOutOfCombatLookat = false;
	default playerLookatFollowCameraDirection = false;
	default playerLookatFollowCameraDirectionReset = false;

	public timer function PlayerLookatFollowCameraDirectionReset( time : float , id : int )
	{
		if (playerLookatFollowCameraDirection)
		{
			playerLookatFollowCameraDirection = false;
		}
	}

	function LookatLoop()
	{
		var lookatactors 									: array<CActor>;
		var lookatents										: array<CGameplayEntity>;
		var i												: int;
		var curtime 										: float;
		var npccount 										: int;
		var targetpos 										: Vector;
		var camerapos 										: Vector;
		var camhead 										: Vector;
		var playerpos										: Vector;
		var interactionTarget								: CInteractionComponent;
		var tempTarget										: CGameplayEntity;
		var gameLightComp, gameInteractComp 				: CComponent;
		var ents											: array<CGameplayEntity>;
		var vehicle											: CEntity;
		var cam_directionX		 							: float;

		if (thePlayer.IsCastingSign()
		|| FactsQuerySum("ACS_In_Meditation") > 0
		|| ACS_Cast_Sign_Process
		)
		{
			((CActor)thePlayer).DisableLookAt();
			return;
		}

		camerapos = theCamera.GetCameraPosition();
		camhead = VecFromHeading(theCamera.GetCameraHeading());
		playerpos = thePlayer.GetWorldPosition();
		targetpos = camerapos + camhead * 10;
		
		if(camerapos.Z > playerpos.Z + 1.85)
		{
			targetpos.Z = camerapos.Z - 4;
		}
		if(camerapos.Z < playerpos.Z + 1.3)
		{
			targetpos.Z = camerapos.Z + 4;
		}

		(ACSGetCEntity('acs_lookat_entity')).TeleportWithRotation(LerpV(ACSGetCEntity('acs_lookat_entity').GetWorldPosition(), targetpos, 0.1), thePlayer.GetWorldRotation());

		if ( theInput.LastUsedPCInput() )
		{
			cam_directionX = theInput.GetActionValue( 'GI_MouseDampX' );
		}
		else if (theInput.LastUsedGamepad())
		{
			cam_directionX = theInput.GetActionValue( 'GI_AxisRightX' );
		}

		if (thePlayer.IsUsingVehicle()
		|| thePlayer.IsUsingHorse()
		)
		{
			vehicle = thePlayer.GetUsedVehicle();

			if (vehicle.HasTag('ACS_Player_Merchant_Ship') || vehicle.HasTag('ACS_Player_Ghost_Ship'))
			{
				((CActor)thePlayer).DisableLookAt();

				return;
			}


			if( thePlayer.playerAiming.GetCurrentStateName() == 'Aiming'
			)
			{
				thePlayer.SetBehaviorVectorVariable( 'lookAtTargetHorseTorsoAim_ACS', targetpos );

				if (thePlayer.GetBehaviorVariable( 'lookatOnHorseTorsoAim_ACS' ) != 1)
				{
					thePlayer.SetBehaviorVariable( 'lookatOnHorseTorsoAim_ACS', 1, true );
				}
			}
			else
			{
				if (thePlayer.GetBehaviorVariable( 'lookatOnHorseTorsoAim_ACS' ) != 0)
				{
					thePlayer.SetBehaviorVariable( 'lookatOnHorseTorsoAim_ACS', 0, true );
				}

				if (cam_directionX != 0
				)
				{
					thePlayer.SetBehaviorVectorVariable( 'lookAtTarget', targetpos );

					if (thePlayer.GetBehaviorVariable( 'lookatOn' ) != 1)
					{
						thePlayer.SetBehaviorVariable( 'lookatOn', 1, true );
					}
				}
				else
				{
					if (thePlayer.GetBehaviorVariable( 'lookatOn' ) != 0)
					{
						thePlayer.SetBehaviorVariable( 'lookatOn', 0, true );
					}
				}
			}
		}
		else
		{
			if (
			thePlayer.IsInCombat()
			|| thePlayer.IsThreatened()
			)
			{
				if (!playerIsInCombatLookat)
				{
					((CActor)thePlayer).DisableLookAt();

					playerIsOutOfCombatLookat = false;

					playerIsInCombatLookat = true;
				}

				curtime = theGame.GetEngineTimeAsSeconds();

				lookatactors.Clear();

				//lookatactors = thePlayer.GetNPCsAndPlayersInRange( 4.5, 20, , FLAG_ExcludePlayer + FLAG_Attitude_Hostile + FLAG_OnlyAliveActors);

				lookatactors = thePlayer.GetNPCsAndPlayersInCone(4.5, VecHeading(GetWitcherPlayer().GetHeadingVector()), 60, 50, , FLAG_ExcludePlayer + FLAG_Attitude_Hostile + FLAG_OnlyAliveActors );

				if (lookatactors.Size() > 0)
				{
					for(i = 0; i < lookatactors.Size(); i += 1)
					{
						if(
						lookatactors[i]
						&& lookatactors[i].IsAlive()
						//&& ACS_AttitudeCheck ( (CActor)lookatactors[i] )
						&& (lookatactors[i] == (CActor)( thePlayer.GetTarget() ) || lookatactors[i] == (CActor)( thePlayer.moveTarget ))
						)
						{
							if(curtime > lastlooktime + 1 )
							{
								if (thePlayer.GetDisplayTarget())
								{
									lookTargetentity = ((CActor)thePlayer.GetDisplayTarget());
								}
								else
								{
									lookTargetentity = lookatactors[i];
								}
								
								lastlooktime = theGame.GetEngineTimeAsSeconds();

								break;
							}
						}

						if(lookTargetentity != savedTarget)
						{
							((CActor)thePlayer).DisableLookAt();
							((CActor)thePlayer).EnableDynamicLookAt(lookTargetentity, 999);
						}
					
						savedTarget = lookTargetentity;
					}
				}
				else
				{
					if (thePlayer.GetDisplayTarget())
					{
						lookTargetentity = ((CActor)thePlayer.GetDisplayTarget());
					}
					else
					{
						if ((CActor)( thePlayer.moveTarget ))
						{
							lookTargetentity = (CActor)( thePlayer.moveTarget );
						}
					}

					if(lookTargetentity != savedTarget)
					{
						((CActor)thePlayer).DisableLookAt();
						((CActor)thePlayer).EnableDynamicLookAt(lookTargetentity, 999);
					}

					savedTarget = lookTargetentity;
				}
			}
			else
			{
				if (!playerIsOutOfCombatLookat)
				{
					((CActor)thePlayer).DisableLookAt();

					playerIsInCombatLookat = false;

					playerIsOutOfCombatLookat = true;
				}

				if (cam_directionX != 0
				)
				{
					if (!playerLookatFollowCameraDirection)
					{
						RemoveTimer('PlayerLookatFollowCameraDirectionReset');
						AddTimer('PlayerLookatFollowCameraDirectionReset', 5 , false);

						playerLookatFollowCameraDirection = true;
					}
				}

				if (playerLookatFollowCameraDirection)
				{
					savedTarget = ACSGetCEntity('acs_lookat_entity');

					if (!playerIsOutsideDisableLookat)
					{
						((CActor)thePlayer).DisableLookAt();

						playerIsInsideDisableLookat = false;

						playerIsOutsideDisableLookat = true;
					}

					((CActor)thePlayer).EnableDynamicLookAt(ACSGetCEntity('acs_lookat_entity'), 999);
				}
				else
				{
					if (!playerIsInsideDisableLookat)
					{
						((CActor)thePlayer).DisableLookAt();

						playerIsOutsideDisableLookat = false;

						playerIsInsideDisableLookat = true;
					}

					curtime = theGame.GetEngineTimeAsSeconds();

					lookatents.Clear();

					//FindGameplayEntitiesInRange(lookatents, thePlayer, 4.5, 20, ,FLAG_ExcludePlayer, ,);

					FindGameplayEntitiesInCone(lookatents, thePlayer.GetWorldPosition() + thePlayer.GetWorldForward(), VecHeading(thePlayer.GetHeadingVector()), 60, 5, 20, ,FLAG_ExcludePlayer, ,);

					for(i = 0; i < lookatents.Size(); i += 1)
					{
						if (lookatents.Size() > 0)
						{
							if (lookatents[i] == this
							|| lookatents[i].HasTag('acswatcher')
							|| lookatents[i].HasTag('acswatchersecondary')
							)
							{
								continue;
							}

							gameLightComp = lookatents[i].GetComponentByClassName('CGameplayLightComponent');

							gameInteractComp = lookatents[i].GetComponentByClassName('CInteractionComponent');

							if(
							(CNewNPC)lookatents[i]
							|| (COilBarrelEntity)lookatents[i]
							|| gameLightComp
							|| gameInteractComp
							|| (W3Container)lookatents[i]
							|| (W3Stash)lookatents[i]
							|| (W3MonsterClue)lookatents[i]
							|| (W3LadderInteraction)lookatents[i]
							|| (W3FastTravelEntity)lookatents[i]
							|| (W3IllusionaryObstacle)lookatents[i]
							|| (W3Boat)lookatents[i]
							|| (W3CollectiblePlaces)lookatents[i]
							|| (W3InteractionSwitch)lookatents[i]
							|| (CLightEntitySimpleWithEffectImmunity)lookatents[i]
							|| (CScheduledUsableEntity)lookatents[i]
							|| (W3WitcherBed)lookatents[i]
							|| (W3WeatherShrine)lookatents[i]
							|| (W3LeaderboardCustom)lookatents[i]
							|| (CTeleportEntity)lookatents[i]
							|| (CSignReactiveEntity)lookatents[i]
							|| (W3NewDoor)lookatents[i]
							|| (W3MutagenDismantlingTable)lookatents[i]
							|| (CMonsterNestEntity)lookatents[i]
							|| (CACSMonsterNestEntity)lookatents[i]
							|| (W3HouseDecorationBase)lookatents[i]
							|| (W3LockableEntity)lookatents[i]
							|| (W3Door)lookatents[i]
							|| (W3BeehiveStandingEntity)lookatents[i]
							|| (CBeehiveEntity)lookatents[i]
							|| (W3AnimationInteractionEntity)lookatents[i]
							|| (CInteractiveEntity)lookatents[i]
							|| (W3NoticeBoard)lookatents[i]
							|| (W3SmartObject)lookatents[i]
							|| (W3ItemRepairObject)lookatents[i]
							|| (W3AlchemyTable)lookatents[i]
							|| (W3Stables)lookatents[i]
							|| (W3LockableEntity)lookatents[i] 
							|| (W3Poster)lookatents[i]
							|| (W3LadderInteraction)lookatents[i]
							)
							{
								if(curtime > lastlooktime + 1 )
								{
									lookTargetentity = lookatents[i];
									lastlooktime = theGame.GetEngineTimeAsSeconds();
									break;
								}
							}

							if(lookTargetentity != savedTarget)
							{
								((CActor)thePlayer).DisableLookAt();
								((CActor)thePlayer).EnableDynamicLookAt(lookTargetentity, 999);
							}
						
							savedTarget = lookTargetentity;
						}
						else
						{
							if(ACSGetCEntity('acs_lookat_entity') != savedTarget)
							{
								((CActor)thePlayer).EnableDynamicLookAt(ACSGetCEntity('acs_lookat_entity'), 999);
							}
						
							savedTarget = ACSGetCEntity('acs_lookat_entity');
						}
					}
				}
			
				/*
				if (thePlayer.IsInInterior())
				{
					if (!playerIsInsideDisableLookat)
					{
						((CActor)thePlayer).DisableLookAt();

						playerIsOutsideDisableLookat = false;

						playerIsInsideDisableLookat = true;
					}

					curtime = theGame.GetEngineTimeAsSeconds();

					lookatents.Clear();

					//FindGameplayEntitiesInRange(lookatents, thePlayer, 4.5, 20, ,FLAG_ExcludePlayer, ,);

					FindGameplayEntitiesInCone(lookatents, thePlayer.GetWorldPosition() + thePlayer.GetWorldForward(), VecHeading(thePlayer.GetHeadingVector()), 60, 4.5, 20, ,FLAG_ExcludePlayer, ,);

					for(i = 0; i < lookatents.Size(); i += 1)
					{
						if (lookatents.Size() > 0)
						{
							if (lookatents[i] == this
							|| lookatents[i].HasTag('acswatcher')
							|| lookatents[i].HasTag('acswatchersecondary')
							)
							{
								continue;
							}

							gameLightComp = lookatents[i].GetComponentByClassName('CGameplayLightComponent');

							gameInteractComp = lookatents[i].GetComponentByClassName('CInteractionComponent');

							if(
							(CNewNPC)lookatents[i]
							|| (COilBarrelEntity)lookatents[i]
							|| gameLightComp
							|| gameInteractComp
							|| (W3Container)lookatents[i]
							|| (W3Stash)lookatents[i]
							|| (W3MonsterClue)lookatents[i]
							|| (W3LadderInteraction)lookatents[i]
							|| (W3FastTravelEntity)lookatents[i]
							|| (W3IllusionaryObstacle)lookatents[i]
							|| (W3Boat)lookatents[i]
							|| (W3CollectiblePlaces)lookatents[i]
							|| (W3InteractionSwitch)lookatents[i]
							|| (CLightEntitySimpleWithEffectImmunity)lookatents[i]
							|| (CScheduledUsableEntity)lookatents[i]
							|| (W3WitcherBed)lookatents[i]
							|| (W3WeatherShrine)lookatents[i]
							|| (W3LeaderboardCustom)lookatents[i]
							|| (CTeleportEntity)lookatents[i]
							|| (CSignReactiveEntity)lookatents[i]
							|| (W3NewDoor)lookatents[i]
							|| (W3MutagenDismantlingTable)lookatents[i]
							|| (CMonsterNestEntity)lookatents[i]
							|| (CACSMonsterNestEntity)lookatents[i]
							|| (W3HouseDecorationBase)lookatents[i]
							|| (W3LockableEntity)lookatents[i]
							|| (W3Door)lookatents[i]
							|| (W3BeehiveStandingEntity)lookatents[i]
							|| (CBeehiveEntity)lookatents[i]
							|| (W3AnimationInteractionEntity)lookatents[i]
							|| (CInteractiveEntity)lookatents[i]
							|| (W3NoticeBoard)lookatents[i]
							|| (W3FastTravelEntity)lookatents[i]
							|| (W3SmartObject)lookatents[i]
							|| (W3ItemRepairObject)lookatents[i]
							|| (W3AlchemyTable)lookatents[i]
							|| (W3Stables)lookatents[i]
							|| (W3LockableEntity)lookatents[i] 
							|| (W3Poster)lookatents[i]
							|| (W3LadderInteraction)lookatents[i]
							)
							{
								if(curtime > lastlooktime + 1 )
								{
									lookTargetentity = lookatents[i];
									lastlooktime = theGame.GetEngineTimeAsSeconds();
									break;
								}
							}

							if(lookTargetentity != savedTarget)
							{
								((CActor)thePlayer).DisableLookAt();
								((CActor)thePlayer).EnableDynamicLookAt(lookTargetentity, 999);
							}
						
							savedTarget = lookTargetentity;
						}
						else
						{
							if(ACSGetCEntity('acs_lookat_entity') != savedTarget)
							{
								((CActor)thePlayer).EnableDynamicLookAt(ACSGetCEntity('acs_lookat_entity'), 999);
							}
						
							savedTarget = ACSGetCEntity('acs_lookat_entity');
						}
					}
				}
				else
				{
					savedTarget = ACSGetCEntity('acs_lookat_entity');

					if (!playerIsOutsideDisableLookat)
					{
						((CActor)thePlayer).DisableLookAt();

						playerIsInsideDisableLookat = false;

						playerIsOutsideDisableLookat = true;
					}

					((CActor)thePlayer).EnableDynamicLookAt(ACSGetCEntity('acs_lookat_entity'), 999);
				}
				*/
			}
		}
	}

	
	function register_extra_inputs()
	{
		var vehicle											 : CVehicleComponent;
		var isUsableItem, isCrossbow, isBomb 				 : bool;
		var itemId											 : SItemUniqueId;	

		if ( !theGame.IsDialogOrCutscenePlaying() 
		&& !theGame.IsFading()
		&& !theGame.IsBlackscreen()
		&& !theGame.IsPaused() 
		&& !theGame.GetPhotomodeEnabled() 
		&& !thePlayer.IsInCutsceneIntro() 
		)
		{
			if (thePlayer.IsEffectActive('critical_low_health', false))
			{
				thePlayer.DestroyEffect('critical_low_health');
			}

			theInput.UnregisterListener( thePlayer.GetInputHandler(), 'CastSign' );

			theInput.RegisterListener( this, 'OnCastSign', 'CastSign' );

			theInput.UnregisterListener( thePlayer.GetInputHandler(), 'AltQuenCasting' );

			theInput.RegisterListener( this, 'OnAltQuen', 'AltQuenCasting' );

			theInput.UnregisterListener( thePlayer.GetInputHandler(), 'Focus' );

			theInput.RegisterListener( this, 'OnExpFocus', 'Focus' );

			theInput.UnregisterListener( thePlayer.GetInputHandler(), 'MovementDoubleTapW' );

			theInput.UnregisterListener( thePlayer.GetInputHandler(), 'MovementDoubleTapS' ); 

			theInput.UnregisterListener( thePlayer.GetInputHandler(), 'MovementDoubleTapA' ); 

			theInput.UnregisterListener( thePlayer.GetInputHandler(), 'MovementDoubleTapD' ); 

			theInput.UnregisterListener( thePlayer.GetInputHandler(), 'Dodge' );

			theInput.RegisterListener( this, 'OnMovementDoubleTapW', 'MovementDoubleTapW' );

			theInput.RegisterListener( this, 'OnMovementDoubleTapS', 'MovementDoubleTapS' ); 

			theInput.RegisterListener( this, 'OnMovementDoubleTapA', 'MovementDoubleTapA' ); 

			theInput.RegisterListener( this, 'OnMovementDoubleTapD', 'MovementDoubleTapD' ); 

			theInput.RegisterListener( this, 'OnMoveForward', 'GI_AxisLeftY' );

			//theInput.RegisterListener( this, 'OnMoveBackward', 'GI_AxisRightY' );

			theInput.RegisterListener( this, 'OnMoveSide', 'GI_AxisLeftX' );

			theInput.RegisterListener( this, 'OnAccelerate', 'GI_Accelerate' );

			theInput.RegisterListener( this, 'OnJump', 'Jump' );

			//theInput.RegisterListener( this, 'OnMoveSideLeft', 'GI_AxisRightX' );

			theInput.RegisterListener( this, 'OnCbtDodge', 'Dodge' );

			theInput.RegisterListener(this, 'OnACSFacemaskToggle', 'ACSFacemaskToggle');

			theInput.RegisterListener(this, 'OnACSHelmToggle', 'ACSHelmToggle');

			theInput.RegisterListener(this, 'OnACSShoulderToggle', 'ACSShoulderToggle');

			///////////////////////////////////////////////////////////////////////////////////////////////////////////

			if (ACS_Settings_Main_Bool('acs_signs_settings','acs_alternate_quickcasting_controls_enabled', false))
			{
				theInput.RegisterListener( this, 'OnACSAltQuen', 'ACSAltQuen' ); 

				theInput.RegisterListener( this, 'OnACSAltIgni', 'ACSAltIgni' ); 

				theInput.RegisterListener( this, 'OnACSAltYrden', 'ACSAltYrden' ); 

				theInput.RegisterListener( this, 'OnACSAltAard', 'ACSAltAard' ); 

				theInput.RegisterListener( this, 'OnACSAltAxii', 'ACSAltAxii' ); 
			}

			///////////////////////////////////////////////////////////////////////////////////////////////////////////

			if (ACS_Settings_Main_Bool('acs_meditation_settings','acs_override_meditation_button_enabled', true))
			{
				theInput.UnregisterListener( thePlayer.GetInputHandler(), 'PanelMeditation' );

				theInput.RegisterListener( this, 'OnCommPanelMeditation', 'PanelMeditation' );
			}
			else
			{
				theInput.UnregisterListener( this, 'PanelMeditation' );
				theInput.RegisterListener( thePlayer.GetInputHandler(), 'OnCommPanelMeditation', 'PanelMeditation' );
			}

			theInput.UnregisterListener( thePlayer.GetInputHandler(), 'AttackHeavy' );

			theInput.RegisterListener( this, 'OnCbtAttackHeavy', 'AttackHeavy' );

			theInput.UnregisterListener( thePlayer.GetInputHandler(), 'AttackWithAlternateLight' );


	public timer function VampiressLightAttackDamageRight(deltaTime : float , id : int)
	{
		var attackRange, attackAngle 	: float;
		var targetNum					: int;

		if (ACSGetCActor('ACS_Transformation_Vampiress').HasTag('ACS_Vampiress_Sorceress_Mode'))
		{
			attackRange = 15;


				else
				{
					l_mcAnchor 	= l_hudModuleAnchors.GetAnchorSprite( "mcAnchorHorseStaminaBar" );
				}
			}
			break;

			case 'console':
			{
				baseHud = (CR4HudModuleBase)hud.GetHudModule("ConsoleModule");

				consoleModule = (CR4HudModuleConsole)hud.GetHudModule("ConsoleModule");

				l_flashModule = consoleModule.GetModuleFlash();

				if (ACS_Settings_Main_Bool('acs_hud_settings_positioning_all','acs_hud_positioning_enabled', false))
				{
					l_flashModule.SetXScale( ACS_Settings_Main_Float('acs_hud_settings_positioning_control_hints_and_action_log','ACS_ActionLogScale', 100) );
					l_flashModule.SetYScale( ACS_Settings_Main_Float('acs_hud_settings_positioning_control_hints_and_action_log','ACS_ActionLogScale', 100) );
					l_flashModule.SetZScale( ACS_Settings_Main_Float('acs_hud_settings_positioning_control_hints_and_action_log','ACS_ActionLogScale', 100) );

					l_flashModule.SetPosition( 
					ACS_HUD_Adjustment('acs_hud_settings_positioning_control_hints_and_action_log', 'ACS_ActionLogHorizontal', 'ACS_ActionLogVertical', 'X', -0.05, 0.01)
					, 
					ACS_HUD_Adjustment('acs_hud_settings_positioning_control_hints_and_action_log', 'ACS_ActionLogHorizontal', 'ACS_ActionLogVertical', 'Y', -0.05, 0.01)
					);

					return;
				}
				else
				{
					l_mcAnchor 	= l_hudModuleAnchors.GetAnchorSprite( "mcAnchorConsole" );
				}
			}
			break;

			case 'controlsFeedback':
			{
				baseHud = (CR4HudModuleBase)hud.GetHudModule("ControlsFeedbackModule");

				controlsFeedbackModule = (CR4HudModuleControlsFeedback)hud.GetHudModule("ControlsFeedbackModule");

				l_flashModule = controlsFeedbackModule.GetModuleFlash();

				if (ACS_Settings_Main_Bool('acs_hud_settings_positioning_all','acs_hud_positioning_enabled', false))
				{
					l_flashModule.SetXScale( ACS_Settings_Main_Float('acs_hud_settings_positioning_control_hints_and_action_log','ACS_ControlsScale', 75) );
					l_flashModule.SetYScale( ACS_Settings_Main_Float('acs_hud_settings_positioning_control_hints_and_action_log','ACS_ControlsScale', 75) );
					l_flashModule.SetZScale( ACS_Settings_Main_Float('acs_hud_settings_positioning_control_hints_and_action_log','ACS_ControlsScale', 75) );

					l_flashModule.SetPosition( 
					ACS_HUD_Adjustment('acs_hud_settings_positioning_control_hints_and_action_log', 'ACS_ControlsHorizontal', 'ACS_ControlsVertical', 'X', 0.03, -0.05)
					, 
					ACS_HUD_Adjustment('acs_hud_settings_positioning_control_hints_and_action_log', 'ACS_ControlsHorizontal', 'ACS_ControlsVertical', 'Y', 0.03, -0.05)
					);

					return;
				}
				else
				{
					l_mcAnchor 	= l_hudModuleAnchors.GetAnchorSprite( "mcAnchorControlsFeedback" );
				}
			}
			break;

			case 'damagedItems':
			{
				baseHud = (CR4HudModuleBase)hud.GetHudModule("DamagedItemsModule");

				damagedItemsModule = (CR4HudModuleDamagedItems)hud.GetHudModule("DamagedItemsModule");

				l_flashModule = damagedItemsModule.GetModuleFlash();

				if (ACS_Settings_Main_Bool('acs_hud_settings_positioning_all','acs_hud_positioning_enabled', false))
				{
					l_flashModule.SetXScale( ACS_Settings_Main_Float('acs_hud_settings_positioning_item_info','ACS_DamagedScale', 75) );
					l_flashModule.SetYScale( ACS_Settings_Main_Float('acs_hud_settings_positioning_item_info','ACS_DamagedScale', 75) );
					l_flashModule.SetZScale( ACS_Settings_Main_Float('acs_hud_settings_positioning_item_info','ACS_DamagedScale', 75) );

					l_flashModule.SetPosition( 
					ACS_HUD_Adjustment('acs_hud_settings_positioning_item_info', 'ACS_DamagedHorizontal', 'ACS_DamagedVertical', 'X', -0.0175, 0.0225)
					, 
					ACS_HUD_Adjustment('acs_hud_settings_positioning_item_info', 'ACS_DamagedHorizontal', 'ACS_DamagedVertical', 'Y', -0.0175, 0.0225)
					);

					return;
				}
				else
				{
					l_mcAnchor 	= l_hudModuleAnchors.GetAnchorSprite( "mcAnchorDamagedItems" );
				}
			}
			break;

			case 'itemInfo':
			{
				baseHud = (CR4HudModuleBase)hud.GetHudModule("ItemInfoModule");

				itemInfoModule = (CR4HudModuleItemInfo)hud.GetHudModule("ItemInfoModule");

				l_flashModule = itemInfoModule.GetModuleFlash();

				if (ACS_Settings_Main_Bool('acs_hud_settings_positioning_all','acs_hud_positioning_enabled', false))
				{
					l_flashModule.SetXScale( ACS_Settings_Main_Float('acs_hud_settings_positioning_item_info','ACS_ItemsScale', 100) );
					l_flashModule.SetYScale( ACS_Settings_Main_Float('acs_hud_settings_positioning_item_info','ACS_ItemsScale', 100) );
					l_flashModule.SetZScale( ACS_Settings_Main_Float('acs_hud_settings_positioning_item_info','ACS_ItemsScale', 100) );

					l_flashModule.SetPosition( 
					ACS_HUD_Adjustment('acs_hud_settings_positioning_item_info', 'ACS_ItemsHorizontal', 'ACS_ItemsVertical', 'X', -0.06, -0.1)
					, 
					ACS_HUD_Adjustment('acs_hud_settings_positioning_item_info', 'ACS_ItemsHorizontal', 'ACS_ItemsVertical', 'Y', -0.06, -0.1)
					);

					return;
				}
				else
				{
					l_mcAnchor 	= l_hudModuleAnchors.GetAnchorSprite( "mcAnchorItemInfo" );
				}
			}
			break;

			case 'wolfMedallion':
			{
				baseHud = (CR4HudModuleBase)hud.GetHudModule("WolfHeadModule");

				wolfsHeadModule = (CR4HudModuleWolfHead)hud.GetHudModule("WolfHeadModule");

				l_flashModule = wolfsHeadModule.GetModuleFlash();

				if (ACS_Settings_Main_Bool('acs_hud_settings_positioning_all','acs_hud_positioning_enabled', false))
				{
					l_flashModule.SetXScale( ACS_Settings_Main_Float('acs_hud_settings_positioning_wolf_medallion','ACS_WolfMedallionScale', 100) );
					l_flashModule.SetYScale( ACS_Settings_Main_Float('acs_hud_settings_positioning_wolf_medallion','ACS_WolfMedallionScale', 100) );
					l_flashModule.SetZScale( ACS_Settings_Main_Float('acs_hud_settings_positioning_wolf_medallion','ACS_WolfMedallionScale', 100) );

					l_flashModule.SetPosition( 
					ACS_HUD_Adjustment('acs_hud_settings_positioning_wolf_medallion', 'ACS_WolfMedallionHorizontal', 'ACS_WolfMedallionVertical', 'X', -0.1, 0.05)
					, 
					ACS_HUD_Adjustment('acs_hud_settings_positioning_wolf_medallion', 'ACS_WolfMedallionHorizontal', 'ACS_WolfMedallionVertical', 'Y', -0.1, 0.05)
					);

					return;
				}
				else
				{
					l_mcAnchor 	= l_hudModuleAnchors.GetAnchorSprite( "mcAnchorWolfHead" );
				}
			}	
			break;

			case 'buffs':
			{
				baseHud = (CR4HudModuleBase)hud.GetHudModule("BuffsModule");

				buffsModule = (CR4HudModuleBuffs)hud.GetHudModule("BuffsModule");

				l_flashModule = buffsModule.GetModuleFlash();

				if (ACS_Settings_Main_Bool('acs_hud_settings_positioning_all','acs_hud_positioning_enabled', false))
				{
					l_flashModule.SetXScale( ACS_Settings_Main_Float('acs_hud_settings_positioning_buffs','ACS_BuffsScale', 100) );
					l_flashModule.SetYScale( ACS_Settings_Main_Float('acs_hud_settings_positioning_buffs','ACS_BuffsScale', 100) );
					l_flashModule.SetZScale( ACS_Settings_Main_Float('acs_hud_settings_positioning_buffs','ACS_BuffsScale', 100) );

					l_flashModule.SetPosition( 
					ACS_HUD_Adjustment('acs_hud_settings_positioning_buffs', 'ACS_BuffsHorizontal', 'ACS_BuffsVertical', 'X', -0.095, 0.045)
					, 
					ACS_HUD_Adjustment('acs_hud_settings_positioning_buffs', 'ACS_BuffsHorizontal', 'ACS_BuffsVertical', 'Y', -0.095, 0.045)
					);

					return;
				}
				else
				{
					l_mcAnchor 	= l_hudModuleAnchors.GetAnchorSprite( "mcAnchorBuffs" );
				}
			}
			break;

			case 'quests':
			{
				baseHud = (CR4HudModuleBase)hud.GetHudModule("QuestsModule");

				objectiveModule = (CR4HudModuleQuests)hud.GetHudModule("QuestsModule");

				l_flashModule = objectiveModule.GetModuleFlash();

				if (ACS_Settings_Main_Bool('acs_hud_settings_positioning_all','acs_hud_positioning_enabled', false))
				{
					l_flashModule.SetXScale( ACS_Settings_Main_Float('acs_hud_settings_positioning_minimap_and_quests','ACS_QuestsScale', 100) );
					l_flashModule.SetYScale( ACS_Settings_Main_Float('acs_hud_settings_positioning_minimap_and_quests','ACS_QuestsScale', 100) );
					l_flashModule.SetZScale( ACS_Settings_Main_Float('acs_hud_settings_positioning_minimap_and_quests','ACS_QuestsScale', 100) );

					anchorX = ACS_Settings_Main_Float('acs_hud_settings_positioning_minimap_and_quests','ACS_QuestsHorizontal', 379);
					anchorY = ACS_Settings_Main_Float('acs_hud_settings_positioning_minimap_and_quests','ACS_QuestsVertical', 350);

					Cx = 0.05;
					Cy = 0.125;
				}
				else
				{
					l_mcAnchor 	= l_hudModuleAnchors.GetAnchorSprite( "mcAnchorQuest" );
				}
			}
			break;

			case 'minimap':
			{
				baseHud = (CR4HudModuleBase)hud.GetHudModule("Minimap2Module");

				minimapModule = (CR4HudModuleMinimap2)hud.GetHudModule("Minimap2Module");

				l_flashModule = minimapModule.GetModuleFlash();

				if (ACS_Settings_Main_Bool('acs_hud_settings_positioning_all','acs_hud_positioning_enabled', false))
				{
					l_flashModule.SetXScale( ACS_Settings_Main_Float('acs_hud_settings_positioning_minimap_and_quests','ACS_MinimapScale', 100) );
					l_flashModule.SetYScale( ACS_Settings_Main_Float('acs_hud_settings_positioning_minimap_and_quests','ACS_MinimapScale', 100) );
					l_flashModule.SetZScale( ACS_Settings_Main_Float('acs_hud_settings_positioning_minimap_and_quests','ACS_MinimapScale', 100) );

					anchorX = ACS_Settings_Main_Float('acs_hud_settings_positioning_minimap_and_quests','ACS_MinimapHorizontal', 375);
					anchorY = ACS_Settings_Main_Float('acs_hud_settings_positioning_minimap_and_quests','ACS_MinimapVertical', 344);

					Cx = 0.05;
					Cy = 0.125;
				}
				else
				{
					l_mcAnchor 	= l_hudModuleAnchors.GetAnchorSprite( "mcAnchorMiniMap" );
				}
			}
			break;

			default:
			return;
			break;
		}

		if (!ACS_Settings_Main_Bool('acs_hud_settings_positioning_all','acs_hud_positioning_enabled', false))
		{
			anchorX = l_mcAnchor.GetX();
			anchorY = l_mcAnchor.GetY();

			tempX = anchorX;

			tempY = anchorY;
		}
		else
		{
			tempX = (anchorX*N+Cx)*baseHud.ACS_GetResolutionWidth();

			tempY = -((anchorY*N-1)+Cy)*baseHud.ACS_GetResolutionHeight();
		}
		
		if (hudModule == 'minimap' && ACS_Settings_Main_Bool('acs_hud_settings_main','acs_minimap_simplified', true) && !thePlayer.IsCiri()) 
		{
			if (!ACS_Settings_Main_Bool('acs_hud_settings_main','acs_minimap_module_enabled', true))
			{
				tempX += ACS_MINIMAP_NO_MINIMAP_HUD_X*scale;
			}
			else
			{
				tempX += ACS_MINIMAP_X*scale;
			}
		}

		if ( hudModule == 'quests' && ACS_Settings_Main_Bool('acs_hud_settings_main','acs_minimap_simplified', true) && !thePlayer.IsCiri()) 
		{
			if (!ACS_Settings_Main_Bool('acs_hud_settings_main','acs_minimap_module_enabled', true))
			{
				if (ACS_Is_DLC_Installed('dlcvhud'))
				{
					tempY += ACS_QUESTS_NO_MINIMAP_HUD_Y_VLAD*scale;
				}
				else
				{
					tempY += ACS_QUESTS_NO_MINIMAP_HUD_Y*scale;
				}
			}
			else
			{
				if (ACS_Is_DLC_Installed('dlcvhud'))
				{
					tempY += ACS_QUESTS_Y_VLAD*scale;
				}
				else
				{
					tempY += ACS_QUESTS_Y*scale;
				}
			}
		}

		if (!ACS_Settings_Main_Bool('acs_hud_settings_positioning_all','acs_hud_positioning_enabled', false))
		{
			tempX = ( tempX - baseHud.ACS_GetResolutionWidth()/2 ) * ( theGame.GetUIHorizontalFrameScale() ) + baseHud.ACS_GetResolutionWidth()/2;

			tempY = ( tempY - baseHud.ACS_GetResolutionHeight()/2 ) * (theGame.GetUIVerticalFrameScale() ) + baseHud.ACS_GetResolutionHeight()/2;
		}

		l_flashModule.SetX(tempX);

		l_flashModule.SetY(tempY);

		if (hudModule == 'minimap')
		{
			if (ACS_Settings_Main_Bool('acs_hud_settings_main','acs_minimap_simplified', true) && !thePlayer.IsCiri()) 
			{
				if (!ACS_Settings_Main_Bool('acs_hud_settings_main','acs_minimap_module_enabled', true))
				{
					if (ACS_Is_DLC_Installed('dlcvhud'))
					{
						tempX = -ACS_MINIMAP_NO_MINIMAP_HUD_X_VLAD + ACS_CLOCK_NO_MINIMAP_HUD_X_VLAD;

						tempY = ACS_CLOCK_NO_MINIMAP_HUD_Y_VLAD;
					}
					else
					{
						tempX = -ACS_MINIMAP_NO_MINIMAP_HUD_X + ACS_CLOCK_NO_MINIMAP_HUD_X;

						tempY = ACS_CLOCK_NO_MINIMAP_HUD_Y;
					}
				}
				else
				{
					if (ACS_Is_DLC_Installed('dlcvhud'))
					{
						tempX = -ACS_MINIMAP_X_VLAD + ACS_CLOCK_X_VLAD;

						tempY = ACS_CLOCK_Y_VLAD;
					}
					else
					{
						tempX = -ACS_MINIMAP_X + ACS_CLOCK_X;

						tempY = ACS_CLOCK_Y;
					}
				}
			}
			else
			{
				tempX = acs_clock_init_x;

				tempY = acs_clock_init_y;
			}

			if (!ACS_Settings_Main_Bool('acs_hud_settings_positioning_all','acs_hud_positioning_enabled', false))
			{
				tempX = ( tempX - baseHud.ACS_GetResolutionWidth()/2 ) * ( theGame.GetUIHorizontalFrameScale() ) + baseHud.ACS_GetResolutionWidth()/2;

				tempY = ( tempY - baseHud.ACS_GetResolutionWidth()/2 ) * ( theGame.GetUIHorizontalFrameScale() ) + baseHud.ACS_GetResolutionWidth()/2;
			}

			l_flashModule.GetChildFlashSprite("mcWorldCondition").SetX(tempX);

			l_flashModule.GetChildFlashSprite("mcWorldCondition").SetY(tempY);

			if (ACS_Is_DLC_Installed('dlcvhud') 
			&& ACS_Settings_Main_Bool('acs_hud_settings_main','acs_minimap_simplified', true) 
			&& !thePlayer.IsCiri())
			{
				if (!ACS_Settings_Main_Bool('acs_hud_settings_main','acs_minimap_module_enabled', true))
				{
					l_flashModule.GetChildFlashSprite( "mcWorldCondition" ).GetChildFlashSprite( "textField" ).SetX(tempX + 840);

					l_flashModule.GetChildFlashSprite( "mcWorldCondition" ).GetChildFlashSprite( "textField" ).SetY(tempY + 109);
				}
				else
				{
					l_flashModule.GetChildFlashSprite( "mcWorldCondition" ).GetChildFlashSprite( "textField" ).SetX(tempX + 840);

					l_flashModule.GetChildFlashSprite( "mcWorldCondition" ).GetChildFlashSprite( "textField" ).SetY(tempY + 109);
				}
			}
		}
	}

	function ACS_HUD_Adjustment( GroupID, XVarID, YVarID, axis : name, Cx, Cy : float ) : float 
	{  
		var HUD_GroupID, HUD_XVarID, HUD_YVarID : name; 
		var HUD_Cx, HUD_Cy : float;
		var X, Y, N        : float;
		
		N = 0.0025; // Normalizing constant for menu slider range. Slider range * N = 1

		HUD_GroupID = GroupID;
		HUD_XVarID  = XVarID; HUD_Cx = Cx;
		HUD_YVarID  = YVarID; HUD_Cy = Cy;

		if (axis == 'X') 
		{ 
			X = StringToFloat(theGame.GetInGameConfigWrapper().GetVarValue(HUD_GroupID, HUD_XVarID));
		
			return (X*N+HUD_Cx)*1920;			
		} 	
		else 
		{ 
			Y = StringToFloat(theGame.GetInGameConfigWrapper().GetVarValue(HUD_GroupID, HUD_YVarID));
			
			return -((Y*N-1)+HUD_Cy)*1080; // Minus sign and -1 are to make larger values equal higher positioning, i.e flip vertical axis			
		}
	}

	////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	function HudModulesAutoHide()
	{
		var hud 															: CR4ScriptedHud;
		var hudWolfHeadModule 												: CR4HudModuleWolfHead;	
		var hudItemModule 													: CR4HudModuleItemInfo;	
		var moduleMinimap, moduleQuest, moduleControls, moduleBuffs 		: CR4HudModuleBase;
		var l_buffsHud														: CR4HudModuleBuffs;

		if( 
		theGame.IsDialogOrCutscenePlaying() 
		|| theGame.GetPhotomodeEnabled() 
		|| thePlayer.IsInCutsceneIntro() 
		)
		{
			return;
		}

		hud = (CR4ScriptedHud)theGame.GetHud();

		moduleMinimap = (CR4HudModuleBase)hud.GetHudModule("Minimap2Module");

		moduleQuest = (CR4HudModuleBase)hud.GetHudModule("QuestsModule");

		moduleControls = (CR4HudModuleBase)hud.GetHudModule("ControlsFeedbackModule");

		moduleBuffs = (CR4HudModuleBase)hud.GetHudModule("BuffsModule");

		l_buffsHud = (CR4HudModuleBuffs)theGame.GetHud().GetHudModule( 'BuffsModule' );

		hudWolfHeadModule = (CR4HudModuleWolfHead)hud.GetHudModule( "WolfHeadModule" );

		hudItemModule = (CR4HudModuleItemInfo)hud.GetHudModule("ItemInfoModule");

		if (!hud)
		{
			if (FactsQuerySum("ACS_Minimap_Module_Hide") > 0)
			{
				FactsRemove("ACS_Minimap_Module_Hide");
			}

			if (FactsQuerySum("ACS_Quest_Module_Hide") > 0)
			{
				FactsRemove("ACS_Quest_Module_Hide");
			}

			if (FactsQuerySum("ACS_Control_Hint_Module_Hide") > 0)
			{
				FactsRemove("ACS_Control_Hint_Module_Hide");
			}

			if (FactsQuerySum("ACS_Buffs_Module_Hide") > 0)
			{
				FactsRemove("ACS_Buffs_Module_Hide");
			}

			if (FactsQuerySum("ACS_WolfHeadHud_Module_Hide") > 0)
			{
				FactsRemove("ACS_WolfHeadHud_Module_Hide");
			}

			if (FactsQuerySum("ACS_ItemHud_Module_Hide") > 0)
			{
				FactsRemove("ACS_ItemHud_Module_Hide");
			}

			if ( FactsQuerySum("ACS_Minimap_Module_Hide") <= 0 )
			{
				minimapAlphaMin = 0;

				RemoveTimer('MinimapModuleFadeFlashObjectIn');

				RemoveTimer('MinimapModuleDespawnDelay');
				AddTimer('MinimapModuleDespawnDelay', ACS_Settings_Main_Float('acs_hud_settings_main','acs_hud_elements_despawn_delay', 7) , false);

				FactsAdd("ACS_Minimap_Module_Hide", 1, -1);
			}

			if ( FactsQuerySum("ACS_Quest_Module_Hide") <= 0 )
			{
				questAlphaMin = 0;

				RemoveTimer('QuestModuleFadeFlashObjectIn');

				RemoveTimer('QuestModuleDespawnDelay');
				AddTimer('QuestModuleDespawnDelay', ACS_Settings_Main_Float('acs_hud_settings_main','acs_hud_elements_despawn_delay', 7) , false);

				FactsAdd("ACS_Quest_Module_Hide", 1, -1);
			}

			if ( FactsQuerySum("ACS_Control_Hint_Module_Hide") <= 0 )
			{
				controlHintAlphaMin = 0;

				RemoveTimer('ControlHintModuleFadeFlashObjectIn');

				RemoveTimer('ControlHintModuleDespawnDelay');
				AddTimer('ControlHintModuleDespawnDelay', ACS_Settings_Main_Float('acs_hud_settings_main','acs_hud_elements_despawn_delay', 7) , false);

				FactsAdd("ACS_Control_Hint_Module_Hide", 1, -1);
			}

			if ( FactsQuerySum("ACS_Buffs_Module_Hide") <= 0 )
			{
				buffsAlphaMin = 0;

				RemoveTimer('BuffsModuleFadeFlashObjectIn');

				RemoveTimer('BuffsModuleDespawnDelay');
				AddTimer('BuffsModuleDespawnDelay', ACS_Settings_Main_Float('acs_hud_settings_main','acs_hud_elements_despawn_delay', 7) , false);

				FactsAdd("ACS_Buffs_Module_Hide", 1, -1);
			}

			if ( FactsQuerySum("ACS_WolfHeadHud_Module_Hide") <= 0 )
			{
				wolfsHeadHudAlphaMin = 0;

				RemoveTimer('WolfHeadHudModuleFadeFlashObjectIn');

				RemoveTimer('WolfHeadHudModuleDespawnDelay');

				if (FactsQuerySum("ACS_WolfHeadHud_Module_Shown") <= 0)
				{
					FactsAdd("ACS_WolfHeadHud_Module_Shown", 1, -1);
				}

				if (FactsQuerySum("ACS_WolfHeadHud_Module_Fading") > 0)
				{
					FactsRemove("ACS_WolfHeadHud_Module_Fading");
				}

				AddTimer('WolfHeadHudModuleDespawnDelay', ACS_Settings_Main_Float('acs_hud_settings_main','acs_hud_elements_despawn_delay', 7) , false);

				FactsAdd("ACS_WolfHeadHud_Module_Hide", 1, -1);
			}

			if ( FactsQuerySum("ACS_ItemHud_Module_Hide") <= 0 )
			{
				itemsHudAlphaMin = 0;

				RemoveTimer('ItemHudModuleFadeFlashObjectIn');

				RemoveTimer('ItemHudModuleDespawnDelay');

				if (FactsQuerySum("ACS_ItemHud_Module_Shown") <= 0)
				{
					FactsAdd("ACS_ItemHud_Module_Shown", 1, -1);
				}

				if (FactsQuerySum("ACS_ItemHud_Module_Fading") > 0)
				{
					FactsRemove("ACS_ItemHud_Module_Fading");
				}

				AddTimer('ItemHudModuleDespawnDelay', ACS_Settings_Main_Float('acs_hud_settings_main','acs_hud_elements_despawn_delay', 7) , false);

				FactsAdd("ACS_ItemHud_Module_Hide", 1, -1);
			}

			if (HudSettingsCheck('WolfHeadModule') && FactsQuerySum("ACS_WolfHeadHud_Module_Shown") > 0)
			{
				if (hudWolfHeadModule.GetEnabled())
				{
					hudWolfHeadModule.SetEnabled(false);

					hud.UpdateHUD();
				}

				FactsRemove("ACS_WolfHeadHud_Module_Shown");
			}

			if (HudSettingsCheck('ItemInfoModule') && FactsQuerySum("ACS_ItemHud_Module_Shown") > 0)
			{
				if (hudItemModule.GetEnabled())
				{
					hudItemModule.SetEnabled(false);

					hud.UpdateHUD();
				}

				FactsRemove("ACS_ItemHud_Module_Shown");
			}

			return;
		}

		HUDModuleUpdatePosition('enemy');

		HUDModuleUpdatePosition('companionBar');

		HUDModuleUpdatePosition('bossBar');

		HUDModuleUpdatePosition('boatHealth');

		HUDModuleUpdatePosition('oxygenBar');

		HUDModuleUpdatePosition('horsePanicBar');

		HUDModuleUpdatePosition('horseStaminaBar');

		HUDModuleUpdatePosition('console');

		HUDModuleUpdatePosition('controlsFeedback');

		HUDModuleUpdatePosition('damagedItems');

		HUDModuleUpdatePosition('itemInfo');

		HUDModuleUpdatePosition('wolfMedallion');

		if (!ACS_Is_DLC_Installed('dlcvhud'))
		{
			HUDModuleUpdatePosition('buffs');
		}
		
		HUDModuleUpdatePosition('quests');

		HUDModuleUpdatePosition('minimap');

		//HUDModuleUpdatePosition('journal');

		//HUDModuleUpdatePosition('message');

		HUDModuleUpdatePosition('areainfo');

		if (RadialMenuCheck())
		{
			if ( !HudSettingsCheck('Minimap2Module') && FactsQuerySum("ACS_Minimap_Module_Hide") > 0)
			{
				RemoveTimer('MinimapModuleDespawnDelay');

				RemoveTimer('MinimapModuleFadeFlashObjectOut');

				minimapAlpha = 100;

				moduleMinimap.SetEnabled(true);

				moduleMinimap.GetModuleFlash().SetAlpha( 100 );

				FactsRemove("ACS_Minimap_Module_Hide");
			}

			if (!HudSettingsCheck('QuestsModule') && FactsQuerySum("ACS_Quest_Module_Hide") > 0)
			{
				RemoveTimer('QuestModuleDespawnDelay');

				RemoveTimer('QuestModuleFadeFlashObjectOut');

				questAlpha = 100;

				moduleQuest.SetEnabled(true);

				moduleQuest.GetModuleFlash().SetAlpha( 100 );

				FactsRemove("ACS_Quest_Module_Hide");
			}

			if (HudSettingsCheck('ControlsFeedbackModule') && FactsQuerySum("ACS_Control_Hint_Module_Hide") > 0)
			{
				RemoveTimer('ControlHintModuleDespawnDelay');

				RemoveTimer('ControlHintModuleFadeFlashObjectOut');

				controlHintAlpha = 100;

				moduleControls.SetEnabled(true);

				moduleControls.GetModuleFlash().SetAlpha( 100 );

				FactsRemove("ACS_Control_Hint_Module_Hide");
			}

			if (HudSettingsCheck('BuffsModule') && FactsQuerySum("ACS_Buffs_Module_Hide") > 0)
			{
				RemoveTimer('BuffsModuleDespawnDelay');

				RemoveTimer('BuffsModuleFadeFlashObjectOut');

				buffsAlpha = 100;

				l_buffsHud.SetDisplayBuffs( true );

				moduleBuffs.SetEnabled(true);
				
				moduleBuffs.GetModuleFlash().SetAlpha( 100 );

				FactsRemove("ACS_Buffs_Module_Hide");
			}

			if (HudSettingsCheck('WolfHeadModule'))
			{
				hudWolfHeadModule.SetAlwaysDisplayed(true);
				hudWolfHeadModule.SetEnabled(true);

				if (FactsQuerySum("ACS_WolfHeadHud_Module_Hide") > 0)
				{

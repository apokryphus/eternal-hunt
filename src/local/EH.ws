						caranthirAnimatedComponentA.PlaySlotAnimationAsync ( 'weak_rift_02', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.5f, 0.85f));

						AddTimer('ACS_Caranthir_Meteorite_Storm_Delay', 1 , false);

						break;

						case 2:

						caranthirAnimatedComponentA.PlaySlotAnimationAsync ( 'weak_rift_08', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.5f, 0.85f));

						AddTimer('ACS_Caranthir_Ice_Spike_Delay_1', 1 , false);

						AddTimer('ACS_Caranthir_Ice_Spike_Delay_2', 3 , false);

						AddTimer('ACS_Caranthir_Ice_Spike_Delay_3', 5 , false);

						break;	

						case 1:

						caranthirAnimatedComponentA.PlaySlotAnimationAsync ( 'weak_spell_staff_01', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.5f, 0.85f));

						AddTimer('ACS_Caranthir_Ice_Spear_Summon_Delay', 0.5 , false);

						break;

						default:

						caranthirAnimatedComponentA.PlaySlotAnimationAsync ( 'weak_spell_hand_06', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.5f, 0.85f));

						vACS_Caranthir_Ice_Spear = new cACS_Caranthir_Abilities in this;
							
						vACS_Caranthir_Ice_Spear.ACS_Caranthir_Minion_Prep_Ice_Line_Engage();

						AddTimer('ACS_Caranthir_Summon_Minion_Delay', 2.5 , false);

						break;
					}
						
					this.previous_acs_caranthir_magic_index_1 = acs_caranthir_magic_index_1;
				}
			}
			else if ( targetDistance >= 20 * 20 )
			{
				if (ACS_canaris_teleport()
				)
				{
					ACS_refresh_canaris_teleport_cooldown();

					GetACSCanarisIceSpearSingle().BreakAttachment();
					GetACSCanarisIceSpearSingle().Destroy();

					RemoveTimer('ACS_Caranthir_Ice_Spear_Single_Fire_Delay_1');

					RemoveTimer('ACS_Caranthir_Ice_Spear_Single_Fire_Delay_2');

					RemoveTimer('ACS_Caranthir_Ice_Spear_Single_Fire_Delay_3');

					RemoveTimer('ACS_Caranthir_Summon_Golem_Delay');

					RemoveTimer('ACS_Caranthir_Meteorite_Storm_Delay');

					RemoveTimer('ACS_Caranthir_Ice_Spike_Delay_1');

					RemoveTimer('ACS_Caranthir_Ice_Spike_Delay_2');

					RemoveTimer('ACS_Caranthir_Ice_Spike_Delay_3');

					RemoveTimer('ACS_Caranthir_Ice_Spear_Summon_Delay');

					RemoveTimer('ACS_Caranthir_Ice_Line_Single_Fire_Delay_1');

					RemoveTimer('ACS_Caranthir_Ice_Line_Single_Fire_Delay_2');

					if( ACSGetCActor('ACS_Canaris').IsAlive()) {ACSGetCActor('ACS_Canaris').ACS_ClearAnimationSpeedMultipliers();}	

					animatedComponentA.PlaySlotAnimationAsync ( 'strong_blink_land', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.5f, 0.5f));

					ACSGetCActor('ACS_Canaris').DestroyEffect('teleport_short');
					ACSGetCActor('ACS_Canaris').PlayEffectSingle('teleport_short');
					ACSGetCActor('ACS_Canaris').StopEffect('teleport_short');

					ACSGetCActor('ACS_Canaris').DestroyEffect('ice_armor');
					ACSGetCActor('ACS_Canaris').PlayEffectSingle('ice_armor');

					vACS_Caranthir_Ice_Spear = new cACS_Caranthir_Abilities in this;
				
					vACS_Caranthir_Ice_Spear.ACS_Caranthir_Teleport_FX_Engage();

					spawnPos = thePlayer.GetWorldPosition() + thePlayer.GetHeadingVector() * -3;

					if( !theGame.GetWorld().NavigationFindSafeSpot( spawnPos, 0.3, 0.3 , newSpawnPos ) )
					{
						theGame.GetWorld().NavigationFindSafeSpot( spawnPos, 0.3, 10 , newSpawnPos );
						spawnPos = newSpawnPos;
					}

					ACSGetCActor('ACS_Canaris').Teleport(ACSFixZAxis(spawnPos));

					/*
					if( !ACSGetCActor('ACS_Canaris').HasTag('ACS_Summoned_Rats') )
					{
						ACSGetCActor('ACS_Canaris').AddTag('ACS_Summoned_Rats');

						animatedComponentA.PlaySlotAnimationAsync ( 'weak_spell_hand_01', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));

						AddTimer('RatMageSummonRats', 1 , false);
					}
					else
					{

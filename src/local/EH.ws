								else if ( ACS_GetItem_Sword_IsEquipped('spear_silver', 'silver') )
								{	
									Attack_Setup_16('FocusModeSpearHeavyAttack');
								}
								else if ( ACS_GetItem_Sword_IsEquipped('greg_silver', 'silver') )
								{	
									Attack_Setup_17('FocusModeGregHeavyAttack');
								}
								else if ( ACS_GetItem_Sword_IsEquipped('olgierd_silver', 'silver') )
								{	
									Attack_Setup_17('FocusModeOlgierdHeavyAttack');
								}
								else if ( ACS_GetItem_Sword_IsEquipped('shield_sword_silver', 'silver') )
								{	
									Attack_Setup_18('FocusModeEredinShieldHeavyAttack');
								}
								else if ( ACS_GetItem_Sword_IsEquipped('imlerith_moveset_silver', 'silver') )
								{	
									Attack_Setup_18('FocusModeImlerithHeavyAttack');
								}
								else if ( ACS_GetItem_Sword_IsEquipped('claws_silver', 'silver') )
								{	
									Attack_Setup_19('FocusModeClawHeavyAttack');
								}
								else if ( ACS_GetItem_Sword_IsEquipped('katana_silver', 'silver') )
								{
									Attack_Setup_17('FocusModeGregHeavyAttack');
								}
								else if ( ACS_GetItem_Sword_IsEquipped('jingubang_steel', 'steel') || ACS_GetItem_Sword_IsEquipped('jingubang_silver', 'silver') )
								{
									Attack_Setup_16('FocusModeJinguBangHeavyAttack');
								}
								else
								{	
									if ( ACS_GetItem_VampClaw('normal') 
									|| ACS_GetItem_VampClaw('shades')
									)
									{
										Attack_Setup_09('GeraltVampireClawSwordHybridHeavyAttack');
									}
									else
									{	
										DefaultSwitch();
										//ACS_Setup_Heavy_Attack_Internal();
										GeraltHeavyAttack();
									}
								}
							}
							else if (thePlayer.IsWeaponHeld('steelsword'))
							{
								if ( ACS_GetItem_Sword_IsEquipped('hammer_steel', 'steel') )
								{
									Attack_Setup_15('FocusModeGiantHeavyAttack');
								}
								else if ( ACS_GetItem_Sword_IsEquipped('axe_steel', 'steel') || ACS_GetItem_Sword_IsEquipped('nithral_steel', 'steel'))
								{
									Attack_Setup_16('FocusModeAxeHeavyAttack');
								}
								else if ( ACS_GetItem_Sword_IsEquipped('spear_steel', 'steel') )
								{	
									Attack_Setup_16('FocusModeSpearHeavyAttack');
								}
								else if ( ACS_GetItem_Sword_IsEquipped('greg_steel', 'steel') )
								{	
									Attack_Setup_17('FocusModeGregHeavyAttack');
								}
								else if ( ACS_GetItem_Sword_IsEquipped('olgierd_steel', 'steel') )
								{	
									Attack_Setup_17('FocusModeOlgierdHeavyAttack');
								}
								else if ( ACS_GetItem_Sword_IsEquipped('eredin_steel', 'steel') || ACS_GetItem_Sword_IsEquipped('shield_sword_steel', 'steel') )
								{	
									Attack_Setup_18('FocusModeEredinShieldHeavyAttack');
								}
								else if (  ACS_GetItem_Sword_IsEquipped('caretaker_shovel_steel', 'steel') || ACS_GetItem_Sword_IsEquipped('imlerith_steel', 'steel') || ACS_GetItem_Sword_IsEquipped('imlerith_moveset_steel', 'steel') )
								{	
									Attack_Setup_18('FocusModeImlerithHeavyAttack');
								}
								else if ( ACS_GetItem_Sword_IsEquipped('claws_steel', 'steel') )
								{	
									Attack_Setup_19('FocusModeClawHeavyAttack');
								}
								else if ( ACS_GetItem_Sword_IsEquipped('katana_steel', 'steel') )
								{
									Attack_Setup_17('FocusModeGregHeavyAttack');
								}
								else if (thePlayer.GetInventory().ItemHasTag( thePlayer.GetInventory().GetCurrentlyHeldSword(), 'acsmagestaff' ))
								{
									Attack_Setup_16('FocusModeMageHeavyAttack');
								}
								else if ( ACS_GetItem_Sword_IsEquipped('jingubang_steel', 'steel') || ACS_GetItem_Sword_IsEquipped('jingubang_silver', 'silver') )
								{
									Attack_Setup_16('FocusModeJinguBangHeavyAttack');
								}
								else
								{	
									if ( ACS_GetItem_VampClaw('normal') 
									|| ACS_GetItem_VampClaw('shades')
									)
									{
										Attack_Setup_09('GeraltVampireClawSwordHybridHeavyAttack');
									}
									else
									{	
										DefaultSwitch();
										//ACS_Setup_Heavy_Attack_Internal();
										GeraltHeavyAttack();
									}
								}
							}
						}
						else
						{
							DefaultSwitch();
							//ACS_Setup_Heavy_Attack_Internal();
							GeraltHeavyAttack();
						}

						heavy_attack_combo_chain_counter += 1;

						RemoveTimer('ResetComboCounter');

						AddTimer('ResetComboCounter', 4 , false );
					}
				}

				DeactivateThings();

				RemoveTimer('AddPlayerIsAttackingBounceArrowTag');
				AddTimer('AddPlayerIsAttackingBounceArrowTag', 0.0625 , false);

				RemoveTimer('RemovePlayerIsAttackingBounceArrowTag');
				AddTimer('RemovePlayerIsAttackingBounceArrowTag', 0.5 , false);

				RemoveTimer('ACS_ResetAnimation');
				RemoveTimer('ACS_ResetAnimation'); AddTimer('ACS_ResetAnimation', 0.5   , false);

				if ( AnimProgressCheck() )
				{
					if (thePlayer.IsInAir()
					|| thePlayer.IsFalling()
					)
					{
						if( ((CActor)thePlayer.GetTarget()) 
						&& ACS_AttitudeCheck ( ((CActor)thePlayer.GetTarget()) ) 
						&& thePlayer.IsInCombat() 
						&& theGame.GetEngineTimeAsSeconds() - last_air_strike_time > 1
						&& thePlayer.GetStat(BCS_Stamina) > 0
						)
						{
							last_air_strike_time = theGame.GetEngineTimeAsSeconds();

							if (!thePlayer.HasTag('ACS_Air_Time'))
							{
								thePlayer.EnableCollisions(false);

								movementAdjustor = thePlayer.GetMovingAgentComponent().GetMovementAdjustor();
									
								movementAdjustor.CancelAll();

								thePlayer.ACS_ClearAnimationSpeedMultipliers();

								if (thePlayer.IsAnyWeaponHeld() 
								&& !thePlayer.IsWeaponHeld('fist') 
								)
								{
									if(RandF() < 0.5)
									{
										PlayerPlayAnimation('aircollision_fwd_lf_land_sword');
									}
									else
									{
										PlayerPlayAnimation('aircollision_fwd_rf_land_sword');
									}
								}
								else
								{
									PlayerPlayAnimation('slide_trip_01');
								}

								thePlayer.RaiseEvent('ACS_ForceLegsFloatIdle');

								thePlayer.BlockAction( EIAB_CallHorse,			'ACS_Air_Time');
								thePlayer.BlockAction( EIAB_DrawWeapon, 		'ACS_Air_Time');
								thePlayer.BlockAction( EIAB_FastTravel, 		'ACS_Air_Time');
								thePlayer.BlockAction( EIAB_InteractionAction, 	'ACS_Air_Time');
								thePlayer.BlockAction( EIAB_UsableItem,			'ACS_Air_Time');
								thePlayer.BlockAction( EIAB_MeditationWaiting,	'ACS_Air_Time');
								thePlayer.BlockAction( EIAB_OpenMeditation,		'ACS_Air_Time');
								thePlayer.BlockAction( EIAB_RadialMenu,			'ACS_Air_Time');
								thePlayer.BlockAction( EIAB_Movement,			'ACS_Air_Time');
								thePlayer.BlockAction( EIAB_QuickSlots, 		'ACS_Air_Time');

								RemoveTimer('RemoveACSAirTime');
								AddTimer('RemoveACSAirTime', 2 , false);

								thePlayer.AddTag('ACS_Air_Time');
							}

							targetDistance = VecDistanceSquared2D( thePlayer.GetWorldPosition(), ((CActor)thePlayer.GetTarget()).GetWorldPosition() );

							if (targetDistance <= 25 * 25)
							{
								if (targetDistance > 5 * 5)
								{
									thePlayer.DestroyEffect('dodge_acs_armor');
									thePlayer.PlayEffectSingle('dodge_acs_armor');

									thePlayer.DestroyEffect('bruxa_dash_trails');
									thePlayer.PlayEffectSingle('bruxa_dash_trails');

									thePlayer.StopEffect('shadowdash_shockwave');

									thePlayer.PlayEffectSingle('shadowdash_shockwave');

									thePlayer.StopEffect('shadowdash_shockwave');
								}

								MovementAdjust('default');

								movementAdjustor.AdjustmentDuration( ticket, 0.25 );

								movementAdjustor.AdjustLocationVertically( ticket, true );

								movementAdjustor.RotateTowards(ticket, ((CActor)thePlayer.GetTarget()));

								movementAdjustor.SlideTowards( ticket, ((CActor)thePlayer.GetTarget()), distArmorSpecialDash, distArmorSpecialDash );

								ACS_StaminaDrain(1, true);
							}
						}
					}
					else
					{
						if (thePlayer.HasTag('ACS_Air_Time'))
						{
							RemoveTimer('Air_Time_Movement_Adjust_Delay');

							thePlayer.BlockAllActions( 'ACS_Air_Time_Init', false );

							thePlayer.EnableCollisions(true);

							thePlayer.RaiseEvent('ACS_FeetAdditiveEnd');

							thePlayer.UnblockAction( EIAB_CallHorse,			'ACS_Air_Time');
							thePlayer.UnblockAction( EIAB_DrawWeapon, 		'ACS_Air_Time');
							thePlayer.UnblockAction( EIAB_FastTravel, 		'ACS_Air_Time');
							thePlayer.UnblockAction( EIAB_InteractionAction, 	'ACS_Air_Time');
							thePlayer.UnblockAction( EIAB_UsableItem,			'ACS_Air_Time');
							thePlayer.UnblockAction( EIAB_MeditationWaiting,	'ACS_Air_Time');
							thePlayer.UnblockAction( EIAB_OpenMeditation,		'ACS_Air_Time');
							thePlayer.UnblockAction( EIAB_RadialMenu,			'ACS_Air_Time');
							thePlayer.UnblockAction( EIAB_Movement,			'ACS_Air_Time');
							thePlayer.UnblockAction( EIAB_QuickSlots, 		'ACS_Air_Time');

							thePlayer.RemoveTag('ACS_Air_Time');
						}

						if (thePlayer.HasTag('ACS_IsSwordWalking'))
						{
							thePlayer.RaiseEvent('ACS_SwordWalkAdditiveEnd');thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');RemoveTimer('CombatTauntDelay');thePlayer.RaiseEvent('ACS_SwordTauntEnd');

							thePlayer.RemoveTag('ACS_IsSwordWalking');
						}
					}
				}
			}
		}
	}

	

	function SpecialAttackSwitch()
	{
		var targetDistance 	: Float;

		if ( thePlayer.IsActionAllowed(EIAB_SpecialAttackLight) )
		{
			if (ACS_New_Replacers_Female_Active())
			{
				thePlayer.PrepareToAttack();
				thePlayer.SetPlayedSpecialAttackMissingResourceSound(false);
				thePlayer.AddTimer( 'IsSpecialLightAttackInputHeld', 0.00001 , true );
				return;
			}

			Rage_Counter_Manager(2);

			if ( !thePlayer.HasTag('ACS_IsPerformingFinisher')
			&& !thePlayer.HasTag('ACS_IsPerformingCombatDismember')
			&& !thePlayer.IsInHitAnim()
			&& !thePlayer.IsCrossbowHeld()
			&& ACS_BuffCheck()
			&& !thePlayer.HasTag('acs_in_wraith')
			&& !thePlayer.HasTag('ACS_Bruxa_Bite_Process')
			&& thePlayer.IsAnyWeaponHeld()
			&& !thePlayer.IsWeaponHeld('fist')
			&& !thePlayer.HasTag('acs_vampire_claws_equipped')
			)
			{
				DeactivateThings();

				ACS_ThingsThatShouldBeRemoved();

				ACS_ExplorationDelayHack(false, 3);

				thePlayer.SendAttackReactionEvent();

				thePlayer.ManageAerondightBuff(true);

				if ( thePlayer.inv.IsItemCrossbow( thePlayer.inv.GetItemFromSlot( 'l_weapon' ) ) )
				{
					thePlayer.OnRangedForceHolster(false, true, false);
				}

				if(thePlayer.HasTag('ACS_Shielded_Entity')){shield_play_anim();}

				//RemoveTimer('RemoveProcessWeaponCollisionTimerDelay');
				//RemoveTimer('AddProcessWeaponCollisionTimer');

				//AddTimer('AddProcessWeaponCollisionTimer', 0.05f , true);

				//AddTimer('RemoveProcessWeaponCollisionTimerDelay', 3 , false);

				if (thePlayer.HasTag('ACS_IsSwordWalking'))
				{
					thePlayer.RemoveTag('ACS_IsSwordWalking');
				}

				RemoveTimer('SwordTauntSwitch'); 
				RemoveTimer('SwordTauntRunningSwitch'); 

				theInput.ForceDeactivateAction('AttackLight');

				theInput.ForceDeactivateAction('AttackWithAlternateLight');
	
				if (ACS_GetWeaponMode() == 0 && !thePlayer.IsWeaponHeld( 'fist' ))
				{
					if( thePlayer.GetEquippedSign() == ST_Axii )
					{	
						if (ACS_Settings_Main_Int('acs_armiger_mode_settings','acs_armiger_axii_sign_weapon', 2) == 0)
						{
							PrimaryWeaponSwitch(); 

							GeraltSpecialLightAttack();
						}
						else if (ACS_Settings_Main_Int('acs_armiger_mode_settings','acs_armiger_axii_sign_weapon', 2) == 1)
						{
							Attack_Setup_20('ArmigerModeOlgierdSpecialAttack');
						}
						else if (ACS_Settings_Main_Int('acs_armiger_mode_settings','acs_armiger_axii_sign_weapon', 2) == 2)
						{
							Attack_Setup_19('ArmigerModeEredinShieldSpecialAttack');
						}
						else if (ACS_Settings_Main_Int('acs_armiger_mode_settings','acs_armiger_axii_sign_weapon', 2) == 3)
						{
							Attack_Setup_20('ArmigerModeClawSpecialAttack');
						}
						else if (ACS_Settings_Main_Int('acs_armiger_mode_settings','acs_armiger_axii_sign_weapon', 2) == 4)
						{
							Attack_Setup_20('ArmigerModeImlerithSpecialAttack');
						}
					}
					else if( thePlayer.GetEquippedSign() == ST_Quen)
					{	
						if (ACS_Settings_Main_Int('acs_armiger_mode_settings','acs_armiger_quen_sign_weapon', 1) == 0)
						{
							PrimaryWeaponSwitch(); 

							GeraltSpecialLightAttack();
						}
						else if (ACS_Settings_Main_Int('acs_armiger_mode_settings','acs_armiger_quen_sign_weapon', 1) == 1)
						{
							Attack_Setup_20('ArmigerModeOlgierdSpecialAttack');
						}
						else if (ACS_Settings_Main_Int('acs_armiger_mode_settings','acs_armiger_quen_sign_weapon', 1) == 2)
						{
							Attack_Setup_19('ArmigerModeEredinShieldSpecialAttack');
						}
						else if (ACS_Settings_Main_Int('acs_armiger_mode_settings','acs_armiger_quen_sign_weapon', 1) == 3)
						{
							Attack_Setup_20('ArmigerModeClawSpecialAttack');
						}
						else if (ACS_Settings_Main_Int('acs_armiger_mode_settings','acs_armiger_quen_sign_weapon', 1) == 4)
						{
							Attack_Setup_20('ArmigerModeImlerithSpecialAttack');
						}
					}
					else if( thePlayer.GetEquippedSign() == ST_Aard )
					{	
						if (ACS_Settings_Main_Int('acs_armiger_mode_settings','acs_armiger_aard_sign_weapon', 3) == 0)
						{
							PrimaryWeaponSwitch(); 

							GeraltSpecialLightAttack();
						}
						else if (ACS_Settings_Main_Int('acs_armiger_mode_settings','acs_armiger_aard_sign_weapon', 3) == 1)
						{
							Attack_Setup_20('ArmigerModeOlgierdSpecialAttack');
						}
						else if (ACS_Settings_Main_Int('acs_armiger_mode_settings','acs_armiger_aard_sign_weapon', 3) == 2)
						{
							Attack_Setup_19('ArmigerModeEredinShieldSpecialAttack');
						}
						else if (ACS_Settings_Main_Int('acs_armiger_mode_settings','acs_armiger_aard_sign_weapon', 3) == 3)
						{
							Attack_Setup_20('ArmigerModeClawSpecialAttack');
						}
						else if (ACS_Settings_Main_Int('acs_armiger_mode_settings','acs_armiger_aard_sign_weapon', 3) == 4)
						{
							Attack_Setup_20('ArmigerModeImlerithSpecialAttack');
						}
					}
					else if( thePlayer.GetEquippedSign() == ST_Yrden )
					{
						if (ACS_Settings_Main_Int('acs_armiger_mode_settings','acs_armiger_yrden_sign_weapon', 4) == 0)
						{
							PrimaryWeaponSwitch(); 

							GeraltSpecialLightAttack();
						}
						else if (ACS_Settings_Main_Int('acs_armiger_mode_settings','acs_armiger_yrden_sign_weapon', 4) == 1)
						{
							Attack_Setup_20('ArmigerModeOlgierdSpecialAttack');
						}
						else if (ACS_Settings_Main_Int('acs_armiger_mode_settings','acs_armiger_yrden_sign_weapon', 4) == 2)
						{
							Attack_Setup_19('ArmigerModeEredinShieldSpecialAttack');
						}
						else if (ACS_Settings_Main_Int('acs_armiger_mode_settings','acs_armiger_yrden_sign_weapon', 4) == 3)
						{
							Attack_Setup_20('ArmigerModeClawSpecialAttack');
						}
						else if (ACS_Settings_Main_Int('acs_armiger_mode_settings','acs_armiger_yrden_sign_weapon', 4) == 4)
						{
							Attack_Setup_20('ArmigerModeImlerithSpecialAttack');
						}
					}
					else if( thePlayer.GetEquippedSign() == ST_Igni )
					{	
						if (ACS_Settings_Main_Int('acs_armiger_mode_settings','acs_armiger_igni_sign_weapon', 0) == 0)
						{
							PrimaryWeaponSwitch(); 

							GeraltSpecialLightAttack();
						}
						else if (ACS_Settings_Main_Int('acs_armiger_mode_settings','acs_armiger_igni_sign_weapon', 0) == 1)
						{
							Attack_Setup_20('ArmigerModeOlgierdSpecialAttack');
						}
						else if (ACS_Settings_Main_Int('acs_armiger_mode_settings','acs_armiger_igni_sign_weapon', 0) == 2)
						{
							Attack_Setup_19('ArmigerModeEredinShieldSpecialAttack');
						}
						else if (ACS_Settings_Main_Int('acs_armiger_mode_settings','acs_armiger_igni_sign_weapon', 0) == 3)
						{
							Attack_Setup_20('ArmigerModeClawSpecialAttack');
						}
						else if (ACS_Settings_Main_Int('acs_armiger_mode_settings','acs_armiger_igni_sign_weapon', 0) == 4)
						{
							Attack_Setup_20('ArmigerModeImlerithSpecialAttack');
						}
					}
				}
				else if (ACS_GetWeaponMode() == 1 && !thePlayer.IsWeaponHeld( 'fist' ))
				{
					if (thePlayer.IsWeaponHeld('silversword'))
					{
						if( ACS_Settings_Main_Int('acs_focus_mode_settings','acs_focus_mode_silver_weapon', 0) == 0 )
						{
							PrimaryWeaponSwitch(); 

							GeraltSpecialLightAttack();
						}
						else if( ACS_Settings_Main_Int('acs_focus_mode_settings','acs_focus_mode_silver_weapon', 0) == 1 )
						{	
							Attack_Setup_21('FocusModeOlgierdSpecialAttack');
						}
						else if( ACS_Settings_Main_Int('acs_focus_mode_settings','acs_focus_mode_silver_weapon', 0) == 2 )
						{	
							Attack_Setup_22('FocusModeSpearSpecialAttack');
						}
						else if( ACS_Settings_Main_Int('acs_focus_mode_settings','acs_focus_mode_silver_weapon', 0) == 3)
						{	
							Attack_Setup_20('FocusModeEredinShieldSpecialAttack');
						}
						else if( ACS_Settings_Main_Int('acs_focus_mode_settings','acs_focus_mode_silver_weapon', 0) == 4 )
						{	
							Attack_Setup_23('FocusModeGregSpecialAttack');
						}
						else if( ACS_Settings_Main_Int('acs_focus_mode_settings','acs_focus_mode_silver_weapon', 0) == 5 )
						{
							Attack_Setup_22('FocusModeImlerithSpecialAttack');
						}
						else if( ACS_Settings_Main_Int('acs_focus_mode_settings','acs_focus_mode_silver_weapon', 0) == 6 )
						{	
							Attack_Setup_24('FocusModeGiantSpecialAttack');
						}
						else if( ACS_Settings_Main_Int('acs_focus_mode_settings','acs_focus_mode_silver_weapon', 0) == 7 )
						{	
							Attack_Setup_21('FocusModeClawSpecialAttack');
						}
						else if( ACS_Settings_Main_Int('acs_focus_mode_settings','acs_focus_mode_silver_weapon', 0) == 8 )
						{	
							Attack_Setup_24('FocusModeAxeSpecialAttack');
						}
					}
					else if (thePlayer.IsWeaponHeld('steelsword'))
					{
						if( ACS_Settings_Main_Int('acs_focus_mode_settings','acs_focus_mode_steel_weapon', 0) == 0 )
						{
							PrimaryWeaponSwitch(); 

							GeraltSpecialLightAttack();
						}
						else if( ACS_Settings_Main_Int('acs_focus_mode_settings','acs_focus_mode_steel_weapon', 0) == 1 )
						{	
							Attack_Setup_21('FocusModeOlgierdSpecialAttack');
						}
						else if( ACS_Settings_Main_Int('acs_focus_mode_settings','acs_focus_mode_steel_weapon', 0) == 2 )
						{	
							Attack_Setup_22('FocusModeSpearSpecialAttack');
						}
						else if( ACS_Settings_Main_Int('acs_focus_mode_settings','acs_focus_mode_steel_weapon', 0) == 3)
						{	
							Attack_Setup_20('FocusModeEredinShieldSpecialAttack');
						}
						else if( ACS_Settings_Main_Int('acs_focus_mode_settings','acs_focus_mode_steel_weapon', 0) == 4 )
						{	
							Attack_Setup_23('FocusModeGregSpecialAttack');
						}
						else if( ACS_Settings_Main_Int('acs_focus_mode_settings','acs_focus_mode_steel_weapon', 0) == 5 )
						{
							Attack_Setup_22('FocusModeImlerithSpecialAttack');
						}
						else if( ACS_Settings_Main_Int('acs_focus_mode_settings','acs_focus_mode_steel_weapon', 0) == 6 )
						{	
							Attack_Setup_24('FocusModeGiantSpecialAttack');
						}
						else if( ACS_Settings_Main_Int('acs_focus_mode_settings','acs_focus_mode_steel_weapon', 0) == 7 )
						{	
							Attack_Setup_21('FocusModeClawSpecialAttack');
						}
						else if( ACS_Settings_Main_Int('acs_focus_mode_settings','acs_focus_mode_steel_weapon', 0) == 8 )
						{	
							Attack_Setup_24('FocusModeAxeSpecialAttack');
						}
					}
				}
				else if ( ACS_GetWeaponMode() == 2 && !thePlayer.IsWeaponHeld( 'fist' ) )
				{
					if (Attack_Directional_Press_Check())
					{
						if ( ACS_Settings_Main_Int('acs_hybrid_mode_settings','acs_hybrid_forward_special_attack', 0) == 0 )
						{
							if (!thePlayer.HasTag('ACSHybridDefaultWeaponTicket')){thePlayer.AddTag('ACSHybridDefaultWeaponTicket');}

							PrimaryWeaponSwitch(); 

							GeraltSpecialLightAttack();
						}
						else if ( ACS_Settings_Main_Int('acs_hybrid_mode_settings','acs_hybrid_forward_special_attack', 0) == 1 )
						{
							if (!thePlayer.HasTag('ACSHybridOlgierdWeaponTicket')){thePlayer.AddTag('ACSHybridOlgierdWeaponTicket');}

							Attack_Setup_21('HybridModeOlgierdForwardSpecialAttack');
						}
						else if ( ACS_Settings_Main_Int('acs_hybrid_mode_settings','acs_hybrid_forward_special_attack', 0) == 2 )
						{
							if (!thePlayer.HasTag('ACSHybridEredinWeaponTicket')){thePlayer.AddTag('ACSHybridEredinWeaponTicket');}

							Attack_Setup_20('HybridModeEredinShieldForwardSpecialAttack');
						}
						else if ( ACS_Settings_Main_Int('acs_hybrid_mode_settings','acs_hybrid_forward_special_attack', 0) == 3 )
						{
							if (!thePlayer.HasTag('ACSHybridClawWeaponTicket')){thePlayer.AddTag('ACSHybridClawWeaponTicket');}

							Attack_Setup_22('HybridModeClawForwardSpecialAttack');
						}
						else if ( ACS_Settings_Main_Int('acs_hybrid_mode_settings','acs_hybrid_forward_special_attack', 0) == 4 )
						{
							if (!thePlayer.HasTag('ACSHybridImlerithWeaponTicket')){thePlayer.AddTag('ACSHybridImlerithWeaponTicket');}

							Attack_Setup_22('HybridModeImlerithForwardSpecialAttack');
						}
						else if ( ACS_Settings_Main_Int('acs_hybrid_mode_settings','acs_hybrid_forward_special_attack', 0) == 5 )
						{
							if (!thePlayer.HasTag('ACSHybridSpearWeaponTicket')){thePlayer.AddTag('ACSHybridSpearWeaponTicket');}

							Attack_Setup_23('HybridModeSpearForwardSpecialAttack');
						}
						else if ( ACS_Settings_Main_Int('acs_hybrid_mode_settings','acs_hybrid_forward_special_attack', 0) == 6 )
						{
							if (!thePlayer.HasTag('ACSHybridGregWeaponTicket')){thePlayer.AddTag('ACSHybridGregWeaponTicket');}

							Attack_Setup_23('HybridModeGregForwardSpecialAttack');
						}
						else if ( ACS_Settings_Main_Int('acs_hybrid_mode_settings','acs_hybrid_forward_special_attack', 0) == 7 )
						{
							if (!thePlayer.HasTag('ACSHybridAxeWeaponTicket')){thePlayer.AddTag('ACSHybridAxeWeaponTicket');}

							Attack_Setup_24('HybridModeAxeForwardSpecialAttack');
						}
						else if ( ACS_Settings_Main_Int('acs_hybrid_mode_settings','acs_hybrid_forward_special_attack', 0) == 8 )
						{
							if (!thePlayer.HasTag('ACSHybridGiantWeaponTicket')){thePlayer.AddTag('ACSHybridGiantWeaponTicket');}

							Attack_Setup_24('HybridModeGiantForwardSpecialAttack');
						}
					}
					else
					{
						if ( ACS_Settings_Main_Int('acs_hybrid_mode_settings','acs_hybrid_special_attack', 0) == 0 )
						{
							if (!thePlayer.HasTag('ACSHybridDefaultWeaponTicket')){thePlayer.AddTag('ACSHybridDefaultWeaponTicket');}

							PrimaryWeaponSwitch(); 

							GeraltSpecialLightAttack();
						}
						else if ( ACS_Settings_Main_Int('acs_hybrid_mode_settings','acs_hybrid_special_attack', 0) == 1 )
						{
							if (!thePlayer.HasTag('ACSHybridOlgierdWeaponTicket')){thePlayer.AddTag('ACSHybridOlgierdWeaponTicket');}

							Attack_Setup_21('HybridModeOlgierdSpecialAttack');
						}
						else if ( ACS_Settings_Main_Int('acs_hybrid_mode_settings','acs_hybrid_special_attack', 0) == 2 )
						{
							if (!thePlayer.HasTag('ACSHybridEredinWeaponTicket')){thePlayer.AddTag('ACSHybridEredinWeaponTicket');}

							Attack_Setup_20('HybridModeEredinShieldSpecialAttack');
						}
						else if ( ACS_Settings_Main_Int('acs_hybrid_mode_settings','acs_hybrid_special_attack', 0) == 3 )
						{
							if (!thePlayer.HasTag('ACSHybridClawWeaponTicket')){thePlayer.AddTag('ACSHybridClawWeaponTicket');}

							Attack_Setup_21('HybridModeClawSpecialAttack');
						}
						else if ( ACS_Settings_Main_Int('acs_hybrid_mode_settings','acs_hybrid_special_attack', 0) == 4 )
						{
							if (!thePlayer.HasTag('ACSHybridImlerithWeaponTicket')){thePlayer.AddTag('ACSHybridImlerithWeaponTicket');}

							Attack_Setup_22('HybridModeImlerithSpecialAttack');
						}
						else if ( ACS_Settings_Main_Int('acs_hybrid_mode_settings','acs_hybrid_special_attack', 0) == 5 )
						{
							if (!thePlayer.HasTag('ACSHybridSpearWeaponTicket')){thePlayer.AddTag('ACSHybridSpearWeaponTicket');}

							Attack_Setup_23('HybridModeSpearSpecialAttack');
						}
						else if ( ACS_Settings_Main_Int('acs_hybrid_mode_settings','acs_hybrid_special_attack', 0) == 6 )
						{
							if (!thePlayer.HasTag('ACSHybridGregWeaponTicket')){thePlayer.AddTag('ACSHybridGregWeaponTicket');}

							Attack_Setup_23('HybridModeGregSpecialAttack');
						}
						else if ( ACS_Settings_Main_Int('acs_hybrid_mode_settings','acs_hybrid_special_attack', 0) == 7 )
						{
							if (!thePlayer.HasTag('ACSHybridAxeWeaponTicket')){thePlayer.AddTag('ACSHybridAxeWeaponTicket');}

							Attack_Setup_24('HybridModeAxeSpecialAttack');
						}
						else if ( ACS_Settings_Main_Int('acs_hybrid_mode_settings','acs_hybrid_special_attack', 0) == 8 )
						{
							if (!thePlayer.HasTag('ACSHybridGiantWeaponTicket')){thePlayer.AddTag('ACSHybridGiantWeaponTicket');}
							
							Attack_Setup_24('HybridModeGiantSpecialAttack');
						}
					}
				}
				else if (ACS_GetWeaponMode() == 3 && !thePlayer.IsWeaponHeld( 'fist' ) )
				{
					if (thePlayer.IsWeaponHeld('silversword'))
					{
						if( ACS_GetItem_Sword_IsEquipped('shield_sword_silver', 'silver') )
						{	
							Attack_Setup_20('FocusModeEredinShieldSpecialAttack');
						}
						else if( ACS_GetItem_Sword_IsEquipped('olgierd_silver', 'silver') )
						{	
							Attack_Setup_21('EquipmentModeOlgierdSpecialAttack');
						}
						else if( ACS_GetItem_Sword_IsEquipped('claws_silver', 'silver') )
						{	
							Attack_Setup_21('FocusModeClawSpecialAttack');
						}
						else if( ACS_GetItem_Sword_IsEquipped('imlerith_moveset_silver', 'silver') )
						{
							Attack_Setup_22('FocusModeImlerithSpecialAttack');
						}
						else if( ACS_GetItem_Sword_IsEquipped('spear_silver', 'silver') )
						{	
							Attack_Setup_22('FocusModeSpearSpecialAttack');
						}
						else if( ACS_GetItem_Sword_IsEquipped('greg_silver', 'silver') )
						{	
							Attack_Setup_23('FocusModeGregSpecialAttack');
						}
						else if( ACS_GetItem_Sword_IsEquipped('hammer_silver', 'silver') )
						{	
							Attack_Setup_24('FocusModeGiantSpecialAttack');
						}
						else if( ACS_GetItem_Sword_IsEquipped('axe_silver', 'silver') )
						{	
							Attack_Setup_24('FocusModeAxeSpecialAttack');
						}
						else if( ACS_GetItem_Sword_IsEquipped('katana_silver', 'silver') )
						{	
							Attack_Setup_23('FocusModeGregSpecialAttack');
						}
						else if ( ACS_GetItem_Sword_IsEquipped('jingubang_steel', 'steel') || ACS_GetItem_Sword_IsEquipped('jingubang_silver', 'silver') )
						{
							Attack_Setup_22('FocusModeJinguBangSpecialAttack');
						}
						else
						{
							if ( ACS_GetItem_VampClaw('normal') 
							|| ACS_GetItem_VampClaw('shades')
							)
							{
								Attack_Setup_09('GeraltVampireClawSwordHybridSpecialAttack');
							}
							else
							{	
								DefaultSwitch();

								GeraltSpecialLightAttack();
							}
						}
					}
					else if (thePlayer.IsWeaponHeld('steelsword'))
					{
						if( ACS_GetItem_Sword_IsEquipped('eredin_steel', 'steel') || ACS_GetItem_Sword_IsEquipped('shield_sword_steel', 'steel') )
						{	
							Attack_Setup_20('FocusModeEredinShieldSpecialAttack');
						}
						else if( ACS_GetItem_Sword_IsEquipped('olgierd_steel', 'steel') )
						{	
							Attack_Setup_21('EquipmentModeOlgierdSpecialAttack');
						}
						else if( ACS_GetItem_Sword_IsEquipped('claws_steel', 'steel') )
						{	
							Attack_Setup_21('FocusModeClawSpecialAttack');
						}
						else if(  ACS_GetItem_Sword_IsEquipped('caretaker_shovel_steel', 'steel') || ACS_GetItem_Sword_IsEquipped('imlerith_steel', 'steel') || ACS_GetItem_Sword_IsEquipped('imlerith_moveset_steel', 'steel') )
						{
							Attack_Setup_22('FocusModeImlerithSpecialAttack');
						}
						else if( ACS_GetItem_Sword_IsEquipped('spear_steel', 'steel') )
						{	
							Attack_Setup_22('FocusModeSpearSpecialAttack');
						}
						else if( ACS_GetItem_Sword_IsEquipped('greg_steel', 'steel') )
						{	
							Attack_Setup_23('FocusModeGregSpecialAttack');
						}
						else if( ACS_GetItem_Sword_IsEquipped('hammer_steel', 'steel') )
						{	
							Attack_Setup_24('FocusModeGiantSpecialAttack');
						}
						else if( ACS_GetItem_Sword_IsEquipped('axe_steel', 'steel') || ACS_GetItem_Sword_IsEquipped('nithral_steel', 'steel'))
						{	
							Attack_Setup_24('FocusModeAxeSpecialAttack');
						}
						else if( ACS_GetItem_Sword_IsEquipped('katana_steel', 'steel') )
						{	
							Attack_Setup_23('FocusModeGregSpecialAttack');
						}
						else if (thePlayer.GetInventory().ItemHasTag( thePlayer.GetInventory().GetCurrentlyHeldSword(), 'acsmagestaff' ))
						{
							Attack_Setup_23('FocusModeMageSpecialAttack');
						}
						else if ( ACS_GetItem_Sword_IsEquipped('jingubang_steel', 'steel') || ACS_GetItem_Sword_IsEquipped('jingubang_silver', 'silver') )
						{
							Attack_Setup_22('FocusModeJinguBangSpecialAttack');
						}
						else
						{	
							if ( ACS_GetItem_VampClaw('normal') 
							|| ACS_GetItem_VampClaw('shades')
							)
							{
								Attack_Setup_09('GeraltVampireClawSwordHybridSpecialAttack');
							}
							else
							{	
								DefaultSwitch();		

								GeraltSpecialLightAttack();
							}
						}
					}
				}

				DeactivateThings();

				RemoveTimer('AddPlayerIsAttackingBounceArrowTag');
				AddTimer('AddPlayerIsAttackingBounceArrowTag', 0.0625 , false);

				RemoveTimer('RemovePlayerIsAttackingBounceArrowTag');
				AddTimer('RemovePlayerIsAttackingBounceArrowTag', 0.5 , false);

				if ( AnimProgressCheck() )
				{
					if (thePlayer.IsInAir()
					|| thePlayer.IsFalling()
					)
					{
						if( ((CActor)thePlayer.GetTarget()) 
						&& ACS_AttitudeCheck ( ((CActor)thePlayer.GetTarget()) ) 
						&& thePlayer.IsInCombat() 
						&& theGame.GetEngineTimeAsSeconds() - last_air_strike_time > 1
						&& thePlayer.GetStat(BCS_Stamina) > 0
						)
						{
							last_air_strike_time = theGame.GetEngineTimeAsSeconds();

							if (!thePlayer.HasTag('ACS_Air_Time'))
							{
								thePlayer.EnableCollisions(false);

								movementAdjustor = thePlayer.GetMovingAgentComponent().GetMovementAdjustor();
									
								movementAdjustor.CancelAll();

								thePlayer.ACS_ClearAnimationSpeedMultipliers();

								if (thePlayer.IsAnyWeaponHeld() 
								&& !thePlayer.IsWeaponHeld('fist') 
								)
								{
									if(RandF() < 0.5)
									{
										PlayerPlayAnimation('aircollision_fwd_lf_land_sword');
									}
									else
									{
										PlayerPlayAnimation('aircollision_fwd_rf_land_sword');
									}
								}
								else
								{
									PlayerPlayAnimation('slide_trip_01');
								}

								thePlayer.RaiseEvent('ACS_ForceLegsFloatIdle');

								thePlayer.BlockAction( EIAB_CallHorse,			'ACS_Air_Time');
								thePlayer.BlockAction( EIAB_DrawWeapon, 		'ACS_Air_Time');
								thePlayer.BlockAction( EIAB_FastTravel, 		'ACS_Air_Time');
								thePlayer.BlockAction( EIAB_InteractionAction, 	'ACS_Air_Time');
								thePlayer.BlockAction( EIAB_UsableItem,			'ACS_Air_Time');
								thePlayer.BlockAction( EIAB_MeditationWaiting,	'ACS_Air_Time');
								thePlayer.BlockAction( EIAB_OpenMeditation,		'ACS_Air_Time');
								thePlayer.BlockAction( EIAB_RadialMenu,			'ACS_Air_Time');
								thePlayer.BlockAction( EIAB_Movement,			'ACS_Air_Time');
								thePlayer.BlockAction( EIAB_QuickSlots, 		'ACS_Air_Time');

								RemoveTimer('RemoveACSAirTime');
								AddTimer('RemoveACSAirTime', 2 , false);

								thePlayer.AddTag('ACS_Air_Time');
							}

							targetDistance = VecDistanceSquared2D( thePlayer.GetWorldPosition(), ((CActor)thePlayer.GetTarget()).GetWorldPosition() );

							if (targetDistance <= 25 * 25)
							{
								if (targetDistance > 5 * 5)
								{
									thePlayer.DestroyEffect('dodge_acs_armor');
									thePlayer.PlayEffectSingle('dodge_acs_armor');

									thePlayer.DestroyEffect('bruxa_dash_trails');
									thePlayer.PlayEffectSingle('bruxa_dash_trails');

									thePlayer.StopEffect('shadowdash_shockwave');

									thePlayer.PlayEffectSingle('shadowdash_shockwave');

									thePlayer.StopEffect('shadowdash_shockwave');
								}

								MovementAdjust('default');

								movementAdjustor.AdjustmentDuration( ticket, 0.25 );

								movementAdjustor.AdjustLocationVertically( ticket, true );

								movementAdjustor.RotateTowards(ticket, ((CActor)thePlayer.GetTarget()));

								movementAdjustor.SlideTowards( ticket, ((CActor)thePlayer.GetTarget()), distArmorSpecialDash, distArmorSpecialDash );

								ACS_StaminaDrain(1, true);
							}
						}
					}
					else
					{
						if (thePlayer.HasTag('ACS_Air_Time'))
						{
							RemoveTimer('Air_Time_Movement_Adjust_Delay');

							thePlayer.BlockAllActions( 'ACS_Air_Time_Init', false );

							thePlayer.EnableCollisions(true);

							thePlayer.RaiseEvent('ACS_FeetAdditiveEnd');

							thePlayer.UnblockAction( EIAB_CallHorse,			'ACS_Air_Time');
							thePlayer.UnblockAction( EIAB_DrawWeapon, 		'ACS_Air_Time');
							thePlayer.UnblockAction( EIAB_FastTravel, 		'ACS_Air_Time');
							thePlayer.UnblockAction( EIAB_InteractionAction, 	'ACS_Air_Time');
							thePlayer.UnblockAction( EIAB_UsableItem,			'ACS_Air_Time');
							thePlayer.UnblockAction( EIAB_MeditationWaiting,	'ACS_Air_Time');
							thePlayer.UnblockAction( EIAB_OpenMeditation,		'ACS_Air_Time');
							thePlayer.UnblockAction( EIAB_RadialMenu,			'ACS_Air_Time');
							thePlayer.UnblockAction( EIAB_Movement,			'ACS_Air_Time');
							thePlayer.UnblockAction( EIAB_QuickSlots, 		'ACS_Air_Time');

							thePlayer.RemoveTag('ACS_Air_Time');
						}

						if (thePlayer.HasTag('ACS_IsSwordWalking'))
						{
							thePlayer.RaiseEvent('ACS_SwordWalkAdditiveEnd');thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');RemoveTimer('CombatTauntDelay');thePlayer.RaiseEvent('ACS_SwordTauntEnd');

							thePlayer.RemoveTag('ACS_IsSwordWalking');
						}
					}
				}
			}
		}
	}

	

	var vClawEquipStandalone : cClawEquipStandalone;

	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	var last_light_attack_time							: float;
	var last_heavy_attack_time							: float;
	var last_parry_skill_time							: float;
	var last_parry_skill_doubletap_time					: float;
	var last_guard_attack_time							: float;
	var last_guard_doubletap_attack_time				: float;
	var last_special_attack_time						: float;
	var last_bruxa_dash_time							: float;
	var last_dodge_time									: float;
	var last_special_dodge_time							: float;
	var last_shoot_bow_moving_time						: float;
	var last_shoot_shotgun_light_attack_time			: float;
	var last_shoot_shotgun_heavy_attack_time			: float;

	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	function ACS_can_perform_light_attack(): bool 
	{
		var cooldown : float;

		cooldown = ACS_Settings_Main_Float('acs_combat_main_settings','acs_light_attack_cooldown', 0.5);

		if( thePlayer.GetStat( BCS_Focus ) < thePlayer.GetStatMax( BCS_Focus )/3) 
		{
			cooldown -= 0;
		}
		else if( thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus )/3
		&& thePlayer.GetStat( BCS_Focus ) < thePlayer.GetStatMax( BCS_Focus ) * 2/3) 
		{	
			cooldown -= 0.1;
		}
		else if( thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus ) * 2/3)
		{	
			cooldown -= 0.2;
		}

		if (!ACS_Settings_Main_Bool('acs_dodge_settings','acs_allow_attacking_while_in_dodge_animation', true))
		{
			if (thePlayer.IsCurrentlyDodging() 
			|| thePlayer.HasTag('ACS_Is_Currently_Dodging')
			)
			{
				return false;
			}
		}

		return (theGame.GetEngineTimeAsSeconds() - last_light_attack_time > cooldown) ;
	}

	function ACS_refresh_light_attack_cooldown() 
	{
		var animatedComponentA 	: CAnimatedComponent;
		
		last_light_attack_time = theGame.GetEngineTimeAsSeconds();

		if (GetWitcherPlayer().HasTag('ACS_Special_Dodge'))
		{
			GetWitcherPlayer().RemoveTag('ACS_Special_Dodge');
		}

		if(!ACS_GetItem_Sword_IsEquipped('jingubang_steel', 'steel') || ACS_GetItem_Sword_IsEquipped('jingubang_silver', 'silver'))
		{
			thePlayer.RaiseEvent('ACS_SwordWalkAdditiveEnd');thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');RemoveTimer('CombatTauntDelay');thePlayer.RaiseEvent('ACS_SwordTauntEnd');
		}

		if (combatExtraActive)
		{
			RemoveTimer('combatExtraReset');

			thePlayer.RaiseEvent('ACS_CombatExtraReset');

			combatExtraActive = false;
		}

		if (idleAdditiveExtraActive)
		{
			thePlayer.RaiseEvent('ACS_IdleAdditiveReset');

			SetIdleAdditiveExtraStatus(false);
		}

		if (thePlayer.HasTag('ACS_SwordBuffAnimationPlayed'))
		{
			thePlayer.RaiseEvent('ACS_BothHandsAdditiveEnd');

			thePlayer.RemoveTag('ACS_SwordBuffAnimationPlayed');
		}

		RemoveSneaking(false);

		animatedComponentA = (CAnimatedComponent)thePlayer.GetComponentByClassName( 'CAnimatedComponent' );

		animatedComponentA.UnfreezePose(); animatedComponentA.UnfreezePoseFadeOut(0.01f);
	}

	function ACS_can_perform_heavy_attack(): bool 
	{
		var cooldown : float;

		cooldown = ACS_Settings_Main_Float('acs_combat_main_settings','acs_heavy_attack_cooldown', 0.5);

		if( thePlayer.GetStat( BCS_Focus ) < thePlayer.GetStatMax( BCS_Focus )/3) 
		{
			cooldown -= 0;
		}
		else if( thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus )/3
		&& thePlayer.GetStat( BCS_Focus ) < thePlayer.GetStatMax( BCS_Focus ) * 2/3) 
		{	
			cooldown -= 0.1;
		}
		else if( thePlayer.GetStat( BCS_Focus ) >= thePlayer.GetStatMax( BCS_Focus ) * 2/3)
		{	
			cooldown -= 0.2;
		}

		if (!ACS_Settings_Main_Bool('acs_dodge_settings','acs_allow_attacking_while_in_dodge_animation', true))
		{
			if (thePlayer.IsCurrentlyDodging() 
			|| thePlayer.HasTag('ACS_Is_Currently_Dodging')
			)
			{
				return false;
			}
		}

		return (theGame.GetEngineTimeAsSeconds() - last_heavy_attack_time > cooldown) ;
	}

	function ACS_refresh_heavy_attack_cooldown() 
	{
		var animatedComponentA 	: CAnimatedComponent;

		last_heavy_attack_time = theGame.GetEngineTimeAsSeconds();

		if (GetWitcherPlayer().HasTag('ACS_Special_Dodge'))
		{
			GetWitcherPlayer().RemoveTag('ACS_Special_Dodge');
		}

		if(!ACS_GetItem_Sword_IsEquipped('jingubang_steel', 'steel') || ACS_GetItem_Sword_IsEquipped('jingubang_silver', 'silver'))
		{
			thePlayer.RaiseEvent('ACS_SwordWalkAdditiveEnd');thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');RemoveTimer('CombatTauntDelay');thePlayer.RaiseEvent('ACS_SwordTauntEnd');
		}

		if (combatExtraActive)
		{
			RemoveTimer('combatExtraReset');
			
			thePlayer.RaiseEvent('ACS_CombatExtraReset');

			combatExtraActive = false;
		}

		if (idleAdditiveExtraActive)
		{
			thePlayer.RaiseEvent('ACS_IdleAdditiveReset');

			SetIdleAdditiveExtraStatus(false);

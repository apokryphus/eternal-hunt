	public timer function CloakAnimProgressSet(deltaTime : float , id : int)
	{
		cloakaniminprogress = false;
	}

	function FurCloakControl() : bool
	{
		if (
		ACS_Settings_Main_Int ('acs_player_equipment_visual_settings','acs_fur_cloak_options', 1) == 0
		)
		{
			return false;
		}

		if (
		(theGame.GetWorld().GetDepotPath() == "levels\skellige\skellige.w2w"
		|| theGame.GetWorld().GetDepotPath() == "levels\prolog_village_winter\prolog_village.w2w")
		&& ACS_Settings_Main_Int ('acs_player_equipment_visual_settings','acs_fur_cloak_options', 1) == 1
		)
		{
			return true;
		}

		if (
		ACS_Settings_Main_Int ('acs_player_equipment_visual_settings','acs_fur_cloak_options', 1) == 2
		)
		{
			return true;
		}

		return false;
	}

	public timer function CloakToggleDelay(deltaTime : float , id : int)
	{
		var p_comp												: CComponent;
		var temp, tempfur1										: CEntityTemplate;
		var steelitem, silveritem, steelid, silverid 			: SItemUniqueId;
		var cloakIDs 											: array<SItemUniqueId>;
		var cloakID 											: SItemUniqueId;
		var equippedItemsId 									: array<SItemUniqueId>;
		var i 													: int;
		var dyeColor											: name;
		var hoodId, dyeId										: array<SItemUniqueId>;

		thePlayer.SoundEvent("monster_dettlaff_monster_movement_wing_flap_short_soft");

		p_comp = thePlayer.GetComponentByClassName( 'CAppearanceComponent' );

		temp = (CEntityTemplate)LoadResource(

		"dlc\dlc_acs\data\armor\old_stuff\berserkercape.w2ent"
		
		, true);

		tempfur1 = (CEntityTemplate)LoadResource(

		"dlc\dlc_acs\data\armor\old_stuff\fur\red_fur_black.w2ent"
		
		, true);

		GetWitcherPlayer().GetItemEquippedOnSlot(EES_SilverSword, silverid);
		GetWitcherPlayer().GetItemEquippedOnSlot(EES_SteelSword, steelid);

		if ( FactsQuerySum("ACS_Cloak_Equipped") <= 0 )
		{
			if (
			FurCloakControl()
			)
			{
				((CAppearanceComponent)p_comp).IncludeAppearanceTemplate(tempfur1);
			}

			if( (thePlayer.inv.HasItem( 'KM Cloak' ) && thePlayer.inv.HasItem( 'KM Pointy Cloak' ))
			|| (!thePlayer.inv.HasItem( 'KM Cloak' ) && !thePlayer.inv.HasItem( 'KM Pointy Cloak' ))
			)
			{
				((CAppearanceComponent)p_comp).IncludeAppearanceTemplate(temp);
			}
			else if( thePlayer.inv.HasItem( 'KM Cloak Lowered' ) )
			{
				dyeColor = thePlayer.inv.GetItemColor( thePlayer.inv.GetItemId('KM Cloak Lowered') );

				thePlayer.GetInventory().RemoveItemByName('KM Cloak', -1);

				thePlayer.GetInventory().RemoveItemByName('KM Pointy Cloak', -1);

				thePlayer.GetInventory().RemoveItemByName('KM Cloak Lowered', -1);

				if (FactsQuerySum("ACS_Player_Using_KM_Pointy_Cloak") > 0)
				{
					hoodId = thePlayer.inv.AddAnItem('KM Pointy Cloak', 1, true, true);
				}
				else if (FactsQuerySum("ACS_Player_Using_KM_Cloak") > 0)
				{
					hoodId = thePlayer.inv.AddAnItem('KM Cloak', 1, true, true);
				}
				else
				{
					hoodId = thePlayer.inv.AddAnItem('KM Cloak', 1, true, true);
				}
				
				dyeId = thePlayer.inv.AddAnItem(dyeColor, 1, true, true);
				thePlayer.inv.ColorItem(hoodId[0], dyeId[0]);
				thePlayer.inv.RemoveItem( dyeId[0], 1 );
				thePlayer.EquipItem( hoodId[0] );
				
				if (hoodtoggle)
				{
					Hood_Exclude();
				}
			}
			else
			{
				if( thePlayer.inv.HasItem( 'KM Cloak' ) && !thePlayer.inv.HasItem( 'KM Pointy Cloak' ))
				{
					cloakIDs = thePlayer.inv.GetItemsIds('KM Cloak');
					cloakID = cloakIDs[0];
					thePlayer.EquipItem(cloakID);

					if (hoodtoggle)
					{
						Hood_Exclude();
					}
				}
				else if( thePlayer.inv.HasItem( 'KM Pointy Cloak' ) && !thePlayer.inv.HasItem( 'KM Cloak' ) )
				{
					cloakIDs = thePlayer.inv.GetItemsIds('KM Pointy Cloak');
					cloakID = cloakIDs[0];
					thePlayer.EquipItem(cloakID);

					if (hoodtoggle)
					{
						Hood_Exclude();
					}
				}
				else
				{
					((CAppearanceComponent)p_comp).IncludeAppearanceTemplate(temp);
				}
			}
		
				
			//CreateDummySwords();

			FactsAdd("ACS_Cloak_Equipped", 1, -1);
		}
		else if (FactsQuerySum("ACS_Cloak_Equipped") > 0)
		{
			((CAppearanceComponent)p_comp).ExcludeAppearanceTemplate(temp);

			((CAppearanceComponent)p_comp).ExcludeAppearanceTemplate(tempfur1);

			if( thePlayer.inv.HasItem( 'KM Cloak' ) && GetWitcherPlayer().IsItemEquippedByName('KM Cloak') )
			{
				equippedItemsId.Clear();

				equippedItemsId = GetWitcherPlayer().GetEquippedItems();

				for ( i=0; i < equippedItemsId.Size() ; i+=1 ) 
				{
					if (thePlayer.inv.GetItemName(equippedItemsId[i]) == 'KM Cloak')
					{
						thePlayer.UnequipItem(equippedItemsId[i]);
					} 	
				}
			}
			else if( thePlayer.inv.HasItem( 'KM Pointy Cloak' ) && GetWitcherPlayer().IsItemEquippedByName('KM Pointy Cloak'))
			{
				equippedItemsId.Clear();

				equippedItemsId = GetWitcherPlayer().GetEquippedItems();

				for ( i=0; i < equippedItemsId.Size() ; i+=1 ) 
				{
					if (thePlayer.inv.GetItemName(equippedItemsId[i]) == 'KM Pointy Cloak')
					{
						thePlayer.UnequipItem(equippedItemsId[i]);
					} 	
				}
			}
			else if( thePlayer.inv.HasItem( 'KM Cloak Lowered' ) && GetWitcherPlayer().IsItemEquippedByName('KM Cloak Lowered'))
			{
				dyeColor = thePlayer.inv.GetItemColor( thePlayer.inv.GetItemId('KM Cloak Lowered') );

				equippedItemsId.Clear();

				equippedItemsId = GetWitcherPlayer().GetEquippedItems();

				for ( i=0; i < equippedItemsId.Size() ; i+=1 ) 
				{
					if (thePlayer.inv.GetItemName(equippedItemsId[i]) == 'KM Cloak Lowered')
					{
						thePlayer.UnequipItem(equippedItemsId[i]);
					} 	
				}

				if( !thePlayer.inv.HasItem( 'KM Cloak' ) && !thePlayer.inv.HasItem( 'KM Pointy Cloak' ))
				{
					if (FactsQuerySum("ACS_Player_Using_KM_Pointy_Cloak") > 0)
					{
						hoodId = thePlayer.inv.AddAnItem('KM Pointy Cloak', 1, true, true);
					}
					else if (FactsQuerySum("ACS_Player_Using_KM_Cloak") > 0)
					{
						hoodId = thePlayer.inv.AddAnItem('KM Cloak', 1, true, true);
					}
					else
					{
						hoodId = thePlayer.inv.AddAnItem('KM Cloak', 1, true, true);
					}

					dyeId = thePlayer.inv.AddAnItem(dyeColor, 1, true, true);
					thePlayer.inv.ColorItem(hoodId[0], dyeId[0]);
					thePlayer.inv.RemoveItem( dyeId[0], 1 );
				}
			}

			if( GetWitcherPlayer().GetItemEquippedOnSlot(EES_SteelSword, steelitem) && !thePlayer.GetInventory().IsItemHeld(steelid) )
			{
				thePlayer.GetInventory().MountItem( steelitem, false );  
			}

			if( GetWitcherPlayer().GetItemEquippedOnSlot( EES_SilverSword, silveritem) && !thePlayer.GetInventory().IsItemHeld(silverid) )
			{
				thePlayer.GetInventory().MountItem( silveritem, false );  
			}

			if ( FactsQuerySum("ACS_Dummy_Swords_Enabled") > 0 )
			{
				FactsRemove("ACS_Dummy_Swords_Enabled");
			}

			if (ACSGetCEntity('ACS_SwordOnHip_Dummy_Attachment'))
			{
				ACSGetCEntity('ACS_SwordOnHip_Dummy_Attachment').Destroy();
			}

			if (ACSGetCEntity('ACS_SwordOnHip_SilverScabbardDummy_Attachment'))
			{
				ACSGetCEntity('ACS_SwordOnHip_SilverScabbardDummy_Attachment').Destroy();
			}

			if (ACSGetCEntity('ACS_SwordOnHip_SteelScabbardDummy_Attachment'))
			{
				ACSGetCEntity('ACS_SwordOnHip_SteelScabbardDummy_Attachment').Destroy();
			}

			if (ACSGetCEntity('ACS_SwordOnHip_Steel_Sword_Dummy'))
			{
				ACSGetCEntity('ACS_SwordOnHip_Steel_Sword_Dummy').Destroy();
			}
			
			if (ACSGetCEntity('ACS_SwordOnHip_Steel_Scabbard_Dummy'))
			{
				ACSGetCEntity('ACS_SwordOnHip_Steel_Scabbard_Dummy').Destroy();
			}

			if (ACSGetCEntity('ACS_SwordOnHip_Silver_Sword_Dummy'))
			{
				ACSGetCEntity('ACS_SwordOnHip_Silver_Sword_Dummy').Destroy();
			}
			
			if (ACSGetCEntity('ACS_SwordOnHip_Silver_Scabbard_Dummy'))
			{
				ACSGetCEntity('ACS_SwordOnHip_Silver_Scabbard_Dummy').Destroy();
			}

			if (ACS_CheckWeaponShouldExistOnHip('steel'))
			{
				CreateSteelDummySwordOnHip(true);
			}

			if (ACS_CheckWeaponShouldExistOnHip('silver'))
			{
				CreateSilverDummySwordOnHip(true);
			}
			
			FactsRemove("ACS_Cloak_Equipped");
		}
	}

	function CloakToggleOff()
	{
		var p_comp												: CComponent;
		var temp, tempfur1										: CEntityTemplate;
		var steelitem, silveritem, steelid, silverid 			: SItemUniqueId;

		RemoveTimer('CloakToggleDelay');

		if (FactsQuerySum("ACS_Cloak_Equipped") > 0)
		{
			thePlayer.SoundEvent("monster_dettlaff_monster_movement_wing_flap_short_soft");

			p_comp = thePlayer.GetComponentByClassName( 'CAppearanceComponent' );

			temp = (CEntityTemplate)LoadResource(

			"dlc\dlc_acs\data\armor\old_stuff\berserkercape.w2ent"
			
			, true);

			tempfur1 = (CEntityTemplate)LoadResource(

			"dlc\dlc_acs\data\armor\old_stuff\fur\red_fur_black.w2ent"
			
			, true);

			((CAppearanceComponent)p_comp).ExcludeAppearanceTemplate(tempfur1);

			((CAppearanceComponent)p_comp).ExcludeAppearanceTemplate(temp);

			if ( FactsQuerySum("ACS_Dummy_Swords_Enabled") > 0 )
			{
				FactsRemove("ACS_Dummy_Swords_Enabled");
			}

			GetWitcherPlayer().GetItemEquippedOnSlot(EES_SilverSword, silverid);
			GetWitcherPlayer().GetItemEquippedOnSlot(EES_SteelSword, steelid);

			if( GetWitcherPlayer().GetItemEquippedOnSlot(EES_SteelSword, steelitem) && !thePlayer.GetInventory().IsItemHeld(steelid) )
			{
				thePlayer.GetInventory().MountItem( steelitem, false );  
			}

			if( GetWitcherPlayer().GetItemEquippedOnSlot( EES_SilverSword, silveritem) && !thePlayer.GetInventory().IsItemHeld(silverid) )
			{
				thePlayer.GetInventory().MountItem( silveritem, false );  
			}
			
			if (ACSGetCEntity('ACS_SwordOnHip_Dummy_Attachment'))
			{
				ACSGetCEntity('ACS_SwordOnHip_Dummy_Attachment').Destroy();
			}

			if (ACSGetCEntity('ACS_SwordOnHip_SilverScabbardDummy_Attachment'))
			{
				ACSGetCEntity('ACS_SwordOnHip_SilverScabbardDummy_Attachment').Destroy();
			}

			if (ACSGetCEntity('ACS_SwordOnHip_SteelScabbardDummy_Attachment'))
			{
				ACSGetCEntity('ACS_SwordOnHip_SteelScabbardDummy_Attachment').Destroy();
			}

			if (ACSGetCEntity('ACS_SwordOnHip_Steel_Sword_Dummy'))
			{
				ACSGetCEntity('ACS_SwordOnHip_Steel_Sword_Dummy').Destroy();
			}
			
			if (ACSGetCEntity('ACS_SwordOnHip_Steel_Scabbard_Dummy'))
			{
				ACSGetCEntity('ACS_SwordOnHip_Steel_Scabbard_Dummy').Destroy();
			}

			if (ACSGetCEntity('ACS_SwordOnHip_Silver_Sword_Dummy'))
			{
				ACSGetCEntity('ACS_SwordOnHip_Silver_Sword_Dummy').Destroy();
			}
			
			if (ACSGetCEntity('ACS_SwordOnHip_Silver_Scabbard_Dummy'))
			{
				ACSGetCEntity('ACS_SwordOnHip_Silver_Scabbard_Dummy').Destroy();
			}

			if (ACS_CheckWeaponShouldExistOnHip('steel'))
			{
				CreateSteelDummySwordOnHip(true);
			}

			if (ACS_CheckWeaponShouldExistOnHip('silver'))
			{
				CreateSilverDummySwordOnHip(true);
			}

			FactsRemove("ACS_Cloak_Equipped");
		}
	}

	function CloakToggleStartup()
	{
		var p_comp												: CComponent;
		var temp, tempfur1										: CEntityTemplate;
		var steelitem, silveritem, steelid, silverid 			: SItemUniqueId;

		RemoveTimer('CloakToggleDelay');

		if (FactsQuerySum("ACS_Cloak_Equipped") > 0)
		{
			if( !GetWitcherPlayer().IsItemEquippedByName('KM Cloak') 
			&& !GetWitcherPlayer().IsItemEquippedByName('KM Cloak Lowered') 
			&& !GetWitcherPlayer().IsItemEquippedByName('KM Pointy Cloak') 
			)
			{
				thePlayer.SoundEvent("monster_dettlaff_monster_movement_wing_flap_short_soft");

				p_comp = thePlayer.GetComponentByClassName( 'CAppearanceComponent' );

				temp = (CEntityTemplate)LoadResource(

				"dlc\dlc_acs\data\armor\old_stuff\berserkercape.w2ent"
				
				, true);

				if (
				FurCloakControl()
				)
				{
					tempfur1 = (CEntityTemplate)LoadResource(

					"dlc\dlc_acs\data\armor\old_stuff\fur\red_fur_black.w2ent"
					
					, true);

					((CAppearanceComponent)p_comp).IncludeAppearanceTemplate(tempfur1);
				}

				((CAppearanceComponent)p_comp).IncludeAppearanceTemplate(temp);
			}

			GetWitcherPlayer().GetItemEquippedOnSlot(EES_SilverSword, silverid);
			GetWitcherPlayer().GetItemEquippedOnSlot(EES_SteelSword, steelid);

			if( GetWitcherPlayer().GetItemEquippedOnSlot(EES_SteelSword, steelitem) && !thePlayer.GetInventory().IsItemHeld(steelid) )
			{
				thePlayer.GetInventory().MountItem( steelitem, false );  
			}

			if( GetWitcherPlayer().GetItemEquippedOnSlot( EES_SilverSword, silveritem) && !thePlayer.GetInventory().IsItemHeld(silverid) )
			{
				thePlayer.GetInventory().MountItem( silveritem, false );  
			}

			//CreateDummySwords();
		}
		else
		{
			if (ACS_CloakEquippedCheck())
			{
				GetWitcherPlayer().GetItemEquippedOnSlot(EES_SilverSword, silverid);
				GetWitcherPlayer().GetItemEquippedOnSlot(EES_SteelSword, steelid);

				if( GetWitcherPlayer().GetItemEquippedOnSlot(EES_SteelSword, steelitem) && !thePlayer.GetInventory().IsItemHeld(steelid) )
				{
					thePlayer.GetInventory().MountItem( steelitem, false );  
				}

				if( GetWitcherPlayer().GetItemEquippedOnSlot( EES_SilverSword, silveritem) && !thePlayer.GetInventory().IsItemHeld(silverid) )
				{
					thePlayer.GetInventory().MountItem( silveritem, false );  
				}
			}
			else
			{
				if (ACS_CheckWeaponShouldExistOnHip('steel'))
				{
					GetWitcherPlayer().GetItemEquippedOnSlot(EES_SteelSword, steelid);

					if( GetWitcherPlayer().GetItemEquippedOnSlot(EES_SteelSword, steelitem) && !thePlayer.GetInventory().IsItemHeld(steelid) )
					{
						thePlayer.GetInventory().MountItem( steelitem, false );  
					}

					CreateSteelDummySwordOnHip(true);
				}

				if (ACS_CheckWeaponShouldExistOnHip('silver'))
				{
					GetWitcherPlayer().GetItemEquippedOnSlot(EES_SilverSword, silverid);

					if( GetWitcherPlayer().GetItemEquippedOnSlot( EES_SilverSword, silveritem) && !thePlayer.GetInventory().IsItemHeld(silverid) )
					{
						thePlayer.GetInventory().MountItem( silveritem, false );  
					}

					CreateSilverDummySwordOnHip(true);
				}
			}
		}
	}

	var vACS_Warden_Tail: cACS_Warden_Tail;

	function EquipACSArmorSwitch( itemName : name, tailSwitch : bool )
	{
		var newID : array<SItemUniqueId>;

		GetWitcherPlayer().UnequipItemFromSlot(EES_Armor);

		if ( helmtoggle )
		{
			vACS_Warden_Tail = new cACS_Warden_Tail in this;

			if (tailSwitch)
			{
				vACS_Warden_Tail.ACS_Warden_Tail_Include_Engage();
			}
			else
			{
				vACS_Warden_Tail.ACS_Warden_Tail_Exclude_Engage();
			}
		}

		if (thePlayer.inv.HasItem(itemName))
		{
			thePlayer.EquipItem( thePlayer.inv.GetItemId(itemName));
		}
		else
		{
			newID = thePlayer.inv.AddAnItem(itemName, 1);

			thePlayer.EquipItem(newID[0]);
		}
	}

	public timer function ACS_ShoulderToggleDelay(deltaTime : float , id : int)
	{
		if (GetWitcherPlayer().IsItemEquippedByName('ACS_Armor_Omega'))
		{
			EquipACSArmorSwitch('ACS_Armor_Alpha', false);
		}
		else if (GetWitcherPlayer().IsItemEquippedByName('NGP_ACS_Armor_Omega'))
		{
			EquipACSArmorSwitch('NGP_ACS_Armor_Alpha', false);
		}
		else if (GetWitcherPlayer().IsItemEquippedByName('ACS_Armor_Alpha'))
		{
			EquipACSArmorSwitch('ACS_Armor_Omega', true);
		}
		else if (GetWitcherPlayer().IsItemEquippedByName('NGP_ACS_Armor_Alpha'))
		{
			EquipACSArmorSwitch('NGP_ACS_Armor_Omega', true);
		}
	}

	event OnACSShoulderToggle( action : SInputAction )
	{
		if (FactsQuerySum("acs_transformation_activated") > 0)
		{
			return false;
		}

		if (IsPressed(action))
		{
			if (theInput.LastUsedGamepad() && theInput.GetActionValue('ACSToggleWearablesMode') < 0.5) 
			{
				return false;
			}

			if (!AnimProgressCheck())
			{
				return false;
			}
	
			if (ACS_Armor_Set_Check('acs_armor', false) && FactsQuerySum("acs_transformation_activated") <= 0)
			{
				thePlayer.PlayEffectSingle('special_attack_only_black_fx');
				thePlayer.StopEffect('special_attack_only_black_fx');

				thePlayer.PlayEffectSingle('ethereal_appear');
				thePlayer.StopEffect('ethereal_appear');

				thePlayer.PlayEffectSingle('embers_particles_test');
				thePlayer.StopEffect('embers_particles_test');

				RemoveTimer('ACS_ShoulderToggleDelay');
				AddTimer('ACS_ShoulderToggleDelay', 0.5 , false);
			}
			else
			{
				if (thePlayer.HasTag('ACS_IsSwordWalking'))
				{
					thePlayer.RemoveTag('ACS_IsSwordWalking');
				}

				if ( thePlayer.IsHoldingItemInLHand() ) 
				{
					thePlayer.OnUseSelectedItem( true );
				}

				if ( thePlayer.IsCrossbowHeld() ) 
				{
					thePlayer.OnRangedForceHolster( false, true );
				}
				 
				cloakaniminprogress = true;

				RemoveTimer('CloakAnimProgressSet');
				AddTimer('CloakAnimProgressSet', 2 , false);

				thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');

				thePlayer.RaiseEvent('ACS_CloakEnabled');
				RemoveTimer('CloakToggleDelay');
				AddTimer('CloakToggleDelay', 0.5 , false);
			}

			return false;
		}
	}

	var vBruxaDodgeBack : cBruxaDodgeBack;

	function ACS_BruxaDodgeInit( dodgeDirection : name )
	{
		if (ACS_New_Replacers_Female_Active())
		{
			GetWitcherPlayer().EvadePressed(EBAT_Dodge);
			ACS_StaminaDrain(4);
			return;
		}

		if ( ACS_Settings_Main_Bool('acs_main_settings','acs_mod_enabled', true) )
		{
			vBruxaDodgeBack = new cBruxaDodgeBack in this;

			if (!GetWitcherPlayer().IsPerformingFinisher()
			&& !GetWitcherPlayer().HasTag('acs_in_wraith')
			&& ACS_BuffCheck()
			)
			{	
				if (!GetWitcherPlayer().HasTag('ACS_Bruxa_Bite_Process') && GetWitcherPlayer().IsActionAllowed(EIAB_Dodge) )
				{
					if ( ACS_Settings_Main_Bool('acs_stamina_settings','acs_stamina_block_action', false) 
					&& GetWitcherPlayer().GetStat( BCS_Stamina ) <= GetWitcherPlayer().GetStatMax( BCS_Stamina ) * 0.15
					&& !thePlayer.HasTag('ACS_Ghost_Stance_Active')
					)
					{
						GetWitcherPlayer().SoundEvent("gui_no_stamina");
					}
					else
					{
						if (ACS_can_dodge())
						{
							ACS_refresh_dodge_cooldown();

							ACS_ThingsThatShouldBeRemoved();

							GetWitcherPlayer().ACS_ClearAnimationSpeedMultipliers();

							ACS_ExplorationDelayHack(false, 3);

							switch(dodgeDirection)
							{
								case 'right':
								vBruxaDodgeBack.BruxaDodgeBackRight_Engage();
								break;

								case 'left':
								vBruxaDodgeBack.BruxaDodgeBackLeft_Engage();
								break;

								case 'center':
								vBruxaDodgeBack.BruxaDodgeBackCenter_Engage();
								break;

								default:
								vBruxaDodgeBack.BruxaDodgeBackCenter_Engage();
								break;
							}
	
							ACS_StaminaDrain(4);
						}
					}
				}
			}
		}
		else
		{
			GetWitcherPlayer().EvadePressed(EBAT_Dodge);

			ACS_StaminaDrain(4);
		}
	}

	event OnMovementDoubleTapA( action : SInputAction )
	{
		if (FactsQuerySum("acs_transformation_activated") > 0
		|| !thePlayer.IsActionAllowed(EIAB_Dodge)
		)
		{
			return false;
		}

		if (thePlayer.HasTag('ACS_IsSwordWalking'))
		{
			thePlayer.RemoveTag('ACS_IsSwordWalking');
		}

		if ( IsPressed( action ) )
		{			
			if ( !thePlayer.IsDodgeTimerRunning() || action.aName != lastACSMovementDoubleTapName )
			{
				thePlayer.StartDodgeTimer();
				lastACSMovementDoubleTapName = action.aName;
			}
			else
			{
				ACSGetCEntity('ACS_Quen_Bubble').Destroy();
		
				ACSGetCEntity('ACS_Quen_Fx').Destroy();

				ACSGetCEntity('ACS_Sign_Icon').Destroy();

				ACSGetCEntity('ACS_Sign_Icon_Anchor').Destroy();

				thePlayer.StopDodgeTimer();

				if (FlipTargetCheck('left'))
				{

				}
				else
				{
					ACS_BruxaDodgeInit('left');
				}
			}
		}
	}


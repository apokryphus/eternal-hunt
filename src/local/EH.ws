							if(!ACSGetCActor('ACS_Transformation_Werewolf').IsEffectActive('blood_effect_claws_left', false)){ACSGetCActor('ACS_Transformation_Werewolf').PlayEffectSingle('blood_effect_claws_left');}
							break;

							case 1:
							if(!ACSGetCActor('ACS_Transformation_Werewolf').IsEffectActive('blood_effect_claws_test', false)){ACSGetCActor('ACS_Transformation_Werewolf').PlayEffectSingle('blood_effect_claws_test');}
							break;

							default:
							if(!ACSGetCActor('ACS_Transformation_Werewolf').IsEffectActive('blood_effect_claws_test', false)){ACSGetCActor('ACS_Transformation_Werewolf').PlayEffectSingle('blood_effect_claws_test');}
							break;
						}

						if(!ACSGetCActor('ACS_Transformation_Vampiress').IsEffectActive('blood_effect_claws_test', false)){ACSGetCActor('ACS_Transformation_Vampiress').PlayEffectSingle('blood_effect_claws_test');}
					}
				}
				else
				{
					if (ACS_Settings_Main_Bool('acs_visual_main_settings','acs_additional_blood_covered_effect_enabled', true))
					{	
						thePlayer.StopEffect('covered_blood_black_ACS');
						thePlayer.PlayEffectSingle('covered_blood_black_ACS');
					}

					switch(direction)
					{
						case 4:
						if(!ACSGetCActor('ACS_Transformation_Werewolf').IsEffectActive('blood_effect_jaw_black', false)){ACSGetCActor('ACS_Transformation_Werewolf').PlayEffectSingle('blood_effect_jaw_black');}
						break;

						case 3:
						if(!ACSGetCActor('ACS_Transformation_Werewolf').IsEffectActive('blood_effect_claws_right_black', false)){ACSGetCActor('ACS_Transformation_Werewolf').PlayEffectSingle('blood_effect_claws_right_black');}
						break;

						case 2:
						if(!ACSGetCActor('ACS_Transformation_Werewolf').IsEffectActive('blood_effect_claws_left_black', false)){ACSGetCActor('ACS_Transformation_Werewolf').PlayEffectSingle('blood_effect_claws_left_black');}
						break;

						case 1:
						if(!ACSGetCActor('ACS_Transformation_Werewolf').IsEffectActive('blood_effect_claws_test_black', false)){ACSGetCActor('ACS_Transformation_Werewolf').PlayEffectSingle('blood_effect_claws_test_black');}
						break;

						default:
						if(!ACSGetCActor('ACS_Transformation_Werewolf').IsEffectActive('blood_effect_claws_test_black', false)){ACSGetCActor('ACS_Transformation_Werewolf').PlayEffectSingle('blood_effect_claws_test_black');}
						break;
					}

					if(!ACSGetCActor('ACS_Transformation_Vampiress').IsEffectActive('blood_effect_claws_test_black', false)){ACSGetCActor('ACS_Transformation_Vampiress').PlayEffectSingle('blood_effect_claws_test_black');}
				}
			}
		}
		else
		{
			if (VecDistanceSquared2D( thePlayer.GetWorldPosition(), npc.GetWorldPosition() ) <= 5 * 5 )
			{
				if (ACS_Settings_Main_Bool('acs_visual_main_settings','acs_additional_blood_covered_effect_enabled', true))
				{	
					thePlayer.StopEffect('covered_blood_red_ACS');
					thePlayer.PlayEffectSingle('covered_blood_red_ACS');
				}

				switch(direction)
				{
					case 4:
					if(!ACSGetCActor('ACS_Transformation_Werewolf').IsEffectActive('blood_effect_jaw', false)){ACSGetCActor('ACS_Transformation_Werewolf').PlayEffectSingle('blood_effect_jaw');}
					break;

					case 3:
					if(!ACSGetCActor('ACS_Transformation_Werewolf').IsEffectActive('blood_effect_claws_right', false)){ACSGetCActor('ACS_Transformation_Werewolf').PlayEffectSingle('blood_effect_claws_right');}
					break;

					case 2:
					if(!ACSGetCActor('ACS_Transformation_Werewolf').IsEffectActive('blood_effect_claws_left', false)){ACSGetCActor('ACS_Transformation_Werewolf').PlayEffectSingle('blood_effect_claws_left');}
					break;

					case 1:
					if(!ACSGetCActor('ACS_Transformation_Werewolf').IsEffectActive('blood_effect_claws_test', false)){ACSGetCActor('ACS_Transformation_Werewolf').PlayEffectSingle('blood_effect_claws_test');}
					break;

					default:
					if(!ACSGetCActor('ACS_Transformation_Werewolf').IsEffectActive('blood_effect_claws_test', false)){ACSGetCActor('ACS_Transformation_Werewolf').PlayEffectSingle('blood_effect_claws_test');}
					break;
				}

				if(!ACSGetCActor('ACS_Transformation_Vampiress').IsEffectActive('blood_effect_claws_test', false)){ACSGetCActor('ACS_Transformation_Vampiress').PlayEffectSingle('blood_effect_claws_test');}
			}
		}
	}

	function Player_Claws_Blood_Effect(npc : CActor)
	{
		var tmpBool 				: bool;
		var mc 						: EMonsterCategory;
		var tmpName 				: name;

		theGame.GetMonsterParamsForActor(npc, mc, tmpName, tmpBool, tmpBool, tmpBool);

		if( ((CNewNPC)npc).GetBloodType() == BT_Red) 
		{
			if (VecDistanceSquared2D( thePlayer.GetWorldPosition(), npc.GetWorldPosition() ) <= 5 * 5 )
			{
				if (npc.HasAbility('mon_lessog_base')
				|| npc.HasAbility('mon_sprigan_base')
				)
				{						
					thePlayer.PlayEffectSingle('blood_effect_claws_test_black');
					thePlayer.StopEffect('blood_effect_claws_test_black');
				} 
				else
				{
					thePlayer.PlayEffectSingle('blood_effect_claws_test');
					thePlayer.StopEffect('blood_effect_claws_test');
				}
			}
		}
		else if( ((CNewNPC)npc).GetBloodType() == BT_Green) 
		{
			if (VecDistanceSquared2D( thePlayer.GetWorldPosition(), npc.GetWorldPosition() ) <= 5 * 5 )
			{
				if (npc.HasAbility('mon_kikimore_base')
				|| npc.HasAbility('mon_black_spider_base')
				|| npc.HasAbility('mon_black_spider_ep2_base')
				|| npc.HasTag('ACS_Ungoliant')
				)
				{						
					thePlayer.PlayEffectSingle('blood_effect_claws_test_black');
					thePlayer.StopEffect('blood_effect_claws_test_black');
				} 
				else 
				{
					thePlayer.PlayEffectSingle('blood_effect_claws_test_green');
					thePlayer.StopEffect('blood_effect_claws_test_green');
				}
			}
		}
		else if( ((CNewNPC)npc).GetBloodType() == BT_Yellow) 
		{
			if (VecDistanceSquared2D( thePlayer.GetWorldPosition(), npc.GetWorldPosition() ) <= 5 * 5 )
			{
				if (npc.HasAbility('mon_archespor_base'))
				{
					thePlayer.PlayEffectSingle('blood_effect_claws_test_yellow');
					thePlayer.StopEffect('blood_effect_claws_test_yellow');
				} 
				else 
				{
					thePlayer.PlayEffectSingle('blood_effect_claws_test');
					thePlayer.StopEffect('blood_effect_claws_test');
				}
			}
		}
		else if( ((CNewNPC)npc).GetBloodType() == BT_Black) 
		{
			if (VecDistanceSquared2D( thePlayer.GetWorldPosition(), npc.GetWorldPosition() ) <= 5 * 5 )
			{
				if ( mc == MC_Vampire ) 
				{
					thePlayer.PlayEffectSingle('blood_effect_claws_test');
					thePlayer.StopEffect('blood_effect_claws_test');
				}
				else if ( mc == MC_Magicals ) 
				{
					if (npc.HasAbility('mon_golem_base')
					|| npc.HasAbility('mon_djinn')
					|| npc.HasAbility('mon_gargoyle')
					)
					{
						thePlayer.PlayEffectSingle('blood_effect_claws_black');
						thePlayer.StopEffect('blood_effect_claws_black');
					}
					else
					{
						thePlayer.PlayEffectSingle('blood_effect_claws_test');
						thePlayer.StopEffect('blood_effect_claws_test');
					}
				}
				else
				{
					thePlayer.PlayEffectSingle('blood_effect_claws_black');
					thePlayer.StopEffect('blood_effect_claws_black');
				}
			}
		}
		else
		{
			if (VecDistanceSquared2D( thePlayer.GetWorldPosition(), npc.GetWorldPosition() ) <= 5 * 5 )
			{
				thePlayer.PlayEffectSingle('blood_effect_claws_test');
				thePlayer.StopEffect('blood_effect_claws_test');
			}
		}
	}

	function FearChance() : float
	{
		var dismemberChance 	: float;

		dismemberChance = theGame.params.DISMEMBERMENT_ON_DEATH_CHANCE;

		if(GetWitcherPlayer() && GetWitcherPlayer().CanUseSkill(S_Perk_03))
		{
			dismemberChance += RoundMath(100 * CalculateAttributeValue(GetWitcherPlayer().GetSkillAttributeValue(S_Perk_03, 'dismember_chance', false, true)));
		}
		
		if( GetWitcherPlayer().IsMutationActive(EPMT_Mutation3) )	
		{
			dismemberChance = 100;
		}

		dismemberChance = dismemberChance * 0.01;

		return dismemberChance;
	}

	function Fear_Stack()
	{
		var fear_actors																	: array<CActor>;
		var k 																			: int;
		var fear_actor																	: CActor;
		var animatedComponentFearActor													: CAnimatedComponent;
		var movementAdjustorFearActor													: CMovementAdjustor;
		var ticketFearActor																: SMovementAdjustmentRequestTicket;

		fear_actors.Clear();

		fear_actors = thePlayer.GetMoveTargets();
				
		//fear_actors.Clear();
			
		//fear_actors = thePlayer.GetNPCsAndPlayersInRange( 10, 25, , FLAG_ExcludePlayer + FLAG_OnlyAliveActors + FLAG_Attitude_Hostile);

		if( fear_actors.Size() > 0 )
		{
			for( k = 0; k < fear_actors.Size(); k += 1 )
			{
				fear_actor = fear_actors[k];

				animatedComponentFearActor = (CAnimatedComponent)fear_actor.GetComponentByClassName( 'CAnimatedComponent' );

				movementAdjustorFearActor = fear_actor.GetMovingAgentComponent().GetMovementAdjustor();

				targetDistance = VecDistanceSquared2D( thePlayer.GetWorldPosition(), fear_actor.GetWorldPosition() ) ;
			
				if ( fear_actor 
				&& fear_actor.IsHuman()
				&& fear_actor.IsMan()
				&& !fear_actor.HasTag('ACS_Shades_Crusader')
				&& !fear_actor.HasTag('ACS_Shades_Hunter')
				&& ((CNewNPC)fear_actor).GetNPCType() != ENGT_Quest
				&& !fear_actor.HasTag('ACS_Swapped_To_Shield')
				//&& RandF() < 0.875
				&& !fear_actor.IsUsingHorse()
				&& !fear_actor.IsUsingVehicle()
				&& !fear_actor.HasAbility('Boss')
				&& !fear_actor.HasAbility('ablIgnoreSigns')
				&& !fear_actor.HasAbility('DisableFinishers')
				&& !fear_actor.HasAbility('MonsterMHBoss')
				&& !thePlayer.IsUsingHorse()
				&& !thePlayer.IsUsingVehicle()
				&& GetAttitudeBetween( thePlayer, fear_actor ) == AIA_Hostile
				)
				{
					if (
					thePlayer.HasTag('ACS_Flammable_Oil_Enabled') 
					|| thePlayer.HasTag('ACS_Ghost_Stance_Active')
					|| fear_actor.GetCurrentHealth() <= fear_actor.GetMaxHealth() * 0.33
					)
					{
						if (RandF() < FearChance() * 2)
						{
							fear_actor.AddTag('ACS_1st_Fear_Stack');

							if (!fear_actor.HasTag('ACS_Final_Fear_Stack'))
							{
								if (!fear_actor.HasAbility('DisableFinishers'))
								{
									fear_actor.AddAbility( 'DisableFinishers', true);
								}

								if (fear_actor.HasAbility('ForceFinisher'))
								{
									fear_actor.RemoveAbility( 'ForceFinisher');
								} 

								fear_actor.SignalGameplayEvent('DisableFinisher');

								if( ((CNewNPC)fear_actor).IsShielded( NULL ) )
								{
									((CNewNPC)fear_actor).ProcessShieldDestruction();
								}

								//fear_actor.SignalGameplayEvent('LeaveCurrentCombatStyle');

								//fear_actor.SetBehaviorVariable( 'combatTauntType', 0.f );

								(fear_actor.GetInventory().GetItemEntityUnsafe( fear_actor.GetInventory().GetItemFromSlot( 'r_weapon' ) )).SetHideInGame(true);

								ticketFearActor = movementAdjustorFearActor.GetRequest( 'ACS_NPC_Fear_Rotate');
								movementAdjustorFearActor.CancelByName( 'ACS_NPC_Fear_Rotate' );
								movementAdjustorFearActor.CancelAll();

								ticketFearActor = movementAdjustorFearActor.CreateNewRequest( 'ACS_NPC_Fear_Rotate' );
								movementAdjustorFearActor.AdjustmentDuration( ticketFearActor, 0.25 );
								movementAdjustorFearActor.MaxRotationAdjustmentSpeed( ticketFearActor, 500000 );

								if( targetDistance <= 5.5 * 5.5 ) 
								{
									if (RandF() < 0.75)
									{
										fear_actor.AddTag('ACS_Scared_On_Ground');

										movementAdjustorFearActor.RotateTowards( ticketFearActor, thePlayer );

										if (RandF() < 0.5)
										{
											animatedComponentFearActor.PlaySlotAnimationAsync ( 'man_ex_scared_ground_start_1', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));
										}
										else
										{
											animatedComponentFearActor.PlaySlotAnimationAsync ( 'man_ex_scared_ground_start_2', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));
										}
									}
									else
									{
										fear_actor.AddTag('ACS_Scared_Standing');

										if (RandF() < 0.5)
										{
											movementAdjustorFearActor.RotateTowards( ticketFearActor, thePlayer, RandRangeF(225,135) );

											animatedComponentFearActor.PlaySlotAnimationAsync ( 'dialogue_man_ex_scared_run_loop', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));
										}
										else
										{
											movementAdjustorFearActor.RotateTowards( ticketFearActor, thePlayer );

											if (RandF() < 0.5)
											{
												animatedComponentFearActor.PlaySlotAnimationAsync ( 'man_ex_scared_loop_1', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));
											}
											else
											{
												animatedComponentFearActor.PlaySlotAnimationAsync ( 'man_ex_scared_loop_2', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));
											}
										}
									}
								}
								else if( targetDistance > 5.5 * 5.5 && targetDistance <= 20 * 20 ) 
								{
									if (RandF() < 0.25)
									{
										fear_actor.AddTag('ACS_Scared_On_Ground');

										movementAdjustorFearActor.RotateTowards( ticketFearActor, thePlayer );

										if (RandF() < 0.5)
										{
											animatedComponentFearActor.PlaySlotAnimationAsync ( 'man_ex_scared_ground_start_1', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));
										}
										else
										{
											animatedComponentFearActor.PlaySlotAnimationAsync ( 'man_ex_scared_ground_start_2', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));
										}
									}
									else
									{
										fear_actor.AddTag('ACS_Scared_Standing');

										if (RandF() < 0.5)
										{
											movementAdjustorFearActor.RotateTowards( ticketFearActor, thePlayer, RandRangeF(225,135) );

											animatedComponentFearActor.PlaySlotAnimationAsync ( 'dialogue_man_ex_scared_run_loop', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));
										}
										else
										{
											movementAdjustorFearActor.RotateTowards( ticketFearActor, thePlayer );

											if (RandF() < 0.5)
											{
												animatedComponentFearActor.PlaySlotAnimationAsync ( 'man_ex_scared_loop_1', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));
											}
											else
											{
												animatedComponentFearActor.PlaySlotAnimationAsync ( 'man_ex_scared_loop_2', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));
											}
										}
									}
								}

								//fear_actor.SignalGameplayEventParamInt('ChangePreferedCombatStyle',(int)EBG_Combat_Fists );

								fear_actor.AddTag('ACS_Final_Fear_Stack');
							}
						}
					}
					else
					{
						if (!fear_actor.HasTag('ACS_1st_Fear_Stack')
						)
						{
							if ( RandF() < FearChance())
							{
								fear_actor.AddTag('ACS_1st_Fear_Stack');
							}
						}
						else if (fear_actor.HasTag('ACS_1st_Fear_Stack')
						)
						{
							if (RandF() < FearChance())
							{
								if (!fear_actor.HasTag('ACS_Final_Fear_Stack')
								)
								{
									if (!fear_actor.HasAbility('DisableFinishers'))
									{
										fear_actor.AddAbility( 'DisableFinishers', true);
									}

									if (fear_actor.HasAbility('ForceFinisher'))
									{
										fear_actor.RemoveAbility( 'ForceFinisher');
									} 

									fear_actor.SignalGameplayEvent('DisableFinisher');

									if( ((CNewNPC)fear_actor).IsShielded( NULL ) )
									{
										((CNewNPC)fear_actor).ProcessShieldDestruction();
									}

									//fear_actor.SignalGameplayEvent('LeaveCurrentCombatStyle');

									//fear_actor.SetBehaviorVariable( 'combatTauntType', 0.f );

									(fear_actor.GetInventory().GetItemEntityUnsafe( fear_actor.GetInventory().GetItemFromSlot( 'r_weapon' ) )).SetHideInGame(true);

									//fear_actor.AddEffectDefault( EET_Blindness, fear_actor, 'console' );

									ticketFearActor = movementAdjustorFearActor.GetRequest( 'ACS_NPC_Fear_Rotate');
									movementAdjustorFearActor.CancelByName( 'ACS_NPC_Fear_Rotate' );
									movementAdjustorFearActor.CancelAll();

									ticketFearActor = movementAdjustorFearActor.CreateNewRequest( 'ACS_NPC_Fear_Rotate' );
									movementAdjustorFearActor.AdjustmentDuration( ticketFearActor, 0.25 );
									movementAdjustorFearActor.MaxRotationAdjustmentSpeed( ticketFearActor, 500000 );

									if( targetDistance <= 5.5 * 5.5 ) 
									{
										if (RandF() < 0.75)
										{
											fear_actor.AddTag('ACS_Scared_On_Ground');

											movementAdjustorFearActor.RotateTowards( ticketFearActor, thePlayer );

											if (RandF() < 0.5)
											{
												animatedComponentFearActor.PlaySlotAnimationAsync ( 'man_ex_scared_ground_start_1', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));
											}
											else
											{
												animatedComponentFearActor.PlaySlotAnimationAsync ( 'man_ex_scared_ground_start_2', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));
											}
										}
										else
										{
											fear_actor.AddTag('ACS_Scared_Standing');

											if (RandF() < 0.5)
											{
												movementAdjustorFearActor.RotateTowards( ticketFearActor, thePlayer, RandRangeF(225,135) );

												animatedComponentFearActor.PlaySlotAnimationAsync ( 'dialogue_man_ex_scared_run_loop', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));
											}
											else
											{
												movementAdjustorFearActor.RotateTowards( ticketFearActor, thePlayer );

												if (RandF() < 0.5)
												{
													animatedComponentFearActor.PlaySlotAnimationAsync ( 'man_ex_scared_loop_1', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));
												}
												else
												{
													animatedComponentFearActor.PlaySlotAnimationAsync ( 'man_ex_scared_loop_2', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));
												}
											}
										}
									}
									else if( targetDistance > 5.5 * 5.5 ) 
									{
										if (RandF() < 0.25)
										{
											fear_actor.AddTag('ACS_Scared_On_Ground');

											movementAdjustorFearActor.RotateTowards( ticketFearActor, thePlayer );

											if (RandF() < 0.5)
											{
												animatedComponentFearActor.PlaySlotAnimationAsync ( 'man_ex_scared_ground_start_1', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));
											}
											else
											{
												animatedComponentFearActor.PlaySlotAnimationAsync ( 'man_ex_scared_ground_start_2', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));
											}
										}
										else
										{
											fear_actor.AddTag('ACS_Scared_Standing');

											if (RandF() < 0.5)
											{
												movementAdjustorFearActor.RotateTowards( ticketFearActor, thePlayer, RandRangeF(225,135) );

												animatedComponentFearActor.PlaySlotAnimationAsync ( 'dialogue_man_ex_scared_run_loop', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));
											}
											else
											{
												movementAdjustorFearActor.RotateTowards( ticketFearActor, thePlayer );

												if (RandF() < 0.5)
												{
													animatedComponentFearActor.PlaySlotAnimationAsync ( 'man_ex_scared_loop_1', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));
												}
												else
												{
													animatedComponentFearActor.PlaySlotAnimationAsync ( 'man_ex_scared_loop_2', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));
												}
											}
										}
									}
									else
									{
										if (RandF() < 0.25)
										{
											fear_actor.AddTag('ACS_Scared_On_Ground');

											movementAdjustorFearActor.RotateTowards( ticketFearActor, thePlayer );

											if (RandF() < 0.5)
											{
												animatedComponentFearActor.PlaySlotAnimationAsync ( 'man_ex_scared_ground_start_1', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));
											}
											else
											{
												animatedComponentFearActor.PlaySlotAnimationAsync ( 'man_ex_scared_ground_start_2', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));
											}
										}
										else
										{
											fear_actor.AddTag('ACS_Scared_Standing');

											if (RandF() < 0.5)
											{
												movementAdjustorFearActor.RotateTowards( ticketFearActor, thePlayer, RandRangeF(225,135) );

												animatedComponentFearActor.PlaySlotAnimationAsync ( 'dialogue_man_ex_scared_run_loop', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));
											}
											else
											{
												movementAdjustorFearActor.RotateTowards( ticketFearActor, thePlayer );

												if (RandF() < 0.5)
												{
													animatedComponentFearActor.PlaySlotAnimationAsync ( 'man_ex_scared_loop_1', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));
												}
												else
												{
													animatedComponentFearActor.PlaySlotAnimationAsync ( 'man_ex_scared_loop_2', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));
												}
											}
										}
									}
									
									fear_actor.AddTag('ACS_Final_Fear_Stack');
								}
							}	
						}
					}
				}
			}
		}
	}

	var vACS_Unseen_Blade_Summon 		: cACS_Unseen_Blade_Summon;

	timer function unseen_blade_spawn_delay( time : float , id : int )
	{
		if(
		!theGame.IsDialogOrCutscenePlaying() 
		&& !thePlayer.IsInNonGameplayCutscene() 
		&& !thePlayer.IsInGameplayScene()
		&& !theGame.GetPhotomodeEnabled() 
		&& !thePlayer.IsInCutsceneIntro() 
		&& !theGame.IsCurrentlyPlayingNonGameplayScene() 
		&& !theGame.IsFading()
		&& !theGame.IsBlackscreen()
		)
		{
			if(
			!ACSGetCActor('ACS_Blade_Of_The_Unseen')
			&& !ACSGetCActor('ACS_Blade_Of_The_Unseen').IsAlive()
			&& !ACS_PlayerSettlementCheck(50))
			{
				GetACSStorage().acs_Number_Of_Bruxae_Slain_Manage(true);

				RemoveTimer('unseen_blade_spawn_delay');
				RemoveTimer('unseen_blade_hunt_delay');
				AddTimer('unseen_blade_hunt_delay', 60 , true);

				vACS_Unseen_Blade_Summon = new cACS_Unseen_Blade_Summon in this;

				vACS_Unseen_Blade_Summon.ACS_Unseen_Blade_Summon_Start_Engage();

				if ( FactsQuerySum("ACS_Blade_Of_The_Unseen_Has_Spoken") > 0 )
				{
					FactsRemove("ACS_Blade_Of_The_Unseen_Has_Spoken");
				}
			}
			else
			{
				if ( FactsQuerySum("ACS_Blade_Of_The_Unseen_Has_Spoken") <= 0 )
				{
					if( RandF() < 0.5 ) 
					{
						GetWitcherPlayer().DisplayHudMessage( GetLocStringById(2118449940) );
					}
					else
					{
						GetWitcherPlayer().DisplayHudMessage( GetLocStringById(2118449941) );
					}

					FactsAdd("ACS_Blade_Of_The_Unseen_Has_Spoken", 1, -1);
				}
			}
		}
	}

	timer function unseen_blade_hunt_delay( time : float , id : int )
	{
		var playerRot, rotationAdjusted 				: EulerAngles;
		var spawnPos									: Vector;

		if(
		!theGame.IsDialogOrCutscenePlaying() 
		&& !thePlayer.IsInNonGameplayCutscene() 
		&& !thePlayer.IsInGameplayScene()
		&& !theGame.GetPhotomodeEnabled() 
		&& !thePlayer.IsInCutsceneIntro() 
		&& !theGame.IsCurrentlyPlayingNonGameplayScene() 
		&& !theGame.IsFading()
		&& !theGame.IsBlackscreen()
		)
		{
			if(
			ACSGetCActor('ACS_Blade_Of_The_Unseen')
			&& ACSGetCActor('ACS_Blade_Of_The_Unseen').IsAlive()
			&& !ACS_PlayerSettlementCheck(50))
			{
				playerRot = thePlayer.GetWorldRotation();

				playerRot.Yaw += 180;

				rotationAdjusted = EulerAngles(0,0,0);

				rotationAdjusted.Yaw = playerRot.Yaw;

				spawnPos = theCamera.GetCameraPosition() + VecFromHeading(theCamera.GetCameraHeading()) * 10;

				theGame.GetWorld().NavigationFindSafeSpot(spawnPos, 0.5f, 20.f, spawnPos);

				ACSGetCActor('ACS_Blade_Of_The_Unseen').TeleportWithRotation(ACSFixZAxis(spawnPos), rotationAdjusted);

				if ( FactsQuerySum("ACS_Blade_Of_The_Unseen_Has_Spoken") > 0 )
				{
					FactsRemove("ACS_Blade_Of_The_Unseen_Has_Spoken");
				}
			}
			else
			{
				if ( FactsQuerySum("ACS_Blade_Of_The_Unseen_Has_Spoken") <= 0 )
				{
					if( RandF() < 0.5 ) 
					{
						GetWitcherPlayer().DisplayHudMessage( GetLocStringById(2118449940) );
					}
					else
					{
						GetWitcherPlayer().DisplayHudMessage( GetLocStringById(2118449941) );
					}

					FactsAdd("ACS_Blade_Of_The_Unseen_Has_Spoken", 1, -1);
				}
			}
		}
	}

	function PlayerCommentEnd()
	{
		player_comment_index_COMBAT_END = RandDifferent(this.previous_player_comment_index_COMBAT_END , 2);

		switch (player_comment_index_COMBAT_END) 
		{				
			case 1:
			thePlayer.PlayBattleCry( 'BattleCryMonstersEnd', 1, true, false);
			break;	
						
			default:
			thePlayer.PlayBattleCry('BattleCryHumansEnd', 1, true, false);
			break;
		}

		this.previous_player_comment_index_COMBAT_END = player_comment_index_COMBAT_END;
	}

	function ACS_Finisher_Internal(npc : CActor, action : W3DamageAction)
	{
		var params 															: SCustomEffectParams;
		var voiceTagName 													: name;
		var voiceTagStr														: string;
	
		if (FactsQuerySum("acs_transformation_activated") > 0
		)
		{
			return;
		}

		if (npc.HasTag('ACS_DisableFinisher')
		)
		{
			return;
		}

		if (!action.IsActionMelee())
		{
			return;
		}

		if (npc.GetImmortalityMode() != AIM_Invulnerable
		&& npc.GetImmortalityMode() != AIM_Immortal
		&& !npc.IsUsingHorse()
		&& !npc.IsUsingVehicle()
		)
		{
			wounds.Clear();

			if (((CMovingPhysicalAgentComponent)(((CNewNPC)npc).GetMovingAgentComponent())).GetCapsuleHeight() >= 2
			|| ((CNewNPC)npc).GetRadius() >= 0.7
			|| ((CNewNPC)npc).HasAbility('Boss')
			|| ((CNewNPC)npc).HasTag('IsBoss')
			|| ((CNewNPC)npc).HasTag('ACS_Big_Boi')
			)
			{
				finisherDist = 4;
			}
			else
			{
				finisherDist = 2;
			}

			if (ACS_Settings_Main_Float('acs_visual_main_settings','acs_player_scale', 1) > 1)
			{
				finisherDist += ACS_Settings_Main_Float('acs_visual_main_settings','acs_player_scale', 1) * 0.25;
			}

			npc.SetBehaviorMimicVariable( 'gameplayMimicsMode', (float)(int)GMM_Tpose );

			voiceTagName =  npc.GetVoicetag();

			voiceTagStr = NameToString( voiceTagName );

			if ( 
			ACS_GetItem_Sword_IsEquipped('knife_steel', 'steel') 
			&& thePlayer.IsWeaponHeld('steelsword')
			&& npc.IsMan()
			&& !npc.UsesEssence()
			&& ((CNewNPC)npc).GetNPCType() != ENGT_Quest
			&& !npc.HasTag( 'ethereal' )
			&& !npc.HasAbility( 'Boss' )
			&& !npc.HasTag( 'IsBoss' )
			&& !npc.HasTag( 'ACS_Berserkers_Human' )
			&& !npc.HasTag( 'ACS_Shades_Hunter' )
			&& !npc.HasTag( 'ACS_Shades_Crusader' )
			&& !npc.IsUsingHorse()
			&& !npc.IsUsingVehicle()
			&& !npc.HasTag('ACS_In_Rage')
			&& !npc.HasTag('ACS_Pre_Rage')
			&& !npc.HasTag('ACS_Currently_In_Grapple_Anim')
			&& !npc.HasTag('ACS_Currently_In_Beh_Switch_Anim')
			&& !npc.HasTag('ACS_Final_Fear_Stack')
			&& !((CNewNPC)npc).IsInFinisherAnim()
			&& !((CNewNPC)npc).IsRagdolled()
			&& ACS_Rage_Process == false
			&& npc.GetBehaviorGraphInstanceName() != 'Shield'
			&& !npc.HasTag('mq1060_witcher')
			&& StrFindFirst(voiceTagStr, "REINALD") < 0
			&& !thePlayer.HasTag('acs_vampire_claws_equipped')
			&& !thePlayer.IsInFistFightMiniGame()
			&& npc.GetCurrentHealth() <= npc.GetMaxHealth() * 0.25
			&& VecDistanceSquared2D( thePlayer.GetWorldPosition(), npc.GetNearestPointInBothPersonalSpaces( thePlayer.GetWorldPosition() ) ) < finisherDist * finisherDist
			)
			{
				Fear_Stack();

				InitiateFinisherChain(false);

				return;
			}

			if ( npc.HasTag('ACS_Final_Fear_Stack') 
			&& npc.IsHuman()
			&& ACS_BuffCheck()
			&& !thePlayer.IsCrossbowHeld()
			&& !thePlayer.HasTag('ACS_IsPerformingFinisher')
			&& !thePlayer.HasTag('ACS_IsPerformingCombatDismember')
			)
			{	
				Fear_Stack();

				if (!npc.HasTag('ACS_man_finisher_dlc_arm_lp_combat_dismember')
				&& !npc.HasTag('ACS_man_finisher_dlc_arm_rp_combat_dismember')
				&& !npc.HasTag('ACS_man_finisher_dlc_legs_lp_combat_dismember')
				&& !npc.HasTag('ACS_man_finisher_dlc_legs_rp_combat_dismember')
				)
				{
					dismembermentComp = (CDismembermentComponent)(npc.GetComponentByClassName( 'CDismembermentComponent' ));

					if(dismembermentComp)
					{
						dismembermentComp.GetWoundsNames( wounds );

						//for( i=0; i < wounds.Size(); i+=1 )

						for( i=wounds.Size()-1; i>=0; i-=1 )
						{
							if( !StrContains( wounds[ i ], "gash" ) 
							)
							{
								wounds.EraseFast( i );
							}
						}

						if ( wounds.Size() > 0 )
						{
							usedWound = wounds[ RandRange( wounds.Size() ) ];
						}

						if (!thePlayer.IsWeaponHeld('fist') )
						{
							npc.SoundEvent("bone_break_bb_acs");
					
							npc.SoundEvent("breach_bb_acs");

							npc.SetDismembermentInfo( usedWound, npc.GetWorldPosition() - npc.GetWorldPosition(), false, DETF_Igni );
						}
					}

					npc.AddTimer( 'ACS_DelayedDismemberTimer', 0.05f, false );
				}

				movementAdjustor.CancelAll();

				ACS_PerformFinisher(npc);

				Fear_Stack();

				npc.SoundEvent("cmb_play_hit_heavy");
				GetWitcherPlayer().SoundEvent("cmb_play_hit_heavy");
				GetWitcherPlayer().SoundEvent("cmb_play_dismemberment_gore");
				GetWitcherPlayer().SoundEvent("monster_dettlaff_monster_vein_hit_blood");

				npc.DrainStamina( ESAT_FixedValue, npc.GetStatMax( BCS_Stamina ), 60 );

				if( RandF() < ACS_Settings_Main_Float('acs_taunt_settings','acs_finisher_taunt_chance', 0.25) ) 
				{
					PlayerCommentEnd();
				}

				if (ACS_Armor_Set_Check('acs_armor', false))
				{
					thePlayer.SoundEvent("monster_caretaker_fx_black_exhale");

					thePlayer.SoundEvent("monster_caretaker_fx_summon");
					
					if (thePlayer.GetStat(BCS_Focus) >= thePlayer.GetStatMax( BCS_Focus ) * 0.9875
					&& thePlayer.GetStat(BCS_Stamina) == thePlayer.GetStatMax(BCS_Stamina))
					{
						npc.DestroyEffect('critical_burning');
						npc.PlayEffectSingle('critical_burning');
					}
				}

				if (thePlayer.HasTag('ACS_Flammable_Oil_Enabled'))
				{
					if (ACS_GetItem_SwordHeldSwitchBasedUponStat('frost_sword'))
					{
						npc.DestroyEffect('critical_frozen');
						npc.PlayEffectSingle('critical_frozen');
					}
					else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('poison_sword'))
					{
						npc.DestroyEffect('critical_poison');
						npc.PlayEffectSingle('critical_poison');
					}
					else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('bleed_sword'))
					{
						npc.DestroyEffect('blood_spill');
						npc.PlayEffectSingle('blood_spill');
					}
					else
					{
						npc.DestroyEffect('critical_burning');
						npc.PlayEffectSingle('critical_burning');
					}
				}

				return;
			}

			if (
			( npc.GetCurrentHealth() <= 0.01 )
			&& !thePlayer.HasTag('ACS_IsPerformingFinisher')
			&& !thePlayer.HasTag('ACS_IsPerformingCombatDismember')
			&& ACS_BuffCheck()
			&& !thePlayer.IsCrossbowHeld()
			//&& !npc.HasTag('ACS_caretaker_shade')
			//&& !npc.HasTag('ACS_Wild_Hunt_Rider')
			)
			{	
				if ( VecDistanceSquared2D( thePlayer.GetWorldPosition(), npc.GetNearestPointInBothPersonalSpaces( thePlayer.GetWorldPosition() ) ) < finisherDist * finisherDist )
				{
					if (!thePlayer.IsWeaponHeld('fist')
					&& !thePlayer.IsInFistFightMiniGame()
					)
					{
						if (!npc.HasTag('ACS_man_finisher_dlc_arm_lp_combat_dismember')
						&& !npc.HasTag('ACS_man_finisher_dlc_arm_rp_combat_dismember')
						&& !npc.HasTag('ACS_man_finisher_dlc_legs_lp_combat_dismember')
						&& !npc.HasTag('ACS_man_finisher_dlc_legs_rp_combat_dismember')
						)
						{
							dismembermentComp = (CDismembermentComponent)(npc.GetComponentByClassName( 'CDismembermentComponent' ));

							if(dismembermentComp)
							{
								dismembermentComp.GetWoundsNames( wounds );

								for( i=wounds.Size()-1; i>=0; i-=1 )
								{
									if( !StrContains( wounds[ i ], "gash" ) 
									)
									{
										wounds.EraseFast( i );
									}
								}

								/*
								if (npc.IsHuman())
								{
									for( i=wounds.Size()-1; i>=0; i-=1 )
									{
										if( !StrContains( wounds[ i ], "gash" ) 
										)
										{
											wounds.EraseFast( i );
										}
									}
								}
								else if (npc.IsMonster())
								{
									for( i=wounds.Size()-1; i>=0; i-=1 )
									{
										if( !StrContains( wounds[ i ], "gash" ) 
										|| !StrContains( wounds[ i ], "cut" ) 
										|| !StrContains( wounds[ i ], "head" ) 
										)
										{
											wounds.EraseFast( i );
										}
									}
								}
								*/

								if ( wounds.Size() > 0 )
								{
									usedWound = wounds[ RandRange( wounds.Size() ) ];
								}
							}
							

							movementAdjustor.CancelAll();
							
							if (!thePlayer.IsWeaponHeld('fist') )
							{
								npc.SoundEvent("bone_break_bb_acs");
					
								npc.SoundEvent("breach_bb_acs");

								npc.SetDismembermentInfo( usedWound, npc.GetWorldPosition() - npc.GetWorldPosition(), false, DETF_Igni );
							}

							npc.AddTimer( 'ACS_DelayedDismemberTimer', 0.05f, false );
						}
					}

					ACS_PerformFinisher(npc);

					Fear_Stack();

					npc.SoundEvent("cmb_play_hit_heavy");
					GetWitcherPlayer().SoundEvent("cmb_play_hit_heavy");
					GetWitcherPlayer().SoundEvent("cmb_play_dismemberment_gore");
					GetWitcherPlayer().SoundEvent("monster_dettlaff_monster_vein_hit_blood");

					npc.DrainStamina( ESAT_FixedValue, npc.GetStatMax( BCS_Stamina ), 60 );

					if( RandF() < ACS_Settings_Main_Float('acs_taunt_settings','acs_finisher_taunt_chance', 0.25) ) 
					{
						PlayerCommentEnd();
					}

					if (ACS_Armor_Set_Check('acs_armor', false))
					{
						thePlayer.SoundEvent("monster_caretaker_fx_black_exhale");

						thePlayer.SoundEvent("monster_caretaker_fx_summon");
						
						if (thePlayer.GetStat(BCS_Focus) >= thePlayer.GetStatMax( BCS_Focus ) * 0.9875
						&& thePlayer.GetStat(BCS_Stamina) == thePlayer.GetStatMax(BCS_Stamina))
						{
							npc.DestroyEffect('critical_burning');
							npc.PlayEffectSingle('critical_burning');
						}
					}

					if (thePlayer.HasTag('ACS_Flammable_Oil_Enabled'))
					{
						if (ACS_GetItem_SwordHeldSwitchBasedUponStat('frost_sword'))
						{
							npc.DestroyEffect('critical_frozen');
							npc.PlayEffectSingle('critical_frozen');
						}
						else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('poison_sword'))
						{
							npc.DestroyEffect('critical_poison');
							npc.PlayEffectSingle('critical_poison');
						}
						else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('bleed_sword'))
						{
							npc.DestroyEffect('blood_spill');
							npc.PlayEffectSingle('blood_spill');
						}
						else
						{
							npc.DestroyEffect('critical_burning');
							npc.PlayEffectSingle('critical_burning');
						}
					}

					
				}

				return;
			}
		}
	}

	function ACS_Dismember_Internal(npc : CActor, action : W3DamageAction)
	{
		var tmpBool 				: bool;
		var mc 						: EMonsterCategory;
		var tmpName 				: name;
		var i						: int;
		var attackName 				: name;

		if (FactsQuerySum("acs_transformation_activated") > 0
		|| npc.HasTag('ACS_DisableDismemberment')
		)
		{
			return;
		}

		if (!action.IsActionMelee())
		{
			return;
		}

		if (
		((thePlayer.IsWeaponHeld('fist')
		&& !thePlayer.HasTag('acs_vampire_claws_equipped'))
		|| thePlayer.IsInFistFightMiniGame())
		&& !ACS_Settings_Main_Bool('acs_custom_finishers_settings','acs_fist_dismemberment_enabled', false)
		)
		{
			return;
		}

		attackName = ((W3Action_Attack)action).GetAttackName();

		if (npc.GetImmortalityMode() != AIM_Invulnerable
		&& npc.GetImmortalityMode() != AIM_Immortal)
		{
			wounds.Clear();

			if (npc.IsHuman() 
			&& !npc.IsUsingHorse()
			&& !npc.IsUsingVehicle()
			)
			{
				if ( npc.UsesVitality() && npc.GetStat( BCS_Vitality ) <= 0 )
				{	
					Fear_Stack();

					if (npc.HasAbility('ForceFinisher'))
					{
						npc.RemoveAbility( 'ForceFinisher');
					}

					npc.SetBehaviorMimicVariable( 'gameplayMimicsMode', (float)(int)GMM_Tpose );

					npc.GetComponent("Finish").SetEnabled(false);

					if (!npc.HasTag('ACS_man_finisher_dlc_arm_lp_combat_dismember')
					&& !npc.HasTag('ACS_man_finisher_dlc_arm_rp_combat_dismember')
					&& !npc.HasTag('ACS_man_finisher_dlc_legs_lp_combat_dismember')
					&& !npc.HasTag('ACS_man_finisher_dlc_legs_rp_combat_dismember')
					)
					{
						dismembermentComp = (CDismembermentComponent)(npc.GetComponentByClassName( 'CDismembermentComponent' ));

						if(dismembermentComp)
						{
							dismembermentComp.GetWoundsNames( wounds );

							for( i=wounds.Size()-1; i>=0; i-=1 )
							{
								if( !StrContains( wounds[ i ], "_torso" ) 
								)
								{
									wounds.EraseFast( i );
								}
							}
						
							if ( wounds.Size() >= 0 )
							{
								usedWound = wounds[ RandRange( wounds.Size() ) ];
							}

							npc.SoundEvent("bone_break_bb_acs");
					
							npc.SoundEvent("breach_bb_acs");

							npc.SetDismembermentInfo( usedWound, npc.GetWorldPosition() - npc.GetWorldPosition(), false );
						}

						ACS_ApplyForce((CNewNPC)npc);

						if (thePlayer.HasTag('acs_vampire_claws_equipped') 
						&& thePlayer.IsLastEnemyKilled()
						&& !npc.HasTag('ACS_Final_Fear_Stack')
						&& attackName != 'attack_heavy'
						)
						{
							npc.AddTimer( 'ACS_DelayedDismemberTimer', 2.25f, false );
						}
						else
						{
							if ( GetWitcherPlayer().IsItemEquippedByName('acs_bruxa_bite_item') 
							&& thePlayer.GetInventory().GetItemName( thePlayer.GetSelectedItemId() ) == 'acs_bruxa_bite_item' 
							&& !npc.HasTag('ACS_Final_Fear_Stack')
							//&& !thePlayer.IsLastEnemyKilled()
							&& attackName != 'attack_heavy'
							)
							{
								npc.AddTimer( 'ACS_DelayedDismemberTimer', 2.25f, false );
							}
							else
							{
								npc.AddTimer( 'ACS_DelayedDismemberTimer', 0.05f, false );
							}
						}
					}
					
					if (npc.IsHuman() && npc.HasTag('ACS_caretaker_shade'))
					{
						thePlayer.GainStat( BCS_Vitality, thePlayer.GetStatMax( BCS_Vitality ) * 0.10 );

						ShowHealFloatingValue(thePlayer.GetStatMax( BCS_Vitality ) * 0.10, true);
					}

					if (thePlayer.HasTag('acs_vampire_claws_equipped'))
					{
						if(RandF() < 0.5)
						{
							thePlayer.SoundEvent("monster_dettlaff_monster_combat_geralt_deathblow_01");
						}
						else
						{
							thePlayer.SoundEvent("monster_dettlaff_monster_combat_geralt_deathblow_02");
						}

						Player_Claws_Blood_Effect(npc);

						if (thePlayer.IsLastEnemyKilled() 
						&& !npc.HasTag('ACS_Final_Fear_Stack')
						&& attackName != 'attack_heavy'
						&& RandF() < ACS_Settings_Main_Float('acs_custom_finishers_settings','acs_custom_finisher_chance', 1)
						)
						{
							thePlayer.GainStat( BCS_Vitality, thePlayer.GetStatMax( BCS_Vitality ) * 0.10 );

							ShowHealFloatingValue(thePlayer.GetStatMax( BCS_Vitality ) * 0.10, true);

							ACS_PerformFinisherBruxaBite(npc);
						}
						else
						{
							if ( GetWitcherPlayer().IsItemEquippedByName('acs_bruxa_bite_item') 
							&& thePlayer.GetInventory().GetItemName( thePlayer.GetSelectedItemId() ) == 'acs_bruxa_bite_item' 
							&& !npc.HasTag('ACS_Final_Fear_Stack')
							&& attackName != 'attack_heavy'
							)
							{
								thePlayer.GainStat( BCS_Vitality, thePlayer.GetStatMax( BCS_Vitality ) * 0.10 );

								ShowHealFloatingValue(thePlayer.GetStatMax( BCS_Vitality ) * 0.10, true);

								ACS_PerformFinisherBruxaBite(npc);
							}
						}
					}

					if ( ((CNewNPC)npc).GetNPCType() != ENGT_Quest )
					{
						if ( ((CNewNPC)npc).GetNPCType() == ENGT_Guard )
						{
							npc.DestroyAfter(30);
						}
						else
						{
							npc.DestroyAfter(20);
						}
					}

					if (ACS_Armor_Set_Check('acs_armor', false))
					{
						thePlayer.SoundEvent("monster_caretaker_fx_black_exhale");

						thePlayer.SoundEvent("monster_caretaker_fx_summon");

						if (thePlayer.GetStat(BCS_Focus) >= thePlayer.GetStatMax( BCS_Focus ) * 0.9875
						&& thePlayer.GetStat(BCS_Stamina) == thePlayer.GetStatMax(BCS_Stamina))
						{
							npc.DestroyEffect('critical_burning');
							npc.PlayEffectSingle('critical_burning');
						}
					}

					if (thePlayer.HasTag('ACS_Flammable_Oil_Enabled'))
					{
						if (ACS_GetItem_SwordHeldSwitchBasedUponStat('frost_sword'))
						{
							npc.DestroyEffect('critical_frozen');
							npc.PlayEffectSingle('critical_frozen');
						}
						else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('poison_sword'))
						{
							npc.DestroyEffect('critical_poison');
							npc.PlayEffectSingle('critical_poison');
						}
						else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('bleed_sword'))
						{
							npc.DestroyEffect('blood_spill');
							npc.PlayEffectSingle('blood_spill');
						}
						else
						{
							npc.DestroyEffect('critical_burning');
							npc.PlayEffectSingle('critical_burning');
						}
					}
				}
				else if ( npc.UsesEssence() && npc.GetStat( BCS_Essence ) <= 0 )
				{	
					Fear_Stack();

					npc.GetComponent("Finish").SetEnabled(false);

					if (!npc.HasTag('ACS_man_finisher_dlc_arm_lp_combat_dismember')
					&& !npc.HasTag('ACS_man_finisher_dlc_arm_rp_combat_dismember')
					&& !npc.HasTag('ACS_man_finisher_dlc_legs_lp_combat_dismember')
					&& !npc.HasTag('ACS_man_finisher_dlc_legs_rp_combat_dismember')
					)
					{
						dismembermentComp = (CDismembermentComponent)(npc.GetComponentByClassName( 'CDismembermentComponent' ));

						if(dismembermentComp) 
						{
							dismembermentComp.GetWoundsNames( wounds );

							for( i=wounds.Size()-1; i>=0; i-=1 )
							{
								if( !StrContains( wounds[ i ], "_torso" ) 
								)
								{
									wounds.EraseFast( i );
								}
							}
							
							if ( wounds.Size() >= 0 )
							{
								usedWound = wounds[ RandRange( wounds.Size() ) ];
							}

							npc.SoundEvent("bone_break_bb_acs");
					
							npc.SoundEvent("breach_bb_acs");
							
							npc.SetDismembermentInfo( usedWound, npc.GetWorldPosition() - npc.GetWorldPosition(), false );
						}

						ACS_ApplyForce((CNewNPC)npc);

						if (thePlayer.HasTag('acs_vampire_claws_equipped') 
						&& thePlayer.IsLastEnemyKilled() 
						&& !npc.HasTag('ACS_Final_Fear_Stack')
						&& attackName != 'attack_heavy'
						)
						{
							npc.AddTimer( 'ACS_DelayedDismemberTimer', 2.25f, false );
						}
						else
						{
							if ( GetWitcherPlayer().IsItemEquippedByName('acs_bruxa_bite_item') 
							&& thePlayer.GetInventory().GetItemName( thePlayer.GetSelectedItemId() ) == 'acs_bruxa_bite_item' 
							&& !npc.HasTag('ACS_Final_Fear_Stack')
							//&& !thePlayer.IsLastEnemyKilled()
							&& attackName != 'attack_heavy'
							)
							{
								npc.AddTimer( 'ACS_DelayedDismemberTimer', 2.25f, false );
							}
							else
							{
								npc.AddTimer( 'ACS_DelayedDismemberTimer', 0.05f, false );
							}
						}
					}
						
					if (npc.IsHuman() && npc.HasTag('ACS_caretaker_shade'))
					{
						thePlayer.GainStat( BCS_Vitality, thePlayer.GetStatMax( BCS_Vitality ) * 0.10 );

						ShowHealFloatingValue(thePlayer.GetStatMax( BCS_Vitality ) * 0.10, true);
					}

					if (thePlayer.HasTag('acs_vampire_claws_equipped'))
					{
						if(RandF() < 0.5)
						{
							thePlayer.SoundEvent("monster_dettlaff_monster_combat_geralt_deathblow_01");
						}
						else
						{
							thePlayer.SoundEvent("monster_dettlaff_monster_combat_geralt_deathblow_02");
						}

						Player_Claws_Blood_Effect(npc);

						if (thePlayer.IsLastEnemyKilled() 
						&& !npc.HasTag('ACS_Final_Fear_Stack')
						&& attackName != 'attack_heavy'
						&& RandF() < ACS_Settings_Main_Float('acs_custom_finishers_settings','acs_custom_finisher_chance', 1)
						)
						{
							thePlayer.GainStat( BCS_Vitality, thePlayer.GetStatMax( BCS_Vitality ) * 0.10 );

							ShowHealFloatingValue(thePlayer.GetStatMax( BCS_Vitality ) * 0.10, true);

							ACS_PerformFinisherBruxaBite(npc);

	event OnToggleSigns( action : SInputAction )
	{
		var tolerance : float;

		tolerance = 2.5f;

		if( action.value < -tolerance )
		{
			if (FactsQuerySum("acs_transformation_activated") > 0)
			{
				ACS_ExplorationDelayHack(false, 3);

				if (FactsQuerySum("acs_vampireess_transformation_activated") > 0)
				{
					if (ACSGetCActor('ACS_Transformation_Vampiress').HasTag('ACS_Vampiress_Sorceress_Mode'))
					{
						ACS_Transformation_Vampiress_Toggle_Previous_Special();

						ACS_Transformation_Vampiress_Hand_FX_Refresh();
					}
				}

				if (FactsQuerySum("acs_vampire_monster_transformation_activated") > 0)
				{
					if (ACSGetCActor('ACS_Transformation_Vampire_Monster').HasTag('ACS_Vampire_Monster_Ground_Mode'))
					{
						
					}
					else
					{
						ACS_Deal_Damage_To_Abduction_Victim();
					}
				}

				return false;
			}

			if (ACS_Settings_Main_Bool('acs_movement_main_settings','acs_modular_movement_speed_enabled', true))
			{
				if(thePlayer.IsInCombat()
				|| theInput.GetActionValue('Sprint') != 0
				|| theInput.GetActionValue('WalkToggle') != 0
				|| theInput.GetActionValue('SprintToggle') != 0
				)
				{
					if(thePlayer.IsGuarded() 
					|| thePlayer.IsInGuardedState() 
					|| theInput.GetActionValue('LockAndGuard') > 0.5 )
					{
						CycleTargets(true);
					}
					else
					{
						GetWitcherPlayer().TogglePreviousSign();
					}
				}
			}
			else
			{
				if(thePlayer.IsGuarded() 
				|| thePlayer.IsInGuardedState() 
				|| theInput.GetActionValue('LockAndGuard') > 0.5 )
				{
					CycleTargets(true);
				}
				else
				{
					GetWitcherPlayer().TogglePreviousSign();
				}
			}

			if(!thePlayer.IsInCombat()
			&& theInput.GetActionValue('Sprint') == 0
			&& theInput.GetActionValue('WalkToggle') == 0
			&& theInput.GetActionValue('SprintToggle') == 0
			)
			{
				if (currspeed == 0)
				{

				}
				else
				{
					currspeed = CycleLocomotionSpeed( true );
				}
			}
			

			if (FactsQuerySum("ACS_In_Meditation") > 0 
			&& !ACSGetCEntity('ACS_Meditation_Campfire')
			)
			{
				if (thePlayer.IsAnyWeaponHeld() && !thePlayer.IsWeaponHeld('fist'))
				{

				}
				else
				{
					if (meditationPushups)
					{
						meditationPushups = false;

						meditationSquat = true;
					}

					else if (meditationSquat)
					{
						meditationSquat = false;

						meditationSleep = true;
					}

					else if (meditationSleep)
					{
						meditationSleep = false;

						meditationNormal = true;
					}

					else if (meditationNormal)
					{
						meditationNormal = false;

						meditationPushups = true;
					}
				}
			}
			else
			{
				if ( ACS_Settings_Main_Bool('acs_main_settings','acs_mod_enabled', true)
				&& !thePlayer.GetWeaponHolster().IsOnTheMiddleOfHolstering() 
				&& !GetWitcherPlayer().IsPerformingFinisher()
				&& !GetWitcherPlayer().HasTag('acs_in_wraith')
				&& !GetWitcherPlayer().HasTag('ACS_Bruxa_Bite_Process')
				&& ACS_BuffCheck()
				&& GetWitcherPlayer().IsActionAllowed(EIAB_Dodge)
				&& !GetWitcherPlayer().IsInAir()
				&& GetWitcherPlayer().IsActionAllowed(EIAB_Movement)
				&& GetWitcherPlayer().IsActionAllowed(EIAB_LightAttacks)
				&& FactsQuerySum("acs_transformation_activated") <= 0
				&& !GetWitcherPlayer().IsCrossbowHeld() 
				&& !GetWitcherPlayer().IsInHitAnim() 
				&& !thePlayer.IsGuarded() 
				&& !thePlayer.IsInGuardedState() 
				&& theInput.GetActionValue('LockAndGuard') == 0
				&& theGame.GetEngineTimeAsSeconds() - last_sign_switch_arsenal_refresh_time > 1
				)
				{ 
					last_sign_switch_arsenal_refresh_time = theGame.GetEngineTimeAsSeconds();

					ACS_SignSwitchArsenalInit(); 
				} 

				if (thePlayer.IsAnyWeaponHeld() 
				&& !thePlayer.IsWeaponHeld('fist')
				&& !thePlayer.HasTag('acs_vampire_claws_equipped')
				&& !thePlayer.HasTag('acs_aard_sword_equipped')
				&& !thePlayer.IsGuarded() 
				&& !thePlayer.IsInGuardedState() 
				&& theInput.GetActionValue('LockAndGuard') == 0
				&& theGame.GetEngineTimeAsSeconds() - last_sign_switch_taunt_refresh_time > 1
				)
				{ 
					last_sign_switch_taunt_refresh_time = theGame.GetEngineTimeAsSeconds();

					if (thePlayer.HasTag('ACS_IsSwordWalking')){thePlayer.RemoveTag('ACS_IsSwordWalking');}

					RemoveTimer('SwordTauntSwitch'); 
					RemoveTimer('SwordTauntRunningSwitch'); 
					
					
					RemoveTimer('CombatTauntDelay');RemoveTimer('SwordTauntRunningSwitchSecondary'); 
					RemoveTimer('SwordTauntRunningSwitchSecondaryWeaponBlood'); 
					AddTimer('SwordTauntRunningSwitchSecondary', 0.01 , false); 

					if (thePlayer.HasTag('ACS_Sword_Hit_Blood_Trigger'))
					{
						AddTimer('SwordTauntRunningSwitchSecondaryWeaponBlood', 1.01 , false); 

						thePlayer.RemoveTag('ACS_Sword_Hit_Blood_Trigger');
					}
				}
			}

			CycleStances(true);
			
		}
		else if( action.value > tolerance )
		{
			if (FactsQuerySum("acs_transformation_activated") > 0)
			{
				ACS_ExplorationDelayHack(false, 3);

				if (FactsQuerySum("acs_vampireess_transformation_activated") > 0)
				{
					if (ACSGetCActor('ACS_Transformation_Vampiress').HasTag('ACS_Vampiress_Sorceress_Mode'))
					{
						ACS_Transformation_Vampiress_Toggle_Next_Special();

						ACS_Transformation_Vampiress_Hand_FX_Refresh();
					}
				}

				if (FactsQuerySum("acs_vampire_monster_transformation_activated") > 0)
				{
					if (ACSGetCActor('ACS_Transformation_Vampire_Monster').HasTag('ACS_Vampire_Monster_Ground_Mode'))
					{
						
					}
					else
					{
						ACS_Deal_Damage_To_Abduction_Victim();
					}
				}

				return false;
			}

			if (ACS_Settings_Main_Bool('acs_movement_main_settings','acs_modular_movement_speed_enabled', true))
			{
				if(thePlayer.IsInCombat()
				|| theInput.GetActionValue('Sprint') != 0
				|| theInput.GetActionValue('WalkToggle') != 0
				|| theInput.GetActionValue('SprintToggle') != 0
				)
				{
					if(thePlayer.IsGuarded() 
					|| thePlayer.IsInGuardedState() 
					|| theInput.GetActionValue('LockAndGuard') > 0.5 )
					{
						CycleTargets(false);
					}
					else
					{
						GetWitcherPlayer().ToggleNextSign();
					}
				}
			}
			else
			{
				if(thePlayer.IsGuarded() 
				|| thePlayer.IsInGuardedState() 
				|| theInput.GetActionValue('LockAndGuard') > 0.5 )
				{
					CycleTargets(false);
				}
				else
				{
					GetWitcherPlayer().ToggleNextSign();
				}
			}

			if(!thePlayer.IsInCombat()
			&& theInput.GetActionValue('Sprint') == 0
			&& theInput.GetActionValue('WalkToggle') == 0
			&& theInput.GetActionValue('SprintToggle') == 0
			)
			{
				if (currspeed == 4)
				{
					if (ACS_Settings_Main_Bool('acs_movement_main_settings','acs_fast_sprint', true)
					&& theGame.GetEngineTimeAsSeconds() - last_fast_sprint_activate > 2
					&& !fast_sprint_activated
					)
					{
						last_fast_sprint_activate = theGame.GetEngineTimeAsSeconds();

						RemoveTimer('ActivateFastSprint');
						AddTimer('ActivateFastSprint', 1 , false);
					}
				}
				else
				{
					currspeed = CycleLocomotionSpeed( false );
				}
			}

			if (FactsQuerySum("ACS_In_Meditation") > 0 
			&& !ACSGetCEntity('ACS_Meditation_Campfire')
			)
			{
				if (thePlayer.IsAnyWeaponHeld() && !thePlayer.IsWeaponHeld('fist'))
				{

				}
				else
				{
					if (meditationPushups)
					{
						meditationPushups = false;

						meditationSquat = true;
					}

					else if (meditationSquat)
					{
						meditationSquat = false;

						meditationSleep = true;
					}

					else if (meditationSleep)
					{
						meditationSleep = false;

						meditationNormal = true;
					}

					else if (meditationNormal)
					{
						meditationNormal = false;

						meditationPushups = true;
					}
				}
			}
			else
			{
				if ( ACS_Settings_Main_Bool('acs_main_settings','acs_mod_enabled', true)
				&& !thePlayer.GetWeaponHolster().IsOnTheMiddleOfHolstering() 
				&& !GetWitcherPlayer().IsPerformingFinisher()
				&& !GetWitcherPlayer().HasTag('acs_in_wraith')
				&& !GetWitcherPlayer().HasTag('ACS_Bruxa_Bite_Process')
				&& ACS_BuffCheck()
				&& GetWitcherPlayer().IsActionAllowed(EIAB_Dodge)
				&& !GetWitcherPlayer().IsInAir()
				&& GetWitcherPlayer().IsActionAllowed(EIAB_Movement)
				&& GetWitcherPlayer().IsActionAllowed(EIAB_LightAttacks)
				&& FactsQuerySum("acs_transformation_activated") <= 0
				&& !GetWitcherPlayer().IsCrossbowHeld() 
				&& !GetWitcherPlayer().IsInHitAnim() 
				&& !thePlayer.IsGuarded() 
				&& !thePlayer.IsInGuardedState() 
				&& theInput.GetActionValue('LockAndGuard') == 0
				&& theGame.GetEngineTimeAsSeconds() - last_sign_switch_arsenal_refresh_time > 1
				)
				{ 
					last_sign_switch_arsenal_refresh_time = theGame.GetEngineTimeAsSeconds();

					ACS_SignSwitchArsenalInit(); 
				} 

				if (thePlayer.IsAnyWeaponHeld() 
				&& !thePlayer.IsWeaponHeld('fist')
				&& !thePlayer.HasTag('acs_vampire_claws_equipped')
				&& !thePlayer.HasTag('acs_aard_sword_equipped')
				&& !thePlayer.IsGuarded() 
				&& !thePlayer.IsInGuardedState() 
				&& theInput.GetActionValue('LockAndGuard') == 0
				&& theGame.GetEngineTimeAsSeconds() - last_sign_switch_taunt_refresh_time > 1
				)
				{ 
					last_sign_switch_taunt_refresh_time = theGame.GetEngineTimeAsSeconds();

					if (thePlayer.HasTag('ACS_IsSwordWalking')){thePlayer.RemoveTag('ACS_IsSwordWalking');}

					RemoveTimer('SwordTauntSwitch'); 
					RemoveTimer('SwordTauntRunningSwitch'); 
					
					
					RemoveTimer('CombatTauntDelay');RemoveTimer('SwordTauntRunningSwitchSecondary'); 
					RemoveTimer('SwordTauntRunningSwitchSecondaryWeaponBlood'); 
					AddTimer('SwordTauntRunningSwitchSecondary', 0.01 , false); 

					if (thePlayer.HasTag('ACS_Sword_Hit_Blood_Trigger'))
					{
						AddTimer('SwordTauntRunningSwitchSecondaryWeaponBlood', 1.01 , false); 

						thePlayer.RemoveTag('ACS_Sword_Hit_Blood_Trigger');
					}
				}
			}

			CycleStances(false);
		}
	}

	var vACS_PrimaryWeaponSwitch 		: cACS_PrimaryWeaponSwitch;
	
	function PrimaryWeaponSwitch()
	{
		if (ACS_Settings_Main_Bool('acs_main_settings','acs_mod_enabled', true)
		&& FactsQuerySum("acs_transformation_activated") <= 0
		&& !GetWitcherPlayer().HasTag('acs_in_wraith') 
		&& !ACS_New_Replacers_Female_Active()
		&& FactsQuerySum("ACS_Slayer_Active") <= 0
		&& FactsQuerySum("ACS_Azkar_Active") <= 0
		)
		{	
			vACS_PrimaryWeaponSwitch = new cACS_PrimaryWeaponSwitch in this;
			vACS_PrimaryWeaponSwitch.Primary_Weapon_Switch_Engage();
		}
	}

	var vACS_SecondaryWeaponSwitch 		: cACS_SecondaryWeaponSwitch;

	function SecondaryWeaponSwitch()
	{
		if (ACS_Settings_Main_Bool('acs_main_settings','acs_mod_enabled', true)
		&& !ACS_New_Replacers_Female_Active()
		&& FactsQuerySum("acs_transformation_activated") <= 0
		&& !GetWitcherPlayer().HasTag('acs_in_wraith') 
		&& FactsQuerySum("ACS_Slayer_Active") <= 0
		&& FactsQuerySum("ACS_Azkar_Active") <= 0
		)
		{		
			vACS_SecondaryWeaponSwitch = new cACS_SecondaryWeaponSwitch in this;
			vACS_SecondaryWeaponSwitch.Secondary_Weapon_Switch_Engage();
		}
	}

	var vACS_RangedWeaponSwitch : cACS_RangedWeaponSwitch;

	function ACS_RangedWeaponSwitch()
	{
		if (ACS_Settings_Main_Bool('acs_main_settings','acs_mod_enabled', true)
		&& !ACS_New_Replacers_Female_Active()
		&& FactsQuerySum("acs_transformation_activated") <= 0
		&& !GetWitcherPlayer().HasTag('acs_in_wraith') 
		)
		{	
			vACS_RangedWeaponSwitch = new cACS_RangedWeaponSwitch in this;
			vACS_RangedWeaponSwitch.ACS_RangedWeaponSwitch_Engage();
			ACSGetEquippedSword().StopAllEffects();
		}
	}

	event OnCbtAttackHeavy( action : SInputAction )
	{
		var allowed, checkedSword : bool;
		var outKeys : array<EInputKey>;
		var bolt 	: W3BoltProjectile;

		if ( thePlayer.inv.IsItemCrossbow( thePlayer.inv.GetItemFromSlot( 'l_weapon' ) ) )
		{
			thePlayer.OnRangedForceHolster(false, true, false);
		}

		if (theInput.GetActionValue('ControllerCastModifier') > 0.5)
		return false;

		if ( !FocusModeOverlapCheck() )
		return false;

		if (FactsQuerySum("acs_transformation_activated") > 0)
		{
			ACS_ExplorationDelayHack(false, 3);

			if( IsReleased(action) && theInput.GetLastActivationTime( action.aName ) < 0.2 )
			{
				if( thePlayer.IsActionAllowed(EIAB_HeavyAttacks)  )
				{
					if (thePlayer.GetBIsInputAllowed())
					{
						if (FactsQuerySum("acs_wolven_curse_activated") > 0)
						{
							ACS_Transformation_Werewolf_Heavy_Attacks();
						}

						if (FactsQuerySum("acs_toad_transformation_activated") > 0)
						{
							ACS_Transformation_Toad_Heavy_Attacks();
						}

						if (FactsQuerySum("acs_red_miasmal_curse_activated") > 0)
						{
							ACS_Transformation_Red_Miasmal_Heavy_Attacks();
						}

						if (FactsQuerySum("acs_sharley_curse_activated") > 0)
						{
							ACS_Transformation_Sharley_Heavy_Attacks();
						}

						if (FactsQuerySum("acs_black_wolf_curse_activated") > 0)
						{
							ACS_Transformation_Black_Wolf_Heavy_Attacks();
						}

						if (FactsQuerySum("acs_giant_curse_activated") > 0&& !ACSGetCActor('ACS_Transformation_Giant').HasTag('ACS_Transformation_Giant_Block_All_Actions'))
						{
							ACS_Transformation_Giant_Heavy_Attacks();
						}

						if (FactsQuerySum("acs_vampireess_transformation_activated") > 0)
						{
							if (FactsQuerySum("acs_vampireess_transformation_activated") > 0)
							{
								if (!ACSGetCActor('ACS_Transformation_Vampiress').HasTag('ACS_Vampiress_Sorceress_Mode'))
								{
									ACS_Transformation_Vampiress_Heavy_Attacks_Melee();
								}
								else
								{
									ACS_Transformation_Vampiress_Heavy_Attacks_Ranged();
								}
							}
						}

						if (FactsQuerySum("acs_vampire_monster_transformation_activated") > 0)
						{
							if (ACSGetCActor('ACS_Transformation_Vampire_Monster').HasTag('ACS_Vampire_Monster_Ground_Mode'))
							{
								ACS_Transformation_Vampire_Monster_Heavy_Attacks_Ground();
							}
							else
							{
								ACS_Transformation_Vampire_Monster_Heavy_Attack_Air();
							}
						}
					}
				}
			}

			return false;
		}
		
		if ( thePlayer.GetBIsInputAllowed() )
		{
			if(theGame.GetInGameConfigWrapper().GetVarValue('Gameplay', 'EnableAlternateSignCasting') == "1")
			{
				altSignCasting = true;
			}	
			else
			{
				altSignCasting = false;
			}

			if(altSignCasting 
			&& !theInput.LastUsedPCInput() && theInput.GetActionValue('CastSign') > 0.1f && !GetWitcherPlayer().IsCurrentSignChanneled())
			{
				if (ACS_Settings_Main_Bool('acs_signs_settings','acs_alternate_quickcasting_controls_enabled', false))
				{
					return false;
				}

				if(IsPressed( action ))
				{
					
					AltCastSign(ST_Yrden);
					return false;
				}
				else if (IsReleased( action ))
				{
					return false;
				}
			}

			if( thePlayer.IsActionAllowed(EIAB_HeavyAttacks) )
			{
				allowed = false;
				
				if( thePlayer.GetCurrentMeleeWeaponType() == PW_Fists || thePlayer.GetCurrentMeleeWeaponType() == PW_None )
				{
					checkedSword = false;
					if(thePlayer.IsActionAllowed(EIAB_Fists))
						allowed = true;
				}
				else if(thePlayer.IsActionAllowed(EIAB_SwordAttack))
				{
					checkedSword = true;
					allowed = true;
				}
				
				if(allowed)
				{
					if( IsReleased(action) && theInput.GetLastActivationTime( action.aName ) < 0.2 )
					{
						Rage_Counter_Manager(3);

						ACSGetCEntity('ACS_Quen_Bubble').Destroy();
		
						ACSGetCEntity('ACS_Quen_Fx').Destroy();

						ACSGetCEntity('ACS_Sign_Icon').Destroy();

						ACSGetCEntity('ACS_Sign_Icon_Anchor').Destroy();

						if ( ACS_Settings_Main_Bool('acs_main_settings','acs_mod_enabled', true) ) 
						{ 
							if ( checkedSword )
							{
								HeavyAttackSwitch(); //ACS
							}
							else
							{
								FistHeavyAttackSwitch(); //ACS
							}
						} 
						else
						{
							thePlayer.SetupCombatAction( EBAT_HeavyAttack, BS_Released );
						}

						thePlayer.CancelHoldAttacks();
					}
				}
				else
				{
					if(checkedSword)
						thePlayer.DisplayActionDisallowedHudMessage(EIAB_SwordAttack);
					else					
						thePlayer.DisplayActionDisallowedHudMessage(EIAB_Fists);
				}
			}
			else if ( !thePlayer.IsActionBlockedBy(EIAB_HeavyAttacks,'interaction') )
			{
				thePlayer.DisplayActionDisallowedHudMessage(EIAB_HeavyAttacks);
			}
		}
	}

	event OnCbtSpecialAttackWithAlternateLight( action : SInputAction )
	{
		if ( FactsQuerySum("ACS_Azkar_Active") > 0
		|| FactsQuerySum("ACS_Slayer_Active") > 0
		)
		{
			return false;
		}

		if (theInput.GetActionValue('ControllerCastModifier') > 0.5)
		return false;
		
		CbSpecialAttackPC( action, false);
	}
	
	event OnCbtSpecialAttackWithAlternateHeavy( action : SInputAction )
	{
		if ( FactsQuerySum("ACS_Azkar_Active") > 0
		|| FactsQuerySum("ACS_Slayer_Active") > 0
		|| FactsQuerySum("acs_transformation_activated") > 0
		)
		{
			return false;
		}

		if (theInput.GetActionValue('ControllerCastModifier') > 0.5)
		return false;

		if ( !FocusModeOverlapCheck() )
		return false;
		
		CbSpecialAttackPC( action, true);
	}
	
	function CbSpecialAttackPC( action : SInputAction, isHeavy : bool ) 
	{
		var switchAttackType : bool;

		if ( FactsQuerySum("ACS_Azkar_Active") > 0
		|| FactsQuerySum("ACS_Slayer_Active") > 0
		)
		{
			return;
		}
		
		switchAttackType = ShouldSwitchAttackType();
		
		if ( !theInput.LastUsedPCInput() )
		{
			return;
		}

		if (thePlayer.HasTag('ACS_IsSwordWalking'))
		{
			thePlayer.RemoveTag('ACS_IsSwordWalking');
		}

		SwordWalkAdditiveEnd(action);

		if ( thePlayer.inv.IsItemCrossbow( thePlayer.inv.GetItemFromSlot( 'l_weapon' ) ) )
		{
			thePlayer.OnRangedForceHolster(false, true, false);
		}
		
		if ( IsPressed(action) )
		{
			if (switchAttackType != isHeavy) 
			{
				OnCbtSpecialAttackHeavy(action);
			}
			else
			{
				OnCbtSpecialAttackLight(action);
			}
		}
		else if ( IsReleased( action ) )
		{
			if (switchAttackType != isHeavy) 
			{
				OnCbtSpecialAttackHeavy(action);
			}
			else
			{
				OnCbtSpecialAttackLight(action);
			}
		}
	}

	var vACS_Rend_Projectile : cACS_Rend_Projectile;

	public timer function Rend_Projectile_Switch(deltaTime : float , id : int)
	{
		var maxAdrenaline								: float;
		var curAdrenaline								: float;

		vACS_Rend_Projectile = new cACS_Rend_Projectile in this;

		if (ACS_GetItem_Sword_IsEquipped('leviathan_held', 'secondary_weapon'))
		{
			if (thePlayer.GetStat(BCS_Stamina) == 0)
			{
				ACS_Frost_Cone();
				vACS_Rend_Projectile.ACS_Eredin_Frost_Projectile_Engage();
			}
			else
			{
				vACS_Rend_Projectile.ACS_Throw_Leviathan_Engage();
			}
			
			return;
		}

		if (ACS_Armor_Set_Check('acs_armor', false))
		{
			vACS_Rend_Projectile.ACS_Armor_Rend_Projectile_Engage();

			return;
		}
		
		maxAdrenaline = GetWitcherPlayer().GetStatMax(BCS_Focus);
		
		curAdrenaline = GetWitcherPlayer().GetStat(BCS_Focus);

		if (thePlayer.HasTag('ACS_Flammable_Oil_Enabled') )
		{
			if (ACS_GetItem_SwordHeldSwitchBasedUponStat('frost_sword'))
			{
				ACS_Frost_Cone();
				vACS_Rend_Projectile.ACS_Eredin_Frost_Projectile_Engage();
			}
			else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('poison_sword'))
			{
				ACS_Poison_Cloud();
			}
			else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('bleed_sword'))
			{
				ACS_Blood_Arc();
			}
			else
			{
				vACS_Rend_Projectile.ACS_Ifrit_Fire_Projectile_Engage();
			}
		
			return;
		}

		if ( ACS_GetWeaponMode() == 0 
		|| ACS_GetWeaponMode() == 1
		|| ACS_GetWeaponMode() == 2 )
		{
			if ( ACS_Settings_Main_Bool('acs_combat_main_settings','acs_elemental_rend', false) )
			{
				if (curAdrenaline >= maxAdrenaline/3)
				{
					if( GetWitcherPlayer().GetEquippedSign() == ST_Igni && GetWitcherPlayer().HasTag('acs_igni_secondary_sword_equipped') && GetWitcherPlayer().CanUseSkill(S_Sword_s02))
					{
						vACS_Rend_Projectile.ACS_Armor_Rend_Projectile_Engage();
					}
					else if( GetWitcherPlayer().GetEquippedSign() == ST_Axii && GetWitcherPlayer().HasTag('acs_axii_secondary_sword_equipped') && GetWitcherPlayer().CanUseSkill(S_Sword_s02))
					{
						vACS_Rend_Projectile.ACS_Eredin_Frost_Projectile_Engage();
					}
					else if( GetWitcherPlayer().GetEquippedSign() == ST_Aard && GetWitcherPlayer().HasTag('acs_aard_secondary_sword_equipped') && GetWitcherPlayer().CanUseSkill(S_Sword_s02))
					{
						vACS_Rend_Projectile.ACS_Golem_Stone_Projectile_Engage();
					}
					else if( GetWitcherPlayer().GetEquippedSign() == ST_Quen && GetWitcherPlayer().HasTag('acs_quen_secondary_sword_equipped') && GetWitcherPlayer().CanUseSkill(S_Sword_s02))
					{
						vACS_Rend_Projectile.ACS_Root_Projectile_Engage();
					}
					else if( GetWitcherPlayer().GetEquippedSign() == ST_Yrden && GetWitcherPlayer().HasTag('acs_yrden_secondary_sword_equipped') && GetWitcherPlayer().CanUseSkill(S_Sword_s02))
					{
						vACS_Rend_Projectile.ACS_Giant_Shockwave_Mult_Engage();
					}
				}
			}
		}
	}

	event OnCbtSpecialAttackHeavy( action : SInputAction )
	{	
		if ( FactsQuerySum("ACS_Azkar_Active") > 0
		|| FactsQuerySum("ACS_Slayer_Active") > 0
		|| FactsQuerySum("acs_transformation_activated") > 0
		)
		{
			return false;
		}

		if ( !FocusModeOverlapCheck() )
		return false;

		if(!theInput.LastUsedPCInput() && IsPressed( action ) && theInput.GetActionValue( 'CastSign' ) > 0)
		{
			return false;
		}

		if ( thePlayer.inv.IsItemCrossbow( thePlayer.inv.GetItemFromSlot( 'l_weapon' ) ) )
		{
			thePlayer.OnRangedForceHolster(false, true, false);
		}

		if (thePlayer.HasTag('ACS_IsSwordWalking'))
		{
			thePlayer.RemoveTag('ACS_IsSwordWalking');
		}

		SwordWalkAdditiveEnd(action);
		
		if ( IsReleased( action )  )
		{
			thePlayer.CancelHoldAttacks();
			return true;
		}

		if (ACS_Is_DLC_Installed('dlc_spectre') && IsPressed( action ))
		{
			if (thePlayer.HasTag('spectre_rend_cooldown_active'))
			{
				return false;
			}
		}
		
		if ( !IsPlayerAbleToPerformSpecialAttack() )
			return false;
		
		if( !thePlayer.IsActionAllowed(EIAB_HeavyAttacks))
		{
			thePlayer.DisplayActionDisallowedHudMessage(EIAB_HeavyAttacks);
			return false;
		}		
		if(!thePlayer.IsActionAllowed(EIAB_SpecialAttackHeavy))
		{
			thePlayer.DisplayActionDisallowedHudMessage(EIAB_SpecialAttackHeavy);
			return false;
		}
		
		if ( IsPressed(action) )
		{
			thePlayer.RaiseEvent('ACS_SwordWalkAdditiveEnd');thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');RemoveTimer('CombatTauntDelay');thePlayer.RaiseEvent('ACS_SwordTauntEnd');

			if (combatExtraActive)
			{
				RemoveTimer('combatExtraReset');
				
				thePlayer.RaiseEvent('ACS_CombatExtraReset');

				SetCombatExtraStatus(false);
			}

			if (idleAdditiveExtraActive)
			{
				thePlayer.RaiseEvent('ACS_IdleAdditiveReset');

				SetIdleAdditiveExtraStatus(false);
			}

			if (thePlayer.HasTag('ACS_SwordBuffAnimationPlayed'))
			{
				thePlayer.RaiseEvent('ACS_BothHandsAdditiveEnd');

				thePlayer.RemoveTag('ACS_SwordBuffAnimationPlayed');
			}

			if (GetWitcherPlayer().HasTag('ACS_Special_Dodge'))
			{
				GetWitcherPlayer().RemoveTag('ACS_Special_Dodge');
			}

			thePlayer.RaiseEvent('ACS_KickAttackReset');

			thePlayer.RaiseEvent('ACS_TW1AnimsReset');

			if( thePlayer.CanUseSkill(S_Sword_s02) )	
			{	
				//thePlayer.PrepareToAttack();
				//thePlayer.SetPlayedSpecialAttackMissingResourceSound(false);
				//thePlayer.AddTimer( 'IsSpecialHeavyAttackInputHeld', 0.00001, true );

				if (FactsQuerySum("ACS_Combat_Art_Active") > 0
				&& Attack_Directional_Press_Check()
				&& thePlayer.GetStat(BCS_Focus) >= thePlayer.GetStatMax(BCS_Focus) * 0.33
				)
				{
					if (FactsQuerySum("ACS_ShadowFall_Activated") > 0
					)
					{
						ACS_Tutorial_Display_Check('ACS_ShadowFall_Tutorial_Shown');

						GetACSWatcherSecondary().GotoState('ACS_ShadowFall');
					}

					if (FactsQuerySum("ACS_Wolven_Flash_Activated") > 0
					)
					{
						ACS_Tutorial_Display_Check('ACS_Wolven_Flash_Tutorial_Shown');

						GetACSWatcherSecondary().GotoState('ACS_Wolven_Flash');
					}

					if (FactsQuerySum("ACS_Wolven_Cross_Activated") > 0
					)
					{
						ACS_Tutorial_Display_Check('ACS_Wolven_Cross_Tutorial_Shown');

						GetACSWatcherSecondary().GotoState('ACS_Wolven_Cross');
					}


					if (FactsQuerySum("ACS_Mortal_Draw_Activated") > 0
					)
					{
						ACS_Tutorial_Display_Check('ACS_Mortal_Draw_Tutorial_Shown');

						GetACSWatcherSecondary().GotoState('ACS_Mortal_Draw');
					}

					if (FactsQuerySum("ACS_Feainnewedd_Dance_Activated") > 0
					)
					{
						ACS_Tutorial_Display_Check('ACS_Feainnewedd_Dance_Tutorial_Shown');

						GetACSWatcherSecondary().GotoState('ACS_Feainnewedd_Dance');
					}

					if (FactsQuerySum("ACS_One_Mind_Activated") > 0
					)
					{
						ACS_Tutorial_Display_Check('ACS_One_Mind_Tutorial_Shown');

						GetACSWatcherSecondary().GotoState('ACS_One_Mind');
					}

					if (FactsQuerySum("ACS_Spiral_Cloud_Passage_Activated") > 0
					)
					{
						ACS_Tutorial_Display_Check('ACS_Spiral_Cloud_Passage_Tutorial_Shown');

						GetACSWatcherSecondary().GotoState('ACS_Spiral_Cloud_Passage');
					}

				}
				else
				{
					vACS_Setup_Combat_Action_Vanilla = new cACS_Setup_Combat_Action_Vanilla in this;

					vACS_Setup_Combat_Action_Vanilla.Setup_Combat_Action_Heavy_Special_Engage();
				}
			}
			else
			{
				if ( theInput.IsActionPressed('AttackHeavy') )
				{
					theInput.ForceDeactivateAction('AttackHeavy');
				}
				else if ( theInput.IsActionPressed('AttackWithAlternateHeavy') )
				{
					theInput.ForceDeactivateAction('AttackWithAlternateHeavy');
				}
			}
		}
	}

	event OnCommGuard( action : SInputAction )
	{
		if (FactsQuerySum("acs_transformation_activated") > 0)
		{
			return false;
		}

		if (thePlayer.IsPerformingFinisher()
		|| thePlayer.HasTag('ACS_IsPerformingFinisher')
		|| thePlayer.HasTag('ACS_IsPerformingCombatDismember')
		|| thePlayer.HasTag('ACS_Bruxa_Bite_Process')
		|| thePlayer.HasTag('ACS_Transformation_Bruxa_Cloaked')
		|| thePlayer.HasTag('ACS_Ghost_Stance_Active')
		|| thePlayer.HasTag('ACS_Is_Sneaking')
		|| thePlayer.HasTag('ACS_Neutral_Flip')
		|| thePlayer.HasTag('ACS_In_Heavenly_Strike')
		|| thePlayer.HasTag('ACS_In_Dance_Of_Wrath')
		|| thePlayer.HasTag('ACS_In_Combat_Art')
		)
		{
			return false;
		}

		if ( !thePlayer.IsInsideInteraction() )
		{
			if (  thePlayer.IsActionAllowed(EIAB_Parry) )
			{
				if (thePlayer.HasTag('ACS_IsSwordWalking'))
				{
					thePlayer.RemoveTag('ACS_IsSwordWalking');
				}

				SwordWalkAdditiveEnd(action);

				if( IsReleased(action) && thePlayer.GetCurrentStateName() == 'CombatFists' )
					thePlayer.OnGuardedReleased();
					if ( ACS_Settings_Main_Bool('acs_main_settings','acs_mod_enabled', true) ) { RemoveTimer('ACS_Shield_Spawn_Delay'); ACS_Axii_Shield_Destroy_DELAY(); return true;} //ACS
				
				if( IsPressed(action) )
				{
					thePlayer.AddCounterTimeStamp(theGame.GetEngineTime());	

					if (!thePlayer.HasTag('ACS_IsPerformingFinisher')
					&& !thePlayer.HasTag('ACS_IsPerformingCounterWound'))
					{
						action_interrupt();
					}

					thePlayer.SetGuarded(true);
					thePlayer.OnPerformGuard();

					if ( ACS_Settings_Main_Bool('acs_main_settings','acs_mod_enabled', true) ) 
					{ 
						GuardAttack(); 
					}
				}
				else if( IsReleased(action) )
				{
					thePlayer.SetGuarded(false);
					
					if ( ACS_Settings_Main_Bool('acs_main_settings','acs_mod_enabled', true) ) 
					{
						RemoveTimer('ACS_Shield_Spawn_Delay'); 
						
						ACS_Axii_Shield_Destroy_DELAY(); 
						return true;
					}
				}	
			}
			else
			{
				thePlayer.DisplayActionDisallowedHudMessage(EIAB_Parry);				
			}
		}
	}

	public timer function Vampire_Monster_Bats_Gatling(deltaTime : float , id : int)
	{
		GetVampireMonsterClass().ACS_VampireMonsterBatProjectileRepeating_Engage();
	}

	event OnCbtLockAndGuard( action : SInputAction )
	{
		if (FactsQuerySum("acs_transformation_activated") > 0)
		{
			if( IsPressed(action) )
			{
				ACS_ExplorationDelayHack(false, 3);

				if (thePlayer.GetBIsInputAllowed())
				{
					if (FactsQuerySum("acs_giant_curse_activated") > 0)
					{
						ACSGetCActor('ACS_Transformation_Giant').AddTag('ACS_Transformation_Giant_Is_Parrying');

						((CAnimatedComponent)((CNewNPC)ACSGetCActor('ACS_Transformation_Giant')).GetComponentByClassName( 'CAnimatedComponent' )).RaiseBehaviorForceEvent('IgnoreSigns');
					}

					if (FactsQuerySum("acs_vampireess_transformation_activated") > 0)
					{
						if (!ACSGetCActor('ACS_Transformation_Vampiress').HasTag('ACS_Vampiress_Sorceress_Mode'))
						{
							ACS_Transformation_Vampiress_Repel_Melee();
						}
						else
						{
							ACS_Transformation_Vampiress_Repel_Ranged();
						}

						ACSGetCActor('ACS_Transformation_Vampiress').AddTag('ACS_Vampiress_Is_Parrying');
					}

					if (FactsQuerySum("acs_vampire_monster_transformation_activated") > 0)
					{
						if (ACSGetCActor('ACS_Transformation_Vampire_Monster').HasTag('ACS_Vampire_Monster_Ground_Mode'))
						{
							ACSVampireMonsterRemoveAttackTimers();
							ACSGetCActor('ACS_Transformation_Vampire_Monster').AddTag('ACS_Transformation_Vampire_Monster_Is_Parrying');
						}
						else
						{
							thePlayer.SoundEvent('monster_dettlaff_monster_voice_heavy_charge');

							//ACS_Transformation_Vampire_Monster_Special_Light_Attack_Air_Gatling();
						}
					}
				}
			}

			if( IsReleased(action) )
			{
				if (FactsQuerySum("acs_giant_curse_activated") > 0)
				{
					ACSGetCActor('ACS_Transformation_Giant').RemoveTag('ACS_Transformation_Giant_Is_Parrying');

					((CAnimatedComponent)((CNewNPC)ACSGetCActor('ACS_Transformation_Giant')).GetComponentByClassName( 'CAnimatedComponent' )).RaiseBehaviorForceEvent('InterruptOverlay');
				}

				if (FactsQuerySum("acs_vampire_monster_transformation_activated") > 0)
				{
					RemoveTimer('Vampire_Monster_Bats_Gatling');

					GetWitcherPlayer().SoundEvent("q704_bats_stop");

					ACSGetCActor('ACS_Transformation_Vampire_Monster').RemoveTag('ACS_Transformation_Vampire_Monster_Is_Parrying');
				}

				if (FactsQuerySum("acs_vampireess_transformation_activated") > 0)
				{
					ACSGetCActor('ACS_Transformation_Vampiress').RemoveTag('ACS_Vampiress_Is_Parrying');
				}
			}

			return false;
		}

		if (thePlayer.IsPerformingFinisher()
		|| thePlayer.HasTag('ACS_IsPerformingFinisher')
		|| thePlayer.HasTag('ACS_IsPerformingCombatDismember')
		|| thePlayer.HasTag('ACS_Bruxa_Bite_Process')
		|| thePlayer.HasTag('ACS_Transformation_Bruxa_Cloaked')
		|| thePlayer.HasTag('ACS_Ghost_Stance_Active')
		|| thePlayer.HasTag('ACS_Is_Sneaking')
		|| thePlayer.HasTag('ACS_Neutral_Flip')
		|| thePlayer.HasTag('ACS_In_Heavenly_Strike')
		|| thePlayer.HasTag('ACS_In_Dance_Of_Wrath')
		|| thePlayer.HasTag('ACS_In_Combat_Art')
		)
		{
			return false;
		}

		if( IsPressed(action) && RadialMenuCheck())
		{
			NightVision();

			return false;
		}

		if (theInput.GetActionValue('ControllerCastModifier') > 0.5)
			return false;

		if (thePlayer.HasTag('ACS_IsSwordWalking'))
		{
			thePlayer.RemoveTag('ACS_IsSwordWalking');
		}

		SwordWalkAdditiveEnd(action);
		
		if( IsReleased(action) )
		{
			if(theGame.GetInGameConfigWrapper().GetVarValue('Gameplay', 'EnableAlternateSignCasting') == "1")
			{
				altSignCasting = true;
			}	
			else
			{
				altSignCasting = false;
			}

			if(altSignCasting
			&& !theInput.LastUsedPCInput() && theInput.GetActionValue('CastSign') > 0.1f && GetWitcherPlayer().IsCurrentSignChanneled())
			{				
				thePlayer.AbortSign();
			}

			thePlayer.SetGuarded(false);
			thePlayer.OnGuardedReleased();	
			if ( ACS_Settings_Main_Bool('acs_main_settings','acs_mod_enabled', true) ) { RemoveTimer('ACS_Shield_Spawn_Delay'); ACS_Axii_Shield_Destroy_DELAY(); return true;} //ACS
		}
		
		if( (thePlayer.IsWeaponHeld('fist') || thePlayer.GetCurrentStateName() == 'CombatFists') && !thePlayer.IsActionAllowed(EIAB_Fists))
		{
			if ( thePlayer.inv.IsItemCrossbow( thePlayer.inv.GetItemFromSlot( 'l_weapon' ) ) )
			{
				thePlayer.OnRangedForceHolster(false, true, false);
			}

			if (!thePlayer.HasTag('ACS_IsPerformingFinisher')
			&& !thePlayer.HasTag('ACS_IsPerformingCounterWound'))
			{
				action_interrupt();
			}

			if ( ACS_Settings_Main_Bool('acs_main_settings','acs_mod_enabled', true) ) { thePlayer.RaiseEvent('ACS_TW1AnimsReset'); GuardAttack(); return true;} //ACS
			thePlayer.DisplayActionDisallowedHudMessage(EIAB_Fists);
			return false;
		}

		if( IsPressed(action) )
		{
			if(theGame.GetInGameConfigWrapper().GetVarValue('Gameplay', 'EnableAlternateSignCasting') == "1")
			{
				altSignCasting = true;
			}	
			else
			{
				altSignCasting = false;
			}

			if(altSignCasting
			&& !theInput.LastUsedPCInput() && theInput.GetActionValue('CastSign') > 0.1f && !GetWitcherPlayer().IsCurrentSignChanneled())
			{

				if (ACS_Settings_Main_Bool('acs_signs_settings','acs_alternate_quickcasting_controls_enabled', false))
				{
					return false;
				}
				
				AltCastSign(ST_Igni);
				return false;
			}

			if ( thePlayer.GetCurrentStateName() == 'Exploration' )
				thePlayer.GoToCombatIfNeeded();
				
			if ( thePlayer.bLAxisReleased )
				thePlayer.ResetRawPlayerHeading();
			
			if ( thePlayer.rangedWeapon && thePlayer.rangedWeapon.GetCurrentStateName() != 'State_WeaponWait' )
				thePlayer.OnRangedForceHolster( true, true );
			
			thePlayer.AddCounterTimeStamp(theGame.GetEngineTime());	

			if (!thePlayer.HasTag('ACS_IsPerformingFinisher')
			&& !thePlayer.HasTag('ACS_IsPerformingCounterWound'))
			{
				action_interrupt();
			}

			thePlayer.SetGuarded(true);
			thePlayer.OnPerformGuard();

			if ( thePlayer.inv.IsItemCrossbow( thePlayer.inv.GetItemFromSlot( 'l_weapon' ) ) )
			{
				thePlayer.OnRangedForceHolster(false, true, false);
			}

			if ( ACS_Settings_Main_Bool('acs_main_settings','acs_mod_enabled', true) ) { GuardAttack(); } //ACS
		}	
	}

	private function IsPlayerAbleToPerformSpecialAttack() : bool
	{
		if( ( thePlayer.GetCurrentStateName() == 'Exploration' ) && !( thePlayer.IsWeaponHeld( 'silversword' ) || thePlayer.IsWeaponHeld( 'steelsword' ) ) )
		{
			return false;
		}
		return true;
	}

	event OnCbtCameraLockOrSpawnHorse( action : SInputAction )
	{
		if ( OnCbtCameraLock(action) )
		{
			return true;
		}
			
		if ( OnCommSpawnHorse(action) )
		{
			return true;
		}
			
		return false;
	}

	private var pressTimestamp : float;

	private var acs_roach_l_aiTree		: CAIFollowSideBySideAction;
	private var acs_roachActionID 		: int;

	public timer function HorseLeadTimer(deltaTime : float , id : int)
	{
		var horse 															: CNewNPC;
		var lines															: array<int>;

		horse = thePlayer.GetHorseWithInventory();

		if( 
		VecDistanceSquared( thePlayer.GetWorldPosition(), horse.GetWorldPosition() ) <= 4 * 4 
		)
		{
			if( horse
			&&	horse.IsAlive()
			&& !thePlayer.IsSailing() 
			&& !thePlayer.IsUsingHorse() 
			&& !thePlayer.IsUsingVehicle() 
			)
			{
				if ( !horse.HasTag('ACS_Roach_Is_Following') )
				{
					lines.Clear();
					lines.PushBack(1128848);
					lines.PushBack(1047201);
					lines.PushBack(1047199);
					lines.PushBack(1047211);
					lines.PushBack(1047209);

					thePlayer.PlayLine( lines[RandRange(lines.Size())], false);

					if(RandF() < 0.5)
					{
						thePlayer.RaiseEvent('ACS_CombatTauntLeft');
					}
					else
					{
						thePlayer.RaiseEvent('ACS_CombatTauntRight');
					}

					acs_roach_l_aiTree = new CAIFollowSideBySideAction in this;
					acs_roach_l_aiTree.OnCreated();
					acs_roach_l_aiTree.params.targetTag = 'PLAYER';
					acs_roach_l_aiTree.params.moveSpeed = 3;
					acs_roach_l_aiTree.params.teleportToCatchup = false;

					acs_roachActionID = horse.ForceAIBehavior(acs_roach_l_aiTree, BTAP_Emergency);

					((CNewNPC)horse).ACS_SetAnimationSpeedMultiplier( 1.25 );

					horse.AddTag('ACS_Roach_Is_Following');
				}
			}
		}
	}

	function TargetLockOrSpawnHorse() : name
	{
		if ( !theInput.LastUsedPCInput() )
		{
			return 'SpawnHorse';
		}
		
		return 'CameraLock';
	}

	function DodgeOrRoll() : name
	{
		if ( !theInput.LastUsedPCInput() )
		{
			return 'CbtRoll';
		}
		
		return 'Dodge';
	}

	public timer function SneakingLureCreateDelay(deltaTime : float , id : int)
	{
		var ent_1 															: CEntity;
		var ent_anchor, ent													: CEntity;
		var bone_vec														: Vector;
		var bone_rot														: EulerAngles;

		ACSGetCEntityDestroyAll('ACS_Sneaking_Lure_Entity');

		ent_1 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

		"dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent"

		, true ), TraceFloor(thePlayer.GetWorldPosition()), thePlayer.GetWorldRotation() );

		ent_1.AddTag('ACS_Sneaking_Lure_Entity');

		ent_1.DestroyAfter(10);


		ent_anchor = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

		"dlc\dlc_acs\data\fx\acs_pulse.w2ent"

		, true ), ent_1.GetWorldPosition() + Vector(0,0,1.75),  ent_1.GetWorldRotation() );

		//ent_anchor.PlayEffectSingle('sonar_contract_red');

		ent_anchor.DestroyAfter(5);

		//thePlayer.StopEffect('acs_sharley_sonar_red');
		//thePlayer.PlayEffect('acs_sharley_sonar_red');


		ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

		"dlc\dlc_acs\data\fx\acs_pulse.w2ent"

		, true ), ent_1.GetWorldPosition(), ent_1.GetWorldRotation() );

		ent.CreateAttachment(ent_anchor,,Vector(-0.25,0,-0.75), EulerAngles(0,0,0) );

		ent.PlayEffectSingle('medallion_pulse_red');

		ent.DestroyAfter(5);
	}

	var last_whistle_time : float;

	event OnCommSpawnHorse( action : SInputAction )
	{
		var isSpawnHorseSecondTap 											: bool;
		var horse 															: CNewNPC;
		var vehicle 														: CVehicleComponent;
		var lines															: array<int>;
		var headcComponent 													: array< CComponent >;

		if (FactsQuerySum("acs_transformation_activated") > 0)
		{
			return false;
		}
		
		if ( 
		ACS_IS_SNEAKING 
		&& thePlayer.HasTag('ACS_Is_Sneaking')
		)
		{
			if( IsPressed( action ) 
			&& theGame.GetEngineTimeAsSeconds() - last_whistle_time > 1
			)
			{
				last_whistle_time = theGame.GetEngineTimeAsSeconds();

				if (thePlayer.HasTag('ACS_IsSwordWalking'))
				{
					thePlayer.RemoveTag('ACS_IsSwordWalking');
				}

				headcComponent.Clear();

				headcComponent = thePlayer.GetComponentsByClassName( 'CHeadManagerComponent' );

				( ( CHeadManagerComponent ) headcComponent[0] ).MimicTest( 'geralt_neutral_gesture_whistle_call_face' );

				thePlayer.SoundEvent("animals_horse_whistle");

				RemoveTimer('SneakingLureCreateDelay');
				AddTimer('SneakingLureCreateDelay', 0.5, false);
			}

			return false;
		}

		horse = thePlayer.GetHorseWithInventory();

		isSpawnHorseSecondTap = false;

		if( IsPressed( action ) )
		{
			if( 
			VecDistanceSquared( thePlayer.GetWorldPosition(), horse.GetWorldPosition() ) <= 4 * 4 
			)
			{
				if ((theInput.IsActionPressed('Sprint') || thePlayer.GetIsSprinting())
				&& (theInput.GetActionValue('GI_AxisLeftX') != 0 || theInput.GetActionValue('GI_AxisLeftY') != 0) 
				)
				{
					vehicle = (CVehicleComponent)( horse.GetHorseComponent() );

					if( vehicle )
					{
						/*
						if (thePlayer.HasTag('ACS_IsSwordWalking'))
						{
							thePlayer.RaiseEvent('ACS_SwordWalkAdditiveEnd');thePlayer.RaiseEvent('ACS_CombatTauntEnd');RemoveTimer('CombatTauntDelay');thePlayer.RaiseEvent('ACS_SwordTauntEnd');

							thePlayer.RemoveTag('ACS_IsSwordWalking');
						}

						if (thePlayer.IsAnyWeaponHeld()
						&& !thePlayer.IsWeaponHeld('fist')
						)
						{
							RemoveTimer('CombatTauntDelay');
							RemoveTimer('SwordTauntRunningSwitchSecondary'); 
							RemoveTimer('SwordTauntRunningSwitchSecondaryWeaponBlood'); 
							AddTimer('SwordTauntRunningSwitchSecondary', 0.01 , false); 
						}

						thePlayer.StopEffect('jump_ground_fx1');
						thePlayer.PlayEffect('jump_ground_fx1');

						thePlayer.RaiseEvent('ACS_HorseMountFlip');

						thePlayer.RaiseEvent('ACS_TorsoBend');

						thePlayer.RaiseEvent( 'ACS_CastAardIdleFast' );

						RemoveTimer('AardLightIcon');

						AddTimer('AardLightIcon', 0.125f, false);

						AardLightIconFeet();

						thePlayer.SoundEvent("sign_aard_blast");

						thePlayer.PlayEffectSingle('acs_fast_sprint_trail');
						thePlayer.StopEffect('acs_fast_sprint_trail');

						((CNewNPC)horse).GetMovingAgentComponent().SetGameplayRelativeMoveSpeed(3); 

						FactsAdd("ACS_Horse_Sprint_Start", 1, -1);
						*/

						//AardMountDealDamage();
						
						vehicle.Mount(thePlayer, VMT_MountIfPossible, EVS_driver_slot);
					}
				}
				else
				{
					RemoveTimer('HorseLeadTimer');
					AddTimer('HorseLeadTimer', 0.5 , false);
				}

				return false;
			}

			return false;
		}

		if( IsReleased( action ) )
		{
			RemoveTimer('HorseLeadTimer');
			
			if ( horse.HasTag('ACS_Roach_Is_Following') )
			{
				lines.Clear();
				lines.PushBack(1128839);
				lines.PushBack(1047203);

				thePlayer.PlayLine( lines[RandRange(lines.Size())], false);
				
				horse.CancelAIBehavior(acs_roachActionID);
				delete acs_roach_l_aiTree;

				((CNewNPC)horse).ACS_SetAnimationSpeedMultiplier( 1 );

				horse.RemoveTag('ACS_Roach_Is_Following');

				return false;
			}
		}
		
		isSpawnHorseSecondTap = pressTimestamp + DOUBLE_TAP_WINDOW >= theGame.GetEngineTimeAsSeconds();

		thePlayer.UnblockAction( EIAB_CallHorse, 'OnCombatActionStart' );

		if( thePlayer.IsActionAllowed( EIAB_CallHorse ) 
			&& !thePlayer.IsInInterior() && !thePlayer.IsInAir()
			&& (isSpawnHorseSecondTap || theInput.LastUsedPCInput()) 
			&& !thePlayer.IsSailing() 
			&& !thePlayer.IsUsingHorse() 
			&& !thePlayer.IsUsingVehicle() 
			)
		{
			((CActor)thePlayer.GetHorseWithInventory()).GetMovingAgentComponent().SetGameplayRelativeMoveSpeed(0);

			((CActor)thePlayer.GetHorseWithInventory()).GetMovingAgentComponent().GetMovementAdjustor().CancelAll();

			RemoveTimer('horse_runaway_repeat');

			RemoveTimer('horse_run_away_stop');

			if ( thePlayer.IsHoldingItemInLHand () )
			{
				thePlayer.OnUseSelectedItem(true);
				thePlayer.SetPlayerActionToRestore ( PATR_CallHorse );
			}
			else
			{
				if( 
				VecDistanceSquared( thePlayer.GetWorldPosition(), horse.GetWorldPosition() ) <= 2 * 2 
				)
				{
					if( horse
					&&	horse.IsAlive()
					&& !thePlayer.IsSailing() 
					&& !thePlayer.IsUsingHorse() 
					&& !thePlayer.IsUsingVehicle() 
					&& !thePlayer.IsSprintActionPressed() 
					&& !thePlayer.GetIsSprintToggled() 
					&& !thePlayer.GetIsSprinting() 
					)
					{
						horse_run_away();
					}
				}
				else
				{
					if (thePlayer.HasTag('ACS_IsSwordWalking'))
					{
						thePlayer.RemoveTag('ACS_IsSwordWalking');
					}

					thePlayer.RaiseEvent('ACS_CombatTauntEnd'); RemoveTimer('CombatTauntDelay');

					RemoveTimer('CombatTauntDelay');

					thePlayer.RaiseEvent('HorseSummon');

					horsesummonanimprogress = true;

					RemoveTimer('HorseSummonAnimProgressComplete');
					AddTimer('HorseSummonAnimProgressComplete', 1.5 , false);

					RemoveTimer('ACSOnSpawnPlayerHorse');
					AddTimer('ACSOnSpawnPlayerHorse', RandRangeF(1, 0.5) , false);
				}
			}			
		}
		else if( isSpawnHorseSecondTap || theInput.LastUsedPCInput() )
		{
			if( thePlayer.IsInInterior() )
				thePlayer.DisplayActionDisallowedHudMessage( EIAB_Undefined, false, true );
			else
				thePlayer.DisplayActionDisallowedHudMessage( EIAB_CallHorse );
		}
			
		pressTimestamp = theGame.GetEngineTimeAsSeconds();
			
		return true;
	}

	public timer function HorseSummonAnimProgressComplete(deltaTime : float , id : int)
	{
		horsesummonanimprogress = false;

		ACSGetCEntity('ACS_Horse_Portal').BreakAttachment();
	}

	public timer function LootHerbAnimProgressComplete(deltaTime : float , id : int)
	{
		lootherbanimprogress = false;
	}


	public timer function CreateHorsePortal(deltaTime : float , id : int)
	{
		var vehicle 						: CVehicleComponent;
		var horse 							: CNewNPC;
		var temp							: CEntityTemplate;
		var ent								: CEntity;

		horse = thePlayer.GetHorseWithInventory();

		temp = (CEntityTemplate)LoadResource( 

		"dlc\dlc_acs\data\fx\horse_portal\horse_portal.w2ent"
			
		, true );

		ACSGetCEntity('ACS_Horse_Portal').Destroy();

		ent = theGame.CreateEntity( temp, ACSFixZAxis(horse.GetWorldPosition()), thePlayer.GetWorldRotation() );

		ent.CreateAttachment(horse);

		ent.PlayEffectSingle('teleport_fx');

		ent.AddTag('ACS_Horse_Portal');

		ent.DestroyAfter(3);

		theGame.GetBehTreeReactionManager().CreateReactionEventIfPossible( thePlayer, 'CastSignAction', 1, 1.75f, -1.f, -1, true );

		thePlayer.GetHorseWithInventory().SignalGameplayEventParamObject( 'HorseSummon', thePlayer );
			
		((W3HorseComponent)thePlayer.GetHorseWithInventory().GetHorseComponent()).NGELookatPlayer();
	}

	timer function SpawnHorseAtClosestTravelPost(deltaTime : float , id : int)
	{
		var signposts						: array<CGameplayEntity>;
		var array_of_nodes					: array<CNode>;
		var closest_signpost_node			: CNode;
		var i								: int;
		var horse 							: CNewNPC;

		FindGameplayEntitiesInRange(
		signposts,
		thePlayer,
		5000, 
		100, 
		, 
		FLAG_ExcludePlayer,
		, 
		'W3FastTravelEntity'
		);

		for (i = 0; i < signposts.Size(); i += 1) 
		{
			array_of_nodes.PushBack((CNode)signposts[i]);
		}

		closest_signpost_node = FindClosestNode(thePlayer.GetWorldPosition(), array_of_nodes);
		
		horse = thePlayer.GetHorseWithInventory();

		horse.Teleport(closest_signpost_node.GetWorldPosition());

		thePlayer.GetHorseWithInventory().SignalGameplayEventParamObject( 'HorseSummon', thePlayer );
			
		((W3HorseComponent)thePlayer.GetHorseWithInventory().GetHorseComponent()).NGELookatPlayer();
	}

	private function OnPlayerHorseSummoned( horseEntity : CEntity )
	{
		var saddle	 		: SItemUniqueId;
		var horseManager	: W3HorseManager;
		var horse			: CActor;

		
		horseManager = GetWitcherPlayer().GetHorseManager();
		saddle = horseManager.GetItemInSlot(EES_HorseSaddle);
		if ( horseManager.GetInventoryComponent().GetItemName(saddle) == 'Devil Saddle' )
		{
			
			horse = (CActor)horseEntity;
			horse.AddEffectDefault(EET_WeakeningAura, horse, 'horse saddle', false);
		}
		
		thePlayer.GetHorseWithInventory().SignalGameplayEventParamObject( 'HorseSummon', thePlayer );
		
		GetWitcherPlayer().GetHorseManager().ApplyHorseUpdateOnSpawn();
	}

	public timer function ACSOnSpawnPlayerHorse(deltaTime : float , id : int)
	{
		var createEntityHelper				: CR4CreateEntityHelper;
		var vehicle 						: CVehicleComponent;
		var horse 							: CNewNPC;
		var spawnPos, newSpawnPos			: Vector;

		horse = thePlayer.GetHorseWithInventory();

		((CNewNPC)horse).ACS_SetAnimationSpeedMultiplier( 1 );

		if (ACS_Settings_Main_Bool('acs_horse_settings','acs_instant_mount_enabled', false))
		{
			if( !horse
			||	!horse.IsAlive())
			{
				createEntityHelper = new CR4CreateEntityHelper in theGame;
				createEntityHelper.SetPostAttachedCallback( theGame, 'OnPlayerHorseSummoned' );
				theGame.SummonPlayerHorse( true, createEntityHelper ); 

				if( thePlayer.inv.HasItem( 'acs_horse_teleport_item' ) )
				{
					spawnPos = theCamera.GetCameraPosition() + theCamera.GetCameraDirection() * -6;

					if( !theGame.GetWorld().NavigationFindSafeSpot( spawnPos, 1.0, 6.0 , newSpawnPos ) )
					{
						theGame.GetWorld().NavigationFindSafeSpot( spawnPos, 1, 6.0 , newSpawnPos );
						spawnPos = newSpawnPos;
					}

					horse.Teleport(spawnPos);

					thePlayer.GetHorseWithInventory().SignalGameplayEventParamObject( 'HorseSummon', thePlayer );
						
					((W3HorseComponent)thePlayer.GetHorseWithInventory().GetHorseComponent()).NGELookatPlayer();

					RemoveTimer('CreateHorsePortal');
					AddTimer('CreateHorsePortal', 0.125 , false);
				}
				else
				{
					RemoveTimer('SpawnHorseAtClosestTravelPost');
					AddTimer('SpawnHorseAtClosestTravelPost', 0.1 , false);
				}
			}
			else
			{
				if( VecDistanceSquared2D( thePlayer.GetWorldPosition(), horse.GetWorldPosition() ) > 100 * 100 )
				{
					if( thePlayer.inv.HasItem( 'acs_horse_teleport_item' ) )
					{
						createEntityHelper = new CR4CreateEntityHelper in theGame;
						createEntityHelper.SetPostAttachedCallback( theGame, 'OnPlayerHorseSummoned' );
						theGame.SummonPlayerHorse( true, createEntityHelper ); 

						spawnPos = theCamera.GetCameraPosition() + theCamera.GetCameraDirection() * -6;

						if( !theGame.GetWorld().NavigationFindSafeSpot( spawnPos, 1.0, 6.0 , newSpawnPos ) )
						{
							theGame.GetWorld().NavigationFindSafeSpot( spawnPos, 1, 6.0 , newSpawnPos );
							spawnPos = newSpawnPos;
						}

						horse.Teleport(spawnPos);

						thePlayer.GetHorseWithInventory().SignalGameplayEventParamObject( 'HorseSummon', thePlayer );
							
						((W3HorseComponent)thePlayer.GetHorseWithInventory().GetHorseComponent()).NGELookatPlayer();


						RemoveTimer('CreateHorsePortal');
						AddTimer('CreateHorsePortal', 0.125 , false);
					}
					else
					{
						RemoveTimer('SpawnHorseAtClosestTravelPost');
						AddTimer('SpawnHorseAtClosestTravelPost', 0.1 , false);
						
						theGame.GetGuiManager().ShowNotification(GetLocStringById(2118449446));
					}
				}
				else
				{
					horse.SignalGameplayEventParamObject( 'HorseSummon', thePlayer );
					
					((W3HorseComponent)horse.GetHorseComponent()).NGELookatPlayer();
				}

				if( horse 
				&& !thePlayer.IsSailing() 
				&& !thePlayer.IsUsingHorse() 
				&& !thePlayer.IsUsingVehicle() 
				)
				{
					horse.TeleportWithRotation( thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() ); 

					RemoveTimer('CreateHorsePortal');
					AddTimer('CreateHorsePortal', 0.125 , false);

					vehicle = (CVehicleComponent)( horse.GetHorseComponent() );

					if( vehicle )
					{
						vehicle.Mount(thePlayer, VMT_ImmediateUse, EVS_driver_slot);
					}
				}
			}
		}
		else
		{
			if( !horse
			||	!horse.IsAlive())
			{
				createEntityHelper = new CR4CreateEntityHelper in theGame;
				createEntityHelper.SetPostAttachedCallback( theGame, 'OnPlayerHorseSummoned' );
				theGame.SummonPlayerHorse( true, createEntityHelper ); 

				if( thePlayer.inv.HasItem( 'acs_horse_teleport_item' ) )
				{
					spawnPos = theCamera.GetCameraPosition() + theCamera.GetCameraDirection() * -6;

					if( !theGame.GetWorld().NavigationFindSafeSpot( spawnPos, 1.0, 6.0 , newSpawnPos ) )
					{
						theGame.GetWorld().NavigationFindSafeSpot( spawnPos, 1, 6.0 , newSpawnPos );
						spawnPos = newSpawnPos;
					}

					horse.Teleport(spawnPos);

					thePlayer.GetHorseWithInventory().SignalGameplayEventParamObject( 'HorseSummon', thePlayer );
						
					((W3HorseComponent)thePlayer.GetHorseWithInventory().GetHorseComponent()).NGELookatPlayer();

					RemoveTimer('CreateHorsePortal');
					AddTimer('CreateHorsePortal', 0.125 , false);
				}
				else
				{
					RemoveTimer('SpawnHorseAtClosestTravelPost');
					AddTimer('SpawnHorseAtClosestTravelPost', 0.1 , false);
				}
			}
			else
			{
				if (VecDistanceSquared2D( thePlayer.GetWorldPosition(), horse.GetWorldPosition() ) > 100 * 100)
				{
					if( thePlayer.inv.HasItem( 'acs_horse_teleport_item' ) )
					{
						createEntityHelper = new CR4CreateEntityHelper in theGame;
						createEntityHelper.SetPostAttachedCallback( theGame, 'OnPlayerHorseSummoned' );
						theGame.SummonPlayerHorse( true, createEntityHelper ); 

						spawnPos = theCamera.GetCameraPosition() + theCamera.GetCameraDirection() * -6;

						if( !theGame.GetWorld().NavigationFindSafeSpot( spawnPos, 1.0, 6.0 , newSpawnPos ) )
						{
							theGame.GetWorld().NavigationFindSafeSpot( spawnPos, 1, 6.0 , newSpawnPos );
							spawnPos = newSpawnPos;
						}

						horse.Teleport(spawnPos);

						thePlayer.GetHorseWithInventory().SignalGameplayEventParamObject( 'HorseSummon', thePlayer );
							
						((W3HorseComponent)thePlayer.GetHorseWithInventory().GetHorseComponent()).NGELookatPlayer();


						RemoveTimer('CreateHorsePortal');
						AddTimer('CreateHorsePortal', 0.125 , false);
					}
					else
					{
						RemoveTimer('SpawnHorseAtClosestTravelPost');
						AddTimer('SpawnHorseAtClosestTravelPost', 0.1 , false);

						theGame.GetGuiManager().ShowNotification(GetLocStringById(2118449446));
					}
				}
				else
				{
					horse.SignalGameplayEventParamObject( 'HorseSummon', thePlayer );
					
					((W3HorseComponent)horse.GetHorseComponent()).NGELookatPlayer();

					PlayerSpeakController('show_up_when_whistle');
				}
			}
			
		}

		thePlayer.OnSpawnHorse();
	}

	private var studyTargetCallTime																											: float;
	private var studyTargetDoubleTap 																										: bool;

	public var ghost_stance_kill_count : int;

	public var ghost_stance_active_kill_count : int;


	function Ghost_Stance_Kill_Increment( active : bool, num : int )
	{
		var anchor_temp											: CEntityTemplate;
		var anchor2												: CEntity;
	
		if (!active)
		{
			if (num == 0)
			{
				ghost_stance_active_kill_count -= ghost_stance_active_kill_count;

				ghost_stance_kill_count -= ghost_stance_kill_count;

				if (FactsQuerySum("ACS_Ghost_Stance_Notification_Seen") > 0)
				{
					FactsRemove("ACS_Ghost_Stance_Notification_Seen");
				}
			}
			else
			{
				if (ghost_stance_kill_count >= 6
				)
				{
					if (FactsQuerySum("ACS_Ghost_Stance_Notification_Seen") <= 0
					&& (thePlayer.HasTag('acs_igni_sword_equipped') || thePlayer.HasTag('acs_igni_secondary_sword_equipped'))
					)
					{
						ACS_Tutorial_Display_Check('ACS_Gwynbleidd_Stance_Tutorial_Shown');

						anchor_temp = (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\fx\wolf_decal.w2ent", true );
			
						anchor2 = (CEntity)theGame.CreateEntity( anchor_temp, thePlayer.GetWorldPosition() );
						anchor2.CreateAttachment( GetWitcherPlayer(), , Vector(0,0,2.125) );

						anchor2.DestroyAfter(2);

						anchor2.PlayEffectSingle('gwynbleidd_icon');

						if ( !theSound.SoundIsBankLoaded("monster_werewolf.bnk") )
						{
							theSound.SoundLoadBank( "monster_werewolf.bnk", false );
						}

						thePlayer.SoundEvent("qu_nv_503_werewolf_howl");
						thePlayer.SoundEvent("qu_nv_503_werewolf_howl");
						thePlayer.SoundEvent("qu_nv_503_werewolf_howl");
						thePlayer.SoundEvent("qu_nv_503_werewolf_howl");
						thePlayer.SoundEvent("qu_nv_503_werewolf_howl");
						thePlayer.SoundEvent("qu_nv_503_werewolf_howl");
						thePlayer.SoundEvent("monster_werewolf_morkvarg_appear");
						thePlayer.SoundEvent("monster_werewolf_morkvarg_disappear");

						FactsAdd("ACS_Ghost_Stance_Notification_Seen", 1, -1);
					}
				}
				else
				{
					ghost_stance_kill_count += num;
				}
			}
		}
		else
		{
			if (num == 0)
			{
				ghost_stance_active_kill_count -= ghost_stance_active_kill_count;
			}
			else
			{
				if (ghost_stance_active_kill_count >= 2
				)
				{

				}
				else
				{
					ghost_stance_active_kill_count += num;
				}
			}
		}
		
	}

	function MeditationFireSourceCheck() : bool
	{
		var i : int;
		var ents : array<CGameplayEntity>;
		var gameplayLightComp, pointLightComp : CComponent;
		var playerPosZ, entPosZ : float;
		var playerPos, entPos : Vector;

		ents.Clear();
		
		//FindGameplayEntitiesInRange(ents,thePlayer,4.5,50,,FLAG_ExcludePlayer,, );

		FindGameplayEntitiesInCone(ents, thePlayer.GetWorldPosition() + thePlayer.GetWorldForward(), VecHeading(thePlayer.GetHeadingVector()), 90, 5, 50, ,FLAG_ExcludePlayer, ,);
		
		for ( i = 0; i < ents.Size(); i+=1 )
		{
			playerPos = thePlayer.GetWorldPosition();

			playerPos.Z = playerPosZ;

			entPos = ents[i].GetWorldPosition();

			entPos.Z = entPosZ;


			if (entPosZ <= playerPosZ + 1.5)
			{
				gameplayLightComp = ents[i].GetComponentByClassName('CGameplayLightComponent');

				pointLightComp = ents[i].GetComponentByClassName('CPointLightComponent');

				if(gameplayLightComp)
				{
					if (((CGameplayLightComponent)gameplayLightComp).IsLightOn())
					{
						return true;
					}
				}

				if (pointLightComp)
				{
					if (((CPointLightComponent)pointLightComp).IsEnabled())
					{
						return true;
					}
				}
			}
		}
		
		return false;
	}

	var last_sword_glint_time : float;

	function LightSourceCheck() : bool
	{
		var i : int;
		var ents : array<CGameplayEntity>;
		var gameplayLightComp, pointLightComp : CComponent;

		if (thePlayer.HasTag('ACS_Flammable_Oil_Enabled') )
		{
			if (!ACS_GetItem_SwordHeldSwitchBasedUponStat('frost_sword')
			&& !ACS_GetItem_SwordHeldSwitchBasedUponStat('poison_sword')
			&& !ACS_GetItem_SwordHeldSwitchBasedUponStat('bleed_sword')
			)
			{
				return true;
			}
		}

		ents.Clear();
		
		//FindGameplayEntitiesInRange(ents,thePlayer,4.5,50,,FLAG_ExcludePlayer,, );

		FindGameplayEntitiesInCone(ents, thePlayer.GetWorldPosition() + thePlayer.GetWorldForward(), VecHeading(thePlayer.GetHeadingVector()), 270, 30, 50, ,FLAG_ExcludePlayer, ,);
		
		for ( i = 0; i < ents.Size(); i+=1 )
		{
			gameplayLightComp = ents[i].GetComponentByClassName('CGameplayLightComponent');

			pointLightComp = ents[i].GetComponentByClassName('CPointLightComponent');

			if(gameplayLightComp)
			{
				if (((CGameplayLightComponent)gameplayLightComp).IsLightOn())
				{
					return true;
				}
			}

			if (pointLightComp)
			{
				if (((CPointLightComponent)pointLightComp).IsEnabled())
				{
					return true;
				}
			}
		}
		
		return false;
	}

	event OnCbtCameraLock( action : SInputAction )
	{	
		if( IsPressed(action) )
		{
			if ((theInput.GetActionValue('LockAndGuard') > 0.1f 
			|| theInput.GetActionValue('Guard') > 0.1f)
			&& !theGame.IsDialogOrCutscenePlaying() 
			&& !theGame.GetPhotomodeEnabled() 
			&& !thePlayer.IsInCutsceneIntro() 
			&& !theGame.IsCurrentlyPlayingNonGameplayScene() 
			&& !theGame.IsFading()
			&& !theGame.IsBlackscreen()
			&& !theGame.IsPaused() 
			&& thePlayer.IsAnyWeaponHeld() 
			&& !thePlayer.IsWeaponHeld('fist')
			&& !thePlayer.HasTag('ACS_Ghost_Stance_Active')
			)
			{
				if (thePlayer.GetStat(BCS_Focus) >= thePlayer.GetStatMax(BCS_Focus) * 0.33
				&& FactsQuerySum("ACS_Ghost_Stance_Notification_Seen") > 0
				&& thePlayer.IsThreatened()
				)
				{
					thePlayer.AddTag('ACS_Ghost_Stance_Active');

					return false;
				}
				
				if (thePlayer.GetStat(BCS_Stamina) > 0
				&& !thePlayer.HasTag('ACS_Player_Is_Attacking') 
				&& !thePlayer.IsDoingSpecialAttack(true)
				&& !thePlayer.IsDoingSpecialAttack(false)
				&& !thePlayer.IsCastingSign()
				&& !ACS_Cast_Sign_Process
				&& !thePlayer.IsCurrentlyDodging()
				&& ACS_BuffCheck()
				&& theGame.GetEngineTimeAsSeconds() - last_sword_glint_time > 1
				)
				{
					last_sword_glint_time = theGame.GetEngineTimeAsSeconds();

					if (LightSourceCheck())
					{
						GetACSWatcherSecondary().GotoState('ACS_Sword_Glint');

						ACS_Tutorial_Display_Check('ACS_Sword_Glint_Tutorial_Shown');

						return false;
					}

					if (FactsQuerySum("ACS_Darkness_Upon_Us") <= 0
					&& GetWeatherConditionName() != 'WT_Rain_Heavy' 
					&& GetWeatherConditionName() != 'WT_Rain_Dark' 
					&& GetWeatherConditionName() != 'WT_Rain_Storm' 
					&& GetWeatherConditionName() != 'WT_Rain' 
					&& !ACS_IsInDarkPlace()
					&& !RoofCheck()
					)
					{
						GetACSWatcherSecondary().GotoState('ACS_Sword_Glint');

						ACS_Tutorial_Display_Check('ACS_Sword_Glint_Tutorial_Shown');

						return false;
					}

					if(thePlayer.GetCombatIdleStance() <= 0.f )
					{
						thePlayer.RaiseEvent('ACS_CombatTauntLeft');
					}
					else
					{
						thePlayer.RaiseEvent('ACS_CombatTauntRight');
					}

					return false;
				}
			}

			if( studyTargetCallTime + DOUBLE_TAP_WINDOW >= theGame.GetEngineTimeAsSeconds() )
			{
				studyTargetDoubleTap = true;
			}
			else
			{
				studyTargetDoubleTap = false;	
			}

			if( studyTargetDoubleTap )
			{
				if (thePlayer.GetDisplayTarget()
				&& (CActor)( thePlayer.GetDisplayTarget()) 
				&& FactsQuerySum("ACS_Study_Target_Active") <= 0
				&& !thePlayer.IsInAir()
				&& !thePlayer.HasTag('ACS_IsPerformingFinisher')
				&& !thePlayer.HasTag('ACS_In_Combat_Art')
				&& FactsQuerySum("ACS_Mounted_Attack_Attachment_Active") <= 0
				&& !horseLeapStrikeProcess
				&& !thePlayer.IsInAir()
				&& !thePlayer.IsFalling()
				)
				{
					RemoveTimer('StudyTargetRemoveTimer');

					ACS_SlowMoAdjustable(0.0001, 999);

					AddTimer('StudyTargetRemoveTimer', 7 , false);

					FactsAdd("ACS_Study_Target_Active", 1, -1);
				}
				else if( FactsQuerySum("ACS_Study_Target_Active") > 0)
				{
					RemoveTimer('StudyTargetRemoveTimer');

					RemoveTimer('RemoveACSSlowmo');

					theGame.RemoveTimeScale( theGame.GetTimescaleSource(ETS_InstantKill) );

					FactsRemove("ACS_Study_Target_Active");
				}
			}
			else
			{
				if ( thePlayer.IsThreatened() || thePlayer.IsActorLockedToTarget() )
				{
					if( !thePlayer.IsActionAllowed(EIAB_CameraLock))
					{
						return false;
					}

					if (!theInput.LastUsedPCInput())
					{
						if ( !thePlayer.IsHardLockEnabled() 
						&& thePlayer.GetDisplayTarget() 
						&& (CActor)( thePlayer.GetDisplayTarget() ) 
						&& thePlayer.IsActionAllowed(EIAB_HardLock))
						{	
							if ( thePlayer.bLAxisReleased )
							{
								thePlayer.ResetRawPlayerHeading();
							}

							thePlayer.HardLockToTarget( true );
						}
						else
						{
							thePlayer.HardLockToTarget( false );
						}	
					}
					else
					{
						ACS_Tutorial_Display_Check('ACS_Target_Lock_Tutorial_Shown');

						RemoveTimer('TargetLockDelay');
						AddTimer('TargetLockDelay', 0.5 , false);
					}
				}
			}
			
			studyTargetCallTime = theGame.GetEngineTimeAsSeconds();
		}

		if( IsReleased(action) )
		{
			RemoveTimer('TargetLockDelay');
		}

		return false;
	}

	public timer function TargetLockDelay(deltaTime : float , id : int)
	{
		if ( thePlayer.IsThreatened() || thePlayer.IsActorLockedToTarget() )
		{
			if ( !thePlayer.IsHardLockEnabled() 
			&& thePlayer.GetDisplayTarget() 
			&& (CActor)( thePlayer.GetDisplayTarget() ) 
			&& thePlayer.IsActionAllowed(EIAB_HardLock))
			{	
				if ( thePlayer.bLAxisReleased )
				{
					thePlayer.ResetRawPlayerHeading();
				}

				thePlayer.HardLockToTarget( true );
			}
			else
			{
				thePlayer.HardLockToTarget( false );
			}	
		}
	}

	function AnimProgressCheck() : bool
	{
		if (potionaniminprogress)
		{
			return false;
		}

		if (maskaniminprogress)
		{
			return false;
		}

		if (hoodaniminprogress)
		{
			return false;
		}

		if (cloakaniminprogress)
		{
			return false;
		}

		if (horsesummonanimprogress)
		{
			return false;
		}

		if (lootherbanimprogress)
		{
			return false;
		}

		if (itemuseanimprogress)
		{
			return false;
		}

		return true;
	}

	private var potionUpperHeld, potionLowerHeld : bool;	

	private var potionModeHold : bool;	

	default potionModeHold = true;

	private var radialPotionUpperTimer, radialPotionLowerTimer : bool;
	public function SetRadialPotionUpperTimer(set:bool){radialPotionUpperTimer = set;}
	public function SetRadialPotionLowerTimer(set:bool){radialPotionLowerTimer = set;}

	timer function DrinkRadialPotionUpper( delta : float , id : int)
	{
		GetWitcherPlayer().OnPotionDrinkInput(true);
		SetRadialPotionUpperTimer(false);
	}
	
	timer function DrinkRadialPotionLower( delta : float , id : int)
	{
		GetWitcherPlayer().OnPotionDrinkInput(false);
		SetRadialPotionLowerTimer(false);
	}

	event OnCommDrinkpotionUpperHeld( action : SInputAction )
	{
		if (!AnimProgressCheck())
		{
			return false;
		}

		if(!potionModeHold)
			return false;

		if(RadialMenuCheck())
		{
			RemoveTimer('DrinkRadialPotionUpper');
			radialPotionUpperTimer = false;
		}
			
		if(IsReleased(action))
			return false;
		
		potionUpperHeld = true;
		GetWitcherPlayer().FlipSelectedPotion(true);
	}
	
	event OnCommDrinkpotionLowerHeld( action : SInputAction )
	{
		if (!AnimProgressCheck())
		{
			return false;
		}
		
		if(!potionModeHold)
			return false;

		if(RadialMenuCheck())
		{
			RemoveTimer('DrinkRadialPotionLower');
			radialPotionLowerTimer = false;
		}
			
		if(IsReleased(action))
			return false;
		
		potionLowerHeld = true;
		GetWitcherPlayer().FlipSelectedPotion(false);
	}
	
	public final function SetPotionSelectionMode(b : bool)
	{
		potionModeHold = b;
	}

	private final function DrinkPotion(action : SInputAction, upperSlot : bool) : bool
	{
		var witcher : W3PlayerWitcher;

		witcher = GetWitcherPlayer();

		if (!AnimProgressCheck())
		{
			return false;
		}

		if(RadialMenuCheck())
		{		
			if( IsPressed(action) && !witcher.GetRadialPopupShown() )
			{
				if(upperSlot)
				{
					if(radialPotionUpperTimer)
					{
						if(witcher.GetSelectedPotionSlotUpper() == EES_Potion1)
						{
							witcher.PotionSelectionPopup( EISPM_RadialMenuSlot1 );
						}
							
						else
						{
							witcher.PotionSelectionPopup( EISPM_RadialMenuSlot3 );
						}
							
						RemoveTimer('DrinkRadialPotionUpper');

						radialPotionUpperTimer = false;
						return false;
					}
					
					AddTimer('DrinkRadialPotionUpper', 0.035f , false);

					radialPotionUpperTimer = true;
				}
				else
				{
					if(radialPotionLowerTimer)
					{
						if(witcher.GetSelectedPotionSlotLower() == EES_Potion2)
						{
							witcher.PotionSelectionPopup( EISPM_RadialMenuSlot2 );
						}
						else
						{
							witcher.PotionSelectionPopup( EISPM_RadialMenuSlot4 );
						}
							
						RemoveTimer('DrinkRadialPotionLower');

						radialPotionLowerTimer = false;
						return false;
					}
					
					AddTimer('DrinkRadialPotionLower', 0.035f , false);

					radialPotionLowerTimer = true;
				}
			}
			
			potionUpperHeld = false;
			potionLowerHeld = false;
			return false;
		}
		
		if ( potionModeHold && IsReleased(action) )
		{
			if(!potionUpperHeld && !potionLowerHeld)
			{
				if (upperSlot)
				{
					if ( !thePlayer.IsHoldingItemInLHand() && !thePlayer.IsCrossbowHeld() ) 
					{
						PotionOrFoodSwitchController(GetWitcherPlayer().GetSelectedPotionSlotUpper());
					}
					else
					{
						RemoveTimer('PotionSlotUpperDelay');
						AddTimer('PotionSlotUpperDelay', 1 , false);
					}
				}
				else
				{
					if ( !thePlayer.IsHoldingItemInLHand() && !thePlayer.IsCrossbowHeld() ) 
					{
						PotionOrFoodSwitchController(GetWitcherPlayer().GetSelectedPotionSlotLower());
					}
					else
					{
						RemoveTimer('PotionSlotLowerDelay');
						AddTimer('PotionSlotLowerDelay', 1 , false);
					}
				}
			}
			
			if(upperSlot)
				potionUpperHeld = false;
			else
				potionLowerHeld = false;
		}		
		else if(!potionModeHold && IsPressed(action))
		{
			witcher = GetWitcherPlayer();
			if(!witcher.IsPotionDoubleTapRunning())
			{
				witcher.SetPotionDoubleTapRunning(true, upperSlot);
				return true;
			}
			else
			{
				witcher.SetPotionDoubleTapRunning(false);
				witcher.FlipSelectedPotion(upperSlot);				
				return true;
			}
		}
		
		return false;
	}

	public timer function PotionSlotUpperDelay(deltaTime : float , id : int)
	{
		GetWitcherPlayer().OnPotionDrinkInput(true);

		AddTimer('SetPotionsAnimProgressDelay', 3 , false);
	}

	public timer function PotionSlotLowerDelay(deltaTime : float , id : int)
	{
		GetWitcherPlayer().OnPotionDrinkInput(false);

		AddTimer('SetPotionsAnimProgressDelay', 3 , false);
	}

	function AttachUseableItem(slot : EEquipmentSlots)
	{
		var item 															: SItemUniqueId;
		var temp															: CEntityTemplate;
		var ent																: CEntity;
		var attach_vec														: Vector;
		var attach_rot														: EulerAngles;
		var timeToDestroy, h												: float;
		var meshcomp														: CComponent;
		var animcomp 														: CAnimatedComponent;
	
		GetWitcherPlayer().GetItemEquippedOnSlot( slot, item );

		if (
		(GetWitcherPlayer().inv.GetItemCategory(item) == 'potion' 
		&& GetWitcherPlayer().inv.ItemHasTag(item, 'Potion'))
		)
		{
			temp = (CEntityTemplate)LoadResource(
				"dlc\dlc_acs\data\models\potion_bottle\acs_potion_bottle.w2ent"
				//"dlc\bob\data\quests\main_quests\quest_files\q704_truth\entities\q704_dropped_potion_app.w2ent"
				//"items\quest_items\mh107\mh107_item_czart_lure_potion.w2ent"
				//"items\quest_items\q401\q401_item__drip\q401_item__drip_blue_potion.w2ent"
				//"items\quest_items\q401\q401_item__drip\q401_item__drip_gray_potion.w2ent"
				//"items\quest_items\q401\q401_item__drip\q401_item__drip_red_potion.w2ent"
				//"dlc\bob\data\quests\main_quests\quest_files\q704_truth\entities\q704_dropped_potion_app.w2ent"
				//"dlc\bob\data\quests\main_quests\quest_files\q704_truth\entities\q704_dropped_potion_container.w2ent"
				//"dlc\bob\data\items\quest_items\mh701\mh701_item_sharely_lure_potion.w2ent"
				//"dlc\bob\data\quests\minor_quests\quest_files\mq7017_talking_horse\entities\mq7017_4_potion_bottle.w2ent"
				//
				//

			, true );

			attach_rot.Roll = 0;
			attach_rot.Pitch = 180;
			attach_rot.Yaw = 0;
			attach_vec.X = 0;
			attach_vec.Y = 0;
			attach_vec.Z = 0.2;

			timeToDestroy = 3.75;
		}
		else if 
		(
			GetWitcherPlayer().inv.ItemHasTag(item, 'Edibles')
		)
		{
			if (GetWitcherPlayer().inv.ItemHasTag(item, 'Drinks'))
			{
				temp = (CEntityTemplate)LoadResource(

				"quests\prologue\quest_files\q002_emhyr\entities\q002_empty_bottles.w2ent"
				//"quests\sidequests\novigrad\quest_files\sq310_dangerous_game\entities\sq310_voka_bottle_container.w2ent"
				//"quests\part_1\quest_files\q105_witches\entities\q105_item__godling_bottle.w2ent"

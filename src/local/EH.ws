	var last_necrofiend_proj_spawn_time					: float;

	var vACS_Necrofiend 		: cACS_Necrofiend;

	function Necrofiend_Manager()
	{
		if (!ACSGetCActor('ACS_Necrofiend'))
		{
			return;
		}

		if ((theGame.GetEngineTimeAsSeconds() - last_necrofiend_proj_spawn_time > 7) && ACSGetCActor('ACS_Necrofiend').IsAlive())
		{
			last_necrofiend_proj_spawn_time = theGame.GetEngineTimeAsSeconds();

			vACS_Necrofiend = new cACS_Necrofiend in this;

			vACS_Necrofiend.ACS_Necrofiend_Proj_Start_Engage();
		}	
	}

	var vACS_Nekker_Guardian 							: cACS_Nekker_Guardian;

	var last_nekker_guardian_spawn_time 				: float;

	var last_nekker_guardian_heal_time					: float;

	function Can_Spawn_Nekker_Guardian() : bool
	{
		return theGame.GetEngineTimeAsSeconds() - last_nekker_guardian_spawn_time > 60;
	}

	function Refresh_Nekker_Guardian_Cooldown()
	{
		last_nekker_guardian_spawn_time = theGame.GetEngineTimeAsSeconds();
	}

	function Nekker_Guardian_Manager()
	{
		if (!ACSGetCActor('ACS_Nekker_Guardian'))
		{
			vACS_Nekker_Guardian = new cACS_Nekker_Guardian in this;

			vACS_Nekker_Guardian.ACS_Nekker_Guardian_Start_Engage();
		}
		else
		{
			if (ACSGetCActor('ACS_Nekker_Guardian') && ACSGetCActor('ACS_Nekker_Guardian').IsAlive())
			{
				if (theGame.GetEngineTimeAsSeconds() - last_nekker_guardian_heal_time > 3)
				{
					last_nekker_guardian_heal_time = theGame.GetEngineTimeAsSeconds();

					vACS_Nekker_Guardian = new cACS_Nekker_Guardian in this;

					vACS_Nekker_Guardian.ACS_Nekker_Guardian_Heal_Engage();
				}
			}
		}
		
	}

	var vACS_Fire_Bear_Projectiles			: cACS_Fire_Bear_Projectiles;

	function ACS_Fire_Bear_Flames_Manager()
	{
		var animatedComponentA																									: CAnimatedComponent;
		var movementAdjustorNPC																									: CMovementAdjustor; 
		var ticketNPC 																											: SMovementAdjustmentRequestTicket; 
		var targetDistance, fireballChance, firelineChance, fireballDistance, firelineDistance, flameOnChance					: float;

		if (!ACSGetCActor('ACS_Fire_Bear') 
		|| !ACSGetCActor('ACS_Fire_Bear').IsAlive()
		|| ACSGetCActor('ACS_Fire_Bear').ACS_IsInDimeritiumCloud()
		)
		{
			return;
		}

		animatedComponentA = (CAnimatedComponent)((CNewNPC)ACSGetCActor('ACS_Fire_Bear')).GetComponentByClassName( 'CAnimatedComponent' );	

		movementAdjustorNPC = ACSGetCActor('ACS_Fire_Bear').GetMovingAgentComponent().GetMovementAdjustor();

		targetDistance = VecDistanceSquared2D( ACSGetCActor('ACS_Fire_Bear').GetWorldPosition(), GetWitcherPlayer().GetWorldPosition() );

		if (ACSGetCActor('ACS_Fire_Bear') 
		&& ACSGetCActor('ACS_Fire_Bear').IsAlive()
		&& !animatedComponentA.HasFrozenPose())
		{
			if (ACS_bear_can_flame_on()
			&& ACS_Fire_Bear_FireLine_Process == false
			&& ACS_Fire_Bear_Fireball_Process == false
			&& ACS_Fire_Bear_Meteor_Process == false
			)
			{
				if (ACS_FireBearBuffCheck()
				&& !ACSGetCActor('ACS_Fire_Bear').IsEffectActive('flames', false)
				)
				{
					ACS_refresh_bear_flame_on_cooldown();

					ACS_Fire_Bear_FlameOn_Process = true;

					if (ACSGetCActor('ACS_Fire_Bear').GetStat(BCS_Essence) <= ACSGetCActor('ACS_Fire_Bear').GetStatMax(BCS_Essence)/2)
					{
						flameOnChance = 0.95;
					}
					else
					{
						flameOnChance = 0.5;
					}

					if( RandF() < flameOnChance )
					{
						ticketNPC = movementAdjustorNPC.GetRequest( 'ACS_Fire_FlameOn_Rotate');
						movementAdjustorNPC.CancelByName( 'ACS_Fire_FlameOn_Rotate' );

						ticketNPC = movementAdjustorNPC.CreateNewRequest( 'ACS_Fire_FlameOn_Rotate' );
						movementAdjustorNPC.AdjustmentDuration( ticketNPC, 0.01 );
						movementAdjustorNPC.MaxRotationAdjustmentSpeed( ticketNPC, 50000 );

						movementAdjustorNPC.RotateTowards( ticketNPC, GetWitcherPlayer() );

						animatedComponentA.PlaySlotAnimationAsync ( 'bear_special_attack', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 1));

						ACSGetCActor('ACS_Fire_Bear').RemoveBuff(EET_FireAura, true, 'acs_fire_bear_fire_aura');

						ACSGetCActor('ACS_Fire_Bear').AddEffectDefault( EET_FireAura, ACSGetCActor('ACS_Fire_Bear'), 'acs_fire_bear_fire_aura' );

						ACSGetCActor('ACS_Fire_Bear').PlayEffectSingle('flames');

						RemoveTimer('ACSFireBearFlameOnDelay');
						AddTimer('ACSFireBearFlameOnDelay', 1.5 , false);
					}
					else
					{
						ACS_Fire_Bear_FlameOn_Process = false;
					}
				}
			}

			if (ACS_bear_can_throw_fireball()
			&& ACS_Fire_Bear_FlameOn_Process == false
			&& ACS_Fire_Bear_FireLine_Process == false
			&& ACS_Fire_Bear_Meteor_Process == false
			)
			{
				ACS_refresh_bear_fireball_cooldown();

				ACS_Fire_Bear_Fireball_Process = true;

				if (ACSGetCActor('ACS_Fire_Bear').GetStat(BCS_Essence) <= ACSGetCActor('ACS_Fire_Bear').GetStatMax(BCS_Essence)/2)
				{
					fireballChance = 0.25;

					fireballDistance = 5;

					if (ACSGetCActor('ACS_Fire_Bear').IsEffectActive('flames', false))
					{
						fireballChance += 0.25;

						fireballDistance -= 2;
					}
				}
				else
				{
					fireballChance = 0.125;

					fireballDistance = 7;

					if (ACSGetCActor('ACS_Fire_Bear').IsEffectActive('flames', false))
					{
						fireballChance += 0.125;

						fireballDistance -= 2;
					}
				}

				if( RandF() < fireballChance )
				{
					if ( ACS_FireBearBuffCheck()
					//&& ACSGetCActor('ACS_Fire_Bear').IsInCombat()
					)
					{
						if ( targetDistance > fireballDistance * fireballDistance && targetDistance < 35 * 35 )
						{
							ticketNPC = movementAdjustorNPC.GetRequest( 'ACS_Fire_Bear_Fireball_Rotate');
							movementAdjustorNPC.CancelByName( 'ACS_Fire_Bear_Fireball_Rotate' );

							ticketNPC = movementAdjustorNPC.CreateNewRequest( 'ACS_Fire_Bear_Fireball_Rotate' );
							movementAdjustorNPC.AdjustmentDuration( ticketNPC, 0.25 );
							movementAdjustorNPC.MaxRotationAdjustmentSpeed( ticketNPC, 50000 );

							movementAdjustorNPC.RotateTowards( ticketNPC, GetWitcherPlayer() );

							//animatedComponentA.PlaySlotAnimationAsync ( 'bear_attack_bite', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0, 0));

							//Fireball();

							if( RandF() < 0.5 )
							{
								animatedComponentA.PlaySlotAnimationAsync ( 'bear_attack_swing_left_move', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 1));

								RemoveTimer('ACSFireBearFireballLeftDelay');
								AddTimer('ACSFireBearFireballLeftDelay', 0.75 , false);
							}
							else
							{
								animatedComponentA.PlaySlotAnimationAsync ( 'bear_attack_swing_right_move', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 1));

								RemoveTimer('ACSFireBearFireballRightDelay');
								AddTimer('ACSFireBearFireballRightDelay', 0.75 , false);
							}
						}
						else if (targetDistance > 35 * 35)
						{
							ACS_Fire_Bear_Fireball_Process = false;

							ACS_dropbearmeteorstart();
						}
						else
						{
							ACS_Fire_Bear_Fireball_Process = false;
						}
					}
				}
				else
				{
					ACS_Fire_Bear_Fireball_Process = false;
				}
			}

			if (ACS_bear_can_throw_fireline()
			&& ACS_Fire_Bear_FlameOn_Process == false
			&& ACS_Fire_Bear_Fireball_Process == false
			&& ACS_Fire_Bear_Meteor_Process == false
			)
			{
				ACS_refresh_bear_fireline_cooldown();

				ACS_Fire_Bear_FireLine_Process = true;

				if (ACSGetCActor('ACS_Fire_Bear').GetStat(BCS_Essence) <= ACSGetCActor('ACS_Fire_Bear').GetStatMax(BCS_Essence)/2)
				{
					firelineChance = 0.5;

					firelineDistance = 5;

					if (ACSGetCActor('ACS_Fire_Bear').IsEffectActive('flames', false))
					{
						fireballChance += 0.25;

						firelineDistance -= 2;
					}
				}
				else
				{
					firelineChance = 0.25;

					firelineDistance = 7;

					if (ACSGetCActor('ACS_Fire_Bear').IsEffectActive('flames', false))
					{
						firelineChance += 0.25;

						firelineDistance -= 2;
					}
				}

				if( RandF() < firelineChance )
				{
					if (ACS_FireBearBuffCheck()
					//&& ACSGetCActor('ACS_Fire_Bear').IsInCombat()
					)
					{
						if ( targetDistance > firelineDistance * firelineDistance && targetDistance < 25 * 25 )
						{
							ticketNPC = movementAdjustorNPC.GetRequest( 'ACS_Fire_Bear_Fireball_Rotate');
							movementAdjustorNPC.CancelByName( 'ACS_Fire_Bear_Fireball_Rotate' );

							ticketNPC = movementAdjustorNPC.CreateNewRequest( 'ACS_Fire_Bear_Fireball_Rotate' );
							movementAdjustorNPC.AdjustmentDuration( ticketNPC, 0.75 );
							movementAdjustorNPC.MaxRotationAdjustmentSpeed( ticketNPC, 50000 );

							movementAdjustorNPC.RotateTowards( ticketNPC, GetWitcherPlayer() );

							animatedComponentA.PlaySlotAnimationAsync ( 'bear_taunt02', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 1));

							RemoveTimer('ACSFireBearFireLineDelay');
							AddTimer('ACSFireBearFireLineDelay', 2 , false);
						}
						else if ( targetDistance > 25 * 25 )
						{
							ACS_Fire_Bear_FireLine_Process = false;

							ACS_dropbearmeteorstart();
						}
						else
						{
							ACS_Fire_Bear_FireLine_Process = false;
						}
					}
				}
				else
				{
					ACS_Fire_Bear_FireLine_Process = false;
				}
			}
		}	
	}


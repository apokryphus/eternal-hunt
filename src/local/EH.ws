				GetACSStorage().acs_setScaleForOnelinerByTag("ACS_Witcher_School_Switch_Notification", 100, 100, 100);
			}

			if (FactsQuerySum("ACS_Dual_Wield_Toggle_Enabled") > 0)
			{

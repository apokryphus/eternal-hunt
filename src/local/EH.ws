	private var minimapAlphaMin : float;
	default minimapAlphaMin = 0;

	private var minimapAlphaMinProcess : bool;
	default minimapAlphaMinProcess = false;

	private var questAlphaMin : float;
	default questAlphaMin = 0;

	private var questAlphaMinProcess : bool;
	default questAlphaMinProcess = false;

	private var controlHintAlphaMin : float;
	default controlHintAlphaMin = 0;

	private var controlHintAlphaMinProcess : bool;
	default controlHintAlphaMinProcess = false;

	private var buffsAlphaMin : float;
	default buffsAlphaMin = 0;

	private var buffsAlphaMinProcess : bool;
	default buffsAlphaMinProcess = false;

	private var wolfsHeadHudAlphaMin : float;
	default wolfsHeadHudAlphaMin = 0;

	private var wolfsHeadHudAlphaMinProcess : bool;
	default wolfsHeadHudAlphaMinProcess = false;

	private var itemsHudAlphaMin : float;
	default itemsHudAlphaMin = 0;

	private var itemsHudAlphaMinProcess : bool;
	default itemsHudAlphaMinProcess = false;

	timer function MinimapModuleFadeFlashObjectIn(dt : float , id : int)
	{	
		var hud 															: CR4ScriptedHud;
		var module 															: CR4HudModuleMinimap2;	
		
		hud = (CR4ScriptedHud)theGame.GetHud();

		module = (CR4HudModuleMinimap2)hud.GetHudModule("Minimap2Module");

		module.GetModuleFlash().SetXScale( minimapAlphaMin );
		module.GetModuleFlash().SetYScale( minimapAlphaMin );
		module.GetModuleFlash().SetZScale( minimapAlphaMin );

		module.GetModuleFlash().SetAlpha( 100 );

		if (minimapAlphaMin >= ACS_Settings_Main_Float('acs_hud_settings_positioning_minimap_and_quests','ACS_MinimapScale', 100))
		{
			minimapAlphaMin = 0;

			minimapAlphaMinProcess = true;

			RemoveTimer('MinimapModuleFadeFlashObjectIn');
		}
		else
		{
			minimapAlphaMin += 5;
		}
	}


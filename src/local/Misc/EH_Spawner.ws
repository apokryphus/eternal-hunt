		else
		{				
			//targetPosition = GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetWorldForward() * 10;
			targetPosition = GetWitcherPlayer().GetLookAtPosition();
			//targetPosition.Z += 1.1;
				

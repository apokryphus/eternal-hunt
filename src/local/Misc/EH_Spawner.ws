		iconPath_stamina = "<img src='img://" + "icons/inventory/acs_stamina_bar.xbm" + "' vspace='" + (1) + "' />&nbsp;";

		iconPath_toxicity = "<img src='img://" + "icons/inventory/acs_toxicity_bar.xbm" + "' vspace='" + (1) + "' />&nbsp;";


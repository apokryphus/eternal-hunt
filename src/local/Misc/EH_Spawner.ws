statemachine class cACS_Sword_Array
{
    function Sword_Array_Engage()
	{
		this.PushState('ACS_Sword_Array');
	}
}

state ACS_Sword_Array in cACS_Sword_Array
{
	private var anchor_temp, sword_temp																													: CEntityTemplate;
	private var bonePosition, attach_vec																												: Vector;
	private var boneRotation, attach_rot																												: EulerAngles;
	private var static_torso_sword_1, static_torso_sword_2, static_torso_sword_3, static_torso_sword_4, static_torso_sword_5 							: W3ACSSwordProjectile;	
	private var sword_torso_anchor_1 																													: CEntity;	
	private var movementAdjustor																														: CMovementAdjustor;
	private var ticket 																																	: SMovementAdjustmentRequestTicket;
	private var action 																																	: W3DamageAction;
	private var initpos																																	: Vector;
	private var actor, pActor       																													: CActor;
	private var targetPosition																															: Vector;
	private var meshcomp 																																: CComponent;
	private var h 																																		: float;
	private var actortarget																																: CActor;
	private var actors    																																: array<CActor>;
	private var i         																																: int;
	private var targetPositions																															: array<Vector>;
		
	event OnEnterState(prevStateName : name)
	{
		super.OnEnterState(prevStateName);
		Ready_Swords();
	}
	
	entry function Ready_Swords()
	{
		GetACSWatcher().IdleAdditiveBlockTemp();

		GetACSWatcher().RemoveTimer('ACS_Shout');

		anchor_temp = (CEntityTemplate)LoadResourceAsync( "dlc\dlc_acs\data\entities\other\fx_ent.w2ent", true );
		
		sword_temp = (CEntityTemplate)LoadResourceAsync( "dlc\dlc_acs\data\entities\projectiles\sword_projectile_1.w2ent", true );

		////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

		GetWitcherPlayer().GetBoneWorldPositionAndRotationByIndex( GetWitcherPlayer().GetBoneIndex( 'Trajectory' ), bonePosition, boneRotation );
		sword_torso_anchor_1 = (CEntity)theGame.CreateEntity( anchor_temp, GetWitcherPlayer().GetWorldPosition() + Vector( 0, 0, -10 ) );
		sword_torso_anchor_1.CreateAttachmentAtBoneWS( GetWitcherPlayer(), 'Trajectory', bonePosition, boneRotation );
		sword_torso_anchor_1.AddTag('acs_sword_array_torso_anchor_1');
		
		////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

		static_torso_sword_1 = (W3ACSSwordProjectile)theGame.CreateEntity( sword_temp, GetWitcherPlayer().GetWorldPosition() + Vector( 0, 0, -10 ) );

		////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
		
		// + down/ - up
		attach_rot.Roll = 0;

		attach_rot.Pitch = 0;
		
		// + left/ - right
		attach_rot.Yaw = 0;
		
		attach_vec.X = 0;
		
		//-Forward/+Backward
		attach_vec.Y = 0.75;
		
		//+up/-down
		attach_vec.Z = 2.5;
				
		static_torso_sword_1.CreateAttachment( sword_torso_anchor_1, , attach_vec, attach_rot );

		GetWitcherPlayer().PlayEffectSingle('hit_lightning');
		GetWitcherPlayer().StopEffect('hit_lightning');

		static_torso_sword_1.Init(GetWitcherPlayer());

		static_torso_sword_1.PlayEffectSingle('blade_trail');
		static_torso_sword_1.PlayEffectSingle('appear_flash');
		static_torso_sword_1.PlayEffectSingle('eff_2');
		static_torso_sword_1.PlayEffectSingle('fast_attack_buff');
		static_torso_sword_1.PlayEffectSingle('fast_attack_buff_hit');
		static_torso_sword_1.PlayEffectSingle('fire_sparks_trail');

		if (ACS_Armor_Set_Check('forgotten_wolf', false) 
		|| ACS_Armor_Set_Check('acs_armor', false)
		|| ACS_Armor_Set_Check('volhikar', false)
		|| thePlayer.HasTag('acs_vampire_claws_equipped')
		|| ACS_Vampire_Claws_Access()
		)
		{
			static_torso_sword_1.PlayEffectSingle('glow_red');
		}
		else
		{
			static_torso_sword_1.PlayEffectSingle('glow');
		}

		static_torso_sword_1.AddTag('acs_sword_projectile_01');
		
		////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

		Sleep(0.25f);

		static_torso_sword_2 = (W3ACSSwordProjectile)theGame.CreateEntity( sword_temp, GetWitcherPlayer().GetWorldPosition() + Vector( 0, 0, -10 ) );
	
		attach_rot.Roll = 0;
		attach_rot.Pitch = 0;
		
		attach_rot.Yaw = 0;
		
		//+Up/-Down
		attach_vec.X = 1;
		
		//-Forward/+Backward
		attach_vec.Y = 0.75;
		
		//+Left/-Right
		attach_vec.Z = 2;
				
		static_torso_sword_2.CreateAttachment( sword_torso_anchor_1, , attach_vec, attach_rot );

		static_torso_sword_2.Init(GetWitcherPlayer());
		
		static_torso_sword_2.PlayEffectSingle('blade_trail');
		static_torso_sword_2.PlayEffectSingle('appear_flash');
		static_torso_sword_2.PlayEffectSingle('eff_2');
		static_torso_sword_2.PlayEffectSingle('fast_attack_buff');
		static_torso_sword_2.PlayEffectSingle('fast_attack_buff_hit');
		static_torso_sword_2.PlayEffectSingle('fire_sparks_trail');

		if (ACS_Armor_Set_Check('forgotten_wolf', false) 
		|| ACS_Armor_Set_Check('acs_armor', false)
		|| ACS_Armor_Set_Check('volhikar', false)
		|| thePlayer.HasTag('acs_vampire_claws_equipped')
		|| ACS_Vampire_Claws_Access()
		)
		{
			static_torso_sword_2.PlayEffectSingle('glow_red');
		}
		else
		{
			static_torso_sword_2.PlayEffectSingle('glow');
		}

		static_torso_sword_2.AddTag('acs_sword_projectile_02');
		
		////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

		Sleep(0.25f);

		static_torso_sword_3 = (W3ACSSwordProjectile)theGame.CreateEntity( sword_temp, GetWitcherPlayer().GetWorldPosition() + Vector( 0, 0, -10 ) );

		attach_rot.Roll = 0;
		attach_rot.Pitch = 0;
		
		attach_rot.Yaw = 0;
		
		//+Up/-Down
		attach_vec.X = -1;
		
		//-Forward/+Backward
		attach_vec.Y = 0.75;
		
		//+Left/-Right
		attach_vec.Z = 2;
				
		static_torso_sword_3.CreateAttachment( sword_torso_anchor_1, , attach_vec, attach_rot );

		static_torso_sword_3.Init(GetWitcherPlayer());
		
		static_torso_sword_3.PlayEffectSingle('blade_trail');
		static_torso_sword_3.PlayEffectSingle('appear_flash');
		static_torso_sword_3.PlayEffectSingle('eff_2');
		static_torso_sword_3.PlayEffectSingle('fast_attack_buff');
		static_torso_sword_3.PlayEffectSingle('fast_attack_buff_hit');
		static_torso_sword_3.PlayEffectSingle('fire_sparks_trail');

		if (ACS_Armor_Set_Check('forgotten_wolf', false) 
		|| ACS_Armor_Set_Check('acs_armor', false)
		|| ACS_Armor_Set_Check('volhikar', false)
		|| thePlayer.HasTag('acs_vampire_claws_equipped')
		|| ACS_Vampire_Claws_Access()
		)
		{
			static_torso_sword_3.PlayEffectSingle('glow_red');
		}
		else
		{
			static_torso_sword_3.PlayEffectSingle('glow');
		}

		static_torso_sword_3.AddTag('acs_sword_projectile_03');
		
		////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

		Sleep(0.25f);

		static_torso_sword_4 = (W3ACSSwordProjectile)theGame.CreateEntity( sword_temp, GetWitcherPlayer().GetWorldPosition() + Vector( 0, 0, -10 ) );

		attach_rot.Roll = 0;
		attach_rot.Pitch = 0;
		
		attach_rot.Yaw = 0;
		
		//+Up/-Down
		attach_vec.X = 1;
		
		//-Forward/+Backward
		attach_vec.Y = 0.75;
		
		//+Left/-Right
		attach_vec.Z = 1;
				
		static_torso_sword_4.CreateAttachment( sword_torso_anchor_1, , attach_vec, attach_rot );

		static_torso_sword_4.Init(GetWitcherPlayer());
		
		static_torso_sword_4.PlayEffectSingle('blade_trail');
		static_torso_sword_4.PlayEffectSingle('appear_flash');
		static_torso_sword_4.PlayEffectSingle('eff_2');
		static_torso_sword_4.PlayEffectSingle('fast_attack_buff');
		static_torso_sword_4.PlayEffectSingle('fast_attack_buff_hit');
		static_torso_sword_4.PlayEffectSingle('fire_sparks_trail');

		if (ACS_Armor_Set_Check('forgotten_wolf', false) 
		|| ACS_Armor_Set_Check('acs_armor', false)
		|| ACS_Armor_Set_Check('volhikar', false)
		|| thePlayer.HasTag('acs_vampire_claws_equipped')
		|| ACS_Vampire_Claws_Access()
		)
		{
			static_torso_sword_4.PlayEffectSingle('glow_red');
		}
		else
		{
			static_torso_sword_4.PlayEffectSingle('glow');
		}

		static_torso_sword_4.AddTag('acs_sword_projectile_04');
		
		////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

		Sleep(0.25f);

		static_torso_sword_5 = (W3ACSSwordProjectile)theGame.CreateEntity( sword_temp, GetWitcherPlayer().GetWorldPosition() + Vector( 0, 0, -10 ) );

		attach_rot.Roll = 0;
		attach_rot.Pitch = 0;
		
		attach_rot.Yaw = 0;
		
		//+Up/-Down
		attach_vec.X = -1;
		
		//-Forward/+Backward
		attach_vec.Y = 0.75;
		
		//+Left/-Right
		attach_vec.Z = 1;
				
		static_torso_sword_5.CreateAttachment( sword_torso_anchor_1, , attach_vec, attach_rot );

		static_torso_sword_4.Init(GetWitcherPlayer());
		
		static_torso_sword_5.PlayEffectSingle('blade_trail');
		static_torso_sword_5.PlayEffectSingle('appear_flash');
		static_torso_sword_5.PlayEffectSingle('eff_2');
		static_torso_sword_5.PlayEffectSingle('fast_attack_buff');
		static_torso_sword_5.PlayEffectSingle('fast_attack_buff_hit');
		static_torso_sword_5.PlayEffectSingle('fire_sparks_trail');

		if (ACS_Armor_Set_Check('forgotten_wolf', false) 
		|| ACS_Armor_Set_Check('acs_armor', false)
		|| ACS_Armor_Set_Check('volhikar', false)
		|| thePlayer.HasTag('acs_vampire_claws_equipped')
		|| ACS_Vampire_Claws_Access()
		)
		{
			static_torso_sword_5.PlayEffectSingle('glow_red');
		}
		else
		{
			static_torso_sword_5.PlayEffectSingle('glow');
		}

		static_torso_sword_5.AddTag('acs_sword_projectile_05');
		
		////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

		Sleep(0.25f);

		GetACSWatcher().IdleAdditiveBlockTemp();

		thePlayer.RaiseEvent('ACS_ThrowDagger');

		Sleep(0.375f);

		SwordsFire();
		
		Sleep(0.25f);
		
		sword_torso_anchor_1.Destroy();
	}

	latent function SwordsFire()
	{
		actors = GetWitcherPlayer().GetNPCsAndPlayersInRange( 50, 5, , FLAG_ExcludePlayer + FLAG_Attitude_Hostile + FLAG_OnlyAliveActors);

		if (actors.Size() <= 1 || thePlayer.IsHardLockEnabled())
		{
			actor = (CActor)( GetWitcherPlayer().GetDisplayTarget() );

			if( ACS_AttitudeCheck ( actor ) && GetWitcherPlayer().IsInCombat() && actor.IsAlive() )
			{		
				targetPosition = actor.PredictWorldPosition( 0.1 );

				if ((actor.HasTag('ACS_Big_Boi')
				|| actor.HasAbility('mon_toad_base')
				|| actor.HasAbility('mon_type_huge')
				|| ((CMovingPhysicalAgentComponent)((actor.GetMovingAgentComponent()))).GetCapsuleHeight() >= 2
				|| actor.GetRadius() >= 0.7)
				&& !actor.HasTag('ice_troll')
				&& actor.GetSfxTag() != 'sfx_troll_cave'
				)
				{
					targetPosition.Z += 1.5;
				}
				else
				{
					targetPosition.Z += 1.1;
				}
			}		
			else
			{				
				targetPosition = GetWitcherPlayer().GetLookAtPosition();
			}

			PrepareSwordForFiring(static_torso_sword_1, 'acs_sword_projectile_01', targetPosition);

			Sleep(0.125f);

			actor = (CActor)( GetWitcherPlayer().GetDisplayTarget() );

			if( ACS_AttitudeCheck ( actor ) && GetWitcherPlayer().IsInCombat() && actor.IsAlive() )
			{		
				targetPosition = actor.PredictWorldPosition( 0.1 );

				if ((actor.HasTag('ACS_Big_Boi')
				|| actor.HasAbility('mon_toad_base')
				|| actor.HasAbility('mon_type_huge')
				|| ((CMovingPhysicalAgentComponent)((actor.GetMovingAgentComponent()))).GetCapsuleHeight() >= 2
				|| actor.GetRadius() >= 0.7)
				&& !actor.HasTag('ice_troll')
				&& actor.GetSfxTag() != 'sfx_troll_cave'
				)
				{
					targetPosition.Z += 1.5;
				}
				else
				{
					targetPosition.Z += 1.1;
				}
			}		
			else
			{				
				targetPosition = GetWitcherPlayer().GetLookAtPosition();
			}

			PrepareSwordForFiring(static_torso_sword_2, 'acs_sword_projectile_02', targetPosition);

			Sleep(0.125f);

			actor = (CActor)( GetWitcherPlayer().GetDisplayTarget() );

			if( ACS_AttitudeCheck ( actor ) && GetWitcherPlayer().IsInCombat() && actor.IsAlive() )
			{		
				targetPosition = actor.PredictWorldPosition( 0.1 );

				if ((actor.HasTag('ACS_Big_Boi')
				|| actor.HasAbility('mon_toad_base')
				|| actor.HasAbility('mon_type_huge')
				|| ((CMovingPhysicalAgentComponent)((actor.GetMovingAgentComponent()))).GetCapsuleHeight() >= 2
				|| actor.GetRadius() >= 0.7)
				&& !actor.HasTag('ice_troll')
				&& actor.GetSfxTag() != 'sfx_troll_cave'
				)
				{
					targetPosition.Z += 1.5;
				}
				else
				{
					targetPosition.Z += 1.1;
				}
			}		
			else
			{				
				targetPosition = GetWitcherPlayer().GetLookAtPosition();
			}

			PrepareSwordForFiring(static_torso_sword_3, 'acs_sword_projectile_03', targetPosition);

			Sleep(0.125f);

			actor = (CActor)( GetWitcherPlayer().GetDisplayTarget() );

			if( ACS_AttitudeCheck ( actor ) && GetWitcherPlayer().IsInCombat() && actor.IsAlive() )
			{		
				targetPosition = actor.PredictWorldPosition( 0.1 );

				if ((actor.HasTag('ACS_Big_Boi')
				|| actor.HasAbility('mon_toad_base')
				|| actor.HasAbility('mon_type_huge')
				|| ((CMovingPhysicalAgentComponent)((actor.GetMovingAgentComponent()))).GetCapsuleHeight() >= 2
				|| actor.GetRadius() >= 0.7)
				&& !actor.HasTag('ice_troll')
				&& actor.GetSfxTag() != 'sfx_troll_cave'
				)
				{
					targetPosition.Z += 1.5;
				}
				else
				{
					targetPosition.Z += 1.1;
				}
			}		
			else
			{				
				targetPosition = GetWitcherPlayer().GetLookAtPosition();
			}

			PrepareSwordForFiring(static_torso_sword_4, 'acs_sword_projectile_04', targetPosition);

			Sleep(0.125f);

			actor = (CActor)( GetWitcherPlayer().GetDisplayTarget() );

			if( ACS_AttitudeCheck ( actor ) && GetWitcherPlayer().IsInCombat() && actor.IsAlive() )
			{		
				targetPosition = actor.PredictWorldPosition( 0.1 );

				if ((actor.HasTag('ACS_Big_Boi')
				|| actor.HasAbility('mon_toad_base')
				|| actor.HasAbility('mon_type_huge')
				|| ((CMovingPhysicalAgentComponent)((actor.GetMovingAgentComponent()))).GetCapsuleHeight() >= 2
				|| actor.GetRadius() >= 0.7)
				&& !actor.HasTag('ice_troll')
				&& actor.GetSfxTag() != 'sfx_troll_cave'
				)
				{
					targetPosition.Z += 1.5;
				}
				else
				{
					targetPosition.Z += 1.1;
				}
			}		
			else
			{				
				targetPosition = GetWitcherPlayer().GetLookAtPosition();
			}

			PrepareSwordForFiring(static_torso_sword_5, 'acs_sword_projectile_05', targetPosition);
		}	
		else if (actors.Size() > 1
		)
		{
			targetPositions.Clear();

			for( i = 0; i < actors.Size(); i += 1 )
			{
				targetPosition = ((CActor)actors[i]).PredictWorldPosition( 0.1 );

				if ((((CActor)actors[i]).HasTag('ACS_Big_Boi')
				|| ((CActor)actors[i]).HasAbility('mon_toad_base')
				|| ((CActor)actors[i]).HasAbility('mon_type_huge')
				|| ((CMovingPhysicalAgentComponent)(((CActor)actors[i]).GetMovingAgentComponent())).GetCapsuleHeight() >= 2
				|| ((CActor)actors[i]).GetRadius() >= 0.7)
				&& !actor.HasTag('ice_troll')
				&& actor.GetSfxTag() != 'sfx_troll_cave'
				)
				{
					targetPosition.Z += 1.5;
				}
				else
				{
					targetPosition.Z += 1.1;
				}

				targetPositions.PushBack(targetPosition);
			}

			switch (actors.Size())
			{
				case 5:

					PrepareSwordForFiring(static_torso_sword_1, 'acs_sword_projectile_01', targetPositions[0]);
	
					Sleep(0.125f);

					PrepareSwordForFiring(static_torso_sword_2, 'acs_sword_projectile_02', targetPositions[1]);
					
					Sleep(0.125f);

					PrepareSwordForFiring(static_torso_sword_3, 'acs_sword_projectile_03', targetPositions[2]);

					Sleep(0.125f);

					PrepareSwordForFiring(static_torso_sword_4, 'acs_sword_projectile_04', targetPositions[3]);

					Sleep(0.125f);

					PrepareSwordForFiring(static_torso_sword_5, 'acs_sword_projectile_05', targetPositions[4]);

				break;

				case 4:

					PrepareSwordForFiring(static_torso_sword_1, 'acs_sword_projectile_01', targetPositions[0]);
	
					Sleep(0.125f);

					PrepareSwordForFiring(static_torso_sword_2, 'acs_sword_projectile_02', targetPositions[1]);
					
					Sleep(0.125f);

					PrepareSwordForFiring(static_torso_sword_3, 'acs_sword_projectile_03', targetPositions[2]);

					Sleep(0.125f);

					PrepareSwordForFiring(static_torso_sword_4, 'acs_sword_projectile_04', targetPositions[3]);

					Sleep(0.125f);

					PrepareSwordForFiring(static_torso_sword_5, 'acs_sword_projectile_05', targetPositions[0]);

				break;

				case 3:

					PrepareSwordForFiring(static_torso_sword_1, 'acs_sword_projectile_01', targetPositions[0]);
	
					Sleep(0.125f);

					PrepareSwordForFiring(static_torso_sword_2, 'acs_sword_projectile_02', targetPositions[1]);
					
					Sleep(0.125f);

					PrepareSwordForFiring(static_torso_sword_3, 'acs_sword_projectile_03', targetPositions[2]);

					Sleep(0.125f);

					PrepareSwordForFiring(static_torso_sword_4, 'acs_sword_projectile_04', targetPositions[0]);

					Sleep(0.125f);

					PrepareSwordForFiring(static_torso_sword_5, 'acs_sword_projectile_05', targetPositions[1]);

				break;

				case 2:

					PrepareSwordForFiring(static_torso_sword_1, 'acs_sword_projectile_01', targetPositions[0]);
	
					Sleep(0.125f);

					PrepareSwordForFiring(static_torso_sword_2, 'acs_sword_projectile_02', targetPositions[1]);
					
					Sleep(0.125f);

					PrepareSwordForFiring(static_torso_sword_3, 'acs_sword_projectile_03', targetPositions[0]);

					Sleep(0.125f);

					PrepareSwordForFiring(static_torso_sword_4, 'acs_sword_projectile_04', targetPositions[1]);

					Sleep(0.125f);

					PrepareSwordForFiring(static_torso_sword_5, 'acs_sword_projectile_05', targetPositions[0]);

				break;

				case 1:

					PrepareSwordForFiring(static_torso_sword_1, 'acs_sword_projectile_01', targetPositions[0]);
	
					Sleep(0.125f);

					PrepareSwordForFiring(static_torso_sword_2, 'acs_sword_projectile_02', targetPositions[0]);
					
					Sleep(0.125f);

					PrepareSwordForFiring(static_torso_sword_3, 'acs_sword_projectile_03', targetPositions[0]);

					Sleep(0.125f);

					PrepareSwordForFiring(static_torso_sword_4, 'acs_sword_projectile_04', targetPositions[0]);

					Sleep(0.125f);

					PrepareSwordForFiring(static_torso_sword_5, 'acs_sword_projectile_05', targetPositions[0]);

				break;

				default:

					PrepareSwordForFiring(static_torso_sword_1, 'acs_sword_projectile_01', targetPositions[0]);
	
					Sleep(0.125f);

					PrepareSwordForFiring(static_torso_sword_2, 'acs_sword_projectile_02', targetPositions[0]);
					
					Sleep(0.125f);

					PrepareSwordForFiring(static_torso_sword_3, 'acs_sword_projectile_03', targetPositions[0]);

					Sleep(0.125f);

					PrepareSwordForFiring(static_torso_sword_4, 'acs_sword_projectile_04', targetPositions[0]);

					Sleep(0.125f);

					PrepareSwordForFiring(static_torso_sword_5, 'acs_sword_projectile_05', targetPositions[0]);

				break;
			}
		}
	}

	function PrepareSwordForFiring(sword : W3ACSSwordProjectile, tag : name, pos : Vector)
	{
		sword.BreakAttachment();

		sword.DestroyEffect('blade_trail');
		sword.DestroyEffect('appear_flash');
		sword.DestroyEffect('eff_2');
		sword.DestroyEffect('fast_attack_buff');
		sword.DestroyEffect('fast_attack_buff_hit');
		sword.DestroyEffect('fire_sparks_trail');
		sword.DestroyEffect('glow');
		sword.DestroyEffect('glow_red');

		sword.PlayEffectSingle('blade_trail');
		sword.PlayEffectSingle('appear_flash');
		sword.PlayEffectSingle('eff_2');
		sword.PlayEffectSingle('fast_attack_buff');
		sword.PlayEffectSingle('fast_attack_buff_hit');
		sword.PlayEffectSingle('fire_sparks_trail');

		if (ACS_Armor_Set_Check('forgotten_wolf', false) 
		|| ACS_Armor_Set_Check('acs_armor', false)
		|| ACS_Armor_Set_Check('volhikar', false)
		|| thePlayer.HasTag('acs_vampire_claws_equipped')
		|| ACS_Vampire_Claws_Access()
		)
		{
			sword.PlayEffectSingle('glow_red');
		}
		else
		{
			sword.PlayEffectSingle('glow');
		}

		sword.RemoveTag(tag);

		sword.ShootProjectileAtPosition( RandRangeF(15,-15), 20+RandRange(5,1), pos, 500 );
		sword.DestroyAfter(31);
	}
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


function ACS_Bat_Damage()
{
	var actortarget																										: CActor;
	var actors    																										: array<CActor>;
	var damage																											: float;
	var i																												: int;
	var dmg 																											: W3DamageAction;
	var targetVitality, targetEssence 																					: EBaseCharacterStats;

	//actors = GetActorsInRange(GetWitcherPlayer(), 7, 100, ,true);

	actors.Clear();

	actors = GetWitcherPlayer().GetNPCsAndPlayersInRange( 7, 20, , FLAG_ExcludePlayer + FLAG_Attitude_Hostile + FLAG_OnlyAliveActors);

	//GetWitcherPlayer().DrainStamina( ESAT_FixedValue, 0.046875 );

	//GetWitcherPlayer().DrainStamina( ESAT_FixedValue, 0.0625 );

	GetWitcherPlayer().DrainStamina( ESAT_FixedValue, 0.5 );

	for( i = 0; i < actors.Size(); i += 1 )
	{
		actortarget = (CActor)actors[i];

		if (actortarget.UsesEssence())
		{
			if ( actortarget.GetStat( BCS_Essence ) <= actortarget.GetStatMax( BCS_Essence ) * 0.05 )
			{
				damage = 99999;
			}
			else
			{
				damage = actortarget.GetStat( BCS_Essence ) * 0.000625;
			}
		}
		else if (actortarget.UsesVitality())
		{
			if ( actortarget.GetStat( BCS_Vitality ) <= actortarget.GetStatMax( BCS_Vitality ) * 0.05 )
			{
				damage = 99999;
			}
			else
			{
				damage = actortarget.GetStat( BCS_Vitality ) * 0.000625;
			}
		}

		if 
		( 
		actortarget == GetWitcherPlayer() 
		|| actortarget.HasTag('smokeman') 
		|| ((CNewNPC)(actortarget)).IsHorse() 
		|| actortarget.HasTag('ACS_Rat_Mage_Rat')
		|| actortarget.HasTag('ACS_Plumard')
		|| actortarget.HasTag('ACS_Necrofiend_Tentacle_1') 
		|| actortarget.HasTag('ACS_Necrofiend_Tentacle_2') 
		|| actortarget.HasTag('ACS_Necrofiend_Tentacle_3') 
		|| actortarget.HasTag('ACS_Necrofiend_Tentacle_6')
		|| actortarget.HasTag('ACS_Necrofiend_Tentacle_5')
		|| actortarget.HasTag('ACS_Necrofiend_Tentacle_4') 
		|| actortarget.HasAbility('animal_rat_base')
		)
		continue;
			
		dmg = new W3DamageAction in theGame.damageMgr;
		dmg.Initialize(NULL, actortarget, theGame, 'ACS_Bats_Damage', EHRT_None, CPS_Undefined, false, false, true, false);
		dmg.SetProcessBuffsIfNoDamage(true);
		dmg.SetCanPlayHitParticle(false);
		dmg.SetSuppressHitSounds(true);

		dmg.AddDamage( theGame.params.DAMAGE_NAME_DIRECT, 50 + damage );
					
		//dmg.AddEffectInfo( EET_Bleeding, 10 );
			
		dmg.SetCriticalHit(); theGame.damageMgr.ProcessAction( dmg );
								
		delete dmg;	
	}
}


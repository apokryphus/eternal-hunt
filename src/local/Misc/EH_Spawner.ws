	latent function Dance_Of_Wrath_Lv2()
	{
		actorVictims.Clear();

		actorVictims = GetWitcherPlayer().GetNPCsAndPlayersInRange( 15, 2, , FLAG_ExcludePlayer + FLAG_OnlyAliveActors + FLAG_Attitude_Hostile );

		if( actorVictims.Size() > 0 )
		{
			if( actorVictims.Size() == 2 )
			{
				last_enemy = false;

				for( j = 0; j < actorVictims.Size(); j += 1 )
				{
					if ( j == actorVictims.Size() - 1 )
					{
						last_enemy = true;
					}

					if (actorVictims[j])
					{
						//GetWitcherPlayer().StopEffect('disappear_ciri');
						//GetWitcherPlayer().PlayEffectSingle('disappear_ciri');

						GetWitcherPlayer().AddTag('ACS_Dance_Of_Wrath_Lv2');

						if (actorVictims[j].IsAlive())
						{
							theGame.RemoveTimeScale( theGame.GetTimescaleSource(ETS_InstantKill) );

							thePlayer.DestroyEffect('dodge_acs_armor');
							thePlayer.PlayEffectSingle('dodge_acs_armor');

							thePlayer.StopEffect('shadowdash_shockwave');

							thePlayer.PlayEffectSingle('shadowdash_shockwave');

							thePlayer.StopEffect('shadowdash_shockwave');

							movementAdjustor = GetWitcherPlayer().GetMovingAgentComponent().GetMovementAdjustor();

							dist = (((CMovingPhysicalAgentComponent)actorVictims[j].GetMovingAgentComponent()).GetCapsuleRadius() 
							+ ((CMovingPhysicalAgentComponent)GetWitcherPlayer().GetMovingAgentComponent()).GetCapsuleRadius());

							ticket = movementAdjustor.GetRequest( 'ACS_Dance_Of_Wrath');
							movementAdjustor.CancelByName( 'ACS_Dance_Of_Wrath' );
							movementAdjustor.CancelAll();

							if (thePlayer.IsInCombat() || thePlayer.IsThreatened())
							{
								ACS_ExplorationDelayHack(false, 3);
							}

							ticket = movementAdjustor.CreateNewRequest( 'ACS_Dance_Of_Wrath' );
							movementAdjustor.AdjustmentDuration( ticket, 0.125 );
							movementAdjustor.MaxRotationAdjustmentSpeed( ticket, 500000 );

							movementAdjustor.RotateTowards(ticket, actorVictims[j]);

							movementAdjustor.SlideTowards( ticket, actorVictims[j], dist, dist );

							if (ACS_Armor_Set_Check('acs_armor', false))
							{
								if ( !theSound.SoundIsBankLoaded("monster_golem_ifryt.bnk") )
								{
									theSound.SoundLoadBank( "monster_golem_ifryt.bnk", false );
								}

								GetWitcherPlayer().SoundEvent("monster_golem_dao_cmb_swoosh_light");	  

								proj_1 = (W3ACSFireLine)theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync( "dlc\dlc_acs\data\entities\projectiles\acs_armor_fire_line_proj.w2ent", true ), GetWitcherPlayer().GetWorldPosition() );
								proj_1.Init(GetWitcherPlayer());
								proj_1.PlayEffectSingle('fire_line');
								proj_1.ShootProjectileAtPosition(0,	30, actorPos, 10 );
								proj_1.DestroyAfter(10);
							}
							else
							{
								if (thePlayer.HasTag('ACS_Flammable_Oil_Enabled')
								)
								{
									if (ACS_GetItem_SwordHeldSwitchBasedUponStat('frost_sword'))
									{
										GetACSWatcher().ACS_Ice_Blast();
									}
									else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('poison_sword'))
									{
										ACS_Poison_Cloud();
									}
									else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('bleed_sword'))
									{
										GetACSWatcher().ACS_Blood_Arc();
									}
									else
									{
										if ( !theSound.SoundIsBankLoaded("monster_golem_ifryt.bnk") )
										{
											theSound.SoundLoadBank( "monster_golem_ifryt.bnk", false );
										}
										
										GetWitcherPlayer().SoundEvent("monster_golem_dao_cmb_swoosh_light");	  
										
										proj_1 = (W3ACSFireLine)theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync( "dlc\dlc_acs\data\entities\projectiles\elemental_ifryt_proj.w2ent", true ),  GetWitcherPlayer().GetWorldPosition() );
										proj_1.Init(GetWitcherPlayer());
										proj_1.PlayEffectSingle('fire_line');
										proj_1.ShootProjectileAtPosition(0,	30, actorVictims[j].GetWorldPosition(), 10 );
										proj_1.DestroyAfter(10);
									}
								}
							}

							

							movementAdjustor.RotateTowards(ticket, actorVictims[j]);

							if ( FactsQuerySum("ACS_DanceOfWrathAnimationAlternate") <= 0 )
							{
								if (thePlayer.HasTag('ACS_Dual_Wield_Active'))
								{
									GetACSWatcher().PlayerPlayAnimation( 'man_geralt_sword_attack_strong_far_forward_1_lp_80ms_dw_ACS' );
								}
								else
								{
									GetACSWatcher().PlayerPlayAnimation( 'man_geralt_sword_attack_strong_far_forward_1_lp_80ms' );
								}

								FactsAdd("ACS_DanceOfWrathAnimationAlternate", 1, -1);
							}
							else if ( FactsQuerySum("ACS_DanceOfWrathAnimationAlternate") > 0 )
							{

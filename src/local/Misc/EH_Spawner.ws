					case 2: //front right
					pPos.X = -0.15;
					pPos.Y = -0.07;
					pPos.Z = 0.17;
					pRot.Roll = 130;
					pRot.Pitch = 290;
					pRot.Yaw = -40; 
					break;
					
					case 3: //front left
					pPos.X = -0.18;
					pPos.Y = -0.07;
					pPos.Z = -0.09;
					pRot.Roll = 155;
					pRot.Pitch = 265;
					pRot.Yaw = -20; 
					break;
					
					case 4: //Akatoshka7
					pPos.X = -0.15;
					pPos.Y = -0.18;
					pPos.Z = 0.17;
					pRot.Roll = 125;
					pRot.Pitch = 325;
					pRot.Yaw = -55; 
					break;
					
					default: //back right higher antr
					pPos.X = 0.13;
					pPos.Y = 0.01;
					pPos.Z = 0.11;
					pRot.Roll = 125;
					pRot.Pitch = 280;
					pRot.Yaw = -80; 
					break;
				}

				fake.CreateAttachment(dummy, , pPos, pRot );

				FactsAdd("ACS_Slot_01_Virus_Bomb_Equipped");
			}
		
			break;

			default:
		
			if (FactsQuerySum("ACS_Slot_01_Dancing_Star_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_01_Dancing_Star_Prop');

				FactsRemove("ACS_Slot_01_Dancing_Star_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_01_Devils_Puffball_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_01_Devils_Puffball_Prop');

				FactsRemove("ACS_Slot_01_Devils_Puffball_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_01_Dwimeritium_Bomb_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_01_Dwimeritium_Prop');

				FactsRemove("ACS_Slot_01_Dwimeritium_Bomb_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_01_Dragons_Dream_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_01_Dragons_Dream_Prop');

				FactsRemove("ACS_Slot_01_Dragons_Dream_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_01_Grapeshot_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_01_Grapeshot_Prop');

				FactsRemove("ACS_Slot_01_Grapeshot_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_01_Silver_Dust_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_01_Silver_Dust_Prop');

				FactsRemove("ACS_Slot_01_Silver_Dust_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_01_White_Frost_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_01_White_Frost_Prop');

				FactsRemove("ACS_Slot_01_White_Frost_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_01_Samum_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_01_Samum_Prop');

				FactsRemove("ACS_Slot_01_Samum_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_01_Salt_Bomb_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_01_Salt_Bomb_Prop');

				FactsRemove("ACS_Slot_01_Salt_Bomb_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_01_Glue_Bomb_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_01_Glue_Bomb_Prop');

				FactsRemove("ACS_Slot_01_Glue_Bomb_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_01_Fungi_Bomb_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_01_Fungi_Bomb_Prop');

				FactsRemove("ACS_Slot_01_Fungi_Bomb_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_01_Shrapnel_Bomb_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_01_Shrapnel_Bomb_Prop');

				FactsRemove("ACS_Slot_01_Shrapnel_Bomb_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_01_Virus_Bomb_Equipped") <= 0)
			{
				if (!ACSGetCEntity('ACS_Slot_01_Bomb_Prop_Anchor'))
				{
					dummy = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync("dlc\dlc_acs\data\entities\other\fx_ent.w2ent", true), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );
					dummy.AddTag('ACS_Slot_01_Bomb_Prop_Anchor');
				}
				else 
				{
					dummy = ACSGetCEntity('ACS_Slot_01_Bomb_Prop_Anchor');
				}
				
				fake = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync("dlc\dlcardbombs\data\items\weapons\projectiles\petards\bomb_virus.w2ent", true), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );
				fake.AddTag('ACS_Slot_01_Virus_Bomb_Prop');
				
				bIndex = GetWitcherPlayer().GetBoneIndex( 'pelvis' );	
				GetWitcherPlayer().GetBoneWorldPositionAndRotationByIndex( bIndex, bPos, bRot );
				
				dummy.CreateAttachmentAtBoneWS(GetWitcherPlayer(), 'pelvis', bPos, bRot );

				option = ACS_Settings_Main_Int('acs_player_equipment_visual_settings','acs_wearable_bombs_positioning', 0);

				switch ( option )
				{
					case 0: //back lower
					pPos.X = 0.13;
					pPos.Y = 0.01;
					pPos.Z = 0.11;
					pRot.Roll = 125;
					pRot.Pitch = 280;
					pRot.Yaw = -80; 
					break;

					case 1: //back higher
					pPos.X = 0.13;
					pPos.Y = -0.09;
					pPos.Z = 0.11;
					pRot.Roll = 115;
					pRot.Pitch = 280;
					pRot.Yaw = -80; 
					break;
					
					case 2: //front right
					pPos.X = -0.15;
					pPos.Y = -0.07;
					pPos.Z = 0.17;
					pRot.Roll = 130;
					pRot.Pitch = 290;
					pRot.Yaw = -40; 
					break;
					
					case 3: //front left
					pPos.X = -0.18;
					pPos.Y = -0.07;
					pPos.Z = -0.09;
					pRot.Roll = 155;
					pRot.Pitch = 265;
					pRot.Yaw = -20; 
					break;
					
					case 4: //Akatoshka7
					pPos.X = -0.15;
					pPos.Y = -0.18;
					pPos.Z = 0.17;
					pRot.Roll = 125;
					pRot.Pitch = 325;
					pRot.Yaw = -55; 
					break;
					
					default: //back right higher antr
					pPos.X = 0.13;
					pPos.Y = 0.01;
					pPos.Z = 0.11;
					pRot.Roll = 125;
					pRot.Pitch = 280;
					pRot.Yaw = -80; 
					break;
				}

				fake.CreateAttachment(dummy, , pPos, pRot );

				FactsAdd("ACS_Slot_01_Virus_Bomb_Equipped");
			}
		
			break;
		}

		SleepOneFrame();
	}

	


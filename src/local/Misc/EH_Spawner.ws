					pPos.X = -0.15;
					pPos.Y = -0.18;
					pPos.Z = 0.17;
					pRot.Roll = 125;
					pRot.Pitch = 325;
					pRot.Yaw = -55; 
					break;
					
					default: //back right higher antr
					pPos.X = 0.13;
					pPos.Y = 0.01;
					pPos.Z = 0.11;
					pRot.Roll = 125;
					pRot.Pitch = 280;
					pRot.Yaw = -80; 
					break;
				}

				fake.CreateAttachment(dummy, , pPos, pRot );

				FactsAdd("ACS_Slot_01_Dancing_Star_Equipped");
			}
		
			break;
		}

		SleepOneFrame();
	}

	


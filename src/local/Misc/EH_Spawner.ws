												vfxEnt.PlayEffectSingle('critical_yrden');
												vfxEnt.DestroyAfter(1.5);
												npc.AddEffectDefault( EET_Slowdown, GetWitcherPlayer(), 'acs_weapon_passive_effects' ); 							
											}

				option = ACS_Settings_Main_Int('acs_player_equipment_visual_settings','acs_wearable_bombs_positioning', 0);

				switch ( option )
				{
					case 0: //back lower
					pPos.X = 0.13;
					pPos.Y = 0.01;
					pPos.Z = 0.11;
					pRot.Roll = 125;
					pRot.Pitch = 280;
					pRot.Yaw = -80; 
					break;

					case 1: //back higher
					pPos.X = 0.13;
					pPos.Y = -0.09;
					pPos.Z = 0.11;
					pRot.Roll = 115;
					pRot.Pitch = 280;
					pRot.Yaw = -80; 

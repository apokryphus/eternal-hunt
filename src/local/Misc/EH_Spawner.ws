	default showMountPrompt = false;


	var trollCrew_01, trollCrew_02, trollCrew_03, trollCrew_04, trollCrew_05, trollCrew_06, trollCrew_07, trollCrew_08, trollCrew_09, trollCrew_10, trollCrew_11													: CEntity;

	var acs_boat_lamp_01, acs_boat_lamp_02, acs_boat_lamp_03, acs_boat_lamp_04, acs_boat_lamp_05, acs_boat_lamp_06, acs_boat_lamp_07, acs_boat_lamp_08, acs_boat_lamp_09, acs_boat_lamp_10, acs_boat_lamp_11		: CEntity;


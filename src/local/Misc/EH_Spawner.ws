state ACS_Finisher_Dagger_Summon_Engage in cACS_Dagger_Summon
{
	private var attach_vec				: Vector;
	private var dagger_1 				: CEntity;
	private var attach_rot				: EulerAngles;
	private var meshcomp 				: CComponent;
	private var h 						: float;

	event OnEnterState(prevStateName : name)
	{
		super.OnEnterState(prevStateName);
		
		Finisher_Dagger_Summon_Entry();
	}

	entry function Finisher_Dagger_Summon_Entry()
	{
		if ( !theSound.SoundIsBankLoaded("mq_nml_1035.bnk") )
		{
			theSound.SoundLoadBank( "mq_nml_1035.bnk", false );
		}

		GetWitcherPlayer().SoundEvent("scene_weapon_sword_unsheat_fast");
		
		dagger_1 = (CEntity)theGame.CreateEntity((CEntityTemplate)LoadResourceAsync( 
						
		//"dlc\dlc_acs\data\entities\swords\vesemir_dagger.w2ent" 

		//"items\quest_items\q105\q105_item__dagger.w2ent"

		//"quests\sidequests\novigrad\quest_files\sq310_dangerous_game\entities\sq310_dagger.w2ent"

		//"quests\generic_quests\novigrad\quest_files\mh308_noonwraith\entities\mh308_dagger.w2ent"

		//"quests\sidequests\novigrad\quest_files\sq310_dangerous_game\entities\sq310_knife_fm.w2ent"

		//"dlc\bob\data\items\quest_items\q703\q703_unique_hunting_knife.w2ent"

		//"items\weapons\unique\baron_dagger.w2ent"

		"dlc\dlc_acs\data\entities\swords\baron_dagger.w2ent"

		, true), GetWitcherPlayer().GetWorldPosition() );

		if ( 
		GetACSWatcher().ACS_IS_SNEAKING 
		&& thePlayer.HasTag('ACS_Is_Sneaking')
		)
		{
			attach_rot.Roll = 0;
			attach_rot.Pitch = 180;
			attach_rot.Yaw = 0;
			attach_vec.X = 0;
			attach_vec.Y = 0;
			attach_vec.Z = -0.03125f;
		}
		else
		{
			attach_rot.Roll = 0;
			attach_rot.Pitch = 0;
			attach_rot.Yaw = 0;
			attach_vec.X = 0;
			attach_vec.Y = 0;
			attach_vec.Z = 0;
		}
			
		dagger_1.CreateAttachment( GetWitcherPlayer(), 'r_weapon', attach_vec, attach_rot );
		dagger_1.AddTag('acs_finisher_dagger');
	}
}


state ACS_Prepare_Knife_Engage in cACS_Throw_Knife
{
	private var proj_1								: W3ACSKnifeProjectile;
	private var initpos, newpos, targetPosition		: Vector;
	private var blade_temp							: CEntityTemplate;
	private var actor								: CActor;

	event OnEnterState(prevStateName : name)
	{
		Prepare_Knife_Entry();
	}

	entry function Prepare_Knife_Entry()
	{
		blade_temp = (CEntityTemplate)LoadResourceAsync( "dlc\dlc_acs\data\entities\projectiles\acs_knife_projectile.w2ent", true );

		proj_1 = (W3ACSKnifeProjectile)theGame.CreateEntity( blade_temp, initpos );

		proj_1.CreateAttachment(thePlayer,'l_weapon',Vector(0,0,0),EulerAngles(0,0,0));

		proj_1.AddTag('ACS_Knife_Projectile');
	}
}

state ACS_Throw_Knife_Engage in cACS_Throw_Knife
{
	private var proj_1								: W3ACSKnifeProjectile;
	private var initpos, newpos, targetPosition		: Vector;
	private var blade_temp							: CEntityTemplate;
	private var actor								: CActor;
	private var i, phantom_knife_count				: int;

	event OnEnterState(prevStateName : name)
	{
		Throw_Knife_Entry();
	}

	entry function Throw_Knife_Entry()
	{
		GetACSKnifeProjectile().Init(thePlayer);

		initpos = GetACSKnifeProjectile().GetWorldPosition();

		actor = ((CActor)( thePlayer.GetTarget() ));

		if( ACS_AttitudeCheck ( actor ) && GetWitcherPlayer().IsInCombat() && actor.IsAlive() )
		{
			if ( actor.GetBoneIndex('head') != -1 )
			{
				targetPosition = actor.GetBoneWorldPosition('head');
				targetPosition.Z += RandRangeF(0,-0.5);
				targetPosition.X += RandRangeF(0.125,-0.125);
			}
			else
			{
				targetPosition = actor.GetWorldPosition();
				targetPosition.Z += 1.5;
				targetPosition.X += RandRangeF(0.125,-0.125);
			}
		}
		else
		{
			targetPosition = GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetWorldForward() * 30;

			targetPosition.Z += 1.25;
		}

		GetACSKnifeProjectile().BreakAttachment();

		GetACSKnifeProjectile().ShootProjectileAtPosition( 5, 40, targetPosition, 500 );

		GetACSKnifeProjectile().RemoveTag('ACS_Knife_Projectile');

		if (GetWitcherPlayer().CanUseSkill(S_Alchemy_s11) )
		{
			phantom_knife_count = thePlayer.GetSkillLevel(S_Alchemy_s11) + 1;

			if (phantom_knife_count > 4)
			{
				phantom_knife_count = 4;
			}

			blade_temp = (CEntityTemplate)LoadResourceAsync( "dlc\dlc_acs\data\entities\projectiles\acs_knife_projectile.w2ent", true );

			for( i = 0; i < phantom_knife_count; i += 1 )
			{
				proj_1 = (W3ACSKnifeProjectile)theGame.CreateEntity( blade_temp, initpos );

				proj_1.ShootProjectileAtPosition( 5, RandRangeF(40,20), targetPosition + Vector(RandRangeF(1, -1), RandRangeF(1, -1), RandRangeF(1, -1)), 500 );

				proj_1.AddTag('ACS_Phantom_Knife');
				
				SleepOneFrame();
			}
		}

	}
}

function GetACSKnifeProjectile() : W3ACSKnifeProjectile
{
	var ent 				 : W3ACSKnifeProjectile;
	
	ent = (W3ACSKnifeProjectile)theGame.GetEntityByTag( 'ACS_Knife_Projectile' );
	return ent;
}




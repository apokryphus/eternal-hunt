		, true ), ACSFixZAxis(pos2), rot );

		ent_2.AddTag('ACS_Training_Dummy');
	}
	

}

class CACSPocketDummy extends CNewNPC
{
	var ent, ent_mesh            : CEntity;

	event OnSpawned( spawnData : SEntitySpawnData )
	{
		super.OnSpawned( spawnData );

		ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

		"dlc\bob\data\fx\quest\q704\q704_13_fountain\q704_fairlytale_portal.w2ent"

		, true ), GetWorldPosition() + Vector( 0, 0, 1 ) );

		ent.PlayEffectSingle('portal');
		ent.StopEffect('portal');

		ent_mesh = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

		"dlc\bob\data\items\quest_items\sq701\sq701_item__dummy_bodymesh01.w2ent"

		, true ), GetWorldPosition() + Vector( 0, 0, 0 ) ); 

		GetWitcherPlayer().SoundEvent('magic_geralt_teleport');

		SetInteractionPriority( IP_Max_Unpushable );

		((CAnimatedComponent)this.GetComponentByClassName('CAnimatedComponent')).FreezePose();
	}

	event OnTakeDamage( action : W3DamageAction )
	{	
		super.OnTakeDamage(action);
	}

	event OnDeath( damageAction : W3DamageAction  )
	{
		super.OnDeath(damageAction);

		this.Destroy();
	}

	event OnDestroyed()
	{
		ent.PlayEffectSingle('portal');
		ent.StopEffect('portal');

		ent.DestroyAfter(5);

		ent_mesh.Destroy();

		GetWitcherPlayer().SoundEvent('magic_geralt_teleport');

		super.OnDestroyed();
	}
}

class W3ACSInteractionSwitch extends W3PhysicalSwitch
{
	protected var isActivatedByPlayer		: bool;			
	editable var focusModeHighlight			: EFocusModeVisibility;
	
	default isActivatedByPlayer				= false;
	default focusModeHighlight 				= FMV_None;
	
	editable var interactionActiveInState 	: ESwitchState;
	default interactionActiveInState		= SS_Undefined;	
	hint interactionActiveInState = "State for which interaction is possible. If set to SS_Undefined, there's no restriction.";

	// bookmark
	var spawned_ent : CEntity;
	var spawned_horse : CEntity;
	var ent_spawned : array<CEntity>;
	
	event OnSpawned( spawnData : SEntitySpawnData )
	{
		super.OnSpawned( spawnData );
		
		UpdateInteractionComponent( GetComponent( "Unlocked" ) );
		UpdateFocusModeHighlight();
		
		AddAnimEventCallback('SwitchOnEvent',	'OnAnimEvent_SwitchOnEvent');
		AddAnimEventCallback('SwitchOffEvent',	'OnAnimEvent_SwitchOffEvent');

		AddTimer('oneliner_add_delay', 0.1 , false );
	}

	timer function oneliner_add_delay ( dt : float, id : int)
	{
		var tags : array<name>;
		var nam, quantity : name;

		tags = this.GetTags();

		if(tags.Size() == 0)
		{
			tags.PushBack('sword1h_easy');
			tags.PushBack('1');
		}
		else if(tags.Size() == 1)
		{
			tags.PushBack('1');
		}

		nam = tags[0];

		quantity = tags[1];

		ACS_Oneliner(
		(new ACS_Oneliner_TagBuilder in theGame)
		.tag("font")
		.attr("size", "26")
		.attr("color", "#ffffff")
		.text(NameToString(nam) + ", " + NameToString(quantity))
		, this, "ACS_Lever_Spawner_Name", Vector(0,0,2.5),,30 );

		GetACSStorage().acs_setScaleForOnelinerByTag("ACS_Lever_Spawner_Name", 100, 100, 100);

		GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Lever_Spawner_Name", 100);
	}

	public function Enable( enable : bool )
	{
		super.Enable( enable );
		
		UpdateInteractionComponent( GetComponent( "Unlocked" ) );
		UpdateFocusModeHighlight();		
	}
	
	public function Lock( lock : bool )
	{
		var hud : CR4ScriptedHud;
		
		super.Lock( lock );
		
		if ( isActivatedByPlayer )
		{
			
			hud = (CR4ScriptedHud)theGame.GetHud();
			if ( hud )
			{
				hud.ForceInteractionUpdate();
			}
		}
	}
	
	public function InteractWith( on : bool, switchType : PhysicalSwitchAnimationType )
	{
		var inteactionState				: W3PlayerWitcherStateApproachInteractionState;
		var vecToObject 				: Vector;
		var heading						: float;
		
		
		
		vecToObject = this.GetWorldPosition() - thePlayer.GetWorldPosition();
		heading = VecHeading( vecToObject );
		inteactionState = ( W3PlayerWitcherStateApproachInteractionState )thePlayer.GetState( 'ApproachInteractionState' );
		inteactionState.SetObjectPointHeading( heading, this );
		inteactionState.SetSyncInteractionAnimation( on, switchType );
		
			
		if (thePlayer.IsHoldingItemInLHand())
		{
			thePlayer.HideUsableItem(true);
			restoreUsableItemL = true;
		}
		
		thePlayer.GotoState( 'ApproachInteractionState' );
	}
	
	function UpdateInteractionComponent( optional component : CComponent )
	{
		if ( !component )
		{
			component = GetComponent( 'CInteractionComponent' );
		}
		if ( component )
		{
			component.SetEnabled( enabled );
		}
	}
	
	event OnInteractionAttached( interaction : CInteractionComponent )
	{
		UpdateInteractionComponent( interaction );
	}
	
	function UpdateFocusModeHighlight()
	{
		if ( enabled )
		{
			SetFocusModeVisibility( focusModeHighlight );
		}
		else
		{
			SetFocusModeVisibility( FMV_None );
		}	
	}

	event OnInteractionActivated( interactionComponentName : string, activator : CEntity )
	{
		if ( activator == thePlayer )
		{
			isActivatedByPlayer = true;
		}
	}
	
	event OnInteractionDeactivated( interactionComponentName : string, activator : CEntity )
	{
		if ( activator == thePlayer )
		{
			isActivatedByPlayer = false;
		}
	}
	
	event OnInteraction( interactionComponentName : string, activator : CEntity )
	{
		var switchEntity : CEntity;
		var toSwitchEntity : Vector;
		
		if ( IsLocked() )
		{
			GetWitcherPlayer().DisplayHudMessage("panel_hud_message_just_locked");
		}
		else 
		{
			RemoveTimer('ent_freeze');
			RemoveTimer('ent_unfreeze');
			RemoveTimer('ent_spawn_delay');

			if ( IsOn() )
			{
				if ( switchOffAnimationType == PSAT_Undefined )
				{
					Toggle( (CActor)activator, false, false );
				}
				else
				{
					InteractWith( true, switchOffAnimationType );
					
					
					EntityHandleSet( lastActivatorHandle, thePlayer );
				}

				AddTimer('ent_freeze', 2 , false );
			}
			else if ( IsOff() )
			{
				if ( switchOffAnimationType == PSAT_Undefined )
				{
					Toggle( (CActor)activator, false, false );
				}
				else
				{
					InteractWith( false, switchOffAnimationType );
					
					
					EntityHandleSet( lastActivatorHandle, thePlayer );
				}

				AddTimer('ent_unfreeze', 2 , false );

				if(!ent_alive_check())
				{
					AddTimer('ent_spawn_delay', 2 , false );
				}
			}
		}
		
		
			
	}

	timer function ent_freeze ( dt : float, id : int)
	{
		var actor															: CActor;
		var animatedComponent												: CAnimatedComponent;
		var j																: int;

		if (ent_spawned.Size() > 0)
		{
			for( j = 0; j < ent_spawned.Size(); j += 1 )
			{
				actor = ((CActor)(ent_spawned[j]));

				animatedComponent = (CAnimatedComponent)actor.GetComponentByClassName( 'CAnimatedComponent' );

				if ( animatedComponent 
				)
				{
					animatedComponent.FreezePose();
				}	
			}
		}
	}

	timer function ent_unfreeze ( dt : float, id : int)
	{
		var actor															: CActor;
		var animatedComponent												: CAnimatedComponent;
		var j																: int;

		if (ent_spawned.Size() > 0)
		{
			for( j = 0; j < ent_spawned.Size(); j += 1 )
			{
				actor = ((CActor)(ent_spawned[j]));

				animatedComponent = (CAnimatedComponent)actor.GetComponentByClassName( 'CAnimatedComponent' );

				if ( animatedComponent 
				)
				{
					animatedComponent.UnfreezePose();
				}	
			}
		}
	}

	function ent_alive_check() : bool
	{
		var actor															: CActor;
		var animatedComponent												: CAnimatedComponent;
		var j																: int;

		if (ent_spawned.Size() > 0)
		{
			for( j = 0; j < ent_spawned.Size(); j += 1 )
			{
				actor = ((CActor)(ent_spawned[j]));

				if(actor.IsAlive())
				{
					return true;
				}
				else
				{
					actor.Destroy();
				}	
			}
		}

		return false;
	}


	timer function ent_spawn_delay ( dt : float, id : int)
	{
		var pos, cameraDir, player, posFin, normal, posTemp : Vector;
		var rot : EulerAngles;
		var i, sign : int;
		var s,r,x,y : float;
		var template : CEntityTemplate;
		var horseTemplate : CEntityTemplate;
		var horseTag : array<name>;
		var resourcePath	: string;
		var l_aiTree		: CAIHorseDoNothingAction;
		var templateCSV : C2dArray;
		var tags : array<name>;
		var quantity : int;
		var nam : name;

		tags = this.GetTags();

		if(tags.Size() == 0)
		{
			tags.PushBack('sword1h_easy');
			tags.PushBack('1');
		}
		else if(tags.Size() == 1)
		{
			tags.PushBack('1');
		}

		nam = tags[0];

		quantity = NameToInt(tags[1]);

		quantity = Max(quantity, 1);
		
		rot = thePlayer.GetWorldRotation();	

		if(nam != 'boat')
		{
			rot.Yaw += 180;		
		}
		
		
		cameraDir = theCamera.GetCameraDirection();
		
		cameraDir.X *= 10;	
		cameraDir.Y *= 10;
		
		
		player = thePlayer.GetWorldPosition();
		
		
		pos = cameraDir + player;	
		pos.Z = player.Z;
		
		
		posFin.Z = pos.Z;			
		s = quantity / 0.2;			
		r = SqrtF(s/Pi());
		
		
		template = (CEntityTemplate)LoadResource(nam);
		
		if ( nam == 'rider' ) 
			horseTemplate = (CEntityTemplate)LoadResource('horse');
			
		if(!template)
		{
			resourcePath = "characters\npc_entities\monsters";
			resourcePath = resourcePath + NameToString(nam);
			resourcePath = resourcePath + ".w2ent";
			template = (CEntityTemplate)LoadResource( resourcePath, true );
		}
		
		if( nam == 'def' )
		{
			templateCSV = LoadCSV("gameplay\globals\temp_spawner.csv");
			
			resourcePath = templateCSV.GetValueAt(0,0);
			template = (CEntityTemplate)LoadResource( resourcePath, true );
		}

		for(i=0; i<quantity; i+=1)
		{		
			x = RandF() * r;			
			y = RandF() * (r - x);		
			
			if(RandRange(2))					
				sign = 1;
			else
				sign = -1;
				
			posFin.X = pos.X + sign * x;	
			
			if(RandRange(2))					
				sign = 1;
			else
				sign = -1;
				
			posFin.Y = pos.Y + sign * y;	
			
			if(nam == 'boat')
			{
				posFin.Z = 0.0f;
			}
			else
			{
				if(theGame.GetWorld().StaticTrace( posFin + Vector(0,0,5), posFin - Vector(0,0,5), posTemp, normal ))
				{
					posFin = posTemp;
				}
			}
			
			if( nam == 'boat' )
			{
				spawned_ent = theGame.CreateEntity(template, posFin, rot, true, false, false, PM_Persist );
			}
			else
			{
				spawned_ent = theGame.CreateEntity(template, posFin, rot);
			}
			
			if ( horseTemplate )
			{
				horseTag.PushBack('enemy_horse');
				spawned_horse = theGame.CreateEntity(horseTemplate, posFin, rot,true,false,false,PM_DontPersist,horseTag);
				
				
				
				
				l_aiTree = new CAIHorseDoNothingAction in spawned_ent;
				l_aiTree.OnCreated();
				((CActor)spawned_ent).ForceAIBehavior( l_aiTree, BTAP_AboveEmergency2, 'AI_Rider_Load_Forced' );
				
				((CActor)spawned_ent).SignalGameplayEventParamInt( 'RidingManagerMountHorse', MT_instant | MT_fromScript );
			}
				
			((CActor)spawned_ent).SetTemporaryAttitudeGroup( 'hostile_to_player', AGP_Default );

			ent_spawned.PushBack(spawned_ent);
		}
	}
	
	event OnInteractionActivationTest( interactionComponentName : string, activator : CEntity )
	{
		if ( interactionActiveInState != SS_Undefined && interactionActiveInState != currentState )
		{
			return false;
		}
		
		if( activator == thePlayer )
		{
			if( IsEnabled() )
			{
				return true;
			}
			else
			{
				return false;
			}
		}
		return false;
	}
	
	event OnAnimEvent_SwitchOnEvent( animEventName : name, animEventType : EAnimationEventType, animInfo : SAnimationEventAnimInfo )
	{
		SetBehaviorVariable( 'SwitchState', BEH_ON_FROM_OFF );
	}
	event OnAnimEvent_SwitchOffEvent( animEventName : name, animEventType : EAnimationEventType, animInfo : SAnimationEventAnimInfo )
	{
		SetBehaviorVariable( 'SwitchState', BEH_OFF_FROM_ON );
	}
};

//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

statemachine class cACS_Finisher_Chain
{
    function Unarmed_Finisher_Engage()
	{
		this.PushState('Unarmed_Finisher_Engage');
	}

	 function Armed_Finisher_Engage()
	{
		this.PushState('Armed_Finisher_Engage');
	}
}

state Unarmed_Finisher_Engage in cACS_Finisher_Chain
{
	private var actorVictims															: array<CActor>;
	private var j, k 																	: int;
	private var movementAdjustor, movementAdjustorTarget								: CMovementAdjustor;
	private var ticket, ticketTarget													: SMovementAdjustmentRequestTicket;
	private var dist																	: float;
	private var chosen_finisher_anim_name												: name;
	private var finisher_anim_names														: array< name >;
	private var last_enemy																: bool;
	private var enemyAnimatedComponent 													: CAnimatedComponent;

	event OnEnterState(prevStateName : name)
	{
		super.OnEnterState(prevStateName);

		Unarmed_Finisher();
	}
	
	entry function Unarmed_Finisher()
	{
		actorVictims.Clear();
		
		actorVictims = GetWitcherPlayer().GetNPCsAndPlayersInRange( 10, 20, , FLAG_ExcludePlayer + FLAG_OnlyAliveActors + FLAG_Attitude_Hostile );

		if( actorVictims.Size() > 0 )
		{
			thePlayer.AddTag('ACS_IsPerformingFinisher');

			((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent()).SetAnimatedMovement( true );

			GetACSWatcher().RemoveTimer('ACS_ResetAnimation');

			last_enemy = false;

			GetWitcherPlayer().EnableCharacterCollisions(false);
			GetWitcherPlayer().SetImmortalityMode( AIM_Invulnerable, AIC_Default, true ); 
			GetWitcherPlayer().SetCanPlayHitAnim(false);
			GetWitcherPlayer().AddBuffImmunity_AllNegative('acs_unarmed_finisher', true);

			GetWitcherPlayer().ACS_ClearAnimationSpeedMultipliers();

			GetACSWatcher().RemoveTimer('ACS_ResetAnimation');

			thePlayer.BlockAllActions( 'ACS_Unarmed_Finisher_Action_Block', true );

			Sleep(0.5);

			thePlayer.RaiseEvent('ACS_DrawSwordEnd');

			for( j = 0; j < actorVictims.Size(); j += 1 )
			{
				if ( j == actorVictims.Size() - 1 )
				{
					last_enemy = true;
				}

				if (actorVictims[j] 
				&& actorVictims[j].IsAlive()
				&& GetACSWatcher().PerformUnarmedFinisherCheck(((CNewNPC)(actorVictims[j])))
				&& VecDistanceSquared2D( thePlayer.GetWorldPosition(), actorVictims[j].GetWorldPosition() ) <= 2 * 2
				)
				{
					if ( actorVictims[j].GetInteractionPriority() != IP_Max_Unpushable )
					{
						actorVictims[j].SetInteractionPriority( IP_Max_Unpushable );
					}
					
					enemyAnimatedComponent = (CAnimatedComponent)actorVictims[j].GetComponentByClassName( 'CAnimatedComponent' );	

					((CNewNPC)(actorVictims[j])).EnableCharacterCollisions(false);

					((CNewNPC)(actorVictims[j])).SetCanPlayHitAnim(true);

					((CNewNPC)(actorVictims[j])).SetUnstoppable(false);

					((CNewNPC)(actorVictims[j])).GetRootAnimatedComponent().PlaySlotAnimationAsync( '', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0, 0) );
					
					movementAdjustor = GetWitcherPlayer().GetMovingAgentComponent().GetMovementAdjustor();

					dist = (((CMovingPhysicalAgentComponent)actorVictims[j].GetMovingAgentComponent()).GetCapsuleRadius() 
					+ ((CMovingPhysicalAgentComponent)GetWitcherPlayer().GetMovingAgentComponent()).GetCapsuleRadius()) * 0.55;

					ticket = movementAdjustor.GetRequest( 'ACS_Unarmed_Finisher');
					movementAdjustor.CancelByName( 'ACS_Unarmed_Finisher' );
					movementAdjustor.CancelAll();

					ticket = movementAdjustor.CreateNewRequest( 'ACS_Unarmed_Finisher' );
					movementAdjustor.AdjustmentDuration( ticket, 0.01 );
					movementAdjustor.MaxRotationAdjustmentSpeed( ticket, 250 );
					movementAdjustor.MaxLocationAdjustmentSpeed( ticket, 25 );
					movementAdjustor.AdjustLocationVertically( ticket, true );
					movementAdjustor.ScaleAnimationLocationVertically( ticket, true );
					movementAdjustor.Continuous(ticket);
					movementAdjustor.RotateTowards(ticket, actorVictims[j], 2.5);

					//movementAdjustor.SlideTowards( ticket, actorVictims[j], dist, dist );


					movementAdjustorTarget = actorVictims[j].GetMovingAgentComponent().GetMovementAdjustor();

					ticketTarget = movementAdjustorTarget.GetRequest( 'ACS_Unarmed_Finisher');
					movementAdjustorTarget.CancelByName( 'ACS_Unarmed_Finisher' );
					movementAdjustorTarget.CancelAll();

					ticketTarget = movementAdjustorTarget.CreateNewRequest( 'ACS_Unarmed_Finisher' );
					movementAdjustorTarget.AdjustmentDuration( ticketTarget, 0.125 );
					movementAdjustorTarget.MaxRotationAdjustmentSpeed( ticketTarget, 50000 );
					movementAdjustorTarget.MaxLocationAdjustmentSpeed( ticketTarget, 10 );
					movementAdjustorTarget.AdjustLocationVertically( ticketTarget, true );
					movementAdjustorTarget.ScaleAnimationLocationVertically( ticketTarget, true );
					movementAdjustorTarget.Continuous(ticketTarget);

					movementAdjustorTarget.RotateTowards(ticketTarget, thePlayer);

					movementAdjustorTarget.SlideTowards( ticketTarget, thePlayer, dist, dist );

					if (VecDistanceSquared2D( thePlayer.GetWorldPosition(), actorVictims[j].GetWorldPosition() ) > 1.75 * 1.75)
					{
						actorVictims[j].AddEffectDefault( EET_LongStagger, thePlayer, "ACS_Unarmed_Finisher" );
					}

					Sleep(0.125);

					finisher_anim_names.Clear();

					if (theInput.GetActionValue('GI_AxisLeftX') == 0 && theInput.GetActionValue('GI_AxisLeftY') == 0 )
					{
						finisher_anim_names.PushBack('man_finisher_05_rp');
						//finisher_anim_names.PushBack('man_finisher_06_lp');
						finisher_anim_names.PushBack('man_finisher_dlc_legs_rp');
						finisher_anim_names.PushBack('man_finisher_dlc_legs_lp');
						finisher_anim_names.PushBack('man_finisher_dlc_arm_rp');
						finisher_anim_names.PushBack('man_finisher_dlc_arm_lp');
						finisher_anim_names.PushBack('man_finisher_dlc_neck_rp');
					}

					else if (theInput.GetActionValue('GI_AxisLeftY') > 0.1 && theInput.GetActionValue('GI_AxisLeftX') == 0)
					{
						finisher_anim_names.PushBack('man_finisher_05_rp');
						//finisher_anim_names.PushBack('man_finisher_06_lp');
					}

					else if (theInput.GetActionValue('GI_AxisLeftY') < -0.1 && theInput.GetActionValue('GI_AxisLeftX') == 0  )
					{
						finisher_anim_names.PushBack('man_finisher_dlc_neck_rp');
					}

					else if (theInput.GetActionValue('GI_AxisLeftX') > 0.1 && theInput.GetActionValue('GI_AxisLeftY') == 0 )
					{
						finisher_anim_names.PushBack('man_finisher_dlc_arm_rp');
						finisher_anim_names.PushBack('man_finisher_dlc_legs_rp');
					}

					else if (theInput.GetActionValue('GI_AxisLeftX') < -0.1 && theInput.GetActionValue('GI_AxisLeftY') == 0) 
					{
						finisher_anim_names.PushBack('man_finisher_dlc_arm_lp');
						finisher_anim_names.PushBack('man_finisher_dlc_legs_lp');
					}

					else if (theInput.GetActionValue('GI_AxisLeftY') > 0.1 && theInput.GetActionValue('GI_AxisLeftX') > 0.1 )
					{
						finisher_anim_names.PushBack('man_finisher_dlc_arm_rp');
					}

					else if (theInput.GetActionValue('GI_AxisLeftY') > 0.1 && theInput.GetActionValue('GI_AxisLeftX') < -0.1 )
					{
						finisher_anim_names.PushBack('man_finisher_dlc_arm_lp');
					}

					else if (theInput.GetActionValue('GI_AxisLeftY') < -0.1 && theInput.GetActionValue('GI_AxisLeftX') > 0.1 )
					{
						finisher_anim_names.PushBack('man_finisher_dlc_legs_rp');
					}

					else if (theInput.GetActionValue('GI_AxisLeftX') < -0.1 && theInput.GetActionValue('GI_AxisLeftY') < -0.1 )
					{
						finisher_anim_names.PushBack('man_finisher_dlc_legs_lp');
					}

					else
					{
						finisher_anim_names.PushBack('man_finisher_05_rp');
						//finisher_anim_names.PushBack('man_finisher_06_lp');
						finisher_anim_names.PushBack('man_finisher_dlc_legs_rp');
						finisher_anim_names.PushBack('man_finisher_dlc_legs_lp');
						finisher_anim_names.PushBack('man_finisher_dlc_arm_rp');
						finisher_anim_names.PushBack('man_finisher_dlc_arm_lp');
						finisher_anim_names.PushBack('man_finisher_dlc_neck_rp');
					}

					chosen_finisher_anim_name = finisher_anim_names[RandRange(finisher_anim_names.Size())];

					thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( chosen_finisher_anim_name, 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0.125f, 1.0f) );

					GetWitcherPlayer().ACS_ClearAnimationSpeedMultipliers();

					GetACSWatcher().RemoveTimer('ACS_ResetAnimation');

					GetWitcherPlayer().EnableCharacterCollisions(false);
					GetWitcherPlayer().SetImmortalityMode( AIM_Invulnerable, AIC_Default, true ); 
					GetWitcherPlayer().SetCanPlayHitAnim(false);
					GetWitcherPlayer().AddBuffImmunity_AllNegative('acs_unarmed_finisher', true);

					enemyAnimatedComponent.UnfreezePose();

					enemyAnimatedComponent.UnfreezePoseFadeOut(0);
	
					switch(chosen_finisher_anim_name)
					{
						case 'man_finisher_dlc_arm_lp':
						enemyAnimatedComponent.PlaySlotAnimationAsync( 'man_finisher_dlc_arm_lp_no_dismemberment_ACS', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.125f, 0.125f) );
						Sleep(1.25);
						break;

						case 'man_finisher_dlc_arm_rp':
						enemyAnimatedComponent.PlaySlotAnimationAsync( 'man_finisher_dlc_arm_rp_no_dismemberment_ACS', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.125f, 0.125f) );
						Sleep(1.25);
						break;

						case 'man_finisher_dlc_legs_lp':
						enemyAnimatedComponent.PlaySlotAnimationAsync( 'man_finisher_dlc_legs_lp_no_dismemberment_ACS', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.125f, 0.125f) );
						Sleep(1.25);
						break;

						case 'man_finisher_dlc_legs_rp':
						enemyAnimatedComponent.PlaySlotAnimationAsync( 'man_finisher_dlc_legs_rp_no_dismemberment_ACS', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.125f, 0.125f) );
						Sleep(1.25);
						break;

						case 'man_finisher_05_rp':
						enemyAnimatedComponent.PlaySlotAnimationAsync( 'man_finisher_05_rp_no_dismemberment_ACS', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.125f, 0.125f) );
						Sleep(1.5);
						break;

						case 'man_finisher_06_lp':
						enemyAnimatedComponent.PlaySlotAnimationAsync( 'man_finisher_06_lp_no_dismemberment_ACS', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.125f, 0.125f) );
						Sleep(1.5);
						break;

						case 'man_finisher_dlc_neck_rp':
						movementAdjustor.CancelAll();
						//movementAdjustorTarget.CancelAll();
						enemyAnimatedComponent.PlaySlotAnimationAsync( 'man_finisher_dlc_neck_rp_no_dismemberment_ACS', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.125f, 0.125f) );
						Sleep(1.5);
						break;

						default:
						enemyAnimatedComponent.PlaySlotAnimationAsync( 'man_finisher_06_lp_no_dismemberment_ACS', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.125f, 0.125f) );
						Sleep(1.5);
						break;
					}

					GetACSWatcher().FreezeMoveTargets(6);
				}
				else
				{
					last_enemy = true;
				}
			}

			if ( last_enemy == true ) 
			{
				if (chosen_finisher_anim_name == 'man_finisher_05_rp')
				{
					thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( 'combat_locomotion_walk_idle_to_forward_fail', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0.5f, 0.125f) );
				}
				
				movementAdjustor = GetWitcherPlayer().GetMovingAgentComponent().GetMovementAdjustor();

				movementAdjustor.CancelAll();

				thePlayer.RemoveTag('ACS_IsPerformingFinisher');

				if( GetWitcherPlayer().IsAlive()) {GetWitcherPlayer().ACS_ClearAnimationSpeedMultipliers();}

				GetWitcherPlayer().EnableCharacterCollisions(true);
				GetWitcherPlayer().SetImmortalityMode( AIM_None, AIC_Default, true );
				GetWitcherPlayer().SetCanPlayHitAnim(true);
				GetWitcherPlayer().RemoveBuffImmunity_AllNegative('acs_unarmed_finisher');

				thePlayer.BlockAllActions( 'ACS_Unarmed_Finisher_Action_Block', false );

				((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent()).SetAnimatedMovement( false );

				if (!thePlayer.IsAnyWeaponHeld()
				|| thePlayer.IsWeaponHeld('fist')
				)
				{
					thePlayer.RaiseEvent('LootHerb');

					thePlayer.RaiseEvent('ACS_HolsterDagger');

					ACSGetCEntity('acs_finisher_dagger').BreakAttachment();

					ACSGetCEntity('acs_finisher_dagger').CreateAttachment( GetWitcherPlayer(), 'r_weapon', Vector(0,0,0), EulerAngles(180,0,-0.0625f) );

					if ( !theSound.SoundIsBankLoaded("qu_nml_105.bnk") )
					{
						theSound.SoundLoadBank( "qu_nml_105.bnk", false );
					}

					GetWitcherPlayer().SoundEvent("qu_nml_105_geralt_sheats_dagger");

					Sleep(0.5);

					thePlayer.RaiseEvent('ACS_ForceHandClosedREnd');
					ACSGetCEntityDestroyAll('acs_finisher_dagger');
				}
			}
		}
		else
		{
			//thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( 'combat_locomotion_walk_idle_to_forward_fail', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0.125f, 0.125f) );

			thePlayer.RemoveTag('ACS_IsPerformingFinisher');

			movementAdjustor = GetWitcherPlayer().GetMovingAgentComponent().GetMovementAdjustor();

			movementAdjustor.CancelAll();

			GetWitcherPlayer().EnableCharacterCollisions(true);
			GetWitcherPlayer().SetImmortalityMode( AIM_None, AIC_Default, true );
			GetWitcherPlayer().SetCanPlayHitAnim(true);
			GetWitcherPlayer().RemoveBuffImmunity_AllNegative('acs_unarmed_finisher');
			
			thePlayer.BlockAllActions( 'ACS_Unarmed_Finisher_Action_Block', false );

			((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent()).SetAnimatedMovement( false );

			if (!thePlayer.IsAnyWeaponHeld()
			|| thePlayer.IsWeaponHeld('fist')
			)
			{
				thePlayer.RaiseEvent('LootHerb');

				thePlayer.RaiseEvent('ACS_HolsterDagger');

				ACSGetCEntity('acs_finisher_dagger').BreakAttachment();

				ACSGetCEntity('acs_finisher_dagger').CreateAttachment( GetWitcherPlayer(), 'r_weapon', Vector(0,0,0), EulerAngles(180,0,-0.0625f) );

				if ( !theSound.SoundIsBankLoaded("qu_nml_105.bnk") )
				{
					theSound.SoundLoadBank( "qu_nml_105.bnk", false );
				}

				GetWitcherPlayer().SoundEvent("qu_nml_105_geralt_sheats_dagger");

				Sleep(0.5);

				thePlayer.RaiseEvent('ACS_ForceHandClosedREnd');
				ACSGetCEntityDestroyAll('acs_finisher_dagger');
			}
		}
	}
	

}

state Armed_Finisher_Engage in cACS_Finisher_Chain
{
	private var actorVictims															: array<CActor>;
	private var j, k 																	: int;
	private var movementAdjustor, movementAdjustorTarget								: CMovementAdjustor;
	private var ticket, ticketTarget													: SMovementAdjustmentRequestTicket;
	private var dist																	: float;
	private var chosen_finisher_anim_name												: name;
	private var finisher_anim_names														: array< name >;
	private var last_enemy																: bool;
	private var enemyAnimatedComponent 													: CAnimatedComponent;
	private var voiceTagName 															: name;
	private var voiceTagStr																: string;

	event OnEnterState(prevStateName : name)
	{
		super.OnEnterState(prevStateName);

		Armed_Finisher();
	}
	
	entry function Armed_Finisher()
	{
		actorVictims.Clear();
		
		actorVictims = GetWitcherPlayer().GetNPCsAndPlayersInRange( 10, 20, , FLAG_ExcludePlayer + FLAG_OnlyAliveActors + FLAG_Attitude_Hostile );

		if( actorVictims.Size() > 0 )
		{
			thePlayer.AddTag('ACS_IsPerformingFinisher');

			((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent()).SetAnimatedMovement( true );

			GetACSWatcher().RemoveTimer('ACS_ResetAnimation');

			last_enemy = false;

			GetWitcherPlayer().EnableCharacterCollisions(false);
			GetWitcherPlayer().SetImmortalityMode( AIM_Invulnerable, AIC_Default, true ); 
			GetWitcherPlayer().SetCanPlayHitAnim(false);
			GetWitcherPlayer().AddBuffImmunity_AllNegative('acs_unarmed_finisher', true);

			GetWitcherPlayer().ACS_ClearAnimationSpeedMultipliers();

			GetACSWatcher().RemoveTimer('ACS_ResetAnimation');

			thePlayer.BlockAllActions( 'ACS_Unarmed_Finisher_Action_Block', true );

			thePlayer.RaiseEvent('ACS_DrawSwordEnd');

			for( j = 0; j < actorVictims.Size(); j += 1 )
			{
				if ( j == actorVictims.Size() - 1 )
				{
					last_enemy = true;
				}

				voiceTagName =  actorVictims[j] .GetVoicetag();

				voiceTagStr = NameToString( voiceTagName );

				if (actorVictims[j] 
				&& actorVictims[j].IsAlive()
				&& ACS_GetItem_Sword_IsEquipped('knife_steel', 'steel') 
				&& thePlayer.IsWeaponHeld('steelsword')
				&& actorVictims[j] .IsMan()
				&& !actorVictims[j] .UsesEssence()
				&& ((CNewNPC)actorVictims[j] ).GetNPCType() != ENGT_Quest
				&& !actorVictims[j] .HasTag( 'ethereal' )
				&& !actorVictims[j] .HasAbility( 'Boss' )
				&& !actorVictims[j] .HasTag( 'IsBoss' )
				&& !actorVictims[j] .HasTag( 'ACS_Berserkers_Human' )
				&& !actorVictims[j] .HasTag( 'ACS_Shades_Hunter' )
				&& !actorVictims[j] .HasTag( 'ACS_Shades_Crusader' )
				&& !actorVictims[j] .IsUsingHorse()
				&& !actorVictims[j] .IsUsingVehicle()
				&& !actorVictims[j] .HasTag('ACS_In_Rage')
				&& !actorVictims[j] .HasTag('ACS_Pre_Rage')
				&& !actorVictims[j] .HasTag('ACS_Final_Fear_Stack')
				&& !((CNewNPC)actorVictims[j] ).IsInFinisherAnim()
				&& GetACSWatcher().ACS_Rage_Process == false
				&& actorVictims[j] .GetBehaviorGraphInstanceName() != 'Shield'
				&& !actorVictims[j] .HasTag('mq1060_witcher')
				&& StrFindFirst(voiceTagStr, "REINALD") < 0
				&& !thePlayer.HasTag('acs_vampire_claws_equipped')
				&& !thePlayer.IsInFistFightMiniGame()
				&& VecDistanceSquared2D( thePlayer.GetWorldPosition(), actorVictims[j].GetWorldPosition() ) <= 2 * 2
				)
				{
					if ( actorVictims[j].GetInteractionPriority() != IP_Max_Unpushable )
					{
						actorVictims[j].SetInteractionPriority( IP_Max_Unpushable );
					}
					
					enemyAnimatedComponent = (CAnimatedComponent)actorVictims[j].GetComponentByClassName( 'CAnimatedComponent' );	

					((CNewNPC)(actorVictims[j])).EnableCharacterCollisions(false);

					((CNewNPC)(actorVictims[j])).SetCanPlayHitAnim(true);

					((CNewNPC)(actorVictims[j])).SetUnstoppable(false);

					((CNewNPC)(actorVictims[j])).GetRootAnimatedComponent().PlaySlotAnimationAsync( '', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0, 0) );
					
					movementAdjustor = GetWitcherPlayer().GetMovingAgentComponent().GetMovementAdjustor();

					dist = (((CMovingPhysicalAgentComponent)actorVictims[j].GetMovingAgentComponent()).GetCapsuleRadius() 
					+ ((CMovingPhysicalAgentComponent)GetWitcherPlayer().GetMovingAgentComponent()).GetCapsuleRadius()) * 0.55;

					ticket = movementAdjustor.GetRequest( 'ACS_Unarmed_Finisher');
					movementAdjustor.CancelByName( 'ACS_Unarmed_Finisher' );
					movementAdjustor.CancelAll();

					ticket = movementAdjustor.CreateNewRequest( 'ACS_Unarmed_Finisher' );
					movementAdjustor.AdjustmentDuration( ticket, 0.01 );
					movementAdjustor.MaxRotationAdjustmentSpeed( ticket, 250 );
					movementAdjustor.MaxLocationAdjustmentSpeed( ticket, 25 );
					movementAdjustor.AdjustLocationVertically( ticket, true );
					movementAdjustor.ScaleAnimationLocationVertically( ticket, true );
					movementAdjustor.Continuous(ticket);
					movementAdjustor.RotateTowards(ticket, actorVictims[j], 2.5);

					//movementAdjustor.SlideTowards( ticket, actorVictims[j], dist, dist );


					movementAdjustorTarget = actorVictims[j].GetMovingAgentComponent().GetMovementAdjustor();

					ticketTarget = movementAdjustorTarget.GetRequest( 'ACS_Unarmed_Finisher');
					movementAdjustorTarget.CancelByName( 'ACS_Unarmed_Finisher' );
					movementAdjustorTarget.CancelAll();

					ticketTarget = movementAdjustorTarget.CreateNewRequest( 'ACS_Unarmed_Finisher' );
					movementAdjustorTarget.AdjustmentDuration( ticketTarget, 0.125 );
					movementAdjustorTarget.MaxRotationAdjustmentSpeed( ticketTarget, 50000 );
					movementAdjustorTarget.MaxLocationAdjustmentSpeed( ticketTarget, 10 );
					movementAdjustorTarget.AdjustLocationVertically( ticketTarget, true );
					movementAdjustorTarget.ScaleAnimationLocationVertically( ticketTarget, true );
					movementAdjustorTarget.Continuous(ticketTarget);

					movementAdjustorTarget.RotateTowards(ticketTarget, thePlayer);

					movementAdjustorTarget.SlideTowards( ticketTarget, thePlayer, dist, dist );

					if (VecDistanceSquared2D( thePlayer.GetWorldPosition(), actorVictims[j].GetWorldPosition() ) > 1.75 * 1.75)
					{
						actorVictims[j].AddEffectDefault( EET_LongStagger, thePlayer, "ACS_Unarmed_Finisher" );
					}

					Sleep(0.125);

					finisher_anim_names.Clear();

					if (theInput.GetActionValue('GI_AxisLeftX') == 0 && theInput.GetActionValue('GI_AxisLeftY') == 0 )
					{
						finisher_anim_names.PushBack('man_finisher_05_rp');
						//finisher_anim_names.PushBack('man_finisher_06_lp');
						finisher_anim_names.PushBack('man_finisher_dlc_legs_rp');
						finisher_anim_names.PushBack('man_finisher_dlc_legs_lp');
						finisher_anim_names.PushBack('man_finisher_dlc_arm_rp');
						finisher_anim_names.PushBack('man_finisher_dlc_arm_lp');
						finisher_anim_names.PushBack('man_finisher_dlc_neck_rp');
					}

					else if (theInput.GetActionValue('GI_AxisLeftY') > 0.1 && theInput.GetActionValue('GI_AxisLeftX') == 0)
					{
						finisher_anim_names.PushBack('man_finisher_05_rp');
						//finisher_anim_names.PushBack('man_finisher_06_lp');
					}

					else if (theInput.GetActionValue('GI_AxisLeftY') < -0.1 && theInput.GetActionValue('GI_AxisLeftX') == 0  )
					{
						finisher_anim_names.PushBack('man_finisher_dlc_neck_rp');
					}

					else if (theInput.GetActionValue('GI_AxisLeftX') > 0.1 && theInput.GetActionValue('GI_AxisLeftY') == 0 )
					{
						finisher_anim_names.PushBack('man_finisher_dlc_arm_rp');
						finisher_anim_names.PushBack('man_finisher_dlc_legs_rp');
					}

					else if (theInput.GetActionValue('GI_AxisLeftX') < -0.1 && theInput.GetActionValue('GI_AxisLeftY') == 0) 
					{
						finisher_anim_names.PushBack('man_finisher_dlc_arm_lp');
						finisher_anim_names.PushBack('man_finisher_dlc_legs_lp');
					}

					else if (theInput.GetActionValue('GI_AxisLeftY') > 0.1 && theInput.GetActionValue('GI_AxisLeftX') > 0.1 )
					{
						finisher_anim_names.PushBack('man_finisher_dlc_arm_rp');
					}

					else if (theInput.GetActionValue('GI_AxisLeftY') > 0.1 && theInput.GetActionValue('GI_AxisLeftX') < -0.1 )
					{
						finisher_anim_names.PushBack('man_finisher_dlc_arm_lp');
					}

					else if (theInput.GetActionValue('GI_AxisLeftY') < -0.1 && theInput.GetActionValue('GI_AxisLeftX') > 0.1 )
					{
						finisher_anim_names.PushBack('man_finisher_dlc_legs_rp');
					}

					else if (theInput.GetActionValue('GI_AxisLeftX') < -0.1 && theInput.GetActionValue('GI_AxisLeftY') < -0.1 )
					{
						finisher_anim_names.PushBack('man_finisher_dlc_legs_lp');
					}

					else
					{
						finisher_anim_names.PushBack('man_finisher_05_rp');
						//finisher_anim_names.PushBack('man_finisher_06_lp');
						finisher_anim_names.PushBack('man_finisher_dlc_legs_rp');
						finisher_anim_names.PushBack('man_finisher_dlc_legs_lp');
						finisher_anim_names.PushBack('man_finisher_dlc_arm_rp');
						finisher_anim_names.PushBack('man_finisher_dlc_arm_lp');
						finisher_anim_names.PushBack('man_finisher_dlc_neck_rp');
					}

					chosen_finisher_anim_name = finisher_anim_names[RandRange(finisher_anim_names.Size())];

					thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( chosen_finisher_anim_name, 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0.125f, 1.0f) );

					GetWitcherPlayer().ACS_ClearAnimationSpeedMultipliers();

					GetACSWatcher().RemoveTimer('ACS_ResetAnimation');

					GetWitcherPlayer().EnableCharacterCollisions(false);
					GetWitcherPlayer().SetImmortalityMode( AIM_Invulnerable, AIC_Default, true ); 
					GetWitcherPlayer().SetCanPlayHitAnim(false);
					GetWitcherPlayer().AddBuffImmunity_AllNegative('acs_unarmed_finisher', true);

					enemyAnimatedComponent.UnfreezePose();

					enemyAnimatedComponent.UnfreezePoseFadeOut(0);
	
					switch(chosen_finisher_anim_name)
					{
						case 'man_finisher_dlc_arm_lp':
						enemyAnimatedComponent.PlaySlotAnimationAsync( 'man_finisher_dlc_arm_lp_no_dismemberment_ACS', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.125f, 0.125f) );
						Sleep(1.25);
						break;

						case 'man_finisher_dlc_arm_rp':
						enemyAnimatedComponent.PlaySlotAnimationAsync( 'man_finisher_dlc_arm_rp_no_dismemberment_ACS', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.125f, 0.125f) );
						Sleep(1.25);
						break;

						case 'man_finisher_dlc_legs_lp':
						enemyAnimatedComponent.PlaySlotAnimationAsync( 'man_finisher_dlc_legs_lp_no_dismemberment_ACS', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.125f, 0.125f) );
						Sleep(1.25);
						break;

						case 'man_finisher_dlc_legs_rp':
						enemyAnimatedComponent.PlaySlotAnimationAsync( 'man_finisher_dlc_legs_rp_no_dismemberment_ACS', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.125f, 0.125f) );
						Sleep(1.25);
						break;

						case 'man_finisher_05_rp':
						enemyAnimatedComponent.PlaySlotAnimationAsync( 'man_finisher_05_rp_no_dismemberment_ACS', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.125f, 0.125f) );
						Sleep(1.5);
						break;

						case 'man_finisher_06_lp':
						enemyAnimatedComponent.PlaySlotAnimationAsync( 'man_finisher_06_lp_no_dismemberment_ACS', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.125f, 0.125f) );
						Sleep(1.5);
						break;

						case 'man_finisher_dlc_neck_rp':
						movementAdjustor.CancelAll();
						//movementAdjustorTarget.CancelAll();
						enemyAnimatedComponent.PlaySlotAnimationAsync( 'man_finisher_dlc_neck_rp_no_dismemberment_ACS', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.125f, 0.125f) );
						Sleep(1.5);
						break;

						default:
						enemyAnimatedComponent.PlaySlotAnimationAsync( 'man_finisher_06_lp_no_dismemberment_ACS', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.125f, 0.125f) );
						Sleep(1.5);
						break;
					}

					GetACSWatcher().FreezeMoveTargets(6);
				}
				else
				{
					last_enemy = true;
				}
			}

			if ( last_enemy == true ) 
			{
				if (chosen_finisher_anim_name == 'man_finisher_05_rp')
				{
					thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( 'combat_locomotion_walk_idle_to_forward_fail', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0.5f, 0.125f) );
				}

				movementAdjustor = GetWitcherPlayer().GetMovingAgentComponent().GetMovementAdjustor();

				movementAdjustor.CancelAll();

				thePlayer.RemoveTag('ACS_IsPerformingFinisher');

				if( GetWitcherPlayer().IsAlive()) {GetWitcherPlayer().ACS_ClearAnimationSpeedMultipliers();}

				GetWitcherPlayer().EnableCharacterCollisions(true);
				GetWitcherPlayer().SetImmortalityMode( AIM_None, AIC_Default, true );
				GetWitcherPlayer().SetCanPlayHitAnim(true);
				GetWitcherPlayer().RemoveBuffImmunity_AllNegative('acs_unarmed_finisher');

				thePlayer.BlockAllActions( 'ACS_Unarmed_Finisher_Action_Block', false );

				((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent()).SetAnimatedMovement( false );
			}
		}
		else
		{
			//thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( 'combat_locomotion_walk_idle_to_forward_fail', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0.125f, 0.125f) );

			thePlayer.RemoveTag('ACS_IsPerformingFinisher');

			movementAdjustor = GetWitcherPlayer().GetMovingAgentComponent().GetMovementAdjustor();

			movementAdjustor.CancelAll();

			GetWitcherPlayer().EnableCharacterCollisions(true);
			GetWitcherPlayer().SetImmortalityMode( AIM_None, AIC_Default, true );
			GetWitcherPlayer().SetCanPlayHitAnim(true);
			GetWitcherPlayer().RemoveBuffImmunity_AllNegative('acs_unarmed_finisher');
			
			thePlayer.BlockAllActions( 'ACS_Unarmed_Finisher_Action_Block', false );

			((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent()).SetAnimatedMovement( false );
		}
	}
	

}

statemachine class cACS_Destroy_Custom_Monsters
{
    function Destroy_Custom_Monsters_Engage()
	{
		this.PushState('Destroy_Custom_Monsters_Engage');
	}
}

state Destroy_Custom_Monsters_Engage in cACS_Destroy_Custom_Monsters
{
	event OnEnterState(prevStateName : name)
	{
		super.OnEnterState(prevStateName);
		Destroy_Custom_Monsters();
	}
	
	entry function Destroy_Custom_Monsters()
	{
		var i												: int;
		var actors 											: array<CActor>;

		actors.Clear();

		theGame.GetActorsByTag( 'ACS_Custom_Monster', actors );	
		
		for( i = 0; i < actors.Size(); i += 1 )
		{
			actors[i].Kill('ACS_Kill_All', true, actors[i]);

			if (actors[i].IsAlive())
			{
				actors[i].Kill('ACS_Kill_All', true, actors[i]);
			}

			actors[i].StopAllEffects();
			actors[i].RemoveTimers();
			actors[i].SetHideInGame(true);
			actors[i].SetVisibility(false);
			actors[i].Destroy();

			SleepOneFrame();
		}
	}
	

}

statemachine class CACSElectricFist extends CGameplayEntity
{
	event OnSpawned( spawnData : SEntitySpawnData )
	{
		super.OnSpawned( spawnData );

		SoundEvent("magic_sorceress_vfx_hit_electric");

		if (ACS_Is_DLC_Installed('dlcquen')
		|| ACS_Armor_Set_Check('acs_armor', false)
		|| ACS_Armor_Set_Check('wh_armor', false)
		|| ACS_Armor_Set_Check('eredin_armor', false)
		|| ACS_Armor_Set_Check('imlerith_armor', false)
		|| ACS_Armor_Set_Check('caranthir_armor', false)
		|| ACS_Armor_Set_Check('vgx_eredin_armor', false)
		)
		{
			PlayEffectSingle('hit_electric_blue');

			PlayEffectSingle('diagonal_up_left_blue');
			PlayEffectSingle('diagonal_down_left_blue');
			PlayEffectSingle('down_blue');
			PlayEffectSingle('up_blue');
			PlayEffectSingle('diagonal_up_right_blue');
			PlayEffectSingle('diagonal_down_right_blue');
			PlayEffectSingle('right_blue');
			PlayEffectSingle('left_blue');
		}
		else
		{
			PlayEffectSingle('hit_electric_normal');

			PlayEffectSingle('diagonal_up_left_normal');
			PlayEffectSingle('diagonal_down_left_normal');
			PlayEffectSingle('down_normal');
			PlayEffectSingle('up_normal');
			PlayEffectSingle('diagonal_up_right_normal');
			PlayEffectSingle('diagonal_down_right_normal');
			PlayEffectSingle('right_normal');
			PlayEffectSingle('left_normal');
		}

		this.PushState('SpawnLightningCoils');
	}
}

state SpawnLightningCoils in CACSElectricFist
{
	event OnEnterState(prevStateName : name)
	{
		super.OnEnterState(prevStateName);

		LightningCoilsStart();
	}

	entry function LightningCoilsStart()
	{
		var actortarget 					: CActor;
		var actors		    				: array<CActor>;
		var i								: int;
		var dmg								: W3DamageAction;
		var damageMax, damageMin			: float;
		var fxent, ent_2                    : CEntity;
    	var temp                  			: CEntityTemplate;

		ent_2 = theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync( 
			"dlc\dlc_acs\data\fx\sign_icons.w2ent"
		, true ), parent.GetWorldPosition(), parent.GetWorldRotation() );

		if (ACS_Is_DLC_Installed('dlcquen')
		|| ACS_Armor_Set_Check('acs_armor', false)
		|| ACS_Armor_Set_Check('wh_armor', false)
		|| ACS_Armor_Set_Check('eredin_armor', false)
		|| ACS_Armor_Set_Check('imlerith_armor', false)
		|| ACS_Armor_Set_Check('caranthir_armor', false)
		|| ACS_Armor_Set_Check('vgx_eredin_armor', false)
		)
		{
			ent_2.PlayEffectSingle('quen_icon_blue');

			ent_2.PlayEffectSingle('critical_aard');
		}
		else
		{
			ent_2.PlayEffectSingle('quen_icon');

			ent_2.PlayEffectSingle('critical_quen');
		}

		ent_2.CreateAttachment(parent);

		ent_2.DestroyAfter(0.75);

		SleepOneFrame();

		actors.Clear();

		actors = thePlayer.GetNPCsAndPlayersInRange( 5, RandRange(4,2), , FLAG_OnlyAliveActors + FLAG_Attitude_Hostile + FLAG_ExcludePlayer);

		if( actors.Size() > 0 )
		{
			for( i = 0; i < actors.Size(); i += 1 )
			{
				actortarget = (CActor)actors[i];

				if (actortarget == ACSGetCActor('ACS_Transformation_Black_Wolf')
				|| actortarget.HasTag('smokeman') 
				|| actortarget.HasTag('ACS_Necrofiend_Tentacle_1') 
				|| actortarget.HasTag('ACS_Necrofiend_Tentacle_2') 
				|| actortarget.HasTag('ACS_Necrofiend_Tentacle_3') 
				|| actortarget.HasTag('ACS_Necrofiend_Tentacle_6')
				|| actortarget.HasTag('ACS_Necrofiend_Tentacle_5')
				|| actortarget.HasTag('ACS_Necrofiend_Tentacle_4')
				|| actortarget.HasTag('ACS_Vampire_Monster_Boss_Bar') 
				|| actortarget.HasTag('ACS_Chaos_Cloud')
				)
				continue;

				actortarget.IsAttacked();

				actortarget.SignalGameplayEventParamInt('Time2Dodge', (int)EDT_Attack_Light );

				dmg = new W3DamageAction in theGame.damageMgr;
				
				dmg.Initialize(thePlayer, actortarget, NULL, thePlayer.GetName(), EHRT_Heavy, CPS_Undefined, false, false, true, false);
				
				dmg.SetProcessBuffsIfNoDamage(true);
				
				dmg.SetIgnoreImmortalityMode(false);

				dmg.SetHitAnimationPlayType(EAHA_ForceYes);

				dmg.SetCanPlayHitParticle(false);

				if (actortarget.UsesVitality()) 
				{ 
					damageMax = actortarget.GetStat( BCS_Vitality ) * 0.0625; 

					damageMin = actortarget.GetStat( BCS_Vitality ) * 0.03125; 
				} 
				else if (actortarget.UsesEssence()) 
				{ 
					damageMax = actortarget.GetStat( BCS_Essence ) * 0.0625; 
					
					damageMin = actortarget.GetStat( BCS_Essence ) * 0.03125; 
				}

				dmg.SetHitReactionType( EHRT_Heavy, true);

				dmg.AddDamage( theGame.params.DAMAGE_NAME_SHOCK, 50 + RandRangeF(damageMax,damageMin) );

				dmg.AddEffectInfo(EET_Paralyzed, 1.5);

				dmg.SetForceExplosionDismemberment();
					
				dmg.SetCriticalHit(); theGame.damageMgr.ProcessAction( dmg );
					
				delete dmg;	


				temp = (CEntityTemplate)LoadResourceAsync("dlc\dlc_acs\data\fx\electric_fist\electric_fist_fx_dummy_entity.w2ent",true);

				fxent = (CEntity)theGame.CreateEntity(temp, actortarget.GetWorldPosition(), actortarget.GetWorldRotation());

				fxent.CreateAttachment(actortarget,, Vector( 0, 0, RandRangeF(1.5,1.25) ), EulerAngles(RandRangeF(360,0),RandRangeF(360,0),RandRangeF(356,0)));

				if (ACS_Is_DLC_Installed('dlcquen')
				|| ACS_Armor_Set_Check('acs_armor', false)
				|| ACS_Armor_Set_Check('wh_armor', false)
				|| ACS_Armor_Set_Check('eredin_armor', false)
				|| ACS_Armor_Set_Check('imlerith_armor', false)
				|| ACS_Armor_Set_Check('caranthir_armor', false)
				|| ACS_Armor_Set_Check('vgx_eredin_armor', false)
				)
				{
					fxent.PlayEffectSingle('hit_electric_blue');

					parent.PlayEffectSingle('lightning_blue', fxent);
				}
				else
				{
					fxent.PlayEffectSingle('hit_electric_normal');

					parent.PlayEffectSingle('lightning_normal', fxent);
				}

				fxent.DestroyAfter(3);

				fxent.SoundEvent("magic_sorceress_vfx_hit_electric");

				parent.StopEffect('lightning_blue');
				parent.StopEffect('lightning_normal');

				Sleep(0.125f);
			}
		}

		LightningCoilsNeutral();
	}
	
	latent function LightningCoilsNeutral()
	{
		var temp															: CEntityTemplate;
		var ent																: CEntity;
		var i, count														: int;
		var playerPos, spawnPos												: Vector;
		var randAngle, randRange											: float;
		var playerRot														: EulerAngles;

		temp = (CEntityTemplate)LoadResourceAsync( 

		"dlc\dlc_acs\data\fx\electric_fist\electric_fist_fx_dummy_entity.w2ent"
			
		, true );

		playerPos = parent.GetWorldPosition();

		playerRot = parent.GetWorldRotation();

		playerRot.Pitch += RandRangeF(356,0);
		playerRot.Roll += RandRangeF(356,0);
		playerRot.Yaw += RandRangeF(356,0);
		
		count = RandRange(5,3);
			
		for( i = 0; i < count; i += 1 )
		{
			randRange = 2.5 + 2.5 * RandF();
			randAngle = 2.5 * Pi() * RandF();
			
			spawnPos.X = randRange * CosF( randAngle ) + playerPos.X;
			spawnPos.Y = randRange * SinF( randAngle ) + playerPos.Y;
			spawnPos.Z = playerPos.Z;

			ent = theGame.CreateEntity( temp, ACSFixZAxis(spawnPos), playerRot );

			if (ACS_Is_DLC_Installed('dlcquen')
			|| ACS_Armor_Set_Check('acs_armor', false)
			|| ACS_Armor_Set_Check('wh_armor', false)
			|| ACS_Armor_Set_Check('eredin_armor', false)
			|| ACS_Armor_Set_Check('imlerith_armor', false)
			|| ACS_Armor_Set_Check('caranthir_armor', false)
			|| ACS_Armor_Set_Check('vgx_eredin_armor', false)
			)
			{
				ent.PlayEffectSingle('hit_electric_blue');

				parent.PlayEffectSingle('lightning_blue', ent);
			}
			else
			{
				ent.PlayEffectSingle('hit_electric_normal');

				parent.PlayEffectSingle('lightning_normal', ent);
			}

			ent.DestroyAfter(1);

			ent.SoundEvent("magic_sorceress_vfx_hit_electric");

			parent.StopEffect('lightning_blue');
			parent.StopEffect('lightning_normal');

			Sleep(0.125);
		}
	}
	

}

statemachine class CACSMountedAttackAttachment extends CNewNPC
{
	var ent										: CEntity;
	var attach_vec								: Vector;
	var attach_rot								: EulerAngles;
	var p_comp									: CComponent;
	var temp									: CEntityTemplate;

	event OnSpawned( spawnData : SEntitySpawnData )
	{	
		var animcomp 																: CAnimatedComponent;
		var mac 																	: CMovingPhysicalAgentComponent;

		super.OnSpawned( spawnData );

		(this.GetMovingAgentComponent()).SetEnabledFeetIK(false,0.5);

		(this.GetMovingAgentComponent()).SetEnabledSlidingOnSlopeIK(false);

		((CMovingPhysicalAgentComponent)((CNewNPC)this).GetMovingAgentComponent()).EnableCollisionPrediction( false );

		((CMovingPhysicalAgentComponent)((CNewNPC)this).GetMovingAgentComponent()).SetTerrainInfluence(0);

		((CMovingPhysicalAgentComponent)((CNewNPC)this).GetMovingAgentComponent()).EnableAdditionalVerticalSlidingIteration(true);

		((CMovingPhysicalAgentComponent)((CNewNPC)this).GetMovingAgentComponent()).SetPushable(false);

		((CMovingPhysicalAgentComponent)((CNewNPC)this).GetMovingAgentComponent()).SetRagdollPushingMul(0);

		((CMovingPhysicalAgentComponent)((CNewNPC)this).GetMovingAgentComponent()).SetGravity(false);

		EnablePhysicalMovement( false );

		this.SetTemporaryAttitudeGroup( 'q104_avallach_friendly_to_all', AGP_Default );	

		((CActor)this).EnableCollisions(false);
		((CActor)this).EnableCharacterCollisions(false);

		((CActor)this).SetImmortalityMode( AIM_Invulnerable, AIC_Combat ); 
		((CActor)this).SetCanPlayHitAnim(false); 
		((CActor)this).AddBuffImmunity_AllNegative('ACS_Mount_Util_Buff_Immune', true); 
		((CActor)this).AddBuffImmunity_AllCritical('ACS_Mount_Util_Critical_Immune', true);

		AddTimer('MountCheck', 0.001, true);

		AddAbility( 'DisableHorsePanic' );

		this.AddTag('ACS_MountedAttackAttachmentActive');

		AddTimer('DestroyProcess', 3 , false );

		GetACSStorage().acs_deleteOnelinerByTag("ACS_MountedAttackAttachmentMessage");

		if (!ACS_Settings_Main_Bool('acs_misc_main_settings','acs_hide_mount_prompt', false))
		{
			ACS_Oneliner(
			(new ACS_Oneliner_TagBuilder in theGame)
			.tag("font")
			.attr("size", "26")
			.attr("color", "#f00000")
			.text("[" + GetLocStringById(182503) + "]" )
			, ACSGetCActor('ACS_MountedAttackTarget'), "ACS_MountedAttackAttachmentMessage", Vector(0,0,1.75), 3);

			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_MountedAttackAttachmentMessage", 100);

			GetACSStorage().acs_setScaleForOnelinerByTag("ACS_MountedAttackAttachmentMessage", 100, 100, 100);
		}

		ACS_Tutorial_Display_Check('ACS_Mounted_Attack_Tutorial_Shown');
	}

	var disableMount : bool;

	private timer function MountCheck ( dt : float, id : int )
	{
		var vehicle 						: CVehicleComponent;
		var module, module_1 				: CR4HudModuleBase;
		var ent 							: CEntity;

		module = (CR4HudModuleBase)((CR4ScriptedHud)theGame.GetHud()).GetHudModule("HorseStaminaBarModule");

		module_1 = (CR4HudModuleBase)((CR4ScriptedHud)theGame.GetHud()).GetHudModule("HorsePanicBarModule");

		vehicle = (CVehicleComponent)( ((CNewNPC)this).GetHorseComponent() );

		if(
		!thePlayer.IsUsingVehicle() 
		&& !thePlayer.IsUsingHorse() 
		)
		{
			if( 
			VecDistanceSquared( thePlayer.GetWorldPosition(), this.GetWorldPosition() ) <= 6 * 6
			&& (theInput.GetActionValue('Interact') > 0.1
			|| theInput.GetActionValue('InteractHold') > 0.1)
			&& theInput.GetActionValue('CastSign') == 0
			&& !thePlayer.IsCastingSign()
			&& !disableMount
			)
			{
				if( vehicle )
				{
					thePlayer.DrainFocus( thePlayer.GetStatMax( BCS_Focus ) );
					
					ACSGetCActor('ACS_MountedAttackTarget').EnableCharacterCollisions(false);

					ACSGetCActor('ACS_MountedAttackTarget').AddEffectDefault( EET_Stagger, thePlayer, "ACS_Mounted_Attack_Start" );

					thePlayer.RaiseEvent('ACS_SneakAnim');

					thePlayer.RaiseEvent('ACS_CombatExtraMount');

					GetACSStorage().acs_deleteOnelinerByTag("ACS_MountedAttackAttachmentMessage");
					
					thePlayer.BlockAction( EIAB_DrawWeapon, 			'ACS_Mounted_Attack');
					thePlayer.BlockAction( EIAB_Movement, 				'ACS_Mounted_Attack');
					thePlayer.BlockAction( EIAB_Crossbow, 				'ACS_Mounted_Attack');
					thePlayer.BlockAction( EIAB_Interactions, 			'ACS_Mounted_Attack');
					thePlayer.BlockAction( EIAB_InteractionAction, 		'ACS_Mounted_Attack');
					thePlayer.BlockAction( EIAB_UsableItem, 			'ACS_Mounted_Attack');
					thePlayer.BlockAction( EIAB_Jump, 					'ACS_Mounted_Attack');
					thePlayer.BlockAction( EIAB_QuickSlots, 			'ACS_Mounted_Attack');
					thePlayer.BlockAction( EIAB_ThrowBomb, 				'ACS_Mounted_Attack');
					thePlayer.BlockAction( EIAB_MountVehicle, 			'ACS_Mounted_Attack');
					thePlayer.BlockAction( EIAB_DismountVehicle, 		'ACS_Mounted_Attack');

					RemoveTimer('DismountProcess_Watcher');
					AddTimer('DismountProcess_Watcher', 0.01, true);

					RemoveTimer('DestroyProcess');
					AddTimer('DismountProcess_End', RandRangeF(10, 5) , false );

					thePlayer.ACS_ClearAnimationSpeedMultipliers();

					vehicle.Mount(thePlayer, VMT_ImmediateUse, EVS_driver_slot);
				}
			}

			if ( FactsQuerySum("ACS_Mounted_Attack_Attachment_Active") > 0 )
			{
				if (!module.GetEnabled())
				{
					module.SetEnabled(true);
					((CR4ScriptedHud)theGame.GetHud()).UpdateHUD();
				}

				if (!module_1.GetEnabled())
				{
					module_1.SetEnabled(true);
					((CR4ScriptedHud)theGame.GetHud()).UpdateHUD();
				}

				FactsRemove("ACS_Mounted_Attack_Attachment_Active");
			}

			return;
		}

		((CActor)this).EnableCollisions(false);
		((CActor)this).EnableCharacterCollisions(false);

		if(
		thePlayer.GetHorseCurrentlyMounted() == (CNewNPC)this
		&& VecDistanceSquared( thePlayer.GetWorldPosition(), this.GetWorldPosition() ) <= 6 * 6
		)
		{
			if ( FactsQuerySum("ACS_Mounted_Attack_Attachment_Active") <= 0 )
			{
				FactsAdd("ACS_Mounted_Attack_Attachment_Active", 1, -1);
			}

			if (module.GetEnabled())
			{
				module.SetEnabled(false);
				((CR4ScriptedHud)theGame.GetHud()).UpdateHUD();
			}

			if (module_1.GetEnabled())
			{
				module_1.SetEnabled(false);
				((CR4ScriptedHud)theGame.GetHud()).UpdateHUD();
			}
		}
		else
		{
			if ( FactsQuerySum("ACS_Mounted_Attack_Attachment_Active") > 0 )
			{
				if (!module.GetEnabled())
				{
					module.SetEnabled(true);
					((CR4ScriptedHud)theGame.GetHud()).UpdateHUD();
				}

				if (!module_1.GetEnabled())
				{
					module_1.SetEnabled(true);
					((CR4ScriptedHud)theGame.GetHud()).UpdateHUD();
				}

				FactsRemove("ACS_Mounted_Attack_Attachment_Active");
			}
		}
	}

	event OnTakeDamage( action : W3DamageAction )
	{

	}

	private timer function DestroyProcess ( dt : float, id : int )
	{
		GetACSStorage().acs_deleteOnelinerByTag("ACS_MountedAttackAttachmentMessage");

		thePlayer.RemoveTag('ACS_MountedAttackDismountProcessStart');

		RemoveTimer('DismountProcess_Stab_Damage');

		ACSGetCActor('ACS_MountedAttackTarget').EnableCharacterCollisions(true);

		ACSGetCActor('ACS_MountedAttackTarget').RemoveTag('ACS_NPC_Ready_For_Mounted_Attack_Attachment');
		ACSGetCActor('ACS_MountedAttackTarget').RemoveTag('ACS_MountedAttackTarget');

		ACSGetCEntity('ACS_MountedAttackAttachmentAnchor').Destroy();
		
		Destroy();
	}

	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

	public function DismountProcess_Stab()
	{
		if (!thePlayer.HasTag('ACS_MountedAttackDismountProcessStart'))
		{
			thePlayer.ACS_ClearAnimationSpeedMultipliers();

			
			RemoveTimer('DismountProcess_End');

			thePlayer.RaiseEvent('ACS_CombatExtraMountedStab');

			thePlayer.AddTag('ACS_MountedAttackDismountProcessStart');

			RemoveTimer('DismountProcess_Stab_Damage');
			AddTimer('DismountProcess_Stab_Damage', 0.75 , false );

			thePlayer.AddTag('ACS_MountedAttackDismountProcessStart');
		}
	}

	private timer function DismountProcess_Stab_Damage ( dt : float, id : int )
	{
		var dmg																															: W3DamageAction;
		var damage																														: float;
		var dmgValSilver, dmgValSteel																									: float;
		var item_steel, item_silver																										: SItemUniqueId;
		var tmpName 																													: name;
		var tmpBool 																													: bool;
		var mc 																															: EMonsterCategory;
		var sword_slash_ent																												: CEntity;

		theGame.GetMonsterParamsForActor(ACSGetCActor('ACS_MountedAttackTarget'), mc, tmpName, tmpBool, tmpBool, tmpBool);

		if( ((CNewNPC)ACSGetCActor('ACS_MountedAttackTarget')).GetBloodType() == BT_Red) 
		{
			if (ACSGetCActor('ACS_MountedAttackTarget').HasAbility('mon_lessog_base')
			|| ACSGetCActor('ACS_MountedAttackTarget').HasAbility('mon_sprigan_base')
			)
			{						
				GetACSWatcher().weapon_blood_fx('black');
			} 
			else 
			{
				GetACSWatcher().weapon_blood_fx('red');
			}
		}
		else if( ((CNewNPC)ACSGetCActor('ACS_MountedAttackTarget')).GetBloodType() == BT_Green) 
		{
			if (ACSGetCActor('ACS_MountedAttackTarget').HasAbility('mon_kikimore_base')
			|| ACSGetCActor('ACS_MountedAttackTarget').HasAbility('mon_black_spider_base')
			|| ACSGetCActor('ACS_MountedAttackTarget').HasAbility('mon_black_spider_ep2_base')
			|| ACSGetCActor('ACS_MountedAttackTarget').HasTag('ACS_Ungoliant')
			)
			{						
				GetACSWatcher().weapon_blood_fx('black');
			} 
			else 
			{
				GetACSWatcher().weapon_blood_fx('green');
			}
		}
		else if( ((CNewNPC)ACSGetCActor('ACS_MountedAttackTarget')).GetBloodType() == BT_Yellow) 
		{
			if (ACSGetCActor('ACS_MountedAttackTarget').HasAbility('mon_archespor_base'))
			{
				GetACSWatcher().weapon_blood_fx('yellow');
			} 
			else 
			{
				GetACSWatcher().weapon_blood_fx('red');
			}
		}
		else if	( ((CNewNPC)ACSGetCActor('ACS_MountedAttackTarget')).GetBloodType() == BT_Black) 
		{
			if ( mc == MC_Vampire ) 
			{
				GetACSWatcher().weapon_blood_fx('red');
			}
			else if ( mc == MC_Magicals ) 
			{
				if (ACSGetCActor('ACS_MountedAttackTarget').HasAbility('mon_golem_base')
				|| ACSGetCActor('ACS_MountedAttackTarget').HasAbility('mon_djinn')
				|| ACSGetCActor('ACS_MountedAttackTarget').HasAbility('mon_gargoyle')
				)
				{
					GetACSWatcher().weapon_blood_fx('black');
				}
				else
				{
					GetACSWatcher().weapon_blood_fx('red');
				}
			}
			else
			{
				GetACSWatcher().weapon_blood_fx('black');
			}
		}
		else
		{
			GetACSWatcher().weapon_blood_fx('red');
		}

		if (RandF() < 0.5)
		{
			GetWitcherPlayer().SoundEvent("blood_spatter_bb_acs");
		}
		else
		{
			GetWitcherPlayer().SoundEvent("proc_bleed_wf_acs");
		}

		if (ACS_Settings_Main_Bool('acs_visual_main_settings','acs_directional_slash_effects_enabled', true))
		{
			sword_slash_ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\fx\acs_sword_slashes.w2ent", true ), ACSGetCActor('ACS_MountedAttackTarget').GetWorldPosition() + Vector( 0, 0, RandRangeF(1.5,1.25) ), EulerAngles(0,0,0));

			sword_slash_ent.DestroyAfter(0.5);

			if (((CMovingPhysicalAgentComponent)(ACSGetCActor('ACS_MountedAttackTarget').GetMovingAgentComponent())).GetCapsuleHeight() >= 2
			|| ACSGetCActor('ACS_MountedAttackTarget').GetRadius() >= 0.7
			|| ACSGetCActor('ACS_MountedAttackTarget').HasAbility('Boss')
			|| ACSGetCActor('ACS_MountedAttackTarget').HasTag('IsBoss')
			|| ACSGetCActor('ACS_MountedAttackTarget').HasTag('ACS_Big_Boi')
			)
			{
				sword_slash_ent.PlayEffectSingle('sword_slash_finisher_large');
			}
			else
			{
				sword_slash_ent.PlayEffectSingle('sword_slash_finisher');
			}

			sword_slash_ent.PlayEffectSingle('sword_slash_finisher_secondary');
		}

		ACSGetCActorRemoveTag('ACS_Counter_Wound_Ready');

		ACSGetCEntityDestroyAll('ACS_Counter_Wound'); 
		
		ACSGetCEntityDestroyAll('ACS_Sneaking_Lure');

		((CNewNPC)ACSGetCActor('ACS_MountedAttackTarget')).ACS_ResetPostureImmediate();

		GetWitcherPlayer().SoundEvent("proc_slash_wf_acs");

		GetWitcherPlayer().SoundEvent("cmb_play_ger_stab_in");

		GetWitcherPlayer().SoundEvent("cmb_play_ger_stab_out");

		GetWitcherPlayer().SoundEvent("cmb_play_dismemberment_gore");

		GetWitcherPlayer().SoundEvent("monster_dettlaff_monster_vein_hit_blood");

		GetWitcherPlayer().GetInventory().GetItemEquippedOnSlot(EES_SteelSword, item_steel);

		GetWitcherPlayer().GetInventory().GetItemEquippedOnSlot(EES_SilverSword, item_silver);

		dmg = new W3DamageAction in theGame.damageMgr;
			
		dmg.Initialize(GetWitcherPlayer(), ACSGetCActor('ACS_MountedAttackTarget'), NULL, GetWitcherPlayer().GetName(), EHRT_Heavy, CPS_Undefined, false, false, true, false);
		
		dmg.SetHitReactionType( EHRT_Heavy, true);

		dmg.SetHitAnimationPlayType(EAHA_ForceYes);

		if (GetWitcherPlayer().IsWeaponHeld('steelsword'))
		{
			dmgValSilver = GetWitcherPlayer().GetTotalWeaponDamage(item_steel, theGame.params.DAMAGE_NAME_SLASHING, GetInvalidUniqueId()) 
			+ GetWitcherPlayer().GetTotalWeaponDamage(item_steel, theGame.params.DAMAGE_NAME_PIERCING, GetInvalidUniqueId())
			+ GetWitcherPlayer().GetTotalWeaponDamage(item_steel, theGame.params.DAMAGE_NAME_BLUDGEONING, GetInvalidUniqueId());

			dmgValSilver *= 2;

			if (ACSGetCActor('ACS_MountedAttackTarget').UsesVitality()) 
			{ 
				dmg.AddDamage( theGame.params.DAMAGE_NAME_PHYSICAL, 50 + dmgValSilver );
			} 
			else if (ACSGetCActor('ACS_MountedAttackTarget').UsesEssence()) 
			{ 
				dmg.AddDamage( theGame.params.DAMAGE_NAME_SILVER, 50 + dmgValSilver );
			} 
		}
		else if (GetWitcherPlayer().IsWeaponHeld('silversword'))
		{
			dmgValSteel = GetWitcherPlayer().GetTotalWeaponDamage(item_silver, theGame.params.DAMAGE_NAME_SILVER, GetInvalidUniqueId()); 

			dmgValSteel *= 2;

			if (ACSGetCActor('ACS_MountedAttackTarget').UsesVitality()) 
			{ 
				dmg.AddDamage( theGame.params.DAMAGE_NAME_PHYSICAL, 50 + dmgValSteel );
			} 
			else if (ACSGetCActor('ACS_MountedAttackTarget').UsesEssence()) 
			{ 
				dmg.AddDamage( theGame.params.DAMAGE_NAME_SILVER, 50 + dmgValSteel );
			} 
		}

		if (ACSGetCActor('ACS_MountedAttackTarget').GetCurrentHealth() >= ACSGetCActor('ACS_MountedAttackTarget').GetMaxHealth() * 0.5) 
		{ 
			if (ACSGetCActor('ACS_MountedAttackTarget').UsesVitality()) 
			{ 
				dmg.AddDamage( theGame.params.DAMAGE_NAME_PHYSICAL, 50 + ACSGetCActor('ACS_MountedAttackTarget').GetStat( BCS_Vitality ) * 0.25 );
			} 
			else if (ACSGetCActor('ACS_MountedAttackTarget').UsesEssence()) 
			{ 
				dmg.AddDamage( theGame.params.DAMAGE_NAME_SILVER, 50 + ACSGetCActor('ACS_MountedAttackTarget').GetStat( BCS_Essence ) * 0.25 );
			} 
		}
		else
		{
			if (ACSGetCActor('ACS_MountedAttackTarget').UsesVitality()) 
			{ 
				dmg.AddDamage( theGame.params.DAMAGE_NAME_PHYSICAL, 50 + (ACSGetCActor('ACS_MountedAttackTarget').GetStatMax( BCS_Vitality ) - ACSGetCActor('ACS_MountedAttackTarget').GetStat( BCS_Vitality )) * 0.25 );
			} 
			else if (ACSGetCActor('ACS_MountedAttackTarget').UsesEssence()) 
			{ 
				dmg.AddDamage( theGame.params.DAMAGE_NAME_SILVER, 50 + (ACSGetCActor('ACS_MountedAttackTarget').GetStatMax( BCS_Essence ) - ACSGetCActor('ACS_MountedAttackTarget').GetStat( BCS_Essence )) * 0.25 );
			} 
		}

		dmg.AddEffectInfo(EET_Stagger, 3);

		dmg.SetCriticalHit(); theGame.damageMgr.ProcessAction( dmg );
			
		delete dmg;

		
		RemoveTimer('DismountProcess_End');
		AddTimer('DismountProcess_End', 1 , false );
	}

	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	
	var plantedBomb, plantedBombSecondary		: W3Petard;
	
	var detonationTimer							: float;

	var selectedItemId, petard1ID, petard2ID	: SItemUniqueId;
	var thrownEntityPath						: String;
	var petard									: CEntity;

	public function DismountProcess_PlantBomb()
	{

		if (!thePlayer.HasTag('ACS_MountedAttackDismountProcessStart'))
		{
			thePlayer.ACS_ClearAnimationSpeedMultipliers();

			selectedItemId = thePlayer.GetSelectedItemId();

			if(thePlayer.inv.IsItemBomb(selectedItemId))
			{
				thePlayer.inv.SingletonItemRemoveAmmo(selectedItemId, 1);
			}

			detonationTimer = RandRangeF(7,5);

			
			RemoveTimer('DismountProcess_End');

			thePlayer.RaiseEvent('ACS_CombatExtraPlantBomb');

			thePlayer.AddTag('ACS_MountedAttackDismountProcessStart');

			plantedBomb = (W3Petard)theGame.CreateEntity( (CEntityTemplate)LoadResource( 
			"dlc\dlc_acs\data\entities\projectiles\acs_shrapnel_bomb.w2ent"
			, true ), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );

			plantedBomb.Init(thePlayer);

			plantedBomb.CreateAttachment( thePlayer, 'l_weapon' , Vector( 0, 0, 0 ), EulerAngles(0,0,0) );

			plantedBomb.RemoveTimer('ACS_DetonationTimer');
			plantedBomb.AddTimer('ACS_DetonationTimer', detonationTimer , false );

			plantedBomb.PlayEffect('fx_trail');
			plantedBomb.PlayEffect('sparks');

			plantedBomb.PlayEffect('tell');

			//plantedBomb.AddTag('ACS_Mounted_Attack_Bomb');

			petard = (CThrowable)(thePlayer.GetInventory()).GetDeploymentItemEntity( selectedItemId,,,true );

			thrownEntityPath = petard.GetReadableName();

			if (StrContains( thrownEntityPath, "frost" ))
			{
				plantedBomb.AddTag('ACS_Bomb_Add_Frozen');
			}

			if (StrContains( thrownEntityPath, "virus" ))
			{
				plantedBomb.AddTag('ACS_Bomb_Add_Poison');
			}

			if (StrContains( thrownEntityPath, "dancing" ))
			{
				plantedBomb.AddTag('ACS_Bomb_Add_Knockdown');
			}

			if (StrContains( thrownEntityPath, "samum" ))
			{
				plantedBomb.AddTag('ACS_Bomb_Add_Blindness');
			}

			plantedBombSecondary = (W3Petard)theGame.CreateEntity( (CEntityTemplate)LoadResource( 
			thrownEntityPath
			, true ), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );

			plantedBombSecondary.Init(thePlayer);

			plantedBombSecondary.CreateAttachment( thePlayer, 'l_weapon' , Vector( 0, 0, 0 ), EulerAngles(0,0,0) );

			plantedBombSecondary.RemoveTimer('ACS_DetonationTimer');
			plantedBombSecondary.AddTimer('ACS_DetonationTimer', detonationTimer , false );

			plantedBombSecondary.PlayEffect('fx_trail');
			plantedBombSecondary.PlayEffect('sparks');


			RemoveTimer('DismountProcess_BombProcess');
			AddTimer('DismountProcess_BombProcess', 0.5 , false );

			thePlayer.AddTag('ACS_MountedAttackDismountProcessStart');
		}
	}

	private timer function DismountProcess_BombProcess ( dt : float, id : int )
	{
		var bonePosition								: Vector;
		var boneRotation								: EulerAngles;

		plantedBomb.BreakAttachment();

		plantedBombSecondary.BreakAttachment();

		theSound.SoundEvent("gui_inventory_bombs_attach");
		theSound.SoundEvent("gui_inventory_other_attach");

		if ( ACSGetCActor('ACS_MountedAttackTarget').GetBoneIndex('head') != -1 )
		{
			ACSGetCActor('ACS_MountedAttackTarget').GetBoneWorldPositionAndRotationByIndex( ACSGetCActor('ACS_MountedAttackTarget').GetBoneIndex( 'head' ), bonePosition, boneRotation );

			plantedBomb.CreateAttachmentAtBoneWS(ACSGetCActor('ACS_MountedAttackTarget'), 'head', bonePosition, boneRotation);
			plantedBombSecondary.CreateAttachmentAtBoneWS(ACSGetCActor('ACS_MountedAttackTarget'), 'head', bonePosition, boneRotation);
		}
		else
		{
			if ( ACSGetCActor('ACS_MountedAttackTarget').GetBoneIndex('k_head_g') != -1 )
			{
				ACSGetCActor('ACS_MountedAttackTarget').GetBoneWorldPositionAndRotationByIndex( ACSGetCActor('ACS_MountedAttackTarget').GetBoneIndex( 'k_head_g' ), bonePosition, boneRotation );

				plantedBomb.CreateAttachmentAtBoneWS(ACSGetCActor('ACS_MountedAttackTarget'), 'k_head_g', bonePosition, boneRotation);
				plantedBombSecondary.CreateAttachmentAtBoneWS(ACSGetCActor('ACS_MountedAttackTarget'), 'k_head_g', bonePosition, boneRotation);
			}
			else
			{
				plantedBomb.CreateAttachment(ACSGetCActor('ACS_MountedAttackTarget'), 'blood_point', Vector(0,0,0), ACSGetCActor('ACS_MountedAttackTarget').GetWorldRotation());
				plantedBombSecondary.CreateAttachment(ACSGetCActor('ACS_MountedAttackTarget'), 'blood_point', Vector(0,0,0), ACSGetCActor('ACS_MountedAttackTarget').GetWorldRotation());
			}
		}

		ACSGetCActorRemoveTag('ACS_Counter_Wound_Ready');

		ACSGetCEntityDestroyAll('ACS_Counter_Wound'); 
		
		ACSGetCEntityDestroyAll('ACS_Sneaking_Lure');

		((CNewNPC)ACSGetCActor('ACS_MountedAttackTarget')).ACS_ResetPostureImmediate();

		
		RemoveTimer('DismountProcess_End');
		AddTimer('DismountProcess_End', 1 , false );
	}

	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////


	private timer function DismountProcess_End ( dt : float, id : int )
	{
		var pos : Vector;
		var rot : EulerAngles;
		var movementAdjustor : CMovementAdjustor;
		var ticket : SMovementAdjustmentRequestTicket;
		var vehicle 						: W3HorseComponent;
		var horseComp : W3HorseComponent;

		thePlayer.ACS_ClearAnimationSpeedMultipliers();

		RemoveTimer('DismountProcess_Watcher');

		RemoveTimer('DismountProcess_Stab_Damage');

		GetACSStorage().acs_deleteOnelinerByTag("ACS_MountedAttackAttachmentMessage");

		thePlayer.UnblockAction( EIAB_DrawWeapon, 				'ACS_Mounted_Attack');
		thePlayer.UnblockAction( EIAB_Crossbow, 				'ACS_Mounted_Attack');
		thePlayer.UnblockAction( EIAB_Interactions, 			'ACS_Mounted_Attack');
		thePlayer.UnblockAction( EIAB_InteractionAction, 		'ACS_Mounted_Attack');
		thePlayer.UnblockAction( EIAB_UsableItem, 				'ACS_Mounted_Attack');
		thePlayer.UnblockAction( EIAB_Jump, 					'ACS_Mounted_Attack');
		thePlayer.UnblockAction( EIAB_QuickSlots, 				'ACS_Mounted_Attack');
		thePlayer.UnblockAction( EIAB_ThrowBomb, 				'ACS_Mounted_Attack');
		thePlayer.UnblockAction( EIAB_Movement, 				'ACS_Mounted_Attack');
		thePlayer.UnblockAction( EIAB_MountVehicle, 			'ACS_Mounted_Attack');
		thePlayer.UnblockAction( EIAB_DismountVehicle, 			'ACS_Mounted_Attack');

		//thePlayer.RaiseEvent('ACS_SneakAnimEnd');

		//thePlayer.RaiseEvent('ACS_TorsoBendReset');

		thePlayer.RaiseEvent('ACS_CombatExtraReset');

		if (RandF() < 0.5)
		{
			thePlayer.RaiseEvent('ACS_Backflip01');
		}
		else
		{
			thePlayer.RaiseEvent('ACS_Backflip02');
		}

		thePlayer.RaiseEvent('ACS_CombatExtraTW1SilverStrongStart');

		thePlayer.PlayEffectSingle('acs_fast_sprint_trail');
		thePlayer.StopEffect('acs_fast_sprint_trail');

		//GetACSWatcher().HorseLeapStrike();

		thePlayer.ClearCleanupFunction();
		thePlayer.GotoState( 'ACS_DismountHorse', true );

		GetACSWatcher().PlayerPlayAnimation('horse_gallop_get_off');

		thePlayer.RaiseEvent('ACS_TorsoBendReset');

		thePlayer.RaiseEvent('ACS_SneakAnimEnd');

		thePlayer.RemoveTag('ACS_MountedAttackDismountProcessStart');

		disableMount = true;
		
		vehicle = (W3HorseComponent)( ((CNewNPC)this).GetHorseComponent() );

		vehicle.SetMountableByPlayer(false);

		ACS_ExplorationDelayHack(false, 3);

		//rot = ACSGetCActor('ACS_MountedAttackTarget').GetWorldRotation();

		//thePlayer.TeleportWithRotation(TraceFloor(pos) + Vector(0,0,3), rot);

		//rot = thePlayer.GetWorldRotation();

		//rot.Yaw -= 180;

		//thePlayer.TeleportWithRotation(TraceFloor(pos) + Vector(0,0,1.5), rot);

		//ACSGetCActor('ACS_MountedAttackTarget').AddTag('ACS_Enemy_Attacking_From_Behind');

		ACSGetCActor('ACS_MountedAttackTarget').EnableCharacterCollisions(true);

		ACSGetCActor('ACS_MountedAttackTarget').RemoveTag('ACS_NPC_Ready_For_Mounted_Attack_Attachment');
		ACSGetCActor('ACS_MountedAttackTarget').RemoveTag('ACS_MountedAttackTarget');

		this.RemoveTag('ACS_MountedAttackAttachmentActive');

		if (thePlayer.GetPlayerCombatStance() != PCS_AlertNear)
		{
			thePlayer.SetPlayerCombatStance(PCS_AlertNear, true);
			thePlayer.SetPlayerCombatStance(PCS_AlertNear, true);
			thePlayer.SetPlayerCombatStance(PCS_AlertNear, true);
		}

		this.DestroyAfter(1);
	}

	private timer function DismountProcess_Watcher ( dt : float, id : int )
	{
		if (
		!ACSGetCActor('ACS_MountedAttackTarget')	
		|| !ACSGetCActor('ACS_MountedAttackTarget').IsAlive()
		
		)
		{
			
			RemoveTimer('DismountProcess_End');
			AddTimer('DismountProcess_End', 1 , false );

			RemoveTimer('DismountProcess_Watcher');
		}
	}

	event OnDeath( damageAction : W3DamageAction  )
	{

	}

	event OnDestroyed()
	{
		super.OnDestroyed();
	}
}

function ACSGetMountedAttackAttachment(entTag: name) : CACSMountedAttackAttachment
{
	var ent 				 : CACSMountedAttackAttachment;
	
	ent = (CACSMountedAttackAttachment)theGame.GetEntityByTag( entTag );
	return ent;
}

statemachine class CACSGuidingWindEnt extends CNewNPC
{
	var rippleForceEnt 													: CEntity;
	var guidingWindSoundPlaying											: bool;

	event OnSpawned( spawnData : SEntitySpawnData )
	{
		var meshcomp														: CComponent;
		var animcomp 														: CAnimatedComponent;
		var movementAdjustorGuidingWind										: CMovementAdjustor; 
		var ticketGuidingWind 												: SMovementAdjustmentRequestTicket; 
		var targetDistanceQuestMarker 										: float;

		super.OnSpawned( spawnData );

		movementAdjustorGuidingWind = GetMovingAgentComponent().GetMovementAdjustor();
		movementAdjustorGuidingWind.CancelByName( 'ACS_Guiding_Wind_Rotate' );

		movementAdjustorGuidingWind.CancelAll();
		ticketGuidingWind = movementAdjustorGuidingWind.CreateNewRequest( 'ACS_Guiding_Wind_Rotate' );

		movementAdjustorGuidingWind.AdjustmentDuration( ticketGuidingWind, 0.01 );
		movementAdjustorGuidingWind.MaxRotationAdjustmentSpeed( ticketGuidingWind, 500000 );

		if (theGame.GetCommonMapManager().GetUserMapPinCount() == 0)
		{
			movementAdjustorGuidingWind.RotateTowards( ticketGuidingWind, ACSGetCEntity('ACS_Guiding_Light_Marker') );
		}
		else if (theGame.GetCommonMapManager().GetUserMapPinCount() > 0)
		{
			movementAdjustorGuidingWind.RotateTowards( ticketGuidingWind, ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker') );
		}

		EnableCharacterCollisions(false);
		EnableCollisions(false);

		AddBuffImmunity_AllNegative('ACS_Guiding_Wind_Entity', true);

		AddBuffImmunity_AllCritical('ACS_Guiding_Wind_Entity', true);

		SetUnpushableTarget(thePlayer);

		SetImmortalityMode( AIM_Invulnerable, AIC_Combat ); 
		SetCanPlayHitAnim(false); 

		SetTemporaryAttitudeGroup( 'q104_avallach_friendly_to_all', AGP_Default );	

		animcomp = (CAnimatedComponent)this.GetComponentByClassName('CAnimatedComponent');
		meshcomp = (CMeshComponent)this.GetComponentByClassName('CMeshComponent');

		animcomp.SetScale(Vector(0,0,0,0));
		meshcomp.SetScale(Vector(0,0,0,0));

		animcomp.FreezePose();


		rippleForceEnt = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource( 

		"dlc\dlc_acs\data\fx\guiding_wind\guiding_wind_physics.w2ent"

		, true ), this.GetWorldPosition(), this.GetWorldRotation() );




		AddTimer('guiding_wind_particles_can_play', 0.5 , false );


		AddTimer('guiding_wind_teleport', 0.01, true);

		AddTimer('guiding_wind_control', 0.01, true);

		AddTimer('guiding_wind_reset_timer', ACS_Settings_Main_Float('acs_hud_settings_main','acs_guiding_wind_reset_delay', 10) , false );


		this.PushState('ACS_Guiding_Wind_Spawn_Secondary');
		
	}

	event OnTakeDamage( action : W3DamageAction )
	{

	}

	event OnDeath( action : W3DamageAction )
	{

	}

	timer function guiding_wind_teleport( deltaTime : float , id : int)
	{
		var targetZ, currZ											: float;
		var targetPosition, currPosition							: Vector;

		if (theGame.IsFading()
		|| theGame.IsBlackscreen()
		|| theGame.IsDialogOrCutscenePlaying() 
		|| thePlayer.IsInInterior()
		)
		{
			RemoveTimers();

			rippleForceEnt.Destroy();

			this.Destroy();
			
			return;
		}

		rippleForceEnt.TeleportWithRotation(this.GetWorldPosition() + Vector(0,0,5), this.GetWorldRotation());

		if (this.HasTag('ACS_Guiding_Wind_Ent'))
		{
			Teleport( thePlayer.GetWorldPosition() );
		}
		else
		{
			currPosition = TraceFloor(GetWorldPosition());

			if(!thePlayer.IsSwimming() && !thePlayer.IsDiving())
			{
				if (currPosition.Z < theGame.GetWorld().GetWaterLevel(currPosition, true))
				{
					currPosition.Z = theGame.GetWorld().GetWaterLevel(currPosition, true);
				}
			}

			if (theGame.GetCommonMapManager().GetUserMapPinCount() == 0)
			{
				if (!ACS_GetQuestPoint() 
				|| theGame.GetJournalManager().GetTrackedQuest().baseName == "ACS Exploration"
				)
				{
					RemoveTimers();

					rippleForceEnt.Destroy();

					this.Destroy();
					
					return;
				}

				if (VecDistanceSquared2D(this.GetWorldPosition(), ACSGetCEntity('ACS_Guiding_Light_Marker').GetWorldPosition() ) > 6 * 6)
				{
					targetPosition = TraceFloor(ACSGetCEntity('ACS_Guiding_Light_Marker').GetWorldPosition());

					if(!thePlayer.IsSwimming() && !thePlayer.IsDiving())
					{
						if (targetPosition.Z < theGame.GetWorld().GetWaterLevel(targetPosition, true))
						{
							targetPosition.Z = theGame.GetWorld().GetWaterLevel(targetPosition, true);
						}
					}

					this.Teleport( LerpV(currPosition, targetPosition, 0.001) );
				}
				else
				{
					this.Teleport( LerpV(this.GetWorldPosition(), ACSGetCEntity('ACS_Guiding_Light_Marker').GetWorldPosition() + Vector(0,0,-200) , 0.01) );
				}
			}
			else if (theGame.GetCommonMapManager().GetUserMapPinCount() > 0)
			{
				if (VecDistanceSquared2D(this.GetWorldPosition(), ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').GetWorldPosition() ) > 6 * 6)
				{
					targetPosition = TraceFloor(ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').GetWorldPosition());

					if(!thePlayer.IsSwimming() && !thePlayer.IsDiving())
					{
						if (targetPosition.Z < theGame.GetWorld().GetWaterLevel(targetPosition, true))
						{
							targetPosition.Z = theGame.GetWorld().GetWaterLevel(targetPosition, true);
						}
					}

					this.Teleport( LerpV(currPosition, targetPosition, 0.001) );
				}
				else
				{
					this.Teleport( LerpV(this.GetWorldPosition(), ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').GetWorldPosition() + Vector(0,0,-200) , 0.01) );
				}
			}
		}
	}

	var guidingWindParticlesCanPlay											: bool;

	timer function guiding_wind_particles_can_play( deltaTime : float , id : int)
	{
		rippleForceEnt.DestroyEffect('cone_old');

		rippleForceEnt.PlayEffectSingle('cone_old');

		guidingWindParticlesCanPlay = true;
	}

	timer function guiding_wind_control( deltaTime : float , id : int)
	{
		var movementAdjustorGuidingWind																							: CMovementAdjustor; 
		var ticketGuidingWind 																									: SMovementAdjustmentRequestTicket; 
		var targetDistanceQuestMarker 																							: float;

		movementAdjustorGuidingWind = GetMovingAgentComponent().GetMovementAdjustor();
		movementAdjustorGuidingWind.CancelByName( 'ACS_Guiding_Wind_Rotate' );

		movementAdjustorGuidingWind.CancelAll();
		ticketGuidingWind = movementAdjustorGuidingWind.CreateNewRequest( 'ACS_Guiding_Wind_Rotate' );

		movementAdjustorGuidingWind.AdjustmentDuration( ticketGuidingWind, 0.01 );
		movementAdjustorGuidingWind.MaxRotationAdjustmentSpeed( ticketGuidingWind, 500000 );

		if (theGame.GetCommonMapManager().GetUserMapPinCount() == 0)
		{
			movementAdjustorGuidingWind.RotateTowards( ticketGuidingWind, ACSGetCEntity('ACS_Guiding_Light_Marker') );

			targetDistanceQuestMarker = VecDistanceSquared2D( GetWitcherPlayer().GetWorldPosition(), ACSGetCEntity('ACS_Guiding_Light_Marker').GetWorldPosition() );

			if( targetDistanceQuestMarker > 6 * 6
			)
			{
				ParticleSwitch();
			}
		}
		else if (theGame.GetCommonMapManager().GetUserMapPinCount() > 0)
		{
			movementAdjustorGuidingWind.RotateTowards( ticketGuidingWind, ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker') );

			ParticleSwitch();
		}
	}

	function ParticleSwitch()
	{
		if (!guidingWindParticlesCanPlay)
		{
			return;
		}

		if (this.HasTag('ACS_Guiding_Wind_Ent'))
		{
			if (ACS_Settings_Main_Bool('acs_hud_settings_main','acs_guiding_wind_sound_enabled', false))
			{
				if (!guidingWindSoundPlaying)
				{
					this.SoundEvent("wind_sfx_start_acs");

					guidingWindSoundPlaying = true;
				}
			}
		}
		else
		{
			if ( guidingWindSoundPlaying )
			{
				this.SoundEvent("wind_sfx_stop_acs");

				guidingWindSoundPlaying = false;
			}
		}

		switch(ACS_Settings_Main_Int('acs_hud_settings_main','acs_guiding_wind_particle_type', 0) )
		{
			case 1:
				StopEffect('wind');
				StopEffect('wind_less_particles');
				StopEffect('wind_slow');
				StopEffect('wind_slow_less_particles');
				StopEffect('wind_fast');
				StopEffect('wind_fast_less_particles');

				switch(ACS_Settings_Main_Int('acs_hud_settings_main','acs_guiding_wind_particle_amount', 0))
				{
					case 2:
						if (
						IsEffectActive('embers_fast_less_particles', false)
						)
						{
							StopEffect('embers_fast_less_particles');
						}

						if (
							!IsEffectActive('embers_less_particles', false)
						)
						{
							PlayEffectSingle('embers_less_particles');
						}

						if (
							!IsEffectActive('embers_slow_less_particles', false)
						)
						{
							PlayEffectSingle('embers_slow_less_particles');
						}

						if (
							!IsEffectActive('embers_fast', false)
						)
						{
							PlayEffectSingle('embers_fast');
						}
					break;

					case 1:
						if (
						IsEffectActive('embers_slow_less_particles', false)
						)
						{
							StopEffect('embers_slow_less_particles');
						}

						if (
							!IsEffectActive('embers_less_particles', false)
						)
						{
							PlayEffectSingle('embers_less_particles');
						}

						if (
							!IsEffectActive('embers_fast', false)
						)
						{
							PlayEffectSingle('embers_fast_less_particles');
						}
					break;

					case 0:
						if (
							IsEffectActive('embers_fast', false)
						)
						{
							StopEffect('embers_fast');
						}

						if (
							IsEffectActive('embers_slow_less_particles', false)
						)
						{
							StopEffect('embers_slow_less_particles');
						}

						if (
							IsEffectActive('embers_less_particles', false)
						)
						{
							StopEffect('embers_less_particles');
						}

						if (
							!IsEffectActive('embers_fast_less_particles', false)
						)
						{
							PlayEffectSingle('embers_fast_less_particles');
						}
					break;

					default:
						if (
						IsEffectActive('embers_fast_less_particles', false)
						)
						{
							StopEffect('embers_fast_less_particles');
						}

						if (
							!IsEffectActive('embers_less_particles', false)
						)
						{
							PlayEffectSingle('embers_less_particles');
						}

						if (
							!IsEffectActive('embers_slow_less_particles', false)
						)
						{
							PlayEffectSingle('embers_slow_less_particles');
						}

						if (
							!IsEffectActive('embers_fast', false)
						)
						{
							PlayEffectSingle('embers_fast');
						}
					break;
				}
			break;

			case 0:
				StopEffect('embers');
				StopEffect('embers_less_particles');
				StopEffect('embers_slow');
				StopEffect('embers_slow_less_particles');
				StopEffect('embers_fast');
				StopEffect('embers_fast_less_particles');

				switch(ACS_Settings_Main_Int('acs_hud_settings_main','acs_guiding_wind_particle_amount', 0))
				{
					case 2:
						if (
						IsEffectActive('wind_fast_less_particles', false)
						)
						{
							StopEffect('wind_fast_less_particles');
						}

						if (
							!IsEffectActive('wind_less_particles', false)
						)
						{
							PlayEffectSingle('wind_less_particles');
						}

						if (
							!IsEffectActive('wind_slow_less_particles', false)
						)
						{
							PlayEffectSingle('wind_slow_less_particles');
						}

						if (
							!IsEffectActive('wind_fast', false)
						)
						{
							PlayEffectSingle('wind_fast');
						}
					break;

					case 1:
						if (
						IsEffectActive('wind_slow_less_particles', false)
						)
						{
							StopEffect('wind_slow_less_particles');
						}

						if (
							!IsEffectActive('wind_less_particles', false)
						)
						{
							PlayEffectSingle('wind_less_particles');
						}

						if (
							!IsEffectActive('wind_fast_less_particles', false)
						)
						{
							PlayEffectSingle('wind_fast_less_particles');
						}
					break;

					case 0:
						if (
						IsEffectActive('wind_fast', false)
						)
						{
							StopEffect('wind_fast');
						}

						if (
							IsEffectActive('wind_slow_less_particles', false)
						)
						{
							StopEffect('wind_slow_less_particles');
						}

						if (
							IsEffectActive('wind_less_particles', false)
						)
						{
							StopEffect('wind_less_particles');
						}

						if (
							!IsEffectActive('wind_fast_less_particles', false)
						)
						{
							PlayEffectSingle('wind_fast_less_particles');
						}
					break;

					default:
						if (
						IsEffectActive('wind_fast', false)
						)
						{
							StopEffect('wind_fast');
						}

						if (
							IsEffectActive('wind_slow_less_particles', false)
						)
						{
							StopEffect('wind_slow_less_particles');
						}

						if (
							IsEffectActive('wind_less_particles', false)
						)
						{
							StopEffect('wind_less_particles');
						}

						if (
							!IsEffectActive('wind_fast_less_particles', false)
						)
						{
							PlayEffectSingle('wind_fast_less_particles');
						}
					break;
				}
			break;

			default:
				StopEffect('embers');
				StopEffect('embers_less_particles');
				StopEffect('embers_slow');
				StopEffect('embers_slow_less_particles');
				StopEffect('embers_fast');
				StopEffect('embers_fast_less_particles');

				switch(ACS_Settings_Main_Int('acs_hud_settings_main','acs_guiding_wind_particle_amount', 0))
				{
					case 2:
						if (
						IsEffectActive('wind_fast_less_particles', false)
						)
						{
							StopEffect('wind_fast_less_particles');
						}

						if (
							!IsEffectActive('wind_less_particles', false)
						)
						{
							PlayEffectSingle('wind_less_particles');
						}

						if (
							!IsEffectActive('wind_slow_less_particles', false)
						)
						{
							PlayEffectSingle('wind_slow_less_particles');
						}

						if (
							!IsEffectActive('wind_fast', false)
						)
						{
							PlayEffectSingle('wind_fast');
						}
					break;

					case 1:
						if (
						IsEffectActive('wind_slow_less_particles', false)
						)
						{
							StopEffect('wind_slow_less_particles');
						}

						if (
							!IsEffectActive('wind_less_particles', false)
						)
						{
							PlayEffectSingle('wind_less_particles');
						}

						if (
							!IsEffectActive('wind_fast_less_particles', false)
						)
						{
							PlayEffectSingle('wind_fast_less_particles');
						}
					break;

					case 0:
						if (
						IsEffectActive('wind_fast', false)
						)
						{
							StopEffect('wind_fast');
						}

						if (
							IsEffectActive('wind_slow_less_particles', false)
						)
						{
							StopEffect('wind_slow_less_particles');
						}

						if (
							IsEffectActive('wind_less_particles', false)
						)
						{
							StopEffect('wind_less_particles');
						}

						if (
							!IsEffectActive('wind_fast_less_particles', false)
						)
						{
							PlayEffectSingle('wind_fast_less_particles');
						}
					break;

					default:
						if (
						IsEffectActive('wind_fast', false)
						)
						{
							StopEffect('wind_fast');
						}

						if (
							IsEffectActive('wind_slow_less_particles', false)
						)
						{
							StopEffect('wind_slow_less_particles');
						}

						if (
							IsEffectActive('wind_less_particles', false)
						)
						{
							StopEffect('wind_less_particles');
						}

						if (
							!IsEffectActive('wind_fast_less_particles', false)
						)
						{
							PlayEffectSingle('wind_fast_less_particles');
						}
					break;
				}
			break;
		}

		if (theGame.GetEngineTimeAsSeconds() - last_physics_activate > 0.125)
		{
			last_physics_activate = theGame.GetEngineTimeAsSeconds();

			rippleForceEnt.DestroyEffect('physics');

			rippleForceEnt.PlayEffectSingle('physics');
		}
	}

	var last_physics_activate : float;

	timer function guiding_wind_reset_timer( deltaTime : float , id : int)
	{	
		guiding_wind_reset();
	}

	function guiding_wind_reset()
	{
		this.RemoveTag('ACS_Guiding_Wind_Ent');

		rippleForceEnt.DestroyAfter(60);

		this.DestroyAfter(60);

		if ( guidingWindSoundPlaying )
		{
			this.SoundEvent("wind_sfx_stop_acs");

			guidingWindSoundPlaying = false;
		}
	}
}

state ACS_Guiding_Wind_Spawn_Secondary in CACSGuidingWindEnt
{
	private var temp															: CEntityTemplate;
	private var entPrimary, ent													: CEntity;
	private var i, count														: int;
	private var playerPos, spawnPos												: Vector;
	private var playerRot														: EulerAngles;

	event OnEnterState(prevStateName : name)
	{
		ACS_Guiding_Wind_Spawn_Secondary_Entry();
	}

	entry function ACS_Guiding_Wind_Spawn_Secondary_Entry()
	{
		while (true) 
		{
			ACS_Guiding_Wind_Spawn_Secondary_Latent();

			Sleep(RandRangeF(1,0.5));
    	}
	}
	
	latent function ACS_Guiding_Wind_Spawn_Secondary_Latent()
	{
		if (!parent.HasTag('ACS_Guiding_Wind_Ent'))
		{
			return;
		}

		temp = (CEntityTemplate)LoadResourceAsync( 

		"dlc\dlc_acs\data\entities\other\guiding_wind_ent_secondary.w2ent"
			
		, true );

		playerPos = TraceFloor(parent.GetWorldPosition() + parent.GetWorldForward() * -16);

		playerRot = parent.GetWorldRotation();

		entPrimary = theGame.CreateEntity( temp, TraceFloor(playerPos + parent.GetWorldRight() * RandRangeF(5,-5)), playerRot );

		entPrimary.AddTag('ACS_Guiding_Wind_Ent_Secondary');

		switch(ACS_Settings_Main_Int('acs_hud_settings_main','acs_guiding_wind_particle_amount', 0))
		{
			case 2:
				count = RandRange(8,6);
			break;

			case 1:
				count = RandRange(6,4);
			break;

			case 0:
				count = RandRange(4,2);
			break;

			default:
				count = RandRange(4,2);
			break;
		}
			
		for( i = 0; i < count; i += 1 )
		{
			spawnPos.X = playerPos.X + RandRangeF(15,-15);
			spawnPos.Y = playerPos.Y;
			spawnPos.Z = playerPos.Z;

			ent = theGame.CreateEntity( temp, TraceFloor(spawnPos), playerRot );

			ent.AddTag('ACS_Guiding_Wind_Ent_Secondary');

			SleepOneFrame();
		}
	}


}

statemachine class CACSGuidingWindEntSecondary extends CNewNPC
{
	var trail_ent                  										: CEntity;
	var rippleForceEnt 													: CEntity;
	var speed															: float;

	event OnSpawned( spawnData : SEntitySpawnData )
	{
		var meshcomp														: CComponent;
		var animcomp 														: CAnimatedComponent;
	
		super.OnSpawned( spawnData );

		EnableCharacterCollisions(false);
		EnableCollisions(false);

		AddBuffImmunity_AllNegative('ACS_Guiding_Wind_Entity', true);

		AddBuffImmunity_AllCritical('ACS_Guiding_Wind_Entity', true);

		SetImmortalityMode( AIM_Invulnerable, AIC_Combat ); 
		SetCanPlayHitAnim(false); 

		SetTemporaryAttitudeGroup( 'q104_avallach_friendly_to_all', AGP_Default );	

		animcomp = (CAnimatedComponent)this.GetComponentByClassName('CAnimatedComponent');
		meshcomp = (CMeshComponent)this.GetComponentByClassName('CMeshComponent');

		animcomp.SetScale(Vector(0,0,0,0));
		meshcomp.SetScale(Vector(0,0,0,0));

		animcomp.FreezePose();



		trail_ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

		"dlc\dlc_acs\data\fx\body_trail.w2ent"

		, true ), GetWitcherPlayer().GetWorldPosition(), GetWitcherPlayer().GetWorldRotation() );

		trail_ent.CreateAttachment(this, , Vector(RandRangeF(3,-3),RandRangeF(3,-3),RandRangeF(5,0.5)) );

		if (ACS_Settings_Main_Int('acs_hud_settings_main','acs_guiding_wind_particle_type', 0) == 0 )
		{
			switch(ACS_Settings_Main_Int('acs_hud_settings_main','acs_guiding_wind_particle_amount', 0))
			{
				case 2:
					trail_ent.PlayEffect('trails_white');

					trail_ent.PlayEffect('trails_white');

					trail_ent.PlayEffect('trails_white');
				break;

				case 1:
					trail_ent.PlayEffect('trails_white');

					trail_ent.PlayEffect('trails_white');
				break;

				case 0:
					trail_ent.PlayEffect('trails_white');
				break;

				default:
					trail_ent.PlayEffect('trails_white');
				break;
			}
		}
		else
		{
			switch(ACS_Settings_Main_Int('acs_hud_settings_main','acs_guiding_wind_particle_amount', 0))
			{
				case 2:
					trail_ent.PlayEffect('trails_red');

					trail_ent.PlayEffect('trails_red');

					trail_ent.PlayEffect('trails_red');
				break;

				case 1:
					trail_ent.PlayEffect('trails_red');

					trail_ent.PlayEffect('trails_red');
				break;

				case 0:
					trail_ent.PlayEffect('trails_red');
				break;

				default:
					trail_ent.PlayEffect('trails_red');
				break;
			}
		}

		rippleForceEnt = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource( 

		"dlc\dlc_acs\data\fx\guiding_wind\guiding_wind_physics.w2ent"

		, true ), this.GetWorldPosition(), this.GetWorldRotation() );


		speed = RandRangeF(0.00125, 0.001);


		AddTimer('guiding_wind_secondary_loop', 0.0001, true);
	}

	event OnTakeDamage( action : W3DamageAction )
	{

	}

	event OnDeath( action : W3DamageAction )
	{

	}

	var last_physics_activate : float;

	timer function guiding_wind_secondary_loop ( dt : float, id : int)
	{
		var targetZ, currZ											: float;
		var targetPosition, currPosition							: Vector;

		if (
		theGame.IsFading()
		|| theGame.IsBlackscreen()
		|| theGame.IsDialogOrCutscenePlaying() 
		|| thePlayer.IsInInterior()
		|| this.IsInInterior())
		{
			trail_ent.Destroy();

			rippleForceEnt.Destroy();

			this.Destroy();

			return;
		}

		rippleForceEnt.TeleportWithRotation(this.GetWorldPosition() + Vector(0,0,0), this.GetWorldRotation());

		if (theGame.GetEngineTimeAsSeconds() - last_physics_activate > 1)
		{
			last_physics_activate = theGame.GetEngineTimeAsSeconds();

			//rippleForceEnt.DestroyEffect('physics');

			//rippleForceEnt.PlayEffectSingle('physics');
		}

		currPosition = TraceFloor(GetWorldPosition());

		if(!thePlayer.IsSwimming() && !thePlayer.IsDiving())
		{
			if (currPosition.Z < theGame.GetWorld().GetWaterLevel(currPosition, true))
			{
				currPosition.Z = theGame.GetWorld().GetWaterLevel(currPosition, true);
			}
		}

		if (theGame.GetCommonMapManager().GetUserMapPinCount() == 0)
		{
			if (VecDistanceSquared2D(this.GetWorldPosition(), ACSGetCEntity('ACS_Guiding_Light_Marker').GetWorldPosition() ) > 6 * 6)
			{
				targetPosition = TraceFloor(ACSGetCEntity('ACS_Guiding_Light_Marker').GetWorldPosition());

				if(!thePlayer.IsSwimming() && !thePlayer.IsDiving())
				{
					if (targetPosition.Z < theGame.GetWorld().GetWaterLevel(targetPosition, true))
					{
						targetPosition.Z = theGame.GetWorld().GetWaterLevel(targetPosition, true);
					}
				}

				this.Teleport( LerpV(currPosition, targetPosition ,speed) );
			}
			else
			{
				RemoveTimer( 'guiding_wind_secondary_loop' );

				rippleForceEnt.Destroy();

				trail_ent.Destroy();

				this.Destroy();
			}
		}
		else if (theGame.GetCommonMapManager().GetUserMapPinCount() > 0)
		{
			if (VecDistanceSquared2D(this.GetWorldPosition(), ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').GetWorldPosition() ) > 6 * 6)
			{
				targetPosition = TraceFloor(ACSGetCEntity('ACS_Guiding_Light_User_Pin_Marker').GetWorldPosition());

				if(!thePlayer.IsSwimming() && !thePlayer.IsDiving())
				{
					if (targetPosition.Z < theGame.GetWorld().GetWaterLevel(targetPosition, true))
					{
						targetPosition.Z = theGame.GetWorld().GetWaterLevel(targetPosition, true);
					}
				}


				this.Teleport( LerpV(currPosition, targetPosition ,speed) );
			}
			else
			{
				RemoveTimer( 'guiding_wind_secondary_loop' );

				rippleForceEnt.Destroy();

				trail_ent.Destroy();

				this.Destroy();
			}
		}
	}
}

function ACSGetGuidingWindEnt(entTag: name) : CACSGuidingWindEnt
{
	var ent 				 : CACSGuidingWindEnt;
	
	ent = (CACSGuidingWindEnt)theGame.GetEntityByTag( entTag );
	return ent;
}


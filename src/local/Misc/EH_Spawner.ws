		ACS_Oneliner(iconPath_health, focus_indicator_ent_02, "ACS_Adrenaline_Bar_02_Max_Indicator", Vector(0,0,-0.125)).run_indicator('player_focus_bar_66_max_indicator');


		ACS_Oneliner(iconPath_health, focus_indicator_ent_03, "ACS_Adrenaline_Bar_03_Max_Indicator", Vector(0,0,-0.1875)).run_indicator('player_focus_bar_99_max_indicator');



		//////////////////////////////////////////////////////////////////////////////


		ACS_Oneliner(iconPath_adrenaline, focus_indicator_ent_01, "ACS_Adrenaline_Bar_01_Indicator", Vector(0,0,-0.0625)).run_indicator('player_focus_bar_33');


		ACS_Oneliner(iconPath_adrenaline, focus_indicator_ent_02, "ACS_Adrenaline_Bar_02_Indicator", Vector(0,0,-0.125)).run_indicator('player_focus_bar_66');


		ACS_Oneliner(iconPath_adrenaline, focus_indicator_ent_03, "ACS_Adrenaline_Bar_03_Indicator", Vector(0,0,-0.1875)).run_indicator('player_focus_bar_99');
	}

	function CreateMedallion()
	{
		var iconPath_background_bar																																											: String;
		var iconPath_health, iconPath_stamina, iconPath_toxicity, iconPath_posture, iconPath_greyhealth, iconPath_adrenaline																				: String;
		var iconPath_medallion, iconPath_medallion_red_glow, iconPath_medallion_red_glow_background, iconPath_medallion_chain, iconPath_medallion_chain_left, iconPath_medallion_chain_right 				: String;
		var anchor_point, anchor_point_01, anchor_point_02																																					: Vector;
		var bone_vec																																														: Vector;
		var bone_rot																																														: EulerAngles;
		var targetDistance 																																													: float;
		var cam_directionX																																													: float;
		var hud									        																																					: CR4ScriptedHud;
   		var screenMarginX 					  																																								: float; 
   		var screenMarginY 					  																																								: float = 0.000000000125; 
    	var currentWidth, currentHeight 																																									: int;
		var ratio, medallion_chain_x_size                      																																				: float;

		alpha = 100;

		GetACSStorage().acs_deleteOnelinerByTag("ACS_Wolf_Head_Medallion_Chain_Left");

		GetACSStorage().acs_deleteOnelinerByTag("ACS_Wolf_Head_Medallion_Chain_Right");

		GetACSStorage().acs_deleteOnelinerByTag("ACS_Wolf_Head_Medallion");

		GetACSStorage().acs_deleteOnelinerByTag("ACS_Wolf_Head_Medallion_Red_Glow");

		GetACSStorage().acs_deleteOnelinerByTag("ACS_Wolf_Head_Medallion_Back_Glow");


		iconPath_medallion = "<img src='img://" + "icons/inventory/acs_wolf_head_medallion_no_glow_128.xbm" + "' vspace='" + (7) + "' />&nbsp;";

		iconPath_medallion_red_glow = "<img src='img://" + "icons/inventory/acs_wolf_head_medallion_128.xbm" + "' vspace='" + (7) + "' />&nbsp;";

		iconPath_medallion_red_glow_background = "<img src='img://" + "icons/inventory/acs_wolf_head_medallion_glow_128.xbm" + "' vspace='" + (7) + "' />&nbsp;";

		//iconPath_medallion_chain = "<img src='img://" + "icons/inventory/acs_wolf_head_medallion_chain.xbm" + "' vspace='" + (7) + "' />&nbsp;";

		//iconPath_medallion_chain = "<img src='img://" + "icons/inventory/acs_wolf_head_medallion_chain_alt.xbm" + "' vspace='" + (7) + "' />&nbsp;";

		//iconPath_medallion_chain = "<img src='img://" + "icons/inventory/acs_wolf_head_medallion_chain_tangle.xbm" + "' vspace='" + (7) + "' />&nbsp;";

		iconPath_medallion_chain_left = "<img src='img://" + "icons/inventory/acs_wolf_head_medallion_chain_alt_left_03.xbm" + "' vspace='" + (7) + "' />&nbsp;";

		iconPath_medallion_chain_right = "<img src='img://" + "icons/inventory/acs_wolf_head_medallion_chain_alt_right_03.xbm" + "' vspace='" + (7) + "' />&nbsp;";

		//acs_wolf_head_medallion_chain

		//acs_wolf_head_medallion_no_glow_128
		//acs_wolf_head_medallion_glow_128
		//acs_wolf_head_medallion_no_glow_transparent_eye_128

		ACS_Oneliner(
		iconPath_medallion_red_glow_background
		, 
		, 
		"ACS_Wolf_Head_Medallion_Back_Glow"
		, 
		, 
		,
		,
		,
		,
		,
		,true,Vector(0.0575, 0.15)).run_indicator('wolf_head_back_glow_indicator');

		GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Wolf_Head_Medallion_Back_Glow", 0);

		GetACSStorage().acs_setScaleForOnelinerByTag("ACS_Wolf_Head_Medallion_Back_Glow", 62.5, 62.5, 62.5);

		ACS_Oneliner(
		iconPath_medallion_chain_left
		, 
		, 
		"ACS_Wolf_Head_Medallion_Chain_Left"
		, 
		, 
		,
		,
		,
		,
		,

		,true,Vector(0.03, 0.0855));

		theGame.GetCurrentViewportResolution( currentWidth, currentHeight );

		ratio = ( (float)currentWidth ) / currentHeight;

		if ( AbsF( ratio - 21.0 / 9.0 ) < 0.06 )
		{
			medallion_chain_x_size = 118.75;
		}
		else
		{
			medallion_chain_x_size = 87.5;
		}

		GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Wolf_Head_Medallion_Chain_Left", 100);

		GetACSStorage().acs_setScaleForOnelinerByTag("ACS_Wolf_Head_Medallion_Chain_Left", medallion_chain_x_size, 75, 75);


			ACS_Oneliner(
			iconPath_medallion
			, 
			, 
			"ACS_Wolf_Head_Medallion"
			, 
			, 
			,
			,
			,
			,
			,
			,true,Vector(0.0575, 0.15)).run_indicator('wolf_head_indicator');

			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Wolf_Head_Medallion", 100);

			GetACSStorage().acs_setScaleForOnelinerByTag("ACS_Wolf_Head_Medallion", 62.5, 62.5, 62.5);




			ACS_Oneliner(
			iconPath_medallion_red_glow
			, 
			, 
			"ACS_Wolf_Head_Medallion_Red_Glow"
			, 
			, 
			,
			,
			,
			,
			,
			,true,Vector(0.0575, 0.15)).run_indicator('wolf_head_eyes_glow_indicator');

			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Wolf_Head_Medallion_Red_Glow", 100);

			GetACSStorage().acs_setScaleForOnelinerByTag("ACS_Wolf_Head_Medallion_Red_Glow", 62.5, 62.5, 62.5);

		ACS_Oneliner(
		iconPath_medallion_chain_right
		, 
		, 
		"ACS_Wolf_Head_Medallion_Chain_Right"
		, 
		, 
		,
		,
		,
		,
		,

		,true,Vector(0.0875, 0.0855));

		GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Wolf_Head_Medallion_Chain_Right", 100);

		GetACSStorage().acs_setScaleForOnelinerByTag("ACS_Wolf_Head_Medallion_Chain_Right", medallion_chain_x_size, 75, 75);
	}

	timer function RadialMenuFix( delta : float , id : int)
	{
		var hud								    																							: CR4ScriptedHud;
		var moduleRadial																													: CR4HudModuleRadialMenu;

		hud = (CR4ScriptedHud)theGame.GetHud();

		if ( hud )
		{
			moduleRadial = (CR4HudModuleRadialMenu)hud.GetHudModule("RadialMenuModule");
			moduleRadial.HideRadialMenu();
		}
	}

	timer function SignIndicatorDespawnDelay( delta : float , id : int)
	{
		if (indicator_active)
		{
			GetACSStorage().acs_deleteOnelinerByTag("ACS_Health_Background_Bar_Indicator");

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Stamina_Background_Bar_Indicator");

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Toxicity_Background_Bar_Indicator");

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Player_Posture_Background_Bar_Indicator");

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Health_Bar_Indicator");

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Grey_Health_Bar_Indicator");

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Stamina_Bar_Indicator");

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Toxicity_Bar_Indicator");

			//GetACSStorage().acs_deleteOnelinerByTag("ACS_Player_Posture_Bar_Indicator");

			//GetACSStorage().acs_deleteOnelinerByTag("ACS_Player_Posture_Bar_Max_Indicator");

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Wolf_Head_Medallion_Red_Glow");

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Wolf_Head_Medallion_Back_Glow");

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Adrenaline_Background_Bar_01_Indicator");

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Adrenaline_Background_Bar_02_Indicator");

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Adrenaline_Background_Bar_03_Indicator");

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Adrenaline_Bar_01_Max_Indicator");

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Adrenaline_Bar_02_Max_Indicator");

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Adrenaline_Bar_03_Max_Indicator");

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Adrenaline_Bar_01_Indicator");

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Adrenaline_Bar_02_Indicator");

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Adrenaline_Bar_03_Indicator");

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Sign_Indicator_Dimmed");

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Sign_Indicator_Available");

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Sign_Indicator_Activated");

			if (sign_indicator_string != "NULL")
			{
				sign_indicator_string = "NULL";
			}

			alpha = 100;

			anchor_ent.BreakAttachment();

			anchor_ent.CreateAttachment(this,, Vector(0,0,0));

			if (indicator_combat_check)
			{
				indicator_progress = 0.0001;

				indicator_combat_check = false;
			}

			indicator_active = false;
		}
	}

	timer function MedallionDespawnDelay( delta : float , id : int)
	{
		if (indicator_medallion_active)
		{
			GetACSStorage().acs_deleteOnelinerByTag("ACS_Wolf_Head_Medallion_Red_Glow");

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Wolf_Head_Medallion_Back_Glow");

			alpha = 100;

			RemoveTimer('FadeOutOneliners');
			AddTimer('FadeOutOneliners', 0.01, true);

			indicator_medallion_active = false;
		}
	}

	var alpha : float;

	default alpha = 100;

	timer function FadeOutOneliners( delta : float , id : int)
	{
		if (alpha <= 0)
		{
			GetACSStorage().acs_deleteOnelinerByTag("ACS_Wolf_Head_Medallion");

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Wolf_Head_Medallion_Chain_Left");

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Wolf_Head_Medallion_Chain_Right");

			RemoveTimer('FadeOutOneliners');
		}
		else
		{
			alpha -= 1;

			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Wolf_Head_Medallion" , alpha);

			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Wolf_Head_Medallion_Chain_Left" , alpha);

			GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Wolf_Head_Medallion_Chain_Right" , alpha);
		}
	}
}

state W3ACSSignIndicatorIdle in W3ACSSignIndicator 
{

}

state W3ACSSignIndicatorEntitySpawns in W3ACSSignIndicator 
{
	var anchor_ent, sign_indicator_ent, focus_indicator_ent_01, focus_indicator_ent_02, focus_indicator_ent_03, health_stat_indicator_ent, stamina_stat_indicator_ent, toxicity_stat_indicator_ent /*, posture_stat_indicator_ent*/         : CEntity;

	event OnEnterState(previous_state_name: name) 
	{
    	super.OnEnterState(previous_state_name);

		SpawnEnts();
	}

	entry function SpawnEnts()
	{
		var attach_rot                        						 	: EulerAngles;
    	var attach_vec													: Vector;


		anchor_ent = theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync( 

		"dlc\dlc_acs\data\fx\sign_indicator_fx.w2ent"

		, true ), parent.GetWorldPosition(), parent.GetWorldRotation() );

		SleepOneFrame();

		sign_indicator_ent = theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync( 

		"dlc\dlc_acs\data\fx\sign_indicator_fx.w2ent"

		, true ), parent.GetWorldPosition(), parent.GetWorldRotation() );

		sign_indicator_ent.AddTag('ACS_Current_Sign_Indicator');

		sign_indicator_ent.AddTag('ACS_HUD_Marker_Entity');

		SleepOneFrame();

		focus_indicator_ent_01 = theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync( 

		"dlc\dlc_acs\data\fx\sign_indicator_fx.w2ent"

		, true ), parent.GetWorldPosition(), parent.GetWorldRotation() );

		focus_indicator_ent_01.AddTag('ACS_Adrenaline_Indicator');

		focus_indicator_ent_01.AddTag('ACS_HUD_Marker_Entity');

		SleepOneFrame();

		focus_indicator_ent_02 = theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync( 

		"dlc\dlc_acs\data\fx\sign_indicator_fx.w2ent"

		, true ), parent.GetWorldPosition(), parent.GetWorldRotation() );

		focus_indicator_ent_02.AddTag('ACS_Adrenaline_Indicator');

		focus_indicator_ent_02.AddTag('ACS_HUD_Marker_Entity');

		SleepOneFrame();

		focus_indicator_ent_03 = theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync( 

		"dlc\dlc_acs\data\fx\sign_indicator_fx.w2ent"

		, true ), parent.GetWorldPosition(), parent.GetWorldRotation() );

		focus_indicator_ent_03.AddTag('ACS_Adrenaline_Indicator');

		focus_indicator_ent_03.AddTag('ACS_HUD_Marker_Entity');

		SleepOneFrame();

		health_stat_indicator_ent = theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync( 

		"dlc\dlc_acs\data\fx\sign_indicator_fx.w2ent"

		, true ), parent.GetWorldPosition(), parent.GetWorldRotation() );

		health_stat_indicator_ent.AddTag('ACS_Health_Stat_Indicator');

		health_stat_indicator_ent.AddTag('ACS_HUD_Marker_Entity');

		SleepOneFrame();

		stamina_stat_indicator_ent = theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync( 

		"dlc\dlc_acs\data\fx\sign_indicator_fx.w2ent"

		, true ), parent.GetWorldPosition(), parent.GetWorldRotation() );

		stamina_stat_indicator_ent.AddTag('ACS_Stamina_Stat_Indicator');

		stamina_stat_indicator_ent.AddTag('ACS_HUD_Marker_Entity');

		SleepOneFrame();

		toxicity_stat_indicator_ent = theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync( 

		"dlc\dlc_acs\data\fx\sign_indicator_fx.w2ent"

		, true ), parent.GetWorldPosition(), parent.GetWorldRotation() );

		toxicity_stat_indicator_ent.AddTag('ACS_Toxicity_Stat_Indicator');

		toxicity_stat_indicator_ent.AddTag('ACS_HUD_Marker_Entity');

		SleepOneFrame();

		//posture_stat_indicator_ent = theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync( 

		//"dlc\dlc_acs\data\fx\sign_indicator_fx.w2ent"

		//, true ), parent.GetWorldPosition(), parent.GetWorldRotation() );

		//posture_stat_indicator_ent.AddTag('ACS_Posture_Stat_Indicator');

		//posture_stat_indicator_ent.AddTag('ACS_HUD_Marker_Entity');

		///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

		anchor_ent.CreateAttachment(parent,, Vector(0,0,0));

		///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

		attach_rot.Roll = 0;
		attach_rot.Pitch = 0;
		attach_rot.Yaw = 0;
		attach_vec.X = -0.625;
		attach_vec.Y = 0;
		attach_vec.Z = -0.125;


		sign_indicator_ent.CreateAttachment(anchor_ent, , attach_vec, attach_rot );

		///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

		attach_rot.Roll = 0;
		attach_rot.Pitch = 0;
		attach_rot.Yaw = 0;
		attach_vec.X = -0.8;
		attach_vec.Y = 0;
		attach_vec.Z = -0.275;

		focus_indicator_ent_01.CreateAttachment( anchor_ent, , attach_vec, attach_rot );

		///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
		
		attach_rot.Roll = 0;
		attach_rot.Pitch = 0;
		attach_rot.Yaw = 0;
		attach_vec.X = -0.8;
		attach_vec.Y = 0;
		attach_vec.Z = -0.375;

		focus_indicator_ent_02.CreateAttachment( anchor_ent, , attach_vec, attach_rot );

		///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

		attach_rot.Roll = 0;
		attach_rot.Pitch = 0;
		attach_rot.Yaw = 0;
		attach_vec.X = -0.8;
		attach_vec.Y = 0;
		attach_vec.Z = -0.475;

		focus_indicator_ent_03.CreateAttachment( anchor_ent, , attach_vec, attach_rot );

		///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

		attach_rot.Roll = 0;
		attach_rot.Pitch = 0;
		attach_rot.Yaw = 0;
		attach_vec.X = -0.9375;
		attach_vec.Y = 0;
		attach_vec.Z = 0.28125;

		health_stat_indicator_ent.CreateAttachment( anchor_ent, , attach_vec, attach_rot );

		///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

		attach_rot.Roll = 0;
		attach_rot.Pitch = 0;
		attach_rot.Yaw = 0;
		attach_vec.X = -0.875;
		attach_vec.Y = 0;
		attach_vec.Z = 0.140625;

		stamina_stat_indicator_ent.CreateAttachment( anchor_ent, , attach_vec, attach_rot );

		///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

		attach_rot.Roll = 0;
		attach_rot.Pitch = 0;
		attach_rot.Yaw = 0;
		attach_vec.X = -0.8125;
		attach_vec.Y = 0;
		attach_vec.Z = 0;

		toxicity_stat_indicator_ent.CreateAttachment( anchor_ent, , attach_vec, attach_rot );

		///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

		/*
		attach_rot.Roll = 0;
		attach_rot.Pitch = 0;
		attach_rot.Yaw = 0;
		attach_vec.X = -0.8125;
		attach_vec.Y = 0;
		attach_vec.Z = 0.09375;
		*/

		//posture_stat_indicator_ent.CreateAttachment( anchor_ent, , attach_vec, attach_rot );

		///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

		parent.anchor_ent = anchor_ent;
		parent.sign_indicator_ent = sign_indicator_ent;
		parent.focus_indicator_ent_01 = focus_indicator_ent_01;
		parent.focus_indicator_ent_02 = focus_indicator_ent_02;
		parent.focus_indicator_ent_03 = focus_indicator_ent_03;
		parent.health_stat_indicator_ent = health_stat_indicator_ent;
		parent.stamina_stat_indicator_ent = stamina_stat_indicator_ent;
		parent.toxicity_stat_indicator_ent = toxicity_stat_indicator_ent;
		//parent.posture_stat_indicator_ent = posture_stat_indicator_ent;

		parent.AddTimer('SignIndicatorLoop', 0.001, true);

		GotoState('W3ACSSignIndicatorIdle');
	}

	event OnLeaveState( nextStateName : name )
	{
		super.OnLeaveState(nextStateName);
	}
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////


statemachine class cACS_CreateSwordDummies
{
    function ACS_CreateSteelSwordDummy( fast : bool )
	{
		if (fast)
		{
			this.PushState('ACS_CreateSteelSwordDummyFast');
		}
		else
		{
			this.PushState('ACS_CreateSteelSwordDummy');
		}
		
	}

	function ACS_CreateSilverSwordDummy( fast : bool )
	{
		if (fast)
		{
			this.PushState('ACS_CreateSilverSwordDummyFast');
		}
		else
		{
			this.PushState('ACS_CreateSilverSwordDummy');
		}
	}
}

state ACS_CreateSteelSwordDummyFast in cACS_CreateSwordDummies
{	
	event OnEnterState(prevStateName : name)
	{
		CreateSteelSwordDummyFast();
	}
	
	entry function CreateSteelSwordDummyFast()
	{
		var steelid 																								: SItemUniqueId;
		var swordsteel, steelcopy, steelScabbardEnt, dummycomp														: CEntity; 
		var steelScabbardscomp 																						: CDrawableComponent;
		var boneIndex																								: int;
		var steelScabbardMeshComponent 																				: CMeshComponent;
		var bonePosition																							: Vector;
		var boneRotation																							: EulerAngles;
		var swordOnHip_steel_position																				: Vector;
		var swordOnHip_steel_scabbard_position																		: Vector;
		var swordOnHip_steel_rotation																				: EulerAngles;
		var swordOnHip_steel_scabbard_rotation																		: EulerAngles;
		var steel_pos_x,steel_pos_y,steel_pos_z   																	: Float;
		var steel_scab_pos_x,steel_scab_pos_y,steel_scab_pos_z  													: Float;
		var steel_roll, steel_pitch, steel_yaw 																		: Float; 
		var steel_scab_roll, steel_scab_pitch, steel_scab_yaw														: Float; 

		var scabbardscomp 																							: CDrawableComponent;
		var scabbardI 																								: int;
		var scabbardItems 																							: array<SItemUniqueId>;
		var scabbardMeshComponent 																					: CMeshComponent;
		var scabbardEnt 																							: CEntity;

		var temp_path 																								: String;

		var boneName 																								: CName;

		if (ACS_Settings_Main_Bool('acs_player_equipment_visual_settings','acs_hide_sword_sheathes', false))
		{
			return;
		}
		
		GetWitcherPlayer().GetItemEquippedOnSlot(EES_SteelSword, steelid);

		if (ACS_DoNotCreateMeshCheck('steel', steelid))
		{
			return;
		}

		if (GetWitcherPlayer().IsWeaponHeld('steelsword'))
		{
			return;
		}

		swordOnHip_steel_position.X = 0;    
		swordOnHip_steel_position.Y = 0;    
		swordOnHip_steel_position.Z = 0;     

		swordOnHip_steel_rotation.Pitch = 0;
		swordOnHip_steel_rotation.Roll = 0;
		swordOnHip_steel_rotation.Yaw = 0;

		if ((ACS_Settings_Main_Int ('acs_player_equipment_visual_settings','acs_swords_positioning_when_cloaked', 0, true) == 1 || FactsQuerySum("ACS_Force_Weapons_On_Hips") > 0))
		{
			swordOnHip_steel_position.X += -0.19;
			swordOnHip_steel_position.Y += -0.17; // - up + down
			swordOnHip_steel_position.Z += -0.15; // - left + right

			swordOnHip_steel_rotation.Pitch += 107;
			swordOnHip_steel_rotation.Roll += 18;
			swordOnHip_steel_rotation.Yaw += 140;

			boneName = 'pelvis';
		}
		else if (ACS_Settings_Main_Int ('acs_player_equipment_visual_settings','acs_swords_positioning_when_cloaked', 0, true) == 0)
		{
			swordOnHip_steel_position.X += 0.50; // + up - down
			swordOnHip_steel_position.Y += -0.20; // + forward - back
			swordOnHip_steel_position.Z += -0.14; // + left - right

			swordOnHip_steel_rotation.Pitch += 14;
			swordOnHip_steel_rotation.Roll += -68;
			swordOnHip_steel_rotation.Yaw += 15;

			boneName = 'torso2';
		}


		swordOnHip_steel_scabbard_position.X = -1.22;    
		swordOnHip_steel_scabbard_position.Y = 0.180;    
		swordOnHip_steel_scabbard_position.Z = 0;     

		swordOnHip_steel_scabbard_rotation.Pitch = 0;
		swordOnHip_steel_scabbard_rotation.Roll = 0;
		swordOnHip_steel_scabbard_rotation.Yaw = 180;
		
		swordOnHip_steel_scabbard_position.X += 0.61;
		swordOnHip_steel_scabbard_position.Y -= 0.09;
		swordOnHip_steel_scabbard_position.Z -= -1.71;

		swordOnHip_steel_scabbard_rotation.Pitch += 180;
		swordOnHip_steel_scabbard_rotation.Roll += -24.3;
		swordOnHip_steel_scabbard_rotation.Yaw += 14.4 + 0.41;

		//////////////////////////////////////////////////////////////////////////////////////////
		
		if ( !theGame.GetEntityByTag('ACS_SwordOnHip_Dummy_Attachment') )
		{
			boneIndex = thePlayer.GetBoneIndex( boneName );	
			thePlayer.GetBoneWorldPositionAndRotationByIndex( boneIndex, bonePosition, boneRotation );
			dummycomp = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync("dlc\dlc_acs\data\entities\other\acs_swords_on_hip_attachment.w2ent",true ), thePlayer.GetWorldPosition() + Vector( 0, 0, -100 ) );
			dummycomp.AddTag('ACS_SwordOnHip_Dummy_Attachment');
			//dummycomp.CreateAttachmentAtBoneWS(thePlayer, boneName, bonePosition, boneRotation );
		}

		if ( !theGame.GetEntityByTag('ACS_SwordOnHip_SteelScabbardDummy_Attachment') )
		{
			dummycomp = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync("dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent",true ), Vector( 0, 0, 0 ) );
			dummycomp.AddTag('ACS_SwordOnHip_SteelScabbardDummy_Attachment');
			dummycomp.CreateAttachment( ACSGetCEntity('ACS_SwordOnHip_Dummy_Attachment'),,swordOnHip_steel_position, swordOnHip_steel_rotation );
		}

		if ( !theGame.GetEntityByTag('ACS_SwordOnHip_Steel_Sword_Dummy') )
		{
			swordsteel = thePlayer.GetInventory().GetItemEntityUnsafe( steelid );

			steelcopy = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync(

			swordsteel.GetReadableName()

			,true ), thePlayer.GetWorldPosition() + Vector(0,0,-100), thePlayer.GetWorldRotation());

			steelcopy.AddTag('ACS_SwordOnHip_Steel_Sword_Dummy');
		}

		if ( !theGame.GetEntityByTag('ACS_SwordOnHip_Steel_Scabbard_Dummy') )
		{
			if (!StrContains( swordsteel.GetReadableName(), "sabre" )
			&& !StrContains( swordsteel.GetReadableName(), "saber" )
			&& !StrContains( swordsteel.GetReadableName(), "knife" )
			&& !StrContains( swordsteel.GetReadableName(), "axe" )
			&& !StrContains( swordsteel.GetReadableName(), "hammmer" )
			&& !StrContains( swordsteel.GetReadableName(), "poker" )
			&& !StrContains( swordsteel.GetReadableName(), "wildhunt" )
			&& !StrContains( swordsteel.GetReadableName(), "wild_hunt" )
			&& !StrContains( swordsteel.GetReadableName(), "eredin" )
			&& !StrContains( swordsteel.GetReadableName(), "olgierd" )
			&& !StrContains( swordsteel.GetReadableName(), "iris" )
			&& !StrContains( swordsteel.GetReadableName(), "novalis" )
			)
			{
				scabbardItems.Clear();

				scabbardItems = thePlayer.GetInventory().GetItemsByCategory('steel_scabbards');

				for ( scabbardI=0; scabbardI < scabbardItems.Size() ; scabbardI+=1 )
				{
					scabbardscomp = (CDrawableComponent)((thePlayer.GetInventory().GetItemEntityUnsafe(scabbardItems[scabbardI])).GetMeshComponent());

					if (ACS_Settings_Main_Bool('acs_player_equipment_visual_settings','acs_alternate_scabbard_steel_enabled', false) 
					)
					{
						switch(ACS_Settings_Main_Int('acs_player_equipment_visual_settings','acs_alternate_scabbard_steel_style', 0))
						{
							default:
							case 0:
								if (ACS_Armor_Set_Check('wolf', false))
								{
									temp_path = "dlc\dlc10\data\items\weapons\swords\witcher_steel_swords\witcher_steel_wolf_scabbard.w2ent";
								}
								else if (ACS_Armor_Set_Check('bear', false))
								{
									temp_path = "items\weapons\swords\witcher_steel_scabbards\witcher_steel_bear_scabbard.w2ent";
								}
								else if (ACS_Armor_Set_Check('cat', false))
								{
									temp_path = "items\weapons\swords\witcher_steel_scabbards\witcher_steel_lynx_scabbard.w2ent";
								}
								else if (ACS_Armor_Set_Check('griffin', false))
								{
									temp_path = "items\weapons\swords\witcher_steel_scabbards\witcher_steel_gryphon_scabbard.w2ent";
								}
								else if (ACS_Armor_Set_Check('manticore', false))
								{
									temp_path = "dlc\dlc10\data\items\weapons\swords\witcher_steel_swords\witcher_steel_wolf_scabbard.w2ent";
								}
								else if (ACS_Armor_Set_Check('forgotten_wolf', false))
								{
									temp_path = "items\weapons\swords\witcher_steel_scabbards\witcher_steel_netflix_scabbard.w2ent";
								}
								else if (ACS_Armor_Set_Check('viper', false))
								{
									temp_path = "items\weapons\swords\witcher_steel_scabbards\witcher_steel_bear_scabbard.w2ent";
								}
								else
								{
									temp_path = "items\bodyparts\geralt_items\scabbards\steel_scabbards\scabbard_steel_3_07.w2ent";
								}
							break;

							case 1:
								temp_path = "dlc\dlc10\data\items\weapons\swords\witcher_steel_swords\witcher_steel_wolf_scabbard.w2ent";
							break;

							case 2:
								temp_path = "items\weapons\swords\witcher_steel_scabbards\witcher_steel_bear_scabbard.w2ent";
							break;

							case 3:
								temp_path = "items\weapons\swords\witcher_steel_scabbards\witcher_steel_lynx_scabbard.w2ent";
							break;

							case 4:
								temp_path = "items\weapons\swords\witcher_steel_scabbards\witcher_steel_gryphon_scabbard.w2ent";
							break;

							case 5:
								temp_path = "dlc\dlc10\data\items\weapons\swords\witcher_steel_swords\witcher_steel_wolf_scabbard.w2ent";
							break;

							case 6:
								temp_path = "items\weapons\swords\witcher_steel_scabbards\witcher_steel_netflix_scabbard.w2ent";
							break;

							case 7:
								temp_path = "items\weapons\swords\witcher_steel_scabbards\witcher_steel_bear_scabbard.w2ent";
							break;

							case 8:
								//temp_path = "items\bodyparts\geralt_items\scabbards\steel_scabbards\scabbard_steel_3_07.w2ent";

								temp_path = "items\bodyparts\geralt_items\scabbards\steel_scabbards\scabbard_steel_3_07.w2ent";
							break;
						}
						
						scabbardEnt = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource(
								
						temp_path

						,true ), thePlayer.GetWorldPosition()-100, thePlayer.GetWorldRotation());
					}
					else
					{
						scabbardEnt = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource(
								
						thePlayer.GetInventory().GetItemEntityUnsafe(scabbardItems[scabbardI]).GetReadableName()

						,true ), thePlayer.GetWorldPosition()-100, thePlayer.GetWorldRotation());
					}

					scabbardMeshComponent = ( CMeshComponent ) scabbardEnt.GetComponentByClassName( 'CMeshComponent' );

					scabbardMeshComponent.SetScale( Vector( 1.03, 1.03, 1.03 ) );

					scabbardEnt.AddTag('ACS_SwordOnHip_Steel_Scabbard_Dummy');
				}
			}
		}

		ACSGetCEntity('ACS_SwordOnHip_Steel_Sword_Dummy').CreateAttachment( ACSGetCEntity('ACS_SwordOnHip_Dummy_Attachment'),,swordOnHip_steel_position, swordOnHip_steel_rotation );

		ACSGetCEntity('ACS_SwordOnHip_Steel_Scabbard_Dummy').CreateAttachment( ACSGetCEntity('ACS_SwordOnHip_SteelScabbardDummy_Attachment'),,swordOnHip_steel_scabbard_position, swordOnHip_steel_scabbard_rotation );
	}
	
	event OnLeaveState( nextStateName : name ) 
	{
		super.OnLeaveState(nextStateName);
	}
}

state ACS_CreateSilverSwordDummyFast in cACS_CreateSwordDummies
{	
	event OnEnterState(prevStateName : name)
	{
		CreateSilverSwordDummyFast();
	}

	entry function CreateSilverSwordDummyFast()
	{
		var silverid 																								: SItemUniqueId;
		var silverScabbardItems 																					: array<SItemUniqueId>;
		var swordsilver, silvercopy, silverScabbardEnt, dummycomp													: CEntity; 
		var silverScabbardscomp 																					: CDrawableComponent;
		var boneIndex																								: int;
		var silverScabbardMeshComponent 																			: CMeshComponent;
		var bonePosition																							: Vector;
		var boneRotation																							: EulerAngles;
		var swordOnHip_silver_position																				: Vector;
		var swordOnHip_silver_scabbard_position																		: Vector;
		var swordOnHip_silver_rotation																				: EulerAngles;
		var swordOnHip_silver_scabbard_rotation																		: EulerAngles;

		var silver_pos_x,silver_pos_y,silver_pos_z   																: Float;
		var silver_scab_pos_x,silver_scab_pos_y,silver_scab_pos_z  													: Float;
		var silver_roll, silver_pitch, silver_yaw 																	: Float; 
		var silver_scab_roll,silver_scab_pitch,silver_scab_yaw														: Float; 

		var scabbardscomp 																							: CDrawableComponent;
		var scabbardI 																								: int;
		var scabbardItems 																							: array<SItemUniqueId>;
		var scabbardMeshComponent 																					: CMeshComponent;
		var scabbardEnt 																							: CEntity;

		var temp_path 																								: String;
		var boneName 																								: CName;

		if (ACS_Settings_Main_Bool('acs_player_equipment_visual_settings','acs_hide_sword_sheathes', false))
		{
			return;
		}

		GetWitcherPlayer().GetItemEquippedOnSlot(EES_SilverSword, silverid);

		if (ACS_DoNotCreateMeshCheck('silver', silverid))
		{
			return;
		}

		if (GetWitcherPlayer().IsWeaponHeld('silversword'))
		{
			return;
		}
		

		swordOnHip_silver_position.X = 0;    
		swordOnHip_silver_position.Y = 0;    
		swordOnHip_silver_position.Z = 0;     

		swordOnHip_silver_rotation.Pitch = 0;
		swordOnHip_silver_rotation.Roll = 0;
		swordOnHip_silver_rotation.Yaw = 0;

		if ((ACS_Settings_Main_Int ('acs_player_equipment_visual_settings','acs_swords_positioning_when_cloaked', 0, true) == 1 || FactsQuerySum("ACS_Force_Weapons_On_Hips") > 0))
		{
			swordOnHip_silver_position.X += -0.17;
			swordOnHip_silver_position.Y += -0.15;
			swordOnHip_silver_position.Z += -0.19;

			swordOnHip_silver_rotation.Pitch += 107;
			swordOnHip_silver_rotation.Roll += 18;
			swordOnHip_silver_rotation.Yaw += 140;

			boneName = 'pelvis';
		}
		else if (ACS_Settings_Main_Int ('acs_player_equipment_visual_settings','acs_swords_positioning_when_cloaked', 0, true) == 0)
		{
			swordOnHip_silver_position.X += 0.44; // + up - down
			swordOnHip_silver_position.Y += -0.22; // + forward - back
			swordOnHip_silver_position.Z += -0.24; // + left - right

			swordOnHip_silver_rotation.Pitch += 14;
			swordOnHip_silver_rotation.Roll += -68;
			swordOnHip_silver_rotation.Yaw += 15;

			boneName = 'torso2';
		}

		swordOnHip_silver_scabbard_position.X = -1.27;    
		swordOnHip_silver_scabbard_position.Y = -0.009;    
		swordOnHip_silver_scabbard_position.Z = 0;     

		swordOnHip_silver_scabbard_rotation.Pitch = 0;
		swordOnHip_silver_scabbard_rotation.Roll = 0;
		swordOnHip_silver_scabbard_rotation.Yaw = 180;
		
		swordOnHip_silver_scabbard_position.X += 0.61 + 0.025;
		swordOnHip_silver_scabbard_position.Y += 0.09 - 0.085;
		swordOnHip_silver_scabbard_position.Z += 1.71 - 0.07;

		swordOnHip_silver_scabbard_rotation.Pitch += 180 - 1.5;
		swordOnHip_silver_scabbard_rotation.Roll += -24.3 - 5.5;
		swordOnHip_silver_scabbard_rotation.Yaw += 14.4 + 3.5;

		//////////////////////////////////////////////////////////////////////////////////////////

		if ( !theGame.GetEntityByTag('ACS_SwordOnHip_Dummy_Attachment') )
		{
			boneIndex = thePlayer.GetBoneIndex( boneName );	
			thePlayer.GetBoneWorldPositionAndRotationByIndex( boneIndex, bonePosition, boneRotation );
			dummycomp = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync("dlc\dlc_acs\data\entities\other\acs_swords_on_hip_attachment.w2ent",true ), thePlayer.GetWorldPosition() + Vector( 0, 0, -100 ) );
			dummycomp.AddTag('ACS_SwordOnHip_Dummy_Attachment');
			//dummycomp.CreateAttachmentAtBoneWS(thePlayer, boneName, bonePosition, boneRotation );
		}

		if ( !theGame.GetEntityByTag('ACS_SwordOnHip_SilverScabbardDummy_Attachment') )
		{
			dummycomp = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource("dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent",true ), Vector( 0, 0, 0 ) );
			dummycomp.AddTag('ACS_SwordOnHip_SilverScabbardDummy_Attachment');
			dummycomp.CreateAttachment( ACSGetCEntity('ACS_SwordOnHip_Dummy_Attachment'),,swordOnHip_silver_position, swordOnHip_silver_rotation );
		}

		if ( !theGame.GetEntityByTag('ACS_SwordOnHip_Silver_Sword_Dummy') )
		{
			swordsilver = thePlayer.GetInventory().GetItemEntityUnsafe( silverid );

			silvercopy = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync(

			swordsilver.GetReadableName()

			,true ), thePlayer.GetWorldPosition() + Vector( 0, 0, -100 ), thePlayer.GetWorldRotation());

			silvercopy.AddTag('ACS_SwordOnHip_Silver_Sword_Dummy');
		}

		if ( !theGame.GetEntityByTag('ACS_SwordOnHip_Silver_Scabbard_Dummy') )
		{
			if (!StrContains( swordsilver.GetReadableName(), "sabre" )
			&& !StrContains( swordsilver.GetReadableName(), "saber" )
			&& !StrContains( swordsilver.GetReadableName(), "knife" )
			&& !StrContains( swordsilver.GetReadableName(), "axe" )
			&& !StrContains( swordsilver.GetReadableName(), "hammmer" )
			&& !StrContains( swordsilver.GetReadableName(), "poker" )
			&& !StrContains( swordsilver.GetReadableName(), "wildhunt" )
			&& !StrContains( swordsilver.GetReadableName(), "wild_hunt" )
			&& !StrContains( swordsilver.GetReadableName(), "eredin" )
			&& !StrContains( swordsilver.GetReadableName(), "olgierd" )
			&& !StrContains( swordsilver.GetReadableName(), "iris" )
			&& !StrContains( swordsilver.GetReadableName(), "novalis" )
			)
			{
				scabbardItems.Clear();

				scabbardItems = thePlayer.GetInventory().GetItemsByCategory('silver_scabbards');

				for ( scabbardI=0; scabbardI < scabbardItems.Size() ; scabbardI+=1 )
				{
					scabbardscomp = (CDrawableComponent)((thePlayer.GetInventory().GetItemEntityUnsafe(scabbardItems[scabbardI])).GetMeshComponent());

					if (ACS_Settings_Main_Bool('acs_player_equipment_visual_settings','acs_alternate_scabbard_silver_enabled', false) 
					)
					{
						switch(ACS_Settings_Main_Int('acs_player_equipment_visual_settings','acs_alternate_scabbard_silver_style', 0))
						{
							default:
							case 0:
								if (ACS_Armor_Set_Check('wolf', false))
								{
									temp_path = "dlc\dlc10\data\items\weapons\swords\witcher_silver_swords\witcher_silver_wolf_scabbard.w2ent";
								}
								else if (ACS_Armor_Set_Check('bear', false))
								{
									temp_path = "items\weapons\swords\witcher_silver_scabbards\witcher_silver_bear_scabbard.w2ent";
								}
								else if (ACS_Armor_Set_Check('cat', false))
								{
									temp_path = "items\weapons\swords\witcher_silver_scabbards\witcher_silver_lynx_scabbard.w2ent";
								}
								else if (ACS_Armor_Set_Check('griffin', false))
								{
									temp_path = "items\weapons\swords\witcher_silver_scabbards\witcher_silver_gryphon_scabbard.w2ent";
								}
								else if (ACS_Armor_Set_Check('manticore', false))
								{
									temp_path = "dlc\dlc10\data\items\weapons\swords\witcher_silver_swords\witcher_silver_wolf_scabbard.w2ent";
								}
								else if (ACS_Armor_Set_Check('forgotten_wolf', false))
								{
									temp_path = "items\weapons\swords\witcher_silver_scabbards\witcher_silver_netflix_scabbard.w2ent";
								}
								else if (ACS_Armor_Set_Check('viper', false))
								{
									temp_path = "items\weapons\swords\witcher_silver_scabbards\witcher_silver_bear_scabbard.w2ent";
								}
								else
								{
									temp_path = "items\bodyparts\geralt_items\scabbards\silver_scabbards\scabbard_silver_3_07.w2ent";
								}
							break;

							case 1:
								temp_path = "dlc\dlc10\data\items\weapons\swords\witcher_silver_swords\witcher_silver_wolf_scabbard.w2ent";
							break;

							case 2:
								temp_path = "items\weapons\swords\witcher_silver_scabbards\witcher_silver_bear_scabbard.w2ent";
							break;

							case 3:
								temp_path = "items\weapons\swords\witcher_silver_scabbards\witcher_silver_lynx_scabbard.w2ent";
							break;

							case 4:
								temp_path = "items\weapons\swords\witcher_silver_scabbards\witcher_silver_gryphon_scabbard.w2ent";
							break;

							case 5:
								temp_path = "dlc\dlc10\data\items\weapons\swords\witcher_silver_swords\witcher_silver_wolf_scabbard.w2ent";
							break;

							case 6:
								temp_path = "items\weapons\swords\witcher_silver_scabbards\witcher_silver_netflix_scabbard.w2ent";
							break;

							case 7:
								temp_path = "items\weapons\swords\witcher_silver_scabbards\witcher_silver_bear_scabbard.w2ent";
							break;

							case 8:
								temp_path = "items\bodyparts\geralt_items\scabbards\silver_scabbards\scabbard_silver_3_07.w2ent";
							break;
						}

						scabbardEnt = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource(
								
						temp_path

						,true ), thePlayer.GetWorldPosition()-100, thePlayer.GetWorldRotation());
					}
					else
					{
						scabbardEnt = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource(
								
						thePlayer.GetInventory().GetItemEntityUnsafe(scabbardItems[scabbardI]).GetReadableName()

						,true ), thePlayer.GetWorldPosition()-100, thePlayer.GetWorldRotation());
					}

					scabbardMeshComponent = ( CMeshComponent ) scabbardEnt.GetComponentByClassName( 'CMeshComponent' );

					scabbardMeshComponent.SetScale( Vector( 1.03, 1.03, 1.03 ) );

					scabbardEnt.AddTag('ACS_SwordOnHip_Silver_Scabbard_Dummy');
				}
			}
		}

		ACSGetCEntity('ACS_SwordOnHip_Silver_Sword_Dummy').CreateAttachment( ACSGetCEntity('ACS_SwordOnHip_Dummy_Attachment'),,swordOnHip_silver_position, swordOnHip_silver_rotation );

		ACSGetCEntity('ACS_SwordOnHip_Silver_Scabbard_Dummy').CreateAttachment( ACSGetCEntity('ACS_SwordOnHip_SilverScabbardDummy_Attachment'),,swordOnHip_silver_scabbard_position, swordOnHip_silver_scabbard_rotation );
	}

	event OnLeaveState( nextStateName : name ) 
	{
		super.OnLeaveState(nextStateName);
	}
}

state ACS_CreateSteelSwordDummy in cACS_CreateSwordDummies
{	
	event OnEnterState(prevStateName : name)
	{
		CreateSteelSwordDummy();
	}
	
	entry function CreateSteelSwordDummy()
	{
		var steelid 																								: SItemUniqueId;
		var swordsteel, steelcopy, steelScabbardEnt, dummycomp														: CEntity; 
		var steelScabbardscomp 																						: CDrawableComponent;
		var boneIndex																								: int;
		var steelScabbardMeshComponent 																				: CMeshComponent;
		var bonePosition																							: Vector;
		var boneRotation																							: EulerAngles;
		var swordOnHip_steel_position																				: Vector;
		var swordOnHip_steel_scabbard_position																		: Vector;
		var swordOnHip_steel_rotation																				: EulerAngles;
		var swordOnHip_steel_scabbard_rotation																		: EulerAngles;
		var steel_pos_x,steel_pos_y,steel_pos_z   																	: Float;
		var steel_scab_pos_x,steel_scab_pos_y,steel_scab_pos_z  													: Float;
		var steel_roll, steel_pitch, steel_yaw 																		: Float; 
		var steel_scab_roll, steel_scab_pitch, steel_scab_yaw														: Float; 

		var scabbardscomp 																							: CDrawableComponent;
		var scabbardI 																								: int;
		var scabbardItems 																							: array<SItemUniqueId>;
		var scabbardMeshComponent 																					: CMeshComponent;
		var scabbardEnt 																							: CEntity;

		var temp_path 																								: String;

		var boneName 																								: CName;

		if (ACS_Settings_Main_Bool('acs_player_equipment_visual_settings','acs_hide_sword_sheathes', false))
		{
			return;
		}

		
		GetWitcherPlayer().GetItemEquippedOnSlot(EES_SteelSword, steelid);

		swordOnHip_steel_position.X = 0;    
		swordOnHip_steel_position.Y = 0;    
		swordOnHip_steel_position.Z = 0;     

		swordOnHip_steel_rotation.Pitch = 0;
		swordOnHip_steel_rotation.Roll = 0;
		swordOnHip_steel_rotation.Yaw = 0;

		if ((ACS_Settings_Main_Int ('acs_player_equipment_visual_settings','acs_swords_positioning_when_cloaked', 0, true) == 1 || FactsQuerySum("ACS_Force_Weapons_On_Hips") > 0))
		{
			swordOnHip_steel_position.X += -0.19;
			swordOnHip_steel_position.Y += -0.17; // - up + down
			swordOnHip_steel_position.Z += -0.15; // - left + right

			swordOnHip_steel_rotation.Pitch += 107;
			swordOnHip_steel_rotation.Roll += 18;
			swordOnHip_steel_rotation.Yaw += 140;

			boneName = 'pelvis';
		}
		else if (ACS_Settings_Main_Int ('acs_player_equipment_visual_settings','acs_swords_positioning_when_cloaked', 0, true) == 0)
		{
			swordOnHip_steel_position.X += 0.50; // + up - down
			swordOnHip_steel_position.Y += -0.20; // + forward - back
			swordOnHip_steel_position.Z += -0.14; // + left - right

			swordOnHip_steel_rotation.Pitch += 14;
			swordOnHip_steel_rotation.Roll += -68;
			swordOnHip_steel_rotation.Yaw += 15;

			boneName = 'torso2';
		}

		swordOnHip_steel_scabbard_position.X = -1.22;    
		swordOnHip_steel_scabbard_position.Y = 0.180;    
		swordOnHip_steel_scabbard_position.Z = 0;     

		swordOnHip_steel_scabbard_rotation.Pitch = 0;
		swordOnHip_steel_scabbard_rotation.Roll = 0;
		swordOnHip_steel_scabbard_rotation.Yaw = 180;
		
		swordOnHip_steel_scabbard_position.X += 0.61;
		swordOnHip_steel_scabbard_position.Y -= 0.09;
		swordOnHip_steel_scabbard_position.Z -= -1.71;

		swordOnHip_steel_scabbard_rotation.Pitch += 180;
		swordOnHip_steel_scabbard_rotation.Roll += -24.3;
		swordOnHip_steel_scabbard_rotation.Yaw += 14.4 + 0.41;


		//////////////////////////////////////////////////////////////////////////////////////////

		if ( !theGame.GetEntityByTag('ACS_SwordOnHip_Dummy_Attachment') )
		{
			boneIndex = thePlayer.GetBoneIndex( boneName );	
			thePlayer.GetBoneWorldPositionAndRotationByIndex( boneIndex, bonePosition, boneRotation );
			dummycomp = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync("dlc\dlc_acs\data\entities\other\acs_swords_on_hip_attachment.w2ent",true ), thePlayer.GetWorldPosition() + Vector( 0, 0, -100 ) );
			dummycomp.AddTag('ACS_SwordOnHip_Dummy_Attachment');
			//dummycomp.CreateAttachmentAtBoneWS(thePlayer, boneName, bonePosition, boneRotation );
		}

		if ( !theGame.GetEntityByTag('ACS_SwordOnHip_SteelScabbardDummy_Attachment') )
		{
			dummycomp = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource("dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent",true ), Vector( 0, 0, 0 ) );
			dummycomp.AddTag('ACS_SwordOnHip_SteelScabbardDummy_Attachment');
			dummycomp.CreateAttachment( ACSGetCEntity('ACS_SwordOnHip_Dummy_Attachment'),,swordOnHip_steel_position, swordOnHip_steel_rotation );
		}

		if ( !theGame.GetEntityByTag('ACS_SwordOnHip_Steel_Sword_Dummy') )
		{
			swordsteel = thePlayer.GetInventory().GetItemEntityUnsafe( steelid );

			steelcopy = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync(

			swordsteel.GetReadableName()

			,true ), thePlayer.GetWorldPosition() + Vector(0,0,-100), thePlayer.GetWorldRotation());

			steelcopy.AddTag('ACS_SwordOnHip_Steel_Sword_Dummy');
		}

		if ( !theGame.GetEntityByTag('ACS_SwordOnHip_Steel_Scabbard_Dummy') )
		{
			if (!StrContains( swordsteel.GetReadableName(), "sabre" )
			&& !StrContains( swordsteel.GetReadableName(), "saber" )
			&& !StrContains( swordsteel.GetReadableName(), "knife" )
			&& !StrContains( swordsteel.GetReadableName(), "axe" )
			&& !StrContains( swordsteel.GetReadableName(), "hammmer" )
			&& !StrContains( swordsteel.GetReadableName(), "poker" )
			&& !StrContains( swordsteel.GetReadableName(), "wildhunt" )
			&& !StrContains( swordsteel.GetReadableName(), "wild_hunt" )
			&& !StrContains( swordsteel.GetReadableName(), "eredin" )
			&& !StrContains( swordsteel.GetReadableName(), "olgierd" )
			&& !StrContains( swordsteel.GetReadableName(), "iris" )
			&& !StrContains( swordsteel.GetReadableName(), "novalis" )
			)
			{
				scabbardItems.Clear();

				scabbardItems = thePlayer.GetInventory().GetItemsByCategory('steel_scabbards');

				for ( scabbardI=0; scabbardI < scabbardItems.Size() ; scabbardI+=1 )
				{
					scabbardscomp = (CDrawableComponent)((thePlayer.GetInventory().GetItemEntityUnsafe(scabbardItems[scabbardI])).GetMeshComponent());

					if (ACS_Settings_Main_Bool('acs_player_equipment_visual_settings','acs_alternate_scabbard_steel_enabled', false) 
					)
					{
						switch(ACS_Settings_Main_Int('acs_player_equipment_visual_settings','acs_alternate_scabbard_steel_style', 0))
						{
							default:
							case 0:
								if (ACS_Armor_Set_Check('wolf', false))
								{
									temp_path = "dlc\dlc10\data\items\weapons\swords\witcher_steel_swords\witcher_steel_wolf_scabbard.w2ent";
								}
								else if (ACS_Armor_Set_Check('bear', false))
								{
									temp_path = "items\weapons\swords\witcher_steel_scabbards\witcher_steel_bear_scabbard.w2ent";
								}
								else if (ACS_Armor_Set_Check('cat', false))
								{
									temp_path = "items\weapons\swords\witcher_steel_scabbards\witcher_steel_lynx_scabbard.w2ent";
								}
								else if (ACS_Armor_Set_Check('griffin', false))
								{
									temp_path = "items\weapons\swords\witcher_steel_scabbards\witcher_steel_gryphon_scabbard.w2ent";
								}
								else if (ACS_Armor_Set_Check('manticore', false))
								{
									temp_path = "dlc\dlc10\data\items\weapons\swords\witcher_steel_swords\witcher_steel_wolf_scabbard.w2ent";
								}
								else if (ACS_Armor_Set_Check('forgotten_wolf', false))
								{
									temp_path = "items\weapons\swords\witcher_steel_scabbards\witcher_steel_netflix_scabbard.w2ent";
								}
								else if (ACS_Armor_Set_Check('viper', false))
								{
									temp_path = "items\weapons\swords\witcher_steel_scabbards\witcher_steel_bear_scabbard.w2ent";
								}
								else
								{
									temp_path = "items\bodyparts\geralt_items\scabbards\steel_scabbards\scabbard_steel_3_07.w2ent";
								}
							break;

							case 1:
								temp_path = "dlc\dlc10\data\items\weapons\swords\witcher_steel_swords\witcher_steel_wolf_scabbard.w2ent";
							break;

							case 2:
								temp_path = "items\weapons\swords\witcher_steel_scabbards\witcher_steel_bear_scabbard.w2ent";
							break;

							case 3:
								temp_path = "items\weapons\swords\witcher_steel_scabbards\witcher_steel_lynx_scabbard.w2ent";
							break;

							case 4:
								temp_path = "items\weapons\swords\witcher_steel_scabbards\witcher_steel_gryphon_scabbard.w2ent";
							break;

							case 5:
								temp_path = "dlc\dlc10\data\items\weapons\swords\witcher_steel_swords\witcher_steel_wolf_scabbard.w2ent";
							break;

							case 6:
								temp_path = "items\weapons\swords\witcher_steel_scabbards\witcher_steel_netflix_scabbard.w2ent";
							break;

							case 7:
								temp_path = "items\weapons\swords\witcher_steel_scabbards\witcher_steel_bear_scabbard.w2ent";
							break;

							case 8:
								//temp_path = "items\bodyparts\geralt_items\scabbards\steel_scabbards\scabbard_steel_3_07.w2ent";

								temp_path = "items\bodyparts\geralt_items\scabbards\steel_scabbards\scabbard_steel_3_07.w2ent";
							break;
						}
						
						scabbardEnt = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource(
								
						temp_path

						,true ), thePlayer.GetWorldPosition()-100, thePlayer.GetWorldRotation());
					}
					else
					{
						scabbardEnt = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource(
								
						thePlayer.GetInventory().GetItemEntityUnsafe(scabbardItems[scabbardI]).GetReadableName()

						,true ), thePlayer.GetWorldPosition()-100, thePlayer.GetWorldRotation());
					}

					scabbardMeshComponent = ( CMeshComponent ) scabbardEnt.GetComponentByClassName( 'CMeshComponent' );

					scabbardMeshComponent.SetScale( Vector( 1.03, 1.03, 1.03 ) );

					scabbardEnt.AddTag('ACS_SwordOnHip_Steel_Scabbard_Dummy');
				}
			}
		}

		Sleep( 0.75 );

		thePlayer.GetInventory().UnmountItem( steelid, true );

		Sleep(0.0125);

		if( GetWitcherPlayer().GetItemEquippedOnSlot( EES_SteelSword, steelid) )
		{
			thePlayer.GetInventory().MountItem( steelid, false );
		}

		ACSGetCEntity('ACS_SwordOnHip_Steel_Sword_Dummy').CreateAttachment( ACSGetCEntity('ACS_SwordOnHip_Dummy_Attachment'),,swordOnHip_steel_position, swordOnHip_steel_rotation );

		ACSGetCEntity('ACS_SwordOnHip_Steel_Scabbard_Dummy').CreateAttachment( ACSGetCEntity('ACS_SwordOnHip_SteelScabbardDummy_Attachment'),,swordOnHip_steel_scabbard_position, swordOnHip_steel_scabbard_rotation );
	}
	
	event OnLeaveState( nextStateName : name ) 
	{
		super.OnLeaveState(nextStateName);
	}
}

state ACS_CreateSilverSwordDummy in cACS_CreateSwordDummies
{	
	event OnEnterState(prevStateName : name)
	{
		CreateSilverSwordDummy();
	}

	entry function CreateSilverSwordDummy()
	{
		var silverid 																								: SItemUniqueId;
		var silverScabbardItems 																					: array<SItemUniqueId>;
		var swordsilver, silvercopy, silverScabbardEnt, dummycomp													: CEntity; 
		var silverScabbardscomp 																					: CDrawableComponent;
		var boneIndex																								: int;
		var silverScabbardMeshComponent 																			: CMeshComponent;
		var bonePosition																							: Vector;
		var boneRotation																							: EulerAngles;
		var swordOnHip_silver_position																				: Vector;
		var swordOnHip_silver_scabbard_position																		: Vector;
		var swordOnHip_silver_rotation																				: EulerAngles;
		var swordOnHip_silver_scabbard_rotation																		: EulerAngles;

		var silver_pos_x,silver_pos_y,silver_pos_z   																: Float;
		var silver_scab_pos_x,silver_scab_pos_y,silver_scab_pos_z  													: Float;
		var silver_roll, silver_pitch, silver_yaw 																	: Float; 
		var silver_scab_roll,silver_scab_pitch,silver_scab_yaw														: Float; 

		var scabbardscomp 																							: CDrawableComponent;
		var scabbardI 																								: int;
		var scabbardItems 																							: array<SItemUniqueId>;
		var scabbardMeshComponent 																					: CMeshComponent;
		var scabbardEnt 																							: CEntity;

		var temp_path 																								: String;

		var boneName 																								: CName;

		if (ACS_Settings_Main_Bool('acs_player_equipment_visual_settings','acs_hide_sword_sheathes', false))
		{
			return;
		}

		
		GetWitcherPlayer().GetItemEquippedOnSlot(EES_SilverSword, silverid);

		swordOnHip_silver_position.X = 0;    
		swordOnHip_silver_position.Y = 0;    
		swordOnHip_silver_position.Z = 0;     

		swordOnHip_silver_rotation.Pitch = 0;
		swordOnHip_silver_rotation.Roll = 0;
		swordOnHip_silver_rotation.Yaw = 0;

		if ((ACS_Settings_Main_Int ('acs_player_equipment_visual_settings','acs_swords_positioning_when_cloaked', 0, true) == 1 || FactsQuerySum("ACS_Force_Weapons_On_Hips") > 0))
		{
			swordOnHip_silver_position.X += -0.17;
			swordOnHip_silver_position.Y += -0.15;
			swordOnHip_silver_position.Z += -0.19;

			swordOnHip_silver_rotation.Pitch += 107;
			swordOnHip_silver_rotation.Roll += 18;
			swordOnHip_silver_rotation.Yaw += 140;

			boneName = 'pelvis';

		}
		else if (ACS_Settings_Main_Int ('acs_player_equipment_visual_settings','acs_swords_positioning_when_cloaked', 0, true) == 0)
		{
			swordOnHip_silver_position.X += 0.44; // + up - down
			swordOnHip_silver_position.Y += -0.22; // + forward - back
			swordOnHip_silver_position.Z += -0.24; // + left - right

			swordOnHip_silver_rotation.Pitch += 14;
			swordOnHip_silver_rotation.Roll += -68;
			swordOnHip_silver_rotation.Yaw += 15;
			
			boneName = 'torso2';
		}

		swordOnHip_silver_scabbard_position.X = -1.27;    
		swordOnHip_silver_scabbard_position.Y = -0.009;    
		swordOnHip_silver_scabbard_position.Z = 0;     

		swordOnHip_silver_scabbard_rotation.Pitch = 0;
		swordOnHip_silver_scabbard_rotation.Roll = 0;
		swordOnHip_silver_scabbard_rotation.Yaw = 180;
		
		swordOnHip_silver_scabbard_position.X += 0.61 + 0.025;
		swordOnHip_silver_scabbard_position.Y += 0.09 - 0.085;
		swordOnHip_silver_scabbard_position.Z += 1.71 - 0.07;

		swordOnHip_silver_scabbard_rotation.Pitch += 180 - 1.5;
		swordOnHip_silver_scabbard_rotation.Roll += -24.3 - 5.5;
		swordOnHip_silver_scabbard_rotation.Yaw += 14.4 + 3.5;

		//////////////////////////////////////////////////////////////////////////////////////////

		if ( !theGame.GetEntityByTag('ACS_SwordOnHip_Dummy_Attachment') )
		{
			boneIndex = thePlayer.GetBoneIndex( boneName );	
			thePlayer.GetBoneWorldPositionAndRotationByIndex( boneIndex, bonePosition, boneRotation );
			dummycomp = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync("dlc\dlc_acs\data\entities\other\acs_swords_on_hip_attachment.w2ent",true ), thePlayer.GetWorldPosition() + Vector( 0, 0, -100 ) );
			dummycomp.AddTag('ACS_SwordOnHip_Dummy_Attachment');
			//dummycomp.CreateAttachmentAtBoneWS(thePlayer, boneName, bonePosition, boneRotation );
		}

		if ( !theGame.GetEntityByTag('ACS_SwordOnHip_SilverScabbardDummy_Attachment') )
		{
			dummycomp = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource("dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent",true ), Vector( 0, 0, 0 ) );
			dummycomp.AddTag('ACS_SwordOnHip_SilverScabbardDummy_Attachment');
			dummycomp.CreateAttachment( ACSGetCEntity('ACS_SwordOnHip_Dummy_Attachment'),,swordOnHip_silver_position, swordOnHip_silver_rotation );
		}

		if ( !theGame.GetEntityByTag('ACS_SwordOnHip_Silver_Sword_Dummy') )
		{
			swordsilver = thePlayer.GetInventory().GetItemEntityUnsafe( silverid );

			silvercopy = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync(

			swordsilver.GetReadableName()

			,true ), thePlayer.GetWorldPosition() + Vector( 0, 0, -100 ), thePlayer.GetWorldRotation());

			silvercopy.AddTag('ACS_SwordOnHip_Silver_Sword_Dummy');
		}

		if ( !theGame.GetEntityByTag('ACS_SwordOnHip_Silver_Scabbard_Dummy') )
		{
			if (!StrContains( swordsilver.GetReadableName(), "sabre" )
			&& !StrContains( swordsilver.GetReadableName(), "saber" )
			&& !StrContains( swordsilver.GetReadableName(), "knife" )
			&& !StrContains( swordsilver.GetReadableName(), "axe" )
			&& !StrContains( swordsilver.GetReadableName(), "hammmer" )
			&& !StrContains( swordsilver.GetReadableName(), "poker" )
			&& !StrContains( swordsilver.GetReadableName(), "wildhunt" )
			&& !StrContains( swordsilver.GetReadableName(), "wild_hunt" )
			&& !StrContains( swordsilver.GetReadableName(), "eredin" )
			&& !StrContains( swordsilver.GetReadableName(), "olgierd" )
			&& !StrContains( swordsilver.GetReadableName(), "iris" )
			&& !StrContains( swordsilver.GetReadableName(), "novalis" )
			)
			{
				scabbardItems.Clear();

				scabbardItems = thePlayer.GetInventory().GetItemsByCategory('silver_scabbards');

				for ( scabbardI=0; scabbardI < scabbardItems.Size() ; scabbardI+=1 )
				{
					scabbardscomp = (CDrawableComponent)((thePlayer.GetInventory().GetItemEntityUnsafe(scabbardItems[scabbardI])).GetMeshComponent());

					if (ACS_Settings_Main_Bool('acs_player_equipment_visual_settings','acs_alternate_scabbard_silver_enabled', false) 
					)
					{
						switch(ACS_Settings_Main_Int('acs_player_equipment_visual_settings','acs_alternate_scabbard_silver_style', 0))
						{
							default:
							case 0:
								if (ACS_Armor_Set_Check('wolf', false))
								{
									temp_path = "dlc\dlc10\data\items\weapons\swords\witcher_silver_swords\witcher_silver_wolf_scabbard.w2ent";
								}
								else if (ACS_Armor_Set_Check('bear', false))
								{
									temp_path = "items\weapons\swords\witcher_silver_scabbards\witcher_silver_bear_scabbard.w2ent";
								}
								else if (ACS_Armor_Set_Check('cat', false))
								{
									temp_path = "items\weapons\swords\witcher_silver_scabbards\witcher_silver_lynx_scabbard.w2ent";
								}
								else if (ACS_Armor_Set_Check('griffin', false))
								{
									temp_path = "items\weapons\swords\witcher_silver_scabbards\witcher_silver_gryphon_scabbard.w2ent";
								}
								else if (ACS_Armor_Set_Check('manticore', false))
								{
									temp_path = "dlc\dlc10\data\items\weapons\swords\witcher_silver_swords\witcher_silver_wolf_scabbard.w2ent";
								}
								else if (ACS_Armor_Set_Check('forgotten_wolf', false))
								{
									temp_path = "items\weapons\swords\witcher_silver_scabbards\witcher_silver_netflix_scabbard.w2ent";
								}
								else if (ACS_Armor_Set_Check('viper', false))
								{
									temp_path = "items\weapons\swords\witcher_silver_scabbards\witcher_silver_bear_scabbard.w2ent";
								}
								else
								{
									temp_path = "items\bodyparts\geralt_items\scabbards\silver_scabbards\scabbard_silver_3_07.w2ent";
								}
							break;

							case 1:
								temp_path = "dlc\dlc10\data\items\weapons\swords\witcher_silver_swords\witcher_silver_wolf_scabbard.w2ent";
							break;

							case 2:
								temp_path = "items\weapons\swords\witcher_silver_scabbards\witcher_silver_bear_scabbard.w2ent";
							break;

							case 3:
								temp_path = "items\weapons\swords\witcher_silver_scabbards\witcher_silver_lynx_scabbard.w2ent";
							break;

							case 4:
								temp_path = "items\weapons\swords\witcher_silver_scabbards\witcher_silver_gryphon_scabbard.w2ent";
							break;

							case 5:
								temp_path = "dlc\dlc10\data\items\weapons\swords\witcher_silver_swords\witcher_silver_wolf_scabbard.w2ent";
							break;

							case 6:
								temp_path = "items\weapons\swords\witcher_silver_scabbards\witcher_silver_netflix_scabbard.w2ent";
							break;

							case 7:
								temp_path = "items\weapons\swords\witcher_silver_scabbards\witcher_silver_bear_scabbard.w2ent";
							break;

							case 8:
								temp_path = "items\bodyparts\geralt_items\scabbards\silver_scabbards\scabbard_silver_3_07.w2ent";
							break;
						}

						scabbardEnt = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource(
								
						temp_path

						,true ), thePlayer.GetWorldPosition()-100, thePlayer.GetWorldRotation());
					}
					else
					{
						scabbardEnt = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource(
								
						thePlayer.GetInventory().GetItemEntityUnsafe(scabbardItems[scabbardI]).GetReadableName()

						,true ), thePlayer.GetWorldPosition()-100, thePlayer.GetWorldRotation());
					}

					scabbardMeshComponent = ( CMeshComponent ) scabbardEnt.GetComponentByClassName( 'CMeshComponent' );

					scabbardMeshComponent.SetScale( Vector( 1.03, 1.03, 1.03 ) );

					scabbardEnt.AddTag('ACS_SwordOnHip_Silver_Scabbard_Dummy');
				}
			}
		}

		Sleep( 0.75 );

		thePlayer.GetInventory().UnmountItem( silverid, true );

		Sleep(0.0125);

		if( GetWitcherPlayer().GetItemEquippedOnSlot( EES_SilverSword, silverid) )
		{
			thePlayer.GetInventory().MountItem( silverid, false );
		}

		ACSGetCEntity('ACS_SwordOnHip_Silver_Sword_Dummy').CreateAttachment( ACSGetCEntity('ACS_SwordOnHip_Dummy_Attachment'),,swordOnHip_silver_position, swordOnHip_silver_rotation );

		ACSGetCEntity('ACS_SwordOnHip_Silver_Scabbard_Dummy').CreateAttachment( ACSGetCEntity('ACS_SwordOnHip_SilverScabbardDummy_Attachment'),,swordOnHip_silver_scabbard_position, swordOnHip_silver_scabbard_rotation );
	}

	event OnLeaveState( nextStateName : name ) 
	{
		super.OnLeaveState(nextStateName);
	}
}

statemachine class CACSSwordsOnHipAttachmentEnt extends CGameplayEntity
{
	var boneIndex																								: int;
	var bonePosition																							: Vector;
	var boneRotation, rotationModifier																			: EulerAngles;
	var boneName 																								: CName;
	var rotation_switch																							: bool;
	var rotation_counter, rotation_modifier, rotation_limit, bone_pitch_adjustment								: float;
	var mac																										: CMovingPhysicalAgentComponent;
	var pVelocity																								: float;
	var attachment_movement_pause																				: bool;
	var original_bonePosition																					: Vector;
	var original_boneRotation																					: EulerAngles;
		
	event OnSpawned( spawnData : SEntitySpawnData )
	{
		rotationModifier = EulerAngles(0,0,0);

		rotation_counter = 0;

		bone_pitch_adjustment = 0;

		if ((ACS_Settings_Main_Int ('acs_player_equipment_visual_settings','acs_swords_positioning_when_cloaked', 0, true) == 1 || FactsQuerySum("ACS_Force_Weapons_On_Hips") > 0))
		{
			boneName = 'pelvis';

			boneIndex = thePlayer.GetBoneIndex( boneName );	

			thePlayer.GetBoneWorldPositionAndRotationByIndex( boneIndex, bonePosition, boneRotation );

			original_bonePosition = bonePosition;

			original_boneRotation = boneRotation;
		}
		else if (ACS_Settings_Main_Int ('acs_player_equipment_visual_settings','acs_swords_positioning_when_cloaked', 0, true) == 0)
		{
			boneName = 'torso2';

			boneIndex = thePlayer.GetBoneIndex( boneName );	

			thePlayer.GetBoneWorldPositionAndRotationByIndex( boneIndex, bonePosition, boneRotation );

			original_bonePosition = bonePosition;

			original_boneRotation = boneRotation;
		}

		AddTimer('AttachmentLoop', 0.0001, true);
	}

	timer function AttachmentLoop( time : float , id : int )
	{
		if (ACS_Settings_Main_Bool('acs_player_equipment_visual_settings','acs_hide_sword_sheathes', false)
		|| thePlayer.IsCiri()
		|| ACS_New_Replacers_Female_Active()
		)
		{
			this.Teleport(thePlayer.GetWorldPosition() + Vector(0,0,-200));

			this.DestroyAfter(1);

			RemoveTimers();

			return;
		}

		ACSSwordUpdateEnhancements();

		if (theGame.IsDialogOrCutscenePlaying() 
		|| thePlayer.IsInCutsceneIntro()
		|| theGame.IsCurrentlyPlayingNonGameplayScene()
		|| thePlayer.IsInCombat()
		//|| (ACS_Settings_Main_Int ('acs_player_equipment_visual_settings','acs_swords_positioning_when_cloaked', 0, true) == 1 || FactsQuerySum("ACS_Force_Weapons_On_Hips") > 0)
		)
		{
			if (!attachment_movement_pause)
			{
				rotationModifier = EulerAngles(0,0,0);
				
				rotation_counter = 0;

				bone_pitch_adjustment = 0;

				if ((ACS_Settings_Main_Int ('acs_player_equipment_visual_settings','acs_swords_positioning_when_cloaked', 0, true) == 1 || FactsQuerySum("ACS_Force_Weapons_On_Hips") > 0))
				{
					boneName = 'pelvis';

					boneIndex = thePlayer.GetBoneIndex( boneName );	

					thePlayer.GetBoneWorldPositionAndRotationByIndex( boneIndex, bonePosition, boneRotation );

					original_bonePosition = bonePosition;

					original_boneRotation = boneRotation;
				}
				else if (ACS_Settings_Main_Int ('acs_player_equipment_visual_settings','acs_swords_positioning_when_cloaked', 0, true) == 0)
				{
					boneName = 'torso2';

					boneIndex = thePlayer.GetBoneIndex( boneName );	

					thePlayer.GetBoneWorldPositionAndRotationByIndex( boneIndex, bonePosition, boneRotation );

					original_bonePosition = bonePosition;

					original_boneRotation = boneRotation;
				}

				this.BreakAttachment();

				this.CreateAttachmentAtBoneWS(thePlayer, boneName, bonePosition, boneRotation );

				attachment_movement_pause = true;
			}
		}
		else
		{
			if ((ACS_Settings_Main_Int ('acs_player_equipment_visual_settings','acs_swords_positioning_when_cloaked', 0, true) == 1 || FactsQuerySum("ACS_Force_Weapons_On_Hips") > 0))
			{
				boneName = 'pelvis';

				boneIndex = thePlayer.GetBoneIndex( boneName );	

				thePlayer.GetBoneWorldPositionAndRotationByIndex( boneIndex, bonePosition, boneRotation );

				original_bonePosition = bonePosition;

				original_boneRotation = boneRotation;
			}
			else if (ACS_Settings_Main_Int ('acs_player_equipment_visual_settings','acs_swords_positioning_when_cloaked', 0, true) == 0)
			{
				boneName = 'torso2';

				boneIndex = thePlayer.GetBoneIndex( boneName );	

				thePlayer.GetBoneWorldPositionAndRotationByIndex( boneIndex, bonePosition, boneRotation );

				original_bonePosition = bonePosition;

				original_boneRotation = boneRotation;
			}
			
			pVelocity = VecLengthSquared(thePlayer.GetMovingAgentComponent().GetVelocity());

			if (thePlayer.IsUsingHorse()
			|| thePlayer.IsUsingVehicle()
			)
			{
				rotation_modifier = 0.0625;
			}
			else
			{
				if (thePlayer.playerMoveType == PMT_Walk 
				|| thePlayer.playerMoveType == PMT_Run
				)
				{
					if (GetACSWatcher().currspeed == 0
					&& ACS_Settings_Main_Bool('acs_movement_main_settings','acs_modular_movement_speed_enabled', true)
					)
					{
						rotation_modifier = 0.0625;
					}
					else
					{
						rotation_modifier = 0.125;
					}
				}
				else
				{
					rotation_modifier = 0.25;
				}
			}

			rotation_modifier += pVelocity * 0.001;

			rotation_limit = 2.5;

			boneRotation = original_boneRotation;

			boneRotation.Pitch -= bone_pitch_adjustment;

			boneRotation.Pitch += rotationModifier.Pitch;
			boneRotation.Roll += rotationModifier.Roll;
			boneRotation.Yaw += rotationModifier.Yaw;


			if (rotation_counter >= rotation_limit && !rotation_switch)
			{
				rotation_switch = true;
			}
			else if (rotation_counter <= -rotation_limit && rotation_switch)
			{
				rotation_switch = false;
			}

			if (thePlayer.HasTag('ACS_IsManagingSword')
			|| thePlayer.GetWeaponHolster().IsOnTheMiddleOfHolstering()
			|| theGame.IsDialogOrCutscenePlaying() 
			|| thePlayer.IsInCutsceneIntro()
			|| theGame.IsCurrentlyPlayingNonGameplayScene()
			|| !thePlayer.IsAlive()
			|| thePlayer.IsInsideInteraction()
			|| thePlayer.GetPlayerAction() != PEA_None
			|| (ACS_Settings_Main_Int ('acs_player_equipment_visual_settings','acs_swords_positioning_when_cloaked', 0, true) == 1 || FactsQuerySum("ACS_Force_Weapons_On_Hips") > 0)
			)
			{
				if (rotation_counter > 0)
				{
					rotation_counter -= 0.125;

					rotationModifier.Pitch -= 0.125;
					rotationModifier.Roll -= 0.125;
					rotationModifier.Yaw -= 0.125;
				}
				else if (rotation_counter < 0)
				{
					rotation_counter += 0.125;
					
					rotationModifier.Pitch += 0.125;
					rotationModifier.Roll += 0.125;
					rotationModifier.Yaw += 0.125;
				}
				else
				{
					rotation_counter = 0;

					rotationModifier.Pitch = 0;
					rotationModifier.Roll = 0;
					rotationModifier.Yaw = 0;
				}

				if (bone_pitch_adjustment > 0)
				{
					bone_pitch_adjustment -= 0.03125;
				}
				else if (bone_pitch_adjustment < 0)
				{
					bone_pitch_adjustment += 0.03125;
				}
				else
				{
					bone_pitch_adjustment = 0;
				}
			}
			else
			{
				if (bone_pitch_adjustment > 7.5)
				{
					bone_pitch_adjustment -= 0.03125;
				}
				else if (bone_pitch_adjustment < 7.5)
				{
					bone_pitch_adjustment += 0.03125;
				}
				else
				{
					bone_pitch_adjustment = 7.5;
				}

				if (
				((thePlayer.playerMoveType != PMT_Idle && pVelocity > 2))
				&& !thePlayer.HasTag('ACS_IsManagingSword')
				&& !thePlayer.GetWeaponHolster().IsOnTheMiddleOfHolstering()
				)
				{
					if (!rotation_switch)
					{
						rotation_counter += rotation_modifier;

						rotationModifier.Pitch += rotation_modifier * 0.5;
						rotationModifier.Roll += rotation_modifier;
						rotationModifier.Yaw += rotation_modifier * 0.5;
					}
					else if (rotation_switch)
					{
						rotation_counter -= rotation_modifier;

						rotationModifier.Pitch -= rotation_modifier * 0.5;
						rotationModifier.Roll -= rotation_modifier;
						rotationModifier.Yaw -= rotation_modifier * 0.5;
					}
				}
				else
				{
					if (rotation_counter > 0)
					{
						rotation_counter -= 0.125;

						rotationModifier.Pitch -= 0.125;
						rotationModifier.Roll -= 0.125;
						rotationModifier.Yaw -= 0.125;
					}
					else if (rotation_counter < 0)
					{
						rotation_counter += 0.125;
						
						rotationModifier.Pitch += 0.125;
						rotationModifier.Roll += 0.125;
						rotationModifier.Yaw += 0.125;
					}
					else
					{
						rotation_counter = 0;

						rotationModifier.Pitch = 0;
						rotationModifier.Roll = 0;
						rotationModifier.Yaw = 0;
					}
				}
			}

			if (attachment_movement_pause)
			{
				attachment_movement_pause = false;
			}

			this.BreakAttachment();
			this.CreateAttachmentAtBoneWS(thePlayer, boneName, original_bonePosition, boneRotation );
		}
	}


	function ACSSwordUpdateEnhancements()
	{
		var steelID, silverID 						: SItemUniqueId;
		var enhancements 							: array<name>;
		var runeCount 								: int;

		if (!ACS_Settings_Main_Bool('acs_player_equipment_visual_settings','acs_permanent_rune_glow', true))
		{
			return;
		}

		if (ACSGetCEntity('ACS_SwordOnHip_Silver_Sword_Dummy'))
		{
			enhancements.Clear();

			GetWitcherPlayer().GetItemEquippedOnSlot(EES_SilverSword, silverID);

			GetWitcherPlayer().GetInventory().GetItemEnhancementItems( silverID, enhancements );

			runeCount = GetWitcherPlayer().GetInventory().GetItemEnhancementCount( silverID );

			if ( runeCount > 0 && ( ( runeCount - 1 ) < enhancements.Size() ) )
			{
				ACSGetCEntity('ACS_SwordOnHip_Silver_Sword_Dummy').StopEffect( ACS_GetRuneLevel( runeCount ) );
				ACSGetCEntity('ACS_SwordOnHip_Silver_Sword_Dummy').StopEffect( ACS_GetRuneFxName( enhancements[ runeCount - 1 ] ) );

				ACSGetCEntity('ACS_SwordOnHip_Silver_Sword_Dummy').PlayEffectSingle( ACS_GetRuneLevel( runeCount ) );
				ACSGetCEntity('ACS_SwordOnHip_Silver_Sword_Dummy').PlayEffectSingle( ACS_GetRuneFxName( enhancements[ runeCount - 1 ] ) );
			}
			else if ( 3 == runeCount && 1 == enhancements.Size() )
			{
				ACSGetCEntity('ACS_SwordOnHip_Silver_Sword_Dummy').StopEffect( ACS_GetRuneLevel( runeCount ) );
				ACSGetCEntity('ACS_SwordOnHip_Silver_Sword_Dummy').StopEffect( ACS_GetEnchantmentFxName( enhancements[ 0 ] ) );

				ACSGetCEntity('ACS_SwordOnHip_Silver_Sword_Dummy').PlayEffectSingle( ACS_GetRuneLevel( runeCount ) );
				ACSGetCEntity('ACS_SwordOnHip_Silver_Sword_Dummy').PlayEffectSingle( ACS_GetEnchantmentFxName( enhancements[ 0 ] ) );
			}

			ACSGetCEntity('ACS_SwordOnHip_Silver_Sword_Dummy').PlayEffectSingle('rune_blast_loop');
		}

		if (ACSGetCEntity('ACS_SwordOnHip_Steel_Sword_Dummy'))
		{
			enhancements.Clear();

			GetWitcherPlayer().GetItemEquippedOnSlot(EES_SteelSword, steelID);

			GetWitcherPlayer().GetInventory().GetItemEnhancementItems( steelID, enhancements );

			runeCount = GetWitcherPlayer().GetInventory().GetItemEnhancementCount( steelID );

			if ( runeCount > 0 && ( ( runeCount - 1 ) < enhancements.Size() ) )
			{
				ACSGetCEntity('ACS_SwordOnHip_Steel_Sword_Dummy').StopEffect( ACS_GetRuneLevel( runeCount ) );
				ACSGetCEntity('ACS_SwordOnHip_Steel_Sword_Dummy').StopEffect( ACS_GetRuneFxName( enhancements[ runeCount - 1 ] ) );

				ACSGetCEntity('ACS_SwordOnHip_Steel_Sword_Dummy').PlayEffectSingle( ACS_GetRuneLevel( runeCount ) );
				ACSGetCEntity('ACS_SwordOnHip_Steel_Sword_Dummy').PlayEffectSingle( ACS_GetRuneFxName( enhancements[ runeCount - 1 ] ) );
			}
			else if ( 3 == runeCount && 1 == enhancements.Size() )
			{
				ACSGetCEntity('ACS_SwordOnHip_Steel_Sword_Dummy').StopEffect( ACS_GetRuneLevel( runeCount ) );
				ACSGetCEntity('ACS_SwordOnHip_Steel_Sword_Dummy').StopEffect( ACS_GetEnchantmentFxName( enhancements[ 0 ] ) );

				ACSGetCEntity('ACS_SwordOnHip_Steel_Sword_Dummy').PlayEffectSingle( ACS_GetRuneLevel( runeCount ) );
				ACSGetCEntity('ACS_SwordOnHip_Steel_Sword_Dummy').PlayEffectSingle( ACS_GetEnchantmentFxName( enhancements[ 0 ] ) );
			}

			ACSGetCEntity('ACS_SwordOnHip_Steel_Sword_Dummy').PlayEffectSingle('rune_blast_loop');
		}
	}
}


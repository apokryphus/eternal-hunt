statemachine class CACSSwordSlashController extends CGameplayEntity
{
	event OnSpawned( spawnData : SEntitySpawnData )
	{
		AddTimer('wait_for_tag', 0.1 , false );
	}

	private timer function wait_for_tag( delta : float , id : int)
	{
		this.GotoState('ACS_Sword_Slash_Process');

	} 

	event OnDestroyed()
	{

	}
}

//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

state ACS_Sword_Slash_Process in CACSSwordSlashController
{
	private var temp															: CEntityTemplate;
	private var ent																: CEntity;
	private var i, count														: int;
	private var pos																: Vector;
	private var rot																: EulerAngles;

	event OnEnterState(prevStateName : name)
	{
		super.OnEnterState(prevStateName);

		Sword_Slash_Process();
	}
	
	entry function Sword_Slash_Process()
	{
		temp = (CEntityTemplate)LoadResourceAsync( 

		"dlc\dlc_acs\data\fx\sword_slash_circular\acs_sword_slash_circular.w2ent"
			
		, true );

		pos = parent.GetWorldPosition();
		

		if (parent.HasTag('ACS_Sword_Slash_Mortal_Draw')
		)
		{
			count = 14;
		}
		else if (parent.HasTag('ACS_Sword_Slash_Spiral_Cloud')
		)
		{
			count = 7;
		}
		else if (parent.HasTag('ACS_Sword_Slash_Wolven_Flash_Secondary'))
		{
			count = 1;
		}
		else if (parent.HasTag('ACS_Sword_Slash_Controller_Damage_Reduce')
		|| parent.HasTag('ACS_Sword_Slash_Controller_Damage_Reduce_Extra')
		)
		{
			count = 3;
		}
		else
		{
			count = RandRange(10,7);
		}

		if (count > 7)
		{
			parent.AddTag('ACS_Sword_Slash_Controller_Damage_Reduce');
		}
			
		for( i = 0; i < count; i += 1 )
		{
			rot = parent.GetWorldRotation();

			ent = theGame.CreateEntity( temp, pos, rot );

			ent.AddTag('ACS_Sword_Slash_Circular_Deal_Damage');

			if (parent.HasTag('ACS_Sword_Slash_Mix'))
			{
				if (RandF() < 0.5)
				{
					ent.AddTag( 'ACS_Sword_Slash_Circular_Light' );
				}
				else
				{
					ent.AddTag( 'ACS_Sword_Slash_Circular_Medium' );
				}
			}
			else if (parent.HasTag('ACS_Sword_Slash_Light'))
			{
				ent.AddTag( 'ACS_Sword_Slash_Circular_Light' );
			}
			else if (parent.HasTag('ACS_Sword_Slash_Heavy'))
			{
				ent.AddTag( 'ACS_Sword_Slash_Circular_Heavy' );
			}
			else
			{
				ent.AddTag( 'ACS_Sword_Slash_Circular_Light' );
			}

			if (parent.HasTag('ACS_Sword_Slash_Feainnewedd_Dance'))
			{
				ent.AddTag('ACS_Sword_Slash_Feainnewedd_Dance');
			}

			if (parent.HasTag('ACS_Sword_Slash_Spiral_Cloud'))
			{
				ent.AddTag('ACS_Sword_Slash_Spiral_Cloud');
			}

			if (parent.HasTag('ACS_Sword_Slash_Mortal_Draw'))
			{
				if (RandF() < 0.5)
				{
					ent.AddTag( 'ACS_Sword_Slash_Circular_Mortal_Draw_Primary' );
				}
				else
				{
					ent.AddTag( 'ACS_Sword_Slash_Circular_Mortal_Draw_Secondary' );
				}
			}

			if (parent.HasTag('ACS_Sword_Slash_Wolven_Flash_Secondary'))
			{
				ent.AddTag('ACS_Sword_Slash_Wolven_Flash_Secondary');
			}

			if (parent.HasTag('ACS_Sword_Slash_Controller_Damage_Reduce'))
			{
				ent.AddTag('ACS_Sword_Slash_Damage_Reduce');
			}

			if (parent.HasTag('ACS_Sword_Slash_Controller_Damage_Reduce_Extra'))
			{
				ent.AddTag('ACS_Sword_Slash_Damage_Reduce_Extra');
			}

			Sleep(0.05);
		}

		Sleep(3);

		parent.Destroy();
	}
	

}


statemachine class CACSSwordSlashCircular extends CGameplayEntity
{
	var rot : EulerAngles;
	var forwardSpin : bool;

	event OnSpawned( spawnData : SEntitySpawnData )
	{
		AddTimer('wait_for_tag', 0.01, false );
	}

	function DealDamageToVictim(victim : CGameplayEntity)
	{
		var action : W3DamageAction;
		var damage : float;
		
		action = new W3DamageAction in this;

		action.Initialize( thePlayer, victim, theGame, thePlayer.GetName(), EHRT_Heavy, CPS_Undefined, false, false, true, false );

		if ( ((CActor)victim) == thePlayer
		)
		{
			return;
		}

		if (((CActor)victim).UsesVitality()) 
		{ 
			if ( ((CActor)victim).GetStat( BCS_Vitality ) >= ((CActor)victim).GetStatMax( BCS_Vitality ) * 0.5 )
			{
				damage = ((CActor)victim).GetStat( BCS_Vitality ) * 0.0625; 
			}
			else if ( ((CActor)victim).GetStat( BCS_Vitality ) < ((CActor)victim).GetStatMax( BCS_Vitality ) * 0.5 )
			{
				damage = ( ((CActor)victim).GetStatMax( BCS_Vitality ) - ((CActor)victim).GetStat( BCS_Vitality ) ) * 0.0625; 
			}
		} 
		else if (((CActor)victim).UsesEssence()) 
		{ 
			if (((CMovingPhysicalAgentComponent)(((CActor)victim).GetMovingAgentComponent())).GetCapsuleHeight() >= 2
			|| ((CActor)victim).GetRadius() >= 0.7
			|| ((CActor)victim).HasAbility('Boss')
			|| ((CActor)victim).HasTag('IsBoss')
			)
			{
				if ( ((CActor)victim).GetStat( BCS_Essence ) >= ((CActor)victim).GetStatMax( BCS_Essence ) * 0.5 )
				{
					damage = ((CActor)victim).GetStat( BCS_Essence ) * 0.03125; 
				}
				else if ( ((CActor)victim).GetStat( BCS_Essence ) < ((CActor)victim).GetStatMax( BCS_Essence ) * 0.5 )
				{
					damage = ( ((CActor)victim).GetStatMax( BCS_Essence ) - ((CActor)victim).GetStat( BCS_Essence ) ) * 0.03125; 
				}
			}
			else
			{
				if ( ((CActor)victim).GetStat( BCS_Essence ) >= ((CActor)victim).GetStatMax( BCS_Essence ) * 0.5 )
				{
					damage = ((CActor)victim).GetStat( BCS_Essence ) * 0.0625; 
				}
				else if ( ((CActor)victim).GetStat( BCS_Essence ) < ((CActor)victim).GetStatMax( BCS_Essence ) * 0.5 )
				{
					damage = ( ((CActor)victim).GetStatMax( BCS_Essence ) - ((CActor)victim).GetStat( BCS_Essence ) ) * 0.0625; 
				}
			}
		}

		if (thePlayer.HasTag('ACS_Flammable_Oil_Enabled'))
		{
			if (ACS_GetItem_SwordHeldSwitchBasedUponStat('frost_sword'))
			{
				SoundEvent("ep2_mutations_06_frosty_aard");

				action.AddDamage( theGame.params.DAMAGE_NAME_FROST , 10 + damage * 0.1 );

				action.AddEffectInfo(EET_SlowdownFrost, 1);
			}
			else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('poison_sword'))
			{
				if ( !theSound.SoundIsBankLoaded("ep2_mutations_04.bnk") )
				{
					theSound.SoundLoadBank( "ep2_mutations_04.bnk", false );
				}

				SoundEvent("ep2_mutations_04_poison_blood_spray_enemy");

				action.AddDamage( theGame.params.DAMAGE_NAME_POISON , 10 + damage * 0.1 );

				action.AddEffectInfo(EET_Poison, 1);
			}
			else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('bleed_sword'))
			{
				if ( !theSound.SoundIsBankLoaded("monster_barghest.bnk") )
				{
					theSound.SoundLoadBank( "monster_barghest.bnk", false );
				}

				SoundEvent("monster_barghest_combat_blood_flames");

				action.AddDamage( theGame.params.DAMAGE_NAME_SLASHING , 10 + damage * 0.1 );

				action.AddEffectInfo(EET_Bleeding, 1);
			}
			else
			{
				SoundEvent("fx_fire_geralt_fire_hit");

				action.AddDamage( theGame.params.DAMAGE_NAME_FIRE , 10 + damage * 0.1 );

				action.AddEffectInfo(EET_Burning, 1);
			}
		}

		if (this.HasTag('ACS_Sword_Slash_Damage_Reduce'))
		{
			damage -= damage * 0.5;
		}

		if (this.HasTag('ACS_Sword_Slash_Damage_Reduce_Extra'))
		{
			damage -= damage * 0.875;
		}

		action.AddDamage( theGame.params.DAMAGE_NAME_DIRECT , 50 + damage );

		action.SetHitAnimationPlayType(EAHA_ForceYes);
		
		action.SetCanPlayHitParticle(false);

		action.SetForceExplosionDismemberment();

		theGame.damageMgr.ProcessAction( action );
		delete action;	
	}

	private timer function wait_for_tag( delta : float , id : int)
	{
		var entities	 		: array<CGameplayEntity>;
		var i					: int;
		var range				: int;

		rot = GetWorldRotation();

		rot.Roll += 115;

		entities.Clear();

		if (HasTag('ACS_Sword_Slash_Wolven_Flash_Primary'))
		{
			range = 5;

			SoundEvent("monster_dettlaff_vampire_movement_whoosh_claws_large");

			rot.Yaw -= 90;
		}
		else if (HasTag('ACS_Sword_Slash_Wolven_Flash_Secondary'))
		{
			range = 4;

			SoundEvent("monster_dettlaff_vampire_movement_whoosh_claws_small");

			rot.Yaw -= 90;

			rot.Pitch += RandRangeF(360, 0);
		}
		else if (HasTag('ACS_Sword_Slash_Wolven_Cross_01'))
		{
			range = 2;

			SoundEvent("monster_dettlaff_vampire_movement_whoosh_claws_small");

			rot.Yaw -= 90;

			rot.Pitch -= RandRangeF(135, 112.5);
		}
		else if (HasTag('ACS_Sword_Slash_Wolven_Cross_02'))
		{
			range = 2;

			SoundEvent("monster_dettlaff_vampire_movement_whoosh_claws_small");

			rot.Yaw -= 90;

			rot.Pitch += RandRangeF(135, 112.5);
		}
		else if (HasTag('ACS_Sword_Slash_Circular_Singular'))
		{
			range = 7;

			SoundEvent("monster_dettlaff_vampire_movement_whoosh_claws_large");

			rot.Yaw -= 90;

			rot.Pitch += RandRangeF(90, 67.5);
		}
		else if (HasTag('ACS_Sword_Slash_Backflip'))
		{
			range = 5;

			SoundEvent("monster_dettlaff_vampire_movement_whoosh_claws_large");

			rot.Yaw -= 90;

			rot.Pitch += 180;
		}
		else if (HasTag('ACS_Sword_Slash_Circular_On_Hit_Switch_Left')
		|| HasTag('ACS_Sword_Slash_Circular_Finisher_Switch_Left')
		)
		{
			rot.Yaw -= 90;

			rot.Pitch += RandRangeF(112.5, 67.5);
		}
		else if (HasTag('ACS_Sword_Slash_Circular_On_Hit_Switch_Right')
		|| HasTag('ACS_Sword_Slash_Circular_Finisher_Switch_Right')
		)
		{
			rot.Yaw -= 90;

			rot.Pitch -= RandRangeF(112.5, 67.5);
		}
		else if (HasTag('ACS_Sword_Slash_Circular_On_Hit_Switch_Diagonal_Right')
		|| HasTag('ACS_Sword_Slash_Circular_Finisher_Switch_Diagonal_Right')
		)
		{
			rot.Yaw -= 90;

			rot.Pitch += RandRangeF(67.5, 22.5);
		}
		else if (HasTag('ACS_Sword_Slash_Circular_On_Hit_Switch_Diagonal_Left')
		|| HasTag('ACS_Sword_Slash_Circular_Finisher_Switch_Diagonal_Left')
		)
		{
			rot.Yaw -= 90;

			rot.Pitch -= RandRangeF(67.5, 22.5);
		}
		else if (HasTag('ACS_Sword_Slash_Circular_On_Hit_Switch_Diagonal_Right_Up')
		|| HasTag('ACS_Sword_Slash_Circular_Finisher_Switch_Diagonal_Right_Up')
		)
		{
			rot.Yaw -= 90;

			rot.Pitch -= RandRangeF(157.5, 112.5);
		}
		else if (HasTag('ACS_Sword_Slash_Circular_On_Hit_Switch_Diagonal_Left_Up')
		|| HasTag('ACS_Sword_Slash_Circular_Finisher_Switch_Diagonal_Left_Up')
		)
		{
			rot.Yaw -= 90;

			rot.Pitch += RandRangeF(157.5, 112.5);
		}
		else if (HasTag('ACS_Sword_Slash_Circular_On_Hit_Switch_Overhead')
		|| HasTag('ACS_Sword_Slash_Circular_Finisher_Switch_Overhead')
		)
		{
			rot.Yaw -= 90;
		}
		else if (HasTag('ACS_Sword_Slash_Circular_On_Hit_Switch_Stab')
		|| HasTag('ACS_Sword_Slash_Circular_Finisher_Switch_Stab')
		)
		{
			rot.Yaw += 90;
		}
		else
		{
			if (HasTag('ACS_Sword_Slash_Spiral_Cloud')
			|| HasTag('ACS_Sword_Slash_Circular_Mortal_Draw_Primary')
			|| HasTag('ACS_Sword_Slash_Circular_Mortal_Draw_Secondary')
			)
			{
				range = 6;
			}
			else
			{
				range = 3;
			}

			rot.Yaw += RandRangeF(180, -180);

			rot.Pitch += RandRangeF(90, -90);

			if (HasTag('ACS_Sword_Slash_Circular_Light')
			|| HasTag('ACS_Sword_Slash_Circular_Medium')
			)
			{
				SoundEvent("monster_dettlaff_vampire_movement_whoosh_claws_med_fire");
			}
			else if (HasTag('ACS_Sword_Slash_Circular_Heavy'))
			{
				SoundEvent("monster_dettlaff_vampire_movement_whoosh_claws_med_fire");
			}
		}

		if (HasTag('ACS_Sword_Slash_Circular_Deal_Damage'))
		{
			FindGameplayEntitiesInSphere( entities, GetWorldPosition(), range, 999 );

			for( i = 0; i < entities.Size(); i += 1 )
			{
				DealDamageToVictim( entities[i] );
			}
		}

		AddTimer('SwordSlashSpin', 0.00000000000000000000001, true);

		AddTimer('effect_end', 0.325, false );
	} 

	private timer function SwordSlashSpin( delta : float , id : int)
	{
		if (HasTag('ACS_Sword_Slash_Circular_On_Hit_Switch_Stab')
		|| HasTag('ACS_Sword_Slash_Circular_Finisher_Switch_Stab')
		)
		{
			rot.Pitch -= 7.5;
		}
		else
		{
			rot.Roll -= 7.5;
		}

		if (HasTag('ACS_Sword_Slash_Circular_Singular')
		)
		{
			if (HasTag('ACS_Sword_Slash_Feainnewedd_Dance'))
			{
				PlayEffectSingle('sword_slash_feainnewedd_dance');
				StopEffect('sword_slash_feainnewedd_dance');
			}
			else
			{
				PlayEffectSingle('sword_slash_circular_large');
				StopEffect('sword_slash_circular_large');
			}
		}
		else if (HasTag('ACS_Sword_Slash_Circular_Light')
		)
		{
			if (HasTag('ACS_Sword_Slash_Feainnewedd_Dance'))
			{
				PlayEffectSingle('sword_slash_feainnewedd_dance');
				StopEffect('sword_slash_feainnewedd_dance');
			}
			else if (HasTag('ACS_Sword_Slash_Circular_Mortal_Draw_Primary'))
			{
				PlayEffectSingle('mortal_draw_fx_01');
				StopEffect('mortal_draw_fx_01');
			}
			else if (HasTag('ACS_Sword_Slash_Circular_Mortal_Draw_Secondary'))
			{
				PlayEffectSingle('mortal_draw_fx_02');
				StopEffect('mortal_draw_fx_02');
			}
			else
			{
				PlayEffectSingle('sword_slash_circular_default');
				StopEffect('sword_slash_circular_default');
			}
		}
		else if (HasTag('ACS_Sword_Slash_Circular_Medium'))
		{
			if (HasTag('ACS_Sword_Slash_Circular_Mortal_Draw_Primary'))
			{
				PlayEffectSingle('mortal_draw_fx_01');
				StopEffect('mortal_draw_fx_01');
			}
			else if (HasTag('ACS_Sword_Slash_Circular_Mortal_Draw_Secondary'))
			{
				PlayEffectSingle('mortal_draw_fx_02');
				StopEffect('mortal_draw_fx_02');
			}
			else
			{
				PlayEffectSingle('sword_slash_circular_medium');
				StopEffect('sword_slash_circular_medium');
			}
		}
		else if (HasTag('ACS_Sword_Slash_Circular_Heavy'))
		{
			PlayEffectSingle('heavy_trail_extended_fx');
			StopEffect('heavy_trail_extended_fx');
		}
		else if (HasTag('ACS_Sword_Slash_Circular_On_Hit_Switch_Right')
		|| HasTag('ACS_Sword_Slash_Circular_On_Hit_Switch_Left')
		|| HasTag('ACS_Sword_Slash_Circular_On_Hit_Switch_Diagonal_Right')
		|| HasTag('ACS_Sword_Slash_Circular_On_Hit_Switch_Diagonal_Left')
		|| HasTag('ACS_Sword_Slash_Circular_On_Hit_Switch_Diagonal_Right_Up')
		|| HasTag('ACS_Sword_Slash_Circular_On_Hit_Switch_Diagonal_Left_Up')
		|| HasTag('ACS_Sword_Slash_Circular_On_Hit_Switch_Overhead')
		|| HasTag('ACS_Sword_Slash_Circular_On_Hit_Switch_Stab')
		)
		{
			if (!IsEffectActive('electric_sword_trail_white', false))
			{
				PlayEffectSingle('electric_sword_trail_white');
			}

			if (!IsEffectActive('sword_lightning_white', false))
			{
				PlayEffectSingle('sword_lightning_white');
			}
		}
		else if (HasTag('ACS_Sword_Slash_Circular_Finisher_Switch_Right')
		|| HasTag('ACS_Sword_Slash_Circular_Finisher_Switch_Left')
		|| HasTag('ACS_Sword_Slash_Circular_Finisher_Switch_Diagonal_Right')
		|| HasTag('ACS_Sword_Slash_Circular_Finisher_Switch_Diagonal_Left')
		|| HasTag('ACS_Sword_Slash_Circular_Finisher_Switch_Diagonal_Right_Up')
		|| HasTag('ACS_Sword_Slash_Circular_Finisher_Switch_Diagonal_Left_Up')
		|| HasTag('ACS_Sword_Slash_Circular_Finisher_Switch_Overhead')
		|| HasTag('ACS_Sword_Slash_Circular_Finisher_Switch_Stab')
		)
		{
			if (!IsEffectActive('electric_sword_trail_red', false))
			{
				PlayEffectSingle('electric_sword_trail_red');
			}
			
			if (!IsEffectActive('sword_lightning_white', false))
			{
				PlayEffectSingle('sword_lightning_white');
			}

			if (!IsEffectActive('blood_sword_trail', false))
			{
				PlayEffectSingle('blood_sword_trail');
			}
		}
		else
		{
			PlayEffectSingle('light_trail_extended_fx');
			StopEffect('light_trail_extended_fx');
		}

		if (thePlayer.HasTag('ACS_Flammable_Oil_Enabled'))
		{
			if (ACS_GetItem_SwordHeldSwitchBasedUponStat('frost_sword'))
			{
				if (!IsEffectActive('ice_fire_sparks_trail', false))
				{
					PlayEffectSingle('ice_fire_sparks_trail');
				}

				if (!IsEffectActive('frost_sword_trail', false))
				{
					PlayEffectSingle('frost_sword_trail');
				}

				if (!IsEffectActive('sword_axii_trail', false))
				{
					PlayEffectSingle('sword_axii_trail');
				}
			}
			else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('poison_sword'))
			{
				if (!IsEffectActive('poison_sword_trail', false))
				{
					PlayEffectSingle('poison_sword_trail');
				}
			}
			else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('bleed_sword'))
			{
				if (!IsEffectActive('blood_sword_trail', false))
				{
					PlayEffectSingle('blood_sword_trail');
				}
			}
			else
			{
				if (!IsEffectActive('fire_sparks_trail', false))
				{
					PlayEffectSingle('fire_sparks_trail');
				}

				if (!IsEffectActive('fire_sword_trail', false))
				{
					PlayEffectSingle('fire_sword_trail');
				}

				if (!IsEffectActive('sword_igni_trail', false))
				{
					PlayEffectSingle('sword_igni_trail');
				}
			}
		}


		TeleportWithRotation(this.GetWorldPosition(), rot);
	}

	private timer function effect_end( delta : float , id : int)
	{
		RemoveTimers();

		StopAllEffects();

		DestroyAfter(1);
	}

	event OnDestroyed()
	{
		RemoveTimers();

		StopAllEffects();
	}
}

//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

statemachine class CACSBloodsmokeEntity extends CGameplayEntity
{
	event OnSpawned( spawnData : SEntitySpawnData )
	{
		if (FactsQuerySum("ACS_Bloodsmoke_Active") > 0)
		{
			FactsRemove("ACS_Bloodsmoke_Active");
		}

		GetACSWatcher().RemoveTimer('IgniLightIcon');
		GetACSWatcher().RemoveTimer('AardLightIcon');
		
		AddTimer('IgniLightIconRed', 0.5 , false );

		thePlayer.RaiseEvent('ACS_IgniLight');

		PlayEffect('blood_init');

		PlayEffect('shadowdash_ground_blood_construct');

		PlayEffect('shadowdash_construct');

		if ( !theSound.SoundIsBankLoaded("fx_blood.bnk") )
		{
			theSound.SoundLoadBank( "fx_blood.bnk", false );
		}

		SoundEvent("dialog_fx_blood_short");

		SoundEvent("fx_blood_outflow_small_short");
		SoundEvent("fx_blood_outflow_medium_short");

		SoundEvent("fx_blood_outflow_small_loop");
		SoundEvent("fx_blood_outflow_medium_loop");

		AddTimer('bloodsmoke_init_delay', 0.75 , false );
	}

	timer function IgniLightIconRed( time : float , id : int )
	{
		var ent, ent_2 						: CEntity;
		var bone_vec, attach_vec			: Vector;
		var bone_rot, attach_rot			: EulerAngles;

		ACSGetCEntity('ACS_Quen_Bubble').Destroy();
			
		ACSGetCEntity('ACS_Quen_Fx').Destroy();

		ACSGetCEntity('ACS_Sign_Icon').Destroy();

		ACSGetCEntity('ACS_Sign_Icon_Anchor').Destroy();

		ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
		"dlc\dlc_acs\data\fx\sign_icons.w2ent"
		, true ), GetWitcherPlayer().GetWorldPosition(), GetWitcherPlayer().GetWorldRotation() );

		ent_2 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
		"dlc\dlc_acs\data\fx\sign_icons.w2ent"
		, true ), GetWitcherPlayer().GetWorldPosition(), GetWitcherPlayer().GetWorldRotation() );

		GetWitcherPlayer().GetBoneWorldPositionAndRotationByIndex( GetWitcherPlayer().GetBoneIndex( 'l_handRoll' ), bone_vec, bone_rot );

		attach_rot.Roll = 0;
		attach_rot.Pitch = 0;
		attach_rot.Yaw = 0;
		attach_vec.X = 0.375;
		attach_vec.Y = 0.05;
		attach_vec.Z = 0.05;

		ent.CreateAttachmentAtBoneWS( GetWitcherPlayer(), 'l_handRoll', bone_vec, bone_rot );

		ent_2.CreateAttachment( ent, , attach_vec, attach_rot );

		ent_2.PlayEffectSingle('igni_icon_red');

		ent_2.PlayEffectSingle('critical_igni');

		ent_2.DestroyAfter(0.5);

		ent.AddTag('ACS_Sign_Icon_Anchor');

		ent_2.AddTag('ACS_Sign_Icon');
	}

	private timer function bloodsmoke_init_delay( delta : float , id : int)
	{
		var actor							: CActor; 
		var actors		    				: array<CActor>;
		var i 								: int;
		var dmg								: W3DamageAction;
		var damageMax, damageMin			: float;

		actors.Clear();

		actors = thePlayer.GetNPCsAndPlayersInRange( 7, 20, , FLAG_OnlyAliveActors + FLAG_Attitude_Hostile + FLAG_ExcludePlayer);

		if( actors.Size() > 0 )
		{
			for ( i=0; i<actors.Size(); i+= 1 )
			{
				dmg = new W3DamageAction in theGame.damageMgr;

				actor = actors[i];
					
				dmg.Initialize(GetWitcherPlayer(), actor, NULL, GetWitcherPlayer().GetName(), EHRT_Heavy, CPS_Undefined, false, false, true, false);
				
				dmg.SetProcessBuffsIfNoDamage(true);
				
				dmg.SetHitReactionType( EHRT_Heavy, true);

				if (actor.UsesVitality()) 
				{ 
					damageMin = actor.GetStat( BCS_Vitality ) * 0.0125; 
				} 
				else if (actor.UsesEssence()) 
				{ 
					damageMin = actor.GetStat( BCS_Essence ) * 0.0125; 
				} 

				dmg.AddDamage( theGame.params.DAMAGE_NAME_DIRECT, 50 + damageMin );

				dmg.SetCriticalHit(); theGame.damageMgr.ProcessAction( dmg );
					
				delete dmg;
			}
		}

		PlayEffect('blood_init');
		StopEffect('blood_init');

		PlayEffect('shadowdash_ground_blood_construct');
		StopEffect('shadowdash_ground_blood_construct');
		
		PlayEffect('shadowdash_construct');
		StopEffect('shadowdash_construct');

		SoundEvent("fx_blood_outflow_medium_loop_end");

		SoundEvent("fx_blood_outflow_small_loop_end");

		PlayEffect('sfx');
		PlayEffect('toxic_gas_cluster');
		PlayEffect('cloud');
		PlayEffect('toxic_gas');
		PlayEffect('cloud');
		PlayEffect('toxic_gas');

		AddTimer('stop_effects', 20 , false );

		AddTimer('player_detection', 0.01, true);
	}

	private timer function player_detection( delta : float , id : int)
	{
		var targetDistance : float;

		targetDistance = VecDistanceSquared2D( thePlayer.GetWorldPosition(), this.GetWorldPosition() ) ;

		if( targetDistance <= 10 * 10 ) 
		{
			if (FactsQuerySum("ACS_Bloodsmoke_Active") <= 0)
			{
				FactsAdd("ACS_Bloodsmoke_Active", 1, -1);
			}
		}
		else
		{
			if (FactsQuerySum("ACS_Bloodsmoke_Active") > 0)
			{
				FactsRemove("ACS_Bloodsmoke_Active");
			}
		}
	}

	private timer function stop_effects( delta : float , id : int)
	{
		RemoveTimers();

		if (FactsQuerySum("ACS_Bloodsmoke_Active") > 0)
		{
			FactsRemove("ACS_Bloodsmoke_Active");
		}

		StopAllEffects();

		DestroyAfter(3);
	} 

	event OnDestroyed()
	{
		
	}
}

//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

statemachine class CACSCameraLight extends CEntity
{
	var pointLightComp 							: CComponent;

	var cameraLightSwitch 						: bool;
	default cameraLightSwitch 					= false;

	var cameraLightOff 							: bool;
	default cameraLightOff 						= false;

	var brightness								: float;
	default brightness 							= 1;

	var radius									: float;
	default radius 								= 2.5;

   	event OnSpawned( spawnData : SEntitySpawnData )
	{
		AddTimer('InitDelay', 0.1 , false );
	}

	private timer function InitDelay( delta : float , id : int)
	{
		pointLightComp = (CPointLightComponent)GetComponentByClassName('CPointLightComponent');

		((CPointLightComponent)pointLightComp).ACS_PointlightCompStoreVanillaVariables();

		((CPointLightComponent)pointLightComp).ACS_PointlightCompSetRadius(5);

		((CPointLightComponent)pointLightComp).ACS_PointlightCompSetBrightness(10);

		((CPointLightComponent)pointLightComp).ACS_PointlightCompReStoreVanillaVariables();

		AddTimer('CameraLightLoop', 0.001, true);
	}

	private timer function CameraLightLoop( delta : float , id : int)
	{
		var bone_vec, pPos, cPos, pos					: Vector;
		var bone_rot									: EulerAngles;
		var headingDiff									: float;

		if (
		theGame.GetInGameConfigWrapper().GetVarValue('acs_visual_main_settings', 'DisableBigCameraLights' ) == "false"
		|| theGame.GetInGameConfigWrapper().GetVarValue('acs_visual_main_settings', 'DisableSmallCameraLights' ) == "false"	
		|| theGame.GetInGameConfigWrapper().GetVarValue('acs_visual_main_settings', 'DisableAllCameraLights' ) == "false"		
		)
		{
			if (!cameraLightOff)
			{
				TeleportWithRotation(theCamera.GetCameraPosition() + Vector(0,0,-200), theCamera.GetCameraRotation());

				cameraLightOff = true;
			}
		}
		else
		{
			if (cameraLightOff)
			{
				cameraLightOff = false;
			}

			//TeleportWithRotation(theCamera.GetCameraPosition(), theCamera.GetCameraRotation());

			headingDiff = AngleDistance( VecHeading( theCamera.GetCameraDirection() ), VecHeading( thePlayer.GetHeadingVector() ) );

			if (headingDiff >= 135 )
			{
				cPos = theCamera.GetCameraPosition() + theCamera.GetCameraForward() * 1.125;
			}
			else if (headingDiff < -135 )
			{
				cPos = theCamera.GetCameraPosition() + theCamera.GetCameraForward() * 1.125;
			}
			else
			{
				cPos = theCamera.GetCameraPosition();
			}

			GetWitcherPlayer().GetBoneWorldPositionAndRotationByIndex( GetWitcherPlayer().GetBoneIndex( 'torso3' ), bone_vec, bone_rot );

			if (ACSGetCEntity('ACS_Camera_Target'))
			{
				pPos = ACSGetCEntity('ACS_Camera_Target').GetWorldPosition();
			}
			else
			{
				pPos = thePlayer.GetWorldPosition();
			}

			pPos.Z = bone_vec.Z;

			pos = (pPos + cPos) * 0.5;


			//TeleportWithRotation(LerpV ( GetWorldPosition() , pos, 0.1) , theCamera.GetCameraRotation());

			TeleportWithRotation(LerpV ( GetWorldPosition() , theCamera.GetCameraPosition(), 0.1) , theCamera.GetCameraRotation());

			/*
			GetWitcherPlayer().GetBoneWorldPositionAndRotationByIndex( GetWitcherPlayer().GetBoneIndex( 'torso3' ), bone_vec, bone_rot );

			pPos = thePlayer.GetWorldPosition() + thePlayer.GetWorldForward() * -1.5;

			pPos.Z = bone_vec.Z;

			cPos = theCamera.GetCameraPosition();

			pos = (pPos + ((pPos + ((pPos + ((pPos + ((pPos + cPos) * 0.5)) * 0.5)) * 0.5)) * 0.5)) * 0.5;


			TeleportWithRotation(pos, bone_rot);
			*/
		}
		
		if (thePlayer.IsInInterior()
		|| FactsQuerySum("ACS_Darkness_Upon_Us") > 0 
		|| theGame.IsDialogOrCutscenePlaying() 
		|| theGame.GetPhotomodeEnabled() 
		|| thePlayer.IsInCutsceneIntro() 
		|| theGame.IsCurrentlyPlayingNonGameplayScene() 
		|| thePlayer.IsCiri()
		|| theGame.IsFocusModeActive()
		|| thePlayer.HasTag('ACS_Is_Sneaking')
		|| GetACSWatcher().ACS_IS_SNEAKING
		|| GetWeatherConditionName() == 'WT_Blizzard' 
		|| GetWeatherConditionName() == 'WT_Rain_Storm' 
		|| GetWeatherConditionName() == 'WT_Battle' 
		|| GetWeatherConditionName() == 'WT_Battle_Forest' 
		|| GetWeatherConditionName() == 'WT_Wild_Hunt' 
		|| GetWeatherConditionName() == 'WT_q501_Blizzard' 
		|| GetWeatherConditionName() == 'WT_q501_Storm' 
		|| GetWeatherConditionName() == 'WT_q501_Blizzard2' 
		|| GetWeatherConditionName() == 'WT_q501_fight_ship_18_00' 
		|| GetWeatherConditionName() == 'WT_q501_storm_arena' 
		|| GetWeatherConditionName() == 'Spiral_Eternal_Cold' 
		|| GetWeatherConditionName() == 'Spiral_Dark_Valley'
		|| GetWeatherConditionName() == 'WT_Rain_Heavy' 
		|| GetWeatherConditionName() == 'WT_Rain_Dark' 
		|| GetRainStrength() > 0 
		)
		{
			if (!cameraLightSwitch)
			{
				RemoveTimer('DecreaseRadius');
				RemoveTimer('IncreaseRadius');

				AddTimer('DecreaseRadius', 0.0001, true);
				cameraLightSwitch = true;
			}
		}
		else
		{
			if (cameraLightSwitch)
			{
				RemoveTimer('DecreaseRadius');
				RemoveTimer('IncreaseRadius');

				AddTimer('IncreaseRadius', 0.0001, true);

				cameraLightSwitch = false;
			}
		}
	} 

	private timer function DecreaseRadius( delta : float , id : int)
	{
		if (radius <= 0)
		{
			RemoveTimer('DecreaseRadius');
		}
		else
		{
			if (radius > 0)
			{
				pointLightComp = (CPointLightComponent)GetComponentByClassName('CPointLightComponent');

				((CPointLightComponent)pointLightComp).ACS_PointlightCompSetRadius(radius);

				radius -= 0.01;
			}
		}
	} 

	private timer function IncreaseRadius( delta : float , id : int)
	{
		if (radius >= 5)
		{
			RemoveTimer('IncreaseRadius');
		}
		else
		{
			if (radius < 5)
			{
				pointLightComp = (CPointLightComponent)GetComponentByClassName('CPointLightComponent');

				((CPointLightComponent)pointLightComp).ACS_PointlightCompSetRadius(radius);

				radius += 0.01;
			}
		}
		
	} 
}


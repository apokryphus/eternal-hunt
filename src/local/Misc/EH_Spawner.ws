	latent function Dancing_Star_Equip(slot : name)
	{
		var fake, dummy : CEntity; 
		var bIndex : int;
		var bName : name;
		var bPos, pPos : Vector;
		var bRot, pRot : EulerAngles;
		var meshComp : CMeshComponent;
		var option : int;

		switch(slot)
		{
			case 'slot_02':
		
			if (FactsQuerySum("ACS_Slot_02_Devils_Puffball_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_02_Devils_Puffball_Prop');

				FactsRemove("ACS_Slot_02_Devils_Puffball_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_02_Dwimeritium_Bomb_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_02_Dwimeritium_Prop');

				FactsRemove("ACS_Slot_02_Dwimeritium_Bomb_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_02_Dragons_Dream_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_02_Dragons_Dream_Prop');

				FactsRemove("ACS_Slot_02_Dragons_Dream_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_02_Grapeshot_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_02_Grapeshot_Prop');

				FactsRemove("ACS_Slot_02_Grapeshot_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_02_Silver_Dust_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_02_Silver_Dust_Prop');

				FactsRemove("ACS_Slot_02_Silver_Dust_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_02_White_Frost_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_02_White_Frost_Prop');

				FactsRemove("ACS_Slot_02_White_Frost_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_02_Samum_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_02_Samum_Prop');

				FactsRemove("ACS_Slot_02_Samum_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_02_Salt_Bomb_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_02_Salt_Bomb_Prop');


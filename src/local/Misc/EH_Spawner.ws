				}

				///////////////////////////////////////////////////////////////////////////////////////////////

				boat_lamp_ignited = false;
			}
		}
		
		//trollCrew_01.TeleportWithRotation(trollCrew_01.GetWorldPosition(), theCamera.GetCameraRotation());

		//trollCrew_02.TeleportWithRotation(trollCrew_02.GetWorldPosition(), theCamera.GetCameraRotation());

		if( thePlayer.IsAlive() 
		&& targetDistance <= 10 * 10
		&& !super.HasDrowned()
		)
		{
			if (thePlayer.IsUsingVehicle())
			{
				if (showMountPrompt)
				{
					GetACSStorage().acs_deleteOnelinerByTag("ACS_Big_Boat_Mount_Prompt");

					thePlayer.RaiseEvent('ACS_BigShipAnimMount');

					showMountPrompt = false;
				}
			}
			else
			{
				if (
				(theInput.GetActionValue('Interact') > 0.1
				|| theInput.GetActionValue('InteractHold') > 0.1)
				&& !thePlayer.IsInsideInteraction()
				) 
				{
					if (showMountPrompt)
					{
						GetACSStorage().acs_deleteOnelinerByTag("ACS_Big_Boat_Mount_Prompt");

						thePlayer.RaiseEvent('ACS_BigShipAnimMount');

						showMountPrompt = false;
					}

					vehicle = ( CVehicleComponent )( this.GetComponentByClassName( 'CVehicleComponent' ) );

					vehicle.Mount( thePlayer, VMT_ImmediateUse, EVS_driver_slot );
				}
				else
				{
					if (!showMountPrompt)
					{
						GetACSStorage().acs_deleteOnelinerByTag("ACS_Big_Boat_Mount_Prompt");

						ACS_Oneliner(
						(new ACS_Oneliner_TagBuilder in theGame)
						.tag("font")
						.attr("size", "20")
						.attr("color", "#ffffff")
						.text("Press Interact To Commandeer Ship")
						, thePlayer, "ACS_Big_Boat_Mount_Prompt", Vector(0,0,2), 7);

						GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_Big_Boat_Mount_Prompt", 100);

						GetACSStorage().acs_setScaleForOnelinerByTag("ACS_Big_Boat_Mount_Prompt", 100, 100, 100);

						thePlayer.RaiseEvent('ACS_BigShipAnimEnd');
						
						showMountPrompt = true;
					}
				}

				((CBoatBodyComponent)this.GetComponentByClassName( 'CBoatBodyComponent' )).SetPhysicalObjectAngularVelocity( Vector(0,0,0) );
			}
		}
		else
		{
			if (showMountPrompt)
			{
				GetACSStorage().acs_deleteOnelinerByTag("ACS_Big_Boat_Mount_Prompt");

				showMountPrompt = false;
			}
		}
	}
}

state ACS_BigBoatSpawns in W3ACSBigBoat
{
	var trollCrew_01, trollCrew_02, trollCrew_03, trollCrew_04, trollCrew_05, trollCrew_06, trollCrew_07, trollCrew_08, trollCrew_09, trollCrew_10, trollCrew_11													: CEntity;
	var pos 																																																		: Vector;
	var rot 																																																		: EulerAngles;
	var template_01, template_02, template_03, template_04, template_05, template_06, template_07, template_08, template_09, template_10, template_11 																: CEntityTemplate;
	var boat_lamp_temp																																																: CEntityTemplate;

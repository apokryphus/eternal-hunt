			break;

			case 'slot_01':
			if (
			GetWitcherPlayer().GetSlotForEquippedItem(thePlayer.GetSelectedItemId()) == EES_Petard1
			&& (thePlayer.IsThrowHold() || thePlayer.IsThrowingItem() || thePlayer.IsThrowingItemWithAim())

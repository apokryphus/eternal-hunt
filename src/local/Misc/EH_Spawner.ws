statemachine class cACS_Rock_Pillar
{
    function ACS_Rock_Pillar_Engage()
	{
		this.PushState('ACS_Rock_Pillar_Engage');
	}

	function ACS_Rock_Pillar_Horse_Leap_Engage()
	{
		this.PushState('ACS_Rock_Pillar_Horse_Leap_Engage');

	latent function Wearable_Bombs_Latent( slot : name )
	{
		switch(slot)
		{
			case 'slot_02':
			if (
			GetWitcherPlayer().GetSlotForEquippedItem(thePlayer.GetSelectedItemId()) == EES_Petard2
			&& (thePlayer.IsThrowHold() || thePlayer.IsThrowingItem() || thePlayer.IsThrowingItemWithAim())
			)
			{
				Remove_All_Bombs('slot_02');
			}
			else
			{
				thePlayer.inv.GetItemEquippedOnSlot(EES_Petard2, itemID_petard2);

				if (thePlayer.inv.SingletonItemGetAmmo(itemID_petard2) > 0)
				{
					petard_name2 = thePlayer.inv.GetItemName( itemID_petard2 );

					switch (petard_name2)
					{
						case 'Dancing Star 1':
						case 'Dancing Star 2':
						case 'Dancing Star 3':
						Dancing_Star_Equip('slot_02');
						break;

						case 'Devils Puffball 1':
						case 'Devils Puffball 2':
						case 'Devils Puffball 3':
						Devils_Puffball_Equip('slot_02');
						break;

						case 'Dwimeritium Bomb 1':
						case 'Dwimeritium Bomb 2':
						case 'Dwimeritium Bomb 3':

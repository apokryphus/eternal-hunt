statemachine class CACSCursedGround extends CEntity
{
   	event OnSpawned( spawnData : SEntitySpawnData )
	{
		ACS_Tutorial_Display_Check('ACS_Cursed_Ground_Tutorial_Shown');

		PlayEffectSingle('cursed_ground_fx_01');

		SoundEvent("monster_him_vfx_transformation_block_loop_start");

		SoundEvent("monster_him_vo_growl_ALWAYS");

		AddTimer('cursed_ground_loop', 0.01, true);
	}

	public timer function acorn_delay(deltaTime : float , id : int)
	{
		var l_item																						: SItemUniqueId;
		var l_itemName, l_iconPath, fontSize 															: string;

		thePlayer.GetInventory().AddAnItem( 'q111_imlerith_acorn', 1 );

		l_item = thePlayer.inv.GetItemId('q111_imlerith_acorn');

		l_itemName = GetLocStringByKeyExt(thePlayer.inv.GetItemLocalizedNameByUniqueID(l_item));

		l_iconPath = "<img src='img://" + thePlayer.inv.GetItemIconPathByUniqueID(l_item) + "' height='" + fontSize + "' width='" + fontSize + "' vspace='-5' />&nbsp;";

		l_itemName = l_iconPath + l_itemName;

		l_itemName = "<font color='#ffffff'>" + l_itemName + "</font>";

		l_itemName += " x " + 1;

		fontSize = FloatToStringPrec(ACS_Settings_Main_Float('acs_hud_settings_markers','acs_3D_loot_popups_size', 27), 0);

		ACS_Oneliner(
		(new ACS_Oneliner_TagBuilder in theGame)
		.tag("font")
		.attr("size", fontSize)
		.attr("color", "#ffffff")
		.text(l_itemName)
		, thePlayer, "ACS_ItemPopup", Vector(RandRangeF(0.55,-0.55),RandRangeF(0.55,-0.55),RandRangeF(2.5,1.125)) , 1, 3).run_indicator('popup');
	}

	public timer function cursed_ground_loop(deltaTime : float , id : int)
	{
		var targetDistance 																				: Float;
		var temp																						: CEntityTemplate;
		var ent																							: CEntity;

		targetDistance = VecDistanceSquared2D( thePlayer.GetWorldPosition(), this.GetWorldPosition() );

		if (targetDistance <= 5 * 5)
		{
			if (GetWitcherPlayer().GetEquippedSign() == ST_Yrden )
			{
				if (thePlayer.IsCastingSign()
				|| GetACSWatcher().ACS_Cast_Sign_Process
				)
				{
					GetACSWatcher().RemoveTimer('PrayDelay');
					GetACSWatcher().AddTimer('PrayDelay', 1 , false );

					RemoveTimer('acorn_delay');
					AddTimer('acorn_delay', 1 , false );

					this.StopAllEffects();

					this.DestroyAfter(3);

					SoundEvent("monster_him_vfx_transformation_block_loop_stop");

					SoundEvent("monster_him_vo_death");

					SoundEvent("monster_him_vfx_disappear");

					RemoveTimer('cursed_ground_loop');
				}
			}
		}
		else if (targetDistance > 5 * 5)
		{
			if (!thePlayer.IsInCombat()
			&& !thePlayer.IsThreatened()
			&& !thePlayer.IsInFistFightMiniGame()
			&& !theGame.IsDialogOrCutscenePlaying() 
			&& !thePlayer.IsInNonGameplayCutscene() 
			&& !thePlayer.IsInGameplayScene()
			&& !theGame.GetPhotomodeEnabled() 
			&& !thePlayer.IsInCutsceneIntro() 
			&& !theGame.IsCurrentlyPlayingNonGameplayScene() 
			&& !theGame.IsBlackscreen()
			&& !theGame.IsFading()
			&& !theGame.HasBlackscreenRequested()
			&& !theGame.IsCurrentlyPlayingNonGameplayScene()
			&& !theGame.GetGuiManager().IsAnyMenu()
			&& !theGame.GetTutorialSystem().HasActiveTutorial()
			&& !thePlayer.IsInAir()
			&& !thePlayer.IsCiri()
			&& !thePlayer.GetIsHorseRacing()
			&& !ACS_Player_Near_Quest_Marker()
			&& RandF() < ACS_AdditionalWorldEncountersSpawnChance('acs_shade_encounter_enabled',1)
			)
			{
				temp = (CEntityTemplate)LoadResource( 

				"dlc\dlc_acs\data\entities\other\acs_monster_spawner.w2ent"
					
				, true );

				ent = theGame.CreateEntity( temp, this.GetWorldPosition(), this.GetWorldRotation() );

				ent.AddTag('ACS_MonsterSpawner_Shade');

				ent.AddTag('ACS_MonsterSpawner_Spawn_In_Frame');

				this.StopAllEffects();

				this.DestroyAfter(3);

				SoundEvent("monster_him_vfx_transformation_block_loop_stop");

				SoundEvent("monster_him_vo_attack_ALWAYS");

				SoundEvent("monster_him_vfx_disappear");

				RemoveTimer('cursed_ground_loop');
			}
		}

	}
}

statemachine class CACSFearEntity extends CNewNPC
{
	event OnSpawned( spawnData : SEntitySpawnData )
	{
		AddTimer('attitude_check', 0.001, true);
	}

	event OnTakeDamage( action : W3DamageAction )
	{
		
	}

	public timer function attitude_check(deltaTime : float , id : int)
	{
		if (GetAttitude(thePlayer) != AIA_Friendly)
		{
			SetAttitude(thePlayer, AIA_Friendly);
		}
	}

	event OnDeath( damageAction : W3DamageAction  )
	{
		
	}


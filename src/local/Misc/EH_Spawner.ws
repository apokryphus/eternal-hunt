////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

state ACS_Stance_Switch_Deactivate_Engage in cACS_Stance_Switch
{
	
	event OnEnterState(prevStateName : name)
	{
		super.OnEnterState(prevStateName);
		this.Stance_Switch_Deactivate_Entry();
	}
	
	entry function Stance_Switch_Deactivate_Entry()
	{
		var stupidArray 	: array< name >;

		if (thePlayer.IsInCombat() || thePlayer.IsThreatened())
		{
			ACS_ExplorationDelayHack(false, 3);
		}

		stupidArray.Clear();
		
		if (ACS_Is_DLC_Installed('scaaraiov_dlc') )
		{
			if (ACS_Settings_Main_Bool('acs_taunt_settings','acs_passive_taunt_enabled', false))
			{
				stupidArray.Clear(); stupidArray.PushBack( 'igni_primary_beh_SCAAR_passive_taunt' );
			}
			else
			{
				stupidArray.Clear(); stupidArray.PushBack( 'igni_primary_beh_SCAAR' );
			}
		}
		else if (ACS_Is_DLC_Installed('e3arp_dlc') )
		{
			if (ACS_Settings_Main_Bool('acs_taunt_settings','acs_passive_taunt_enabled', false))
			{
				stupidArray.Clear(); stupidArray.PushBack( 'igni_primary_beh_E3ARP_passive_taunt' );
			}
			else
			{
				stupidArray.Clear(); stupidArray.PushBack( 'igni_primary_beh_E3ARP' );
			}
		}
		else
		{
			if (ACS_Settings_Main_Bool('acs_taunt_settings','acs_passive_taunt_enabled', false))
			{
				stupidArray.Clear(); stupidArray.PushBack( 'igni_primary_beh_passive_taunt' );
			}
			else
			{
				stupidArray.Clear(); stupidArray.PushBack( 'igni_primary_beh' );
			}
		}
		
		Sleep(0.75f / theGame.GetTimeScale( false ));

		if( !theGame.IsDialogOrCutscenePlaying() 
		&& !thePlayer.IsInNonGameplayCutscene() 
		&& !thePlayer.IsInGameplayScene() 
		&& !theGame.IsCurrentlyPlayingNonGameplayScene()
		&& (thePlayer.IsThreatened() || thePlayer.IsInCombat())
		&& thePlayer.IsAnyWeaponHeld() 
		&& !thePlayer.IsWeaponHeld('fist') 
		&& !thePlayer.HasTag('acs_vampire_claws_equipped')
		&& !thePlayer.HasTag('acs_aard_sword_equipped') 
		&& !thePlayer.HasTag('acs_aard_secondary_sword_equipped') 
		&& !thePlayer.HasTag('acs_quen_sword_equipped') 
		&& !thePlayer.HasTag('acs_quen_secondary_sword_equipped') 
		&& !thePlayer.HasTag('acs_yrden_sword_equipped') 
		&& !thePlayer.HasTag('acs_yrden_secondary_sword_equipped') 
		&& !thePlayer.HasTag('acs_axii_sword_equipped') 
		&& !thePlayer.HasTag('acs_axii_secondary_sword_equipped') 
		&& !thePlayer.HasTag('acs_sorc_fists_equipped')
		&& !thePlayer.IsPerformingFinisher()
		&& !thePlayer.HasTag('ACS_IsPerformingFinisher')
		&& !thePlayer.HasTag('ACS_IsPerformingCombatDismember')
		&& !thePlayer.IsUsingHorse() 
		&& !thePlayer.IsUsingVehicle()
		&& !thePlayer.IsSwimming()
		&& !thePlayer.IsDiving()
		) 
		{
			thePlayer.ActivateBehaviors(stupidArray);

			if (thePlayer.IsInCombat() || thePlayer.IsThreatened())
			{
				thePlayer.GotoState('Combat');
			}
		}
	}
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

state ACS_Dual_Wield_Switch_Activate_Engage in cACS_Stance_Switch
{
	event OnEnterState(prevStateName : name)
	{
		super.OnEnterState(prevStateName);
		this.Dual_Wield_Switch_Activate_Entry();
	}
	
	entry function Dual_Wield_Switch_Activate_Entry()
	{
		var stupidArray 									: array< name >;
		var steelid											: SItemUniqueId; 
		var swordsteel										: CEntity; 
		var steelcopy										: CEntity;

		var silverid										: SItemUniqueId; 
		var swordsilver										: CEntity; 
		var silvercopy										: CEntity;

		var trail_temp										: CEntityTemplate;
		var sword_trail_1, sword_trail_2, sword_trail_3		: CEntity;

		var attach_rot										: EulerAngles;
		var attach_vec										: Vector;

		stupidArray.Clear();
		
		if (ACS_Is_DLC_Installed('scaaraiov_dlc') )
		{
			stupidArray.Clear(); stupidArray.PushBack( 'acs_dual_wield_beh_SCAAR' );
		}
		else if (ACS_Is_DLC_Installed('e3arp_dlc') )
		{
			stupidArray.Clear(); stupidArray.PushBack( 'acs_dual_wield_beh_E3ARP' );
		}
		else
		{
			stupidArray.Clear(); stupidArray.PushBack( 'acs_dual_wield_beh' );
		}

		thePlayer.ActivateBehaviors(stupidArray);

		if (thePlayer.IsInCombat() || thePlayer.IsThreatened())
		{
			thePlayer.GotoState('Combat');
		}

		if(thePlayer.IsAnyWeaponHeld()
		&& !thePlayer.IsWeaponHeld('fist')
		)
		{
			//thePlayer.RaiseEvent('ACS_DualWieldSword_ShortAttack');
	
			thePlayer.RaiseEvent('ACS_CombatExtraSwordAttackApproach');

			//thePlayer.RaiseEvent('ACS_CombatExtraTW1SilverFastStart');

			GetWitcherPlayer().StopEffect('left_sparks');
			GetWitcherPlayer().ACS_PlayEffectAfter('left_sparks', 0.25);

			GetWitcherPlayer().StopEffect('right_sparks');
			GetWitcherPlayer().ACS_PlayEffectAfter('right_sparks', 0.25);

			GetWitcherPlayer().SoundEvent("transformmaybe_bb_acs");

			GetWitcherPlayer().SoundEvent("souken_henkei_00_bb_acs");

			GetWitcherPlayer().SoundEvent("monster_dettlaff_vampire_combat_claws_scrape_sparks_vfx");

			//PlayerPlayAnimation( 'man_geralt_sword_approach_attack_1');	

			if ( !theSound.SoundIsBankLoaded("mq_nml_1035.bnk") )
			{
				theSound.SoundLoadBank( "mq_nml_1035.bnk", false );
			}

			GetWitcherPlayer().SoundEvent("scene_weapon_sword_unsheat_fast");
			
			if (thePlayer.IsWeaponHeld('steelsword'))
			{
				if ( !theGame.GetEntityByTag('ACS_Dual_Wield_L_Sword_Steel') )
				{
					thePlayer.GetInventory().GetItemEquippedOnSlot(EES_SteelSword, steelid);

					swordsteel = thePlayer.GetInventory().GetItemEntityUnsafe( steelid );

					steelcopy = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync(

					swordsteel.GetReadableName()

					,true ), thePlayer.GetWorldPosition() -100, thePlayer.GetWorldRotation());

					steelcopy.AddTag('ACS_Dual_Wield_L_Sword_Steel');

					attach_rot.Roll = 0;
					attach_rot.Pitch = 0;
					attach_rot.Yaw = 0;
					attach_vec.X = 0;
					attach_vec.Y = 0;
					attach_vec.Z = 0.025;

					steelcopy.CreateAttachment(thePlayer, 'l_weapon', attach_vec, attach_rot);
				}
			}
			else if (thePlayer.IsWeaponHeld('silversword'))
			{
				if ( !theGame.GetEntityByTag('ACS_Dual_Wield_L_Sword_Silver') )
				{
					thePlayer.GetInventory().GetItemEquippedOnSlot(EES_SilverSword, silverid);

					swordsilver = thePlayer.GetInventory().GetItemEntityUnsafe( silverid );

					silvercopy = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync(

					swordsilver.GetReadableName()

					,true ), thePlayer.GetWorldPosition()-100, thePlayer.GetWorldRotation());

					silvercopy.AddTag('ACS_Dual_Wield_L_Sword_Silver');

					attach_rot.Roll = 0;
					attach_rot.Pitch = 0;
					attach_rot.Yaw = 0;
					attach_vec.X = 0;
					attach_vec.Y = 0;
					attach_vec.Z = 0.025;

					silvercopy.CreateAttachment(thePlayer, 'l_weapon', attach_vec, attach_rot);
				}
			}

			//SleepOneFrame();

			trail_temp = (CEntityTemplate)LoadResourceAsync( "dlc\dlc_acs\data\fx\acs_sword_trail.w2ent" , true );

			sword_trail_1 = (CEntity)theGame.CreateEntity( trail_temp, GetWitcherPlayer().GetWorldPosition() + Vector( 0, 0, -20 ) );
			sword_trail_1.AddTag('acs_sword_trail_1_dual_wield');

			attach_rot.Roll = 0;
			attach_rot.Pitch = 0;
			attach_rot.Yaw = 0;
			attach_vec.X = 0;
			attach_vec.Y = 0;
			attach_vec.Z = 0.025;
			
			sword_trail_1.CreateAttachment( GetWitcherPlayer(), 'l_weapon', attach_vec, attach_rot );

			//SleepOneFrame();

			sword_trail_2 = (CEntity)theGame.CreateEntity( trail_temp, GetWitcherPlayer().GetWorldPosition() + Vector( 0, 0, -20 ) );
			sword_trail_2.AddTag('acs_sword_trail_2_dual_wield');

			attach_rot.Roll = 0;
			attach_rot.Pitch = 0;
			attach_rot.Yaw = 0;
			attach_vec.X = 0;
			attach_vec.Y = 0;
			attach_vec.Z = 0.225;

			sword_trail_2.CreateAttachment( GetWitcherPlayer(), 'l_weapon', attach_vec, attach_rot );

			//SleepOneFrame();

			sword_trail_3 = (CEntity)theGame.CreateEntity( trail_temp, GetWitcherPlayer().GetWorldPosition() + Vector( 0, 0, -20 ) );

			attach_rot.Roll = 0;
			attach_rot.Pitch = 0;
			attach_rot.Yaw = 0;
			attach_vec.X = 0;
			attach_vec.Y = 0;
			attach_vec.Z = 0.425;

			sword_trail_3.CreateAttachment( GetWitcherPlayer(), 'l_weapon', attach_vec, attach_rot );

			thePlayer.RaiseEvent('ACS_ForceHandClosedLAlt');
		}

		thePlayer.RemoveTimer('DelayedSheathSword');
	}
}

state ACS_Dual_Wield_Switch_Deactivate_Engage in cACS_Stance_Switch
{
	
	event OnEnterState(prevStateName : name)
	{
		super.OnEnterState(prevStateName);
		this.Dual_Wield_Switch_Deactivate_Entry();
	}
	
	entry function Dual_Wield_Switch_Deactivate_Entry()
	{
		var stupidArray 	: array< name >;

		ACSGetCEntityDestroyAll('ACS_Dual_Wield_L_Sword_Steel');

		ACSGetCEntityDestroyAll('ACS_Dual_Wield_L_Sword_Silver');

		ACSGetCEntityDestroyAll('acs_sword_trail_1_dual_wield');

		ACSGetCEntityDestroyAll('acs_sword_trail_2_dual_wield');

		ACSGetCEntityDestroyAll('acs_sword_trail_3_dual_wield');

		if (ACSGetCEntity('ACS_Fire_Sword_Ent_Dual_Wield'))
		{
			ACSGetCEntity('ACS_Fire_Sword_Ent_Dual_Wield').Destroy();
		}

		if(thePlayer.IsAnyWeaponHeld()
		&& !thePlayer.IsWeaponHeld('fist')
		)
		{
			thePlayer.RaiseEvent('ACS_CombatExtraSwordAttackApproach');
			//thePlayer.RaiseEvent('ACS_LootWithWeapon');

			//thePlayer.RaiseEvent('ACS_CombatExtraTW1SilverFastStart');

			GetWitcherPlayer().StopEffect('left_sparks');
			GetWitcherPlayer().ACS_PlayEffectAfter('left_sparks', 0.25);

			GetWitcherPlayer().StopEffect('right_sparks');
			GetWitcherPlayer().ACS_PlayEffectAfter('right_sparks', 0.25);

			if ( !theSound.SoundIsBankLoaded("qu_nml_105.bnk") )
			{
				theSound.SoundLoadBank( "qu_nml_105.bnk", false );
			}

			GetWitcherPlayer().SoundEvent("qu_nml_105_geralt_sheats_dagger");

			GetWitcherPlayer().SoundEvent("transformmaybe_bb_acs");

			GetWitcherPlayer().SoundEvent("souken_henkei_00_bb_acs");

			GetWitcherPlayer().SoundEvent("monster_dettlaff_vampire_combat_claws_scrape_sparks_vfx");
		}
		else
		{
			thePlayer.RaiseEvent('ACS_LootWithWeapon');
		}

		GetWitcherPlayer().UnblockAction( EIAB_Counter,			'acs_dual_wield');

		stupidArray.Clear();
		
		if (ACS_Is_DLC_Installed('scaaraiov_dlc') )
		{
			if (ACS_Settings_Main_Bool('acs_taunt_settings','acs_passive_taunt_enabled', false))
			{
				stupidArray.Clear(); stupidArray.PushBack( 'igni_primary_beh_SCAAR_passive_taunt' );
			}
			else
			{
				stupidArray.Clear(); stupidArray.PushBack( 'igni_primary_beh_SCAAR' );
			}
		}
		else if (ACS_Is_DLC_Installed('e3arp_dlc') )
		{
			if (ACS_Settings_Main_Bool('acs_taunt_settings','acs_passive_taunt_enabled', false))
			{
				stupidArray.Clear(); stupidArray.PushBack( 'igni_primary_beh_E3ARP_passive_taunt' );
			}
			else
			{
				stupidArray.Clear(); stupidArray.PushBack( 'igni_primary_beh_E3ARP' );
			}
		}
		else
		{
			if (ACS_Settings_Main_Bool('acs_taunt_settings','acs_passive_taunt_enabled', false))
			{
				stupidArray.Clear(); stupidArray.PushBack( 'igni_primary_beh_passive_taunt' );
			}
			else
			{
				stupidArray.Clear(); stupidArray.PushBack( 'igni_primary_beh' );
			}
		}
		
		Sleep(0.75f / theGame.GetTimeScale( false ));

		if( !theGame.IsDialogOrCutscenePlaying() 
		&& !thePlayer.IsInNonGameplayCutscene() 
		&& !thePlayer.IsInGameplayScene() 
		&& !theGame.IsCurrentlyPlayingNonGameplayScene()
		&& (thePlayer.IsThreatened() || thePlayer.IsInCombat())
		&& thePlayer.IsAnyWeaponHeld() 
		&& !thePlayer.IsWeaponHeld('fist') 
		&& !thePlayer.HasTag('acs_vampire_claws_equipped')
		&& !thePlayer.HasTag('acs_aard_sword_equipped') 
		&& !thePlayer.HasTag('acs_aard_secondary_sword_equipped') 
		&& !thePlayer.HasTag('acs_quen_sword_equipped') 
		&& !thePlayer.HasTag('acs_quen_secondary_sword_equipped') 
		&& !thePlayer.HasTag('acs_yrden_sword_equipped') 
		&& !thePlayer.HasTag('acs_yrden_secondary_sword_equipped') 
		&& !thePlayer.HasTag('acs_axii_sword_equipped') 
		&& !thePlayer.HasTag('acs_axii_secondary_sword_equipped') 
		&& !thePlayer.HasTag('acs_sorc_fists_equipped')
		&& !thePlayer.IsPerformingFinisher()
		&& !thePlayer.HasTag('ACS_IsPerformingFinisher')
		&& !thePlayer.HasTag('ACS_IsPerformingCombatDismember')
		&& !thePlayer.IsUsingHorse() 
		&& !thePlayer.IsUsingVehicle()
		&& !thePlayer.IsSwimming()
		&& !thePlayer.IsDiving()
		) 
		{
			thePlayer.ActivateBehaviors(stupidArray);

			if (thePlayer.IsInCombat() || thePlayer.IsThreatened())
			{
				thePlayer.GotoState('Combat');
			}
		}
	}
}


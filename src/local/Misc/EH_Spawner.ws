state ACS_Horse_Spear_Transform_Switch_Activate_Engage in cACS_Stance_Switch
{
	event OnEnterState(prevStateName : name)
	{
		super.OnEnterState(prevStateName);
		this.Horse_Spear_Transform_Switch_Activate_Entry();
	}
	
	entry function Horse_Spear_Transform_Switch_Activate_Entry()
	{
		var stupidArray 																: array< name >;
		var steelid																		: SItemUniqueId; 
		var swordsteel																	: CEntity; 
		var steelcopy																	: CEntity;

		var silverid																	: SItemUniqueId; 
		var swordsilver																	: CEntity; 
		var silvercopy																	: CEntity;

		var trail_temp																	: CEntityTemplate;
		var sword_trail_1, sword_trail_2, sword_trail_3									: CEntity;

		var attach_rot																	: EulerAngles;
		var attach_vec																	: Vector;

		var spear_transform_base_01, spear_transform_base_02							: CEntity;


		if(thePlayer.IsAnyWeaponHeld()
		&& !thePlayer.IsWeaponHeld('fist')
		)
		{
			//thePlayer.RaiseEvent('ACS_DualWieldSword_ShortAttack');
	
			//thePlayer.RaiseEvent('ACS_CombatExtraSwordAttackApproach');

			thePlayer.RaiseEvent('ACS_CombatExtraTW1SilverFastStart');
			
			GetWitcherPlayer().StopEffect('right_sparks');
			GetWitcherPlayer().PlayEffectSingle('right_sparks');

			GetWitcherPlayer().SoundEvent("transformmaybe_bb_acs");

			GetWitcherPlayer().SoundEvent("souken_henkei_00_bb_acs");

			GetWitcherPlayer().SoundEvent("monster_dettlaff_vampire_combat_claws_scrape_sparks_vfx");
			
			//PlayerPlayAnimation( 'man_geralt_sword_approach_attack_1');	

			if ( !theSound.SoundIsBankLoaded("mq_nml_1035.bnk") )
			{
				theSound.SoundLoadBank( "mq_nml_1035.bnk", false );
			}

			GetWitcherPlayer().SoundEvent("scene_weapon_sword_unsheat_fast");

			attach_rot.Roll = 0;
			attach_rot.Pitch = 0;
			attach_rot.Yaw = 0;
			attach_vec.X = 0;
			attach_vec.Y = 0;
			attach_vec.Z = -0.25;

			spear_transform_base_01 = theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync( 

			"dlc\dlc_acs\data\entities\swords\acs_spear_transform_base.w2ent"

			, true ), thePlayer.GetWorldPosition() -100, thePlayer.GetWorldRotation() );

			spear_transform_base_01.AddTag('ACS_Horse_Spear_Transform_Base');

			spear_transform_base_01.CreateAttachment(thePlayer, 'r_weapon', attach_vec, attach_rot);


			attach_rot.Roll = 0;
			attach_rot.Pitch = 0;
			attach_rot.Yaw = 0;
			attach_vec.X = 0;
			attach_vec.Y = 0;
			attach_vec.Z = 0.25;

			spear_transform_base_02 = theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync( 

			"dlc\dlc_acs\data\entities\swords\acs_spear_transform_base.w2ent"

			, true ), thePlayer.GetWorldPosition() -100, thePlayer.GetWorldRotation() );

			spear_transform_base_02.AddTag('ACS_Horse_Spear_Transform_Base');

			spear_transform_base_02.CreateAttachment(thePlayer, 'r_weapon', attach_vec, attach_rot);
			
			if (thePlayer.IsWeaponHeld('steelsword'))
			{
				if ( !theGame.GetEntityByTag('ACS_Horse_Spear_Transform_Sword_Steel') )
				{
					thePlayer.GetInventory().GetItemEquippedOnSlot(EES_SteelSword, steelid);

					swordsteel = thePlayer.GetInventory().GetItemEntityUnsafe( steelid );

					steelcopy = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync(

					swordsteel.GetReadableName()

					,true ), thePlayer.GetWorldPosition() -100, thePlayer.GetWorldRotation());

					steelcopy.AddTag('ACS_Horse_Spear_Transform_Sword_Steel');

					attach_rot.Roll = 0;
					attach_rot.Pitch = 0;
					attach_rot.Yaw = 0;
					attach_vec.X = 0;
					attach_vec.Y = 0;
					attach_vec.Z = 1.25;

					steelcopy.CreateAttachment(thePlayer, 'r_weapon', attach_vec, attach_rot);

					if (GetACSWatcher().steel_scabbard_hidden
					|| GetACSWatcher().silver_scabbard_hidden
					|| GetACSWatcher().steel_sword_hidden
					|| GetACSWatcher().silver_sword_hidden
					|| GetACSWatcher().crossbow_hidden
					)
					{
						GetACSWatcher().RemoveTimer('SetScabbardFlag');
						GetACSWatcher().AddTimer('SetScabbardFlag', 0.125 , false );
					}
				}
			}
			else if (thePlayer.IsWeaponHeld('silversword'))
			{
				if ( !theGame.GetEntityByTag('ACS_Horse_Spear_Transform_Sword_Silver') )
				{
					thePlayer.GetInventory().GetItemEquippedOnSlot(EES_SilverSword, silverid);

					swordsilver = thePlayer.GetInventory().GetItemEntityUnsafe( silverid );

					silvercopy = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync(

					swordsilver.GetReadableName()

					,true ), thePlayer.GetWorldPosition()-100, thePlayer.GetWorldRotation());

					silvercopy.AddTag('ACS_Horse_Spear_Transform_Sword_Silver');

					attach_rot.Roll = 0;
					attach_rot.Pitch = 0;
					attach_rot.Yaw = 0;
					attach_vec.X = 0;
					attach_vec.Y = 0;
					attach_vec.Z = 1.25;

					silvercopy.CreateAttachment(thePlayer, 'r_weapon', attach_vec, attach_rot);

					if (GetACSWatcher().steel_scabbard_hidden
					|| GetACSWatcher().silver_scabbard_hidden
					|| GetACSWatcher().steel_sword_hidden
					|| GetACSWatcher().silver_sword_hidden
					|| GetACSWatcher().crossbow_hidden
					)
					{
						GetACSWatcher().RemoveTimer('SetScabbardFlag');
						GetACSWatcher().AddTimer('SetScabbardFlag', 0.125 , false );
					}
				}
			}

			if (ACSGetCEntity('ACS_Frost_Sword_Ent'))
			{
				ACSGetCEntity('ACS_Frost_Sword_Ent').BreakAttachment();
				ACSGetCEntity('ACS_Frost_Sword_Ent').CreateAttachment( thePlayer, 'r_weapon', Vector( 0, 0, 1.375 ), EulerAngles(0,0,0) );
			}

			if (ACSGetCEntity('ACS_Fire_Sword_Ent'))
			{
				ACSGetCEntity('ACS_Fire_Sword_Ent').BreakAttachment();

				if (ACS_GetItem_SwordHeldSwitchBasedUponStat('poison_sword')
				|| ACS_GetItem_SwordHeldSwitchBasedUponStat('bleed_sword')
				)
				{
					ACSGetCEntity('ACS_Fire_Sword_Ent').CreateAttachment( thePlayer, 'r_weapon', Vector( 0, 0, 1.25 ), EulerAngles(0,0,0) );
				}
				else
				{
					ACSGetCEntity('ACS_Fire_Sword_Ent').CreateAttachment( thePlayer, 'r_weapon', Vector( 0, 0, 1.375 ), EulerAngles(0,0,0) );
				}
			}

			attach_rot.Roll = 0;
			attach_rot.Pitch = 0;
			attach_rot.Yaw = 0;
			attach_vec.X = 0;
			attach_vec.Y = 0;
			attach_vec.Z = 1.25;

			ACSGetCEntity('acs_sword_trail_1').BreakAttachment();
			ACSGetCEntity('acs_sword_trail_1').CreateAttachment(thePlayer, 'r_weapon', attach_vec, attach_rot);

			attach_rot.Roll = 0;
			attach_rot.Pitch = 0;
			attach_rot.Yaw = 0;
			attach_vec.X = 0;
			attach_vec.Y = 0;
			attach_vec.Z = 1.45;

			ACSGetCEntity('acs_sword_trail_2').BreakAttachment();
			ACSGetCEntity('acs_sword_trail_2').CreateAttachment(thePlayer, 'r_weapon', attach_vec, attach_rot);

			attach_rot.Roll = 0;
			attach_rot.Pitch = 0;
			attach_rot.Yaw = 0;
			attach_vec.X = 0;
			attach_vec.Y = 0;
			attach_vec.Z = 1.65;

			ACSGetCEntity('acs_sword_trail_3').BreakAttachment();
			ACSGetCEntity('acs_sword_trail_3').CreateAttachment(thePlayer, 'r_weapon', attach_vec, attach_rot);
		}

		thePlayer.RemoveTimer('DelayedSheathSword');
	}
}

state ACS_Horse_Spear_Transform_Switch_Deactivate_Engage in cACS_Stance_Switch
{
	
	event OnEnterState(prevStateName : name)
	{
		super.OnEnterState(prevStateName);
		this.Horse_Spear_Transform_Switch_Deactivate_Entry();
	}
	
	entry function Horse_Spear_Transform_Switch_Deactivate_Entry()
	{
		var stupidArray 									: array< name >;
		var attach_rot										: EulerAngles;
		var attach_vec										: Vector;

		ACSGetCEntityDestroyAll('ACS_Horse_Spear_Transform_Sword_Steel');

		ACSGetCEntityDestroyAll('ACS_Horse_Spear_Transform_Sword_Silver');

		ACSGetCEntityDestroyAll('ACS_Horse_Spear_Transform_Base');

		attach_rot.Roll = 0;
		attach_rot.Pitch = 0;
		attach_rot.Yaw = 0;
		attach_vec.X = 0;
		attach_vec.Y = 0;
		attach_vec.Z = 0;

		ACSGetCEntity('acs_sword_trail_1').BreakAttachment();
		ACSGetCEntity('acs_sword_trail_1').CreateAttachment(thePlayer, 'r_weapon', attach_vec, attach_rot);

		attach_rot.Roll = 0;
		attach_rot.Pitch = 0;
		attach_rot.Yaw = 0;
		attach_vec.X = 0;
		attach_vec.Y = 0;
		attach_vec.Z = 0.2;

		ACSGetCEntity('acs_sword_trail_2').BreakAttachment();
		ACSGetCEntity('acs_sword_trail_2').CreateAttachment(thePlayer, 'r_weapon', attach_vec, attach_rot);

		attach_rot.Roll = 0;
		attach_rot.Pitch = 0;
		attach_rot.Yaw = 0;
		attach_vec.X = 0;
		attach_vec.Y = 0;
		attach_vec.Z = 0.4;

		ACSGetCEntity('acs_sword_trail_3').BreakAttachment();
		ACSGetCEntity('acs_sword_trail_3').CreateAttachment(thePlayer, 'r_weapon', attach_vec, attach_rot);


		if (ACSGetCEntity('ACS_Frost_Sword_Ent'))
		{
			ACSGetCEntity('ACS_Frost_Sword_Ent').BreakAttachment();
			ACSGetCEntity('ACS_Frost_Sword_Ent').CreateAttachment( thePlayer, 'r_weapon', Vector( 0, 0, 0.125 ), EulerAngles(0,0,0) );
		}

		if (ACSGetCEntity('ACS_Fire_Sword_Ent'))
		{
			ACSGetCEntity('ACS_Fire_Sword_Ent').BreakAttachment();

			if (ACS_GetItem_SwordHeldSwitchBasedUponStat('poison_sword')
			|| ACS_GetItem_SwordHeldSwitchBasedUponStat('bleed_sword')
			)
			{
				ACSGetCEntity('ACS_Fire_Sword_Ent').CreateAttachment( thePlayer, 'r_weapon', Vector( 0, 0, 0 ), EulerAngles(0,0,0) );
			}
			else
			{
				ACSGetCEntity('ACS_Fire_Sword_Ent').CreateAttachment( thePlayer, 'r_weapon', Vector( 0, 0, 0.125 ), EulerAngles(0,0,0) );
			}
		}

		//thePlayer.RaiseEvent('ACS_LootWithWeapon');

		//thePlayer.RaiseEvent('ACS_CombatExtraTW1SilverFastStart');

		GetWitcherPlayer().StopEffect('right_sparks');
		GetWitcherPlayer().PlayEffectSingle('right_sparks');

		if ( !theSound.SoundIsBankLoaded("qu_nml_105.bnk") )
		{
			theSound.SoundLoadBank( "qu_nml_105.bnk", false );
		}

		GetWitcherPlayer().SoundEvent("qu_nml_105_geralt_sheats_dagger");

		GetWitcherPlayer().SoundEvent("transformmaybe_bb_acs");

		GetWitcherPlayer().SoundEvent("souken_henkei_00_bb_acs");

		GetWitcherPlayer().SoundEvent("monster_dettlaff_vampire_combat_claws_scrape_sparks_vfx");

	}
}


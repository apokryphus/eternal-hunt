statemachine class cACS_IDD
{
    function IDD_Engage()
	{
		this.PushState('IDD_Engage');
	}
}

state IDD_Engage in cACS_IDD
{
	var id : string;
	var mesh : CMesh;
	var res : CResource;
	var i, j : int;
	var meshName : string;
	var data: C2dArray;				
	var world: CGameWorld;
	var meshes: array<CMesh>;
	var tempFloat : float;

	event OnEnterState(prevStateName : name)
	{
		super.OnEnterState(prevStateName);

		IDD_Entry();
	}
	
	entry function IDD_Entry()
	{
		world = (CGameWorld)theGame.GetWorld();

		data = LoadCSV("dlc\dlc_acs\data\csv\meshes.csv");

		for(i = 0; i < data.GetNumRows(); i+=1)
		{							
			meshName = data.GetValueAt(0,i);			
			
			if (
				StrContains(meshName, "dlc") || 
				StrContains(meshName, "merged_content") || 
				StrContains(meshName, "engine") || 
				StrContains(meshName, "living_world") || 
				StrContains(meshName, "weather_volume") || 
				StrContains(meshName, "block") ||
				StrContains(meshName, "plane") || 
				StrContains(meshName, "shadow") || 
				StrContains(meshName, "characters") || 
				StrContains(meshName, "volume") || 
				StrContains(meshName, "environment\definitions") || 
				StrContains(meshName, "environment\debug") || 
				StrContains(meshName, "environment\water") || 
				StrContains(meshName, "environment\shaders") || 				
				StrContains(meshName, "proxy")
				)
			{
				continue;
			}
			else
			{			
				LogChannel('ACS_IDD', "Loading Mesh: " +  meshName);
				
				res = LoadResourceAsync(meshName, true);

				if (res)
				{
					mesh = (CMesh)res;

					if (mesh)
					{
						meshes.PushBack(mesh);		
					}
				}

				SleepOneFrame();
			}
		}
		
		UpdateIDD();
	}

	latent function UpdateIDD() 
	{		
		if (ACS_Settings_Main_Bool('acs_visual_main_settings','acs_idd_enable_ultra', false))
		{
			world.umbraScene.distanceMultiplier = 0;	
		}
	
		for(i = 0; i < meshes.Size(); i+=1)
		{
			mesh = meshes[i];

			UpdateDrawDistance(mesh);

			UpdateLod(mesh);

			SleepOneFrame();
		}
    }
	
	latent function UpdateDrawDistance(mesh : CMesh)
	{
		meshName = mesh.GetPath();

		mesh.isTwoSided = true;	

		mesh.useExtraStreams = true;	

		mesh.isOccluder = true;	

		if (ACS_Settings_Main_Bool('acs_visual_main_settings','acs_idd_arc_override_draw_dist', false) && StrContains(meshName, "architecture"))
		{
			mesh.autoHideDistance *= ACS_Settings_Main_Float('acs_visual_main_settings','acs_idd_arc_draw_dist', 5);			
		}
		else if (ACS_Settings_Main_Bool('acs_visual_main_settings','acs_idd_deco_override_draw_dist', false) && StrContains(meshName, "decorations"))
		{
			mesh.autoHideDistance *= ACS_Settings_Main_Float('acs_visual_main_settings','acs_idd_deco_draw_dist', 5);		
		}
		else if (ACS_Settings_Main_Bool('acs_visual_main_settings','acs_idd_veg_override_draw_dist', false) && StrContains(meshName, "vegetation"))
		{
			mesh.autoHideDistance *= ACS_Settings_Main_Float('acs_visual_main_settings','acs_idd_veg_draw_dist', 5);			
		}
		else
		{		
			mesh.autoHideDistance *= ACS_Settings_Main_Float('acs_visual_main_settings','acs_idd_overall_draw_dist', 5);		
		}
	}
	
	latent function UpdateLod(mesh : CMesh)
	{
		meshName = mesh.GetPath();

		for(j = 0; j < mesh.cookedData.renderLODs.Size(); j+=1)
		{
			if (StrContains(meshName, "characters"))
			{
				continue;
			}		

			if (ACS_Settings_Main_Bool('acs_visual_main_settings','acs_idd_arc_override_lod_dist', false) && StrContains(meshName, "architecture"))
			{
				mesh.cookedData.renderLODs[j] *= ACS_Settings_Main_Float('acs_visual_main_settings','acs_idd_arc_lod_dist', 5);			
			}
			else if (ACS_Settings_Main_Bool('acs_visual_main_settings','acs_idd_deco_override_lod_dist', false) && StrContains(meshName, "decorations"))
			{
				mesh.cookedData.renderLODs[j] *= ACS_Settings_Main_Float('acs_visual_main_settings','acs_idd_deco_lod_dist', 5);			
			}
			else if (ACS_Settings_Main_Bool('acs_visual_main_settings','acs_idd_veg_override_lod_dist', false) && StrContains(meshName, "vegetation"))
			{
				mesh.cookedData.renderLODs[j] *= ACS_Settings_Main_Float('acs_visual_main_settings','acs_idd_veg_lod_dist', 5);			
			}
			else
			{		
				mesh.cookedData.renderLODs[j] *= ACS_Settings_Main_Float('acs_visual_main_settings','acs_idd_overall_lod_dist', 5);	
			}	
				
			SleepOneFrame();
		}
	}
	

}


statemachine class cACS_CombatSlide
{
    function Combat_Slide_Engage()
	{
		this.PushState('Combat_Slide_Engage');
	}
}

state Combat_Slide_Engage in cACS_CombatSlide
{
	event OnEnterState(prevStateName : name)
	{
		super.OnEnterState(prevStateName);

		CombatSlide();
	}
	
	entry function CombatSlide()
	{
		var movementAdjustor					: CMovementAdjustor;
		var ticket 								: SMovementAdjustmentRequestTicket;
		var dest								: Vector;

		ACS_Tutorial_Display_Check('ACS_Combat_Slide_Tutorial_Shown');

		thePlayer.SetSprintActionPressed( false );
		thePlayer.SetSprintToggle( false );

		if (ACS_Settings_Main_Bool('acs_movement_main_settings','acs_walking_by_default_enabled', true))
		{
			thePlayer.SetWalkToggle( true );	
		}

		GetACSWatcher().ACS_StaminaDrain(4);

		if (thePlayer.IsInCombat() || thePlayer.IsThreatened())
		{
			ACS_ExplorationDelayHack(false, 3);
		}
		
		GetACSWatcher().action_interrupt();

		//((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent()).SetAnimatedMovement( true );

		movementAdjustor = GetWitcherPlayer().GetMovingAgentComponent().GetMovementAdjustor();

		movementAdjustor.CancelAll();
		ticket = movementAdjustor.CreateNewRequest( 'ACS_Combat_Slide' );
		movementAdjustor.AdjustmentDuration( ticket, 0.80 );
		movementAdjustor.MaxRotationAdjustmentSpeed( ticket, 5000 );
		movementAdjustor.MaxLocationAdjustmentSpeed( ticket, 5000 );

		//dest = TraceFloor(thePlayer.GetWorldPosition() + thePlayer.GetWorldForward() * 20);

		thePlayer.ACS_ClearAnimationSpeedMultipliers();

		//movementAdjustor.RotateTo( ticket, VecHeading( theCamera.GetCameraDirection() ) );

		movementAdjustor.SlideTo( ticket, TraceFloor(thePlayer.GetWorldPosition() + thePlayer.GetWorldForward() * 10) );

		if (!thePlayer.IsAnyWeaponHeld() || thePlayer.IsWeaponHeld('fist'))
		{
			if (FactsQuerySum("ACS_Combat_Slide_Drift_Left") <= 0)
			{
				GetWitcherPlayer().GetRootAnimatedComponent().PlaySlotAnimationAsync ( 'land_slide_lf_18', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(1, 1));	

				FactsAdd("ACS_Combat_Slide_Drift_Left", 1, -1);
			}
			else
			{
				GetWitcherPlayer().GetRootAnimatedComponent().PlaySlotAnimationAsync ( 'land_slide_rf_18', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(1, 1));	

				FactsRemove("ACS_Combat_Slide_Drift_Left");
			}
		}
		else
		{
			if (FactsQuerySum("ACS_Combat_Slide_Drift_Left") <= 0)
			{
				if (RandF() < 0.5)
				{
					GetWitcherPlayer().GetRootAnimatedComponent().PlaySlotAnimationAsync ( 'ice_skating_attack_loop_r', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));	
				}
				else
				{
					GetWitcherPlayer().GetRootAnimatedComponent().PlaySlotAnimationAsync ( 'ice_skating_attack_02_loop_r', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));	
				}

				FactsAdd("ACS_Combat_Slide_Drift_Left", 1, -1);
			}
			else
			{
				if (RandF() < 0.5)
				{
					GetWitcherPlayer().GetRootAnimatedComponent().PlaySlotAnimationAsync ( 'ice_skating_attack_loop_l', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));	
				}
				else
				{
					GetWitcherPlayer().GetRootAnimatedComponent().PlaySlotAnimationAsync ( 'ice_skating_attack_02_loop_l', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));	
				}

				FactsRemove("ACS_Combat_Slide_Drift_Left");
			}
		}
		
		if (RandF() < 0.5)
		{
			//thePlayer.RaiseEvent('ACS_KneelSlide');
		}
		else
		{
			//thePlayer.RaiseEvent('ACS_SlideFast');
		}

		thePlayer.RaiseEvent('ACS_SlideFast');

		thePlayer.RaiseEvent('ACS_ForceHandClosedR');

		//thePlayer.RaiseEvent('ACS_ForceHandClosedLShield');

		thePlayer.SoundEvent('monster_fleder_mv_slide');

		thePlayer.SoundEvent('mv_slide_start');

		thePlayer.BlockAllActions( 'ACS_Combat_Slide', true );

		GetACSWatcher().CreateFastSprintTrail('white');

		thePlayer.PlayEffectSingle('acs_fast_sprint_trail');
		thePlayer.StopEffect('acs_fast_sprint_trail');

		GetACSWatcher().SetCombatSlideStatus(true);

		thePlayer.SoundEvent('mv_slide_debris');
		thePlayer.StopEffect('jump_ground_fx1');
		thePlayer.PlayEffect('jump_ground_fx1');

		thePlayer.StopEffect('jump_ground_fx2');
		thePlayer.PlayEffect('jump_ground_fx2');

		Sleep(0.75);

		if (theInput.GetActionValue('GI_AxisLeftY') != 0 
		&& thePlayer.IsAnyWeaponHeld() 
		&& !thePlayer.IsWeaponHeld('fist'))
		{

			if (!thePlayer.IsAnyWeaponHeld() || thePlayer.IsWeaponHeld('fist'))
			{
				
			}
			else
			{
				//thePlayer.RaiseEvent('ACS_FeetAdditiveEnd');

				if (FactsQuerySum("ACS_Combat_Slide_Drift_Left") > 0)
				{
					GetWitcherPlayer().GetRootAnimatedComponent().PlaySlotAnimationAsync ( 'ice_skating_drift_start_left', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));	
				}
				else
				{
					GetWitcherPlayer().GetRootAnimatedComponent().PlaySlotAnimationAsync ( 'ice_skating_drift_start_right', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));	
				}
			}

			movementAdjustor.CancelAll();
			ticket = movementAdjustor.CreateNewRequest( 'ACS_Combat_Slide' );
			movementAdjustor.AdjustmentDuration( ticket, 0.55 );
			movementAdjustor.MaxRotationAdjustmentSpeed( ticket, 5000 );
			movementAdjustor.MaxLocationAdjustmentSpeed( ticket, 5000 );

			thePlayer.ACS_ClearAnimationSpeedMultipliers();

			//movementAdjustor.RotateTo( ticket, VecHeading( theCamera.GetCameraDirection() ) );

			//movementAdjustor.RotateTo( ticket, VecHeading( dest ) );

			movementAdjustor.SlideTo( ticket, TraceFloor(thePlayer.GetWorldPosition() + thePlayer.GetWorldForward() * 7.5) );
		
			Sleep(0.25);

			thePlayer.SoundEvent('mv_slide');
			thePlayer.SoundEvent('mv_slide');
			thePlayer.SoundEvent('mv_slide');

			thePlayer.SoundEvent('mv_slide_debris');

			thePlayer.StopEffect('jump_ground_fx1');
			thePlayer.PlayEffect('jump_ground_fx1');

			thePlayer.StopEffect('jump_ground_fx2');
			thePlayer.PlayEffect('jump_ground_fx2');

			if (!thePlayer.IsAnyWeaponHeld() || thePlayer.IsWeaponHeld('fist'))
			{
				
			}
			else
			{
				thePlayer.RaiseEvent('ACS_FeetAdditiveEnd');
				
				thePlayer.SoundEvent('monster_fleder_mv_slide');

				GetACSWatcher().RemoveTimer('AddCombatSlideProcessWeaponCollisionTimer');
				GetACSWatcher().AddTimer('AddCombatSlideProcessWeaponCollisionTimer', 0.05f, true);

				GetACSWatcher().RemoveTimer('RemoveCombatSlideProcessWeaponCollisionTimer');
				GetACSWatcher().AddTimer('RemoveCombatSlideProcessWeaponCollisionTimer', 0.75f, false);

				if (FactsQuerySum("ACS_Combat_Slide_Drift_Left") > 0)
				{
					//thePlayer.RaiseEvent('ACS_CombatTauntLeft');

					GetWitcherPlayer().GetRootAnimatedComponent().PlaySlotAnimationAsync ( 'ice_skating_drift_sword_loop_left', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));	
				}
				else
				{
					//thePlayer.RaiseEvent('ACS_CombatTauntRight');

					GetWitcherPlayer().GetRootAnimatedComponent().PlaySlotAnimationAsync ( 'ice_skating_drift_sword_loop_right', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));	
				}
			}

			Sleep(0.25);

			if (!thePlayer.IsAnyWeaponHeld() || thePlayer.IsWeaponHeld('fist'))
			{
				
			}
			else
			{
				//thePlayer.RaiseEvent('ACS_FeetAdditiveEnd');
			}

			movementAdjustor.CancelAll();
			ticket = movementAdjustor.CreateNewRequest( 'ACS_Combat_Slide' );
			movementAdjustor.AdjustmentDuration( ticket, 0.55 );
			movementAdjustor.MaxRotationAdjustmentSpeed( ticket, 5000 );
			movementAdjustor.MaxLocationAdjustmentSpeed( ticket, 5000 );

			thePlayer.ACS_ClearAnimationSpeedMultipliers();

			//movementAdjustor.RotateTo( ticket, VecHeading( theCamera.GetCameraDirection() ) );

			//movementAdjustor.RotateTo( ticket, VecHeading( dest ) );

			movementAdjustor.SlideTo( ticket, TraceFloor(thePlayer.GetWorldPosition() + thePlayer.GetWorldForward() * 7.5) );
		
			Sleep(0.5);
		}

		movementAdjustor.CancelAll();
		ticket = movementAdjustor.CreateNewRequest( 'ACS_Combat_Slide' );
		movementAdjustor.AdjustmentDuration( ticket, 0.1 );
		movementAdjustor.MaxRotationAdjustmentSpeed( ticket, 5000 );
		movementAdjustor.MaxLocationAdjustmentSpeed( ticket, 5000 );

		thePlayer.ACS_ClearAnimationSpeedMultipliers();

		movementAdjustor.RotateTo( ticket, VecHeading( theCamera.GetCameraDirection() ) );

		thePlayer.ACS_ClearAnimationSpeedMultipliers();

		if (thePlayer.IsInCombat() || thePlayer.IsThreatened())
		{
			ACS_ExplorationDelayHack(false, 3);
		}

		ACSGetCEntityDestroyAll('ACS_Player_Fast_Sprint_Trail');

		GetACSWatcher().SetCombatSlideStatus(false);

		thePlayer.RaiseEvent('ACS_FeetAdditiveEnd');

		thePlayer.RaiseEvent('ACS_ForceHandClosedREnd');

		//if (!thePlayer.HasTag('ACS_Dual_Wield_Active')){thePlayer.RaiseEvent('ACS_ForceHandClosedLEnd');}

		thePlayer.BlockAllActions( 'ACS_Combat_Slide', false );

		if (!thePlayer.IsAnyWeaponHeld() || thePlayer.IsWeaponHeld('fist'))
		{
			GetWitcherPlayer().GetRootAnimatedComponent().PlaySlotAnimationAsync ( 'slide_trip_01', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 1));	
		}
		else
		{
			GetACSWatcher().RemoveTimer('AddCombatSlideProcessWeaponCollisionTimer');

			if (FactsQuerySum("ACS_Combat_Slide_Drift_Left") > 0)
			{
				GetWitcherPlayer().GetRootAnimatedComponent().PlaySlotAnimationAsync ( 'ice_skating_drift_sword_stop_left', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 1));	
			}
			else
			{
				GetWitcherPlayer().GetRootAnimatedComponent().PlaySlotAnimationAsync ( 'ice_skating_drift_sword_stop_right', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 1));	
			}
		}

		thePlayer.SoundEvent('mv_slide_debris');
		thePlayer.StopEffect('jump_ground_fx1');
		thePlayer.PlayEffect('jump_ground_fx1');

		thePlayer.StopEffect('jump_ground_fx2');
		thePlayer.PlayEffect('jump_ground_fx2');

		thePlayer.SoundEvent('mv_slide_end');

		if ( !theGame.IsDialogOrCutscenePlaying() )
		{
			parent.GotoState('Combat');
		}

		//((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent()).SetAnimatedMovement( false );
	}
	

}

//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

statemachine class CACSCatSchoolToeBlade extends CGameplayEntity
{
	var toe_blade_temp							: CEntityTemplate;
	var toe_blade_r, toe_blade_l 				: CEntity;
	var attach_vec		 						: Vector;
	var attach_rot		 						: EulerAngles;

	event OnSpawned( spawnData : SEntitySpawnData )
	{
		SoundEvent("souken_henkei_00_bb_acs");

		toe_blade_temp = (CEntityTemplate)LoadResource(
		"dlc\dlc_acs\data\entities\equipment_mode_weapons\acs_cat_school_toe_blade.w2ent"
		
		,true);

		toe_blade_r = (CEntity)theGame.CreateEntity(toe_blade_temp, this.GetWorldPosition(), this.GetWorldRotation());

		attach_rot.Roll = 90;
		attach_rot.Pitch = 90;
		attach_rot.Yaw = 0;
		attach_vec.X = -0.0625; // + forward - back
		attach_vec.Y = 0; // + up - down
		attach_vec.Z = 0.025; // + right -left

		toe_blade_r.CreateAttachment(this,, attach_vec, attach_rot);

		toe_blade_r.ACS_PlayEffectAfter('light_trail_fx', 0.125);
		toe_blade_r.ACS_PlayEffectAfter('light_block', 0.125);
		toe_blade_r.ACS_PlayEffectAfter('heavy_block', 0.125);
		toe_blade_r.ACS_PlayEffectAfter('counterattack', 0.125);

		toe_blade_r.PlayEffect('fast_attack_buff');
		toe_blade_r.ACS_PlayEffectAfter('fast_attack_buff_hit', 0.125);


		toe_blade_l = (CEntity)theGame.CreateEntity(toe_blade_temp, this.GetWorldPosition(), this.GetWorldRotation());

		attach_rot.Roll = 90;
		attach_rot.Pitch = 90;
		attach_rot.Yaw = 0;
		attach_vec.X = -0.0625; // + forward - back
		attach_vec.Y = 0; // + up - down
		attach_vec.Z = -0.025; // + right -left

		toe_blade_l.CreateAttachment(this,, attach_vec, attach_rot);

		toe_blade_l.ACS_PlayEffectAfter('light_trail_fx', 0.125);
		toe_blade_l.ACS_PlayEffectAfter('light_block', 0.125);
		toe_blade_l.ACS_PlayEffectAfter('heavy_block', 0.125);
		toe_blade_l.ACS_PlayEffectAfter('counterattack', 0.125);

		toe_blade_l.PlayEffect('fast_attack_buff');
		toe_blade_l.ACS_PlayEffectAfter('fast_attack_buff_hit', 0.125);
	}

	private timer function CatSchoolToeBladeDestroyProcess( delta : float , id : int)
	{
		SoundEvent("souken_henkei_00_bb_acs");

		toe_blade_r.PlayEffectSingle('light_block');
		toe_blade_r.PlayEffectSingle('heavy_block');
		toe_blade_r.PlayEffectSingle('counterattack');

		toe_blade_l.PlayEffectSingle('light_block');
		toe_blade_l.PlayEffectSingle('heavy_block');
		toe_blade_l.PlayEffectSingle('counterattack');

		AddTimer('CatSchoolToeBladeDestroyActual', 0.125 , false );
	} 

	private timer function CatSchoolToeBladeDestroyActual( delta : float , id : int)
	{
		toe_blade_r.BreakAttachment();
		toe_blade_r.Teleport(this.GetWorldPosition() + Vector(0,0,-200));
		toe_blade_r.DestroyAfter(0.125f);

		toe_blade_l.BreakAttachment();
		toe_blade_l.Teleport(this.GetWorldPosition() + Vector(0,0,-200));
		toe_blade_l.DestroyAfter(0.125f);

		this.Destroy();
	} 

	event OnDestroyed()
	{

	}
}


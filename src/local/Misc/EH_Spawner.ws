statemachine class ACSBigShipTrollCrew extends CNewNPC
{
	var projectile : W3TrollCannonProjectile;

	event OnSpawned( spawnData : SEntitySpawnData )
	{
		super.OnSpawned(spawnData);

		AddTag('ACS_BigShipTrollCrew');

		AddTimer('Loop', 0.001, true);
	}

	var troll_idle_animation_cooldown, troll_idle_animation_cooldown_refresh : float;

	default troll_idle_animation_cooldown_refresh = 7;

	var troll_idle_anims : array<name>;

	public function PlayAnimation(animation_name: name, blendin, blendout : float)
	{
		var anicomponent: CAnimatedComponent;

		anicomponent = (CAnimatedComponent)((CActor)this).GetComponentByClassName('CAnimatedComponent');
    	anicomponent.PlaySlotAnimationAsync(animation_name, 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(blendin, blendout));
	}

	timer function Loop ( dt : float, id : int)
	{
		var targetDistance		: float;

		targetDistance = VecDistanceSquared2D( this.GetWorldPosition(), GetWitcherPlayer().GetWorldPosition() );

		if (targetDistance <= 50 * 50)
		{
			EnableCollisions(false);

			EnableCharacterCollisions(false);

			if (thePlayer.IsInCombat())
			{
				SetBehaviorVectorVariable( 'lookAtTarget', (thePlayer.GetTarget()).GetWorldPosition() );
			}
			else
			{
				if (thePlayer.IsUsingVehicle() )
				{
					SetBehaviorVectorVariable( 'lookAtTarget', theCamera.GetCameraPosition() + VecFromHeading(theCamera.GetCameraHeading()) * 10 );
				}
				else
				{
					SetBehaviorVectorVariable( 'lookAtTarget', thePlayer.GetWorldPosition() );
				}
			}

			if (theGame.GetEngineTimeAsSeconds() - troll_idle_animation_cooldown > troll_idle_animation_cooldown_refresh)
			{
				troll_idle_animation_cooldown = theGame.GetEngineTimeAsSeconds();

				troll_idle_anims.Clear();

				if (HasTag('ACS_Troll_Crew_Operator'))
				{
					troll_idle_anims.PushBack('monster_cave_troll_poke_fire_with_stick_loop');
					troll_idle_anims.PushBack('monster_cave_troll_soupy_goodness_2');
					troll_idle_anims.PushBack('high_standing_determined_gesture_instruct');
					troll_idle_anims.PushBack('monster_cave_troll_strike_pot');
					troll_idle_anims.PushBack('high_standing_determined_gesture_strike_left');
					troll_idle_anims.PushBack('high_standing_determined_gesture_strike_right');
					//troll_idle_anims.PushBack('high_standing_determined_gesture_boom');

					PlayAnimation(troll_idle_anims[RandRange(troll_idle_anims.Size())], 0.75f, 0.75f);

					troll_idle_animation_cooldown_refresh = 7.5;
				}
				else
				{
					if (!GetACSWatcher().bigShipAnimProcess)
					{
						if (thePlayer.IsInCombat())
						{
							troll_idle_anims.PushBack('monster_cave_troll_taunt_roar_1');
							troll_idle_anims.PushBack('monster_cave_troll_taunt_search');
							troll_idle_anims.PushBack('monster_cave_troll_block');
							troll_idle_anims.PushBack('monster_cave_troll_rage_start');
						}
						else
						{
							troll_idle_anims.PushBack('monster_cave_troll_listen_gesture');
							troll_idle_anims.PushBack('monster_cave_troll_blow_on_fire_in');
							troll_idle_anims.PushBack('monster_cave_troll_blow_on_fire_loop');
							troll_idle_anims.PushBack('monster_cave_troll_blow_on_fire_out');
							troll_idle_anims.PushBack('monster_cave_troll_idle_scratch_face');
							troll_idle_anims.PushBack('monster_cave_troll_poke_fire_with_stick_loop');
							troll_idle_anims.PushBack('monster_cave_troll_soupy_goodness');
							troll_idle_anims.PushBack('monster_cave_troll_soupy_goodness_1');
							troll_idle_anims.PushBack('monster_cave_troll_soupy_goodness_2');
							troll_idle_anims.PushBack('monster_cave_troll_soupy_goodness_in');
							troll_idle_anims.PushBack('monster_cave_troll_soupy_goodness_out');
							troll_idle_anims.PushBack('monster_cave_troll_dialoque_idle_happy_1');
							troll_idle_anims.PushBack('monster_cave_troll_dialoque_idle_happy_2');
							troll_idle_anims.PushBack('monster_cave_troll_dialoque_idle_suspicious_2');
							troll_idle_anims.PushBack('monster_cave_troll_look_in_pot_idle_1');
							troll_idle_anims.PushBack('monster_cave_troll_look_in_pot_idle_2');
							troll_idle_anims.PushBack('monster_cave_troll_look_in_pot_in');
							troll_idle_anims.PushBack('monster_cave_troll_look_in_pot_out');
							troll_idle_anims.PushBack('monster_cave_troll_strike_pot');
							troll_idle_anims.PushBack('monster_cave_troll_threat_posture');
							troll_idle_anims.PushBack('monster_cave_troll_hit_cauldron');
							troll_idle_anims.PushBack('monster_cave_troll_shrugs');
							troll_idle_anims.PushBack('high_standing_determined_gesture_boom');
							troll_idle_anims.PushBack('high_standing_determined_gesture_bad_troll');
							troll_idle_anims.PushBack('high_standing_determined_gesture_instruct');
							troll_idle_anims.PushBack('high_standing_determined_gesture_approve');
							troll_idle_anims.PushBack('high_standing_determined_gesture_strike_left');
							troll_idle_anims.PushBack('high_standing_determined_gesture_strike_right');
							troll_idle_anims.PushBack('high_standing_determined_gesture_scratch_face');
							troll_idle_anims.PushBack('high_standing_determined_gesture_hit_head_wall');
						}

						PlayAnimation(troll_idle_anims[RandRange(troll_idle_anims.Size())], 0.75f, 0.75f);

						troll_idle_animation_cooldown_refresh = RandRangeF(10,5);
					}
				}
			}
		
			if (GetBehaviorVariable( 'lookatOn' ) != 1)
			{
				SetBehaviorVariable( 'lookatOn', 1, true );
			}
		}
	}

	function ThrowProjectileStart()
	{
		var headingDiff									: float;
		var targetDistance								: float;
		var movementAdjustor							: CMovementAdjustor;
		var ticket										: SMovementAdjustmentRequestTicket;

		if (HasTag('ACS_Troll_Crew_Operator'))
		{
			return;
		}

		targetDistance = VecDistanceSquared2D( this.GetWorldPosition(), GetWitcherPlayer().GetWorldPosition() );

		if (targetDistance > 50 * 50)
		{
			return;
		}

		movementAdjustor = this.GetMovingAgentComponent().GetMovementAdjustor();

		ticket = movementAdjustor.GetRequest( 'ACS_BigShipTrollCrewRotate');
		movementAdjustor.CancelByName( 'ACS_BigShipTrollCrewRotate' );
		movementAdjustor.CancelAll();

		ticket = movementAdjustor.CreateNewRequest( 'ACS_BigShipTrollCrewRotate' );
		movementAdjustor.MaxRotationAdjustmentSpeed( ticket, 50000 );
		movementAdjustor.Continuous(ticket);

		projectile = (W3TrollCannonProjectile)theGame.CreateEntity( (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\entities\projectiles\troll_cannon_proj.w2ent", true ), GetWorldPosition() );

		projectile.Init(GetWitcherPlayer());

		headingDiff = AngleDistance( VecHeading( theCamera.GetCameraDirection() ), VecHeading( thePlayer.GetHeadingVector() ) );

		RemoveTimer('ThrowProjectile');

		if (headingDiff >= 60)
		{
			projectile.CreateAttachment(this,'r_weapon');

			PlayAnimation('monster_cave_troll_throw_l', 0.25f, 0.25f);

			AddTimer('ThrowProjectile', 1 , false );

			movementAdjustor.AdjustmentDuration( ticket, 1 );
		}
		else if (headingDiff < -60 )
		{
			projectile.CreateAttachment(this,'l_weapon');

			PlayAnimation('monster_cave_troll_throw_r', 0.25f, 0.25f);

			AddTimer('ThrowProjectile', 1 , false );

			movementAdjustor.AdjustmentDuration( ticket, 1 );
		}
		else
		{
			projectile.CreateAttachment(this,'l_weapon');

			PlayAnimation('monster_cave_troll_throw', 0.25f, 0.25f);

			AddTimer('ThrowProjectile', 1.75 , false );

			movementAdjustor.AdjustmentDuration( ticket, 1.75 );
		}

		if (thePlayer.GetTarget())
		{
			movementAdjustor.RotateTowards( ticket, thePlayer.GetTarget() );
		}
		else
		{
			movementAdjustor.RotateTo( ticket, VecHeading( theCamera.GetCameraDirection() * 50) );
		}
	}

	event OnTakeDamage( action : W3DamageAction )
	{
		action.processedDmg.essenceDamage -= action.processedDmg.essenceDamage;
	}

	timer function ThrowProjectile ( dt : float, id : int)
	{
		var targetPos 						: Vector;
		var movementAdjustor				: CMovementAdjustor;
		var ticket							: SMovementAdjustmentRequestTicket;
		var actor							: CActor;

		movementAdjustor = this.GetMovingAgentComponent().GetMovementAdjustor();

		ticket = movementAdjustor.GetRequest( 'ACS_BigShipTrollCrewRotate');
		movementAdjustor.CancelByName( 'ACS_BigShipTrollCrewRotate' );
		movementAdjustor.CancelAll();

		projectile.BreakAttachment();

		actor = ((CActor)thePlayer.GetTarget());

		if( actor && ACS_AttitudeCheck ( actor ) && actor.IsAlive() )
		{
			targetPos = actor.PredictWorldPosition(RandRangeF(0.7, 0.3));

			if (((CNewNPC)actor).IsFlying()
			|| actor.IsInAir()
			)
			{
				targetPos.Z += 1.5;
			}
		}
		else
		{
			targetPos = theCamera.GetCameraPosition() + theCamera.GetCameraDirection() * 50;
		}

		projectile.ShootProjectileAtPosition( 0, 30, targetPos, 500 );
	}

	timer function troll_play_line ( dt : float, id : int)
	{
		var troll_line : int;

		if (!GetACSWatcher().troll_line_01
		&& !GetACSWatcher().troll_line_02
		&& !GetACSWatcher().troll_line_03
		&& !GetACSWatcher().troll_line_04
		&& !GetACSWatcher().troll_line_05
		&& !GetACSWatcher().troll_line_06
		&& !GetACSWatcher().troll_line_07
		)
		{
			troll_line = 468850;
		}
		else if (GetACSWatcher().troll_line_01
		&& !GetACSWatcher().troll_line_02
		&& !GetACSWatcher().troll_line_03
		&& !GetACSWatcher().troll_line_04
		&& !GetACSWatcher().troll_line_05
		&& !GetACSWatcher().troll_line_06
		&& !GetACSWatcher().troll_line_07
		)
		{
			troll_line = 468244;
		}
		else if (!GetACSWatcher().troll_line_01
		&& GetACSWatcher().troll_line_02
		&& !GetACSWatcher().troll_line_03
		&& !GetACSWatcher().troll_line_04
		&& !GetACSWatcher().troll_line_05
		&& !GetACSWatcher().troll_line_06
		&& !GetACSWatcher().troll_line_07)
		{
			troll_line = 468246;
		}
		else if (!GetACSWatcher().troll_line_01
		&& !GetACSWatcher().troll_line_02
		&& GetACSWatcher().troll_line_03
		&& !GetACSWatcher().troll_line_04
		&& !GetACSWatcher().troll_line_05
		&& !GetACSWatcher().troll_line_06
		&& !GetACSWatcher().troll_line_07)
		{
			troll_line = 468248;
		}
		else if (!GetACSWatcher().troll_line_01
		&& !GetACSWatcher().troll_line_02
		&& !GetACSWatcher().troll_line_03
		&& GetACSWatcher().troll_line_04
		&& !GetACSWatcher().troll_line_05
		&& !GetACSWatcher().troll_line_06
		&& !GetACSWatcher().troll_line_07)
		{
			troll_line = 468250;
		}
		else if (!GetACSWatcher().troll_line_01
		&& !GetACSWatcher().troll_line_02
		&& !GetACSWatcher().troll_line_03
		&& !GetACSWatcher().troll_line_04
		&& GetACSWatcher().troll_line_05
		&& !GetACSWatcher().troll_line_06
		&& !GetACSWatcher().troll_line_07)
		{
			troll_line = 468844;
		}
		else if (!GetACSWatcher().troll_line_01
		&& !GetACSWatcher().troll_line_02
		&& !GetACSWatcher().troll_line_03
		&& !GetACSWatcher().troll_line_04
		&& !GetACSWatcher().troll_line_05
		&& GetACSWatcher().troll_line_06
		&& !GetACSWatcher().troll_line_07)
		{
			troll_line = 468846;
		}
		else if (!GetACSWatcher().troll_line_01
		&& !GetACSWatcher().troll_line_02
		&& !GetACSWatcher().troll_line_03
		&& !GetACSWatcher().troll_line_04
		&& !GetACSWatcher().troll_line_05
		&& !GetACSWatcher().troll_line_06
		&& GetACSWatcher().troll_line_07)
		{
			troll_line = 468848;
		}

		this.PlayLine( troll_line, false);
	}
}

//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

statemachine class W3ACSSignIndicator extends CEntity
{
	var anchor_ent, sign_indicator_ent, focus_indicator_ent_01, focus_indicator_ent_02, focus_indicator_ent_03, health_stat_indicator_ent, stamina_stat_indicator_ent, toxicity_stat_indicator_ent /*, posture_stat_indicator_ent*/     : CEntity;
	var indicator_hud_active, indicator_active, indicator_hud_medallion_active, indicator_medallion_active, standard_check																												: bool;
	var indicator_progress																																																				: float;
	var indicator_combat_check																																																			: bool;
	var indicator_player_check																																																			: bool;

   	event OnSpawned( spawnData : SEntitySpawnData )
	{
		var hud								    																							: CR4ScriptedHud;
		var moduleRadial																													: CR4HudModuleRadialMenu;

		this.PushState('W3ACSSignIndicatorEntitySpawns');

		hud = (CR4ScriptedHud)theGame.GetHud();

		if ( hud )
		{
			moduleRadial = (CR4HudModuleRadialMenu)hud.GetHudModule("RadialMenuModule");

			moduleRadial.ShowRadialMenu();

			RemoveTimer('RadialMenuFix');
			AddTimer('RadialMenuFix', 0.00001, false);
		}
	}

	var sign_indicator_string : string;

	default sign_indicator_string = "NULL";

	timer function SignIndicatorLoop( delta : float , id : int)
	{
		var iconPath_background_bar																											: String;
		var iconPath_health, iconPath_stamina, iconPath_toxicity, iconPath_posture, iconPath_greyhealth, iconPath_adrenaline				: String;
		var iconPath_medallion, iconPath_medallion_red_glow, iconPath_medallion_red_glow_background, iconPath_medallion_chain 				: String;
		var anchor_point, anchor_point_01, anchor_point_02																					: Vector;
		var bone_vec																														: Vector;
		var bone_rot																														: EulerAngles;
		var targetDistance 																													: float;
		var cam_directionX																													: float;
		var headingDiff																														: float;

		if(theGame.IsDialogOrCutscenePlaying() 
		|| !thePlayer.IsAlive()
		|| thePlayer.IsInCutsceneIntro()
		|| theGame.HasBlackscreenRequested()
		|| theGame.IsCurrentlyPlayingNonGameplayScene()
		|| theGame.GetGuiManager().IsAnyMenu()
		|| theGame.GetTutorialSystem().HasActiveTutorial()
		|| theGame.GetPhotomodeEnabled() 
		|| theGame.IsFading() 
		|| theGame.IsBlackscreen()
		|| theGame.GetPhotomodeEnabled() 
		|| theGame.IsPaused()
		|| ACS_Settings_Main_Bool('acs_hud_settings_main','acs_wolfs_head_hud_module_enabled', false)
		)
		{
			//this.DestroyAllEffects();

			if (indicator_hud_active)
			{
				RemoveTimer('SignIndicatorDespawnDelay');

				indicator_hud_active = false;
			}

			if (indicator_hud_medallion_active)
			{
				RemoveTimer('MedallionDespawnDelay');

				RemoveTimer('FadeOutOneliners');

				indicator_hud_medallion_active = false;
			}

			if (standard_check)
			{
				standard_check = false;
			}

			if (indicator_active)
			{
				RemoveTimer('SignIndicatorDespawnDelay');

				anchor_ent.BreakAttachment();

				anchor_ent.CreateAttachment(this,, Vector(0,0,0));

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Health_Background_Bar_Indicator");

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Stamina_Background_Bar_Indicator");

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Toxicity_Background_Bar_Indicator");

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Player_Posture_Background_Bar_Indicator");

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Health_Bar_Indicator");

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Grey_Health_Bar_Indicator");

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Stamina_Bar_Indicator");

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Toxicity_Bar_Indicator");

				//GetACSStorage().acs_deleteOnelinerByTag("ACS_Player_Posture_Bar_Indicator");

				//GetACSStorage().acs_deleteOnelinerByTag("ACS_Player_Posture_Bar_Max_Indicator");

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Adrenaline_Background_Bar_01_Indicator");

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Adrenaline_Background_Bar_02_Indicator");

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Adrenaline_Background_Bar_03_Indicator");

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Adrenaline_Bar_01_Max_Indicator");

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Adrenaline_Bar_02_Max_Indicator");

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Adrenaline_Bar_03_Max_Indicator");

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Adrenaline_Bar_01_Indicator");

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Adrenaline_Bar_02_Indicator");

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Adrenaline_Bar_03_Indicator");

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Sign_Indicator_Dimmed");

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Sign_Indicator_Available");

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Sign_Indicator_Activated");

				if (sign_indicator_string != "NULL")
				{
					sign_indicator_string = "NULL";
				}

				if (indicator_combat_check)
				{
					indicator_progress = 0.0001;

					indicator_combat_check = false;
				}

				if (indicator_player_check)
				{
					indicator_progress = 0.0001;

					indicator_player_check = false;
				}

				indicator_active = false;
			}

			if (indicator_medallion_active)
			{
				RemoveTimer('FadeOutOneliners');

				RemoveTimer('MedallionDespawnDelay');

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Wolf_Head_Medallion_Chain_Left");

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Wolf_Head_Medallion_Chain_Right");

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Wolf_Head_Medallion");

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Wolf_Head_Medallion_Red_Glow");

				GetACSStorage().acs_deleteOnelinerByTag("ACS_Wolf_Head_Medallion_Back_Glow");

				indicator_medallion_active = false;
			}
		}
		else
		{	
			if (indicator_active)
			{
				GetWitcherPlayer().GetBoneWorldPositionAndRotationByIndex( GetWitcherPlayer().GetBoneIndex( 'neck' ), bone_vec, bone_rot );

				targetDistance = VecDistanceSquared2D( theCamera.GetCameraPosition(), bone_vec ) ;

				headingDiff = AngleDistance( VecHeading( theCamera.GetCameraDirection() ), VecHeading( thePlayer.GetHeadingVector() ) );

				if (targetDistance > 6 * 6
				&& (headingDiff > 90 || headingDiff < -90)
				)
				{
					anchor_point = theCamera.GetCameraPosition() + theCamera.GetCameraRight() * -0.5 + theCamera.GetCameraDirection() * 1.5;

					if (!indicator_player_check)
					{
						indicator_progress = 0.0001;
						
						indicator_player_check = true;
					}

					if (indicator_combat_check)
					{
						indicator_progress = 0.0001;

						indicator_combat_check = false;
					}
				}
				else
				{
					if (indicator_player_check)
					{
						indicator_progress = 0.0001;
						
						indicator_player_check = false;
					}

					if (thePlayer.IsInCombat()
					|| thePlayer.IsThreatened()
					|| !ACS_CombatToExplorationCheck()
					|| thePlayer.IsUsingHorse()
					|| thePlayer.IsUsingVehicle()
					|| GetACSWatcher().GetTransformationCamera()
					|| GetACSWatcher().GetKestralCamera()
					|| GetACSWatcher().GetPlayerCamera()
					|| FactsQuerySum("ACS_In_Meditation") > 0 
					)
					{
						//anchor_point_01 = ((theCamera.GetCameraPosition() + theCamera.GetCameraDirection()) + bone_vec) * 0.5;

						//anchor_point_02 = ((((theCamera.GetCameraPosition() + theCamera.GetCameraDirection()) + bone_vec) * 0.5) + bone_vec) * 0.5;

						//anchor_point = (anchor_point_01 + anchor_point_02) * 0.5;

						anchor_point_01 = theCamera.GetCameraPosition() + theCamera.GetCameraDirection();

						if ( thePlayer.IsUsingHorse()
						|| thePlayer.IsUsingVehicle()
						)
						{
							anchor_point_02 = (thePlayer.GetWorldPosition() + Vector(0,0,2));
						}
						else
						{
							anchor_point_02 = (thePlayer.GetWorldPosition() + Vector(0,0,1.5));
						}

						anchor_point = (anchor_point_01 + anchor_point_02) * 0.5;

						if (!indicator_combat_check)
						{
							indicator_progress = 0.0001;

							indicator_combat_check = true;
						}
					}
					else
					{
						anchor_point = bone_vec;

						if (indicator_combat_check)
						{
							indicator_progress = 0.0001;

							indicator_combat_check = false;
						}
					}
				}

				if (indicator_player_check)
				{
					if (indicator_progress >= 0.01)
					{
						indicator_progress = 0.01;
					}
					else
					{
						indicator_progress += 0.001;
					}
				}
				else
				{
					if (indicator_progress >= 0.5)
					{
						indicator_progress = 0.5;
					}
					else
					{
						indicator_progress += 0.001;
					}
				}

				anchor_ent.TeleportWithRotation( LerpV(anchor_ent.GetWorldPosition(), anchor_point, indicator_progress), theCamera.GetCameraRotation() );

				StatBarPositioningControl();
				
				SignIndicatorControl();

				GetNearbyEnemies();
			}

			if (GetACSWatcher().HudExceptionCheck()
			)
			{
				standard_check = true;
			}
			else
			{
				standard_check = false;
			}

			if (standard_check
			|| thePlayer.GetStat(BCS_Stamina) < thePlayer.GetStatMax(BCS_Stamina)
			)
			{
				if (!indicator_hud_active)
				{
					RemoveTimer('SignIndicatorDespawnDelay');

					indicator_hud_active = true;
				}

				if (!indicator_active)
				{
					CreateOneliners();

					indicator_active = true;
				}
			}
			else
			{
				if (indicator_hud_active)
				{
					RemoveTimer('SignIndicatorDespawnDelay');
					AddTimer('SignIndicatorDespawnDelay', ACS_Settings_Main_Float('acs_hud_settings_main','acs_hud_elements_despawn_delay', 7) , false);

					indicator_hud_active = false;
				}
			}

			if (standard_check
			)
			{
				if (!indicator_hud_medallion_active)
				{
					RemoveTimer('MedallionDespawnDelay');

					RemoveTimer('FadeOutOneliners');

					indicator_hud_medallion_active = true;
				}

				if (!indicator_medallion_active)
				{
					CreateMedallion();

					indicator_medallion_active = true;
				}
			}
			else
			{
				if (indicator_hud_medallion_active)
				{
					RemoveTimer('MedallionDespawnDelay');
					AddTimer('MedallionDespawnDelay', ACS_Settings_Main_Float('acs_hud_settings_main','acs_hud_elements_despawn_delay', 7) , false);

					indicator_hud_medallion_active = false;
				}
			}
		}
	}

	function GetNearbyEnemies()
	{
		var actor							: CActor; 
		var actors		    				: array<CActor>;
		var i								: int;
		var pos								: Vector;

		actors.Clear();

		actors = thePlayer.GetNPCsAndPlayersInRange( ACS_Settings_Main_Float('acs_hud_settings_markers','acs_enemy_marker_distance_to_display', 50), 50, , FLAG_OnlyAliveActors + FLAG_Attitude_Hostile + FLAG_ExcludePlayer);

		if( actors.Size() > 0 )
		{
			for (i = 0; i < actors.Size(); i += 1) 
			{
				if (((CNewNPC)actors[i]).IsHorse())
				{
					continue;
				}

				if (!actors[i].HasTag('ACS_Enemy_Detected_Tag'))
				{
					ACS_Oneliner("<img src='img://" + "icons/inventory/acs_enemy_position_arrow.xbm" + "' vspace='" + (10) + "' />&nbsp;" + "<br/><br/><br/><br/><br/><br/><br/><br/><br/><br/>", anchor_ent, "ACS_Enemy_Detection_Indicator", Vector(0,0,0)).run_enemy_detection(actors[i], false);

					ACS_Oneliner("<img src='img://" + "icons/inventory/acs_enemy_position_arrow_attack.xbm" + "' vspace='" + (10) + "' />&nbsp;" + "<br/><br/><br/><br/><br/><br/><br/><br/><br/><br/>", anchor_ent, "ACS_Enemy_Detection_Indicator", Vector(0,0,0)).run_enemy_detection(actors[i], true);

					actors[i].AddTag('ACS_Enemy_Detected_Tag');
				}
			}
		}
	}

	function StatBarPositioningControl()
	{
		var attach_rot                        						 																													: EulerAngles;
    	var attach_vec_health, attach_vec_stamina, attach_vec_toxicity																													: Vector;
		var attach_vec_focus_01, attach_vec_focus_02, attach_vec_focus_03																												: Vector;

		var curr_health, max_health 		  																																			: float;

		var curr_stamina, max_stamina 		 																																			: float;
		
		var curr_toxicity, max_toxicity 	 																																			: float;

		curr_health = thePlayer.GetStat(BCS_Vitality);

      	max_health = thePlayer.GetStatMax(BCS_Vitality);

		curr_stamina = thePlayer.GetStat(BCS_Stamina);

     	max_stamina = thePlayer.GetStatMax(BCS_Stamina);

		curr_toxicity = thePlayer.GetStat(BCS_Toxicity);

      	max_toxicity = 0;

		attach_rot.Roll = 0;
		attach_rot.Pitch = 0;
		attach_rot.Yaw = 0;

		attach_vec_focus_01.X = -0.75;
		attach_vec_focus_02.X = -0.75;
		attach_vec_focus_03.X = -0.75;

		attach_vec_focus_01.Y = 0;
		attach_vec_focus_02.Y = 0;
		attach_vec_focus_03.Y = 0;

		///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
		
		if ((curr_health != max_health
		&& curr_stamina != max_stamina
		&& curr_toxicity != max_toxicity)
		|| GetACSWatcher().RadialMenuCheck()
		|| thePlayer.HasTag('ACS_Drawn_Weapon')
		|| theInput.GetActionValue('Focus') > 0.1f
		)
		{
			attach_vec_health.X = -0.95;
			attach_vec_health.Y = 0;
			attach_vec_health.Z = 0.25;

			///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

			attach_vec_stamina.X = -0.8875;
			attach_vec_stamina.Y = 0;
			attach_vec_stamina.Z = 0.125;

			///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

			attach_vec_toxicity.X = -0.825;
			attach_vec_toxicity.Y = 0;
			attach_vec_toxicity.Z = 0;

			///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

			attach_vec_focus_01.Z = -0.175;

			attach_vec_focus_02.Z = -0.275;

			attach_vec_focus_03.Z = -0.375;
		}
		else
		{
			if (
			curr_health == max_health
			&& curr_stamina == max_stamina
			&& curr_toxicity == max_toxicity
			)
			{
				attach_vec_focus_01.Z = -0.075;

				attach_vec_focus_02.Z = -0.175;

				attach_vec_focus_03.Z = -0.275;
			}
			else
			{
				attach_vec_focus_01.Z = -0.175;

				attach_vec_focus_02.Z = -0.275;

				attach_vec_focus_03.Z = -0.375;
			}

			if (curr_health != max_health
			&& curr_stamina == max_stamina
			&& curr_toxicity == max_toxicity
			)
			{
				attach_vec_health.X = -0.825;
				attach_vec_health.Y = 0;
				attach_vec_health.Z = 0;

				attach_vec_stamina.X = 200;
				attach_vec_stamina.Y = 200;
				attach_vec_stamina.Z = 200;

				attach_vec_toxicity.X = 200;
				attach_vec_toxicity.Y = 200;
				attach_vec_toxicity.Z = 200;
			}
			else if (curr_health == max_health
			&& curr_stamina != max_stamina
			&& curr_toxicity == max_toxicity
			)
			{
				attach_vec_stamina.X = -0.825;
				attach_vec_stamina.Y = 0;
				attach_vec_stamina.Z = 0;

				attach_vec_health.X = 200;
				attach_vec_health.Y = 200;
				attach_vec_health.Z = 200;

				attach_vec_toxicity.X = 200;
				attach_vec_toxicity.Y = 200;
				attach_vec_toxicity.Z = 200;
			}
			else if (curr_health == max_health
			&& curr_stamina == max_stamina
			&& curr_toxicity != max_toxicity
			)
			{
				attach_vec_toxicity.X = -0.825;
				attach_vec_toxicity.Y = 0;
				attach_vec_toxicity.Z = 0;

				attach_vec_health.X = 200;
				attach_vec_health.Y = 200;
				attach_vec_health.Z = 200;

				attach_vec_stamina.X = 200;
				attach_vec_stamina.Y = 200;
				attach_vec_stamina.Z = 200;
			}
			else if (curr_health != max_health
			&& curr_stamina != max_stamina
			&& curr_toxicity == max_toxicity
			)
			{
				attach_vec_health.X = -0.8875;
				attach_vec_health.Y = 0;
				attach_vec_health.Z = 0.125;

				attach_vec_stamina.X = -0.825;
				attach_vec_stamina.Y = 0;
				attach_vec_stamina.Z = 0;

				attach_vec_toxicity.X = 200;
				attach_vec_toxicity.Y = 200;
				attach_vec_toxicity.Z = 200;
			}
			else if (curr_health != max_health
			&& curr_stamina == max_stamina
			&& curr_toxicity != max_toxicity
			)
			{
				attach_vec_health.X = -0.8875;
				attach_vec_health.Y = 0;
				attach_vec_health.Z = 0.125;

				attach_vec_toxicity.X = -0.825;
				attach_vec_toxicity.Y = 0;
				attach_vec_toxicity.Z = 0;

				attach_vec_stamina.X = 200;
				attach_vec_stamina.Y = 200;
				attach_vec_stamina.Z = 200;
			}
			else if (curr_health == max_health
			&& curr_stamina != max_stamina
			&& curr_toxicity != max_toxicity
			)
			{
				attach_vec_stamina.X = -0.8875;
				attach_vec_stamina.Y = 0;
				attach_vec_stamina.Z = 0.125;

				attach_vec_toxicity.X = -0.825;
				attach_vec_toxicity.Y = 0;
				attach_vec_toxicity.Z = 0;

				attach_vec_health.X = 200;
				attach_vec_health.Y = 200;
				attach_vec_health.Z = 200;
			}
		}
		
		health_stat_indicator_ent.BreakAttachment();

		stamina_stat_indicator_ent.BreakAttachment();

		toxicity_stat_indicator_ent.BreakAttachment();

		health_stat_indicator_ent.CreateAttachment( anchor_ent, , attach_vec_health, attach_rot );

		stamina_stat_indicator_ent.CreateAttachment( anchor_ent, , attach_vec_stamina, attach_rot );

		toxicity_stat_indicator_ent.CreateAttachment( anchor_ent, , attach_vec_toxicity, attach_rot );



		focus_indicator_ent_01.BreakAttachment();

		focus_indicator_ent_02.BreakAttachment();

		focus_indicator_ent_03.BreakAttachment();

		focus_indicator_ent_01.CreateAttachment( anchor_ent, , attach_vec_focus_01, attach_rot );

		focus_indicator_ent_02.CreateAttachment( anchor_ent, , attach_vec_focus_02, attach_rot );

		focus_indicator_ent_03.CreateAttachment( anchor_ent, , attach_vec_focus_03, attach_rot );

	}

	function SignIndicatorControl()
	{
		var m_CurrentSelectedSign 																																							: ESignType;
		var iconPath_sign_indicator_dimmed, iconPath_sign_indicator_available, iconPath_sign_indicator_activated																			: String;

		m_CurrentSelectedSign = thePlayer.GetEquippedSign();

		switch(m_CurrentSelectedSign)
		{
			case ST_Igni:

				if (sign_indicator_string != "ACS_Igni_Sign_Selected")
				{
					GetACSStorage().acs_deleteOnelinerByTag("ACS_Sign_Indicator_Dimmed");

					GetACSStorage().acs_deleteOnelinerByTag("ACS_Sign_Indicator_Available");

					GetACSStorage().acs_deleteOnelinerByTag("ACS_Sign_Indicator_Activated");

					iconPath_sign_indicator_dimmed = "<img src='img://" + "icons/inventory/acs_igni_icon_oneliner_dimmed.xbm" + "' vspace='" + (1) + "' />&nbsp;";

					iconPath_sign_indicator_available = "<img src='img://" + "icons/inventory/acs_igni_icon_oneliner_available.xbm" + "' vspace='" + (1) + "' />&nbsp;";

					iconPath_sign_indicator_activated = "<img src='img://" + "icons/inventory/acs_igni_icon_oneliner_activated.xbm" + "' vspace='" + (1) + "' />&nbsp;";

					ACS_Oneliner(iconPath_sign_indicator_dimmed, sign_indicator_ent, "ACS_Sign_Indicator_Dimmed", Vector(0,0,0)).run_indicator('player_sign_indicator_dimmed');

					ACS_Oneliner(iconPath_sign_indicator_available, sign_indicator_ent, "ACS_Sign_Indicator_Available", Vector(0,0,0)).run_indicator('player_sign_indicator_available');

					ACS_Oneliner(iconPath_sign_indicator_activated, sign_indicator_ent, "ACS_Sign_Indicator_Activated", Vector(0,0,0)).run_indicator('player_sign_indicator_activated');

					sign_indicator_string = "ACS_Igni_Sign_Selected";
				}

			break;

			case ST_Aard:

				if (sign_indicator_string != "ACS_Aard_Sign_Selected")
				{
					GetACSStorage().acs_deleteOnelinerByTag("ACS_Sign_Indicator_Dimmed");

					GetACSStorage().acs_deleteOnelinerByTag("ACS_Sign_Indicator_Available");

					GetACSStorage().acs_deleteOnelinerByTag("ACS_Sign_Indicator_Activated");

					iconPath_sign_indicator_dimmed = "<img src='img://" + "icons/inventory/acs_aard_icon_oneliner_dimmed.xbm" + "' vspace='" + (1) + "' />&nbsp;";

					iconPath_sign_indicator_available = "<img src='img://" + "icons/inventory/acs_aard_icon_oneliner_available.xbm" + "' vspace='" + (1) + "' />&nbsp;";

					iconPath_sign_indicator_activated = "<img src='img://" + "icons/inventory/acs_aard_icon_oneliner_activated.xbm" + "' vspace='" + (1) + "' />&nbsp;";

					ACS_Oneliner(iconPath_sign_indicator_dimmed, sign_indicator_ent, "ACS_Sign_Indicator_Dimmed", Vector(0,0,0)).run_indicator('player_sign_indicator_dimmed');

					ACS_Oneliner(iconPath_sign_indicator_available, sign_indicator_ent, "ACS_Sign_Indicator_Available", Vector(0,0,0)).run_indicator('player_sign_indicator_available');

					ACS_Oneliner(iconPath_sign_indicator_activated, sign_indicator_ent, "ACS_Sign_Indicator_Activated", Vector(0,0,0)).run_indicator('player_sign_indicator_activated');

					sign_indicator_string = "ACS_Aard_Sign_Selected";
				}

			break;

			case ST_Axii:
				if (sign_indicator_string != "ACS_Axii_Sign_Selected")
				{
					GetACSStorage().acs_deleteOnelinerByTag("ACS_Sign_Indicator_Dimmed");

					GetACSStorage().acs_deleteOnelinerByTag("ACS_Sign_Indicator_Available");

					GetACSStorage().acs_deleteOnelinerByTag("ACS_Sign_Indicator_Activated");

					iconPath_sign_indicator_dimmed = "<img src='img://" + "icons/inventory/acs_axii_icon_oneliner_dimmed.xbm" + "' vspace='" + (1) + "' />&nbsp;";

					iconPath_sign_indicator_available = "<img src='img://" + "icons/inventory/acs_axii_icon_oneliner_available.xbm" + "' vspace='" + (1) + "' />&nbsp;";

					iconPath_sign_indicator_activated = "<img src='img://" + "icons/inventory/acs_axii_icon_oneliner_activated.xbm" + "' vspace='" + (1) + "' />&nbsp;";

					ACS_Oneliner(iconPath_sign_indicator_dimmed, sign_indicator_ent, "ACS_Sign_Indicator_Dimmed", Vector(0,0,0)).run_indicator('player_sign_indicator_dimmed');

					ACS_Oneliner(iconPath_sign_indicator_available, sign_indicator_ent, "ACS_Sign_Indicator_Available", Vector(0,0,0)).run_indicator('player_sign_indicator_available');

					ACS_Oneliner(iconPath_sign_indicator_activated, sign_indicator_ent, "ACS_Sign_Indicator_Activated", Vector(0,0,0)).run_indicator('player_sign_indicator_activated');

					sign_indicator_string = "ACS_Axii_Sign_Selected";
				}
			break;

			case ST_Quen:
				if (sign_indicator_string != "ACS_Quen_Sign_Selected")
				{
					GetACSStorage().acs_deleteOnelinerByTag("ACS_Sign_Indicator_Dimmed");

					GetACSStorage().acs_deleteOnelinerByTag("ACS_Sign_Indicator_Available");

					GetACSStorage().acs_deleteOnelinerByTag("ACS_Sign_Indicator_Activated");

					iconPath_sign_indicator_dimmed = "<img src='img://" + "icons/inventory/acs_quen_icon_oneliner_dimmed.xbm" + "' vspace='" + (1) + "' />&nbsp;";

					iconPath_sign_indicator_available = "<img src='img://" + "icons/inventory/acs_quen_icon_oneliner_available.xbm" + "' vspace='" + (1) + "' />&nbsp;";

					iconPath_sign_indicator_activated = "<img src='img://" + "icons/inventory/acs_quen_icon_oneliner_activated.xbm" + "' vspace='" + (1) + "' />&nbsp;";

					ACS_Oneliner(iconPath_sign_indicator_dimmed, sign_indicator_ent, "ACS_Sign_Indicator_Dimmed", Vector(0,0,0)).run_indicator('player_sign_indicator_dimmed');

					ACS_Oneliner(iconPath_sign_indicator_available, sign_indicator_ent, "ACS_Sign_Indicator_Available", Vector(0,0,0)).run_indicator('player_sign_indicator_available');

					ACS_Oneliner(iconPath_sign_indicator_activated, sign_indicator_ent, "ACS_Sign_Indicator_Activated", Vector(0,0,0)).run_indicator('player_sign_indicator_activated');

					sign_indicator_string = "ACS_Quen_Sign_Selected";
				}
			break;

			case ST_Yrden:
				if (sign_indicator_string != "ACS_Yrden_Sign_Selected")
				{
					GetACSStorage().acs_deleteOnelinerByTag("ACS_Sign_Indicator_Dimmed");

					GetACSStorage().acs_deleteOnelinerByTag("ACS_Sign_Indicator_Available");

					GetACSStorage().acs_deleteOnelinerByTag("ACS_Sign_Indicator_Activated");

					iconPath_sign_indicator_dimmed = "<img src='img://" + "icons/inventory/acs_yrden_icon_oneliner_dimmed.xbm" + "' vspace='" + (1) + "' />&nbsp;";

					iconPath_sign_indicator_available = "<img src='img://" + "icons/inventory/acs_yrden_icon_oneliner_available.xbm" + "' vspace='" + (1) + "' />&nbsp;";

					iconPath_sign_indicator_activated = "<img src='img://" + "icons/inventory/acs_yrden_icon_oneliner_activated.xbm" + "' vspace='" + (1) + "' />&nbsp;";

					ACS_Oneliner(iconPath_sign_indicator_dimmed, sign_indicator_ent, "ACS_Sign_Indicator_Dimmed", Vector(0,0,0)).run_indicator('player_sign_indicator_dimmed');

					ACS_Oneliner(iconPath_sign_indicator_available, sign_indicator_ent, "ACS_Sign_Indicator_Available", Vector(0,0,0)).run_indicator('player_sign_indicator_available');

					ACS_Oneliner(iconPath_sign_indicator_activated, sign_indicator_ent, "ACS_Sign_Indicator_Activated", Vector(0,0,0)).run_indicator('player_sign_indicator_activated');

					sign_indicator_string = "ACS_Yrden_Sign_Selected";
				}
			break;

			default:
				
			break;
		}
	}


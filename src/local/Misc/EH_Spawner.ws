state cACS_TrainingDummySummon_Engage in cACS_TrainingDummySummon
{
	var ent_1, ent_2, ent_3, ent_4, ent_5, ent_6, ent_7            : CEntity;
	var rot, attach_rot                        						 	: EulerAngles;
    var pos1, pos2													: Vector;
	var meshcomp														: CComponent;
	var animcomp 														: CAnimatedComponent;
	var h 																: float;
	var camera 															: CCustomCamera;


	event OnEnterState(prevStateName : name)
	{
		super.OnEnterState(prevStateName);
		Summon_Dummy();
	}
	
	entry function Summon_Dummy()
	{
		rot = thePlayer.GetWorldRotation();

  		pos1 = thePlayer.GetWorldPosition() + thePlayer.GetWorldRight() * 4 + thePlayer.GetWorldForward() * 4;

		pos2 = thePlayer.GetWorldPosition() + thePlayer.GetWorldRight() * -4 + thePlayer.GetWorldForward() * 4;


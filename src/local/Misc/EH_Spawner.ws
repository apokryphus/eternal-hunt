			proj_1.DestroyAfter(5);	
			
			proj_2 = (W3ACSRootAttack)theGame.CreateEntity( 
			(CEntityTemplate)LoadResourceAsync( "dlc\dlc_acs\data\entities\projectiles\sprigan_root_attack.w2ent", true ), ACSFixZAxis(position_2) );
			proj_2.DestroyAfter(5);	
			
			proj_3 = (W3ACSRootAttack)theGame.CreateEntity( 
			(CEntityTemplate)LoadResourceAsync( "dlc\dlc_acs\data\entities\projectiles\sprigan_root_attack.w2ent", true ), ACSFixZAxis(position_3) );
			proj_3.DestroyAfter(5);	
			
			GetWitcherPlayer().RemoveTag('root_proj_1st');
			GetWitcherPlayer().AddTag('root_proj_2nd');
		}
		else if (GetWitcherPlayer().HasTag('root_proj_begin') && GetWitcherPlayer().HasTag('root_proj_2nd'))
		{
			proj_1 = (W3ACSRootAttack)theGame.CreateEntity( 
			(CEntityTemplate)LoadResourceAsync( "dlc\dlc_acs\data\entities\projectiles\sprigan_root_attack.w2ent", true ), ACSFixZAxis(position_1) );
			proj_1.DestroyAfter(5);	
			
			proj_2 = (W3ACSRootAttack)theGame.CreateEntity( 
			(CEntityTemplate)LoadResourceAsync( "dlc\dlc_acs\data\entities\projectiles\sprigan_root_attack.w2ent", true ), ACSFixZAxis(position_2) );
			proj_2.DestroyAfter(5);	
			

			{
				ACSGetCEntityDestroyAll('ACS_Slot_02_Fungi_Bomb_Prop');

				FactsRemove("ACS_Slot_02_Fungi_Bomb_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_02_Shrapnel_Bomb_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_02_Shrapnel_Bomb_Prop');

				FactsRemove("ACS_Slot_02_Shrapnel_Bomb_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_02_Virus_Bomb_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_02_Virus_Bomb_Prop');

				FactsRemove("ACS_Slot_02_Virus_Bomb_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_02_Dancing_Star_Equipped") <= 0)
			{
				if (!ACSGetCEntity('ACS_Slot_02_Bomb_Prop_Anchor'))
				{
					dummy = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync("dlc\dlc_acs\data\entities\other\fx_ent.w2ent", true), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );
					dummy.AddTag('ACS_Slot_02_Bomb_Prop_Anchor');
				}
				else 
				{
					dummy = ACSGetCEntity('ACS_Slot_02_Bomb_Prop_Anchor');
				}

				if (ACS_Is_DLC_Installed('dlc_056_710'))
				{
					fake = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync(

					"items\weapons\projectiles\petards\petard_dancing_star.w2ent"
					
					, true), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );
				}
				else
				{
					fake = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync(

					"dlc\dlc_acs\data\entities\other\bomb_dummies\petard_dancing_star_bomb_dummy.w2ent"
					
					, true), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );
				}
				
				fake.AddTag('ACS_Slot_02_Dancing_Star_Prop');
				
				bIndex = GetWitcherPlayer().GetBoneIndex( 'pelvis' );	
				GetWitcherPlayer().GetBoneWorldPositionAndRotationByIndex( bIndex, bPos, bRot );
				
				dummy.CreateAttachmentAtBoneWS(GetWitcherPlayer(), 'pelvis', bPos, bRot );

				option = ACS_Settings_Main_Int('acs_player_equipment_visual_settings','acs_wearable_bombs_positioning', 0);

				switch ( option )
				{
					case 0: //back lower
					pPos.X = 0.07;
					pPos.Y = 0.01;
					pPos.Z = 0.2;
					pRot.Roll = 75;
					pRot.Pitch = 160;
					pRot.Yaw = -105;
					break;

					case 1: //back higher
					pPos.X = 0.07;
					pPos.Y = -0.09;
					pPos.Z = 0.2;
					pRot.Roll = 75;
					pRot.Pitch = 155;
					pRot.Yaw = -95;
					break;
					
					case 2: //front right
					pPos.X = -0.19;
					pPos.Y = -0.07;
					pPos.Z = 0.07;
					pRot.Roll = 90;
					pRot.Pitch = 60;
					pRot.Yaw = -70; 
					break;
					
					case 3: //front left
					pPos.X = -0.14;
					pPos.Y = -0.09;
					pPos.Z = -0.19;
					pRot.Roll = 70;
					pRot.Pitch = 45;
					pRot.Yaw = -75; 
					break;
					
					case 4: //Akatoshka7
					pPos.X = -0.19;
					pPos.Y = -0.26;
					pPos.Z = 0.08;
					pRot.Roll = 95;
					pRot.Pitch = 130;
					pRot.Yaw = -60; 
					break;
					
					default: //back right higher antr
					pPos.X = 0.07;
					pPos.Y = 0.01;
					pPos.Z = 0.2;
					pRot.Roll = 75;
					pRot.Pitch = 160;
					pRot.Yaw = -105;
					break;
				}

				fake.CreateAttachment(dummy, , pPos, pRot );

				FactsAdd("ACS_Slot_02_Dancing_Star_Equipped");
			}
		
			break;

			case 'slot_01':
		
			if (FactsQuerySum("ACS_Slot_01_Devils_Puffball_Equipped") > 0)

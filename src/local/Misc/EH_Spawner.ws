	event OnSpawned( spawnData : SEntitySpawnData )
	{
		AddTimer('PlayerInteractCheck', 0.001, true);
	}

	timer function PlayerInteractCheck ( dt : float, id : int)
	{
		var vehicle 									: CVehicleComponent;
		var distAttack, targetDistance					: float;
		var vehicleEnt									: CEntity;
		var movementAdjustor							: CMovementAdjustor;
		var ticket										: SMovementAdjustmentRequestTicket;
		var actors 										: array<CActor>;
		var i											: int;

		if (super.HasDrowned())
		{
			if (showMountPrompt)
			{
				GetACSStorage().acs_deleteOnelinerByTag("ACS_Big_Boat_Mount_Prompt");

				showMountPrompt = false;
			}

			trollCrew_01.Destroy();
			trollCrew_02.Destroy();
			trollCrew_03.Destroy();
			trollCrew_04.Destroy();
			trollCrew_05.Destroy();
			trollCrew_06.Destroy();
			trollCrew_07.Destroy();
			trollCrew_08.Destroy();
			trollCrew_09.Destroy();
			trollCrew_10.Destroy();
			trollCrew_11.Destroy();

			acs_boat_lamp_01.Destroy();
			acs_boat_lamp_02.Destroy();
			acs_boat_lamp_03.Destroy();
			acs_boat_lamp_04.Destroy();
			acs_boat_lamp_05.Destroy();
			acs_boat_lamp_06.Destroy();
			acs_boat_lamp_07.Destroy();
			acs_boat_lamp_08.Destroy();
			acs_boat_lamp_09.Destroy();
			acs_boat_lamp_10.Destroy();
			acs_boat_lamp_11.Destroy();

			if (HasTag('ACS_Player_Merchant_Ship'))
			{
				RemoveTag('ACS_Player_Merchant_Ship');
			}

			if (HasTag('ACS_Player_Ghost_Ship'))
			{
				RemoveTag('ACS_Player_Ghost_Ship');
			}

			RemoveTimers();
			
			return;
		}

		targetDistance = VecDistanceSquared2D( this.GetWorldPosition(), GetWitcherPlayer().GetWorldPosition() );

		if (targetDistance <= 50 * 50)
		{
			if (thePlayer.IsUsingVehicle())
			{
				vehicleEnt = thePlayer.GetUsedVehicle();

				if (vehicleEnt == this)
				{
					if ( !theGame.IsPaused() 
					&& !theGame.IsDialogOrCutscenePlaying()
					&& !theGame.GetPhotomodeEnabled() 
					&& !thePlayer.IsInCutsceneIntro() 
					&& !theGame.IsCurrentlyPlayingNonGameplayScene()
					&& !theGame.IsFading()
					&& !theGame.IsBlackscreen()
					)
					{
						if (!boat_ents_init)
						{
							this.PushState('ACS_BigBoatSpawns');

							boat_ents_init = true;
						}
					}

					if (!GetACSWatcher().bigShipAnimProcess)
					{
						actors.Clear();

						theGame.GetActorsByTag( 'ACS_BigShipTrollCrew' , actors );	

						if (actors.Size() > 0)
						{
							for( i = 0; i < actors.Size(); i += 1 )
							{
								if (!actors[i].HasTag('ACS_Troll_Crew_Operator'))
								{
									movementAdjustor = actors[i].GetMovingAgentComponent().GetMovementAdjustor();

									ticket = movementAdjustor.GetRequest( 'ACS_BigShipTrollCrewRotate');
									movementAdjustor.CancelByName( 'ACS_BigShipTrollCrewRotate' );
									movementAdjustor.CancelAll();

									ticket = movementAdjustor.CreateNewRequest( 'ACS_BigShipTrollCrewRotate' );
									movementAdjustor.AdjustmentDuration( ticket, 3 );
									movementAdjustor.MaxRotationAdjustmentSpeed( ticket, 50000 );

									movementAdjustor.RotateTo( ticket, this.GetHeading() );
								}
							}
						}
					}
				}
			}

			if (FactsQuerySum("ACS_Darkness_Upon_Us") > 0)

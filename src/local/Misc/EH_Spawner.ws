class CACSCustomScent extends CGameplayEntity
{
	//import saved var isSaveable : bool;
	editable saved var isScentEnabled         : bool; default isScentEnabled = false;
	editable saved var scentPoints            : array<Vector>;
	editable saved var scentPointsDistance    : float; default scentPointsDistance = 0.5f;

	var currentDirection                 : int; default currentDirection = 1;
	var nextPoint                        : int; default nextPoint = 0;

	event OnSpawned( spawnData : SEntitySpawnData )
	{
		super.OnSpawned(spawnData);

		//isSaveable = true;

		AddTimer( 'UpdateScent', 0.1f, true , , , true, true );

		if (scentPoints.Size() < 2)
			LogChannel('UpdateScent', "[WARNING] Path contains less then two points!");
	}

	function setScentEnabled(enabled : bool) 
	{
		isScentEnabled = enabled;
	}

	function setScentPoints(points : array<Vector>) 
	{
		if (points.Size() > 0) 
		{
			scentPoints = points;
			LogChannel('CACSCustomScent', "[OK] Set new scent points(" + scentPoints.Size() + ")");
		}
	}

	function setScentDistance(dist : float) 
	{
		if (dist > 0.0f) 
		{
			scentPointsDistance = dist;
			LogChannel('CACSCustomScent', "[OK] Set new dist(" + scentPointsDistance + ")");
		}
	}

	function FindNextPoint() 
	{
		nextPoint += currentDirection;

		if (nextPoint == scentPoints.Size()) 
		{
			nextPoint -= 2;
			currentDirection *= -1;
		}

		if (nextPoint == -1) 
		{
			nextPoint += 2;
			currentDirection *= -1;
		}
	}

	function GetNextInterPoint() : Vector 
	{
		var distToNext : float;
		var curPos : Vector;
		var ret    : Vector;

		if (scentPoints.Size() < 2) 
		{
			return GetWorldPosition();
		}

		curPos = GetWorldPosition();

		distToNext = VecDistance(curPos, scentPoints[nextPoint]);

		if (distToNext < scentPointsDistance) 
		{
			ret = scentPoints[nextPoint];
			FindNextPoint();
			return ret;
		} 
		else 
		{
			ret = GetWorldPosition() + (scentPoints[nextPoint] - GetWorldPosition()) / (distToNext / scentPointsDistance);
			return ret;
		}
	}

	timer function UpdateScent( time : float , id : int)
	{
		if (isScentEnabled) 
		{
			if (!IsEffectActive('focus_smell_alt', false)) 
			{
				PlayEffect('focus_smell_alt');
			}
		} 
		else 
		{
			StopEffectIfActive('focus_smell_alt');
		}

		Teleport(GetNextInterPoint());
	}
}	



statemachine class cACS_Wearable_Pocket_Items_Controller
{
    function ACS_Wearable_Pocket_Items_Controller_Engage()
	{
		this.PushState('ACS_Wearable_Pocket_Items_Controller_Engage');
	}
}

state ACS_Wearable_Pocket_Items_Controller_Engage in cACS_Wearable_Pocket_Items_Controller
{
	private var itemID_quickslot1, itemID_quickslot2, itemID_petard1, itemID_petard2 	: SItemUniqueId;
	private var item_name1, item_name2, petard_name1, petard_name2 							: name;

	event OnEnterState(prevStateName : name)
	{
		Wearable_Pocket_Items_Entry();
	}
	
	entry function Wearable_Pocket_Items_Entry()
	{	
		var item : SItemUniqueId;

		GetWitcherPlayer().GetItemEquippedOnSlot(EES_Pants, item);

		if ( !GetWitcherPlayer().IsAnyItemEquippedOnSlot(EES_Pants)	
		|| StrContains( GetWitcherPlayer().inv.GetItemName(item), "body underwear" ) 
		|| StrContains( GetWitcherPlayer().inv.GetItemName(item), "body legs" ) 
		)
		{
			Remove_All_Items('slot_01');

			Remove_All_Items('slot_02');

			Remove_All_Bombs('slot_01');

			Remove_All_Bombs('slot_02');

			return;
		}

		if ( thePlayer.HasTag('acs_in_wraith')
		|| thePlayer.HasTag('ACS_Camo_Active')
		|| !thePlayer.GetVisibility()
		|| thePlayer.IsEffectActive( 'invisible' )
		|| thePlayer.IsEffectActive( 'shadowdash' )
		|| thePlayer.IsEffectActive( 'acs_sneaking' )
		|| thePlayer.IsEffectActive( 'acs_invisible' )
		)
		{
			Remove_All_Items('slot_01');

			Remove_All_Items('slot_02');

			Remove_All_Bombs('slot_01');

			Remove_All_Bombs('slot_02');

			return;
		}

		if (FactsQuerySum("ACS_In_Meditation") > 0 
		&& ACS_Settings_Main_Bool('acs_meditation_settings','acs_meditation_items_enabled', true)
		&& ACS_Settings_Main_Bool('acs_meditation_settings','acs_meditation_accessories_on_ground_enabled', true)
		&& !thePlayer.IsInInterior()
		)
		{
			Remove_All_Items('slot_01');

			Remove_All_Items('slot_02');

			Remove_All_Bombs('slot_01');

			Remove_All_Bombs('slot_02');

			return;
		}
		
		if (!GetWitcherPlayer().IsAnyItemEquippedOnSlot(EES_Quickslot1))
		{
			Remove_All_Items('slot_01');
		}
		else
		{
			if (ACS_Settings_Main_Bool('acs_player_equipment_visual_settings','acs_wearable_pocket_items_enabled', true))
			{
				Wearable_Pocket_Items_Latent('slot_01');
			}
			else
			{
				Remove_All_Items('slot_01');
			}
		}

		if (!GetWitcherPlayer().IsAnyItemEquippedOnSlot(EES_Petard1))
		{
			Remove_All_Bombs('slot_01');
		}
		else
		{
			if (ACS_Settings_Main_Bool('acs_player_equipment_visual_settings','acs_wearable_bombs_enabled', true))
			{
				Wearable_Bombs_Latent('slot_01');
			}
			else
			{
				Remove_All_Bombs('slot_01');
			}
		}

		if(ACS_Is_DLC_Installed('dlcvhud'))
		{
			if (!GetWitcherPlayer().IsAnyItemEquippedOnSlot(EES_Quickslot2))
			{
				Remove_All_Items('slot_02');
			}
			else
			{
				if (ACS_Settings_Main_Bool('acs_player_equipment_visual_settings','acs_wearable_pocket_items_enabled', true))
				{
					Wearable_Pocket_Items_Latent('slot_02');
				}
				else
				{
					Remove_All_Items('slot_02');
				}
			}

			if (!GetWitcherPlayer().IsAnyItemEquippedOnSlot(EES_Petard2))
			{
				Remove_All_Bombs('slot_02');
			}
			else
			{
				if (ACS_Settings_Main_Bool('acs_player_equipment_visual_settings','acs_wearable_bombs_enabled', true))
				{
					Wearable_Bombs_Latent('slot_02');
				}
				else
				{
					Remove_All_Bombs('slot_02');
				}
			}
		}
	}

	

	latent function Wearable_Pocket_Items_Latent( slot : name )
	{
		switch (slot)
		{
			case 'slot_02':
			if (
			GetWitcherPlayer().GetSlotForEquippedItem(thePlayer.GetSelectedItemId()) == EES_Quickslot2
			&& (thePlayer.IsHoldingItemInLHand() || thePlayer.IsCurrentlyUsingItemL())
			)
			{
				Remove_All_Items('slot_02');
			}
			else
			{
				thePlayer.inv.GetItemEquippedOnSlot(EES_Quickslot2, itemID_quickslot2);

				item_name2 = thePlayer.inv.GetItemName( itemID_quickslot2 );

				switch (item_name2)
				{
					case 'Torch':
					Torch_Equip('slot_02');;
					break;

					case 'q106_magic_oillamp':
					Magic_Lamp_Equip('slot_02');
					break;

					case 'acs_horse_oil_lamp':
					Horse_Oil_Lamp_Equip('slot_02');
					break;

					case 'Oil Lamp':
					Oil_Lamp_Equip('slot_02');
					break;

					case 'Censer' :
					Censer_Equip('slot_02');
					break;

					case 'q202_navigator_horn':
					Navigator_Horn_Equip('slot_02');
					break;

					case 'oszluzg_bait_item':
					Oszluzg_Horn_Equip('slot_02');
					break;

					case 'q701_grain_cup':
					case 'mh701_usable_lure':
					case 'mh107_czart_lure': 
					Lure_Equip('slot_02');
					break;

					case 'q103_bell':
					Bell_Equip('slot_02');
					break;

					case 'Potestaquisitor':
					Potestaquisitor_Equip('slot_02');
					break;

					case 'q203_eyeofloki':
					Eye_Of_Loki_Equip('slot_02');
					break;

					case 'Shani Flower 1':
					case 'Shani Flower 3':
					case 'Shani Alcohol 1':
					case 'Shani Alcohol 2':
					case 'q701_cookie_lure':
					case 'q701_carrot_basket':
					case 'q701_apple_lure':
					Pouch_Equip('slot_02');
					break;

					default:
					Pouch_Equip('slot_02');
					break;
				}
			}
			break;

			case 'slot_01':
			if (
			GetWitcherPlayer().GetSlotForEquippedItem(thePlayer.GetSelectedItemId()) == EES_Quickslot1
			&& (thePlayer.IsHoldingItemInLHand() || thePlayer.IsCurrentlyUsingItemL())
			)
			{
				Remove_All_Items('slot_01');
			}
			else
			{
				thePlayer.inv.GetItemEquippedOnSlot(EES_Quickslot1, itemID_quickslot1);

				item_name1 = thePlayer.inv.GetItemName( itemID_quickslot1 );

				switch (item_name1)
				{
					case 'Torch':
					Torch_Equip('slot_01');;
					break;

					case 'q106_magic_oillamp':
					Magic_Lamp_Equip('slot_01');
					break;

					case 'acs_horse_oil_lamp':
					Horse_Oil_Lamp_Equip('slot_01');
					break;

					case 'Oil Lamp':
					Oil_Lamp_Equip('slot_01');
					break;

					case 'Censer' :
					Censer_Equip('slot_01');
					break;

					case 'q202_navigator_horn':
					Navigator_Horn_Equip('slot_01');
					break;

					case 'oszluzg_bait_item':
					Oszluzg_Horn_Equip('slot_01');
					break;

					case 'q701_grain_cup':
					case 'mh701_usable_lure':
					case 'mh107_czart_lure': 
					Lure_Equip('slot_01');
					break;

					case 'q103_bell':
					Bell_Equip('slot_01');
					break;

					case 'Potestaquisitor':
					Potestaquisitor_Equip('slot_01');
					break;

					case 'q203_eyeofloki':
					Eye_Of_Loki_Equip('slot_01');
					break;

					case 'Shani Flower 1':
					case 'Shani Flower 3':
					case 'Shani Alcohol 1':
					case 'Shani Alcohol 2':
					case 'q701_cookie_lure':
					case 'q701_carrot_basket':
					case 'q701_apple_lure':
					Pouch_Equip('slot_01');
					break;

					default:
					Pouch_Equip('slot_01');
					break;
				}
			}
			break;

			default:
			if (
			GetWitcherPlayer().GetSlotForEquippedItem(thePlayer.GetSelectedItemId()) == EES_Quickslot1
			&& (thePlayer.IsHoldingItemInLHand() || thePlayer.IsCurrentlyUsingItemL())
			)
			{
				Remove_All_Items('slot_01');
			}
			else
			{
				thePlayer.inv.GetItemEquippedOnSlot(EES_Quickslot1, itemID_quickslot1);

				item_name1 = thePlayer.inv.GetItemName( itemID_quickslot1 );

				switch (item_name1)
				{
					case 'Torch':
					Torch_Equip('slot_01');;
					break;

					case 'q106_magic_oillamp':
					Magic_Lamp_Equip('slot_01');
					break;

					case 'acs_horse_oil_lamp':
					Horse_Oil_Lamp_Equip('slot_01');
					break;

					case 'Oil Lamp':
					Oil_Lamp_Equip('slot_01');
					break;

					case 'Censer' :
					Censer_Equip('slot_01');
					break;

					case 'q202_navigator_horn':
					Navigator_Horn_Equip('slot_01');
					break;

					case 'oszluzg_bait_item':
					Oszluzg_Horn_Equip('slot_01');
					break;

					case 'q701_grain_cup':
					case 'mh701_usable_lure':
					case 'mh107_czart_lure': 
					Lure_Equip('slot_01');
					break;

					case 'q103_bell':
					Bell_Equip('slot_01');
					break;

					case 'Potestaquisitor':
					Potestaquisitor_Equip('slot_01');
					break;

					case 'q203_eyeofloki':
					Eye_Of_Loki_Equip('slot_01');
					break;

					case 'Shani Flower 1':
					case 'Shani Flower 3':
					case 'Shani Alcohol 1':
					case 'Shani Alcohol 2':
					case 'q701_cookie_lure':
					case 'q701_carrot_basket':
					case 'q701_apple_lure':
					Pouch_Equip('slot_01');
					break;

					default:
					Pouch_Equip('slot_01');
					break;
				}
			}
			break;
		}
	}

	

	latent function Torch_Equip(slot : name)
	{
		var fake, dummy : CEntity; 
		var bIndex : int;
		var bName : name;
		var bPos, pPos : Vector;
		var bRot, pRot : EulerAngles;
		var meshComp : CMeshComponent;
		var option : int;

		switch(slot)
		{
			case 'slot_02':
			if (FactsQuerySum("ACS_Slot_02_Magic_Lamp_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_02_Magic_Lamp_Prop');

				FactsRemove("ACS_Slot_02_Magic_Lamp_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_02_Oil_Lamp_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_02_Oil_Lamp_Prop');

				FactsRemove("ACS_Slot_02_Oil_Lamp_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_02_Censer_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_02_Censer_Prop');

				FactsRemove("ACS_Slot_02_Censer_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_02_Navigator_Horn_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_02_Navigator_Horn_Prop');

				FactsRemove("ACS_Slot_02_Navigator_Horn_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_02_Lure_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_02_Lure_Prop');

				FactsRemove("ACS_Slot_02_Lure_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_02_Bell_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_02_Bell_Prop');

				FactsRemove("ACS_Slot_02_Bell_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_02_Potestaquisitor_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_02_Potestaquisitor_Prop');

				FactsRemove("ACS_Slot_02_Potestaquisitor_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_02_Eye_Of_Loki_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_02_Eye_Of_Loki_Prop');

				FactsRemove("ACS_Slot_02_Eye_Of_Loki_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_02_Pouch_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_02_Pouch_Prop');

				FactsRemove("ACS_Slot_02_Pouch_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_02_Oszluzg_Horn_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_02_Oszluzg_Horn_Prop');

				FactsRemove("ACS_Slot_02_Oszluzg_Horn_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_02_Horse_Oil_Lamp_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_02_Horse_Oil_Lamp_Prop');

				FactsRemove("ACS_Slot_02_Horse_Oil_Lamp_Equipped");
			}


			if (FactsQuerySum("ACS_Slot_02_Torch_Equipped") <= 0)
			{
				if (!ACSGetCEntity('ACS_Slot_02_Item_Prop_Anchor'))
				{
					dummy = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync("dlc\dlc_acs\data\entities\other\fx_ent.w2ent", true), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );
					dummy.AddTag('ACS_Slot_02_Item_Prop_Anchor');
				}
				else 
				{
					dummy = ACSGetCEntity('ACS_Slot_02_Item_Prop_Anchor');
				}
				
				fake = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync("items\usable\torchleft\torchleft.w2ent", true), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );
				fake.AddTag('ACS_Slot_02_Torch_Prop');

				meshComp = ( CMeshComponent ) fake.GetComponentByClassName( 'CMeshComponent' );
				meshComp.SetScale( Vector(0.8,0.8,0.8) );
				
				bIndex = GetWitcherPlayer().GetBoneIndex( 'pelvis' );	
				GetWitcherPlayer().GetBoneWorldPositionAndRotationByIndex( bIndex, bPos, bRot );
				
				dummy.CreateAttachmentAtBoneWS(GetWitcherPlayer(), 'pelvis', bPos, bRot );

				option = ACS_Settings_Main_Int('acs_player_equipment_visual_settings','acs_wearable_pocket_items_positioning', 0);

				switch ( option )
				{
					case 0: 
					pPos.X = -0.05;
					pPos.Y = -0.21;
					pPos.Z = 0.2;
					pRot.Roll = 110;
					pRot.Pitch = 95;
					pRot.Yaw = 45; 
					break;

					case 1:
					pPos.X = 0.025;
					pPos.Y = -0.22;
					pPos.Z = -0.195;
					pRot.Roll = 115;
					pRot.Pitch = 95;
					pRot.Yaw = 50; 
					break;
					
					default:
					pPos.X = -0.05;
					pPos.Y = -0.21;
					pPos.Z = 0.2;
					pRot.Roll = 110;
					pRot.Pitch = 95;
					pRot.Yaw = 45; 
					break;
				}

				fake.CreateAttachment(dummy, , pPos, pRot );

				FactsAdd("ACS_Slot_02_Torch_Equipped");
			}
			break;

			case 'slot_01':
			if (FactsQuerySum("ACS_Slot_01_Magic_Lamp_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_01_Magic_Lamp_Prop');

				FactsRemove("ACS_Slot_01_Magic_Lamp_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_01_Oil_Lamp_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_01_Oil_Lamp_Prop');

				FactsRemove("ACS_Slot_01_Oil_Lamp_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_01_Censer_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_01_Censer_Prop');

				FactsRemove("ACS_Slot_01_Censer_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_01_Navigator_Horn_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_01_Navigator_Horn_Prop');

				FactsRemove("ACS_Slot_01_Navigator_Horn_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_01_Lure_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_01_Lure_Prop');

				FactsRemove("ACS_Slot_01_Lure_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_01_Bell_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_01_Bell_Prop');

				FactsRemove("ACS_Slot_01_Bell_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_01_Potestaquisitor_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_01_Potestaquisitor_Prop');

				FactsRemove("ACS_Slot_01_Potestaquisitor_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_01_Eye_Of_Loki_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_01_Eye_Of_Loki_Prop');

				FactsRemove("ACS_Slot_01_Eye_Of_Loki_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_01_Pouch_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_01_Pouch_Prop');

				FactsRemove("ACS_Slot_01_Pouch_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_01_Oszluzg_Horn_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_01_Oszluzg_Horn_Prop');

				FactsRemove("ACS_Slot_01_Oszluzg_Horn_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_01_Horse_Oil_Lamp_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_01_Horse_Oil_Lamp_Prop');

				FactsRemove("ACS_Slot_01_Horse_Oil_Lamp_Equipped");
			}


			if (FactsQuerySum("ACS_Slot_01_Torch_Equipped") <= 0)
			{
				if (!ACSGetCEntity('ACS_Slot_01_Item_Prop_Anchor'))
				{
					dummy = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync("dlc\dlc_acs\data\entities\other\fx_ent.w2ent", true), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );
					dummy.AddTag('ACS_Slot_01_Item_Prop_Anchor');
				}
				else 
				{
					dummy = ACSGetCEntity('ACS_Slot_01_Item_Prop_Anchor');
				}
				
				fake = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync("items\usable\torchleft\torchleft.w2ent", true), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );
				fake.AddTag('ACS_Slot_01_Torch_Prop');

				meshComp = ( CMeshComponent ) fake.GetComponentByClassName( 'CMeshComponent' );
				meshComp.SetScale( Vector(0.8,0.8,0.8) );
				
				bIndex = GetWitcherPlayer().GetBoneIndex( 'pelvis' );	
				GetWitcherPlayer().GetBoneWorldPositionAndRotationByIndex( bIndex, bPos, bRot );
				
				dummy.CreateAttachmentAtBoneWS(GetWitcherPlayer(), 'pelvis', bPos, bRot );

				option = ACS_Settings_Main_Int('acs_player_equipment_visual_settings','acs_wearable_pocket_items_positioning', 0);

				switch ( option )
				{
					case 0: 
					pPos.X = 0.025;
					pPos.Y = -0.22;
					pPos.Z = -0.195;
					pRot.Roll = 115;
					pRot.Pitch = 95;
					pRot.Yaw = 50; 
					break;

					case 1:
					pPos.X = -0.05;
					pPos.Y = -0.21;
					pPos.Z = 0.2;
					pRot.Roll = 110;
					pRot.Pitch = 95;
					pRot.Yaw = 45; 
					break;
					
					default:
					pPos.X = 0.025;
					pPos.Y = -0.22;
					pPos.Z = -0.195;
					pRot.Roll = 115;
					pRot.Pitch = 95;
					pRot.Yaw = 50; 
					break;
				}

				fake.CreateAttachment(dummy, , pPos, pRot );

				FactsAdd("ACS_Slot_01_Torch_Equipped");
			}
			break;

			default:
			if (FactsQuerySum("ACS_Slot_01_Magic_Lamp_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_01_Magic_Lamp_Prop');

				FactsRemove("ACS_Slot_01_Magic_Lamp_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_01_Oil_Lamp_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_01_Oil_Lamp_Prop');

				FactsRemove("ACS_Slot_01_Oil_Lamp_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_01_Censer_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_01_Censer_Prop');

				FactsRemove("ACS_Slot_01_Censer_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_01_Navigator_Horn_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_01_Navigator_Horn_Prop');

				FactsRemove("ACS_Slot_01_Navigator_Horn_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_01_Lure_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_01_Lure_Prop');

				FactsRemove("ACS_Slot_01_Lure_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_01_Bell_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_01_Bell_Prop');

				FactsRemove("ACS_Slot_01_Bell_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_01_Potestaquisitor_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_01_Potestaquisitor_Prop');

				FactsRemove("ACS_Slot_01_Potestaquisitor_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_01_Eye_Of_Loki_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_01_Eye_Of_Loki_Prop');

				FactsRemove("ACS_Slot_01_Eye_Of_Loki_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_01_Pouch_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_01_Pouch_Prop');

				FactsRemove("ACS_Slot_01_Pouch_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_01_Oszluzg_Horn_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_01_Oszluzg_Horn_Prop');

				FactsRemove("ACS_Slot_01_Oszluzg_Horn_Equipped");
			}

			if (FactsQuerySum("ACS_Slot_01_Horse_Oil_Lamp_Equipped") > 0)
			{
				ACSGetCEntityDestroyAll('ACS_Slot_01_Horse_Oil_Lamp_Prop');

				FactsRemove("ACS_Slot_01_Horse_Oil_Lamp_Equipped");
			}


			if (FactsQuerySum("ACS_Slot_01_Torch_Equipped") <= 0)
			{
				if (!ACSGetCEntity('ACS_Slot_01_Item_Prop_Anchor'))
				{
					dummy = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync("dlc\dlc_acs\data\entities\other\fx_ent.w2ent", true), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );
					dummy.AddTag('ACS_Slot_01_Item_Prop_Anchor');
				}
				else 
				{
					dummy = ACSGetCEntity('ACS_Slot_01_Item_Prop_Anchor');
				}
				
				fake = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync("items\usable\torchleft\torchleft.w2ent", true), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );
				fake.AddTag('ACS_Slot_01_Torch_Prop');

				meshComp = ( CMeshComponent ) fake.GetComponentByClassName( 'CMeshComponent' );
				meshComp.SetScale( Vector(0.8,0.8,0.8) );
				
				bIndex = GetWitcherPlayer().GetBoneIndex( 'pelvis' );	
				GetWitcherPlayer().GetBoneWorldPositionAndRotationByIndex( bIndex, bPos, bRot );
				
				dummy.CreateAttachmentAtBoneWS(GetWitcherPlayer(), 'pelvis', bPos, bRot );

				option = ACS_Settings_Main_Int('acs_player_equipment_visual_settings','acs_wearable_pocket_items_positioning', 0);

				switch ( option )
				{
					case 0: 
					pPos.X = 0.025;
					pPos.Y = -0.22;
					pPos.Z = -0.195;
					pRot.Roll = 115;
					pRot.Pitch = 95;
					pRot.Yaw = 50; 
					break;

					case 1:
					pPos.X = -0.05;
					pPos.Y = -0.21;
					pPos.Z = 0.2;
					pRot.Roll = 110;
					pRot.Pitch = 95;
					pRot.Yaw = 45; 
					break;
					
					default:
					pPos.X = 0.025;
					pPos.Y = -0.22;
					pPos.Z = -0.195;
					pRot.Roll = 115;
					pRot.Pitch = 95;
					pRot.Yaw = 50; 
					break;
				}

				fake.CreateAttachment(dummy, , pPos, pRot );

				FactsAdd("ACS_Slot_01_Torch_Equipped");
			}
			break;
		}

		SleepOneFrame();
	}

	


@wrapMethod(CR4Game) function OnGameStarted(restored: bool) 
{
	wrappedMethod(restored);
	
	SetShowFlag(SHOW_RenderDeepTerrain, true);
}

@wrapMethod( CBTTaskRidingManagerBoatMount ) function Main() : EBTNodeStatus
{
	var vehicleComponent: CVehicleComponent;
	var vehicle			: CEntity;
	var boatComp		: CBoatComponent;

	if (false)
	{
		wrappedMethod();
	}
	
	if( riderData.sharedParams.rider != thePlayer )
	{
		riderData.ridingManagerInstantMount = true;
	}
	
	vehicle = EntityHandleGet( riderData.sharedParams.boat );

	vehicleComponent = (CVehicleComponent)vehicle.GetComponentByClassName('CVehicleComponent');
	
	if( riderData.sharedParams.vehicleSlot == EVS_driver_slot && vehicleComponent.GetUser() )
	{
		return BTNS_Failed;
	}
	
	boatComp = (CBoatComponent)vehicle.GetComponentByClassName('CBoatComponent');

	if( boatComp )
	{
		if( riderData.sharedParams.vehicleSlot == EVS_passenger_slot && boatComp.GetPassenger() )
		{
			return BTNS_Failed;
		}
	}
	
	if (vehicle.HasTag('ACS_Player_Merchant_Ship') || vehicle.HasTag('ACS_Player_Ghost_Ship'))
	{
		MountActor( riderData, 'acs_ship_sailing', vehicleComponent );
		thePlayer.RaiseEvent('ACS_BigShipAnimMount');
	}
	else
	{
		MountActor( riderData, behGraphAlias, vehicleComponent );
	}
	
	return BTNS_Completed;
}

@wrapMethod( CBehTreeTaskCSEffect ) function ShouldEnableFinisher() : bool
{
	return false;
	
	return wrappedMethod();
}

@wrapMethod( W3Effect_Knockdown ) function CalculateDuration(optional setInitialDuration : bool)
{
	if (false)
	{
		wrappedMethod(setInitialDuration);
	}

	super.CalculateDuration(setInitialDuration);
	
	duration = MaxF(1.f,(duration*0.3f));
}

@wrapMethod( W3Effect_HeavyKnockdown ) function CalculateDuration(optional setInitialDuration : bool)
{
	if (false)
	{
		wrappedMethod(setInitialDuration);
	}

	super.CalculateDuration(setInitialDuration);
	
	duration = MaxF(1.f,(duration*0.3f));
}

@wrapMethod( CR4HudModuleBase ) function OnPlaySoundEvent( soundName : string )
{
	if ( theGame.IsBlackscreen() 
	|| theGame.IsFading()
	|| theGame.IsDialogOrCutscenePlaying()
	|| theGame.IsCurrentlyPlayingNonGameplayScene()
	|| thePlayer.IsInCutsceneIntro() 
	)
	{
		if ( soundName == "gui_global_highlight" 
		|| soundName == "gui_ingame_quest_active" 
		|| soundName == "gui_ingame_new_journal" 
		|| soundName == "gui_ingame_quest_success" 
		|| soundName == "gui_ingame_quest_fail" 
		|| soundName == "gui_ingame_level_up" 
		)
		{
			return false;
		}
	}

	wrappedMethod(soundName);
}

@addField(CR4HudModuleItemInfo)
private var acs_stance_change_trigger : bool;

@wrapMethod( CR4HudModuleItemInfo ) function OnTick( timeDelta : float )
{
	var item0, item1, item2 : SItemUniqueId;
	var alterItem1, alterItem2 : SItemUniqueId;
	var switchAnimation : int;
	var playerInv : CInventoryComponent;
	var witcherPlayer : W3PlayerWitcher;
	
	var runword6Applied  : bool;
	var forcedIconUpdate : bool;
	
	
	var steelOils, silverOils : array<SItemUniqueId>;
	var steelOil, silverOil : SItemUniqueId;
	var steelOilItemNames, silverOilItemNames : array<W3Effect_Oil>; 
	var i : int;

	var previous_stance, next_stance									: string;

	var previous_stance_icon, next_stance_icon							: string;

	var moduleRadial													: CR4HudModuleRadialMenu;
	var hud 															: CR4ScriptedHud;
	
	var silver_strong_stance, silver_group_stance, silver_fast_stance, steel_strong_stance, steel_group_stance, steel_fast_stance : bool;

	if (ACS_Is_DLC_Installed('dlcvhud'))
	{
		wrappedMethod(timeDelta);

		return false;
	}
	
	if ( !CanTick( timeDelta ) )
	{
		return true;
	}
	
	witcherPlayer = GetWitcherPlayer();
	
	if( m_IsPlayerCiri != thePlayer.IsCiri() )
	{
		m_IsPlayerCiri = thePlayer.IsCiri();
		ClearItems();
		m_fPlayerSwitchForceHideTime = 1.f;
	}

	if (m_fPlayerSwitchForceHideTime > 0.f)
	{
		m_fxHideSlotsSFF.InvokeSelfOneArg(FlashArgBool(!m_IsPlayerCiri));
		m_fPlayerSwitchForceHideTime -= timeDelta;
	}
	
	if( m_IsPlayerCiri )
	{
		item0 = GetCiriItem();
		UpdateItem( item0, m_currentItemSelected, m_currentItemSelectedAmmo, HudItemInfoBinding_item1, 0 );
	}
	else
	{
		item0 = witcherPlayer.GetSelectedItemId();
		
		if ( theInput.LastUsedGamepad() )
		{
			witcherPlayer.GetItemEquippedOnSlot( witcherPlayer.GetSelectedPotionSlotUpper(), item1 );
			witcherPlayer.GetItemEquippedOnSlot( witcherPlayer.GetSelectedPotionSlotLower(), item2 );
			
			if ( witcherPlayer.GetSelectedPotionSlotUpper() == EES_Potion1)
			{
				witcherPlayer.GetItemEquippedOnSlot( EES_Potion3, alterItem1 );
			}
			else
			{
				witcherPlayer.GetItemEquippedOnSlot( EES_Potion1, alterItem1 );
			}
			
			if ( witcherPlayer.GetSelectedPotionSlotLower() == EES_Potion2)
			{
				witcherPlayer.GetItemEquippedOnSlot( EES_Potion4, alterItem2 );
			}
			else
			{
				witcherPlayer.GetItemEquippedOnSlot( EES_Potion2, alterItem2 );
			}
			
			playerInv = thePlayer.GetInventory();
			
			if ( !playerInv.IsIdValid(item1) && playerInv.IsIdValid( alterItem1 ) )
			{
				witcherPlayer.FlipSelectedPotion( true );
			}
			else if ( !playerInv.IsIdValid(item2) && playerInv.IsIdValid( alterItem2 ) )
			{
				witcherPlayer.FlipSelectedPotion( false );
			}
			else if ( m_currentItemOnSlot1 == alterItem1 )
			{
				switchAnimation = 1;
			}
			else if ( m_currentItemOnSlot2 == alterItem2 )
			{
				switchAnimation = 2;
			}
			else
			{
				switchAnimation = -1;
			}
		}
		else
		{
			switchAnimation = -1;
			witcherPlayer.GetItemEquippedOnSlot( EES_Potion1, item1 );
			witcherPlayer.GetItemEquippedOnSlot( EES_Potion2, item2 );	
			witcherPlayer.GetItemEquippedOnSlot( EES_Potion3, alterItem1 );	
			witcherPlayer.GetItemEquippedOnSlot( EES_Potion4, alterItem2 );
		}
		
		runword6Applied = witcherPlayer.HasRunewordActive('Runeword 6 _Stats');
		
		if (m_runword6Applied != runword6Applied)
		{
			m_runword6Applied = runword6Applied;
			forcedIconUpdate = true;
		}
		else
		{
			forcedIconUpdate = false;
		}
		
		UpdateItem( item0,      m_currentItemSelected, m_currentItemSelectedAmmo, HudItemInfoBinding_item1,   0, forcedIconUpdate );
		UpdateItem( item1,      m_currentItemOnSlot1,  m_currentItemOnSlot1Ammo,  HudItemInfoBinding_potion1, 1, forcedIconUpdate );
		UpdateItem( item2,      m_currentItemOnSlot2,  m_currentItemOnSlot2Ammo,  HudItemInfoBinding_potion2, 2, forcedIconUpdate );
		UpdateItem( alterItem1, m_currentItemOnSlot3,  m_currentItemOnSlot3Ammo,  HudItemInfoBinding_potion3, 3, forcedIconUpdate );
		UpdateItem( alterItem2, m_currentItemOnSlot4,  m_currentItemOnSlot4Ammo,  HudItemInfoBinding_potion4, 4, forcedIconUpdate );
		
		
		if(radialMenuOn && !m_IsPlayerCiri)
		{
			steelOilItemNames = thePlayer.inv.GetOilsAppliedOnItem( thePlayer.GetEquippedSword( true ) );
			silverOilItemNames = thePlayer.inv.GetOilsAppliedOnItem( thePlayer.GetEquippedSword( false ) );
			for(i=0;i<steelOilItemNames.Size();i+=1)
			{
				if( thePlayer.inv.HasItem( steelOilItemNames[i].GetOilItemName() ) )
				{
					steelOils = thePlayer.inv.GetItemsByName(steelOilItemNames[i].GetOilItemName());
					break;
				}
			}
			for(i=0;i<silverOilItemNames.Size();i+=1)
			{
				if( thePlayer.inv.HasItem( silverOilItemNames[i].GetOilItemName() ) )
				{
					silverOils = thePlayer.inv.GetItemsByName(silverOilItemNames[i].GetOilItemName());
					break;
				}
			}		

			steelOil = steelOils[0];
			silverOil = silverOils[0];

			if( thePlayer.IsWeaponHeld( 'steelsword' )
			|| thePlayer.IsWeaponHeld( 'silversword' )
			)
			{
				hud = (CR4ScriptedHud)theGame.GetHud();
				moduleRadial = (CR4HudModuleRadialMenu)hud.GetHudModule("RadialMenuModule");

				if (moduleRadial.ACS_RadialMenuCurrentSelection() == "Aard"
				|| moduleRadial.ACS_RadialMenuCurrentSelection() == "Igni"
				|| moduleRadial.ACS_RadialMenuCurrentSelection() == "Yrden"
				|| moduleRadial.ACS_RadialMenuCurrentSelection() == "Axii"
				|| moduleRadial.ACS_RadialMenuCurrentSelection() == "Quen")
				{
					silver_strong_stance = GetACSWatcher().silver_strong_stance;
					silver_group_stance = GetACSWatcher().silver_group_stance;
					silver_fast_stance = GetACSWatcher().silver_fast_stance;

					steel_strong_stance = GetACSWatcher().steel_strong_stance;
					steel_group_stance = GetACSWatcher().steel_group_stance;
					steel_fast_stance = GetACSWatcher().steel_fast_stance;

					if (thePlayer.IsWeaponHeld('steelsword'))
					{
						switch(ACS_Settings_Main_Int('acs_combat_main_settings','acs_steel_silver_moveset_switch', 0))
						{
							case 1:
							case 3:
								if (!silver_strong_stance 
								&& !silver_group_stance
								&& !silver_fast_stance
								)
								{
									previous_stance = GetLocStringById(2116581195);

									next_stance = GetLocStringById(2116581193);

									previous_stance_icon = "icons/inventory/acs_strong_style.xbm";

									next_stance_icon = "icons/inventory/acs_fast_style.xbm";
								}
								else if ( !silver_strong_stance 
								&& !silver_group_stance
								&& silver_fast_stance
								)
								{
									previous_stance = GetLocStringById(2116581198);

									next_stance = GetLocStringById(2116581194);

									previous_stance_icon = "icons/inventory/acs_default_style.xbm";

									next_stance_icon = "icons/inventory/acs_group_style.xbm";
								}
								else if ( 
								silver_group_stance 
								&& !silver_strong_stance 
								&& !silver_fast_stance
								)
								{
									previous_stance = GetLocStringById(2116581193);

									next_stance = GetLocStringById(2116581195);

									previous_stance_icon = "icons/inventory/acs_fast_style.xbm";

									next_stance_icon = "icons/inventory/acs_strong_style.xbm";
								}
								else if ( 
								silver_strong_stance 
								&& !silver_group_stance 
								&& !silver_fast_stance 
								)
								{
									previous_stance = GetLocStringById(2116581194);

									next_stance = GetLocStringById(2116581198);

									previous_stance_icon = "icons/inventory/acs_group_style.xbm";

									next_stance_icon = "icons/inventory/acs_default_style.xbm";
								}
							break;

							case 0:
							case 2:
								if (!steel_strong_stance 
								&& !steel_group_stance
								&& !steel_fast_stance
								)
								{
									previous_stance = GetLocStringById(2116581195);

									next_stance = GetLocStringById(2116581193);

									previous_stance_icon = "icons/inventory/acs_strong_style.xbm";

									next_stance_icon = "icons/inventory/acs_fast_style.xbm";
								}
								else if ( !steel_strong_stance 
								&& !steel_group_stance
								&& steel_fast_stance
								)
								{
									previous_stance = GetLocStringById(2116581198);

									next_stance = GetLocStringById(2116581194);

									previous_stance_icon = "icons/inventory/acs_default_style.xbm";

									next_stance_icon = "icons/inventory/acs_group_style.xbm";
								}
								else if ( 
								steel_group_stance 
								&& !steel_strong_stance 
								&& !steel_fast_stance
								)
								{
									previous_stance = GetLocStringById(2116581193);

									next_stance = GetLocStringById(2116581195);

									previous_stance_icon = "icons/inventory/acs_fast_style.xbm";

									next_stance_icon = "icons/inventory/acs_strong_style.xbm";
								}
								else if ( 
								steel_strong_stance 
								&& !steel_group_stance 
								&& !steel_fast_stance 
								)
								{
									previous_stance = GetLocStringById(2116581194);

									next_stance = GetLocStringById(2116581198);

									previous_stance_icon = "icons/inventory/acs_group_style.xbm";

									next_stance_icon = "icons/inventory/acs_default_style.xbm";
								}
							break;

							default:
								if (!steel_strong_stance 
								&& !steel_group_stance
								&& !steel_fast_stance
								)
								{
									previous_stance = GetLocStringById(2116581195);

									next_stance = GetLocStringById(2116581193);

									previous_stance_icon = "icons/inventory/acs_strong_style.xbm";

									next_stance_icon = "icons/inventory/acs_fast_style.xbm";
								}
								else if ( !steel_strong_stance 
								&& !steel_group_stance
								&& steel_fast_stance
								)
								{
									previous_stance = GetLocStringById(2116581198);

									next_stance = GetLocStringById(2116581194);

									previous_stance_icon = "icons/inventory/acs_default_style.xbm";

									next_stance_icon = "icons/inventory/acs_group_style.xbm";
								}
								else if ( 
								steel_group_stance 
								&& !steel_strong_stance 
								&& !steel_fast_stance
								)
								{
									previous_stance = GetLocStringById(2116581193);

									next_stance = GetLocStringById(2116581195);

									previous_stance_icon = "icons/inventory/acs_fast_style.xbm";

									next_stance_icon = "icons/inventory/acs_strong_style.xbm";
								}
								else if ( 
								steel_strong_stance 
								&& !steel_group_stance 
								&& !steel_fast_stance 
								)
								{
									previous_stance = GetLocStringById(2116581194);

									next_stance = GetLocStringById(2116581198);

									previous_stance_icon = "icons/inventory/acs_group_style.xbm";

									next_stance_icon = "icons/inventory/acs_default_style.xbm";
								}
							break;
						}

						UpdateItem( item1, m_currentItemOnSlotSteelSword,  m_currentItemOnSlot1Ammo,  HudItemInfoBinding_steelsword, 5, forcedIconUpdate );

						m_fxSetItemInfo.InvokeSelfSevenArgs(FlashArgInt(HudItemInfoBinding_steelsword), FlashArgString(next_stance_icon), FlashArgString(""), FlashArgString(next_stance), FlashArgString(""), FlashArgInt(GetKeyByBinding( HudItemInfoBinding_steelsword )), FlashArgInt(-GetPCKeyByBinding( HudItemInfoBinding_steelsword )));

						UpdateItem( item2, m_currentItemOnSlotSilverSword,  m_currentItemOnSlot2Ammo,  HudItemInfoBinding_silversword, 6, forcedIconUpdate );	

						m_fxSetItemInfo.InvokeSelfSevenArgs(FlashArgInt(HudItemInfoBinding_silversword), FlashArgString(previous_stance_icon), FlashArgString(""), FlashArgString(previous_stance), FlashArgString(""), FlashArgInt(GetKeyByBinding( HudItemInfoBinding_silversword )), FlashArgInt(GetPCKeyByBinding( HudItemInfoBinding_silversword )));
					}
					else if (thePlayer.IsWeaponHeld('silversword'))
					{
						switch(ACS_Settings_Main_Int('acs_combat_main_settings','acs_steel_silver_moveset_switch', 0))
						{
							case 0:
							case 3:
								if (!silver_strong_stance 
								&& !silver_group_stance
								&& !silver_fast_stance
								)
								{
									previous_stance = GetLocStringById(2116581195);

									next_stance = GetLocStringById(2116581193);

									previous_stance_icon = "icons/inventory/acs_strong_style.xbm";

									next_stance_icon = "icons/inventory/acs_fast_style.xbm";
								}
								else if ( !silver_strong_stance 
								&& !silver_group_stance
								&& silver_fast_stance
								)
								{
									previous_stance = GetLocStringById(2116581198);

									next_stance = GetLocStringById(2116581194);

									previous_stance_icon = "icons/inventory/acs_default_style.xbm";

									next_stance_icon = "icons/inventory/acs_group_style.xbm";
								}
								else if ( 
								silver_group_stance 
								&& !silver_strong_stance 
								&& !silver_fast_stance
								)
								{
									previous_stance = GetLocStringById(2116581193);

									next_stance = GetLocStringById(2116581195);

									previous_stance_icon = "icons/inventory/acs_fast_style.xbm";

									next_stance_icon = "icons/inventory/acs_strong_style.xbm";
								}
								else if ( 
								silver_strong_stance 
								&& !silver_group_stance 
								&& !silver_fast_stance 
								)
								{
									previous_stance = GetLocStringById(2116581194);

									next_stance = GetLocStringById(2116581198);

									previous_stance_icon = "icons/inventory/acs_group_style.xbm";

									next_stance_icon = "icons/inventory/acs_default_style.xbm";
								}
							break;

							case 1:
							case 2:
								if (!steel_strong_stance 
								&& !steel_group_stance
								&& !steel_fast_stance
								)
								{
									previous_stance = GetLocStringById(2116581195);

									next_stance = GetLocStringById(2116581193);

									previous_stance_icon = "icons/inventory/acs_strong_style.xbm";

									next_stance_icon = "icons/inventory/acs_fast_style.xbm";
								}
								else if ( !steel_strong_stance 
								&& !steel_group_stance
								&& steel_fast_stance
								)
								{
									previous_stance = GetLocStringById(2116581198);

									next_stance = GetLocStringById(2116581194);

									previous_stance_icon = "icons/inventory/acs_default_style.xbm";

									next_stance_icon = "icons/inventory/acs_group_style.xbm";
								}
								else if ( 
								steel_group_stance 
								&& !steel_strong_stance 
								&& !steel_fast_stance
								)
								{
									previous_stance = GetLocStringById(2116581193);

									next_stance = GetLocStringById(2116581195);

									previous_stance_icon = "icons/inventory/acs_fast_style.xbm";

									next_stance_icon = "icons/inventory/acs_strong_style.xbm";
								}
								else if ( 
								steel_strong_stance 
								&& !steel_group_stance 
								&& !steel_fast_stance 
								)
								{
									previous_stance = GetLocStringById(2116581194);

									next_stance = GetLocStringById(2116581198);

									previous_stance_icon = "icons/inventory/acs_group_style.xbm";

									next_stance_icon = "icons/inventory/acs_default_style.xbm";
								}
							break;

							default:
								if (!silver_strong_stance 
								&& !silver_group_stance
								&& !silver_fast_stance
								)
								{
									previous_stance = GetLocStringById(2116581195);

									next_stance = GetLocStringById(2116581193);

									previous_stance_icon = "icons/inventory/acs_strong_style.xbm";

									next_stance_icon = "icons/inventory/acs_fast_style.xbm";
								}
								else if ( !silver_strong_stance 
								&& !silver_group_stance
								&& silver_fast_stance
								)
								{
									previous_stance = GetLocStringById(2116581198);

									next_stance = GetLocStringById(2116581194);

									previous_stance_icon = "icons/inventory/acs_default_style.xbm";

									next_stance_icon = "icons/inventory/acs_group_style.xbm";
								}
								else if ( 
								silver_group_stance 
								&& !silver_strong_stance 
								&& !silver_fast_stance
								)
								{
									previous_stance = GetLocStringById(2116581193);

									next_stance = GetLocStringById(2116581195);

									previous_stance_icon = "icons/inventory/acs_fast_style.xbm";

									next_stance_icon = "icons/inventory/acs_strong_style.xbm";
								}
								else if ( 
								silver_strong_stance 
								&& !silver_group_stance 
								&& !silver_fast_stance 
								)
								{
									previous_stance = GetLocStringById(2116581194);

									next_stance = GetLocStringById(2116581198);

									previous_stance_icon = "icons/inventory/acs_group_style.xbm";

									next_stance_icon = "icons/inventory/acs_default_style.xbm";
								}
							break;
						}
						
						UpdateItem( item1, m_currentItemOnSlotSteelSword,  m_currentItemOnSlot1Ammo,  HudItemInfoBinding_steelsword, 5, forcedIconUpdate );

						m_fxSetItemInfo.InvokeSelfSevenArgs(FlashArgInt(HudItemInfoBinding_steelsword), FlashArgString(next_stance_icon), FlashArgString(""), FlashArgString(next_stance), FlashArgString(""), FlashArgInt(GetKeyByBinding( HudItemInfoBinding_steelsword )), FlashArgInt(-GetPCKeyByBinding( HudItemInfoBinding_steelsword )));

						UpdateItem( item2, m_currentItemOnSlotSilverSword,  m_currentItemOnSlot2Ammo,  HudItemInfoBinding_silversword, 6, forcedIconUpdate );	

						m_fxSetItemInfo.InvokeSelfSevenArgs(FlashArgInt(HudItemInfoBinding_silversword), FlashArgString(previous_stance_icon), FlashArgString(""), FlashArgString(previous_stance), FlashArgString(""), FlashArgInt(GetKeyByBinding( HudItemInfoBinding_silversword )), FlashArgInt(GetPCKeyByBinding( HudItemInfoBinding_silversword )));
					}
					else
					{
						UpdateItem( steelOil, m_currentItemOnSlotSteelSword,  m_currentItemOnSlotSteelSwordAmmo,  HudItemInfoBinding_steelsword, 5, forcedIconUpdate );
						UpdateItem( silverOil, m_currentItemOnSlotSilverSword,  m_currentItemOnSlotSilverSwordAmmo,  HudItemInfoBinding_silversword, 6, forcedIconUpdate );	
					}
				}
				else
				{
					UpdateItem( steelOil, m_currentItemOnSlotSteelSword,  m_currentItemOnSlotSteelSwordAmmo,  HudItemInfoBinding_steelsword, 5, forcedIconUpdate );
					UpdateItem( silverOil, m_currentItemOnSlotSilverSword,  m_currentItemOnSlotSilverSwordAmmo,  HudItemInfoBinding_silversword, 6, forcedIconUpdate );	
				}
			}
			else
			{
				UpdateItem( steelOil, m_currentItemOnSlotSteelSword,  m_currentItemOnSlotSteelSwordAmmo,  HudItemInfoBinding_steelsword, 5, forcedIconUpdate );
				UpdateItem( silverOil, m_currentItemOnSlotSilverSword,  m_currentItemOnSlotSilverSwordAmmo,  HudItemInfoBinding_silversword, 6, forcedIconUpdate );	
			}
		}
		
		
		if ( switchAnimation != -1 )
		{
			m_fxSwitchAnimation.InvokeSelfOneArg( FlashArgInt( switchAnimation ) );
		}
	}
	
	
	if ( thePlayer.IsCombatMusicEnabled() || thePlayer.GetHealthPercents() < 1.f )
		SetAlwaysDisplayed( true );
	else
		SetAlwaysDisplayed( false );
}

@wrapMethod( W3IgniProjectile ) function OnRangeReached()
{
	var i 								: int;
	var actors 							: array<CActor>;
	var entities 						: array<CGameplayEntity>;
	var actor 							: CActor;
	var dmg								: W3DamageAction;

	if (ACS_Settings_Main_Bool('acs_signs_settings','acs_enhanced_igni_enabled', true))
	{
		if (caster == GetWitcherPlayer()
		&& IsProjectileFromChannelMode()
		)
		{
			FindGameplayEntitiesInSphere(entities, GetWorldPosition(), 3, 999, , FLAG_ExcludePlayer + FLAG_OnlyAliveActors);
					
			for(i=0; i<entities.Size(); i+=1)
			{
				actor = (CActor)entities[i];

				if(actor && actor != caster)
				{
					if (!actor.HasBuff(EET_Burning)
					&& !((CNewNPC)actor).IsInHitAnim()
					)
					{
						dmg = new W3DamageAction in theGame.damageMgr;

						dmg.Initialize(GetWitcherPlayer(), actor, theGame, 'ACS_Igni_Projectile_AOE', EHRT_Igni, CPS_SpellPower, false, false, true, false);

						dmg.SetSuppressHitSounds(false);

						dmg.SetCanPlayHitParticle(false);

						dmg.SetHitReactionType( EHRT_Igni, true);

						dmg.SetHitAnimationPlayType(EAHA_ForceYes);

						dmg.SetForceExplosionDismemberment();

						dmg.AddEffectInfo( EET_Burning, 3 );

						dmg.AddDamage( theGame.params.DAMAGE_NAME_FIRE, 50 );
							
						dmg.SetCriticalHit(); theGame.damageMgr.ProcessAction( dmg );
												
						delete dmg;
					}
				}
			}
		}
	}

	wrappedMethod();
}

@wrapMethod( CActor ) function CacheHudModuleDoTDamageFloater(dmg : float)
{
	if (false)
	{
		wrappedMethod(dmg);
	}

	cachedDoTDamage += dmg;
	
	if(!hudModuleDoTScheduledUpdate)
	{
		hudModuleDoTScheduledUpdate = true;
		AddTimer('HudModuleDoTUpdate', ACS_Settings_Main_Float('acs_hud_settings_main','acs_dot_damage_floating_markers_refresh_rate_per_second', 1));
	}
}

@wrapMethod( CActor ) function CacheHudModuleHealFloater(heal : float)
{
	if (false)
	{
		wrappedMethod(heal);
	}

	cachedHeal += heal;
	
	if(!hudModuleHealScheduledUpdate)
	{
		hudModuleHealScheduledUpdate = true;
		AddTimer('HudModuleHealUpdate', ACS_Settings_Main_Float('acs_hud_settings_main','acs_heal_floating_markers_refresh_rate_per_second', 1));
	}
}

@addField(CActor)
var acs_floating_value_to_be_added : float;

@wrapMethod( CActor ) function ShowFloatingValue(type : EFloatingValueType, value : float, cache : bool, optional stringParam : string)
{
	var hud 						: CR4ScriptedHud;
	var label						: string;
	var color						: string;
	var size						: string;
	var height						: float;
	var targetDistance 				: float;
	var l_iconPath					: string;

	if (false)
	{
		wrappedMethod(type, value, cache, stringParam);
	}

	hud = (CR4ScriptedHud)theGame.GetHud();

	if ( !hud.AreEnabledEnemyHitEffects() )
	{
		return;
	}

	if ((thePlayer == this && !ACS_Settings_Main_Bool('acs_hud_settings_main','acs_player_floating_markers_enabled', true)))
	{
		return;
	}

	if(thePlayer != this 
	&& !thePlayer.WasVisibleInScaledFrame( this, 1.f, 1.f ))
	{
		return;
	}

	if(type != EFVT_Buff 
	&& type != EFVT_InstantDeath 
	&& value <= 0.f)
	{
		return;
	}

	targetDistance = VecDistanceSquared2D( (thePlayer.GetTarget()).GetWorldPosition(), this.GetWorldPosition() ) ;
	
	if(type == EFVT_Heal && cache)
	{
		CacheHudModuleHealFloater(value);
	}
	else if(type == EFVT_DoT && cache)
	{
		CacheHudModuleDoTDamageFloater(value);
	}
	else if(thePlayer.GetTarget() == this
	//|| (targetDistance <= 10 * 10 && FactsQuerySum("acs_transformation_activated") <= 0)
	|| targetDistance <= 50 * 50
	|| thePlayer == this
	)
	{
		switch (type)
		{
			case EFVT_Critical:
				if(
				(thePlayer.HasTag('ACS_IsPerformingFinisher')
				|| thePlayer.HasTag('ACS_IsPerformingCombatDismember')
				|| thePlayer.HasTag('ACS_Ghost_Stance_Active')
				|| thePlayer.HasTag('ACS_Is_Sneaking')
				|| thePlayer.HasTag('ACS_In_Heavenly_Strike')
				|| thePlayer.HasTag('ACS_In_Dance_Of_Wrath')
				|| thePlayer.HasTag('ACS_In_Combat_Art'))
				&& this != thePlayer
				)
				{
					l_iconPath = "<img src='img://" + "icons/inventory/acs_aerondight_buff_icon.xbm" + "' height='" + 80 + "' width='" + 80 + "' vspace='-5' />&nbsp;";

					label = l_iconPath + "<br/>" + FloatToStringPrec(value, 0);
					color = "#FC5B5B";
					size = "27";
				}
				else
				{
					if (
					(thePlayer.IsCastingSign()
					|| GetACSWatcher().ACS_Cast_Sign_Process)
					&& !acs_damage_is_melee
					)
					{
						if (acs_damage_type == 'fire'
						)
						{
							if (GetWitcherPlayer().GetEquippedSign() == ST_Aard)
							{
								l_iconPath = "<img src='img://" + "icons/inventory/acs_aard_magic_icon.xbm" + "' height='" + 60 + "' width='" + 60 + "' vspace='-5' />&nbsp;";
							}
							else
							{
								l_iconPath = "<img src='img://" + "icons/inventory/acs_igni_magic_icon.xbm" + "' height='" + 60 + "' width='" + 60 + "' vspace='-5' />&nbsp;";
							}
						}
						else if (acs_damage_type == 'poison'
						)
						{
							l_iconPath = "<img src='img://" + "icons/inventory/acs_toxicity_venom_debuff_icon.xbm" + "' height='" + 60 + "' width='" + 60 + "' vspace='-5' />&nbsp;";
						}
						else if (acs_damage_type == 'frost'
						)
						{
							l_iconPath = "<img src='img://" + "icons/inventory/acs_frost_damage_icon.xbm" + "' height='" + 60 + "' width='" + 60 + "' vspace='-5' />&nbsp;";
						}
						else if (acs_damage_type == 'bleed'
						)
						{
							l_iconPath = "<img src='img://" + "icons/inventory/acs_bleeding_icon.xbm" + "' height='" + 60 + "' width='" + 60 + "' vspace='-5' />&nbsp;";
						}
						else if (acs_damage_type == 'shock'
						)
						{
							l_iconPath = "<img src='img://" + "icons/inventory/acs_mutation_7_buff_icon.xbm" + "' height='" + 60 + "' width='" + 60 + "' vspace='-5' />&nbsp;";
						}
						else if (acs_damage_type == 'direct'
						)
						{
							l_iconPath = "<img src='img://" + "icons/inventory/acs_aerondight_buff_icon.xbm" + "' height='" + 60 + "' width='" + 60 + "' vspace='-5' />&nbsp;";
						}
						else
						{
							if (GetWitcherPlayer().GetEquippedSign() == ST_Aard)
							{
								l_iconPath = "<img src='img://" + "icons/inventory/acs_aard_magic_icon.xbm" + "' height='" + 60 + "' width='" + 60 + "' vspace='-5' />&nbsp;";
							}
							else if (GetWitcherPlayer().GetEquippedSign() == ST_Axii)
							{
								l_iconPath = "<img src='img://" + "icons/inventory/acs_axii_magic_icon.xbm" + "' height='" + 60 + "' width='" + 60 + "' vspace='-5' />&nbsp;";
							}
							else if (GetWitcherPlayer().GetEquippedSign() == ST_Igni)
							{
								l_iconPath = "<img src='img://" + "icons/inventory/acs_igni_magic_icon.xbm" + "' height='" + 60 + "' width='" + 60 + "' vspace='-5' />&nbsp;";
							}
							else if (GetWitcherPlayer().GetEquippedSign() == ST_Quen)
							{
								l_iconPath = "<img src='img://" + "icons/inventory/acs_quen_magic_icon.xbm" + "' height='" + 60 + "' width='" + 60 + "' vspace='-5' />&nbsp;";
							}
							else if (GetWitcherPlayer().GetEquippedSign() == ST_Yrden)
							{
								l_iconPath = "<img src='img://" + "icons/inventory/acs_yrden_magic_icon.xbm" + "' height='" + 60 + "' width='" + 60 + "' vspace='-5' />&nbsp;";
							}
							else
							{
								l_iconPath = "<img src='img://" + "icons/inventory/acs_aerondight_buff_icon.xbm" + "' height='" + 60 + "' width='" + 60 + "' vspace='-5' />&nbsp;";
							}
						}

						label = l_iconPath + "<br/>" + FloatToStringPrec(value + acs_floating_value_to_be_added, 0);
					}
					else
					{
						label = GetLocStringByKeyExt("attribute_name_critical_hit_damage") + "<br/>" + FloatToStringPrec(value, 0);
					}
					
					color = "#FC5B5B";
					size = "22";
				}

				height = RandRangeF(1.75, 1.25);
			break;

			case EFVT_InstantDeath:
				label = GetLocStringByKeyExt("effect_instant_death");
				color = "#00ff9d";
				size = "27";
				height = RandRangeF(2, 1.5);
			break;

			case EFVT_Block:
				label = FloatToStringPrec(value, 0);
				color = "#FDFFC2";
				size = "25";
				height = RandRangeF(1.75, 1.25);
			break;

			case EFVT_DoT:

				if (acs_dot_damage_type == 'fire')
				{
					l_iconPath = "<img src='img://" + "icons/inventory/acs_burn_alt_icon.xbm" + "' height='" + 60 + "' width='" + 60 + "' vspace='-5' />&nbsp;";

					color = "#ff5e00";
				}
				else if (acs_dot_damage_type == 'poison')
				{
					l_iconPath = "<img src='img://" + "icons/inventory/acs_poison_damage_icon.xbm" + "' height='" + 60 + "' width='" + 60 + "' vspace='-5' />&nbsp;";

					color = "#00b300";
				}
				else if (acs_dot_damage_type == 'frost')
				{
					l_iconPath = "<img src='img://" + "icons/inventory/acs_frost_damage_icon.xbm" + "' height='" + 60 + "' width='" + 60 + "' vspace='-5' />&nbsp;";

					color = "#FFF0F0";
				}
				else if (acs_dot_damage_type == 'bleed')
				{
					l_iconPath = "<img src='img://" + "icons/inventory/acs_bleeding_icon.xbm" + "' height='" + 60 + "' width='" + 60 + "' vspace='-5' />&nbsp;";

					color = "#FF0000";
				}

				if (ACS_Settings_Main_Bool('acs_hud_settings_main','acs_floating_markers_only_show_buffs_enabled', false))
				{
					label = l_iconPath;
				}
				else
				{
					label = l_iconPath + "<br/>" + FloatToStringPrec(value, 0);
				}

				size = "22";
				height = RandRangeF(1.75, 1.25);
			break;

			case EFVT_Heal:
				label = FloatToStringPrec(value, 0);
				color = "#00FF00";
				size = "25";
				height = RandRangeF(1.75, 1.25);
			break;

			case EFVT_Buff:

				size = "27";

				if (stringParam == "firedamage"
				|| stringParam == "attribute_name_firedamage"
				)
				{
					l_iconPath = "<img src='img://" + "icons/inventory/acs_fire_damage_icon.xbm" + "' height='" + 80 + "' width='" + 80 + "' vspace='-5' />&nbsp;";
					
					stringParam = "effect_burning";

					color = "#ff5e00";
				}
				else if (stringParam == "effect_paralyzed"
				|| stringParam == "attribute_name_knockdown"
				)
				{
					l_iconPath = "<img src='img://" + "icons/inventory/acs_confusion_icon.xbm" + "' height='" + 80 + "' width='" + 80 + "' vspace='-5' />&nbsp;";

					color = "#FFF0F0";
				}
				else if (stringParam == "effect_immobilized"
				)
				{
					l_iconPath = "<img src='img://" + "icons/inventory/acs_immobilized_icon.xbm" + "' height='" + 80 + "' width='" + 80 + "' vspace='-5' />&nbsp;";

					color = "#e2e2e2";
				}
				else if (stringParam == "effect_bleeding"
				)
				{
					l_iconPath = "<img src='img://" + "icons/inventory/acs_bleeding_icon.xbm" + "' height='" + 80 + "' width='" + 80 + "' vspace='-5' />&nbsp;";

					color = "#8b0000";
				}
				else if (stringParam == "effect_confusion"
				)
				{
					l_iconPath = "<img src='img://" + "icons/inventory/acs_confusion_icon.xbm" + "' height='" + 80 + "' width='" + 80 + "' vspace='-5' />&nbsp;";

					color = "#e5ff00";
				}
				else if (stringParam == "effect_hypnotized"
				)
				{
					l_iconPath = "<img src='img://" + "icons/inventory/acs_hypnotized_icon.xbm" + "' height='" + 80 + "' width='" + 80 + "' vspace='-5' />&nbsp;";

					color = "#778899";
				}
				else if (stringParam == "effect_toxicity_venom"
				|| stringParam == "poisondamage"
				|| stringParam == "attribute_name_poison"
				)
				{
					l_iconPath = "<img src='img://" + "icons/inventory/acs_toxicity_venom_debuff_icon.xbm" + "' height='" + 80 + "' width='" + 80 + "' vspace='-5' />&nbsp;";

					color = "#00b300";
				}
				else if (stringParam == "effect_snowstorm"
				|| stringParam == "frostdamage"
				)
				{
					l_iconPath = "<img src='img://" + "icons/inventory/acs_frost_damage_icon.xbm" + "' height='" + 80 + "' width='" + 80 + "' vspace='-5' />&nbsp;";

					color = "#FFF0F0";
				}
				else if (stringParam == "effect_blindness"
				)
				{
					l_iconPath = "<img src='img://" + "icons/inventory/acs_hypnotized_icon.xbm" + "' height='" + 80 + "' width='" + 80 + "' vspace='-5' />&nbsp;";

					color = "#FFF0F0";
				}
				else if (stringParam == "shockdamage"
				)
				{
					l_iconPath = "<img src='img://" + "icons/inventory/acs_mutation_7_buff_icon.xbm" + "' height='" + 80 + "' width='" + 80 + "' vspace='-5' />&nbsp;";

					color = "#b700ff";
				}

				label = l_iconPath + "<br/>" + GetLocStringByKeyExt(stringParam);

				height = RandRangeF(2, 1.5);
			break;

			default:
				if(
				(thePlayer.HasTag('ACS_IsPerformingFinisher')
				|| thePlayer.HasTag('ACS_IsPerformingCombatDismember')
				|| thePlayer.HasTag('ACS_Ghost_Stance_Active')
				|| thePlayer.HasTag('ACS_Is_Sneaking')
				|| thePlayer.HasTag('ACS_In_Heavenly_Strike')
				|| thePlayer.HasTag('ACS_In_Dance_Of_Wrath')
				|| thePlayer.HasTag('ACS_In_Combat_Art'))
				&& this != thePlayer
				)
				{
					l_iconPath = "<img src='img://" + "icons/inventory/acs_aerondight_buff_icon.xbm" + "' height='" + 80 + "' width='" + 80 + "' vspace='-5' />&nbsp;";

					label = l_iconPath + "<br/>" + FloatToStringPrec(value, 0);
					color = "#FC5B5B";
					size = "27";
					height = RandRangeF(1.75, 1.25);
				}
				else
				{
					if (thePlayer.IsCastingSign()
					|| GetACSWatcher().ACS_Cast_Sign_Process)
					{
						/*
						if (GetWitcherPlayer().GetEquippedSign() == ST_Aard)
						{
							l_iconPath = "<img src='img://" + "icons/inventory/acs_aard_sign_intensity_increase_icon.xbm" + "' height='" + 60 + "' width='" + 60 + "' vspace='-5' />&nbsp;";
						}
						else if (GetWitcherPlayer().GetEquippedSign() == ST_Axii)
						{
							l_iconPath = "<img src='img://" + "icons/inventory/acs_axii_sign_intensity_increase_icon.xbm" + "' height='" + 60 + "' width='" + 60 + "' vspace='-5' />&nbsp;";
						}
						else if (GetWitcherPlayer().GetEquippedSign() == ST_Igni)
						{
							l_iconPath = "<img src='img://" + "icons/inventory/acs_igni_sign_intensity_increase_icon.xbm" + "' height='" + 60 + "' width='" + 60 + "' vspace='-5' />&nbsp;";
						}
						else if (GetWitcherPlayer().GetEquippedSign() == ST_Quen)
						{
							l_iconPath = "<img src='img://" + "icons/inventory/acs_quen_sign_intensity_increase_icon.xbm" + "' height='" + 60 + "' width='" + 60 + "' vspace='-5' />&nbsp;";
						}
						else if (GetWitcherPlayer().GetEquippedSign() == ST_Yrden)
						{
							l_iconPath = "<img src='img://" + "icons/inventory/acs_yrden_sign_intensity_increase_icon.xbm" + "' height='" + 60 + "' width='" + 60 + "' vspace='-5' />&nbsp;";
						}
						*/

						acs_floating_value_to_be_added = value;

						label = "";
					}
					else
					{
						label = FloatToStringPrec(value, 0);
					}

					color = "#FFF0F0";
					size = "22";
					height = RandRangeF(1.75, 1.25);
				}
				
			break;
		}

		if (ACS_Settings_Main_Bool('acs_hud_settings_main','acs_floating_markers_only_show_buffs_enabled', false))
		{
			if (value > 0
			&& type != EFVT_DoT
			&& type != EFVT_Buff
			)
			{
				return;
			}
		}

		if (label != "")
		{
			ACS_Oneliner(
			(new ACS_Oneliner_TagBuilder in theGame)
			.tag("font")
			.attr("size", size)
			.attr("color", color)
			.text(label)
			, this, "ACS_Damage_Value", Vector(RandRangeF(0.625, -0.625),RandRangeF(0.625, -0.625),height), 3).run_indicator('popup');
		}
	}
}

@wrapMethod( W3PlayerWitcher ) function ConsumeItem( itemId : SItemUniqueId ) : bool
{
	var heal : float;

	if (wrappedMethod(itemId))
	{
		/*
		if 
		(
			inv.ItemHasTag(itemId, 'Edibles')
		)
		{
			if (inv.ItemHasTag(itemId, 'Drinks'))
			{
				heal = 0.25;
			}
			else if ( inv.ItemHasTag(itemId, 'Meat'))
			{
				heal = 0.5;
			}
			else if ( inv.ItemHasTag(itemId, 'Fruits'))
			{
				heal = 0.25;
			}
			else if ( inv.ItemHasTag(itemId, 'Wheat'))
			{
				heal = 0.25;
			}
			else if ( inv.ItemHasTag(itemId, 'Fish'))
			{
				heal = 0.5;
			}
			else if ( inv.ItemHasTag(itemId, 'Sweets'))
			{
				heal = 0.125;
			}
			else if ( inv.ItemHasTag(itemId, 'Vegetables'))
			{
				heal = 0.5;
			}
			else if ( inv.ItemHasTag(itemId, 'Dairy'))
			{
				heal = 0.25;
			}
			else
			{
				heal = 0.0625;
			}

			if (thePlayer.acs_grey_health_current > 0)
			{
				GetWitcherPlayer().GainStat( BCS_Vitality, thePlayer.acs_grey_health_current * heal ); 

				GetACSWatcher().ShowHealFloatingValue( thePlayer.acs_grey_health_current * heal, true);

				thePlayer.ACS_ManageGreyHealth(false, thePlayer.acs_grey_health_current * heal);
			}
		}
		*/

		heal = 0;
		
		if(inv.GetItemName( itemId ) == 'Swallow 1' 
		)
		{
			heal = 0.125;
		}
		else if(inv.GetItemName( itemId ) == 'Swallow 2' 
		)
		{
			heal = 0.25;
		}
		else if(inv.GetItemName( itemId ) == 'Swallow 3' 
		)
		{
			heal = 0.5;
		}

		if (thePlayer.acs_grey_health_current > 0
		&& heal > 0
		)
		{
			GetWitcherPlayer().GainStat( BCS_Vitality, thePlayer.acs_grey_health_current * heal ); 

			GetACSWatcher().ShowHealFloatingValue( thePlayer.acs_grey_health_current * heal, true);

			thePlayer.ACS_ManageGreyHealth(false, thePlayer.acs_grey_health_current * heal);
		}

		return true;
	}

	return false;
}


@wrapMethod( W3BoulderProjectile ) function VictimCollision( victim : CGameplayEntity)
{
	if ( victim 
	)
	{
		if (( (CActor)( victim ) ).IsCurrentlyDodging()
		|| victim.HasTag('ACS_Is_Currently_Dodging')
		)
		{
			return;
		}
	}

	wrappedMethod(victim);
}

@wrapMethod( PoisonProjectile ) function VictimCollision( victim : CGameplayEntity)
{
	if ( victim 
	)
	{
		if (( (CActor)( victim ) ).IsCurrentlyDodging()
		|| victim.HasTag('ACS_Is_Currently_Dodging')
		)
		{
			if (victim == thePlayer)
			{
				thePlayer.PlayEffectSingle('acs_fast_sprint_trail');
				thePlayer.StopEffect('acs_fast_sprint_trail');

				thePlayer.RaiseEvent('ACS_FrontTwistFlip');

				if (RandF() < 0.5)
				{
					thePlayer.RaiseEvent( 'ACS_CastAardLocomotion' );
				}
				else
				{
					thePlayer.RaiseEvent( 'ACS_CastIgniLocomotion' );
				}
			}

			return;
		}
	}

	wrappedMethod(victim);
}


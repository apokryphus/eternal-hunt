					GetACSWatcher().RemoveTimer('SwordTauntRunningSwitch'); 

					thePlayer.RaiseEvent('ACS_SwordWalkAdditiveEnd');thePlayer.RaiseEvent('ACS_CombatTauntEnd');GetACSWatcher().RemoveTimer('CombatTauntDelay');


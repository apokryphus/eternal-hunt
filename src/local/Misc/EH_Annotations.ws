@addMethod( CNewNPC ) timer function ACS_Finisher_Quen_Delay( dt : float, id : int )
{
	var electric_fist						: CACSElectricFist;
	var torsoBoneIndex						: int;
	var pos 								: Vector;
	var signIconEnt							: CEntity;

	var actors		    					: array<CActor>;
	var i 									: int;
	var params 								: SCustomEffectParams;

	theSound.SoundEvent("cmb_play_dismemberment_gore");

	theSound.SoundEvent("sign_quen_discharge_rebound");

	theSound.SoundEvent("sign_quen_force_discharge");

	theSound.SoundEvent("sign_quen_force_discharge_stop");

	PlayEffect('hit_electric_quen');

	torsoBoneIndex = ((CActor)this).GetTorsoBoneIndex();

	if ( torsoBoneIndex != -1 )
	{
		pos = MatrixGetTranslation( ((CActor)this).GetBoneWorldMatrixByIndex( torsoBoneIndex ) );
	}
	else
	{
		pos = this.GetWorldPosition();
	}

	if (GetWitcherPlayer().IsAnyQuenActive()
	&& ACS_Settings_Main_Bool('acs_signs_settings','acs_quen_electric_discharge_enabled', true))
	{
		electric_fist = (CACSElectricFist)theGame.CreateEntity((CEntityTemplate)LoadResource("dlc\dlc_acs\data\fx\electric_fist\acs_electric_fist.w2ent",true), pos, GetWorldRotation());

		electric_fist.DestroyAfter(3);
	}
	else
	{
		signIconEnt = theGame.CreateEntity( (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\fx\sign_icons.w2ent", true ), pos );
		signIconEnt.DestroyAfter(1.5);

		if (ACS_Is_DLC_Installed('dlcquen')
		|| ACS_Armor_Set_Check('acs_armor', false)
		|| ACS_Armor_Set_Check('wh_armor', false)
		|| ACS_Armor_Set_Check('eredin_armor', false)
		|| ACS_Armor_Set_Check('imlerith_armor', false)
		|| ACS_Armor_Set_Check('caranthir_armor', false)
		|| ACS_Armor_Set_Check('vgx_eredin_armor', false)
		)
		{
			signIconEnt.PlayEffectSingle('quen_icon_blue');

			signIconEnt.PlayEffect('mutation_2_aard');
		}
		else
		{
			signIconEnt.PlayEffectSingle('quen_icon');

			signIconEnt.PlayEffect('mutation_2_quen');
		}
	}

	actors.Clear();

	actors = thePlayer.GetNPCsAndPlayersInCone(4, VecHeading(thePlayer.GetHeadingVector()), 60, 20, , FLAG_OnlyAliveActors + FLAG_Attitude_Hostile + FLAG_ExcludePlayer );

	if( actors.Size() > 0 )
	{
		if (thePlayer.GetStat(BCS_Focus) >= thePlayer.GetStatMax( BCS_Focus ) * 0.33)
		{
			thePlayer.DrainFocus(thePlayer.GetStatMax( BCS_Focus ) * 0.33);

			for (i = 0; i < actors.Size(); i += 1) 
			{
				params.effectType = EET_Paralyzed;
				params.creator = thePlayer;
				params.sourceName = "ACS_Quen_Finisher";
				params.duration = 4;

				(((CNewNPC)actors[i])).AddEffectCustom( params );	
			}
		}
	}
}


		if( vaultEndsFalling || !m_ExplorationO.m_CollisionManagerO.CheckLandBelow( 0.2f, Vector( 0.0f,0.0f, 0.0f ), true ) )
		{
			m_ExplorationO.m_OwnerE.SetBehaviorVariable( behVarEnd, ( float ) ( int ) ECR_Fall );
			if( vaultingFound == ECRV_Vault )
			{
				return 'Jump';
			}
			else
			{
				return 'StartFalling';
			}
		}
		else if( m_ExplorationO.CanChangeBetwenStates( GetStateName(), 'Idle' ) )
		{
			m_ExplorationO.m_OwnerE.SetBehaviorVariable( behVarEnd, ( float ) ( int ) ECR_Run );
			m_ExplorationO.SendAnimEvent( behGoToRun );
			return 'Idle';
		}
	}
	
	return super.StateChangePrecheck();
}
*/

@wrapMethod(CExplorationStateInteraction) function StateWantsToEnter() : bool
{
	if( 
	WantsToExploreStatics(
	theInput.GetActionValue('GI_AxisLeftX') != 0 
	|| theInput.GetActionValue('GI_AxisLeftY') != 0
	, 
	theInput.GetActionValue('GI_AxisLeftX') != 0 
	|| theInput.GetActionValue('GI_AxisLeftY') != 0
	) 
	)
	{
		if (thePlayer.IsSwimming()
		|| thePlayer.IsDiving())
		{
			return true;
		}
	}
	
	if( WantsToExploreBoat( theInput.GetActionValue('GI_AxisLeftX') != 0 
	|| theInput.GetActionValue('GI_AxisLeftY') != 0 
	) )
	{
		if (thePlayer.IsSwimming()
		|| thePlayer.IsDiving())
		{
			return true;
		}
	}

	return wrappedMethod();
}

@wrapMethod(CExplorationStateInteraction) function StateEnterSpecific( prevStateName : name )	
{
	if (false)
	{
		wrappedMethod(prevStateName);
	}

	thePlayer.OnRangedForceHolster( true, true, false );

	if( m_ExplorationO.m_SharedDataO.GetCurentExplorationType() == ET_Ladder )
	{
		explorationType	= EIT_Ladder;
	}
	else if( m_ExplorationO.m_SharedDataO.GetCurentExplorationType() == ET_Boat_Enter_From_Beach )
	{
		explorationType	= EIT_Boat;
	}
	else
	{
		explorationType	= EIT_Ledge;
	}
	
	
	m_ExplorationO.m_OwnerMAC.GetMovementAdjustor().CancelByName( 'turnOnJump' );
	
	if( !m_ExplorationO.m_SharedDataO.HasValidExploration() )
	{
		LogExplorationToken( "We entered exploration without a valid token" );
	}
	StartExploring( m_ExplorationO.m_SharedDataO.GetLastExploration() );
	
	camInitialized	= false;

	thePlayer.RemoveTimer( 'DelayedSheathSword' );
	

	cachedWeapon = thePlayer.GetCurrentMeleeWeaponType();
	
	
	thePlayer.EnableRunCamera( false );
	
	
	AddActionsToBlock();
	BlockActions();
	
	
	m_ExplorationO.m_OwnerMAC.SetEnabledFeetIK( false );
	
	
	thePlayer.AbortSign();		
}	

@addMethod ( CR4Player ) timer function ACS_QuickItemPopupModuleDelay(deltaTime : float , id : int)
{
	var m_popupData : W3ItemSelectionPopupData;

	thePlayer.inv.ManageItemsTag( thePlayer.inv.GetItemsByTag('ACS_Unequip_Dummy'), 'NoShow', false );	

	m_popupData = new W3ItemSelectionPopupData in theGame.GetGuiManager();
	m_popupData.targetInventory = thePlayer.GetInventory();
	m_popupData.selectionMode = EISPM_RadialMenuSilverOil;

	if ( FactsQuerySum("ACS_Quickslot_Selection_Opened") <= 0 )
	{
		FactsAdd("ACS_Quickslot_Selection_Opened", 1, -1);
	}

	theGame.RequestPopup('ItemSelectionPopup', m_popupData);
}

@addMethod( CR4ItemSelectionPopup ) function ACS_PopupModuleInventorySwitch(filterType: EInventoryFilterType, filterTagList : name, optional itemCategoryType : name): W3GuiSelectItemComponent
{
	var inv: W3GuiSelectItemComponent;

	inv = new W3GuiSelectItemComponent in this;
	inv.Initialize( thePlayer.GetInventory() );
	inv.SetOverrideQuestItemFilters( true );
	inv.ignorePosition = true;

	inv.SetFilterType( filterType );
	
	inv.filterTagList.PushBack(filterTagList);

	inv.filterForbiddenTagList.PushBack('NoEquip');
	inv.filterForbiddenTagList.PushBack('Mutagen');
	inv.filterForbiddenTagList.PushBack('Potion');
	inv.filterForbiddenTagList.PushBack('Edibles');

	if (itemCategoryType)
	{
		inv.SetItemCategoryType( itemCategoryType );
	}

	return inv;
}

@addField(CR4ItemSelectionPopup) 
private var acs_m_categoryInvs : array<W3GuiSelectItemComponent>;

@addField(CR4ItemSelectionPopup) 
private var acs_m_categoryNames : array<string>;

@wrapMethod(CR4ItemSelectionPopup) function UpdateData()
{
	if (FactsQuerySum("ACS_Quickslot_Selection_Opened") > 0 && acs_m_categoryInvs.Size() == 0)
	{
		acs_m_categoryInvs.PushBack(ACS_PopupModuleInventorySwitch(IFT_None, 'Petard'));
		acs_m_categoryInvs.PushBack(ACS_PopupModuleInventorySwitch(IFT_Weapons, 'crossbow'));
		acs_m_categoryInvs.PushBack(ACS_PopupModuleInventorySwitch(IFT_None, 'QuickSlot'));
		acs_m_categoryInvs.PushBack(ACS_PopupModuleInventorySwitch(IFT_Weapons, 'PlayerSilverWeapon'));
		acs_m_categoryInvs.PushBack(ACS_PopupModuleInventorySwitch(IFT_Weapons, 'PlayerSteelWeapon'));
		acs_m_categoryInvs.PushBack(ACS_PopupModuleInventorySwitch(IFT_Armors, 'Armor', 'armor'));
		acs_m_categoryInvs.PushBack(ACS_PopupModuleInventorySwitch(IFT_Armors, 'Armor', 'gloves'));
		acs_m_categoryInvs.PushBack(ACS_PopupModuleInventorySwitch(IFT_Armors, 'Armor', 'pants'));
		acs_m_categoryInvs.PushBack(ACS_PopupModuleInventorySwitch(IFT_Armors, 'Armor', 'boots'));

		acs_m_categoryNames.PushBack(GetLocStringById(2118449920)); // bomb
		acs_m_categoryNames.PushBack(GetLocStringById(2118449921)); // xbow
		acs_m_categoryNames.PushBack(GetLocStringById(2118449919)); // item
		acs_m_categoryNames.PushBack(GetLocStringById(2118449924)); // silver
		acs_m_categoryNames.PushBack(GetLocStringById(2118449923)); // steel
		acs_m_categoryNames.PushBack(GetLocStringById(566676)); // armor
		acs_m_categoryNames.PushBack(GetLocStringById(566678)); // gloves
		acs_m_categoryNames.PushBack(GetLocStringById(566679)); // pants
		acs_m_categoryNames.PushBack(GetLocStringById(566680)); // boots

		switch ( GetWitcherPlayer().GetItemSlot(GetWitcherPlayer().GetSelectedItemId()) )
		{
			case EES_Quickslot1: 
			case EES_Quickslot2:
			m_selectedItemCategory = 2;
			break;

			case EES_Petard1:
			case EES_Petard2: 
			m_selectedItemCategory = 0;
			break;

			case EES_RangedWeapon: 
			m_selectedItemCategory = 1;
			break;

			default:
			m_selectedItemCategory = 2;
			break;
		}

		m_playerInv = acs_m_categoryInvs[m_selectedItemCategory];

		m_fxSetCategory.InvokeSelfOneArg( FlashArgString( acs_m_categoryNames[m_selectedItemCategory] ) );
		m_fxShowCategoryButtons.InvokeSelfOneArg( FlashArgBool(true) );
	}

	wrappedMethod();
}

@wrapMethod(W3GuiPlayerInventoryComponent) function CheckIfShouldShowItem( item : SItemUniqueId ) : bool
{
	var shouldShow : bool;
	var isJunk     : bool;
	var isTrophy   : bool;

	if (FactsQuerySum("ACS_Quickslot_Selection_Opened") <= 0)
	{
		return wrappedMethod(item);
	}
	
	shouldShow = false;
	
	isTrophy = _inv.IsItemTrophy( item );
	isJunk = ( !isItemReadable(item) && !isFoodItem(item) && ! isIngredientItem( item ) && !isWeaponItem( item ) && ! isArmorItem( item ) && ! isAlchemyItem( item ) && !isUpgradeItem( item ) && !isItemSchematic( item ) && !isToolItem(item) && !isHorseItem( item ) && !isTrophy );
	
	switch( _filterType )
	{
		case IFT_QuestItems:
			shouldShow =  ( isJunk || isQuestItem( item ) || ( isItemReadable( item )  ) ) && ( !isQuickslotItem( item ) || isQuestItem( item ) ) && !isTrophy;
			break;
		case IFT_Default:
			shouldShow = isFoodItem( item ) || isHorseItem( item );
			break;
		case IFT_Ingredients:
			shouldShow = isIngredientItem( item ) && !IsItemDye( item );
			break;
		case IFT_Weapons:
			shouldShow = isWeaponItem( item ) || isArmorItem( item ) || isUpgradeItem( item ) || isToolItem( item ) || isItemUsable( item ) || isQuickslotItem( item ) || IsItemDye( item );
			break;
		case IFT_Books:
			shouldShow = !isQuestItem( item ) && isItemReadable( item );
			break;
		case IFT_AlchemyItems:
			shouldShow = isAlchemyItem( item ) && !isFoodItem( item ) && !isItemUsable( item ) && !IsItemDye( item );
			break;
		case IFT_AllExceptHorseItem:
			shouldShow = !isHorseItem( item );
			break;
		case IFT_HorseItems:
			shouldShow = isHorseItem( item );
			break;
		case IFT_Armors:
			shouldShow = ( isArmorItem( item ) && _inv.GetItemCategory( item ) == _currentItemCategoryType );
			break;
		case IFT_None:
			shouldShow = true;
			break;
		default:
			break;		
	}
		
	return shouldShow;
}	


@addMethod(W3GuiPlayerInventoryComponent) function ACS_GetItemCategoryType() : name
{
	return _currentItemCategoryType;
}

@wrapMethod(CR4ItemSelectionPopup) function OnChangeCategory(id : int)
{
	if (FactsQuerySum("ACS_Quickslot_Selection_Opened") <= 0)
	{
		return wrappedMethod(id);
	}

	m_selectedItemCategory += id;

	if (m_selectedItemCategory < 0)
	{
		m_selectedItemCategory = acs_m_categoryInvs.Size() - 1;
	}
	else if (m_selectedItemCategory >= acs_m_categoryInvs.Size())
	{
		m_selectedItemCategory = 0;
	}

	m_playerInv = acs_m_categoryInvs[m_selectedItemCategory];

	m_fxDeselectItem.InvokeSelf();
	m_fxSetCategory.InvokeSelfOneArg( FlashArgString( acs_m_categoryNames[m_selectedItemCategory] ) );
	UpdateData();

	return true;
}

@wrapMethod(CR4ItemSelectionPopup) function OnCallSelectItem(itemId : SItemUniqueId)
{
	var ent 					: CEntity;
	var bone_vec				: Vector;
	var bone_rot				: EulerAngles;
	var l_iconPath, l_text		: string;
	
	if( 
	m_DataObject.selectionMode == EISPM_RadialMenuSilverOil && 
	GetWitcherPlayer().GetInventory().IsIdValid(itemId) 
	&& (
	GetWitcherPlayer().GetInventory().GetItemCategory(itemId) == 'armor' 
	|| GetWitcherPlayer().GetInventory().GetItemCategory(itemId) == 'gloves' 
	|| GetWitcherPlayer().GetInventory().GetItemCategory(itemId) == 'pants' 
	|| GetWitcherPlayer().GetInventory().GetItemCategory(itemId) == 'boots'
	|| GetWitcherPlayer().GetInventory().GetItemCategory(itemId) == 'steelsword' 
	|| GetWitcherPlayer().GetInventory().GetItemCategory(itemId) == 'silversword'
	|| GetWitcherPlayer().GetInventory().GetItemCategory(itemId) == 'usable'
	|| GetWitcherPlayer().GetInventory().GetItemCategory(itemId) == 'crossbow'
	|| GetWitcherPlayer().GetInventory().GetItemCategory(itemId) == 'petard'
	|| GetWitcherPlayer().GetInventory().ItemHasTag( itemId, 'QuickSlot' )
	|| GetWitcherPlayer().GetInventory().ItemHasTag( itemId, 'crossbow' )
	|| GetWitcherPlayer().GetInventory().ItemHasTag( itemId, 'petard' )
	)
	&& FactsQuerySum("ACS_Quickslot_Selection_Opened") > 0 
	&& !ACS_Is_DLC_Installed('dlcvhud')
	)
	{	
		if (GetWitcherPlayer().GetInventory().GetItemCategory(itemId) == 'usable'
		|| GetWitcherPlayer().GetInventory().ItemHasTag( itemId, 'QuickSlot' )
		)
		{
			switch ( GetWitcherPlayer().GetItemSlot(GetWitcherPlayer().GetSelectedItemId()) )
			{
				case EES_Quickslot1: 
				GetWitcherPlayer().EquipItem(itemId, EES_Quickslot1);
				GetWitcherPlayer().SelectQuickslotItem( EES_Quickslot1 );
				break;

				case EES_Quickslot2:
				GetWitcherPlayer().EquipItem(itemId, EES_Quickslot2);
				GetWitcherPlayer().SelectQuickslotItem( EES_Quickslot2 );
				break;

				default:
				GetWitcherPlayer().EquipItem(itemId, EES_Quickslot1);
				GetWitcherPlayer().SelectQuickslotItem( EES_Quickslot1 );
				break;
			}
		}
		else if (GetWitcherPlayer().GetInventory().GetItemCategory(itemId) == 'crossbow'
		|| GetWitcherPlayer().GetInventory().ItemHasTag( itemId, 'crossbow' )
		)
		{
			GetWitcherPlayer().EquipItem(itemId, EES_RangedWeapon);
			GetWitcherPlayer().SelectQuickslotItem( EES_RangedWeapon );
		}
		else if (GetWitcherPlayer().GetInventory().GetItemCategory(itemId) == 'petard'
		|| GetWitcherPlayer().GetInventory().ItemHasTag( itemId, 'petard' )
		)
		{
			switch ( GetWitcherPlayer().GetItemSlot(GetWitcherPlayer().GetSelectedItemId()) )
			{
				case EES_Petard1: 
				GetWitcherPlayer().EquipItem(itemId, EES_Petard1);
				GetWitcherPlayer().SelectQuickslotItem( EES_Petard1 );
				break;

				case EES_Petard2:
				GetWitcherPlayer().EquipItem(itemId, EES_Petard2);
				GetWitcherPlayer().SelectQuickslotItem( EES_Petard2 );
				break;

				default:
				if (!GetWitcherPlayer().IsAnyItemEquippedOnSlot(EES_Petard1))
				{
					GetWitcherPlayer().EquipItem(itemId, EES_Petard1);
					GetWitcherPlayer().SelectQuickslotItem( EES_Petard1 );
				}
				else
				{
					if (!GetWitcherPlayer().IsAnyItemEquippedOnSlot(EES_Petard2))
					{
						GetWitcherPlayer().EquipItem(itemId, EES_Petard2);
						GetWitcherPlayer().SelectQuickslotItem( EES_Petard2 );
					}
					else
					{
						GetWitcherPlayer().EquipItem(itemId, EES_Petard1);
						GetWitcherPlayer().SelectQuickslotItem( EES_Petard1 );
					}
				}
				break;
			}
		}
		else
		{
			if( GetWitcherPlayer().GetInventory().GetItemCategory(itemId) == 'armor' )
			{
				GetWitcherPlayer().UnequipItemFromSlot(EES_Armor);
			}

			if( GetWitcherPlayer().GetInventory().GetItemCategory(itemId) == 'gloves' )
			{
				GetWitcherPlayer().UnequipItemFromSlot(EES_Gloves);
			}

			if( GetWitcherPlayer().GetInventory().GetItemCategory(itemId) == 'pants' )
			{
				GetWitcherPlayer().UnequipItemFromSlot(EES_Pants);
			}

			if( GetWitcherPlayer().GetInventory().GetItemCategory(itemId) == 'boots' )
			{
				GetWitcherPlayer().UnequipItemFromSlot(EES_Boots);
			}

			if( GetWitcherPlayer().GetInventory().GetItemCategory(itemId) == 'steelsword' )
			{
				GetWitcherPlayer().UnequipItemFromSlot(EES_SteelSword);
			}

			if( GetWitcherPlayer().GetInventory().GetItemCategory(itemId) == 'silversword' )
			{
				GetWitcherPlayer().UnequipItemFromSlot(EES_SilverSword);
			}

			if (!GetWitcherPlayer().GetInventory().ItemHasTag( itemId, 'ACS_Unequip_Dummy' )
			)
			{
				GetWitcherPlayer().EquipItem(itemId);
			}
		}

		FactsRemove("ACS_Quickslot_Selection_Opened");

		thePlayer.inv.ManageItemsTag( thePlayer.inv.GetItemsByTag('ACS_Unequip_Dummy'), 'NoShow', true );	

		ClosePopup();

		return true;
	}
	else
	{
		wrappedMethod(itemId);
	}
}

@wrapMethod(CR4ItemSelectionPopup) function OnClosingPopup()
{
	if ( FactsQuerySum("ACS_Quickslot_Selection_Opened") > 0 )
	{
		FactsRemove("ACS_Quickslot_Selection_Opened");
	}

	wrappedMethod();

	return true;
}

@wrapMethod(CR4HudModuleJournalUpdate) function DisplayPending()
{
	var title : string;
	var offset : int;
	var isTrackableQuest : bool;
	var isCutscene : bool;
	var itemId : SItemUniqueId;
	var lootPopup : CR4LootPopup;
	var flashModule : CScriptedFlashSprite;
	var journalScale : float;

	if (false)
	{
		wrappedMethod();
	}
	
	if ( theGame.IsBlackscreen() || theGame.IsFading() )
	{
		return;
	}

	flashModule = GetModuleFlash();

	_bDuringDisplay = true;
	isCutscene = theInput.GetContext() == 'Scene';

	if (ACS_Is_DLC_Installed('dlcvhud'))
	{
		offset = 1;
		if(	journalUpdates[0].iconPath != "" )
		{
			offset += 4;
		}
		
		m_fxSetJournalUpdateStatusSFF.InvokeSelfOneArg(FlashArgInt(journalUpdates[0].status + offset));

		journalScale = ACS_Settings_Main_Float('acs_hud_settings_positioning_all','ACS_JournalScale', 55) + 45;

		if (journalScale > 100)
		{
			journalScale = 100;
		}
	}
	else
	{
		journalScale = ACS_Settings_Main_Float('acs_hud_settings_positioning_all','ACS_JournalScale', 55);
	}
	
	lootPopup = (CR4LootPopup)theGame.GetGuiManager().GetPopup('LootPopup');
	itemId = journalUpdates[0].itemId;
	if (thePlayer.inv.IsIdValid(itemId) && !isCutscene )
	{
		if (lootPopup)
		{
			
			_bDuringDisplay = false;
			return;
		}
		ShowElement(true);
		ShowItemInfo(itemId);
		journalUpdates.Erase(0);

		flashModule.SetXScale( journalScale  );
		flashModule.SetYScale( journalScale  );
		flashModule.SetZScale( journalScale  );
		return;
	}
	
	if( (CJournalQuest)journalUpdates[0].journalEntry )
	{
		if( !CheckSceneAndCutsceneDisplay(journalUpdates[0].status,journalUpdates[0].isQuestUpdate) )
		{
			if( journalUpdates.Size() > 0 )
			{
				journalUpdates.Erase(0);
			}
			_bDuringDisplay = false;
			return;
		}
	}
	
	title =  journalUpdates[0].title;
	offset = 1;
	if(	journalUpdates[0].iconPath != "" )
	{
		offset += 4;
	}
	
	m_fxSetJournalUpdateStatusSFF.InvokeSelfOneArg(FlashArgInt(journalUpdates[0].status + offset));
	
	isTrackableQuest = IsTrackableQuest();
	if( journalUpdates[0].displayTime == 0 )
	{
		if (isTrackableQuest)
		{
			journalUpdates[0].displayTime = defaultTrackableDisplayTime;
		}
		else
		{
			journalUpdates[0].displayTime = defaultDisplayTime;
		}
	}
	
	if (ACS_Is_DLC_Installed('dlcvhud'))
	{
		ACS_VladShowJournalUpdate(m_fxShowJournalUpdateSFF, isTrackableQuest, journalUpdates);
	}
	else
	{
		m_fxShowJournalUpdateSFF.InvokeSelfThreeArgs( FlashArgString(journalUpdates[0].text), FlashArgString(title), FlashArgNumber(journalUpdates[0].displayTime) );
	}

	m_fxSetIconSFF.InvokeSelfOneArg(FlashArgString(journalUpdates[0].iconPath));
	ShowElement(true);
	flashModule.SetXScale( journalScale  );
	flashModule.SetYScale( journalScale  );
	flashModule.SetZScale( journalScale  );
	
	if ( journalUpdates[0].soundEvent == "" )
		journalUpdates[0].soundEvent = "gui_ingame_quest_active";
	
	if( journalUpdates[0].soundEvent != "" && bWasRemoved )
	{
		if( !( theGame.IsBlackscreen() || theGame.IsFading() ) )
		{
			OnPlaySoundEvent( journalUpdates[0].soundEvent );
		}
	}
	
	m_defaultInputBindings.Clear();

	if( ( theInput.GetContext() != 'Scene' ) && ( journalUpdates[0].journalEntry || IsNameValid( journalUpdates[0].entryTag ) && !thePlayer.IsCiri() ) )
	{			
		if( isTrackableQuest )
		{			
			RegisterKeyBindings("panel_button_journal_track");
			
			if( ShouldProcessTutorial( 'TutorialNotTrackedQuestUpdate' ) )
			{
				FactsAdd( 'tut_not_tracked_quest_updates' );
			}
		}
		SetButtons( ( (CJournalQuest)journalUpdates[0].journalEntry ) );
	}

	UpdateInputFeedback();
	bWasRemoved = false;
}	

@wrapMethod( CR4Game ) function OnGameStarted(restored : bool )
{
	wrappedMethod(restored);

	thePlayer.ACS_CheckDayNightCycle();
}

@wrapMethod( CR4Game ) function OnHandleWorldChange()
{
	wrappedMethod();

	thePlayer.ACS_CheckDayNightCycle();
}

@wrapMethod( CR4Game ) function OnGameEnded()
{
	thePlayer.ACS_DeactivateDarknessGlobal();

	wrappedMethod();
}

@wrapMethod( W3EnvironmentManager ) function IsNight() : bool
{
	var hours : int ;
	var mins, totalMins : int;

	if (false)
	{
		wrappedMethod();
	}

	hours = GameTimeHours(theGame.GetGameTime());

	mins = GameTimeMinutes(theGame.GetGameTime());
	totalMins = hours * 60 + mins;
	
	if(totalMins >= nightStart || totalMins < dayStart)
	{
		return true;
	}

	return false;
}

@wrapMethod( W3EnvironmentManager ) function GetGameTimeTillNextDay() : GameTime
{
	if (false)
	{
		wrappedMethod();
	}

	return GetGameTimeTillNextHour(180);
}


@addMethod( W3EnvironmentManager ) function ACS_IsAlmostNight(diff : int) : bool
{
	var hours: int ;
	var almostNight: int;
	var mins, totalMins : int;

	almostNight = nightStart - diff;

	hours = GameTimeHours(theGame.GetGameTime());

	mins = GameTimeMinutes(theGame.GetGameTime());

	totalMins = hours * 60 + mins;

	if(totalMins >= almostNight && totalMins < nightStart)
	{
		return true;
	}

	return false;
}

@addMethod( W3EnvironmentManager ) function ACS_GetTimeInMinutes() : int
{
	var currentGameTime : GameTime;
	var hoursAndMins : int;
	
	currentGameTime = theGame.GetGameTime();
	hoursAndMins = GameTimeHours(currentGameTime)*60;
	hoursAndMins += GameTimeMinutes(currentGameTime);
	return hoursAndMins;

}

@addMethod( W3EnvironmentManager ) function ACS_GetMinutesForTime(gt : GameTime) : int
{
	var currentGameTime : GameTime;
	var hoursAndMins : int;
	
	currentGameTime = gt;

	hoursAndMins = GameTimeHours(currentGameTime)*60;

	hoursAndMins += GameTimeMinutes(currentGameTime);

	return hoursAndMins;
}

@addMethod( W3EnvironmentManager ) function ACS_SetDayStartAt(ds : int)
{
	dayStart = ds;
}

@addMethod( W3EnvironmentManager ) function ACS_GetDayStart() : int
{
	return dayStart;
}

@addMethod( W3EnvironmentManager ) function ACS_SetNightStart(ns : int)
{
	nightStart = ns;
}

@addMethod( W3EnvironmentManager ) function ACS_GetNightStart() : int
{
	return nightStart;
}

@addMethod( W3EnvironmentManager ) function ACS_IsStartingDay(diff : int) : bool
{
	var hours: int ;
	var startingDay: int;
	var mins, totalMins : int;

	startingDay = dayStart + diff;

	hours = GameTimeHours(theGame.GetGameTime());

	mins = GameTimeMinutes(theGame.GetGameTime());

	totalMins = hours * 60 + mins;

	if(totalMins >= dayStart && totalMins < startingDay)
	{
		return true;
	}

	return false;
}

@wrapMethod(CR4IngameMenu) function OnNavigatedBack() // SAVE SETTINGS ON EXIT MENU
{
	wrappedMethod();

	thePlayer.ACS_DarknessUpdateValues();
}


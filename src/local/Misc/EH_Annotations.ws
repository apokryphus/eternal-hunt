/////////////////////////////////////////////////////////////////////////////////////////////////////////////////

@addMethod( CNewNPC ) timer function ACS_Summoned_Construct_Run( dt : float, id : int )
{
	var actors, actors2, actorsCultists															: array<CActor>;
	var i, j																					: int;
	var actor, actor2																			: CActor;
	var npc, npc_1																				: CNewNPC;
	var movementAdjustor, movementAdjustorNPC, movementAdjustorBigWraith						: CMovementAdjustor;
	var ticket, ticketNPC, ticket_1																: SMovementAdjustmentRequestTicket;
	var animatedComponentA, animcomp															: CAnimatedComponent;
	var targetDistance, targetDistance_1														: float;
	var dmg																						: W3DamageAction;
	var anim_names																				: array< name >;
	var l_aiTree																				: CAIExecuteAttackAction;

	if(
	this.HasTag('ACS_Summoned_Construct_1')
	|| this.HasTag('ACS_Summoned_Construct_2')
	)
	{
		if ( theGame.IsDialogOrCutscenePlaying() 
		|| thePlayer.IsInCutsceneIntro() 
		|| theGame.IsCurrentlyPlayingNonGameplayScene() 
		)
		{
			thePlayer.RemoveTag('ACS_Player_Has_Summoned_Constructs');
			
			this.Destroy();
		}
		else
		{
			targetDistance = VecDistanceSquared2D( this.GetWorldPosition(), GetWitcherPlayer().GetWorldPosition() );

			movementAdjustorNPC = this.GetMovingAgentComponent().GetMovementAdjustor();

			thePlayer.SetAttitude(this, AIA_Friendly);

			this.SetTemporaryAttitudeGroup( 'friendly_to_player', AGP_Default );	

			ticketNPC = movementAdjustorNPC.GetRequest( 'ACS_Summoned_Construct_Rotate');
			movementAdjustorNPC.CancelByName( 'ACS_Summoned_Construct_Rotate' );

			ticketNPC = movementAdjustorNPC.CreateNewRequest( 'ACS_Summoned_Construct_Rotate' );
			movementAdjustorNPC.AdjustmentDuration( ticketNPC, 0.25 );
			movementAdjustorNPC.MaxRotationAdjustmentSpeed( ticketNPC, 500000 );

			if (!thePlayer.IsInCombat())
			{
				if (targetDistance <= 2 * 2)
				{
					this.GetMovingAgentComponent().SetGameplayRelativeMoveSpeed(0);
				}
				else if (targetDistance > 2 * 2 && targetDistance <= 15 * 15)
				{
					movementAdjustorNPC.RotateTowards( ticketNPC, GetWitcherPlayer() );

					this.GetMovingAgentComponent().SetGameplayRelativeMoveSpeed(2);
				}
				else if (targetDistance > 15 * 15 && GetWitcherPlayer().IsOnGround())
				{
					if (!this.IsEffectActive('shadowdash_body_blood', false))
					{
						this.PlayEffectSingle('shadowdash_body_blood');
					}
					
					this.PlayEffectSingle('shadowdash');
					this.StopEffect('shadowdash');

					this.TeleportWithRotation(TraceFloor(theCamera.GetCameraPosition() + theCamera.GetCameraRight() * -2 + VecFromHeading(theCamera.GetCameraHeading()) * 2), GetWitcherPlayer().GetWorldRotation());
				} 
			}
			
			actors.Clear();

			actors = thePlayer.GetNPCsAndPlayersInRange( 25, 20, , FLAG_OnlyAliveActors + FLAG_Attitude_Hostile + FLAG_ExcludePlayer);

			if( actors.Size() > 0 )
			{
				this.GetMovingAgentComponent().SetGameplayRelativeMoveSpeed(0);

				if (!this.IsEffectActive('claws_trail', false))
				{
					this.PlayEffectSingle('claws_trail');
				}

				for( i = 0; i < actors.Size(); i += 1 )
				{
					npc = (CNewNPC)actors[i];

					actor = actors[i];
					
					if (GetAttitudeBetween( thePlayer, npc ) != AIA_Friendly
					)
					{
						this.SetAttitude(npc, AIA_Hostile);
					}
				}
			}
		}
		
	}
}

@addMethod( CNewNPC ) timer function ACS_NPC_Idle_Action( dt : float, id : int )
{
	var actors, actors2, actorsCultists															: array<CActor>;
	var i, j																					: int;
	var actor, actor2																			: CActor;
	var npc, npc_1																				: CNewNPC;
	var movementAdjustor, movementAdjustorNPC, movementAdjustorBigWraith						: CMovementAdjustor;
	var ticket, ticketNPC, ticket_1																: SMovementAdjustmentRequestTicket;
	var animatedComponentA, animcomp															: CAnimatedComponent;
	var targetDistance, targetDistance_1														: float;
	var dmg																						: W3DamageAction;
	var anim_names																				: array< name >;
	var l_aiTree																				: CAIExecuteAttackAction;

	if (!this.HasTag('ACS_Custom_Monster'))
	{
		RemoveTimer('ACS_NPC_Idle_Action');
	}

	if(
	this.HasTag('ACS_Svalblod')
	)
	{
		actors2.Clear();

		actors2 = this.GetNPCsAndPlayersInRange( 10, 5, , FLAG_OnlyAliveActors );
		
		if( actors2.Size() > 0 )
		{
			for( j = 0; j < actors2.Size(); j += 1 )
			{
				npc = (CNewNPC)actors2[j];

				actor = actors2[j];

				if (npc.HasTag('ACS_Svalblod_Bossbar'))
				{
					if (
					GetAttitudeBetween( this, npc ) != AIA_Friendly
					)
					{
						this.SetAttitude(npc, AIA_Friendly);
					}
				}
				else
				{
					if (
					GetAttitudeBetween( this, npc ) != AIA_Hostile
					)
					{
						this.SetAttitude(npc, AIA_Hostile);
					}
				}
			}
		}
	}
	
	if(
	this.HasTag('ACS_Svalblod_Bear')
	)
	{
		if (
		GetAttitudeBetween( this, thePlayer ) != AIA_Hostile
		)
		{
			this.SetAttitude(thePlayer, AIA_Hostile);
		}

		actors2.Clear();

		actors2 = this.GetNPCsAndPlayersInRange( 10, 5, , FLAG_OnlyAliveActors );
		
		if( actors2.Size() > 0 )
		{
			for( j = 0; j < actors2.Size(); j += 1 )
			{
				npc = (CNewNPC)actors2[j];

				actor = actors2[j];

				if (npc.HasTag('ACS_Svalblod_Bossbar'))
				{
					if (
					GetAttitudeBetween( this, npc ) != AIA_Friendly
					)
					{
						this.SetAttitude(npc, AIA_Friendly);
					}
				}
				else
				{
					if (
					GetAttitudeBetween( this, npc ) != AIA_Hostile
					)
					{
						this.SetAttitude(npc, AIA_Hostile);
					}
				}
			}
		}
	}

	if(
	this.HasTag('ACS_Cultist_Boss')
	)
	{
		if (
		GetAttitudeBetween( this, thePlayer ) != AIA_Hostile
		)
		{
			this.SetAttitude(thePlayer, AIA_Hostile);
		}

		actors2.Clear();

		actors2 = this.GetNPCsAndPlayersInRange( 10, 5, , FLAG_OnlyAliveActors );
		
		if( actors2.Size() > 0 )
		{
			for( j = 0; j < actors2.Size(); j += 1 )
			{
				npc = (CNewNPC)actors2[j];

				actor = actors2[j];

				if (npc.HasTag('ACS_Cultist_Singer')
				|| npc.HasTag('ACS_Cultist')
				|| npc.HasTag('ACS_Cultist_Boss')
				|| npc.HasTag('ACS_Siren')
				|| npc.HasTag('ACS_Siren_Miniboss')
				|| npc.IsAnimal()
				)
				{
					if (
					GetAttitudeBetween( this, npc ) != AIA_Friendly
					)
					{
						this.SetAttitude(npc, AIA_Friendly);
					}
				}
				else
				{
					if (
					GetAttitudeBetween( this, npc ) != AIA_Hostile
					)
					{
						this.SetAttitude(npc, AIA_Hostile);
					}
				}
			}
		}
	}

	if(
	this.HasTag('ACS_Cultist_Singer')
	)
	{
		if (
		GetAttitudeBetween( this, thePlayer ) != AIA_Hostile
		)
		{
			this.SetAttitude(thePlayer, AIA_Hostile);
		}

		if (ACS_cultist_singer_can_sing())
		{
			ACS_refresh_cultist_singer_song_cooldown();

			if (this.IsAlive())
			{
				animcomp = (CAnimatedComponent)this.GetComponentByClassName('CAnimatedComponent');

				anim_names.Clear();

				anim_names.PushBack('woman_work_stand_praying_loop_01');
				anim_names.PushBack('woman_work_stand_praying_loop_02');
				anim_names.PushBack('woman_work_stand_praying_loop_03');

				animcomp.PlaySlotAnimationAsync ( anim_names[RandRange(anim_names.Size())], 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));

				theSound.SoundEvent("qu_sk_210_siren_singing");

				theSound.SoundEvent("qu_sk_210_siren_singing_alt");

				actorsCultists.Clear();

				actorsCultists = this.GetNPCsAndPlayersInRange( 15, 15, , FLAG_ExcludePlayer );

				if( actorsCultists.Size() > 0 )
				{
					for( j = 0; j < actorsCultists.Size(); j += 1 )
					{
						if (actorsCultists[j].HasTag('ACS_Cultist')
						|| actorsCultists[j].HasTag('ACS_Cultist_Boss')
						)
						{
							actorsCultists[j].GainStat(BCS_Essence, actorsCultists[j].GetStatMax(BCS_Essence) * 0.05 );

							actorsCultists[j].GainStat( BCS_Morale, actorsCultists[j].GetStatMax( BCS_Morale ) );  

							actorsCultists[j].GainStat( BCS_Focus, actorsCultists[j].GetStatMax( BCS_Focus ) );  
								
							actorsCultists[j].GainStat( BCS_Stamina, actorsCultists[j].GetStatMax( BCS_Stamina ) );
						}
					}
				}
			}
		}
	}

	if(
	this.HasTag('ACS_Pirate_Zombie')
	)
	{
		if (this.IsEffectActive('special_attack_fx'))
		{
			this.StopEffect('special_attack_fx');
		}

		if (this.IsEffectActive('special_attack_only_black_fx'))
		{
			this.StopEffect('special_attack_only_black_fx');
		}
	}

	if(
	this.HasTag('ACS_Melusine_Cloud')
	)
	{
		if (ACS_melusine_ability_switch())
		{
			ACS_refresh_melusine_ability_switch_cooldown();

			if (this.HasAbility('DjinnRage'))
			{
				this.AddAbility('DjinnWeak');

				this.RemoveAbility('DjinnRage');
			}
			else if (this.HasAbility('DjinnWeak'))
			{
				this.AddAbility('DjinnRage');

				this.RemoveAbility('DjinnWeak');
			}
		}

		if (ACS_melusine_cloud_can_attack())
		{
			ACS_refresh_melusine_cloud_attack_cooldown();

			if (this.HasAbility('DjinnRage'))
			{ 
				ACS_MelusineCloudTesla();
			}
			else if (this.HasAbility('DjinnWeak'))
			{
				l_aiTree = new CAIExecuteAttackAction in this;

				l_aiTree.OnCreated();

				l_aiTree.attackParameter = EAT_Attack1;
				
				this.ForceAIBehavior( l_aiTree, BTAP_AboveCombat2);
			}
		}
	}

	if(
	this.HasTag('ACS_MegaWraith')
	)
	{
		if (this.IsEffectActive('appear', false))
		{
			if (!this.IsEffectActive('demonic_possession', false))
			{
				this.PlayEffectSingle('demonic_possession');
			}

			if (!this.IsEffectActive('critical_burning_green_ex', false))
			{
				this.PlayEffectSingle('critical_burning_green_ex');
			}

			if (!this.IsEffectActive('critical_burning_green_ex_r', false))
			{
				this.PlayEffectSingle('critical_burning_green_ex_r');
			}

			if (!this.IsEffectActive('candle', false))
			{
				this.PlayEffectSingle('candle');
			}

			if (!ACSGetCEntity('ACS_MegaWraith_R_Weapon').IsEffectActive('runeword1_fire_trail_green', false))
			{
				ACSGetCEntity('ACS_MegaWraith_R_Weapon').PlayEffectSingle('runeword1_fire_trail_green');
			}

			if (!ACSGetCEntity('ACS_MegaWraith_R_Weapon').IsEffectActive('runeword_quen', false))
			{
				ACSGetCEntity('ACS_MegaWraith_R_Weapon').PlayEffectSingle('runeword_quen');
			}

			if (!ACSGetCEntity('ACS_MegaWraith_L_Weapon').IsEffectActive('runeword1_fire_trail_green', false))
			{
				ACSGetCEntity('ACS_MegaWraith_L_Weapon').PlayEffectSingle('runeword1_fire_trail_green');
			}

			if (!ACSGetCEntity('ACS_MegaWraith_L_Weapon').IsEffectActive('runeword_quen', false))
			{
				ACSGetCEntity('ACS_MegaWraith_L_Weapon').PlayEffectSingle('runeword_quen');
			}

			ACSGetCEntity('ACS_MegaWraith_L_Weapon').CreateAttachment(this, 'attach_slot_l', Vector(0.1,-0.025,0), EulerAngles(180,0,0));

			ACSGetCEntity('ACS_MegaWraith_R_Weapon').CreateAttachment(this, 'attach_slot_r', Vector(0.1,0.025,0), EulerAngles(0,0,0));
		}

		else if (!this.IsEffectActive('disappear', false))
		{
			if (!this.IsEffectActive('demonic_possession', false))
			{
				this.PlayEffectSingle('demonic_possession');
			}

			if (!this.IsEffectActive('critical_burning_green_ex', false))
			{
				this.PlayEffectSingle('critical_burning_green_ex');
			}

			if (!this.IsEffectActive('critical_burning_green_ex_r', false))
			{
				this.PlayEffectSingle('critical_burning_green_ex_r');
			}

			if (!this.IsEffectActive('candle', false))
			{
				this.PlayEffectSingle('candle');
			}

			if (!ACSGetCEntity('ACS_MegaWraith_R_Weapon').IsEffectActive('runeword1_fire_trail_green', false))
			{
				ACSGetCEntity('ACS_MegaWraith_R_Weapon').PlayEffectSingle('runeword1_fire_trail_green');
			}

			if (!ACSGetCEntity('ACS_MegaWraith_R_Weapon').IsEffectActive('runeword_quen', false))
			{
				ACSGetCEntity('ACS_MegaWraith_R_Weapon').PlayEffectSingle('runeword_quen');
			}

			if (!ACSGetCEntity('ACS_MegaWraith_L_Weapon').IsEffectActive('runeword1_fire_trail_green', false))
			{
				ACSGetCEntity('ACS_MegaWraith_L_Weapon').PlayEffectSingle('runeword1_fire_trail_green');
			}

			if (!ACSGetCEntity('ACS_MegaWraith_L_Weapon').IsEffectActive('runeword_quen', false))
			{
				ACSGetCEntity('ACS_MegaWraith_L_Weapon').PlayEffectSingle('runeword_quen');
			}

			ACSGetCEntity('ACS_MegaWraith_L_Weapon').CreateAttachment(this, 'attach_slot_l', Vector(0.1,-0.025,0), EulerAngles(180,0,0));

			ACSGetCEntity('ACS_MegaWraith_R_Weapon').CreateAttachment(this, 'attach_slot_r', Vector(0.1,0.025,0), EulerAngles(0,0,0));
		}
		else
		{
			this.DestroyEffect('demonic_possession');

			this.DestroyEffect('critical_burning_green_ex');

			this.DestroyEffect('critical_burning_green_ex_r');

			this.DestroyEffect('candle');

			

			ACSGetCEntity('ACS_MegaWraith_L_Weapon').DestroyEffect('igni_power_green');

			ACSGetCEntity('ACS_MegaWraith_L_Weapon').DestroyEffect('quen_power');

			ACSGetCEntity('ACS_MegaWraith_L_Weapon').DestroyEffect('runeword1_fire_trail_green');

			ACSGetCEntity('ACS_MegaWraith_L_Weapon').DestroyEffect('runeword_quen');

			ACSGetCEntity('ACS_MegaWraith_L_Weapon').DestroyEffect('runeword_igni_green');

			ACSGetCEntity('ACS_MegaWraith_L_Weapon').DestroyEffect('light_trail_extended_fx');

			ACSGetCEntity('ACS_MegaWraith_L_Weapon').DestroyEffect('wraith_trail');

			ACSGetCEntity('ACS_MegaWraith_L_Weapon').DestroyEffect('special_trail_fx');



			ACSGetCEntity('ACS_MegaWraith_R_Weapon').DestroyEffect('igni_power_green');

			ACSGetCEntity('ACS_MegaWraith_R_Weapon').DestroyEffect('quen_power');

			ACSGetCEntity('ACS_MegaWraith_R_Weapon').DestroyEffect('runeword1_fire_trail_green');

			ACSGetCEntity('ACS_MegaWraith_R_Weapon').DestroyEffect('runeword_quen');

			ACSGetCEntity('ACS_MegaWraith_R_Weapon').DestroyEffect('runeword_igni_green');

			ACSGetCEntity('ACS_MegaWraith_R_Weapon').DestroyEffect('light_trail_extended_fx');

			ACSGetCEntity('ACS_MegaWraith_R_Weapon').DestroyEffect('wraith_trail');

			ACSGetCEntity('ACS_MegaWraith_R_Weapon').DestroyEffect('special_trail_fx');




			ACSGetCEntity('ACS_MegaWraith_L_Weapon').BreakAttachment();

			ACSGetCEntity('ACS_MegaWraith_L_Weapon').Teleport(this.GetWorldPosition() + Vector(0,0,-200));

			ACSGetCEntity('ACS_MegaWraith_R_Weapon').BreakAttachment();

			ACSGetCEntity('ACS_MegaWraith_R_Weapon').Teleport(this.GetWorldPosition() + Vector(0,0,-200));
		}

		if ( ((CActor)(this.GetTarget())) )
		{
			targetDistance = VecDistanceSquared2D( ((CActor)(this.GetTarget())).GetWorldPosition(), this.GetWorldPosition() ) ;

			movementAdjustorBigWraith = this.GetMovingAgentComponent().GetMovementAdjustor();

			ticket_1 = movementAdjustorBigWraith.GetRequest( 'ACS_MegaWraith_Rotate');
			movementAdjustorBigWraith.CancelByName( 'ACS_MegaWraith_Rotate' );
			movementAdjustorBigWraith.CancelAll();

			ticket_1 = movementAdjustorBigWraith.CreateNewRequest( 'ACS_MegaWraith_Rotate' );
			movementAdjustorBigWraith.AdjustmentDuration( ticket_1, 1 );

			movementAdjustorBigWraith.MaxRotationAdjustmentSpeed( ticket_1, 50000000 );

			if (targetDistance <= 4*4)
			{
				movementAdjustorBigWraith.RotateTowards(ticket_1, ((CActor)(this.GetTarget())));
			}
			else
			{
				movementAdjustorBigWraith.CancelByName( 'ACS_MegaWraith_Rotate' );
			}
		}

		if (
		GetAttitudeBetween( this, thePlayer ) != AIA_Hostile
		)
		{
			this.SetAttitude(thePlayer, AIA_Hostile);
		}

		actors2.Clear();

		actors2 = this.GetNPCsAndPlayersInRange( 10, 5, , FLAG_OnlyAliveActors );
		
		if( actors2.Size() > 0 )
		{
			for( j = 0; j < actors2.Size(); j += 1 )
			{
				npc_1 = (CNewNPC)actors2[j];

				actor2 = actors2[j];

				if (npc_1.IsAnimal()
				|| npc_1.HasTag('ACS_MegaWraith_Minion')
				)
				{
					if (
					GetAttitudeBetween( this, npc ) != AIA_Friendly
					)
					{
						this.SetAttitude(npc, AIA_Friendly);
					}
				}
				else
				{
					if (
					GetAttitudeBetween( this, npc ) != AIA_Hostile
					)
					{
						this.SetAttitude(npc, AIA_Hostile);
					}
				}
			}
		}
	}

	if(
	this.HasTag('ACS_Necrofiend')
	)
	{
		if (this.IsAlive())
		{
			this.StopEffect('spike');
			this.PlayEffect('spike');

			this.StopEffect('spikes_explode_after');
			this.PlayEffect('spikes_explode_after');
		}

		if (
		GetAttitudeBetween( this, thePlayer ) != AIA_Hostile
		)
		{
			this.SetAttitude(thePlayer, AIA_Hostile);
		}

		actors2.Clear();

		actors2 = this.GetNPCsAndPlayersInRange( 10, 5, , FLAG_OnlyAliveActors );
		
		if( actors2.Size() > 0 )
		{
			for( j = 0; j < actors2.Size(); j += 1 )
			{
				npc = (CNewNPC)actors2[j];

				actor = actors2[j];

				if (npc.HasTag('ACS_Necrofiend')
				|| npc.HasTag('ACS_Necrofiend_Tentacle_6')
				|| npc.HasTag('ACS_Necrofiend_Tentacle_5')
				|| npc.HasTag('ACS_Necrofiend_Tentacle_4')
				|| npc.HasTag('ACS_Necrofiend_Tentacle_3')
				|| npc.HasTag('ACS_Necrofiend_Tentacle_2')
				|| npc.HasTag('ACS_Necrofiend_Tentacle_1')
				|| npc.HasTag('ACS_Necrofiend_Adds')
				)
				{
					if (
					GetAttitudeBetween( this, npc ) != AIA_Friendly
					)
					{
						this.SetAttitude(npc, AIA_Friendly);
					}
				}
				else
				{
					if (
					GetAttitudeBetween( this, npc ) != AIA_Hostile
					)
					{
						this.SetAttitude(npc, AIA_Hostile);
					}
				}
			}
		}
	}

	if(
	this.HasTag('ACS_Nekurat')
	)
	{
		((CNewNPC)this).SetAttitude(thePlayer, AIA_Hostile);

		actors2.Clear();

		actors2 = this.GetNPCsAndPlayersInRange( 10, 5, , FLAG_OnlyAliveActors );
		
		if( actors2.Size() > 0 )
		{
			for( j = 0; j < actors2.Size(); j += 1 )
			{
				npc = (CNewNPC)actors2[j];

				actor = actors2[j];

				if (npc.HasTag('ACS_Nekurat') 
				|| npc.HasTag('ACS_Blade_Of_The_Unseen')
				|| npc.HasAbility('mon_vampiress_base')
				)
				{
					if (
					GetAttitudeBetween( this, npc ) != AIA_Friendly
					)
					{
						this.SetAttitude(npc, AIA_Friendly);
					}
				}
				else
				{
					if (
					GetAttitudeBetween( this, npc ) != AIA_Hostile
					)
					{
						this.SetAttitude(npc, AIA_Hostile);
					}
				}
			}
		}
	}

	if(
	this.HasTag('ACS_Cloak_Vamp')
	)
	{
		targetDistance = VecDistanceSquared2D( this.GetWorldPosition(), GetWitcherPlayer().GetWorldPosition() );

		if (
			this.IsInCombat()
		)
		{
			if (!this.HasTag('ACS_Cloak_Vamp_In_Combat'))
			{
				this.AddTag('ACS_Cloak_Vamp_In_Combat');
			}
		}

		if (!this.HasTag('ACS_Cloak_Vamp_In_Combat'))
		{
			((CActor)this).GetMovingAgentComponent().SetGameplayMoveDirection(VecHeading(thePlayer.GetWorldPosition() - this.GetWorldPosition()));

			if (targetDistance <= 15 * 15)
			{
				((CActor)this).GetMovingAgentComponent().SetGameplayRelativeMoveSpeed(1);
			}
		}
	}

	if(
	this.HasTag('ACS_Lynx_Witcher')
	)
	{
		if (this.IsAlive())
		{
			targetDistance = VecDistanceSquared2D( ((CActor)this).GetWorldPosition(), GetWitcherPlayer().GetWorldPosition() );

			animatedComponentA = (CAnimatedComponent)(((CActor)this)).GetComponentByClassName( 'CAnimatedComponent' );	

			((CActor)this).SetAttitude(thePlayer, AIA_Hostile);

			if (!this.IsInCombat())
			{
				animatedComponentA.PlaySlotAnimationAsync ( 'meditation_idle01', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));
			}

			if (targetDistance <= 10 * 10 && GetWitcherPlayer().IsOnGround())
			{
				if (!this.HasTag('ACS_Lynx_Witcher_Combat'))
				{
					dmg = new W3DamageAction in theGame.damageMgr;
						
					dmg.Initialize(GetWitcherPlayer(), ((CActor)this), NULL, GetWitcherPlayer().GetName(), EHRT_None, CPS_Undefined, false, false, true, false);
					
					dmg.SetProcessBuffsIfNoDamage(true);

					dmg.SetCriticalHit(); theGame.damageMgr.ProcessAction( dmg );
						
					delete dmg;	

					animatedComponentA.PlaySlotAnimationAsync ( '', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));

					this.PlayEffectSingle('shadowdash');
					this.StopEffect('shadowdash');

					theSound.SoundEvent("bomb_dragons_dream_explo");

					ACS_LynxWitcherSmokeScreen(this, this.GetWorldPosition());

					this.AddTag('ACS_Lynx_Witcher_Combat');
				}
			}

			if (this.HasTag('ACS_Lynx_Witcher_Stealth'))
			{
				((CActor)this).SetTatgetableByPlayer(false);
			}
			else
			{
				((CActor)this).SetTatgetableByPlayer(true);
			}
		}
	}

	if (this.HasTag('ACS_Knightmare_Eternum'))
	{
		targetDistance = VecDistanceSquared2D( thePlayer.GetWorldPosition(), this.GetWorldPosition() );

		if ( targetDistance <= 10 * 10 )
		{
			if 
			(
				!this.HasAbility('EtherealActive') 
			)
			{
				theSound.SoundEvent("qu_209_two_sirens_sing_loop_stop");
				theSound.SoundEvent("magic_olgierd_ethereal_wake");

				this.PlayEffectSingle('demonic_possession');

				this.PlayEffectSingle('ethereal_buff');
				this.StopEffect('ethereal_buff');

				if (GetWeatherConditionName() != 'WT_Rain_Storm')
				{
					RequestWeatherChangeTo('WT_Rain_Storm', 1.0, false);
				}

				this.AddAbility('EtherealActive');
			}
		}
	}

	if(
	this.HasTag('ACS_Nekker_Guardian')
	)
	{
		if (
		GetAttitudeBetween( this, thePlayer ) != AIA_Hostile
		)
		{
			this.SetAttitude(thePlayer, AIA_Hostile);
		}

		if( targetDistance > 30 * 30 ) 
		{
			if (!this.IsInCombat())
			{
				this.Destroy();
			}
		}
	}
}


//////////////////////////////////////////////////////////////////////////////

@addField(CNewNPC)
public var acs_posture 											: float;

@addField(CNewNPC)
public var acs_max_posture 										: float;

@addField(CNewNPC)
public var acs_posture_anchor 									: CEntity;

@addMethod( CNewNPC ) timer function ACS_Calculate_Posture( dt : float, id : int )
{
	acs_posture = 0;

	acs_max_posture = RandRangeF(150,100);

	if (
	this.HasTag('ACS_Big_Boi')
	|| this.HasAbility('mon_toad_base')
	|| this.HasAbility('mon_type_huge')
	|| ((CMovingPhysicalAgentComponent)((this).GetMovingAgentComponent())).GetCapsuleHeight() >= 2
	|| this.GetRadius() >= 0.7
	)
	{
		acs_max_posture += RandRangeF(200, 150);
	}

	if (UsesEssence())
	{
		acs_max_posture += RandRangeF(100, 50);
	}

	AddTimer('ACS_Posture_Bar_Control', 0.01 , true);
}

@addMethod( CNewNPC ) timer function ACS_Posture_Bar_Control( dt : float, id : int )
{
	var iconPath, iconPath_background_bar, iconPath_max_indicator		: string;
	var boneIndex 														: int;
	var bPos															: Vector;
	var bRot 															: EulerAngles;

	if (this == thePlayer.GetDisplayTarget()
	&& this.IsAlive()
	&& GetAttitudeBetween( this, GetWitcherPlayer() ) == AIA_Hostile
	&& GetACSWatcher().HudSettingsCheck('EnemyFocusModule')
	&& acs_posture > 0
	)
	{
		if (!acs_posture_anchor)
		{
			ACSGetCEntityDestroyAll('ACS_Posture_Anchor');

			acs_posture_anchor = theGame.CreateEntity( (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent", true ), 
			GetWorldPosition(), 
			GetWorldRotation() );

			if ( GetBoneIndex('head') != -1 )
			{
				boneIndex = GetBoneIndex( 'head' );	
				GetBoneWorldPositionAndRotationByIndex( boneIndex, bPos, bRot );

				acs_posture_anchor.CreateAttachmentAtBoneWS(this, 'head', bPos, bRot);
			}
			else
			{
				if ( GetBoneIndex('k_head_g') != -1 )
				{
					boneIndex = GetBoneIndex( 'k_head_g' );	
					GetBoneWorldPositionAndRotationByIndex( boneIndex, bPos, bRot );

					acs_posture_anchor.CreateAttachmentAtBoneWS(this, 'k_head_g', bPos, bRot);
				}
				else
				{
					acs_posture_anchor.CreateAttachment(this, , Vector(0,0,2), thePlayer.GetWorldRotation());
				}
			}

			acs_posture_anchor.AddTag('ACS_Posture_Anchor');

			GetACSStorage().acs_deleteOnelinerByTag("ACS_Posture_Background_Bar_Indicator");

			iconPath_background_bar = "<img src='img://" + "icons/inventory/acs_background_bar.xbm" + "' vspace='" + (1) + "' />&nbsp;";

			ACS_Oneliner(iconPath_background_bar, acs_posture_anchor, "ACS_Posture_Background_Bar_Indicator", Vector(0,0,0.5)).run_indicator('enemy_posture_bar_background_indicator', this);


			GetACSStorage().acs_deleteOnelinerByTag("ACS_Posture_Bar_Max_Indicator");

			iconPath_max_indicator = "<img src='img://" + "icons/inventory/acs_rally_health_bar.xbm" + "' vspace='" + (1) + "' />&nbsp;";

			ACS_Oneliner(iconPath_max_indicator, acs_posture_anchor, "ACS_Posture_Bar_Max_Indicator", Vector(0,0,0.5)).run_indicator('enemy_posture_bar_max_indicator', this);


			GetACSStorage().acs_deleteOnelinerByTag("ACS_Posture_Bar_Indicator");

			iconPath = "<img src='img://" + "icons/inventory/acs_poise_bar.xbm" + "' vspace='" + (1) + "' />&nbsp;";

			ACS_Oneliner(iconPath, acs_posture_anchor, "ACS_Posture_Bar_Indicator", Vector(0,0,0.5)).run_indicator('enemy_posture_bar', this);

		}
	}
	else
	{
		if (acs_posture_anchor)
		{
			acs_posture_anchor.Destroy();
		}
	}
}

//////////////////////////////////////////////////////////////////////////////

@addField(CNewNPC)
public var acs_wound_fx 									: CEntity;

@addField(CNewNPC)
public var acs_posture_max_lock_out 						: bool;

@addMethod( CNewNPC ) function ACS_DealPostureDamage(increase_amount : float)
{
	var iconPath, iconPath_background_bar		: string;
	var boneIndex 								: int;
	var bPos									: Vector;
	var bRot 									: EulerAngles;
	var posture_reset_missing_health			: float;
	var posture_reset_delay						: float;
	var iconPathCounterWound					: string;

	if (thePlayer.HasTag('ACS_IsPerformingFinisher')
	|| thePlayer.HasTag('ACS_IsPerformingCombatDismember')
	|| thePlayer.HasTag('ACS_Bruxa_Bite_Process')
	|| thePlayer.HasTag('ACS_Ghost_Stance_Active')
	)
	{
		return;
	}

	RemoveTimer('ACS_ResetPostureRepeat');
	RemoveTimer('ACS_ResetPosture');

	posture_reset_delay = 3;

	posture_reset_missing_health = GetMaxHealth() / GetCurrentHealth();

	if (posture_reset_missing_health >= 5)
	{
		posture_reset_missing_health = 5;
	}

	posture_reset_delay += posture_reset_missing_health;

	if (ACS_IsInDimeritiumCloud()
	|| HasBuff(EET_HeavyKnockdown) 
	|| HasBuff( EET_Knockdown ) 
	|| HasBuff( EET_Ragdoll ) 
	|| HasBuff( EET_Stagger )
	|| HasBuff( EET_LongStagger )
	|| HasBuff( EET_Pull )
	|| HasBuff( EET_Hypnotized )
	|| HasBuff( EET_WitchHypnotized )
	|| HasBuff( EET_Blindness )
	|| HasBuff( EET_WraithBlindness )
	|| HasBuff( EET_Frozen )
	|| HasBuff( EET_Paralyzed )
	|| HasBuff( EET_Confusion )
	|| HasBuff( EET_Tangled )
	|| HasBuff( EET_Tornado ) 
	|| HasBuff( EET_Swarm ) 
	|| HasBuff( EET_Burning ) 
	|| HasBuff( EET_Poison ) 
	)
	{
		posture_reset_delay += 1;
	}

	if (ACS_Correct_Oil_Used(this)
	|| thePlayer.HasBuff(EET_EnhancedWeapon)
	|| thePlayer.GetInventory().ItemHasTag( thePlayer.GetInventory().GetCurrentlyHeldSword(), 'Aerondight' )
	|| thePlayer.GetInventory().ItemHasTag( thePlayer.GetInventory().GetCurrentlyHeldSword(), 'OlgierdSabre' )
	|| ACS_GetItem_Sword_IsEquipped('jingubang_steel', 'steel') 
	|| ACS_GetItem_Sword_IsEquipped('jingubang_silver', 'silver')
	|| ACS_Vampire_Claws_Access()
	)
	{
		posture_reset_delay += 1;
	}

	if (((CMovingPhysicalAgentComponent)(GetMovingAgentComponent())).GetCapsuleHeight() >= 2
	|| GetRadius() >= 0.7
	|| HasAbility('Boss')
	|| HasTag('IsBoss')
	|| HasTag('ACS_Big_Boi')
	)
	{
		posture_reset_delay * 0.5;
	}

	AddTimer('ACS_ResetPosture', posture_reset_delay, false);
	
	if (ACS_IsInDimeritiumCloud()
	|| HasBuff(EET_HeavyKnockdown) 
	|| HasBuff( EET_Knockdown ) 
	|| HasBuff( EET_Ragdoll ) 
	|| HasBuff( EET_Stagger )
	|| HasBuff( EET_LongStagger )
	|| HasBuff( EET_Pull )
	|| HasBuff( EET_Hypnotized )
	|| HasBuff( EET_WitchHypnotized )
	|| HasBuff( EET_Blindness )
	|| HasBuff( EET_WraithBlindness )
	|| HasBuff( EET_Frozen )
	|| HasBuff( EET_Paralyzed )
	|| HasBuff( EET_Confusion )
	|| HasBuff( EET_Tangled )
	|| HasBuff( EET_Tornado ) 
	|| HasBuff( EET_Swarm ) 
	|| HasBuff( EET_Burning ) 
	|| HasBuff( EET_Poison ) 
	)
	{
		increase_amount += 5;
	}

	if (ACS_Correct_Oil_Used(this)
	|| thePlayer.HasBuff(EET_EnhancedWeapon)
	|| thePlayer.GetInventory().ItemHasTag( thePlayer.GetInventory().GetCurrentlyHeldSword(), 'Aerondight' )
	|| thePlayer.GetInventory().ItemHasTag( thePlayer.GetInventory().GetCurrentlyHeldSword(), 'OlgierdSabre' )
	|| ACS_GetItem_Sword_IsEquipped('jingubang_steel', 'steel') 
	|| ACS_GetItem_Sword_IsEquipped('jingubang_silver', 'silver')
	|| ACS_Vampire_Claws_Access()
	)
	{
		increase_amount += 5;
	}

	if (((CMovingPhysicalAgentComponent)(GetMovingAgentComponent())).GetCapsuleHeight() >= 2
	|| GetRadius() >= 0.7
	|| HasAbility('Boss')
	|| HasTag('IsBoss')
	|| HasTag('ACS_Big_Boi')
	)
	{
		increase_amount -= increase_amount * 0.5;
	}

	if (!acs_posture_max_lock_out)
	{
		acs_posture += increase_amount;
	}

	ACS_Tutorial_Display_Check('ACS_Posture_Tutorial_Shown');

	if (!thePlayer.HasTag('ACS_Is_Sneaking')
	&& !GetACSWatcher().ACS_IS_SNEAKING)
	{
		if (acs_posture >= acs_max_posture)
		{
			acs_posture = acs_max_posture;

			if (!acs_posture_max_lock_out)
			{
				if ( thePlayer.IsAnyWeaponHeld()
				&& !thePlayer.IsWeaponHeld('fist')
				&& IsAlive()
				)
				{
					if (!acs_wound_fx
					&& !HasTag('dandelion')
					&& !thePlayer.IsInFistFightMiniGame()
					&& !StrContains( GetReadableName(), "dandelion" )
					)
					{
						AddTag('ACS_NPC_Ready_For_Mounted_Attack_Attachment');

						ACS_Tutorial_Display_Check('ACS_Counter_Wound_Tutorial_Shown');

						ACSGetCActorRemoveTag('ACS_Counter_Wound_Ready');

						ACSGetCEntityDestroyAll('ACS_Counter_Wound'); ACSGetCEntityDestroyAll('ACS_Sneaking_Lure');

						AddTag('ACS_Counter_Wound_Ready');

						RemoveTimer('ACS_Counter_Wound_Remove');
						AddTimer('ACS_Counter_Wound_Remove', posture_reset_delay , false );

						acs_wound_fx = theGame.CreateEntity( (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent", true ), 
						GetWorldPosition(), 
						GetWorldRotation() );

						if (!ACS_Settings_Main_Bool('acs_misc_main_settings','acs_hide_counter_wound_prompt', false))
						{
							acs_wound_fx.PlayEffectSingle('counter_wound_marker');
						}
						
						//wound_fx.CreateAttachment(npc,'blood_point', Vector(0,0,0), EulerAngles(0,0,0));

						if ( GetBoneIndex('pelvis') != -1 )
						{
							boneIndex = GetBoneIndex( 'pelvis' );	
							GetBoneWorldPositionAndRotationByIndex( boneIndex, bPos, bRot );

							acs_wound_fx.CreateAttachmentAtBoneWS(this, 'pelvis', bPos, bRot);
						}
						else
						{
							if ( GetBoneIndex('k_pelvis_g') != -1 )
							{
								boneIndex = GetBoneIndex( 'k_pelvis_g' );	
								GetBoneWorldPositionAndRotationByIndex( boneIndex, bPos, bRot );

								acs_wound_fx.CreateAttachmentAtBoneWS(this, 'k_pelvis_g', bPos, bRot);
							}
							else
							{
								acs_wound_fx.CreateAttachment(this, , Vector(0,0,1.5), thePlayer.GetWorldRotation());
							}
						}

						acs_wound_fx.AddTag('ACS_Counter_Wound');

						acs_wound_fx.DestroyAfter(posture_reset_delay);

						AddTimer('ACS_ResetPostureCounterWoundDelayReset', posture_reset_delay, false);
					}
				}
				else
				{
					if (acs_wound_fx)
					{
						acs_wound_fx.Destroy();
					}

					if (HasTag('ACS_NPC_Ready_For_Mounted_Attack_Attachment'))
					{
						RemoveTag('ACS_NPC_Ready_For_Mounted_Attack_Attachment');
					}

					if (HasTag('ACS_Counter_Wound_Ready'))
					{
						RemoveTag('ACS_Counter_Wound_Ready');
					}
				}

				acs_posture_max_lock_out = true;
			}	
		}
		else
		{
			if (acs_wound_fx)
			{
				acs_wound_fx.Destroy();
			}

			if (HasTag('ACS_NPC_Ready_For_Mounted_Attack_Attachment'))
			{
				RemoveTag('ACS_NPC_Ready_For_Mounted_Attack_Attachment');
			}

			if (HasTag('ACS_Counter_Wound_Ready'))
			{
				RemoveTag('ACS_Counter_Wound_Ready');
			}
		}
	}
	else
	{
		if (acs_posture >= acs_max_posture)
		{
			acs_posture = acs_max_posture;
		}
	}
	
	
}

@addMethod( CNewNPC ) timer function ACS_ResetPostureCounterWoundDelayReset( dt : float, id : int )
{
	var posture_mult : float;

	acs_posture_max_lock_out = false;

	if (!thePlayer.HasTag('ACS_Is_Sneaking')
	&& !GetACSWatcher().ACS_IS_SNEAKING)
	{
		acs_wound_fx.Destroy();

		if (HasTag('ACS_NPC_Ready_For_Mounted_Attack_Attachment'))
		{
			RemoveTag('ACS_NPC_Ready_For_Mounted_Attack_Attachment');
		}

		if (HasTag('ACS_Counter_Wound_Ready'))
		{
			RemoveTag('ACS_Counter_Wound_Ready');
		}
	}

	RemoveTimer('ACS_ResetPosture');
	RemoveTimer('ACS_ResetPostureRepeat');

	posture_mult = GetCurrentHealth() / GetMaxHealth();

	if((GetCurrentHealth() / GetMaxHealth()) <= 0.75)
	{
		posture_mult = 0.75;
	}

	acs_posture -= acs_posture * posture_mult;
}

@addMethod( CNewNPC ) function ACS_ResetPostureImmediate()
{
	acs_posture_max_lock_out = false;

	if (!thePlayer.HasTag('ACS_Is_Sneaking')
	&& !GetACSWatcher().ACS_IS_SNEAKING)
	{
		acs_wound_fx.Destroy();

		if (HasTag('ACS_NPC_Ready_For_Mounted_Attack_Attachment'))
		{
			RemoveTag('ACS_NPC_Ready_For_Mounted_Attack_Attachment');
		}

		if (HasTag('ACS_Counter_Wound_Ready'))
		{
			RemoveTag('ACS_Counter_Wound_Ready');
		}
	}

	RemoveTimer('ACS_ResetPostureCounterWoundDelayReset');
	RemoveTimer('ACS_ResetPosture');
	RemoveTimer('ACS_ResetPostureRepeat');

	acs_posture -= acs_posture;
}

@addMethod( CNewNPC ) timer function ACS_ResetPosture( dt : float, id : int )
{
	acs_posture_max_lock_out = false;

	if (!thePlayer.HasTag('ACS_Is_Sneaking')
	&& !GetACSWatcher().ACS_IS_SNEAKING)
	{
		acs_wound_fx.Destroy();

		if (HasTag('ACS_NPC_Ready_For_Mounted_Attack_Attachment'))
		{
			RemoveTag('ACS_NPC_Ready_For_Mounted_Attack_Attachment');
		}

		if (HasTag('ACS_Counter_Wound_Ready'))
		{
			RemoveTag('ACS_Counter_Wound_Ready');
		}
	}

	RemoveTimer('ACS_ResetPostureCounterWoundDelayReset');
	RemoveTimer('ACS_ResetPostureRepeat');
	AddTimer('ACS_ResetPostureRepeat', 0.000000000001, true);
}

@addMethod( CNewNPC ) timer function ACS_ResetPostureRepeat( dt : float, id : int )
{
	var posture_mult: float;

	if (acs_posture <= 0)
	{
		acs_posture_max_lock_out = false;

		acs_posture = 0;

		RemoveTimer('ACS_ResetPostureRepeat');
	}
	else
	{
		if (IsRagdolled()

		|| HasBuff(EET_Knockdown)

		|| HasBuff(EET_HeavyKnockdown)

		|| HasBuff(EET_Ragdoll)

		|| HasBuff(EET_Burning)

		|| HasBuff(EET_Frozen)

		|| HasBuff(EET_LongStagger)

		|| HasBuff(EET_Stagger)

		|| HasBuff(EET_Weaken)

		|| HasBuff(EET_Confusion)

		|| HasBuff(EET_AxiiGuardMe)

		|| HasBuff(EET_Hypnotized)

		|| HasBuff(EET_Immobilized)

		|| HasBuff(EET_Paralyzed)

		|| HasBuff(EET_Blindness)

		|| HasBuff(EET_Choking)

		|| HasBuff(EET_Swarm))
		{
			posture_mult = 0.01;
		}
		else
		{
			posture_mult = 0.1;
		}

		acs_posture -= ((GetCurrentHealth() / GetMaxHealth()) * posture_mult);
	}
}

//////////////////////////////////////////////////////////////////////////////

@addField(CR4Player)
public var acs_grey_health_current 											: float;

@addMethod( CR4Player ) function ACS_ManageGreyHealth(store : bool, stored_amount : float)
{
	var vACS_Blood_Spatter_Switch : cACS_Blood_Spatter_Switch;

	if (store)
	{
		acs_grey_health_current += stored_amount;

		RemoveTimer('ACS_ResetGreyHealthRepeat');
		RemoveTimer('ACS_ResetGreyHealth');
		AddTimer('ACS_ResetGreyHealth', 1, false);
	}
	else
	{
		acs_grey_health_current -= stored_amount;

		vACS_Blood_Spatter_Switch = new cACS_Blood_Spatter_Switch in theGame;
					
		vACS_Blood_Spatter_Switch.ACS_Blood_Spatter_Switch_Engage();
	}
}

@addMethod( CR4Player ) timer function ACS_ResetGreyHealth( dt : float, id : int )
{
	RemoveTimer('ACS_ResetGreyHealthRepeat');
	AddTimer('ACS_ResetGreyHealthRepeat', 0.000001, true);
}

@addMethod( CR4Player ) timer function ACS_ResetGreyHealthRepeat( dt : float, id : int )
{
	var grey_health_curr : float;

	grey_health_curr = thePlayer.GetStat(BCS_Vitality) + acs_grey_health_current;

	if (grey_health_curr > thePlayer.GetStatMax(BCS_Vitality) || grey_health_curr <= thePlayer.GetStat(BCS_Vitality))
	{
		acs_grey_health_current = 0;

		RemoveTimer('ACS_ResetGreyHealth');
		RemoveTimer('ACS_ResetGreyHealthRepeat');
	}
	else
	{
		acs_grey_health_current -= 1;
	}
}

//////////////////////////////////////////////////////////////////////////////

@addField(CR4Player)
public var acs_player_posture 											: float;

@addField(CR4Player)
public var acs_max_player_posture 										: float;


@addMethod( CR4Player ) function ACS_DealPlayerPostureDamage(increase_amount : float, posture_break : bool)
{
	var iconPath, iconPath_background_bar		: string;
	var wound_fx								: CEntity;
	var boneIndex 								: int;
	var bPos									: Vector;
	var bRot 									: EulerAngles;
	var posture_reset_delay						: float;
	var paramsKnockdown 						: SCustomEffectParams;
	var item									: SItemUniqueId;
	var light_hit_sound_names_secondary			: array<string>;


	RemoveTimer('ACS_ResetPlayerPostureRepeat');
	RemoveTimer('ACS_ResetPlayerPosture');

	posture_reset_delay = 5;

	if (HasBuff(EET_HeavyKnockdown) 
	|| HasBuff( EET_Knockdown ) 
	|| HasBuff( EET_Ragdoll ) 
	|| HasBuff( EET_Stagger )
	|| HasBuff( EET_LongStagger )
	|| HasBuff( EET_Pull )
	|| HasBuff( EET_Hypnotized )
	|| HasBuff( EET_WitchHypnotized )
	|| HasBuff( EET_Blindness )
	|| HasBuff( EET_WraithBlindness )
	|| HasBuff( EET_Frozen )
	|| HasBuff( EET_Paralyzed )
	|| HasBuff( EET_Confusion )
	|| HasBuff( EET_Tangled )
	|| HasBuff( EET_Tornado ) 
	|| HasBuff( EET_Swarm ) 
	|| HasBuff( EET_Burning ) 
	|| HasBuff( EET_Poison ) 
	)
	{
		posture_reset_delay += 1;
	}

	if 
	(
		GetWitcherPlayer().IsGuarded()
	)
	{
		posture_reset_delay -= 1;
	}

	AddTimer('ACS_ResetPlayerPosture', posture_reset_delay, false);

	if (acs_player_posture >= acs_max_player_posture)
	{
		if (posture_break)
		{
			GetACSWatcher().counterWindowExtendedForEssenceSet(false);

			GetACSWatcher().counterWindowExtendedForVitalitySet(false);

			GetACSWatcher().RemoveTimer('counterWindowExtendedCheckForEssenceTimer');

			GetACSWatcher().RemoveTimer('counterWindowExtendedCheckForVitalityTimer');

			thePlayer.PlayEffectSingle('posture_break');

			thePlayer.StopEffect('posture_break');

			GetWitcherPlayer().SoundEvent("shield_break_00_bb_acs");

			//GetWitcherPlayer().SoundEvent("wall_a1_bb_acs");

			light_hit_sound_names_secondary.PushBack("melee_sword_impact_generic_a_wf_acs");
			light_hit_sound_names_secondary.PushBack("melee_sword_impact_generic_b_wf_acs");
			light_hit_sound_names_secondary.PushBack("melee_sword_impact_generic_c_wf_acs");
			light_hit_sound_names_secondary.PushBack("melee_sword_impact_generic_d_wf_acs");
			light_hit_sound_names_secondary.PushBack("melee_sword_impact_generic_e_wf_acs");
			light_hit_sound_names_secondary.PushBack("melee_sword_impact_generic_f_wf_acs");
			light_hit_sound_names_secondary.PushBack("melee_sword_impact_generic_g_wf_acs");
			light_hit_sound_names_secondary.PushBack("melee_sword_impact_generic_h_wf_acs");
			light_hit_sound_names_secondary.PushBack("melee_sword_impact_generic_i_wf_acs");
			light_hit_sound_names_secondary.PushBack("melee_sword_impact_generic_j_wf_acs");

			theSound.SoundEvent(light_hit_sound_names_secondary[RandRange(light_hit_sound_names_secondary.Size())]);

			RemoveTimer('ACS_ResetPlayerPosture');
			RemoveTimer('ACS_ResetPlayerPostureRepeat');


			GetWitcherPlayer().RemoveBuffImmunity( EET_Stagger,					'acs_guard');
			GetWitcherPlayer().RemoveBuffImmunity( EET_LongStagger,				'acs_guard');

			if (GetWitcherPlayer().IsGuarded())
			{
				GetWitcherPlayer().SetGuarded(false);
				GetWitcherPlayer().OnGuardedReleased();	
			}

			if ( GetWitcherPlayer().IsQuenActive(false))
			{
				GetWitcherPlayer().FinishQuen(false);
			}
			
			GetACSWatcher().RemoveTimer('ACS_Shield_Spawn_Delay'); 

			ACS_Axii_Shield_Destroy();
			ACS_Axii_Shield_Destroy_DELAY();
			ACS_Quen_Monsters_Despawn();
			ACS_Bruxa_Camo_Decoy_Deactivate();
			ACS_AardPull_Deactivate();

			thePlayer.ACS_ClearAnimationSpeedMultipliers();

			GetWitcherPlayer().RaiseEvent( 'AttackInterrupt' );

			paramsKnockdown.effectType = EET_LongStagger;
			paramsKnockdown.creator = thePlayer;
			paramsKnockdown.sourceName = "ACS_Posture_Break";
			paramsKnockdown.duration = 1;

			thePlayer.AddEffectCustom( paramsKnockdown ); 				
			
			ACS_PlayerHitEffects();

			GetWitcherPlayer().PlayEffectSingle('mutation_7_adrenaline_drop');
			GetWitcherPlayer().StopEffect('mutation_7_adrenaline_drop');

			GetWitcherPlayer().DrainFocus( GetWitcherPlayer().GetStatMax( BCS_Focus ) );

			GetWitcherPlayer().SoundEvent("cmb_play_hit_heavy");

			GetWitcherPlayer().SoundEvent("cmb_play_dismemberment_gore");

			GetWitcherPlayer().SoundEvent("damage_01_bb_acs");

			GetWitcherPlayer().SoundEvent("damage_02_bb_acs");

			GetWitcherPlayer().SoundEvent("monster_dettlaff_monster_vein_hit_blood");

			GetWitcherPlayer().PlayEffectSingle('heavy_hit');

			GetWitcherPlayer().StopEffect('heavy_hit');

			acs_player_posture -= acs_player_posture;
		}
		else
		{
			acs_player_posture = acs_max_player_posture;
		}
	}
	else
	{
		if (ACS_IsInDimeritiumCloud()
		|| HasBuff(EET_HeavyKnockdown) 
		|| HasBuff( EET_Knockdown ) 
		|| HasBuff( EET_Ragdoll ) 
		|| HasBuff( EET_Stagger )
		|| HasBuff( EET_LongStagger )
		|| HasBuff( EET_Pull )
		|| HasBuff( EET_Hypnotized )
		|| HasBuff( EET_WitchHypnotized )
		|| HasBuff( EET_Blindness )
		|| HasBuff( EET_WraithBlindness )
		|| HasBuff( EET_Frozen )
		|| HasBuff( EET_Paralyzed )
		|| HasBuff( EET_Confusion )
		|| HasBuff( EET_Tangled )
		|| HasBuff( EET_Tornado ) 
		|| HasBuff( EET_Swarm ) 
		|| HasBuff( EET_Burning ) 
		|| HasBuff( EET_Poison ) 
		)
		{
			increase_amount += 10;
		}

		if( GetWitcherPlayer().GetInventory().GetItemEquippedOnSlot(EES_Armor, item) )
		{
			if( GetWitcherPlayer().GetInventory().ItemHasTag(item, 'HeavyArmor') )
			{
				increase_amount -= increase_amount * 0.5;
			}
			else if( GetWitcherPlayer().GetInventory().ItemHasTag(item, 'MediumArmor') )
			{
				increase_amount -= increase_amount * 0.25;
			}
			else if( GetWitcherPlayer().GetInventory().ItemHasTag(item, 'LightArmor') )
			{
				increase_amount -= increase_amount * 0.125;
			}
		}

		ACS_Tutorial_Display_Check('ACS_Posture_Tutorial_Shown');

		if ( ACS_Armor_Set_Check('manticore', true) && ACSGetCEntity('ACS_ManticoreShield') )
		{
			increase_amount -= increase_amount * 0.5;
		}

		acs_player_posture += increase_amount;

		if (acs_player_posture >= acs_max_player_posture)
		{
			acs_player_posture = acs_max_player_posture;
		}
	}
}

@addMethod( CR4Player ) timer function ACS_ResetPlayerPosture( dt : float, id : int )
{
	RemoveTimer('ACS_ResetPlayerPostureRepeat');
	AddTimer('ACS_ResetPlayerPostureRepeat', 0.001, true);
}

@addMethod( CR4Player ) timer function ACS_ResetPlayerPostureRepeat( dt : float, id : int )
{
	if (acs_player_posture <= 0)
	{
		acs_player_posture = 0;

		RemoveTimer('ACS_ResetPlayerPostureRepeat');
	}
	else
	{
		acs_player_posture -= ((GetCurrentHealth() / GetMaxHealth()) * 0.1);
	}
}



//////////////////////////////////////////////////////////////////////////////

@addField(CNewNPC)
private var acs_dripping_water_ents_added 		: bool;

@addField(CNewNPC)
private var acs_dripping_water_ents		    				: array<CEntity>;

@addMethod( CNewNPC ) function ACS_RoofCheck() : bool
{
	var pos, target, hitPos, hitNormal : Vector;
	
	pos = this.GetWorldPosition();
	pos.Z += 1.8;
	
	target = pos;
	target.Z += 30.0;
	target += this.GetWorldForward() * 18.0;
	
	if(theGame.GetWorld().StaticTrace(pos, target, hitPos, hitNormal))
	{
		return true;
	}

	return false;
}

@wrapMethod(CNewNPC) function OnCombatModeSet( toggle : bool )
{
	SignalGameplayEvent('UnforceTarget');

	wrappedMethod(toggle);
}

@addField(CNewNPC)
public var acs_sneaky_angle 		: float; 

@addMethod( CNewNPC ) function ACS_LineOfSightCheck() : bool
{
	var actors		    								: array<CActor>;
	var j												: int;
	var dist											: float;
	var pos, targetPos									: Vector;

	var traceStartPos, traceEndPos, position, normal 	: Vector;
	var res, res_1, res_2 											: bool;
	var mat												: name;
	var component										: CComponent;
	var collisionGroups									: array<name>;
	var collisionGroups2								: array<name>;
	

	if (this.IsMonster())
	{
		dist = 25;
		acs_sneaky_angle = 200;
	}
	else
	{
		dist = 20;
		acs_sneaky_angle = 180;
	}

	if (thePlayer.IsEffectActive('acs_invisible'))
	{
		dist -= 15;

		acs_sneaky_angle -= 60;
	}

	if (GetRainStrength() > 0 
	&& !thePlayer.IsInInterior()
	&& !GetACSWatcher().RoofCheck()
	)
	{
		dist -= 10;

		acs_sneaky_angle -= 30;
	}

	if (thePlayer.playerMoveType == PMT_Idle)
	{
		dist -= 10;

		acs_sneaky_angle -= 30;
	}

	if (FactsQuerySum("ACS_Darkness_Upon_Us") > 0 
	|| theGame.envMgr.IsNight()
	)
	{
		dist -= 10;

		acs_sneaky_angle -= 20;
	}

	if (thePlayer.IsCurrentlyDodging()
	|| thePlayer.HasTag('ACS_Is_Currently_Dodging'))
	{
		dist -= 10;

		acs_sneaky_angle -= 20;
	}

	if (dist <= 2)
	{
		dist = 2;
	}

	if (acs_sneaky_angle <= 5)
	{
		acs_sneaky_angle = 5;
	}

	pos = this.GetWorldPosition();
	pos.Z += 0.8;

	actors = this.GetNPCsAndPlayersInCone(dist, VecHeading(this.GetHeadingVector()), acs_sneaky_angle, 200, , FLAG_OnlyAliveActors + FLAG_TestLineOfSight); 

	if( actors.Size() > 0 )
	{
		for( j = 0; j < actors.Size(); j += 1 )
		{
			targetPos = actors[j].GetWorldPosition();

			if ( AbsF( targetPos.Z - pos.Z ) > 5 
			|| actors[j] == this
			|| GetAttitudeBetween( this, actors[j] ) == AIA_Friendly
			|| this.GetAttitude( actors[j] ) == AIA_Friendly
			|| theGame.GetGlobalAttitude( actors[j].GetBaseAttitudeGroup(), 'player' ) == AIA_Hostile
			)
			{
				continue;
			}

			if ((CPlayer)actors[j])
			{
				res_1 = true;
			}
		}
	}

	if (res_1)
	{
		traceStartPos 	= this.GetWorldPosition();
		traceEndPos 	= thePlayer.GetWorldPosition();
		
		traceStartPos.Z += 1;
		traceEndPos.Z += 1.6;

		collisionGroups.Clear();
		collisionGroups.PushBack('Static');
		collisionGroups.PushBack('Debris');
		collisionGroups.PushBack('Destructible');
		collisionGroups.PushBack('Terrain');
		collisionGroups.PushBack('ClothCollider');
		collisionGroups.PushBack('Foliage');
		collisionGroups.PushBack('Door');
		collisionGroups.PushBack('Corpse');
		collisionGroups.PushBack('Fence');
		collisionGroups.PushBack('Boat');
		collisionGroups.PushBack('Platforms');

		collisionGroups2.Clear();
		collisionGroups2.PushBack('Character');
		collisionGroups2.PushBack('Static');
		collisionGroups2.PushBack('Debris');
		collisionGroups2.PushBack('Ragdoll');
		collisionGroups2.PushBack('Destructible');
		collisionGroups2.PushBack('Terrain');
		collisionGroups2.PushBack('ClothCollider');
		collisionGroups2.PushBack('RigidBody');
		collisionGroups2.PushBack('Foliage');
		collisionGroups2.PushBack('Door');
		//collisionGroups2.PushBack('Corpse');
		collisionGroups2.PushBack('ParticleCollider');
		collisionGroups2.PushBack('Fence');
		collisionGroups2.PushBack('SoftKinematicContact');
		collisionGroups2.PushBack('Boat');
		collisionGroups2.PushBack('Platforms');
		
		if ( !theGame.GetWorld().SweepTest( traceStartPos, traceEndPos, 0.5, position, normal, collisionGroups ) )
		{
			theGame.GetWorld().StaticTraceWithAdditionalInfo( traceStartPos + this.GetWorldForward()*0.5, traceEndPos, position, normal, mat, component, collisionGroups2 );
			if ( (CActor)component.GetEntity() == thePlayer )
			{
				res_2 = true;
			}
		}
	}

	if (res_2)
	{
		return true;
	}
	
	return false;
}

@addField(CNewNPC)
private var acs_checkLineOfSight 		: bool; 

@addField(CNewNPC)
public var acs_backstab_wound_fx		: CEntity;

@addField(CNewNPC)
public var acs_dummy_lure_entity		: CEntity;

@addField(CNewNPC)
public var acs_enemy_start_heading_vector		: Vector;

@addMethod( CNewNPC ) timer function ACS_Sneaking_Controller( dt : float, id : int )
{
	var targetDistance									: float;
	var bPos, teleport_pos								: Vector;
	var bRot 											: EulerAngles;
	var boneIndex 										: int;
	var movementAdjustorNPC								: CMovementAdjustor;
	var ticketNPC										: SMovementAdjustmentRequestTicket;
	var distance										: float;
	var targetPos										: Vector;
	
	if ( GetTarget())
	{
		if ( ((CActor)GetTarget()).GetBoneIndex('head') != -1 )
		{
			targetPos = ((CActor)GetTarget()).GetBoneWorldPosition('head');
		}
		else
		{
			if ( ((CActor)GetTarget()).GetBoneIndex('k_head_g') != -1 )
			{
				targetPos = ((CActor)GetTarget()).GetBoneWorldPosition('k_head_g');
			}
			else
			{
				targetPos = ((CActor)GetTarget()).GetWorldPosition();

				targetPos.Z += 1.5;
			}
		}
	}
	else
	{
		targetPos = this.GetWorldPosition() + this.GetWorldForward() * 10;

		targetPos.Z += 1.5;
	}

	if (HasTag('ACS_Custom_Monster'))
	{
		if (GetBehaviorVariable( 'lookatOn' ) != 0)
		{
			SetBehaviorVariable( 'lookatOn', 0, true );
		}
	}
	else
	{
		SetBehaviorVectorVariable( 'lookAtTarget', targetPos );

		if (GetBehaviorVariable( 'lookatOn' ) != 1)
		{
			SetBehaviorVariable( 'lookatOn', 1, true );
		}
	}
	
	if ( 
	GetACSWatcher().ACS_IS_SNEAKING 
	&& thePlayer.HasTag('ACS_Is_Sneaking')
	&& this.IsAlive()
	&& !this.HasTag('ACS_Sneaking_Lure')
	&& this != (GetACSWatcher().counter_wound_target)
	&& this.GetNPCType() != ENGT_Quest
	&& this.GetNPCType() != ENGT_Guard
	&& ACS_Settings_Main_Bool('acs_combat_main_settings','acs_sneaking', true)
	)
	{
		if ( 
		this.GetAttitude( thePlayer ) == AIA_Hostile	
		)
		{
			targetDistance = VecDistanceSquared2D( this.GetWorldPosition(), GetWitcherPlayer().GetWorldPosition() );

			if (targetDistance <= 100 * 100)
			{
				if (ACS_LineOfSightCheck() 
				&& acs_checkLineOfSight
				&& !thePlayer.HasTag('ACS_IsPerformingFinisher')
				&& !thePlayer.HasTag('ACS_IsPerformingCounterWound')
				&& !this.HasTag('ACS_Stab_Hostage')
				&& !ACSGetCActor('ACS_Stab_Hostage')
				&& FactsQuerySum("ACS_Bloodsmoke_Active") <= 0
				&& !this.HasBuff( EET_Hypnotized )
				&& !this.HasBuff( EET_WitchHypnotized )
				&& !this.HasBuff( EET_Blindness )
				&& !this.HasBuff( EET_WraithBlindness )
				&& !this.HasBuff( EET_Paralyzed )
				&& !this.HasBuff( EET_Confusion )
				&& !this.HasBuff( EET_Choking )
				&& !this.HasBuff( EET_Immobilized )
				&& !this.HasBuff( EET_AxiiGuardMe )
				&& !this.HasBuff( EET_Weaken )
				)
				{
					//((CAnimatedComponent)(this).GetComponentByClassName('CAnimatedComponent')).FreezePose();

					((CAnimatedComponent)(this).GetComponentByClassName('CAnimatedComponent')).UnfreezePose();

					((CAnimatedComponent)(this).GetComponentByClassName('CAnimatedComponent')).UnfreezePoseFadeOut(1.5);

					this.ACS_SetAnimationSpeedMultiplier(1);

					this.NoticeActor( GetWitcherPlayer() );

					this.SignalGameplayEventParamObject( 'ForceTarget', GetWitcherPlayer() );

					acs_dummy_lure_entity.Destroy();

					GetACSWatcher().RemoveSneaking(true);

					acs_checkLineOfSight = false;
				}
				else
				{	
					this.GetMovingAgentComponent().ResetMoveRequests();

					this.SetGuarded(true);

					if ( !acs_checkLineOfSight )
					{
						theGame.RemoveTimeScale( theGame.GetTimescaleSource(ETS_InstantKill) );
						
						acs_enemy_start_heading_vector = this.GetHeadingVector();

						//((CAnimatedComponent)(this).GetComponentByClassName('CAnimatedComponent')).FreezePose();

						((CAnimatedComponent)(this).GetComponentByClassName('CAnimatedComponent')).UnfreezePose();

						((CAnimatedComponent)(this).GetComponentByClassName('CAnimatedComponent')).UnfreezePoseFadeOut(1.5);

						if (!this.HasTag('ACS_Counter_Wound_Ready'))
						{
							this.AddTag('ACS_Counter_Wound_Ready');
						}

						this.SignalGameplayEvent('UnforceTarget');

						this.ForgetActor( GetWitcherPlayer() );

						if (!acs_dummy_lure_entity)
						{
							acs_dummy_lure_entity = (CEntity)theGame.CreateEntity( 

							(CEntityTemplate)LoadResource("dlc\dlc_acs\data\entities\other\acs_enemy_lure_entity.w2ent", true ), 

							this.GetWorldPosition() + Vector(0,0,10), 

							this.GetWorldRotation() );

							acs_dummy_lure_entity.AddTag('ACS_Sneaking_Lure');

							//acs_dummy_lure_entity.CreateAttachment(this,, Vector(0,0,20));

							this.NoticeActor( ((CActor)acs_dummy_lure_entity) );

							this.SignalGameplayEventParamObject( 'ForceTarget', ((CActor)acs_dummy_lure_entity) );
						}

						if (!acs_backstab_wound_fx)
						{
							acs_backstab_wound_fx = theGame.CreateEntity( (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent", true ), 
							this.GetWorldPosition(), 
							this.GetWorldRotation() );

							if (!ACS_Settings_Main_Bool('acs_misc_main_settings','acs_hide_counter_wound_prompt', false))
							{
								acs_backstab_wound_fx.PlayEffectSingle('counter_wound_marker');
							}

							if ( this.GetBoneIndex('pelvis') != -1 )
							{
								boneIndex = this.GetBoneIndex( 'pelvis' );	
								this.GetBoneWorldPositionAndRotationByIndex( boneIndex, bPos, bRot );

								acs_backstab_wound_fx.CreateAttachmentAtBoneWS(this, 'pelvis', bPos, bRot);
							}
							else
							{
								if ( this.GetBoneIndex('k_pelvis_g') != -1 )
								{
									boneIndex = this.GetBoneIndex( 'k_pelvis_g' );	
									this.GetBoneWorldPositionAndRotationByIndex( boneIndex, bPos, bRot );

									acs_backstab_wound_fx.CreateAttachmentAtBoneWS(this, 'k_pelvis_g', bPos, bRot);
								}
								else
								{
									acs_backstab_wound_fx.CreateAttachment(this, , Vector(0,0,1.5), thePlayer.GetWorldRotation());
								}
							}

							acs_backstab_wound_fx.AddTag('ACS_Counter_Wound');
						}

						movementAdjustorNPC = this.GetMovingAgentComponent().GetMovementAdjustor();
						movementAdjustorNPC.CancelAll();

						if (FactsQuerySum("ACS_Bloodsmoke_Active") > 0)
						{
							ticketNPC = movementAdjustorNPC.GetRequest( 'ACS_NPC_Rotate');
							movementAdjustorNPC.CancelByName( 'ACS_NPC_Rotate' );

							ticketNPC = movementAdjustorNPC.CreateNewRequest( 'ACS_NPC_Rotate' );
							movementAdjustorNPC.AdjustmentDuration( ticketNPC, 1 );
							movementAdjustorNPC.MaxRotationAdjustmentSpeed( ticketNPC, 500000 );

							movementAdjustorNPC.RotateTowards( ticketNPC, thePlayer, RandRangeF(270, 90));
						}

						acs_checkLineOfSight = true;
					}

					//ticketNPC = movementAdjustorNPC.GetRequest( 'ACS_NPC_Rotate');
					//movementAdjustorNPC.CancelByName( 'ACS_NPC_Rotate' );

					//ticketNPC = movementAdjustorNPC.CreateNewRequest( 'ACS_NPC_Rotate' );
					//movementAdjustorNPC.AdjustmentDuration( ticketNPC, 3 );
					//movementAdjustorNPC.MaxRotationAdjustmentSpeed( ticketNPC, 500000 );

					if (!this.IsRotatedTowards( ((CActor)acs_dummy_lure_entity), 10 ))
					{
						//movementAdjustorNPC.RotateTowards( ticketNPC, ((CActor)acs_dummy_lure_entity));

						//((CActor)this).ActionRotateToAsync( acs_dummy_lure_entity.GetWorldPosition() );
					}

					if( this.GetBehaviorVariable('rotateAngle') != 0 
					)
					{
						this.SetBehaviorVariable( 'rotateAngle', 0, true );
					}

					if( this.GetBehaviorVariable('rotation') != 0 
					)
					{
						this.SetBehaviorVariable( 'rotation', 0, true );
					}

					this.RaiseForceEvent( 'Idle' );

					if (ACSGetCEntity('ACS_Sneaking_Lure_Entity'))
					{
						this.ACS_SetAnimationSpeedMultiplier(0.75);
					}
					else
					{
						if (this.IsRotatedTowards( thePlayer, acs_sneaky_angle ))
						{
							this.ACS_SetAnimationSpeedMultiplier(0.5);
						}
						else
						{
							this.ACS_SetAnimationSpeedMultiplier(0.1875f);
						}
					}
					

					if (ACSGetCEntity('ACS_Sneaking_Lure_Entity'))
					{
						teleport_pos = ACSGetCEntity('ACS_Sneaking_Lure_Entity').GetWorldPosition();
						teleport_pos.Z += RandRangeF(1, 2);

						acs_dummy_lure_entity.TeleportWithRotation(teleport_pos, this.GetWorldRotation());
					}
					else
					{
						if (this.HasTag('ACS_Bomb_Planted'))
						{
							teleport_pos = this.GetWorldPosition() + (this.GetWorldForward() * RandRangeF(1.5, 3)) + (this.GetWorldRight() * RandRangeF(-5, 5) );
							teleport_pos.Z += RandRangeF(1, 2);
						}
						else
						{
							teleport_pos = this.GetWorldPosition() + (this.GetWorldForward() * RandRangeF(-0.5, 1.5));
							teleport_pos.Z += RandRangeF(1, 2);
						}
						

						acs_dummy_lure_entity.TeleportWithRotation(LerpV(this.GetWorldPosition(), teleport_pos, 0.1), this.GetWorldRotation());
					}

					if (((CActor)this.GetTarget()) != ((CActor)acs_dummy_lure_entity))
					{
						this.NoticeActor( ((CActor)acs_dummy_lure_entity) );

						this.SignalGameplayEventParamObject( 'ForceTarget', ((CActor)acs_dummy_lure_entity) );
					}

					if (acs_backstab_wound_fx.HasTag('ACS_Counter_Wound_Disable'))
					{
						acs_backstab_wound_fx.StopAllEffects();
					}
					else
					{
						if (((CMovingPhysicalAgentComponent)(this.GetMovingAgentComponent())).GetCapsuleHeight() >= 2
						|| this.GetRadius() >= 0.7
						|| this.HasAbility('Boss')
						|| this.HasTag('IsBoss')
						|| this.HasTag('ACS_Big_Boi')
						)
						{
							distance = 5;
						}
						else
						{
							distance = 3.5;
						}

						if (targetDistance <= distance * distance
						&& this == thePlayer.GetTarget()
						)
						{
							if (!acs_backstab_wound_fx.IsEffectActive('sneaking_notice_marker', false)
							)
							{
								acs_backstab_wound_fx.PlayEffectSingle('sneaking_notice_marker');
							}
						}
						else
						{
							if (acs_backstab_wound_fx.IsEffectActive('sneaking_notice_marker', false))
							{
								acs_backstab_wound_fx.StopEffect('sneaking_notice_marker');
							}
						}

						if (this.IsRotatedTowards( thePlayer, acs_sneaky_angle ))
						{
							if (acs_backstab_wound_fx.IsEffectActive('backstab_ready', false))
							{
								acs_backstab_wound_fx.StopEffect('backstab_ready');
							}
						}
						else
						{
							if (!acs_backstab_wound_fx.IsEffectActive('backstab_ready', false)
							)
							{
								acs_backstab_wound_fx.PlayEffectSingle('backstab_ready');
							}
						}	
					}
				}
			}
		}
	}
	else
	{
		if (acs_checkLineOfSight
		)
		{
			if (
			acs_backstab_wound_fx	
			&& acs_backstab_wound_fx.HasTag('ACS_Counter_Wound_Disable'))
			{
				acs_backstab_wound_fx.StopAllEffects();
			}

			acs_dummy_lure_entity.Destroy();

			//((CAnimatedComponent)(this).GetComponentByClassName('CAnimatedComponent')).FreezePose();

			((CAnimatedComponent)(this).GetComponentByClassName('CAnimatedComponent')).UnfreezePose();

			((CAnimatedComponent)(this).GetComponentByClassName('CAnimatedComponent')).UnfreezePoseFadeOut(1.5);

			this.ACS_SetAnimationSpeedMultiplier(1);

			acs_checkLineOfSight = false;

			if (!ACS_Settings_Main_Bool('acs_combat_main_settings','acs_sneaking', true))
			{
				RemoveTimer('ACS_Sneaking_Controller');
			}
		}
	}
}

@wrapMethod( W3BaitProjectile ) function OnProjectileCollision( pos, normal : Vector, collidingComponent : CComponent, hitCollisionsGroups : array< name >, actorIndex : int, shapeIndex : int )
{
	var ent_1, ent_2 												: CEntity;

	wrappedMethod(pos, normal, collidingComponent, hitCollisionsGroups, actorIndex, shapeIndex);

	this.SoundEvent("bomb_dragons_dream_explo");

	this.SoundEvent("bomb_devils_puffball_explo");

	ACSGetCEntityDestroyAll('ACS_Sneaking_Lure_Entity');

	ent_1 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

	"dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent"

	, true ), this.GetWorldPosition(), this.GetWorldRotation() );

	ent_1.CreateAttachment(this);

	ent_1.AddTag('ACS_Sneaking_Lure_Entity');

	ent_1.DestroyAfter(10);


	ent_2 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

	"dlc\dlc_acs\data\fx\bolt_lure\bolt_lure_marker.w2ent"

	, true ), this.GetWorldPosition(), this.GetWorldRotation() );

	ent_2.CreateAttachment(this);

	ent_2.PlayEffectSingle('smoke');

	ent_2.PlayEffectSingle('marker');

	ent_2.DestroyAfter(60);

	ent_2.SoundEvent("bomb_devils_puffball_ground_loop");
}

@wrapMethod( W3Petard ) function ProcessEffect( optional explosionPosition : Vector, optional collidedTarget : CGameplayEntity )
{
	var ent_1 												: CEntity;

	wrappedMethod(explosionPosition, collidedTarget);

	if (thePlayer.HasTag('ACS_Is_Sneaking') 
	)
	{
		ACSGetCEntityDestroyAll('ACS_Sneaking_Lure_Entity');

		ent_1 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

		"dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent"

		, true ), this.GetWorldPosition(), this.GetWorldRotation() );

		ent_1.CreateAttachment(this);

		ent_1.AddTag('ACS_Sneaking_Lure_Entity');

		ent_1.DestroyAfter(10);
	}

	if(isCluster 
	&& !ignoreBombSkills 
	&& (W3PlayerWitcher)GetOwner() 
	&& GetWitcherPlayer().CanUseSkill(S_Alchemy_s11) 
	&& !HasTag('Snowball')
	&& !HasTag('ACS_Cluster_Bomb_Second_Spawn')
	)
	{
		if (HasTag('ACS_Cluster_Bomb_First_Spawn')
		)
		{
			ProcessClusterBombs();
		}
	}
}

@addMethod( CNewNPC ) timer function ACS_Ice_Breath_Controller_Check( dt : float, id : int )
{
	var temp											: CEntityTemplate;
	var controller										: CACSIceBreatheController;
	var voiceTagName 									: name;
	var voiceTagStr										: string;
	var appearanceName 									: name;
	var appearanceStr									: string;
	var bonePosition									: Vector;
	var boneRotation									: EulerAngles;
	var dripping_water_ent								: CEntity;
	var boneNames										: array<CName>;
	var boneIndex, i, j									: int;

	if (this.IsAlive()
	&& !this.IsInInterior()
	&& !this.ACS_RoofCheck()
	&& thePlayer.WasVisibleInScaledFrame( this, 1.f, 1.f )
	&& ACS_Settings_Main_Bool('acs_visual_main_settings','acs_rain_water_droplets_enabled', true)
	&& (GetWeatherConditionName() == 'WT_Rain_Storm' 
	|| GetWeatherConditionName() == 'WT_Rain_Heavy' 
	|| GetWeatherConditionName() == 'WT_Rain_Dark' 
	)
	)
	{
		voiceTagName =  GetVoicetag();
		voiceTagStr = NameToString( voiceTagName );
		
		appearanceName =  GetAppearance();
		appearanceStr = NameToString( appearanceName );

		if(
		this.IsHuman()
		|| this.IsMan()
		|| this.IsWoman()
		|| StrFindFirst(voiceTagStr, "BOY") >= 0
		|| StrFindFirst(voiceTagStr, "GIRL") >= 0
		|| StrFindFirst(appearanceStr, "BOY") >= 0
		|| StrFindFirst(appearanceStr, "GIRL") >= 0
		)
		{
			if (!acs_dripping_water_ents_added)
			{
				boneNames.Clear();

				boneNames.PushBack('torso');
				boneNames.PushBack('torso2');
				boneNames.PushBack('l_shoulder');
				boneNames.PushBack('l_forearm');
				boneNames.PushBack('l_hand');
				boneNames.PushBack('r_shoulder');
				boneNames.PushBack('r_forearm');
				boneNames.PushBack('r_hand');
				boneNames.PushBack('l_thigh');
				boneNames.PushBack('l_kneeRoll');
				boneNames.PushBack('r_thigh');
				boneNames.PushBack('r_kneeRoll');
				boneNames.PushBack('l_bicep2');
				boneNames.PushBack('l_legRoll2');
				boneNames.PushBack('l_forearmRoll2');
				boneNames.PushBack('r_elbowRoll');
				boneNames.PushBack('l_elbowRoll');
				boneNames.PushBack('r_forearmRoll2');
				boneNames.PushBack('r_legRoll2');
				boneNames.PushBack('r_bicep2');

				boneNames.PushBack('r_thumb3');
				boneNames.PushBack('r_index3');
				boneNames.PushBack('r_middle3');
				boneNames.PushBack('r_ring3');
				boneNames.PushBack('r_pinky3');

				boneNames.PushBack('l_thumb3');
				boneNames.PushBack('l_index3');
				boneNames.PushBack('l_middle3');
				boneNames.PushBack('l_ring3');
				boneNames.PushBack('l_pinky3');
				
				for( i = 0; i < boneNames.Size(); i += 1 )
				{
					if(RandF() < 0.5)
					{
						boneIndex = this.GetBoneIndex( boneNames[i] );	

						this.GetBoneWorldPositionAndRotationByIndex( boneIndex, bonePosition, boneRotation );

						dripping_water_ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

						"dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent"

						, true ), GetWorldPosition(), GetWorldRotation() );

						dripping_water_ent.CreateAttachmentAtBoneWS(this, boneNames[i], bonePosition, boneRotation );

						dripping_water_ent.PlayEffectSingle('dripping_water');

						acs_dripping_water_ents.PushBack(dripping_water_ent);
					}
				}

				acs_dripping_water_ents_added = true;
			}
		}
	}
	else
	{
		if (acs_dripping_water_ents_added)
		{
			for( j = 0; j < acs_dripping_water_ents.Size(); j += 1 )
			{
				acs_dripping_water_ents[j].DestroyAfter(RandRangeF(7,3));
			}

			acs_dripping_water_ents_added = false;
		}
	}

	if (this.IsAlive()
	&& !this.IsInInterior()
	&& thePlayer.WasVisibleInScaledFrame( this, 1.f, 1.f )
	&& ACS_Settings_Main_Bool('acs_visual_main_settings','acs_ice_breath_enabled', true)
	&& (theGame.GetCommonMapManager().GetCurrentArea() == AN_Skellige_ArdSkellig 
	|| theGame.GetCommonMapManager().GetCurrentArea() == AN_Island_of_Myst 
	|| theGame.GetCommonMapManager().GetCurrentArea() == AN_Prologue_Village_Winter 
	|| theGame.GetCommonMapManager().GetCurrentArea() == AN_Kaer_Morhen
	|| GetWeatherConditionName() == 'WT_Snow' 
	|| GetWeatherConditionName() == 'WT_Blizzard' 
	|| GetWeatherConditionName() == 'WT_Battle' 
	|| GetWeatherConditionName() == 'WT_Battle_Forest'
	|| GetWeatherConditionName() == 'WT_Mid_Clouds_Fog'
	|| GetWeatherConditionName() == 'WT_Wild_Hunt'
	|| GetWeatherConditionName() == 'WT_q501_Blizzard'
	|| GetWeatherConditionName() == 'WT_q501_Storm'
	|| GetWeatherConditionName() == 'WT_q501_Blizzard2'
	|| GetWeatherConditionName() == 'WT_q604_Snow'
	|| GetWeatherConditionName() == 'WT_Fog'
	|| GetWeatherConditionName() == 'WT_Light_Fog' 
	|| GetWeatherConditionName() == 'WT_Fog_Windy' 
	|| GetWeatherConditionName() == 'WT_Fog_Snow' 
	|| GetWeatherConditionName() == 'WT_Fog_Heavy' 
	|| GetWeatherConditionName() == 'WT_Cold' 
	|| GetWeatherConditionName() == 'WT_Cold_Clouds'
	|| GetWeatherConditionName() == 'WT_Cold_BOB'
	|| GetWeatherConditionName() == 'fog1' 
	|| GetWeatherConditionName() == 'fog2' 
	|| GetWeatherConditionName() == 'flurry1' 
	|| GetWeatherConditionName() == 'flurry2' 
	|| GetWeatherConditionName() == 'flurry3' 
	|| GetWeatherConditionName() == 'flurry4' 
	|| GetWeatherConditionName() == 'snow1' 
	|| GetWeatherConditionName() == 'snow2' 
	|| GetWeatherConditionName() == 'snow3' 
	|| GetWeatherConditionName() == 'snow4' 
	|| GetWeatherConditionName() == 'snow5' 
	|| GetWeatherConditionName() == 'snow6'
	|| GetWeatherConditionName() == 'blizzard'
	|| GetWeatherConditionName() == 'LightSnow' 
	|| GetWeatherConditionName() == 'MidCloudsSnow' 
	|| GetWeatherConditionName() == 'Snow' 
	|| GetWeatherConditionName() == 'SnowWhite' 
	|| GetWeatherConditionName() == 'Blizzard'
	)
	)
	{
		voiceTagName =  GetVoicetag();
		voiceTagStr = NameToString( voiceTagName );
		
		appearanceName =  GetAppearance();
		appearanceStr = NameToString( appearanceName );

		if(
		this.IsHuman()
		)
		{
			if(this.IsMan()
			|| this.IsWoman()
			|| StrFindFirst(voiceTagStr, "BOY") >= 0
			|| StrFindFirst(voiceTagStr, "GIRL") >= 0
			|| StrFindFirst(appearanceStr, "BOY") >= 0
			|| StrFindFirst(appearanceStr, "GIRL") >= 0
			)
			{
				if (!controller)
				{
					temp = (CEntityTemplate)LoadResource( 

					"dlc\dlc_acs\data\fx\acs_ice_breathe.w2ent"
					
					, true );

					if(
					this.IsWoman()
					)
					{
						this.GetBoneWorldPositionAndRotationByIndex( this.GetBoneIndex( 'hroll' ), bonePosition, boneRotation );
						controller = (CACSIceBreatheController)theGame.CreateEntity( temp, this.GetWorldPosition() + Vector( 0, 0, -10 ) );
						controller.CreateAttachmentAtBoneWS( this, 'hroll', bonePosition, boneRotation );
					}
					else
					{
						this.GetBoneWorldPositionAndRotationByIndex( this.GetBoneIndex( 'head' ), bonePosition, boneRotation );
						controller = (CACSIceBreatheController)theGame.CreateEntity( temp, this.GetWorldPosition() + Vector( 0, 0, -10 ) );
						controller.CreateAttachmentAtBoneWS( this, 'head', bonePosition, boneRotation );
					}
				}
				
				if (!controller.IsEffectActive('ice_breath', false))
				{
					controller.PlayEffectSingle('ice_breath');
				}
			}
		}
		else
		{
			if ( this.GetBoneIndex('head') != -1 )
			{
				this.GetBoneWorldPositionAndRotationByIndex( this.GetBoneIndex( 'head' ), bonePosition, boneRotation );

				controller = (CACSIceBreatheController)theGame.CreateEntity( temp, this.GetWorldPosition() + Vector( 0, 0, -10 ) );
				controller.CreateAttachmentAtBoneWS( this, 'head', bonePosition, boneRotation );
			}
			else
			{
				if ( this.GetBoneIndex('k_head_g') != -1 )
				{
					this.GetBoneWorldPositionAndRotationByIndex( this.GetBoneIndex( 'k_head_g' ), bonePosition, boneRotation );

					controller = (CACSIceBreatheController)theGame.CreateEntity( temp, this.GetWorldPosition() + Vector( 0, 0, -10 ) );
					controller.CreateAttachmentAtBoneWS( this, 'k_head_g', bonePosition, boneRotation );
				}
			}
		}
	}
	else
	{
		if (controller)
		{
			controller.StopAllEffects();
		}
	}
}

@addMethod( CNewNPC ) timer function ACS_Crawl_Controller_Delay_Spawn( dt : float, id : int )
{
	var crawl_temp								: CEntityTemplate;
	var crawl_controller						: CEntity;

	if (!this.IsAlive())
	{
		RemoveTimer('ACS_Crawl_Controller_Delay_Spawn');

		return;
	}

	if(
	this.IsHuman()
	&& this.UsesVitality()
	&& this.IsMan()
	&& !this.HasTag('ACS_Rat_Mage')
	&& !this.HasTag('ACS_Dwarf')
	)
	{
		if (!this.HasTag('ACS_Crawl_Controller_Attached'))
		{
			crawl_temp = (CEntityTemplate)LoadResource( 

			"dlc\dlc_acs\data\entities\other\human_death_crawl_controller.w2ent"
			
			, true );

			crawl_controller = (CEntity)theGame.CreateEntity( crawl_temp, this.GetWorldPosition() + Vector( 0, 0, -20 ) );

			crawl_controller.CreateAttachment( this, 'blood_point', Vector(0,0,0), EulerAngles(0,0,0) );

			this.AddTag('ACS_Crawl_Controller_Attached');
		}
	}
}

@addMethod( CNewNPC ) timer function ACS_DelayedWolfAttitudeSet( dt : float, id : int )
{
	
	if (!this.IsAlive() || thePlayer.IsCiri())
	{
		if (thePlayer.IsCiri() && this.HasAbility('mon_wolf_base'))
		{
			this.SetAttitude(thePlayer, AIA_Hostile);
		}

		RemoveTimer('ACS_DelayedWolfAttitudeSet');

		return;
	}

	if (this.HasAbility('mon_wolf_base')
	&& !this.HasAbility('mon_wolf_summon_were')
	&& !this.HasAbility('mon_evil_dog')
	&& !this.HasTag('ACS_Shadow_Wolf')
	&& !this.HasTag('ACS_MonsterHunt_Woodland_Spirit_Wolf')
	&& !this.UsesEssence()
	&& !this.IsInInterior()
	&& this.GetNPCType() != ENGT_Quest
	)
	{
		this.SetAttitude(thePlayer, AIA_Neutral);

		this.SetAttitude(thePlayer.GetHorseWithInventory(), AIA_Neutral);
	}
}

@addField(CNewNPC)
private saved var acs_animalActionID 		: int;

@addField(CNewNPC)
private saved var acs_animal_l_aiTree		: CAIFollowSideBySideAction;

@addMethod( CNewNPC ) timer function ACS_Animal_Controller( dt : float, id : int )
{
	var targetDistance									: float;

	if (!this.IsAlive() || !this.IsAnimal())
	{
		RemoveTimer('ACS_Animal_Controller');

		return;
	}

	if (!thePlayer.HasTag('ACS_Animal_Attract'))
	{
		if ( this.HasTag('ACS_Animal_Enthralled') )
		{
			this.CancelAIBehavior(acs_animalActionID);
			delete acs_animal_l_aiTree;

			this.RemoveTag('ACS_Animal_Enthralled');
		}

		return;
	}

	if (this.IsAnimal() && thePlayer.HasTag('ACS_Animal_Attract'))
	{
		targetDistance = VecDistanceSquared2D( thePlayer.GetWorldPosition(), this.GetWorldPosition() );

		if(targetDistance <= 20*20
		)
		{
			if ( !this.HasTag('ACS_Animal_Enthralled') )
			{
				acs_animal_l_aiTree = new CAIFollowSideBySideAction in this;
				acs_animal_l_aiTree.OnCreated();
				acs_animal_l_aiTree.params.targetTag = 'PLAYER';
				acs_animal_l_aiTree.params.moveSpeed = 6;
				acs_animal_l_aiTree.params.teleportToCatchup = true;

				acs_animalActionID = this.ForceAIBehavior(acs_animal_l_aiTree, BTAP_Emergency);

				this.AddTag('ACS_Animal_Enthralled');
			}
		}
		else if(targetDistance > 20*20 )
		{
			if ( this.HasTag('ACS_Animal_Enthralled') )
			{
				this.CancelAIBehavior(acs_animalActionID);
				delete acs_animal_l_aiTree;

				this.RemoveTag('ACS_Animal_Enthralled');
			}
		}
	}
}


/*
@addField(Exploration)
private var acs_last_panic_drain_time : float;

@addField(Exploration)
private var acs_swimProgress 		: float;

@addField(Exploration)
private var acs_swim_multiplier : float;

@addField(Exploration)
private var acs_horsePos : Vector;

@addField(Exploration)
private var acs_horseRot, acs_playerRot : EulerAngles;

@addMethod(Exploration) function ACS_Can_Add_Panic_Underwater(): bool 
{
	return theGame.GetEngineTimeAsSeconds() - acs_last_panic_drain_time > 0.1;
}

@addMethod(Exploration) function ACS_Refresh_Add_Panic_Underwater_Cooldown() 
{
	acs_last_panic_drain_time = theGame.GetEngineTimeAsSeconds();
}

@wrapMethod(Exploration) function UpdateLogic( dt : float )
{
	var actorParent : CActor;
	var player : W3PlayerWitcher;
	var slidingDisablesControll : bool;
	var waterDepth, z : float;
	var lookatPos : Vector;

	if(false) 
	{
		wrappedMethod(dt);
	}
	
	if(!thePlayer.GetIsHorseRacing())
		parentActor.SetBehaviorVariable( 'isRearingEnabled', 1.0 );
	else
		parentActor.SetBehaviorVariable( 'isRearingEnabled', 0.0 );

	waterDepth = GetSubmergeDepth();
	parentActor.SetBehaviorVariable( 'submergeDepth', ClampF( waterDepth, -5.0, 5.0 ) );

	if(waterDepth < -0.6f)
	{
		lookatPos = parentActor.GetWorldPosition() + VecConeRand(parentActor.GetHeading(), 0, 5,5) + Vector(0,0,2);
		
		parentActor.SetBehaviorVectorVariable( 'lookAtTarget', lookatPos );
		parentActor.SetBehaviorVariable( 'headWaterDepth', ClampF(-waterDepth/1.5, 0, 1) );
		parentActor.SetBehaviorVariable( 'lookatOn', 1.0f );
	}
	else
	{
		parentActor.SetBehaviorVariable( 'headWaterDepth', 0.f );
	}

	acs_horsePos = parentActor.GetWorldPosition();

	acs_horseRot = parentActor.GetWorldRotation();

	if (
	waterDepth < -1
	&& acs_horsePos.Z < theGame.GetWorld().GetWaterLevel(acs_horsePos, true)
	)
	{
		ResetSoundParameters();

		if (!parentActor.HasTag('ACS_Horse_Is_Swimming'))
		{
			//Jump();

			parentActor.AddTag('ACS_Horse_Is_Swimming');
		}

		(parentActor.GetMovingAgentComponent()).SetEnabledFeetIK(false,0.01);

		(parentActor.GetMovingAgentComponent()).SetEnabledSlidingOnSlopeIK(false);

		if (theInput.GetActionValue('HorseJump') > 0)
		{
			parentActor.EnableCollisions(true);

			if( waterDepth < -2.f && ACS_Can_Add_Panic_Underwater())
			{
				ACS_Refresh_Add_Panic_Underwater_Cooldown();

				parentActor.AddPanic(1);

				if (parentActor.GetStat( BCS_Panic ) <= 0)
				{
					OnHideHorse();
				}
			}

			acs_horsePos.Z -= 0.5;
		}
		else
		{
			parentActor.EnableCollisions(false);

			if (
			waterDepth < -1.65f
			)
			{
				acs_horsePos.Z += 0.5;
			}
			else
			{
				acs_horsePos.Z -= 0.5;
			}
		}

		parent.InternalSetSpeedMultiplier( 0.5f );

		if(theInput.GetActionValue('Gallop') > 0)
		{
			acs_swim_multiplier = 15.75;
			parent.InternalSetSpeed( GALLOP_SPEED );
		}
		else
		{
			if(theInput.GetActionValue('Canter') > 0)
			{
				acs_swim_multiplier = 10.25;
				parent.InternalSetSpeed( CANTER_SPEED );
			}
			else
			{
				if (theInput.GetActionValue('GI_AxisLeftY') > 0 
				|| theInput.GetActionValue('GI_AxisLeftX') > 0
				)
				{
					acs_swim_multiplier = 5.125;
					parent.InternalSetSpeed( TROT_SPEED );
				}
				else
				{
					acs_swimProgress -= acs_swimProgress;

					acs_swim_multiplier = 5.125;

					parent.InternalSetSpeed( WALK_SPEED );
				}
			}
		}

		acs_horsePos += 0.5*VecConeRand(theCamera.GetCameraHeading(), 0.001,theInput.GetActionValue('GI_AxisLeftY') * acs_swim_multiplier, theInput.GetActionValue('GI_AxisLeftY') * acs_swim_multiplier);	

		acs_horsePos -= 0.5*VecConeRand(theCamera.GetCameraHeading()+90, 5, theInput.GetActionValue('GI_AxisLeftX') * acs_swim_multiplier/2 , theInput.GetActionValue('GI_AxisLeftX') * acs_swim_multiplier/2 );

		theGame.GetWorld().NavigationComputeZ( acs_horsePos, acs_horsePos.Z - 128, acs_horsePos.Z + 128, z );

		if(z > acs_horsePos.Z)
		{
			acs_horsePos.Z = z;
		}

		acs_playerRot = theCamera.GetCameraRotation();

		acs_horseRot.Yaw = AngleApproach( acs_playerRot.Yaw, acs_horseRot.Yaw, 1.5 );

		if (theInput.GetActionValue('GI_AxisLeftY') > 0 
		|| theInput.GetActionValue('GI_AxisLeftX') > 0
		|| theInput.GetActionValue('Gallop') > 0
		|| theInput.GetActionValue('Canter') > 0
		)
		{
			parentActor.TeleportWithRotation(LerpV(parentActor.GetWorldPosition(), acs_horsePos, acs_swimProgress), acs_horseRot);
			
		}
		else
		{
			parentActor.Teleport(LerpV(parentActor.GetWorldPosition(), acs_horsePos, acs_swimProgress));
		}

		if (acs_swimProgress >= 0.01)
		{
			acs_swimProgress = 0.01;
		}
		else
		{
			acs_swimProgress += 0.00005;
		}
	}
	else
	{
		if (parentActor.HasTag('ACS_Horse_Is_Swimming'))
		{
			acs_swimProgress -= acs_swimProgress;

			Jump();

			theGame.GetWorld().NavigationComputeZ( acs_horsePos, acs_horsePos.Z - 128, acs_horsePos.Z + 128, z );

			if(z > acs_horsePos.Z)
			{
				acs_horsePos.Z = z;
			}

			parentActor.Teleport(LerpV(parentActor.GetWorldPosition(), acs_horsePos, 0.01f));

			parentActor.EnableCollisions(true);

			(parentActor.GetMovingAgentComponent()).SetEnabledFeetIK(true,4);

			(parentActor.GetMovingAgentComponent()).SetEnabledSlidingOnSlopeIK(true);

			parentActor.RemoveTag('ACS_Horse_Is_Swimming');
		}
	}

	if( roadFollowBlock > 0.0 )
	{
		roadFollowBlock -= dt;
		if( roadFollowBlock < 0.0 )
			roadFollowBlock = 0.0;
	}
	
	useSimpleStaminaManagement = parent.ShouldUseSimpleStaminaManagement();
	
	if( thePlayer.GetIsMovable() && IsHorseControllable() && !dismountRequest && !slidingDisablesControll )
	{
		rl = theInput.GetActionValue( 'GI_AxisLeftX' );
		fb = theInput.GetActionValue( 'GI_AxisLeftY' );
	}
	else
	{
		rl = 0.0;
		fb = 0.0;
	}
	
	isReversing	= false;
	if(currSpeed == MIN_SPEED && fb < 0.f && parent.lastRider == thePlayer )
	{
		isReversing	= true;
	}	
	
	SetTimeoutForCurrentSpeed();
	MaintainCameraVariables( dt );
	
	
	if( ( !useSimpleStaminaManagement && destSpeed > GALLOP_SPEED ) || ( !IsSpeedLocked() && destSpeed > MIN_SPEED && !rl && !fb ) || ( !IsSpeedLocked() && destSpeed > TROT_SPEED ) )
	{
		if( maintainSpeedTimer > speedTimeoutValue )
		{
			destSpeed = MaxF( MIN_SPEED, destSpeed - 1.f );
			maintainSpeedTimer = 0.0;
		}
		else
		{
			maintainSpeedTimer += dt;
		}
	}
	
	actorParent = (CActor)parent.GetEntity();
	
	if ( useSimpleStaminaManagement && currSpeed > GALLOP_SPEED && !isFollowingRoad )
	{
		
		if(thePlayer.GetIsHorseRacing())
			actorParent.DrainStamina( ESAT_FixedValue, 3.33f*dt, 1.f, '', 0.f, 1.f );
		else
			actorParent.DrainStamina( ESAT_FixedValue, 3.33f*dt, 1.f, '', 0.f, 0.45f );
		
		if ( actorParent.GetStat( BCS_Stamina ) <= 0.f )
		{
			staminaBreak = true;
			staminaCooldownTimer = 0.f;
			theGame.VibrateControllerVeryLight();	
		}
	}
	
	destSpeed = MinF( destSpeed, speedRestriction );
	
	if( currSpeed > destSpeed && currSpeed < GALLOP_SPEED )
		PlayVoicesetSlowerHorse();
	
	ProcessControlInput( rl, fb, dt, parent.IsControllableInLocalSpace() || parent.riderSharedParams.mountStatus == VMS_mountInProgress );
	
	if( requestJump )
	{
		if( PerformObstructionJumpTest() && PerformWaterJumpTest() && PerformFallJumpTest() )
		{
			Jump();
		}
		else
		{
			if( !isRefusingToGo && parent.isInIdle && CanPlayCollisionAnim() && !isReversing ) 
			{
				parent.GenerateEvent( 'WallCollision' );
				collisionAnimTimestamp = theGame.GetEngineTimeAsSeconds();
			}
			requestJump = false;
		}
	}
	
	if( staminaBreak )
	{
		if ( staminaCooldownTimer > staminaCooldown )
		{
			staminaBreak = false;
		}
		
		staminaCooldownTimer += dt;
		
		
		if(!isReversing)
			currSpeed = MinF( GALLOP_SPEED, currSpeed );			
		
		
		destSpeed = currSpeed;
	}
	

	if ( currSpeed != destSpeed )
	{
		
		if(!isReversing)
			currSpeed = destSpeed;
		
		
		if ( currSpeed == MIN_SPEED && !parent.isInIdle )
			isSlowlyStopping = true;
		else
			isSlowlyStopping = false;
	}
	
	if (!parentActor.HasTag('ACS_Horse_Is_Swimming'))
	{
		parent.InternalSetSpeedMultiplier( 1.f );
		parent.InternalSetSpeed( currSpeed );
	}
	
	
	if(parent.lastRider == thePlayer)
	{
		parent.SetDistanceBasedSpeed( VecDistance(cachedPos,parent.GetWorldPosition()) );	
		cachedPos = parent.GetWorldPosition();
	
		if(isReversing)
			parentActor.SetBehaviorVariable( 'reverse', 1.0f );	
		else
			parentActor.SetBehaviorVariable( 'reverse', 0.0f );	
	}
	
	CalculateSoundParameters( dt );
	thePlayer.SoundParameter( "horse_speed", currSpeedSound, 'head' ); 
	actorParent.SoundParameter( "horse_stamina", actorParent.GetStatPercents( BCS_Stamina ) * 100 ); 
}

@wrapMethod(Exploration) function CanPlayVoiceset( _currentTime : float ) : bool
{
	var waterDepth, z : float;

	waterDepth = GetSubmergeDepth();

	if (
	waterDepth < -2
	)
	{
		return false;
	}

	return wrappedMethod(_currentTime);
}

@wrapMethod(Exploration) function OnLeaveState( nextStateName : name )
{
	var lookatPos : Vector;
	var waterDepth, z : float;

	if(false) 
	{
		wrappedMethod(nextStateName);
	}

	CleanUpJump();
	ResetForceStop();
	Restore();
	UnregisterInput();

	waterDepth = GetSubmergeDepth();

	if (
	waterDepth < -1
	)
	{
		lookatPos = parentActor.GetWorldPosition() + VecConeRand(parentActor.GetHeading(), 0, 5,5) + Vector(0,0,2);
		
		parentActor.SetBehaviorVectorVariable( 'lookAtTarget', lookatPos );
		parentActor.SetBehaviorVariable( 'headWaterDepth', ClampF(-waterDepth/1.5, 0, 1) );
		parentActor.SetBehaviorVariable( 'lookatOn', 1.0f );

		parent.InternalSetSpeed( WALK_SPEED );
	}
	else
	{
		mac.SetEnabledFeetIK(true);
	}

	super.OnLeaveState( nextStateName );
}
*/


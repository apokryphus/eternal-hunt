@wrapMethod(QuenShield) function OnThrowing()
{
	var player							: CR4Player;
	var ent, ent_2, ent_3, ent_4 		: CEntity;
	var bone_vec, attach_vec, pPos		: Vector;
	var bone_rot, attach_rot			: EulerAngles;

	var inventory : CInventoryComponent;
	var item : SItemUniqueId;
	var i, k : int;
	var slots : array<EEquipmentSlots>;
	var electric_fist	: CACSElectricFist;

	wrappedMethod();

	player = caster.GetPlayer();

	if( super.OnThrowing() && player )
	{
		if (ACS_Armor_Set_Check('acs_armor', false)
		&& ACS_Settings_Main_Bool('acs_signs_settings','acs_quen_extra_effects_enabled', true)
		)
		{
			GetACSWatcher().Red_Blade_Projectile_AOE_Spawner();
		}

		if (ACS_Settings_Main_Bool('acs_signs_settings','acs_enhanced_quen_enabled', true))
		{
			ACSGetCEntity('ACS_Quen_Bubble').Destroy();
			
			ACSGetCEntity('ACS_Quen_Fx').Destroy();

			ACSGetCEntity('ACS_Sign_Icon').Destroy();

			ACSGetCEntity('ACS_Sign_Icon_Anchor').Destroy();

			ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
			"dlc\dlc_acs\data\fx\sign_icons.w2ent"
			, true ), GetWitcherPlayer().GetWorldPosition(), GetWitcherPlayer().GetWorldRotation() );

			ent_2 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
			"dlc\dlc_acs\data\fx\sign_icons.w2ent"
			, true ), GetWitcherPlayer().GetWorldPosition(), GetWitcherPlayer().GetWorldRotation() );

			GetWitcherPlayer().GetBoneWorldPositionAndRotationByIndex( GetWitcherPlayer().GetBoneIndex( 'l_handRoll' ), bone_vec, bone_rot );

			attach_rot.Roll = 0;
			attach_rot.Pitch = 0;
			attach_rot.Yaw = 0;
			attach_vec.X = 0.35;
			attach_vec.Y = 0.125;
			attach_vec.Z = 0;

			ent.CreateAttachmentAtBoneWS( GetWitcherPlayer(), 'l_handRoll', bone_vec, bone_rot );

			ent_2.CreateAttachment( ent, , attach_vec, attach_rot );

			if ((ACS_Armor_Set_Check('forgotten_wolf', false) 
			|| ACS_Armor_Set_Check('acs_armor', false)
			|| ACS_Armor_Set_Check('volhikar', false)
			|| thePlayer.HasTag('acs_vampire_claws_equipped')
			|| ACS_Vampire_Claws_Access()
			) && ACS_Settings_Main_Bool('acs_signs_settings','acs_quen_extra_effects_enabled', true)
			)
			{
				ent_2.PlayEffectSingle('quen_icon_red');

				ent_3 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
				"dlc\dlc_acs\data\fx\pc_quen_mq1060.w2ent"
				, true ), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );

				ent_3.CreateAttachment( thePlayer, , Vector( 0, 0, 0.75 ), EulerAngles(0,0,0) );

				ent_3.PlayEffect('default_fx');
				ent_3.DestroyAfter(0.5);


				ent_4 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
				"dlc\dlc_acs\data\fx\pc_quen_hit_mq1060.w2ent"
				, true ), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );

				ent_4.CreateAttachment( thePlayer, , Vector( 0, 0, 0.75 ), EulerAngles(0,0,0) );

				ent_4.PlayEffect('discharge');
				ent_4.DestroyAfter(3);
			}
			else
			{
				if (ACS_Is_DLC_Installed('dlcquen')
				|| ACS_Armor_Set_Check('acs_armor', false)
				|| ACS_Armor_Set_Check('wh_armor', false)
				|| ACS_Armor_Set_Check('eredin_armor', false)
				|| ACS_Armor_Set_Check('imlerith_armor', false)
				|| ACS_Armor_Set_Check('caranthir_armor', false)
				|| ACS_Armor_Set_Check('vgx_eredin_armor', false)
				)
				{
					ent_2.PlayEffectSingle('quen_icon_blue');

					ent_2.PlayEffectSingle('critical_aard');
				}
				else
				{
					ent_2.PlayEffectSingle('quen_icon');

					ent_2.PlayEffectSingle('critical_quen');
				}
			}

			if (!thePlayer.CanUseSkill(S_Magic_s04))
			{
				ent.DestroyAfter(0.5);
				ent_2.DestroyAfter(0.5);
			}

			ent.AddTag('ACS_Sign_Icon_Anchor');

			ent_2.AddTag('ACS_Sign_Icon');

			if (ACS_Settings_Main_Bool('acs_signs_settings','acs_quen_electric_discharge_enabled', true))
			{
				electric_fist = (CACSElectricFist)theGame.CreateEntity((CEntityTemplate)LoadResource("dlc\dlc_acs\data\fx\electric_fist\acs_electric_fist.w2ent",true), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation());

				electric_fist.CreateAttachment(thePlayer,, Vector( 0, 0, RandRangeF(1.5,1.25) ), EulerAngles(0,0,0));

				electric_fist.DestroyAfter(3);
			}
		}

		inventory = GetWitcherPlayer().inv;

		slots.PushBack(EES_SteelSword);
		slots.PushBack(EES_SilverSword);
		slots.PushBack(EES_Armor);
		slots.PushBack(EES_Gloves);
		slots.PushBack(EES_Pants);
		slots.PushBack(EES_Boots);
		
		for( k = 0; k < slots.Size(); k += 1 )
		{
			if( inventory.GetItemEquippedOnSlot(slots[k], item) )
			{
				if (inventory.GetItemDurability(item) < inventory.GetItemMaxDurability(item) * 0.5)
				{
					inventory.SetItemDurabilityScript( item, inventory.GetItemDurability(item) + (inventory.GetItemMaxDurability(item) - inventory.GetItemDurability(item)) * 0.25 );
				}
			}
		}
	}
}

@wrapMethod(QuenChanneled) function OnThrowing()
{
	var player							: CR4Player;
	var ent, ent_2, ent_3, ent_4 		: CEntity;
	var bone_vec, attach_vec, pPos		: Vector;
	var bone_rot, attach_rot			: EulerAngles;

	var inventory : CInventoryComponent;
	var item : SItemUniqueId;
	var i, k : int;
	var slots : array<EEquipmentSlots>;
	var electric_fist	: CACSElectricFist;

	
	wrappedMethod();

	player = caster.GetPlayer();
	
	if( super.OnThrowing() && player )
	{
		if (ACS_Armor_Set_Check('acs_armor', false)
		&& ACS_Settings_Main_Bool('acs_signs_settings','acs_quen_extra_effects_enabled', true)
		)
		{
			GetACSWatcher().Red_Blade_Projectile_AOE_Spawner();
		}

		if (ACS_Settings_Main_Bool('acs_signs_settings','acs_enhanced_quen_enabled', true))
		{
			ACSGetCEntity('ACS_Quen_Bubble').Destroy();

			ACSGetCEntity('ACS_Quen_Fx').Destroy();

			ACSGetCEntity('ACS_Sign_Icon').Destroy();

			ACSGetCEntity('ACS_Sign_Icon_Anchor').Destroy();

			ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
			"dlc\dlc_acs\data\fx\sign_icons.w2ent"
			, true ), GetWitcherPlayer().GetWorldPosition(), GetWitcherPlayer().GetWorldRotation() );

			ent_2 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
			"dlc\dlc_acs\data\fx\sign_icons.w2ent"
			, true ), GetWitcherPlayer().GetWorldPosition(), GetWitcherPlayer().GetWorldRotation() );

			GetWitcherPlayer().GetBoneWorldPositionAndRotationByIndex( GetWitcherPlayer().GetBoneIndex( 'l_handRoll' ), bone_vec, bone_rot );

			attach_rot.Roll = 0;
			attach_rot.Pitch = 0;
			attach_rot.Yaw = 0;
			attach_vec.X = 0.35;
			attach_vec.Y = 0.125;
			attach_vec.Z = 0;

			ent.CreateAttachmentAtBoneWS( GetWitcherPlayer(), 'l_handRoll', bone_vec, bone_rot );

			ent_2.CreateAttachment( ent, , attach_vec, attach_rot );

			if ((ACS_Armor_Set_Check('forgotten_wolf', false) 
			|| ACS_Armor_Set_Check('acs_armor', false)
			|| ACS_Armor_Set_Check('volhikar', false)
			|| thePlayer.HasTag('acs_vampire_claws_equipped')
			|| ACS_Vampire_Claws_Access()
			) && ACS_Settings_Main_Bool('acs_signs_settings','acs_quen_extra_effects_enabled', true)
			
			)
			{
				ent_2.PlayEffectSingle('quen_icon_red');

				if(!thePlayer.IsUsingHorse())
				{
					ent_3 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
					"dlc\dlc_acs\data\fx\pc_quen_mq1060.w2ent"
					, true ), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );
					
					ent_3.CreateAttachment( thePlayer, , Vector( 0, 0, 0.75 ), EulerAngles(0,0,0) );

					ent_3.PlayEffect('default_fx');
					//ent_3.DestroyAfter(0.5);

					ent_3.AddTag('ACS_Quen_Bubble');


					ent_4 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
					"dlc\dlc_acs\data\fx\pc_quen_hit_mq1060.w2ent"
					, true ), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );

					ent_4.CreateAttachment( thePlayer, , Vector( 0, 0, 0.75 ), EulerAngles(0,0,0) );

					ent_4.PlayEffect('discharge');
					//ent_4.DestroyAfter(3);

					ent_4.AddTag('ACS_Quen_Fx');
				}
			}
			else
			{
				if (ACS_Is_DLC_Installed('dlcquen')
				|| ACS_Armor_Set_Check('acs_armor', false)
				|| ACS_Armor_Set_Check('wh_armor', false)
				|| ACS_Armor_Set_Check('eredin_armor', false)
				|| ACS_Armor_Set_Check('imlerith_armor', false)
				|| ACS_Armor_Set_Check('caranthir_armor', false)
				|| ACS_Armor_Set_Check('vgx_eredin_armor', false)
				)
				{
					ent_2.PlayEffectSingle('quen_icon_blue');

					ent_2.PlayEffectSingle('critical_aard');
				}
				else
				{
					ent_2.PlayEffectSingle('quen_icon');

					ent_2.PlayEffectSingle('critical_quen');
				}
			}

			ent.AddTag('ACS_Sign_Icon_Anchor');

			ent_2.AddTag('ACS_Sign_Icon');

			if (ACS_Settings_Main_Bool('acs_signs_settings','acs_quen_electric_discharge_enabled', true))
			{
				electric_fist = (CACSElectricFist)theGame.CreateEntity((CEntityTemplate)LoadResource("dlc\dlc_acs\data\fx\electric_fist\acs_electric_fist.w2ent",true), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation());

				electric_fist.CreateAttachment(thePlayer,, Vector( 0, 0, RandRangeF(1.5,1.25) ), EulerAngles(0,0,0));

				electric_fist.DestroyAfter(3);
			}
		}

		
		inventory = GetWitcherPlayer().inv;

		slots.PushBack(EES_SteelSword);
		slots.PushBack(EES_SilverSword);
		slots.PushBack(EES_Armor);
		slots.PushBack(EES_Gloves);
		slots.PushBack(EES_Pants);
		slots.PushBack(EES_Boots);
		
		for( k = 0; k < slots.Size(); k += 1 )
		{
			if( inventory.GetItemEquippedOnSlot(slots[k], item) )
			{
				if (inventory.GetItemDurability(item) < inventory.GetItemMaxDurability(item))
				{
					inventory.SetItemDurabilityScript( item, inventory.GetItemDurability(item) + (inventory.GetItemMaxDurability(item) - inventory.GetItemDurability(item)) * 0.25 );
				}
			}
		}
	}
}

@wrapMethod(QuenChanneled) function OnEnded(optional isEnd : bool)
{
	wrappedMethod(isEnd);

	if (ACSGetCEntity('ACS_Quen_Bubble'))
	{
		ACSGetCEntity('ACS_Quen_Bubble').BreakAttachment(); 
		ACSGetCEntity('ACS_Quen_Bubble').Teleport( GetWitcherPlayer().GetWorldPosition() + Vector( 0, 0, -200 ) );
		ACSGetCEntity('ACS_Quen_Bubble').DestroyAfter(0.00125);
		ACSGetCEntity('ACS_Quen_Bubble').RemoveTag('ACS_Quen_Bubble');
	}
	
	if (ACSGetCEntity('ACS_Quen_Fx'))
	{
		ACSGetCEntity('ACS_Quen_Fx').BreakAttachment(); 
		ACSGetCEntity('ACS_Quen_Fx').Teleport( GetWitcherPlayer().GetWorldPosition() + Vector( 0, 0, -200 ) );
		ACSGetCEntity('ACS_Quen_Fx').DestroyAfter(0.00125);
		ACSGetCEntity('ACS_Quen_Fx').RemoveTag('ACS_Quen_Fx');
	}
}


// Finisher Delays

@addMethod( CNewNPC ) timer function ACS_Finisher_Igni_Delay( dt : float, id : int )
{
	var signIconEnt							: CEntity;
	var torsoBoneIndex						: int;
	var pos 								: Vector;

	var actors		    					: array<CActor>;
	var i 									: int;
	var params 								: SCustomEffectParams;

	torsoBoneIndex = ((CActor)this).GetTorsoBoneIndex();

	if ( torsoBoneIndex != -1 )
	{
		pos = MatrixGetTranslation( ((CActor)this).GetBoneWorldMatrixByIndex( torsoBoneIndex ) );
	}
	else
	{
		pos = this.GetWorldPosition();
	}

	ACS_Human_Death_Explode(this, this.GetWorldPosition(), 0.1f);

	signIconEnt = theGame.CreateEntity( (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\fx\sign_icons.w2ent", true ), pos );
	signIconEnt.DestroyAfter(1.5);

	signIconEnt.PlayEffect('igni_icon');

	signIconEnt.PlayEffect('critical_igni');

	signIconEnt.PlayEffect('mutation_2_igni');

	if ( !theSound.SoundIsBankLoaded("sign_igni.bnk") )
	{
		theSound.SoundLoadBank( "sign_igni.bnk", false );
	}

	signIconEnt.SoundEvent("sign_igni_charge_concentrate");
	signIconEnt.SoundEvent("fx_rune_activate_igni");

	this.DestroyEffect('critical_burning');

	this.PlayEffect('critical_burning');

	ACSCreateBurningFX(this);

	RemoveTimer('ACS_Critical_Burning_Remove_Delay');

	AddTimer('ACS_Critical_Burning_Remove_Delay', 300 , false );
	
	actors.Clear();

	actors = thePlayer.GetNPCsAndPlayersInCone(4, VecHeading(thePlayer.GetHeadingVector()), 60, 20, , FLAG_OnlyAliveActors + FLAG_Attitude_Hostile + FLAG_ExcludePlayer );

	if( actors.Size() > 0 )
	{
		if (thePlayer.GetStat(BCS_Focus) >= thePlayer.GetStatMax( BCS_Focus ) * 0.33)
		{
			thePlayer.DrainFocus(thePlayer.GetStatMax( BCS_Focus ) * 0.33);

			for (i = 0; i < actors.Size(); i += 1) 
			{
				params.effectType = EET_Burning;
				params.creator = thePlayer;
				params.sourceName = "ACS_Igni_Finisher";
				params.duration = 3;

				(((CNewNPC)actors[i])).AddEffectCustom( params );	
			}
		}
	}
}

@addMethod( CNewNPC ) timer function ACS_Finisher_Aard_Delay( dt : float, id : int )
{
	var signIconEnt, vfxEnt					: CEntity;
	var tmpBool 							: bool;
	var mc 									: EMonsterCategory;
	var tmpName 							: name;
	var torsoBoneIndex						: int;
	var pos 								: Vector;

	var actors		    					: array<CActor>;
	var i 									: int;
	var params 								: SCustomEffectParams;

	if (((CMovingPhysicalAgentComponent)(GetMovingAgentComponent())).GetCapsuleHeight() >= 2
	|| GetRadius() >= 0.7
	|| HasAbility('Boss')
	|| HasTag('IsBoss')
	|| HasTag('ACS_Big_Boi')
	)
	{
		
	}
	else
	{
		this.SetVisibility(false);
	}

	theSound.SoundEvent("cmb_play_dismemberment_gore");

	theSound.SoundEvent("fx_rune_activate_aard");

	theSound.SoundEvent("sign_aard_blast");

	torsoBoneIndex = ((CActor)this).GetTorsoBoneIndex();

	if ( torsoBoneIndex != -1 )
	{
		pos = MatrixGetTranslation( ((CActor)this).GetBoneWorldMatrixByIndex( torsoBoneIndex ) );
	}
	else
	{
		pos = this.GetWorldPosition() + Vector(0,0,1.5);

}

@addMethod( CNewNPC ) timer function ACS_AddParalyzedDelay( dt : float, id : int )
{
	var params																		: SCustomEffectParams;
	var duration 																	: float;
	var vfxEnt																		: CEntity;
	var dmg																			: W3DamageAction;

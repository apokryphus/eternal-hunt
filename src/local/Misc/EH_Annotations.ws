@wrapMethod(CR4MapMenu) function OnStaticMapPinUsed( pinTag : name, areaId : int )
{
	var initData : W3MapInitData;
	var manager	: CCommonMapManager = theGame.GetCommonMapManager();
	var fastTravelEntity : W3FastTravelEntity;
	var loadingInitData : W3MenuInitData;
	var contentTag : name;
	var progress : float;
	var rootMenu : CR4Menu;

	if (false)
	{
		wrappedMethod( pinTag, areaId );
	}

	manager	= theGame.GetCommonMapManager();
	if ( !manager )
	{
		return false;
	}
	
	if ( !manager.IsWorldAvailable( areaId ) )
	{
		contentTag = manager.GetWorldContentTag( areaId );
		progress = theGame.ProgressToContentAvailable(contentTag);
		theSound.SoundEvent("gui_global_denied");
		theGame.GetGuiManager().ShowProgressDialog(0, "", "panel_map_cannot_travel_downloading_content", true, UDB_Ok, progress, UMPT_Content, contentTag);
		return false;
	}

	if( !thePlayer.IsActionAllowed( EIAB_FastTravel ) )
	{
		showNotification( GetLocStringByKeyExt("panel_hud_message_actionnotallowed") );
		OnPlaySoundEvent("gui_global_denied");
		return false;
	}

	if ( m_currentArea != areaId )
	{
		if ( !thePlayer.IsActionAllowed( EIAB_FastTravelGlobal ) )
		{
			theSound.SoundEvent("gui_global_denied");
			showNotification( GetLocStringByKeyExt("panel_hud_message_actionnotallowed") );
			return false;
		}
	}

	if ( manager.IsEntityMapPinDisabled( pinTag ) )
	{
		theSound.SoundEvent("gui_global_denied");
		showNotification( GetLocStringByKeyExt("panel_hud_message_actionnotallowed") );
		return false;
	}

	if ( !manager.DBG_IsAllowedFT() )
	{
		if ( thePlayer.IsSailing() )
		{
			
			initData = (W3MapInitData)GetMenuInitData();
			if ( initData && initData.GetTriggeredExitEntity() )
			{
				
				initData.SetTriggeredExitEntity( false );
			}
		}
		else
		{
			initData = (W3MapInitData)GetMenuInitData();
			if ( !initData )
			{
				showNotification( GetLocStringByKeyExt("panel_map_cannot_travel") );
				OnPlaySoundEvent("gui_global_denied");
				return false;
			}
			fastTravelEntity = (W3FastTravelEntity)initData.GetUsedFastTravelEntity();
			if (fastTravelEntity && fastTravelEntity.entityName == pinTag)
			{
				showNotification( GetLocStringByKeyExt("panel_map_cannot_travel_already_here") );
				OnPlaySoundEvent("gui_global_denied");
				return false;
			}
			if ( initData.GetTriggeredExitEntity() )
			{
				
				initData.SetTriggeredExitEntity( false );
			}
		}
	}
	
	manager.UseMapPin( pinTag, true );
	
	
	if (areaId == -1)
	{
		areaId == m_shownArea;
	}
	
	if ( m_currentArea == areaId )
	{
		manager.PerformLocalFastTravelTeleport( pinTag );
		theGame.Unpause("menus");
		if ( !theGame.IsGameTimePaused() )
		{
			//theGame.SetGameTime( theGame.GetGameTime() + GameTimeCreate(0, RoundF( RandF() * 4 ), RoundF( RandF() * 60 ), RoundF( RandF() * 60 ) ), true);
		}
	}
	else
	{
		manager.PerformGlobalFastTravelTeleport( m_shownArea, pinTag );
		theGame.Unpause("menus");
		if ( !theGame.IsGameTimePaused() )
		{
			theGame.SetGameTime( theGame.GetGameTime() + GameTimeCreate(0, RoundF( RandF() * 10 ), RoundF( RandF() * 60 ), RoundF( RandF() * 60 ) ), true);
		}
	}
	
	rootMenu = theGame.GetGuiManager().GetRootMenu();
	if ( rootMenu )
	{
		rootMenu.CloseMenu();
	}
	return true;
}

@wrapMethod( CCommonMapManager ) function PerformLocalFastTravelTeleport( destinationPinTag : name )
{
	var position : Vector;
	var rotation : EulerAngles;
	var contextName : name;
	var dummycomp	: CEntity; 

	if (false)
	{
		wrappedMethod(destinationPinTag);
	}

	if ( GetLocalFastTravelPointPosition( destinationPinTag, !thePlayer.IsSailing(), position, rotation ) )
	{
		//contextName = theGame.GetCommonMapManager().GetLocalisationNameFromAreaType( GetCurrentJournalAreaByPosition( position ) );
		//theGame.SetSingleShotLoadingScreen( contextName );

		rotation.Roll = 0.f;
		rotation.Pitch = 0.f;

		ACSGetCEntity('ACS_Fast_Travel_Marker').Destroy();

		if (ACS_Settings_Main_Bool('acs_misc_main_settings','acs_fast_travel_camera_enabled', false))
		{
			dummycomp = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource("dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent",true ), position, rotation );
			dummycomp.AddTag('ACS_Fast_Travel_Marker');

			GetACSWatcher().FastTravelCameraStart(destinationPinTag, position, rotation);
		}
		else
		{
			FactsRemove("ACS_Fast_Travel_Initiated");

			thePlayer.TeleportWithRotation( position, rotation );
		}
		
		UseMapPin( destinationPinTag, false ); 
		
		theGame.RequestAutoSave( "fast travel", true );
	}
	
	if ( GetLocalFastTravelPointPosition( destinationPinTag, !thePlayer.IsSailing(), position, rotation ) 
	&& !thePlayer.IsSailing()
	)
	{
		GetWitcherPlayer().ACSFastTravelMount();
	}

	if (GetACSWatcher().steel_scabbard_hidden
	|| GetACSWatcher().silver_scabbard_hidden
	|| GetACSWatcher().steel_sword_hidden
	|| GetACSWatcher().silver_sword_hidden
	|| GetACSWatcher().crossbow_hidden
	)
	{
		GetACSWatcher().RemoveTimer('SetScabbardFlag');
		GetACSWatcher().AddTimer('SetScabbardFlag', 0.125 , false );
	}
}

@wrapMethod( CCommonMapManager ) function PerformGlobalFastTravelTeleport( destinationArea : int, destinationPinTag : name )
{
	var worldPath : string;
	var position : Vector;
	var rotation : EulerAngles;

	if (false)
	{
		wrappedMethod(destinationArea, destinationPinTag);
	}

	m_destinationPinTag = destinationPinTag;

	worldPath = GetWorldPathFromAreaType( destinationArea );

	if ( StrLen( worldPath ) > 0 
	&& !thePlayer.IsSailing()
	&& worldPath != "levels\wyzima_castle\wyzima_castle.w2w"
	&& worldPath != "levels\the_spiral\spiral.w2w"
	)
	{
		if (FactsQuerySum("ACS_Fast_Travel_With_Horse") <= 0)
		{
			FactsAdd("ACS_Fast_Travel_With_Horse", 1, -1);
		}
	}

	if (GetACSWatcher().steel_scabbard_hidden
	|| GetACSWatcher().silver_scabbard_hidden
	|| GetACSWatcher().steel_sword_hidden
	|| GetACSWatcher().silver_sword_hidden
	|| GetACSWatcher().crossbow_hidden
	)
	{
		GetACSWatcher().RemoveTimer('SetScabbardFlag');
		GetACSWatcher().AddTimer('SetScabbardFlag', 0.125 , false );
	}

	if ( StrLen( worldPath ) > 0 )
	{
		if ( GetFastTravelPointPosition( worldPath, destinationPinTag, !thePlayer.IsSailing(), position, rotation ) )
		{
			m_lastGlobalFastTravelArea = destinationArea;
			m_lastGlobalFastTravelPosition = position;

			if (ACS_Settings_Main_Bool('acs_misc_main_settings','acs_fast_travel_camera_enabled', false)
			&& theGame.GetWorld().GetDepotPath() != "levels\wyzima_castle\wyzima_castle.w2w"
			)
			{
				GetACSWatcher().GlobalFastTravelCameraStart(worldPath, position, rotation , , true);
			}
			else
			{
				theGame.ScheduleWorldChangeToPosition( worldPath, position, rotation );
			}
		}
		else
		{
			if (ACS_Settings_Main_Bool('acs_misc_main_settings','acs_fast_travel_camera_enabled', false)
			&& theGame.GetWorld().GetDepotPath() != "levels\wyzima_castle\wyzima_castle.w2w"
			)
			{
				GetACSWatcher().GlobalFastTravelCameraStart(worldPath, , , destinationPinTag, false);
			}
			else
			{
				theGame.ScheduleWorldChangeToMapPin( worldPath, destinationPinTag );
			}
		}
		
		theGame.RequestAutoSave( "fast travel", true ); 
	}
}

////////////////////////////////////////////////////////////////////////////////

// Credits
//- Based upon code taken from the menu descriptor shared util module by Aeltoth.
//- The discovery of the events this bastardized piece of code relies on was made by [MrCementKnight](https://next.nexusmods.com/profile/MrCementKnight?gameId=952).

@addMethod(CR4IngameMenu) function ACS_displayMessage(message: string, optional current_menu: string, optional optionName : name) 
{
 	var duration						: float = -1;
	var msg								: W3TutorialPopupData;

	if (message == "") 
	{
		if (this.acs_menu_message_fallback_cache != "") 
		{
			message = this.acs_menu_message_fallback_cache;
		}
	}

	if (message == this.acs_menu_message_cache) 
	{
		return;
	}

	this.acs_menu_message_cache = message;

	if (message == "") 
	{
		duration = 0;
	}

	msg = new W3TutorialPopupData in theGame;

	msg.managerRef = theGame.GetTutorialSystem();

	msg.canBeShownInMenus = true;

	msg.scriptTag = 'ACS';

	msg.messageTitle = GetLocStringByKeyExt("panel_" + current_menu);

	msg.duration = duration;

	if (StrContains( NameToString(optionName), "tutorial" ) 
	|| StrContains( NameToString(optionName), "bestiary" ) 
	|| StrContains( NameToString(optionName), "overview" ) 
	)
	{
		message = "<font size = '20' color = '#000000'>" + message + "</font>";

		if (StrContains( NameToString(optionName), "vampire_ring" ) 
		|| StrContains( NameToString(optionName), "transformation_werewolf" ) 
		|| StrContains( NameToString(optionName), "acs_horse_controls_tutorial" ) 
		|| StrContains( NameToString(optionName), "acs_elemental_combo_system_tutorial" ) 
		|| StrContains( NameToString(optionName), "acs_rage_system_tutorial" ) 
		|| StrContains( NameToString(optionName), "acs_bullvore_bestiary" ) 
		)
		{
			msg.posX = 0.55f;

			msg.posY = 0.05f;
		}
		else
		{
			msg.posX = 0.55f;

			msg.posY = 0.25f;
		}
	}
	else
	{
		msg.posX = 0;

		msg.posY = 0;
	}

	msg.messageText = "<p align=\"center\">" + "<b><u><mark>" + GetLocStringByKeyExt("option_" + NameToString(optionName)) + "</mark></u></b>" + "<br/><br/>" + message + "</p>";

	theGame.GetTutorialSystem().ShowTutorialHint(msg);

	if (message == "") 
	{
		msg.CloseTutorialPopup();
	}
}

@addField(CR4IngameMenu)
var acs_menu_descriptors: array<ACS_MenuDescriptor>;

@addField(CR4IngameMenu)
var acs_menu_stack: array<string>;

@addField(CR4IngameMenu)
var acs_menu_message_cache: string;

@addField(CR4IngameMenu)
var acs_menu_message_fallback_cache: string;

@addField(CR4IngameMenu)
var acs_menu_hovered_option: name;

@addField(CR4IngameMenu)
var acs_menu_hovered_out_count: int;

@wrapMethod(CR4IngameMenu) function OnShowOptionSubmenu(actionType: int, menuTag: int, id: string) 
{
	var descriptor				: ACS_MenuDescriptor;
	var message_fallback		: string;
	var previous_size			: int;

	previous_size = this.acs_menu_descriptors.Size();

	this.ACS_onMenuEntered(id, this.acs_menu_descriptors);

	for (previous_size; previous_size < this.acs_menu_descriptors.Size(); previous_size += 1) 
	{
		descriptor = this.acs_menu_descriptors[previous_size];

		if (descriptor) 
		{
			descriptor.enteredAt(id);

			descriptor.Main();
		}
	}

	this.acs_menu_stack.PushBack(id);

	for (previous_size = 0; previous_size < this.acs_menu_descriptors.Size(); previous_size += 1) 
	{
		descriptor = this.acs_menu_descriptors[previous_size];

		if (descriptor) 
		{
			message_fallback += descriptor.getMessageFallback();
		}
	}

	this.acs_menu_message_fallback_cache = message_fallback;

	this.ACS_displayMessage(message_fallback);

	return wrappedMethod(actionType, menuTag, id);
}

@wrapMethod(CR4IngameMenu) function OnOptionPanelNavigateBack() 
{
	var descriptor			: ACS_MenuDescriptor;
	var should_remove		: bool;
	var menu_left			: string;
	var i					: int;

	this.acs_menu_hovered_out_count = 0;

	this.acs_menu_hovered_option = '';

	this.acs_menu_message_fallback_cache = "";

	this.ACS_displayMessage("");

	menu_left = this.acs_menu_stack.PopBack();

	for (i = 0; i < this.acs_menu_descriptors.Size(); i += 1) 
	{
		descriptor = this.acs_menu_descriptors[i];

		should_remove = true;

		if (descriptor) 
		{
			should_remove = descriptor.didEnterAt(menu_left);
		}

		if (should_remove) 
		{
			this.acs_menu_descriptors.Erase(i);

			i -= 1;
		}
	}

	return wrappedMethod();
}

@wrapMethod(CR4IngameMenu) function OnOptionSelectionChanged(optionName: name, value: bool) 
{
	var descriptor				: ACS_MenuDescriptor;
	var current_menu			: string;
	var message					: string;
	var result					: bool;
	var i						: int;

	result = wrappedMethod(optionName, value);

	if (!value) 
	{
		if (optionName == this.acs_menu_hovered_option || this.acs_menu_hovered_out_count > 15) 
		{
			this.ACS_displayMessage("");
			return result;
		}

		this.acs_menu_hovered_out_count += 1;

		optionName = this.acs_menu_hovered_option;

		value = true;
	}
	else 
	{
		this.acs_menu_hovered_out_count = 0;
		this.acs_menu_hovered_option = optionName;
	}

	current_menu = this.acs_menu_stack.Last();

	for (i = 0; i < this.acs_menu_descriptors.Size(); i += 1) 
	{
		descriptor = this.acs_menu_descriptors[i];

		message += descriptor.onOptionHovered(current_menu, optionName);
	}

	this.ACS_displayMessage(message, current_menu, optionName);

	return result;
}

@wrapMethod(CR4IngameMenu) function OnOptionValueChanged( groupId: int, optionName: name, optionValue: string) 
{ 
	var descriptor				: ACS_MenuDescriptor;
	var current_menu			: string;
	var message					: string;
	var result					: bool;
	var i						: int;

	result = wrappedMethod(groupId, optionName, optionValue);

	current_menu = this.acs_menu_stack.Last();

	for (i = 0; i < this.acs_menu_descriptors.Size(); i += 1) 
	{
		descriptor = this.acs_menu_descriptors[i];

		message += descriptor.onOptionValueChanged(current_menu, optionName);
	}

	if (message != "") 
	{
		this.ACS_displayMessage(message, current_menu, optionName);
	}

	return result;
}


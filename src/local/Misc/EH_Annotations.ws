@wrapMethod(CR4LootPopup) function OnPopupTakeItem( Id : int ) : void
{
	if (ACS_Settings_Main_Bool('acs_container_settings','acs_looting_anim_enabled', true)
	&& theGame.IsDialogOrCutscenePlaying() 
	&& thePlayer.IsAlive()
	&& thePlayer.IsInCutsceneIntro()
	&& theGame.HasBlackscreenRequested()
	&& theGame.IsCurrentlyPlayingNonGameplayScene()
	&& theGame.GetGuiManager().IsAnyMenu()
	&& theGame.GetTutorialSystem().HasActiveTutorial()
	&& theGame.GetPhotomodeEnabled() 
	)
	{
		thePlayer.RaiseEvent('ACS_CombatTauntEnd');

		thePlayer.RaiseEvent('ACS_IdleAdditiveReset');

		if( (thePlayer.IsAnyWeaponHeld() && !thePlayer.IsWeaponHeld('fist')) 
		|| thePlayer.GetWeaponHolster().IsOnTheMiddleOfHolstering() 
		)
		{
			if (thePlayer.IsHoldingItemInLHand() )
			{
				
			}
			else
			{
				thePlayer.RaiseEvent('ACS_LootWithWeapon');
			}
		}
		else
		{
			if (thePlayer.IsHoldingItemInLHand() 
			|| theGame.IsFocusModeActive()
			|| theInput.GetActionValue('Focus') > 0.1f
			)
			{
				thePlayer.RaiseEvent('ACS_Loot');
			}
			else
			{
				if (FactsQuerySum("ACS_Loot_Anim_Played") <= 0 )
				{
					thePlayer.RaiseEvent('ACS_Loot');

					GetACSWatcher().CreateLootItemsInHand('default', 'r_hand');

					FactsAdd("ACS_Loot_Anim_Played", 1, -1);
				}
				else if (FactsQuerySum("ACS_Loot_Anim_Played") > 0 )
				{
					thePlayer.RaiseEvent('ACS_LootWithWeapon');

					GetACSWatcher().CreateLootItemsInHand('default', 'l_hand');

					FactsRemove("ACS_Loot_Anim_Played");
				}
			}
		}

		if (GetWitcherPlayer().IsUsingHorse()) 
		{
			if (RandF() < 0.25)
			{
				thePlayer.RaiseEvent('ACS_HorseLootTorsoBendL');
			}
			else
			{
				thePlayer.RaiseEvent('ACS_HorseLootTorsoBendR');
			}
		} 
	}

	wrappedMethod(Id);
}

@wrapMethod(CR4LootPopup) function OnCloseLootWindow()
{
	if( FactsQuerySum("ACS_Player_In_Container_Loot_Anim_Mid") > 0)
	{
		thePlayer.PlayerStopAction( PEA_InspectMid );

		FactsRemove("ACS_Player_In_Container_Loot_Anim_Mid");
	}

	if( FactsQuerySum("ACS_Player_In_Container_Loot_Anim_Low") > 0)
	{
		thePlayer.PlayerStopAction( PEA_InspectLow );

		FactsRemove("ACS_Player_In_Container_Loot_Anim_Low");
	}

	wrappedMethod();
}

@addMethod(CActor) function ACS_SetAnimationSpeedMultiplier( mul : float, optional overrideExistingId : int ) : int
{
	var causer : SAnimMultiplyCauser;
	var finalMul : float;
	var i,size : int;

	if( overrideExistingId != -1 )
	{
		size = animationMultiplierCausers.Size();

		for( i = 0; i < size; i += 1 )
		{
			if( animationMultiplierCausers[i].id == overrideExistingId )
			{
				animationMultiplierCausers[i].mul = mul;
				SetAnimationTimeMultiplier( ACS_CalculateFinalAnimationSpeedMultiplier() );
				return animationMultiplierCausers[i].id;
			}
		}
	}
		
	
	causer.mul = mul;
	causer.id = nextFreeAnimMultCauserId;
	
	nextFreeAnimMultCauserId += 1;
	
	animationMultiplierCausers.PushBack( causer );
			
	
	SetAnimationTimeMultiplier( ACS_CalculateFinalAnimationSpeedMultiplier() );
	
	return causer.id;
}

@addMethod(CAnimatedComponent) function ACS_SetAnimationSpeedMultiplier(mul : float) : int
{
	var causer : SAnimMultiplyCauser;
	var finalMul : float;
			
	
	causer.mul = mul;
	causer.id = nextFreeAnimMultCauserId;
	
	nextFreeAnimMultCauserId += 1;
	
	animationMultiplierCausers.PushBack(causer);
			
	
	SetAnimationTimeMultiplier(ACS_CalculateFinalAnimationSpeedMultiplier());
	
	return causer.id;
}

@addMethod(CAnimatedComponent) function ACS_CalculateFinalAnimationSpeedMultiplier() : float
{
	if(animationMultiplierCausers.Size() > 0)
	{
		return animationMultiplierCausers[animationMultiplierCausers.Size()-1].mul;
	}
	
	return 1;
}

@addMethod(CActor) function ACS_ClearAnimationSpeedMultipliers()
{
	animationMultiplierCausers.Clear();
	SetAnimationTimeMultiplier( 1.0f );
}

@addMethod( CActor) function ACS_CalculateFinalAnimationSpeedMultiplier() : float
{
	if(animationMultiplierCausers.Size() > 0)
		return animationMultiplierCausers[animationMultiplierCausers.Size()-1].mul;
	
	return 1;
}

@wrapMethod(CExplorationStateClimb) function SetProperCameraAnim( reset : bool, speed : float )
{
	if(false) 
	{
		wrappedMethod(reset, speed);
	}

	return;
}
		

@wrapMethod(CExplorationStateClimb) function StateEnterSpecific( prevStateName : name )	
{		
	if(false) 
	{
		wrappedMethod(prevStateName);
	}

	if( prevStateName == 'Swim' )
	{
		thePlayer.GotoState('Exploration');
	}
	
	SetInitialMovementAdjustor();
	
	
	m_ExplorationO.m_MoverO.SetManualMovement( true );

	thePlayer.RemoveTimer( 'DelayedSheathSword' );
	
	
	thePlayer.SetBehaviorVariable( 'inJumpState', 1.f );
	
	
	thePlayer.OnRangedForceHolster( true, true );
	
	
	pelvisTransCur		= 0.0f;
	pelvisTransState	= EOCS_Inactive;
	
	
	SetBehaviorData();
	
	
	camStart	= true;
	
	SetProperCameraAnim( true, 1.0f );
	
	
	if( m_ExplorationO.m_IsDebugModeB )
	{			
		DebugLogSuccesfullClimb();
	}
	
	
	canFall					= false;
	ended					= false;
	canWalk					= false;
	adjustInitialRotDone	= false;
	canRun					= false;
	
	adjustRotDone			= false;	
	adjustTransDone			= false;	
	
	
	m_ExplorationO.m_OwnerMAC.SetEnabledFeetIK( false );
	
	leftHandOffset			= 0.0f;
	rightHandOffset			= 0.0f;
	rightHandOffsetCur		= 0.0f;
	leftHandOffsetCur		= 0.0f;
	handIKEnabled			= false;
	handIKEnabledLeft 		= false;
	handIKEnabledRight		= false;
	handIKqueuedL			= false;
	handIKqueuedR			= false;
	
	m_ExplorationO.m_OwnerMAC.SetHandsIKOffsets( leftHandOffsetCur, rightHandOffsetCur );
	
	adjust2Dduration		= 0.0f;	
	
	thePlayer.AbortSign();
}

@wrapMethod(CExplorationStateClimb) function UpdateCameraIfNeeded( out moveData : SCameraMovementData, dt : float ) : bool
{
	var blend			: float;
	var targetPos		: Vector;
	var position		: Vector;
	var rotation		: EulerAngles;
	var positionDesired	: Vector;
	var rotationDesired	: EulerAngles;
	var inputX			: float;
	var inputY			: float;
	var camera								: CCustomCamera;
	var cameraPreset						: SCustomCameraPreset;
	
	camera = (CCustomCamera)theCamera.GetTopmostCameraObject();
	cameraPreset = camera.GetActivePreset();

	camera.ChangePivotDistanceController( 'Default' );
	camera.ChangePivotPositionController( 'Default' );
	
	moveData.pivotDistanceController = camera.GetActivePivotDistanceController();
	moveData.pivotPositionController = camera.GetActivePivotPositionController();

	moveData.pivotDistanceController.SetDesiredDistance(cameraPreset.distance + 5.0f);
	moveData.pivotPositionController.SetDesiredPosition(GetWitcherPlayer().GetWorldPosition());
	moveData.pivotPositionController.offsetZ = -0.5f;

	return true;

	if (false)
	{
		wrappedMethod(moveData, dt);
	}
	
	if( !updateCameraManual )
	{
		return false;
	}
	
	
	targetPos		= m_ExplorationO.m_OwnerE.GetBoneWorldPositionByIndex( camFollowBoneID );
	rotationDesired	= m_ExplorationO.m_OwnerE.GetWorldRotation();
	
	
	if( camStart == true )
	{
		
		camOriginalPosition = moveData.pivotPositionValue;
		camOriginalRotation	= moveData.pivotRotationValue;
		camCurRotation		= rotationDesired;
		camOriginalOffset	= moveData.cameraLocalSpaceOffset;
		camStart			= false;
	}
	
	
	inputX							= theInput.GetActionValue( 'GI_AxisRightX' );
	inputY							= theInput.GetActionValue( 'GI_AxisRightY' );
	camCurRotation.Yaw				= camCurRotation.Yaw - inputX * dt * 200.0f;
	camCurRotation.Pitch			= ClampF( camCurRotation.Pitch + inputY * dt * 100.0f, -45.0f, 45.0f );
	
	
	camOriginalRotation.Yaw			= LerpAngleF( dt * 5.0f, camOriginalRotation.Yaw, camCurRotation.Yaw );
	camOriginalRotation.Pitch		= LerpAngleF( dt * 5.0f, camOriginalRotation.Pitch, camCurRotation.Pitch );
	
	positionDesired					= targetPos - m_ExplorationO.GetWorldForward() * 0.8f + m_ExplorationO.m_OwnerE.GetWorldUp() * 0.8f;
	camOriginalPosition				= LerpV( camOriginalPosition, positionDesired, dt * 2.0f );
	
	
	moveData.pivotPositionValue		= camOriginalPosition;
	moveData.pivotRotationValue		= camOriginalRotation;
	moveData.cameraLocalSpaceOffset	= camOriginalOffset;
	moveData.pivotPositionVelocity	= Vector( 0.0f, 0.0f, 0.0f );
	moveData.pivotRotationVelocity	= EulerAngles( 0.0f, 0.0f, 0.0f );
	
	return true;
}
	

@wrapMethod(CExplorationStateClimb) function InputWantsToEnter() : bool
{
	var originPositionCheck												: Vector;
	var logFailsCheck													: bool;
	var	distanceTypeCheck												: EClimbDistanceType;
	var	requireInputDirCheck 											: bool;
	var	climbPointCheck													: Vector;
	var	wallNormalCheck													: Vector;
	var	heightTargetCheck												: float;
	var	vaultingFoundCheck												: EClimbRequirementVault;
	var platformFoundCheck												: EClimbRequirementPlatform;
	var curPlayerStateTypeCheck											: EClimbRequirementType;
	var	vaultEndsFallingCheck											: bool;
	var	inputAttemptsTopCheck											: bool;
	var	inputDirectionCheck												: Vector;
	var cameraAngle 													: Vector;
	var tempEndPoint_1, normal_1, startPos, endPos						: Vector;
	var collisionGroupsNames											: array<name>;	
	var comp_1															: CComponent;
	var material_1														: name;
	var l_destructibleCmp												: CDestructionSystemComponent;	
	var params 															: SCustomEffectParams;
	var ragdollDuration													: float;

	//return wrappedMethod();
				
	if (thePlayer.IsActionAllowed(EIAB_Movement)
	&& ACS_Settings_Main_Bool('acs_movement_main_settings','acs_auto_climb_enabled', true)
	)
	{
		if ((theInput.GetActionValue('GI_AxisLeftX') != 0
		|| theInput.GetActionValue('GI_AxisLeftY') != 0)
		&& !thePlayer.IsInsideInteraction()
		//&& OracleWantsToEnter()
		)
		{
			inputAttemptsTopCheck	= !thePlayer.GetIsRunning(); 
		
			if( m_ExplorationO.m_InputO.IsModuleConsiderable() )
			{
				inputDirectionCheck	= m_ExplorationO.m_InputO.GetMovementOnPlaneNormalizedV();
			}
			else
			{		
				inputDirectionCheck	= m_ExplorationO.m_OwnerE.GetWorldForward();
			}

			originPositionCheck	= m_ExplorationO.m_OwnerE.GetWorldPosition();
			
			distanceTypeCheck	= GetDistanceType();
			
			requireInputDirCheck		= m_ExplorationO.m_InputO.IsModuleConsiderable();
			
			m_ClimbOracleO.ComputeAll( inputAttemptsTopCheck, originPositionCheck, inputDirectionCheck, distanceTypeCheck, requireInputDirCheck, logFailsCheck );
			
			if( m_ClimbOracleO.CanWeClimb() )
			{
				m_ClimbOracleO.GetClimbData( heightTargetCheck, vaultingFoundCheck, vaultEndsFallingCheck, platformFoundCheck, climbPointCheck, wallNormalCheck );
			}

			startPos = thePlayer.GetWorldPosition();

			endPos = TraceFloor(thePlayer.GetWorldPosition() + thePlayer.GetHeadingVector() * 2);

			if (thePlayer.GetIsSprinting()
			|| ACS_Armor_Set_Check('acs_armor', false)
			)
			{
				collisionGroupsNames.Clear();

				//collisionGroupsNames.PushBack( 'Terrain');
				collisionGroupsNames.PushBack( 'Static');
				collisionGroupsNames.PushBack( 'Dynamic');
				collisionGroupsNames.PushBack( 'Fence' );
				//collisionGroupsNames.PushBack( 'Water'); 
				collisionGroupsNames.PushBack( 'Door' );
				collisionGroupsNames.PushBack( 'Dangles' );
				collisionGroupsNames.PushBack( 'Foliage' );
				collisionGroupsNames.PushBack( 'Debris' );
				collisionGroupsNames.PushBack( 'Destructible' );
				//collisionGroupsNames.PushBack( 'RigidBody' );
				//collisionGroupsNames.PushBack( 'Boat' );
				//collisionGroupsNames.PushBack( 'BoatDocking' );
				//collisionGroupsNames.PushBack('BoatSide');
				//collisionGroupsNames.PushBack( 'Platforms' );
				collisionGroupsNames.PushBack( 'Corpse' );
				collisionGroupsNames.PushBack( 'Projectile' );
				collisionGroupsNames.PushBack( 'ParticleCollider' ); 
				collisionGroupsNames.PushBack( 'Ragdoll' ); 

				if( theGame.GetWorld().StaticTraceWithAdditionalInfo( startPos, endPos, tempEndPoint_1, normal_1, material_1, comp_1, collisionGroupsNames ) 
				&& comp_1 
				)
				{
					l_destructibleCmp = (CDestructionSystemComponent) comp_1;

					if (l_destructibleCmp)
					{
						l_destructibleCmp.ApplyFracture();

						if (FactsQuerySum("ACS_TorsoBendActive") > 0)
						{
							if (!GetACSWatcher().fast_sprint_activated)
							{
								thePlayer.RaiseEvent('ACS_TorsoBendReset');
							}
							
							FactsRemove("ACS_TorsoBendActive");
						}
					}
				}
			}

			if (heightTargetCheck != 0
			)
			{
				if (FactsQuerySum("ACS_TorsoBendActive") > 0)
				{
					if (!GetACSWatcher().fast_sprint_activated)
					{
						thePlayer.RaiseEvent('ACS_TorsoBendReset');
					}
					
					FactsRemove("ACS_TorsoBendActive");
				}
				
				if (((thePlayer.HasBuff(EET_Drunkenness) && thePlayer.GetStat(BCS_Toxicity) >= thePlayer.GetStatMax(BCS_Toxicity) * 0.33 )
				|| thePlayer.HasTag('ACS_TalkingAnimalsEnabled'))
				&& !(GetACSWatcher().drunkenessRagdollCheck)
				&& thePlayer.GetMovingAgentComponent().GetSpeed() > 0 
				)
				{
					GetACSWatcher().ResetFastWalk();
					
					thePlayer.BlockAllActions( 'ACS_Drunkenness_Ragdoll', true );

					ragdollDuration = RandRangeF(7, 3);

					params.effectType = EET_Ragdoll;
					params.sourceName = 'ACS_Drunkenness';
					params.duration = ragdollDuration;
					thePlayer.AddEffectCustom(params);

					GetACSWatcher().RemoveTimer('RagdollGetup');
					GetACSWatcher().RemoveTimer('RagdollGetupRemoveBlock');
					GetACSWatcher().AddTimer('RagdollGetup', ragdollDuration , false );

					GetACSWatcher().SetDrunkenessRagdollCheck(true);
				}
			}

			if( heightTargetCheck > 0
			//&& vaultingFoundCheck == ECRV_Vault
			)
			{
				collisionGroupsNames.Clear();
				collisionGroupsNames.PushBack( 'Fence' );

				if (theGame.GetWorld().StaticTraceWithAdditionalInfo( startPos, endPos, tempEndPoint_1, normal_1, material_1, comp_1, collisionGroupsNames ))
				{
					if (!thePlayer.GetIsSprinting()
					)
					{
						GetACSWatcher().ResetFastWalk();

						return true;
					}
				}
				else
				{
					cameraAngle = theCamera.GetCameraDirection();

					if ((theInput.GetActionValue('Sprint') > 0.1f || thePlayer.GetIsSprinting())
					)
					{
						if (vaultingFoundCheck == ECRV_Vault
						&& cameraAngle.Z > -0.4
						)
						{
							GetACSWatcher().ResetFastWalk();

							if (heightTargetCheck > 1.6 && heightTargetCheck <= 2.5)
							{
								if ( FactsQuerySum("ACS_Vault_Flip_Check") <= 0 )
								{
									if ( FactsQuerySum("ACS_Vault_Flip_Check_Secondary") <= 0 )
									{
										thePlayer.RaiseEvent('ACS_RunningForwardFlip');

										FactsAdd("ACS_Vault_Flip_Check_Secondary", 1, -1);
									}
									else
									{
										thePlayer.RaiseEvent('ACS_FrontFlip');

										FactsRemove("ACS_Vault_Flip_Check_Secondary");
									}

									FactsAdd("ACS_Vault_Flip_Check", 1, -1);
								}
								else
								{
									FactsRemove("ACS_Vault_Flip_Check");
								}

								thePlayer.PlayEffectSingle('acs_fast_sprint_trail');
								thePlayer.StopEffect('acs_fast_sprint_trail');
							}
					
							return true;
						}

						if( heightTargetCheck > 1.75)
						{
							if (cameraAngle.Z > 0.4)
							{
								GetACSWatcher().ResetFastWalk();

								return true;
							}
						}
						else if( heightTargetCheck > 1.5 && heightTargetCheck <= 1.75)
						{
							if (cameraAngle.Z > 0.2)
							{
								GetACSWatcher().ResetFastWalk();

								return true;
							}
						}
						else if( heightTargetCheck <= 1.5 )
						{
							if (cameraAngle.Z > -0.2)
							{
								GetACSWatcher().ResetFastWalk();

								return true;
							}
						}
					}
				}
			}
		}
	}

	return wrappedMethod();
}



@wrapMethod(CExplorationStateClimb) function StateChangePrecheck( )	: name
{		
	if (false)
	{
		wrappedMethod();
	}

	if( canFall )
	{
		m_ExplorationO.m_OwnerE.SetBehaviorVariable( behVarEnd, ( float ) ( int ) ECR_Fall );
		if( vaultingFound == ECRV_Vault )
		{
			return 'Jump';
		}
		else
		{
			if( m_ExplorationO.IsOnGround() )
			{
				return 'Idle';
			}
			else
			{
				return 'StartFalling';
			}
		}
	}
	
	if( m_ExplorationO.CanChangeBetwenStates( GetStateName(), 'Idle' ) )
	{			
		if( AbsF( m_ExplorationO.m_InputO.GetHeadingDiffFromPlayerF() ) < inputAngleToRun )
		{
			if( canRun && 
			(thePlayer.GetIsRunning() 
			|| theInput.GetActionValue('Sprint') > 0
			|| thePlayer.GetIsSprinting()) 
			) 
			{
				if( m_ExplorationO.m_InputO.IsModuleConsiderable() )
				{
					m_ExplorationO.SendAnimEvent( behGoToRun );
					m_ExplorationO.m_OwnerE.SetBehaviorVariable( behVarEnd, ( float ) ( int ) ECR_Run );
					return 'Idle';
				}
			}
			else if( canWalk )
			{
				if( m_ExplorationO.m_InputO.IsModuleConsiderable() )
				{
					if (
					theInput.GetActionValue('Sprint') > 0
					|| thePlayer.GetIsSprinting()
					)
					{
						m_ExplorationO.m_OwnerE.SetBehaviorVariable( behVarEnd, ( float ) ( int ) ECR_Run );
						m_ExplorationO.SendAnimEvent( behGoToRun );
					}
					else
					{
						m_ExplorationO.m_OwnerE.SetBehaviorVariable( behVarEnd, ( float ) ( int ) ECR_Walk );
						m_ExplorationO.SendAnimEvent( behGoToWalk );
					}

					return 'Idle';
				}
			}
		}
		else if( ( canRun || canWalk ) && m_ExplorationO.m_InputO.IsModuleConsiderable() )
		{
			if (
			theInput.GetActionValue('Sprint') > 0
			|| thePlayer.GetIsSprinting()
			)
			{
				m_ExplorationO.m_OwnerE.SetBehaviorVariable( behVarEnd, ( float ) ( int ) ECR_Run );
				m_ExplorationO.SendAnimEvent( behGoToRun );
			}
			else
			{
				if (
				theInput.GetActionValue('GI_AxisLeftX') != 0 || theInput.GetActionValue('GI_AxisLeftY') != 0 
				)
				{
					m_ExplorationO.m_OwnerE.SetBehaviorVariable( behVarEnd, ( float ) ( int ) ECR_Walk );
						m_ExplorationO.SendAnimEvent( behGoToWalk );
				}
				else
				{
					m_ExplorationO.m_OwnerE.SetBehaviorVariable( behVarEnd, ( float ) ( int ) ECR_Idle );
				}
			}

			return 'Idle';				
		}
	}
	
	
	if( ended || m_ExplorationO.GetStateTimeF() > animDurationLimit ) 
	{
		if( vaultEndsFalling || !m_ExplorationO.m_CollisionManagerO.CheckLandBelow( 0.2f, Vector( 0.0f,0.0f, 0.0f ), true ) )
		{
			m_ExplorationO.m_OwnerE.SetBehaviorVariable( behVarEnd, ( float ) ( int ) ECR_Fall );
			if( vaultingFound == ECRV_Vault )
			{
				return 'Jump';
			}
			else
			{
				return 'StartFalling';
			}
		}
		else if( m_ExplorationO.CanChangeBetwenStates( GetStateName(), 'Idle' ) )
		{
			if (
			theInput.GetActionValue('Sprint') > 0
			|| thePlayer.GetIsSprinting()
			)
			{
				m_ExplorationO.m_OwnerE.SetBehaviorVariable( behVarEnd, ( float ) ( int ) ECR_Run );
				m_ExplorationO.SendAnimEvent( behGoToRun );
			}
			else
			{
				if (
				theInput.GetActionValue('GI_AxisLeftX') != 0 || theInput.GetActionValue('GI_AxisLeftY') != 0 
				)
				{
					m_ExplorationO.m_OwnerE.SetBehaviorVariable( behVarEnd, ( float ) ( int ) ECR_Walk );
						m_ExplorationO.SendAnimEvent( behGoToWalk );
				}
				else
				{
					m_ExplorationO.m_OwnerE.SetBehaviorVariable( behVarEnd, ( float ) ( int ) ECR_Idle );
				}
			}

			return 'Idle';
		}
	}
	
	return super.StateChangePrecheck();
}

@wrapMethod(CExplorationStateClimb) function StateExitSpecific( nextStateName : name )
{
	wrappedMethod(nextStateName);

	thePlayer.StopEffect('jump_ground_fx1');
	thePlayer.PlayEffectSingle('jump_ground_fx1');
}

@wrapMethod(CExplorationStateClimb) function UpdateRunOrWalk()
{
	var runValue	: float;
	
	if (false)
	{
		wrappedMethod();
	}

	if( m_ExplorationO.m_InputO.IsModuleConsiderable() && AbsF( m_ExplorationO.m_InputO.GetHeadingDiffFromPlayerF() ) < inputAngleToRun )
	{
		if( thePlayer.GetIsRunning() 
		|| theInput.GetActionValue('Sprint') > 0
		|| thePlayer.GetIsSprinting()
		) 
		{
			runValue	= 1.0f;
		}
		else
		{
			runValue	= 0.5f;
		}
	}
	else
	{
		runValue	= 0.0f; 
	}
	
	m_ExplorationO.m_OwnerE.SetBehaviorVariable( behToRun, runValue );
}

@wrapMethod(CExplorationStateClimb) function FindPlayerState() : EClimbRequirementType
{
	if (false)
	{
		wrappedMethod();
	}

	if( m_ExplorationO.GetStateTypeCur() ==  EST_OnAir )
	{
		
		if( forceAirCollision )
		{
			return ECRT_AirColliding;
		}
		else if( forceJumpGrab )
		{
			return ECRT_Jumping;
		}
		
		if( m_ExplorationO.GetStateCur() == 'AirCollision' )
		{
			return ECRT_AirColliding;
		}
		return ECRT_Jumping;
	}
	
	
	else if( m_ExplorationO.GetStateTypeCur() ==  EST_Swim )
	{
		return ECRT_Swimming;
	}
	
	
	
	else if( ( thePlayer.GetIsRunning() 
	|| theInput.GetActionValue('Sprint') > 0
	|| thePlayer.GetIsSprinting()
	)  && m_ExplorationO.m_InputO.IsModuleConsiderable() ) 
	{
		return ECRT_Running;
	}
	
	
	return ECRT_Landed;
}

@wrapMethod(CExplorationStateClimb) function ComputeInput()
{
	if (false)
	{
		wrappedMethod();
	}
	
	inputAttemptsTop	= !thePlayer.GetIsRunning() && theInput.GetActionValue('Sprint') == 0 && !thePlayer.GetIsSprinting(); 
	
	if( m_ExplorationO.m_InputO.IsModuleConsiderable() )
	{
		inputDirection	= m_ExplorationO.m_InputO.GetMovementOnPlaneNormalizedV();
	}
	else
	{		
		inputDirection	= m_ExplorationO.m_OwnerE.GetWorldForward();
	}
}

@wrapMethod(CExplorationStateLand) function SetProperLandIK()
{
	wrappedMethod();


	switch( m_LandTypeE )
	{
		case LT_Death	:
		case LT_Damaged	:
		case LT_Crouch	:
		case LT_Panther	:
		case LT_KnockBack	:
			thePlayer.StopEffect('jump_ground_fx1');
			thePlayer.PlayEffectSingle('jump_ground_fx1');
		break;

		default:
		break;
	}
}

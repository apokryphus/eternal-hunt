///////////////////////////////

@wrapMethod(W3AxiiEntity) function OnProcessSignEvent(eventName : name)
{
	var ent, ent_2, ent_3, ent_4 		: CEntity;
	var bone_vec, attach_vec, pPos		: Vector;
	var bone_rot, attach_rot			: EulerAngles;
	
	wrappedMethod(eventName);

	if (ACS_Settings_Main_Bool('acs_signs_settings','acs_enhanced_axii_enabled', true)
	&& !thePlayer.IsUsingHorse()
	&& eventName == 'axii_ready'
	)
	{
		DestroyAllEffects();

		this.SoundEvent("fx_rune_activate_axii");
	}
}

@wrapMethod(W3AxiiEntity) function ProcessThrow()
{
	var i 																					: int;	
	var markerNPC_1, markerNPC_2 															: CEntity;
	var markerTemplate 																		: CEntityTemplate;
	var animcomp 																			: CAnimatedComponent;
	var combatTarget 																		: CActor;
	var marker_ent, marker_ent_2															: CEntity;
	var marker_temp, marker_temp_2															: CEntityTemplate;
	var attach_vec																			: Vector;
	var player																				: CR4Player;
	var ent, ent_2, ent_3, ent_4 															: CEntity;
	var bone_vec, pPos																		: Vector;
	var bone_rot, attach_rot																: EulerAngles;

	var proj : W3AxiiProjectile;			
	var spawnPos : Vector;
	var spawnRot : EulerAngles;		

	var morphedMM	: CMorphedMeshManagerComponent;

	if (false)
	{
		wrappedMethod();
	}
	
	spawnPos = GetWorldPosition();
	spawnRot = GetWorldRotation();
	
	
	StopEffect( effects[fireMode].castEffect );
	PlayEffect('axii_sign_push');

	if (ACS_Settings_Main_Bool('acs_signs_settings','acs_enhanced_axii_enabled', true)
	&& !thePlayer.IsUsingHorse()
	)
	{
		DestroyAllEffects();

		ACSGetCEntity('ACS_Quen_Bubble').Destroy();
			
		ACSGetCEntity('ACS_Quen_Fx').Destroy();

		ACSGetCEntity('ACS_Sign_Icon').Destroy();

		ACSGetCEntity('ACS_Sign_Icon_Anchor').Destroy();

		ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
		"dlc\dlc_acs\data\fx\sign_icons.w2ent"
		, true ), GetWitcherPlayer().GetWorldPosition(), GetWitcherPlayer().GetWorldRotation() );

		ent_2 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
		"dlc\dlc_acs\data\fx\sign_icons.w2ent"
		, true ), GetWitcherPlayer().GetWorldPosition(), GetWitcherPlayer().GetWorldRotation() );

		GetWitcherPlayer().GetBoneWorldPositionAndRotationByIndex( GetWitcherPlayer().GetBoneIndex( 'l_handRoll' ), bone_vec, bone_rot );

		attach_rot.Roll = 0;
		attach_rot.Pitch = 0;
		attach_rot.Yaw = 0;
		attach_vec.X = 0.4;
		attach_vec.Y = 0.15;
		attach_vec.Z = 0;

		ent.CreateAttachmentAtBoneWS( GetWitcherPlayer(), 'l_handRoll', bone_vec, bone_rot );
		ent.BreakAttachment();

		ent_2.CreateAttachment( ent, , attach_vec, attach_rot );

		if ((ACS_Armor_Set_Check('forgotten_wolf', false) 
		|| ACS_Armor_Set_Check('acs_armor', false)
		|| ACS_Armor_Set_Check('volhikar', false)
		|| thePlayer.HasTag('acs_vampire_claws_equipped')
		|| ACS_Vampire_Claws_Access()
		))
		{
			ent_2.PlayEffectSingle('axii_icon_red');
		}
		else
		{
			ent_2.PlayEffectSingle('axii_icon');
		}

		ent.DestroyAfter(1);
		ent_2.DestroyAfter(1);

		this.SoundEvent("sign_axii_ready");
		
		this.SoundEvent("fx_rune_activate_axii");

		//ent.AddTag('ACS_Sign_Icon_Anchor');

		//ent_2.AddTag('ACS_Sign_Icon');
	}

	for(i=0; i<targets.Size(); i+=1)
	{
		if(((CNewNPC)(targets[i])).HasAbility('mon_alghoul') && ((CNewNPC)(targets[i])).HasAbility('RageActive'))
		{
			((CNewNPC)(targets[i])).StopEffect('morph_fx');
			morphedMM = ((CNewNPC)(targets[i])).GetMorphedMeshManagerComponent();
			morphedMM.SetMorphBlend( 0, 0.5f );
			((CNewNPC)(targets[i])).RemoveAbility( 'RageActive' );
			((CNewNPC)(targets[i])).RemoveAbility( 'Thorns' );

			((CNewNPC)(targets[i])).SignalGameplayEvent('StopRage');
		}

		proj = (W3AxiiProjectile)theGame.CreateEntity( projTemplate, spawnPos, spawnRot );

		if (!ACS_Settings_Main_Bool('acs_signs_settings','acs_enhanced_axii_enabled', true)
		)
		{
			proj.PreloadEffect( proj.projData.flyEffect );
		}

		proj.ExtInit( owner, skillEnum, this );			

		if (!ACS_Settings_Main_Bool('acs_signs_settings','acs_enhanced_axii_enabled', true)
		)
		{
			proj.PlayEffect(proj.projData.flyEffect );		
		}		

		proj.ShootProjectileAtNode(0, projSpeed, targets[i]);

		if (ACS_Settings_Main_Bool('acs_signs_settings','acs_axii_wraith_finisher_system', true))
		{
			targets[i].AddTag('ACS_Wraith_Finisher_Marked');

			markerTemplate = (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\entities\other\wraith_finisher_mark.w2ent", true );
		
			markerNPC_1 = (CEntity)theGame.CreateEntity( markerTemplate, targets[i].GetWorldPosition() );

			markerNPC_1.CreateAttachment( targets[i], 'blood_point' );

			ACS_Tutorial_Display_Check('ACS_Phantom_Finisher_Tutorial_Shown');
		}

		if (ACS_Settings_Main_Bool('acs_signs_settings','acs_enhanced_axii_enabled', true)
		)
		{
			((CNewNPC)targets[i]).ACS_DealPostureDamage(10);

			markerNPC_2 = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource( 
			"dlc\dlc_acs\data\fx\sign_icons.w2ent"
			, true ), targets[i].GetWorldPosition() + Vector(0,0,1.5) );

			markerNPC_2.CreateAttachment( targets[i], 'blood_point' );

			markerNPC_2.DestroyAfter(5);

			if ((ACS_Armor_Set_Check('forgotten_wolf', false) 
			|| ACS_Armor_Set_Check('acs_armor', false)
			|| ACS_Armor_Set_Check('volhikar', false)
			|| thePlayer.HasTag('acs_vampire_claws_equipped')
			|| ACS_Vampire_Claws_Access()
			))
			{
				markerNPC_2.PlayEffectSingle('axii_confusion_red');
				markerNPC_2.PlayEffectSingle('axii_guardian_red');
				markerNPC_2.PlayEffectSingle('axii_hipnotize_red');

				ent_2.PlayEffectSingle('axii_lightning_fx_red', markerNPC_2);
			}
			else
			{
				markerNPC_2.PlayEffectSingle('axii_confusion');
				markerNPC_2.PlayEffectSingle('axii_guardian');
				markerNPC_2.PlayEffectSingle('axii_hipnotize');

				ent_2.PlayEffectSingle('axii_lightning_fx', markerNPC_2);
			}
		}
	}		
}

@wrapMethod(W3AxiiEntity) function OnStarted()
{
	var ent, ent_2, ent_3, ent_4 		: CEntity;
	var bone_vec, attach_vec, pPos		: Vector;
	var bone_rot, attach_rot			: EulerAngles;

	wrappedMethod();

	if (ACS_Settings_Main_Bool('acs_signs_settings','acs_enhanced_axii_enabled', true)
	&& !thePlayer.IsUsingHorse()
	)
	{
		DestroyAllEffects();

		ACSGetCEntity('ACS_Quen_Bubble').Destroy();

		ACSGetCEntity('ACS_Quen_Fx').Destroy();

		ACSGetCEntity('ACS_Sign_Icon').Destroy();

		ACSGetCEntity('ACS_Sign_Icon_Anchor').Destroy();

		ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
		"dlc\dlc_acs\data\fx\sign_icons.w2ent"
		, true ), GetWitcherPlayer().GetWorldPosition(), GetWitcherPlayer().GetWorldRotation() );

		ent_2 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
		"dlc\dlc_acs\data\fx\sign_icons.w2ent"
		, true ), GetWitcherPlayer().GetWorldPosition(), GetWitcherPlayer().GetWorldRotation() );

		GetWitcherPlayer().GetBoneWorldPositionAndRotationByIndex( GetWitcherPlayer().GetBoneIndex( 'l_handRoll' ), bone_vec, bone_rot );

		attach_rot.Roll = 0;
		attach_rot.Pitch = 0;
		attach_rot.Yaw = 0;
		attach_vec.X = 0.4;
		attach_vec.Y = 0.15;
		attach_vec.Z = 0;

		ent.CreateAttachmentAtBoneWS( GetWitcherPlayer(), 'l_handRoll', bone_vec, bone_rot );

		ent_2.CreateAttachment( ent, , attach_vec, attach_rot );

		if (ACS_Armor_Set_Check('acs_armor', false)
		&& ACS_Settings_Main_Bool('acs_signs_settings','acs_axii_extra_effects_enabled', true)
		)
		{
			GetACSWatcher().Red_Blade_Projectile_Spawner();
		}

		if ((ACS_Armor_Set_Check('forgotten_wolf', false) 
		|| ACS_Armor_Set_Check('acs_armor', false)
		|| ACS_Armor_Set_Check('volhikar', false)
		|| thePlayer.HasTag('acs_vampire_claws_equipped')
		|| ACS_Vampire_Claws_Access())
		&& ACS_Settings_Main_Bool('acs_signs_settings','acs_axii_extra_effects_enabled', true)
		)
		{
			ent_2.PlayEffectSingle('axii_icon_red_extra_small');

			ent_2.StopEffect('axii_icon_red_extra_small');

			ent_2.PlayEffectSingle('axii_hipnotize_red');

			GetACSWatcher().Axii_Effect(true);
		}
		else
		{
			ent_2.PlayEffectSingle('axii_icon_extra_small');

			ent_2.StopEffect('axii_icon_extra_small');

			ent_2.PlayEffectSingle('axii_hipnotize');

			GetACSWatcher().Axii_Effect(false);
		}

		ent.DestroyAfter(3);
		ent_2.DestroyAfter(3);

		this.SoundEvent("sign_axii_pre_start");

		//ent.AddTag('ACS_Sign_Icon_Anchor');

		//ent_2.AddTag('ACS_Sign_Icon');
	}
}

@wrapMethod(W3AxiiEntity) function OnHorseStarted()
{
	var player							: CR4Player;
	var ent, ent_2, ent_3, ent_4 		: CEntity;
	var bone_vec, attach_vec, pPos		: Vector;
	var bone_rot, attach_rot			: EulerAngles;
	
	wrappedMethod();

	if (ACS_Settings_Main_Bool('acs_signs_settings','acs_enhanced_axii_enabled', true)
	&& thePlayer.IsUsingHorse()
	)
	{
		DestroyAllEffects();

		ACSGetCEntity('ACS_Quen_Bubble').Destroy();
		
		ACSGetCEntity('ACS_Quen_Fx').Destroy();

		ACSGetCEntity('ACS_Sign_Icon').Destroy();

		ACSGetCEntity('ACS_Sign_Icon_Anchor').Destroy();

		ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
		"dlc\dlc_acs\data\fx\sign_icons.w2ent"
		, true ), GetWitcherPlayer().GetWorldPosition(), GetWitcherPlayer().GetWorldRotation() );

		ent_2 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
		"dlc\dlc_acs\data\fx\sign_icons.w2ent"
		, true ), GetWitcherPlayer().GetWorldPosition(), GetWitcherPlayer().GetWorldRotation() );

		GetWitcherPlayer().GetBoneWorldPositionAndRotationByIndex( GetWitcherPlayer().GetBoneIndex( 'l_handRoll' ), bone_vec, bone_rot );

		attach_rot.Roll = 0;
		attach_rot.Pitch = 0;
		attach_rot.Yaw = 0;
		attach_vec.X = 0.4;
		attach_vec.Y = 0.15;
		attach_vec.Z = 0;

		ent.CreateAttachmentAtBoneWS( GetWitcherPlayer(), 'l_handRoll', bone_vec, bone_rot );

		ent_2.CreateAttachment( ent, , attach_vec, attach_rot );

		if (((ACS_Armor_Set_Check('forgotten_wolf', false) 
		|| ACS_Armor_Set_Check('acs_armor', false)
		|| ACS_Armor_Set_Check('volhikar', false)
		|| thePlayer.HasTag('acs_vampire_claws_equipped')
		|| ACS_Vampire_Claws_Access())
		&& ACS_Settings_Main_Bool('acs_signs_settings','acs_axii_extra_effects_enabled', true)
		))
		{
			ent_2.PlayEffectSingle('axii_icon_red');

			ent_2.PlayEffectSingle('axii_hipnotize_red');
		}
		else
		{
			ent_2.PlayEffectSingle('axii_icon');

			ent_2.PlayEffectSingle('axii_hipnotize');
		}

		this.SoundEvent("sign_axii_pre_start");

		//ent.DestroyAfter(0.5);
		//ent_2.DestroyAfter(0.5);

		ent.AddTag('ACS_Sign_Icon_Anchor');

		ent_2.AddTag('ACS_Sign_Icon');
	}
}

@wrapMethod(W3AxiiEntity) function OnEnded(optional isEnd : bool)
{
	wrappedMethod(isEnd);

	if (ACS_Settings_Main_Bool('acs_signs_settings','acs_enhanced_axii_enabled', true))
	{
		DestroyAllEffects();

		ACSGetCEntity('ACS_Quen_Bubble').Destroy();
		
		ACSGetCEntity('ACS_Quen_Fx').Destroy();

		ACSGetCEntity('ACS_Sign_Icon').Destroy();

		ACSGetCEntity('ACS_Sign_Icon_Anchor').Destroy();

		this.SoundEvent("sign_axii_base_loop_end");

		this.SoundEvent("sign_axii_release");
	}
}

@wrapMethod(AxiiCast) function OnSignAborted( optional force : bool )
{
	wrappedMethod(force);

	if (ACS_Settings_Main_Bool('acs_signs_settings','acs_enhanced_axii_enabled', true))
	{
		parent.DestroyAllEffects();

		ACSGetCEntity('ACS_Quen_Bubble').Destroy();
		
		ACSGetCEntity('ACS_Quen_Fx').Destroy();

		ACSGetCEntity('ACS_Sign_Icon').Destroy();

		ACSGetCEntity('ACS_Sign_Icon_Anchor').Destroy();

		parent.SoundEvent("sign_axii_base_loop_end");

		parent.SoundEvent("sign_axii_release");
	}
}


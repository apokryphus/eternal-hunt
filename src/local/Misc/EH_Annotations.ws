@wrapMethod( W3AirDrainProjectile ) function VictimCollision (victim : CGameplayEntity)
{
	if ( victim 
	)
	{
		if (( (CActor)( victim ) ).IsCurrentlyDodging()
		|| victim.HasTag('ACS_Is_Currently_Dodging')
		)
		{
			if (victim == thePlayer)
			{
				thePlayer.PlayEffectSingle('acs_fast_sprint_trail');
				thePlayer.StopEffect('acs_fast_sprint_trail');

				thePlayer.RaiseEvent('ACS_FrontTwistFlip');

				if (RandF() < 0.5)
				{
					thePlayer.RaiseEvent( 'ACS_CastAardLocomotion' );
				}
				else
				{
					thePlayer.RaiseEvent( 'ACS_CastIgniLocomotion' );
				}
			}

			return;
		}
	}

	wrappedMethod(victim);
}

@wrapMethod(CR4InventoryMenu) function UpdateEntityTemplate() : void
{
	var templateFilename : string;
	var appearance : name;
	var environmentFilename : string;
	var environmentSunRotation : EulerAngles;
	var cameraLookAt : Vector;
	var cameraRotation : EulerAngles;
	var cameraDistance : float;
	var updateItems : bool;
	var fov : float;
	var guiSceneController : CR4GuiSceneController;

	if(theGame.GetDLCManager().IsDLCAvailable('dlcvhud') 
	&& theGame.GetDLCManager().IsDLCEnabled('dlcvhud') )
	{
		wrappedMethod();

		return;
	}
	
	guiSceneController = theGame.GetGuiManager().GetSceneController();
	if ( !guiSceneController )
	{
		
		return;
	}

	if ( drawHorse )
	{
		templateFilename             = "HorseforUI";

		appearance                   = '';
		environmentSunRotation.Yaw   = 250;
		environmentSunRotation.Pitch = 10;
		cameraLookAt.Z               = 1;
		cameraRotation.Yaw           = 88.6;
		cameraRotation.Pitch         = 355;
		cameraDistance               = 3.17;

		fov 						 = 35.0f;
		updateItems                  = false;
	}
	else
	{
		templateFilename             = "GeraltForUI";
		appearance                   = '';
		environmentSunRotation.Yaw   = 0;
		environmentSunRotation.Pitch = 0;
		cameraLookAt.Y               = 0.4;
		cameraLookAt.Z               = 0.92;
		cameraRotation.Yaw           = 190.71; 
		cameraRotation.Pitch         = 5;
		cameraDistance               = 3.2;
		fov							 = 35.0f;
		updateItems                  = true;
	}

	guiSceneController.SetEntityTemplate( templateFilename );
	guiSceneController.SetCamera( cameraLookAt, cameraRotation, cameraDistance, fov );
	guiSceneController.SetEnvironmentAndSunRotation( "DefaultEnvironmentForUI", environmentSunRotation );
	guiSceneController.SetEntityAppearance( appearance );

	if( !drawHorse )
	{
		guiSceneController.SetEntityItems( updateItems );
	}
}

@wrapMethod( CR4InventoryMenu ) function ApplyOil(itemId : SItemUniqueId,  targetSlot : int) : void
{
	var curItemInSlot : SItemUniqueId;

	wrappedMethod(itemId, targetSlot);

	if (_inv.GetItemEquippedOnSlot(targetSlot, curItemInSlot))
	{
		if (m_player)
		{
			switch(targetSlot)
			{
				case 2:
					m_player.RaiseEvent('ACS_DrawSteelHack');
				break;

				case 1:
					m_player.RaiseEvent('ACS_DrawSilverHack');
				break;

				case 0:
				default:
				break;

			}

			if (RandF() < 0.5)
			{
				m_player.RaiseEvent('ACS_SwordRepair');
			}
			else
			{
				m_player.RaiseEvent('ACS_SwordBuff');
			}
		}
	}
	else
	{
		return;
	}
}

@wrapMethod( CR4InventoryMenu ) function OnGuiSceneEntitySpawned(entity : CEntity)
{
	var arr : array< name >;

	if (false)
	{
		wrappedMethod(entity);
	}
	
	Event_OnGuiSceneEntitySpawned();

	m_player = entity;

	arr.PushBack( 'acs_inventory_beh' );

	m_player.ActivateBehaviorsSync( arr );
	
	((CActor)m_player).SetBehaviorMimicVariable( 'gameplayMimicsMode', (float)(int)PGMM_Combat );
}

@addField(CR4InventoryMenu)
var acs_idle_additive_index_1 : int;

@addField(CR4InventoryMenu)
var acs_previous_idle_additive_index_1 : int;

@wrapMethod( CR4InventoryMenu ) function PlayPaperdollAnimation( category : name ):void
{
	wrappedMethod(category);

	if (m_player)
	{
		acs_idle_additive_index_1 = RandDifferent(this.acs_previous_idle_additive_index_1 , 13);

		switch (acs_idle_additive_index_1) 
		{	
			case 12:
				m_player.RaiseEvent('ACS_SwordTaunt12');
			break;

			case 11:
				m_player.RaiseEvent('ACS_SwordTaunt11');
			break;

			case 10:
				m_player.RaiseEvent('ACS_SwordTaunt09');
			break;

			case 9:
				m_player.RaiseEvent('ACS_SwordTaunt08');
			break;

			case 8:
				m_player.RaiseEvent('ACS_SwordTaunt06');
			break;

			case 7:
				m_player.RaiseEvent('ACS_SwordTaunt05');
			break;

			case 6:
				m_player.RaiseEvent('ACS_SwordTaunt04');
			break;

			case 5:
				m_player.RaiseEvent('ACS_SwordTaunt02');
			break;

			case 4:
				m_player.RaiseEvent('ACS_SwordTaunt01');
			break;

			case 3:
				m_player.RaiseEvent('ACS_IdleAdditiveKnifeplay03');
			break;
			
			case 2:
				m_player.RaiseEvent('ACS_IdleAdditiveSwordCheck02');
			break;
			
			case 1:
				m_player.RaiseEvent('ACS_IdleAdditiveSwordCheck01');
			break;

			default:
				m_player.RaiseEvent('ACS_IdleAdditiveHeavyMeleeCheck');
			break;
		}

		this.acs_previous_idle_additive_index_1 = acs_idle_additive_index_1;
	}
}


@wrapMethod(CStoryScenePlayer) function OnBlockingSceneStarted( scene: CStoryScene )
{
	var actors		    				: array<CActor>;
	var i								: int;

	wrappedMethod(scene);

	if ( !theGame.IsActive() )
	{
		return true;
	}
	
	if (thePlayer.inv.HasItem('Cup_01'))
	{
		thePlayer.inv.RemoveItemByName('Cup_01', 1);
	}

	if (GetACSWatcher().steel_scabbard_hidden
	|| GetACSWatcher().silver_scabbard_hidden
	|| GetACSWatcher().steel_sword_hidden
	|| GetACSWatcher().silver_sword_hidden
	|| GetACSWatcher().crossbow_hidden
	)
	{
		GetACSWatcher().RemoveTimer('SetScabbardFlag');
		GetACSWatcher().AddTimer('SetScabbardFlag', 0.125 , false );
	}

	///thePlayer.PlayEffectSingle('covered_blood_red_special_ACS');

	thePlayer.RaiseEvent('ACS_SwordWalkAdditiveEnd');

	thePlayer.RaiseEvent('ACS_CombatTauntEnd');

	thePlayer.RaiseEvent('ACS_SwordTauntEnd');

	ACSSignComboSystemRemoveTags();

	ACSGetCEntityDestroyAll('ACS_Sign_Combo_Icon');

	FactsRemove("ACS_Dummy_Swords_Enabled");

	GetACSWatcher().Remove_On_Hit_Tags();
}

@wrapMethod(CStoryScenePlayer) function OnBlockingSceneEnded( output: CStorySceneOutput )
{
	wrappedMethod(output);

	if ( !theGame.IsActive() )
	{
		return true;
	}
	
	if (thePlayer.inv.HasItem('Cup_01'))
	{
		thePlayer.inv.RemoveItemByName('Cup_01', 1);
	}

	if (GetACSWatcher().steel_scabbard_hidden
	|| GetACSWatcher().silver_scabbard_hidden
	|| GetACSWatcher().steel_sword_hidden
	|| GetACSWatcher().silver_sword_hidden
	|| GetACSWatcher().crossbow_hidden
	)
	{
		GetACSWatcher().RemoveTimer('SetScabbardFlag');
		GetACSWatcher().AddTimer('SetScabbardFlag', 0.125 , false );
	}

	thePlayer.RaiseEvent('ACS_SwordWalkAdditiveEnd');

	thePlayer.RaiseEvent('ACS_CombatTauntEnd');

	thePlayer.RaiseEvent('ACS_SwordTauntEnd');

	ACSSignComboSystemRemoveTags();

	ACSGetCEntityDestroyAll('ACS_Sign_Combo_Icon');

	FactsRemove("ACS_Dummy_Swords_Enabled");

	GetACSWatcher().Remove_On_Hit_Tags();
}

@wrapMethod( CR4Game ) function OnGameStarting(restored : bool )
{
	wrappedMethod(restored);

	SetHoursPerMinute(ACS_Settings_Main_Float('acs_darkness_settings_main','acs_hours_per_minute', 0.25));	
}


@wrapMethod(CR4LootPopup) function TakeAllAction() : void
{
    if (theGame.GetDLCManager().IsDLCAvailable('dlc_spectre') 
    && theGame.GetDLCManager().IsDLCEnabled('dlc_spectre') 
    )
    {
		wrappedMethod();

		return;
    }

	if (ACS_Settings_Main_Bool('acs_container_settings','acs_looting_anim_enabled', true))
	{
		thePlayer.RaiseEvent('ACS_CombatTauntEnd');

		thePlayer.RaiseEvent('ACS_IdleAdditiveReset');

		if( (thePlayer.IsAnyWeaponHeld() && !thePlayer.IsWeaponHeld('fist')) 
		|| thePlayer.GetWeaponHolster().IsOnTheMiddleOfHolstering() 
		)
		{
			if (thePlayer.IsHoldingItemInLHand() )
			{
				
			}
			else
			{
				thePlayer.RaiseEvent('ACS_LootWithWeapon');
			}
		}
		else
		{
			if (thePlayer.IsHoldingItemInLHand() 
			|| theGame.IsFocusModeActive()
			|| theInput.GetActionValue('Focus') > 0.1f
			)
			{
				thePlayer.RaiseEvent('ACS_Loot');

				GetACSWatcher().CreateLootItemsInHand('default', 'r_hand');
			}
			else
			{
				if (FactsQuerySum("ACS_Loot_Anim_Played") <= 0 )
				{
					thePlayer.RaiseEvent('ACS_Loot');

					GetACSWatcher().CreateLootItemsInHand('default', 'r_hand');

					FactsAdd("ACS_Loot_Anim_Played", 1, -1);
				}
				else if (FactsQuerySum("ACS_Loot_Anim_Played") > 0 )
				{
					thePlayer.RaiseEvent('ACS_LootWithWeapon');

					GetACSWatcher().CreateLootItemsInHand('default', 'l_hand');

					FactsRemove("ACS_Loot_Anim_Played");
				}
			}
		}

		if (GetWitcherPlayer().IsUsingHorse()) 
		{
			if (RandF() < 0.25)
			{
				thePlayer.RaiseEvent('ACS_HorseLootTorsoBendL');
			}
			else
			{
				thePlayer.RaiseEvent('ACS_HorseLootTorsoBendR');
			}
		} 
	}
	
	_container.TakeAllItems();
}

@addField(W3Container)
private var acsAreaLoot				: acsAoELoot;

@wrapMethod(W3Container) function ProcessLoot()
{
	var targetInv : CInventoryComponent;
	var items1, items2, allItems, ids	: array< SItemUniqueId >;
	var ciriEntity  : W3ReplacerCiri;
	var i, j, k, dismemberment_i : int;
	var itemsCategories : array< name >;
	var category : name;
	var l_itemName, l_iconPath, fontSize : string;
	var qty, qlty		: int;
	var l_containerInv 	: CInventoryComponent;
	var	container_idx, item_count, itemid	: int;
	var l_item							: SItemUniqueId;
	var containerPos, playerPos : Vector;
	var owner 							: CActor;
	var heading : float;
	var riderPos, targetPos : Vector;
	var target : CActor;
	var targetDistance 	: Float;
	var horizontalVal : float;

	if(false) 
	{
		wrappedMethod();
	}

	if(disableLooting)
	{
		return;
	}

	if (usedByCiri)
	{
		thePlayer.RaiseEvent('LootHerb');

		TakeAllItems();
		OnContainerClosed();	

		return;
	}

	thePlayer.RaiseEvent('ACS_CombatTauntEnd');

	if (GetACSWatcher().combatExtraActive)
	{
		GetACSWatcher().RemoveTimer('combatExtraReset');
		
		thePlayer.RaiseEvent('ACS_CombatExtraReset');

		GetACSWatcher().SetCombatExtraStatus(false);
	}

	if (GetACSWatcher().idleAdditiveExtraActive)
	{
		thePlayer.RaiseEvent('ACS_IdleAdditiveReset');

		GetACSWatcher().SetIdleAdditiveExtraStatus(false);
	}

	if (thePlayer.HasTag('ACS_SwordBuffAnimationPlayed'))
	{
		thePlayer.RaiseEvent('ACS_BothHandsAdditiveEnd');

		thePlayer.RemoveTag('ACS_SwordBuffAnimationPlayed');
	}

	if((!ACS_Settings_Main_Bool('acs_container_settings','acs_skip_container_popup_enabled', false) && !((W3Herb)this))
	|| skipInventoryPanel  
	|| (((W3Herb)this) && !ACS_Settings_Main_Bool('acs_container_settings','acs_herb_container_popup_enabled', false)) 
	) 
	{
		if (ACS_Settings_Main_Bool('acs_container_settings','acs_looting_anim_enabled', true))
		{
			containerPos = this.GetWorldPosition();

			playerPos = thePlayer.GetWorldPosition();

			thePlayer.RaiseEvent('ACS_IdleAdditiveReset');

			if (GetWitcherPlayer().IsUsingHorse()) 
			{
				heading = VecHeading( GetWorldPosition() - thePlayer.GetWorldPosition() );
				horizontalVal = AngleDistance( thePlayer.GetHeading(), heading ) / 180.f;

				if (horizontalVal > 0)
				{
					thePlayer.RaiseEvent('ACS_HorseLootTorsoBendR');
				}
				else if (horizontalVal < 0)
				{
					thePlayer.RaiseEvent('ACS_HorseLootTorsoBendL');
				}
			} 

			if( (thePlayer.IsAnyWeaponHeld() && !thePlayer.IsWeaponHeld('fist')) 
			|| thePlayer.GetWeaponHolster().IsOnTheMiddleOfHolstering() 
			)
			{
				if (thePlayer.IsHoldingItemInLHand() )
				{
					
				}
				else
				{
					if (((W3ActorRemains)this) 
					&& ((( ( W3ActorRemains )this ).GetOwner()).IsMonster() || (( ( W3ActorRemains )this ).GetOwner()).IsAnimal())
					)
					{
						/*
						if (ACS_Settings_Main_Bool('acs_container_settings','acs_extended_remains_looting_anim_enabled', false)
						&& FactsQuerySum("ACS_Player_Extended_Remains_Looting_Start") <= 0
						&& theInput.GetActionValue('Take') > 0.1f
						)
						{

						}
						else
						{
						*/
							if (FactsQuerySum("ACS_Player_Remains_Looting_Start") > 0
							)
							{
								thePlayer.RaiseEvent('ACS_LootWithWeapon');

								GetACSWatcher().CreateLootItemsInHand('default', 'l_hand');

								GetACSWatcher().ACS_CreateTrophyDagger();

								thePlayer.RaiseEvent('ACS_TakeTrophy');

								GetACSWatcher().RemoveTimer('ACS_TakeTrophyHandRevert');
								GetACSWatcher().AddTimer('ACS_TakeTrophyHandRevert', 0.75 , false );
							}
						//}
					}
					else
					{
						if (
						(((W3ActorRemains)this)
						|| ((W3Herb)this)
						|| containerPos.Z <= playerPos.Z + 1.25)
						)
						{
							if (!thePlayer.IsUsingHorse()
							&& !thePlayer.IsUsingVehicle()
							//&& !thePlayer.GetIsSprinting()
							//&& !thePlayer.GetIsRunning()
							)
							{
								thePlayer.RaiseEvent('ACS_LootWithWeaponKneeling');
							}
							else
							{
								thePlayer.RaiseEvent('ACS_LootWithWeapon');
							}

							if (
							((W3Herb)this)
							)
							{
								GetACSWatcher().CreateLootItemsInHand('herb', 'l_hand_kneeling');
							}
							else
							{
								GetACSWatcher().CreateLootItemsInHand('default', 'l_hand_kneeling');
							}
						}
						else
						{
							thePlayer.RaiseEvent('ACS_LootWithWeapon');

							GetACSWatcher().CreateLootItemsInHand('default', 'l_hand');
						}
					}
				}
			}
			else
			{
				if (((W3ActorRemains)this) 
				&& ((( ( W3ActorRemains )this ).GetOwner()).IsMonster() || (( ( W3ActorRemains )this ).GetOwner()).IsAnimal())
				)
				{
					/*
					if (ACS_Settings_Main_Bool('acs_container_settings','acs_extended_remains_looting_anim_enabled', false)
					&& FactsQuerySum("ACS_Player_Extended_Remains_Looting_Start") <= 0
					&& theInput.GetActionValue('Take') > 0.1f
					)
					{

					}
					else
					{
					*/
						if (FactsQuerySum("ACS_Player_Remains_Looting_Start") > 0
						)
						{
							thePlayer.RaiseEvent('ACS_LootWithWeapon');
							
							GetACSWatcher().CreateLootItemsInHand('default', 'l_hand');

							GetACSWatcher().ACS_CreateTrophyDagger();

							thePlayer.RaiseEvent('ACS_TakeTrophy');

							GetACSWatcher().RemoveTimer('ACS_TakeTrophyHandRevert');
							GetACSWatcher().AddTimer('ACS_TakeTrophyHandRevert', 0.75 , false );
						}
					//}
				}
				else
				{
					if (thePlayer.IsHoldingItemInLHand() 
					|| theGame.IsFocusModeActive()
					|| theInput.GetActionValue('Focus') > 0.1f
					)
					{
						thePlayer.RaiseEvent('ACS_Loot');

						if (
						((W3Herb)this)
						)
						{
							GetACSWatcher().CreateLootItemsInHand('herb', 'r_hand');
						}
						else
						{
							GetACSWatcher().CreateLootItemsInHand('default', 'r_hand');
						}
					}
					else
					{
						if (FactsQuerySum("ACS_Loot_Anim_Played") <= 0 )
						{
							thePlayer.RaiseEvent('ACS_Loot');

							if (
							((W3Herb)this)
							)
							{
								GetACSWatcher().CreateLootItemsInHand('herb', 'r_hand');
							}
							else
							{
								GetACSWatcher().CreateLootItemsInHand('default', 'r_hand');
							}

							FactsAdd("ACS_Loot_Anim_Played", 1, -1);
						}
						else if (FactsQuerySum("ACS_Loot_Anim_Played") > 0 )
						{
							if (
							(((W3ActorRemains)this)
							|| ((W3Herb)this)
							|| containerPos.Z <= playerPos.Z + 1.25)
							)
							{
								if (!thePlayer.IsUsingHorse()
								&& !thePlayer.IsUsingVehicle()
								//&& !thePlayer.GetIsSprinting()
								//&& !thePlayer.GetIsRunning()
								)
								{
									thePlayer.RaiseEvent('ACS_LootWithWeaponKneeling');
								}
								else
								{
									thePlayer.RaiseEvent('ACS_LootWithWeapon');
								}

								if (
								((W3Herb)this)
								)
								{
									GetACSWatcher().CreateLootItemsInHand('herb', 'l_hand_kneeling');
								}
								else
								{
									GetACSWatcher().CreateLootItemsInHand('default', 'l_hand_kneeling');
								}
							}
							else
							{
								thePlayer.RaiseEvent('ACS_LootWithWeapon');

								GetACSWatcher().CreateLootItemsInHand('default', 'l_hand');
							}
						

							FactsRemove("ACS_Loot_Anim_Played");
						}
					}
				}
			}

			if (
			(((W3ActorRemains)this)
			|| ((W3Herb)this)
			|| containerPos.Z <= playerPos.Z+ 1.25)
			)
			{
				if (!thePlayer.IsUsingHorse()
				&& !thePlayer.IsUsingVehicle()
				//&& !thePlayer.GetIsSprinting()
				//&& !thePlayer.GetIsRunning()
				)
				{
					if (((W3ActorRemains)this) 
					&& ((( ( W3ActorRemains )this ).GetOwner()).IsMonster() || (( ( W3ActorRemains )this ).GetOwner()).IsAnimal())
					)
					{
						/*
						if (ACS_Settings_Main_Bool('acs_container_settings','acs_extended_remains_looting_anim_enabled', false)
						&& FactsQuerySum("ACS_Player_Extended_Remains_Looting_Start") <= 0
						&& theInput.GetActionValue('Take') > 0.1f
						)
						{

						}
						else
						{
						*/
							if (FactsQuerySum("ACS_Player_Remains_Looting_Start") > 0
							)
							{
								thePlayer.RaiseEvent('ACS_LootWithWeapon');
								
								GetACSWatcher().CreateLootItemsInHand('default', 'l_hand');

								GetACSWatcher().ACS_CreateTrophyDagger();

								thePlayer.RaiseEvent('ACS_TakeTrophy');

								GetACSWatcher().RemoveTimer('ACS_TakeTrophyHandRevert');
								GetACSWatcher().AddTimer('ACS_TakeTrophyHandRevert', 0.75 , false );
							}
						//}
					}
					else
					{
						if (!thePlayer.IsSwimming()
						&& !thePlayer.IsDiving())
						{
							thePlayer.RaiseEvent('ACS_KneelFast');
						}
					}

					thePlayer.RaiseEvent('ACS_TorsoBend'); 
				}
				else
				{
					if (thePlayer.IsHoldingItemInLHand() 
					|| theGame.IsFocusModeActive()
					|| theInput.GetActionValue('Focus') > 0.1f
					)
					{
						thePlayer.RaiseEvent('ACS_Loot');

						GetACSWatcher().CreateLootItemsInHand('default', 'r_hand');
					}
					else
					{
						if (FactsQuerySum("ACS_Loot_Anim_Played") <= 0 )
						{
							thePlayer.RaiseEvent('ACS_Loot');

							GetACSWatcher().CreateLootItemsInHand('default', 'r_hand');

							FactsAdd("ACS_Loot_Anim_Played", 1, -1);
						}
						else if (FactsQuerySum("ACS_Loot_Anim_Played") > 0 )
						{
							thePlayer.RaiseEvent('ACS_LootWithWeapon');

							GetACSWatcher().CreateLootItemsInHand('default', 'l_hand');

							FactsRemove("ACS_Loot_Anim_Played");
						}
					}
					
					thePlayer.RaiseEvent('ACS_TorsoBend'); 
				}
			}
			else
			{
				if (containerPos.Z >= playerPos.Z + 1)
				{
					
				}
				else
				{
					thePlayer.RaiseEvent('ACS_TorsoBend');
				}
			}
		}

		if (!ACS_Settings_Main_Bool('acs_container_settings','acs_skip_container_popup_enabled', false))
		{
			fontSize = FloatToStringPrec(ACS_Settings_Main_Float('acs_hud_settings_markers','acs_3D_loot_popups_size', 27), 0);

			if ((ACS_Is_DLC_Installed('dlc_spectre')))
			{
				acsAreaLoot = new acsAoELoot in this;

				acsAreaLoot.initialize(this);

				acsAreaLoot.sorted_inventories.Clear();

				container_idx = acsAreaLoot.inventories.Size();

				item_count = acsAreaLoot.getContainersItemCount(acsAreaLoot.inventories);

				while (container_idx)
				{	
					container_idx -= 1;

					l_containerInv = acsAreaLoot.inventories[container_idx];

					l_containerInv.GetAllItems(ids);

					item_count = ids.Size();

					for (itemid = 0; itemid < item_count; itemid += 1)
					{	
						l_item = ids[itemid];

						if (!l_containerInv.ItemHasTag(l_item, 'Lootable') && (l_containerInv.ItemHasTag(l_item, theGame.params.TAG_DONT_SHOW ) || l_containerInv.ItemHasTag(l_item,'NoDrop') ) )
							continue ;
						
						acsAreaLoot.sorted_inventories.PushBack(acsAreaLoot.inventories[container_idx]);

						if (ACS_Settings_Main_Bool('acs_hud_settings_markers','acs_3D_loot_popups_enabled', true))
						{
							if (
							ACS_FilterCheck(l_containerInv, l_item)
							)
							{
								
							}
							else
							{
								l_itemName = GetLocStringByKeyExt(l_containerInv.GetItemLocalizedNameByUniqueID(l_item));

								l_iconPath = "<img src='img://" + l_containerInv.GetItemIconPathByUniqueID(l_item) + "' height='" + fontSize + "' width='" + fontSize + "' vspace='-5' />&nbsp;";

								l_itemName = l_iconPath + l_itemName;

								if (ACS_Settings_Main_Bool('acs_hud_settings_markers','acs_3D_loot_popups_coloring_enabled', true))
								{
									qlty = RoundMath(CalculateAttributeValue( l_containerInv.GetItemAttributeValue(l_item, 'quality' ) ) );

									switch(qlty)
									{
										case 5:
										l_itemName = "<font color='#00b000'>" + l_itemName + "</font>";
										break;

										case 4:
										l_itemName = "<font color='#ff6c00'>" + l_itemName + "</font>";
										break;

										case 3:
										l_itemName = "<font color='#c9c900'>" + l_itemName + "</font>";
										break;

										case 2:
										l_itemName = "<font color='#1451ff'>" + l_itemName + "</font>";
										break;

										case 1:
										l_itemName = "<font color='#ffffff'>" + l_itemName + "</font>";
										break;

										default:
										l_itemName = "<font color='#ffffff'>" + l_itemName + "</font>";
										break;
									}
								}

								qty = l_containerInv.GetItemQuantity(l_item);

								if (qty > 1) 
								{
									l_itemName += " x " + qty;
								}

								if (thePlayer.IsUsingHorse())
								{
									ACS_Oneliner(
									(new ACS_Oneliner_TagBuilder in theGame)
									.tag("font")
									.attr("size", fontSize)
									.attr("color", "#ffffff")
									.text(l_itemName)
									, thePlayer, "ACS_ItemPopup", Vector(RandRangeF(0.55,-0.55),RandRangeF(0.55,-0.55),RandRangeF(2,1)) , 3).run_indicator('popup');
								}
								else
								{
									ACS_Oneliner(
									(new ACS_Oneliner_TagBuilder in theGame)
									.tag("font")
									.attr("size", fontSize)
									.attr("color", "#ffffff")
									.text(l_itemName)
									, thePlayer, "ACS_ItemPopup", Vector(RandRangeF(0.55,-0.55),RandRangeF(0.55,-0.55),RandRangeF(1.25,1)) , 3).run_indicator('popup');
								}
							}
						}
					}
				}
			}
			else
			{
				if (ACS_Settings_Main_Bool('acs_hud_settings_markers','acs_3D_loot_popups_enabled', true))
				{
					inv.GetAllItems( allItems );

					for(i=0; i<allItems.Size(); i+=1)
					{						
						if( inv.ItemHasTag(allItems[i], 'Lootable' ) || !inv.ItemHasTag(allItems[i], 'NoDrop') && !inv.ItemHasTag(allItems[i], theGame.params.TAG_DONT_SHOW))
						{
							if (
							ACS_FilterCheck(inv, allItems[i])
							)
							{
								allItems.Erase( i );
							}
							else
							{
								l_itemName = GetLocStringByKeyExt(inv.GetItemLocalizedNameByUniqueID(allItems[i]));

								l_iconPath = "<img src='img://" + inv.GetItemIconPathByUniqueID(allItems[i]) + "' height='" + fontSize + "' width='" + fontSize + "' vspace='-5' />&nbsp;";

								l_itemName = l_iconPath + l_itemName;

								if (ACS_Settings_Main_Bool('acs_hud_settings_markers','acs_3D_loot_popups_coloring_enabled', true))
								{
									qlty = RoundMath(CalculateAttributeValue( inv.GetItemAttributeValue(allItems[i], 'quality' ) ) );

									switch(qlty)
									{
										case 5:
										l_itemName = "<font color='#00b000'>" + l_itemName + "</font>";
										break;

										case 4:
										l_itemName = "<font color='#ff6c00'>" + l_itemName + "</font>";
										break;

										case 3:
										l_itemName = "<font color='#c9c900'>" + l_itemName + "</font>";
										break;

										case 2:
										l_itemName = "<font color='#1451ff'>" + l_itemName + "</font>";
										break;

										case 1:
										l_itemName = "<font color='#ffffff'>" + l_itemName + "</font>";
										break;

										default:
										l_itemName = "<font color='#ffffff'>" + l_itemName + "</font>";
										break;
									}
								}

								qty = inv.GetItemQuantity(allItems[i]);

								if (qty > 1) 
								{
									l_itemName += " x " + qty;
								}

								if (thePlayer.IsUsingHorse())
								{
									ACS_Oneliner(
									(new ACS_Oneliner_TagBuilder in theGame)
									.tag("font")
									.attr("size", fontSize)
									.attr("color", "#ffffff")
									.text(l_itemName)
									, thePlayer, "ACS_ItemPopup", Vector(RandRangeF(0.55,-0.55),RandRangeF(0.55,-0.55),RandRangeF(2,1)) , 3).run_indicator('popup');
								}
								else
								{
									ACS_Oneliner(
									(new ACS_Oneliner_TagBuilder in theGame)
									.tag("font")
									.attr("size", fontSize)
									.attr("color", "#ffffff")
									.text(l_itemName)
									, thePlayer, "ACS_ItemPopup", Vector(RandRangeF(0.55,-0.55),RandRangeF(0.55,-0.55),RandRangeF(1.25,1)) , 3).run_indicator('popup');
								}
							}
						}
					}
				}
			}
		}

		if ((ACS_Is_DLC_Installed('dlc_spectre')))
		{
			acsAreaLoot.takeAllItems();
		}

		TakeAllItems();

		OnContainerClosed();	
	}
	else
	{
		if (ACS_Settings_Main_Bool('acs_container_settings','acs_looting_anim_enabled', true))
		{
			if (
			!thePlayer.IsUsingHorse()
			&& !thePlayer.IsUsingVehicle()
			)
			{
				if (((W3Herb)this) && ACS_Settings_Main_Bool('acs_container_settings','acs_herb_container_popup_enabled', false))
				{
					if( FactsQuerySum("ACS_Player_In_Container_Loot_Anim_Low") <= 0)
					{
						thePlayer.PlayerStartAction( PEA_InspectLow );

						FactsAdd("ACS_Player_In_Container_Loot_Anim_Low", 1, -1);
					}
				}

				if ( !((W3Herb)this) && ACS_Settings_Main_Bool('acs_container_settings','acs_skip_container_popup_enabled', false) )
				{
					containerPos = this.GetWorldPosition();

					playerPos = thePlayer.GetWorldPosition();

					if (
					((W3ActorRemains)this)
					|| containerPos.Z <= playerPos.Z + 1.25
					)
					{
						if( FactsQuerySum("ACS_Player_In_Container_Loot_Anim_Low") <= 0)
						{
							thePlayer.PlayerStartAction( PEA_InspectLow );
							
							FactsAdd("ACS_Player_In_Container_Loot_Anim_Low", 1, -1);
						}
					}
					else
					{
						if( FactsQuerySum("ACS_Player_In_Container_Loot_Anim_Mid") <= 0)
						{
							thePlayer.PlayerStartAction( PEA_InspectMid );
							
							FactsAdd("ACS_Player_In_Container_Loot_Anim_Mid", 1, -1);
						}
					}
				}
			}
		}

		ShowLoot();
	}
}

///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

@addMethod(W3Container) function ACS_IsHerbFilterEnabled(targetInv : CInventoryComponent, itemID : SItemUniqueId) : bool
{
	if( targetInv.GetItemName(itemID) == 'Buckthorn' 
	|| targetInv.ItemHasTag(itemID, 'HerbGameplay')
	)
	{
		return true;
	}

	return false;
}


@addMethod(W3Container) function ACS_FilterCheck(targetInv : CInventoryComponent, itemID : SItemUniqueId) : bool
{
	var itemName, itemCategory : name;

	itemName = targetInv.GetItemName(itemID);
	itemCategory = targetInv.GetItemCategory(itemID);


	// herbs
	if( 
	ACS_Settings_Main_Bool('acs_container_settings','acs_container_take_all_skip_herbs_enabled', false) && 
	(targetInv.GetItemName(itemID) == 'Buckthorn' 
	|| targetInv.ItemHasTag(itemID, 'HerbGameplay'))
	)
	{
		return true;
	}

	// armors
	if( 
	ACS_Settings_Main_Bool('acs_container_settings','acs_container_take_all_skip_armors_enabled', false) && 
	targetInv.IsItemAnyArmor(itemID) 
	)
	{
		return true;
	}

	// weapons
	if( 
	ACS_Settings_Main_Bool('acs_container_settings','acs_container_take_all_skip_weapon_enabled', false) && 
	(targetInv.IsItemWeapon(itemID) || targetInv.ItemHasTag(itemID, 'UI_Torch')) 
	)
	{
		return true;
	}

	// ingredients
	if( 
	ACS_Settings_Main_Bool('acs_container_settings','acs_container_take_all_skip_ingredients_enabled', false) && 
	(targetInv.IsItemIngredient(itemID) 
	|| targetInv.GetItemName(itemID) == 'Soltis Vodka')
	)
	{
		return true;
	}

	// junk
	if( 
	ACS_Settings_Main_Bool('acs_container_settings','acs_container_take_all_skip_junk_enabled', false) && 
	targetInv.IsItemJunk(itemID) 
	)
	{
		return true;
	}	

	// readable
	if( 
	ACS_Settings_Main_Bool('acs_container_settings','acs_container_take_all_skip_readable_enabled', false) && 
	(targetInv.IsItemReadable(itemID)
	|| targetInv.ItemHasTag(itemID, 'Painting'))
	)
	{
		return true;
	}


	// already read
	if( 
	ACS_Settings_Main_Bool('acs_container_settings','acs_container_take_all_skip_already_read_enabled', false) && 
	((targetInv.IsItemReadable(itemID) 
	|| targetInv.ItemHasTag(itemID, 'Painting')) 
	&& targetInv.IsBookRead(itemID))
	)
	{
		return true;
	}

	// currency
	if( 
	ACS_Settings_Main_Bool('acs_container_settings','acs_container_take_all_skip_currency_enabled', false) && 
	(targetInv.GetItemName(itemID) == 'Crowns'
	|| targetInv.GetItemName(itemID) == 'Florens'
	|| targetInv.GetItemName(itemID) == 'Orens')
	)
	{
		return true;
	}

	// food
	if( 
	ACS_Settings_Main_Bool('acs_container_settings','acs_container_take_all_skip_food_enabled', false) && 
	targetInv.IsItemFood(itemID) 
	)
	{
		return true;
	}

	// upgrades
	if( 
	ACS_Settings_Main_Bool('acs_container_settings','acs_container_take_all_skip_upgrade_enabled', false) && 
	(targetInv.IsItemUpgrade(itemID)
	|| targetInv.ItemHasTag(itemID, 'MutagenIngredient'))
	)
	{
		return true;
	}

	// horse items
	if( 
	ACS_Settings_Main_Bool('acs_container_settings','acs_container_take_all_skip_horse_items_enabled', false) && 
	(targetInv.IsItemBlinders(itemID) 
	|| targetInv.IsItemHorseBag(itemID)
	|| targetInv.IsItemSaddle(itemID))
	)
	{
		return true;
	}

	// trophies
	if( 
	ACS_Settings_Main_Bool('acs_container_settings','acs_container_take_all_skip_trophies_enabled', false) && 
	targetInv.IsItemTrophy(itemID) 
	)
	{
		return true;
	}

	// toolkit
	if( 
	ACS_Settings_Main_Bool('acs_container_settings','acs_container_take_all_skip_toolkit_enabled', false) && 
	targetInv.IsItemTool(itemID) 
	)
	{
		return true;
	}

	// formulas
	if( 
	ACS_Settings_Main_Bool('acs_container_settings','acs_container_take_all_skip_formulas_enabled', false) && 
	targetInv.IsRecipeOrSchematic(itemID) 
	)
	{
		return true;
	}

	// masks
	if( 
	ACS_Settings_Main_Bool('acs_container_settings','acs_container_take_all_skip_masks_enabled', false) && 
	targetInv.IsItemMask(itemID) 
	)
	{
		return true;
	}
	
	// keys
	if( 
	ACS_Settings_Main_Bool('acs_container_settings','acs_container_take_all_skip_keys_enabled', false) && 
	(itemCategory == 'key'	
	|| (itemCategory == 'misc' && StrContains(NameToString(itemName), "key")))
	)
	{
		return true;
	}

	// others
	if( 
	ACS_Settings_Main_Bool('acs_container_settings','acs_container_take_all_skip_others_enabled', false) 
	&& itemCategory == 'misc'
	&& !StrContains(NameToString(itemName), "key") 
	&& !StrContains(NameToString(itemName), "mh107_fiend_dung") 
	)
	{
		return true;
	}
	
	return false;
}



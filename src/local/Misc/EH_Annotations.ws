	params.effectType = EET_Paralyzed;	
	params.creator = thePlayer;
	params.sourceName = "ACSRageAttackCounter";
							
	params.duration = 3;

	AddEffectCustom(params);
}

@wrapMethod(CR4Player) function PerformCounterCheck(parryInfo: SParryInfo) : bool
{
	var mult 																												: float;
	var parryType																											: EParryType;
	var validCounter, useKnockdown, validCounterForMonsters, validCounterForHumans 											: bool;
	var slideDistance, duration 																							: float;
	var playerToTargetRot																									: EulerAngles;
	var zDifference, mutation8TriggerHP 																					: float;
	var effectType 																											: EEffectType;
	var repelType																											: EPlayerRepelType = PRT_Random;
	var params																												: SCustomEffectParams;
	var thisPos, attackerPos 																								: Vector;
	var isMutation8 																										: bool;
	var fistFightCounter 																									: bool;
	var attackerInventory																									: CInventoryComponent;
	var weaponId																											: SItemUniqueId;
	var weaponTags																											: array<name>;
	var playerToAttackerVector 																								: Vector;
	var tracePosStart																										: Vector;
	var tracePosEnd																											: Vector;
	var hitPos																												: Vector;
	var hitNormal																											: Vector;
	var min, max																											: SAbilityAttributeValue;
	var npc 																												: CNewNPC;
	var electric_fist																										: CACSElectricFist;
	var vfxEnt, parry_fx,  parry_fx_secondary, wound_fx																		: CEntity;
	var dmg																													: W3DamageAction;
	var targetDistance 																										: float;
	var counter_retaliate																									: bool;
	var counterAnimNames																									: array<name>;
	var chosenCounterAnim																									: name;
	var dist																												: float;
	var movementAdjustor 																									: CMovementAdjustor;
	var ticket	 																											: SMovementAdjustmentRequestTicket;	
	var hit_anim_names, sword_counter_names																					: array< name >;
	var counter_sound_names																									: array< string >;
	var damageMax, damageMin																								: float;
	var animatedComponentA 																									: CAnimatedComponent;
	var bPos 																												: Vector;
	var bRot 																												: EulerAngles;
	var boneIndex																											: int;
	var morphedMM																											: CMorphedMeshManagerComponent;
	var counterPassedSecondsInGameTimeEssence, counterPassedSecondsInGameTimeVitality 										: float;
	
	if(false) 
	{
		wrappedMethod(parryInfo);
	}

	if(ShouldProcessTutorial('TutorialDodge') || ShouldProcessTutorial('TutorialCounter'))
	{
		theGame.RemoveTimeScale( theGame.GetTimescaleSource(ETS_TutorialFight) );
		FactsRemove("tut_fight_slomo_ON");
	}
	
	if( ParryCounterCheck() && parryInfo.targetToAttackerAngleAbs < theGame.params.PARRY_HALF_ANGLE)
	{
		npc = (CNewNPC)parryInfo.attacker;

		validCounterForMonsters = ((thePlayer.IsGuarded()) && GetACSWatcher().counterWindowExtendedForEssence && npc.UsesEssence() && ACS_Settings_Main_Float('acs_parry_skills_settings','acs_normal_counter_window_for_silver_health', 1) > 0);

		validCounterForHumans = ((thePlayer.IsGuarded()) && GetACSWatcher().counterWindowExtendedForVitality && npc.UsesVitality() && ACS_Settings_Main_Float('acs_parry_skills_settings','acs_normal_counter_window_for_red_health', 0.5) > 0);

		counterPassedSecondsInGameTimeEssence = theGame.GetEngineTimeAsSeconds() - GetACSWatcher().waitStartTimeEssence;

		counterPassedSecondsInGameTimeVitality = theGame.GetEngineTimeAsSeconds() - GetACSWatcher().waitStartTimeVitality;

		validCounter = (validCounterForMonsters || validCounterForHumans);

		targetDistance = VecDistanceSquared2D( thePlayer.GetWorldPosition(), npc.GetWorldPosition() );
		
		if(validCounter 
		)
		{
			animatedComponentA = (CAnimatedComponent)thePlayer.GetComponentByClassName( 'CAnimatedComponent' );

			animatedComponentA.UnfreezePose();

			animatedComponentA.UnfreezePoseFadeOut(0.01);
			
			thePlayer.RaiseEvent('ACS_TW1AnimsReset');

			thePlayer.SetPlayerTarget( npc );

			thePlayer.SetPlayerCombatTarget( npc );

			thePlayer.UpdateDisplayTarget( true );

			thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( '', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(1.f, 1.f) );

			GCameraShake( ACS_Settings_Main_Float('acs_hud_camera_settings_main','acs_attack_countered_camera_shake_strength', 0.5), true, thePlayer.GetWorldPosition(), 30 );

			if ( IsInCombatActionFriendly() )
			{
				RaiseEvent('CombatActionFriendlyEnd');
			}	
			
			SetBehaviorVariable( 'parryType', ChooseParryTypeIndex( parryInfo ) );
			SetBehaviorVariable( 'counter', (float)validCounter);			
			
			SetBehaviorVariable( 'parryType', ChooseParryTypeIndex( parryInfo ) );
			SetBehaviorVariable( 'counter', (float)validCounter);			
			this.SetBehaviorVariable( 'combatActionType', (int)CAT_Parry );

			if (
			((CNewNPC)npc).HasTag('ACS_Big_Boi')
			|| ((CNewNPC)npc).HasAbility('mon_toad_base')
			|| ((CNewNPC)npc).HasAbility('mon_type_huge')
			|| ((CMovingPhysicalAgentComponent)((npc).GetMovingAgentComponent())).GetCapsuleHeight() >= 2
			|| ((CNewNPC)npc).GetRadius() >= 0.7
			)
			{
				thePlayer.ACS_DealPlayerPostureDamage(30, false);
			}
			else
			{
				thePlayer.ACS_DealPlayerPostureDamage(20, false);
			}
			
			attackerInventory = npc.GetInventory();
			weaponId = attackerInventory.GetItemFromSlot('r_weapon');
			attackerInventory.GetItemTags( weaponId , weaponTags );

			counter_retaliate = false;
			
			if (
			thePlayer.IsHardLockEnabled()
			|| thePlayer.IsWeaponHeld('fist')
			)
			{
				counter_retaliate = true;
			}

			if (thePlayer.HasTag('ACS_Dual_Wield_Active')
			|| thePlayer.HasTag('ACS_Spear_Transform_Active')
			|| targetDistance > 3.5 * 3.5
			|| npc.HasTag('ACS_In_Rage') 
			)
			{
				counter_retaliate = false;
			}

			if (!thePlayer.IsWeaponHeld('fist'))
			{
				if (
				ACS_Settings_Main_Int('acs_parry_skills_settings','acs_default_moveset_human_counter_settings', 1) == 3 
				&& npc.IsHuman() 
				)
				{
					counter_retaliate = false;
				}

				if (
				ACS_Settings_Main_Int('acs_parry_skills_settings','acs_default_moveset_monster_counter_settings', 1) == 3 
				&& npc.IsMonster() 
				)
				{
					counter_retaliate = false;
				}
			}

			if( ((CNewNPC)(npc)).HasAbility('mon_alghoul') 
			&& ((CNewNPC)(npc)).HasAbility('RageActive') 
			&& targetDistance <= 3 * 3
			)
			{
				((CNewNPC)(npc)).StopEffect('morph_fx');
				morphedMM = ((CNewNPC)(npc)).GetMorphedMeshManagerComponent();
				morphedMM.SetMorphBlend( 0, 0.5f );
				((CNewNPC)(npc)).RemoveAbility( 'RageActive' );
				((CNewNPC)(npc)).RemoveAbility( 'Thorns' );

				((CNewNPC)(npc)).SignalGameplayEvent('StopRage');

				counter_retaliate = false;
			}
			
			if( GetWitcherPlayer().IsMutationActive( EPMT_Mutation8 ) )
			{
				isMutation8 = true;
				theGame.GetDefinitionsManager().GetAbilityAttributeValue( 'Mutation8', 'hp_perc_trigger', min, max );
				mutation8TriggerHP = min.valueMultiplicative;
			}
			
			if ( npc.HasAbility('mon_gravehag') )
			{
				repelType = PRT_Slash;
			
				//npc.AddEffectDefault(EET_Stagger, this, "ReflexParryPerformed");

				if (npc.HasAbility('TongueAttack'))
				{
					parryInfo.attacker.AddEffectDefault(EET_CounterStrikeHit, this, 'ReflexParryPerformed');
				}
			}
			else if ( npc && !npc.IsHuman() && !npc.HasTag( 'dettlaff_vampire' ) )
			{
				if (ACS_Armor_Set_Check('manticore', true))
				{
					if (((CMovingPhysicalAgentComponent)(npc.GetMovingAgentComponent())).GetCapsuleHeight() >= 2
					|| npc.GetRadius() >= 0.7
					|| npc.HasAbility('Boss')
					|| npc.HasTag('IsBoss')
					|| npc.HasTag('ACS_Big_Boi')
					)
					{
						useKnockdown = false;
					}
					else
					{
						useKnockdown = true;
					}

					if ( CanUseSkill(S_Sword_s11) )
					{
						if( GetSkillLevel(S_Sword_s11) > 1 && RandRangeF(3,0) < GetWitcherPlayer().GetStat(BCS_Focus) )
						{
							duration = CalculateAttributeValue(GetSkillAttributeValue(S_Sword_s11, 'duration', false, true));
							useKnockdown = true;
						}
					}
				
					if(useKnockdown && (!npc.IsImmuneToBuff(EET_HeavyKnockdown) || !npc.IsImmuneToBuff(EET_Knockdown)))
					{
						if(!npc.IsImmuneToBuff(EET_HeavyKnockdown))
						{
							params.effectType = EET_HeavyKnockdown;
						}
						else
						{
							params.effectType = EET_Knockdown;
						}
						
						repelType = PRT_Random;
						params.creator = this;
						params.sourceName = "ReflexParryPerformed";
						
						if ( CanUseSkill(S_Sword_s11) )
						{
							params.duration = duration;
						}
						else
						{
							params.duration = 0.5;
						}

						if (counter_retaliate)
						{
							//npc.AddEffectCustom(params);

							if(!npc.IsImmuneToBuff(EET_HeavyKnockdown))
							{
								npc.AddTimer('ACS_AddHeavyKnockdownDelay', 0.3 , false );

							}
							else
							{
								npc.AddTimer('ACS_AddKnockdownDelay', 0.3 , false );
							}
						}
					}
					else
					{
						if (counter_retaliate)
						{
							//npc.AddEffectDefault(EET_Stagger, this, "ReflexParryPerformed");

							npc.AddTimer('ACS_AddStaggerDelay', 0.3 , false );
						}
					}
				}
				else
				{
					if (thePlayer.IsWeaponHeld('fist') 
					)
					{	
						if (!thePlayer.HasTag('acs_vampire_claws_equipped')
						&& !thePlayer.HasTag('acs_sorc_fists_equipped')
						)
						{
							if(useKnockdown && !npc.IsImmuneToBuff(EET_LongStagger) )
							{
								repelType = PRT_Kick;
								params.creator = this;
								params.sourceName = "ReflexParryPerformed";
								
								if ( CanUseSkill(S_Sword_s11) )
								{
									params.duration = duration;
								}
								else
								{
									params.duration = 0.5;
								}
								
								if (counter_retaliate)
								{
									//npc.AddEffectCustom(params);

									npc.AddTimer('ACS_AddLongStaggerDelay', 0.3 , false );
								}
							}
							else
							{
								if (counter_retaliate)
								{
									//npc.AddEffectDefault(EET_Stagger, this, "ReflexParryPerformed");

									npc.AddTimer('ACS_AddStaggerDelay', 0.3 , false );
								}
							}

							thePlayer.SoundEvent("cmb_fistfight_parry");

							if(GetWitcherPlayer().IsAnyQuenActive()
							&& ACS_Settings_Main_Bool('acs_signs_settings','acs_quen_electric_discharge_enabled', true)
							)
							{
								electric_fist = (CACSElectricFist)theGame.CreateEntity((CEntityTemplate)LoadResource("dlc\dlc_acs\data\fx\electric_fist\acs_electric_fist.w2ent",true), 
								((npc.GetWorldPosition() + ((npc.GetWorldPosition() + thePlayer.GetWorldPosition()) * 0.5)) * 0.5) + Vector(0, 0, RandRangeF(1.25f,1.125f)), 
								npc.GetWorldRotation() );

								electric_fist.DestroyAfter(3);
							}
							else
							{
								vfxEnt = theGame.CreateEntity( (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\fx\blood_fx.w2ent", true ), 
								((npc.GetWorldPosition() + ((npc.GetWorldPosition() + thePlayer.GetWorldPosition()) * 0.5)) * 0.5) + Vector(0, 0, RandRangeF(1.25f,1.125f)), 
								npc.GetWorldRotation() );

								vfxEnt.PlayEffectSingle('fist_hit_indicator');
								vfxEnt.PlayEffectSingle('hit_refraction_red');
								vfxEnt.DestroyAfter(1.5);
							}
							
							if (GetACSWatcher().PerformUnarmedFinisherCheck(((CNewNPC)npc)))
							{
								GetACSWatcher().InitiateFinisherChain(true);
							}
						}
					}
					else
					{
						if (
						((CNewNPC)npc).HasTag('ACS_Big_Boi')
						|| ((CNewNPC)npc).HasAbility('mon_toad_base')
						|| ((CNewNPC)npc).HasAbility('mon_type_huge')
						|| ((CMovingPhysicalAgentComponent)((npc).GetMovingAgentComponent())).GetCapsuleHeight() >= 2
						|| ((CNewNPC)npc).GetRadius() >= 0.7
						|| ((CNewNPC)npc).IsFlying()
						|| npc.IsInAir()
						|| !thePlayer.WasVisibleInScaledFrame( npc, 1.f, 1.f )
						)
						{
							repelType = PRT_SideStepSlash;
						}
						else
						{
							switch(ACS_Settings_Main_Int('acs_parry_skills_settings','acs_default_moveset_monster_counter_settings', 1))
							{
								case 0:
								repelType = PRT_SideStepSlash;
								break;

								case 1:
								acs_player_counter_index = RandDifferent(this.previous_acs_player_counter_index , 2);

								switch (acs_player_counter_index) 
								{
									case 1:
								
									if (((CMovingPhysicalAgentComponent)(npc.GetMovingAgentComponent())).GetCapsuleHeight() >= 2
									|| npc.GetRadius() >= 0.7
									|| npc.HasAbility('Boss')
									|| npc.HasTag('IsBoss')
									|| npc.HasTag('ACS_Big_Boi')
									)
									{
										useKnockdown = false;
									}
									else
									{
										useKnockdown = true;
									}

									if ( CanUseSkill(S_Sword_s11) )
									{
										if( GetSkillLevel(S_Sword_s11) > 1 && RandRangeF(3,0) < GetWitcherPlayer().GetStat(BCS_Focus) )
										{
											duration = CalculateAttributeValue(GetSkillAttributeValue(S_Sword_s11, 'duration', false, true));
											useKnockdown = true;
										}
									}
									
									if(useKnockdown && (!npc.IsImmuneToBuff(EET_HeavyKnockdown) || !npc.IsImmuneToBuff(EET_Knockdown)))
									{
										if(!npc.IsImmuneToBuff(EET_HeavyKnockdown))
										{
											params.effectType = EET_HeavyKnockdown;
										}
										else
										{
											params.effectType = EET_Knockdown;
										}
										
										repelType = PRT_Random;
										params.creator = this;
										params.sourceName = "ReflexParryPerformed";

										if ( CanUseSkill(S_Sword_s11) )
										{
											params.duration = duration;
										}
										else
										{
											params.duration = 0.5;
										}
										
										if (counter_retaliate)
										{
											//npc.AddEffectCustom(params);

											if(!npc.IsImmuneToBuff(EET_HeavyKnockdown))
											{
												npc.AddTimer('ACS_AddHeavyKnockdownDelay', 0.3 , false );
											}
											else
											{
												npc.AddTimer('ACS_AddKnockdownDelay', 0.3 , false );
											}
										}
									}
									else
									{
										if (counter_retaliate)
										{
											//npc.AddEffectDefault(EET_Stagger, this, "ReflexParryPerformed");

											npc.AddTimer('ACS_AddStaggerDelay', 0.3 , false );
										}
									}
								
									break;

									case 0:
									repelType = PRT_SideStepSlash;
									break;

									default:
									repelType = PRT_SideStepSlash;
									break;
								}
								this.previous_acs_player_counter_index = acs_player_counter_index;
								break;

								case 2:
							
								if (((CMovingPhysicalAgentComponent)(npc.GetMovingAgentComponent())).GetCapsuleHeight() >= 2
								|| npc.GetRadius() >= 0.7
								|| npc.HasAbility('Boss')
								|| npc.HasTag('IsBoss')
								|| npc.HasTag('ACS_Big_Boi')
								)
								{
									useKnockdown = false;
								}
								else
								{
									useKnockdown = true;
								}

								if ( CanUseSkill(S_Sword_s11) )
								{
									if( GetSkillLevel(S_Sword_s11) > 1 && RandRangeF(3,0) < GetWitcherPlayer().GetStat(BCS_Focus) )
									{
										duration = CalculateAttributeValue(GetSkillAttributeValue(S_Sword_s11, 'duration', false, true));
										useKnockdown = true;
									}
								}

								if(useKnockdown && (!npc.IsImmuneToBuff(EET_HeavyKnockdown) || !npc.IsImmuneToBuff(EET_Knockdown)))
								{
									if(!npc.IsImmuneToBuff(EET_HeavyKnockdown))
									{
										params.effectType = EET_HeavyKnockdown;
									}
									else
									{
										params.effectType = EET_Knockdown;
									}
									
									repelType = PRT_Random;
									params.creator = this;
									params.sourceName = "ReflexParryPerformed";

									if ( CanUseSkill(S_Sword_s11) )
									{
										params.duration = duration;
									}
									else
									{
										params.duration = 0.5;
									}
									
									if (counter_retaliate)
									{
										//npc.AddEffectCustom(params);

										if(!npc.IsImmuneToBuff(EET_HeavyKnockdown))
										{
											npc.AddTimer('ACS_AddHeavyKnockdownDelay', 0.3 , false );
										}
										else
										{
											npc.AddTimer('ACS_AddKnockdownDelay', 0.3 , false );
										}
									}
								}
								else
								{
									if (counter_retaliate)
									{
										//npc.AddEffectDefault(EET_Stagger, this, "ReflexParryPerformed");

										npc.AddTimer('ACS_AddStaggerDelay', 0.3 , false );
									}
								}
							
								break;

								default:
								repelType = PRT_SideStepSlash;
								break;
							}
						}
					}
				}
			}
			else if ( weaponTags.Contains('spear2h') 
			|| weaponTags.Contains('axe2h')
			|| weaponTags.Contains('hammer2h')
			|| weaponTags.Contains('halberd2h')
			)
			{
				repelType = PRT_SideStepSlash;

				if (counter_retaliate)
				{
					//npc.AddEffectDefault(EET_Stagger, this, "ReflexParryPerformed");

					npc.AddTimer('ACS_AddStaggerDelay', 0.3 , false );
				}

				if (npc.acs_2h_weapon_destruction_counter >= 3
				&& !npc.HasTag('ACS_2HandWeaponDestroyed')
				)
				{
					npc.SignalGameplayEvent( 'SpearDestruction');
					((CNewNPC)npc).ProcessSpearDestruction();

					npc.ACS_Manage2HWeaponDestructionCounter(true);

					npc.AddTag('ACS_2HandWeaponDestroyed');
				}
				else
				{
					npc.ACS_Manage2HWeaponDestructionCounter(false);
				}
			}
			else
			{
				if (ACS_Armor_Set_Check('manticore', true))
				{
					if (((CMovingPhysicalAgentComponent)(npc.GetMovingAgentComponent())).GetCapsuleHeight() >= 2
					|| npc.GetRadius() >= 0.7
					|| npc.HasAbility('Boss')
					|| npc.HasTag('IsBoss')
					|| npc.HasTag('ACS_Big_Boi')
					)
					{
						useKnockdown = false;
					}
					else
					{
						useKnockdown = true;
					}

					if ( CanUseSkill(S_Sword_s11) )
					{
						if( GetSkillLevel(S_Sword_s11) > 1 && RandRangeF(3,0) < GetWitcherPlayer().GetStat(BCS_Focus) )
						{
							duration = CalculateAttributeValue(GetSkillAttributeValue(S_Sword_s11, 'duration', false, true));
							useKnockdown = true;
						}
					}
				
					if(useKnockdown && (!npc.IsImmuneToBuff(EET_HeavyKnockdown) || !npc.IsImmuneToBuff(EET_Knockdown)))
					{
						if(!npc.IsImmuneToBuff(EET_HeavyKnockdown))
						{
							params.effectType = EET_HeavyKnockdown;
						}
						else
						{
							params.effectType = EET_Knockdown;
						}
						
						repelType = PRT_Random;
						params.creator = this;
						params.sourceName = "ReflexParryPerformed";
						
						if ( CanUseSkill(S_Sword_s11) )
						{
							params.duration = duration;
						}
						else
						{
							params.duration = 0.5;
						}
						
						if (counter_retaliate)
						{
							//npc.AddEffectCustom(params);

							if(!npc.IsImmuneToBuff(EET_HeavyKnockdown))
							{
								npc.AddTimer('ACS_AddHeavyKnockdownDelay', 0.3 , false );
							}
							else
							{
								npc.AddTimer('ACS_AddKnockdownDelay', 0.3 , false );
							}
						}
					}
					else
					{
						if (counter_retaliate)
						{
							//npc.AddEffectDefault(EET_Stagger, this, "ReflexParryPerformed");

							npc.AddTimer('ACS_AddStaggerDelay', 0.3 , false );
						}
					}
				}
				else
				{
					if (thePlayer.IsWeaponHeld('fist') 
					)
					{	
						if (!thePlayer.HasTag('acs_vampire_claws_equipped')
						&& !thePlayer.HasTag('acs_sorc_fists_equipped')
						)
						{
							if(useKnockdown && !npc.IsImmuneToBuff(EET_LongStagger))
							{
								repelType = PRT_Kick;
								params.creator = this;
								params.sourceName = "ReflexParryPerformed";
								
								if ( CanUseSkill(S_Sword_s11) )
								{
									params.duration = duration;
								}
								else
								{
									params.duration = 0.5;
								}
								
								if (counter_retaliate)
								{
									//npc.AddEffectCustom(params);

									npc.AddTimer('ACS_AddLongStaggerDelay', 0.3 , false );
								}
							}
							else
							{
								if (counter_retaliate)
								{
									//npc.AddEffectDefault(EET_Stagger, this, "ReflexParryPerformed");

									npc.AddTimer('ACS_AddStaggerDelay', 0.3 , false );
								}
							}

							thePlayer.SoundEvent("cmb_fistfight_parry");

							if(GetWitcherPlayer().IsAnyQuenActive()
							&& ACS_Settings_Main_Bool('acs_signs_settings','acs_quen_electric_discharge_enabled', true)
							)
							{
								electric_fist = (CACSElectricFist)theGame.CreateEntity((CEntityTemplate)LoadResource("dlc\dlc_acs\data\fx\electric_fist\acs_electric_fist.w2ent",true), 
								((npc.GetWorldPosition() + ((npc.GetWorldPosition() + thePlayer.GetWorldPosition()) * 0.5)) * 0.5) + Vector(0, 0, RandRangeF(1.25f,1.125f)), 
								npc.GetWorldRotation() );

								electric_fist.DestroyAfter(3);
							}
							else
							{
								vfxEnt = theGame.CreateEntity( (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\fx\blood_fx.w2ent", true ), 
								((npc.GetWorldPosition() + ((npc.GetWorldPosition() + thePlayer.GetWorldPosition()) * 0.5)) * 0.5) + Vector(0, 0, RandRangeF(1.25f,1.125f)), 
								npc.GetWorldRotation() );

								vfxEnt.PlayEffectSingle('fist_hit_indicator');
								vfxEnt.PlayEffectSingle('hit_refraction_red');
								vfxEnt.DestroyAfter(1.5);
							}
							
							if (GetACSWatcher().PerformUnarmedFinisherCheck(((CNewNPC)npc)))
							{
								GetACSWatcher().InitiateFinisherChain(true);
							}
						}
					}
					else
					{
						if (
						((CNewNPC)npc).HasTag('ACS_Big_Boi')
						|| ((CNewNPC)npc).HasAbility('mon_toad_base')
						|| ((CNewNPC)npc).HasAbility('mon_type_huge')
						|| ((CMovingPhysicalAgentComponent)((npc).GetMovingAgentComponent())).GetCapsuleHeight() >= 2
						|| ((CNewNPC)npc).GetRadius() >= 0.7
						|| ((CNewNPC)npc).IsFlying()
						|| ((CNewNPC)npc).HasTag('ACS_Big_Boi')
						|| npc.IsInAir()
						|| !thePlayer.WasVisibleInScaledFrame( npc, 1.f, 1.f )
						)
						{
							repelType = PRT_SideStepSlash;
						}
						else
						{
							switch(ACS_Settings_Main_Int('acs_parry_skills_settings','acs_default_moveset_human_counter_settings', 1))
							{
								case 0:
							
									if (((CMovingPhysicalAgentComponent)(npc.GetMovingAgentComponent())).GetCapsuleHeight() >= 2
									|| npc.GetRadius() >= 0.7
									|| npc.HasAbility('Boss')
									|| npc.HasTag('IsBoss')
									|| npc.HasTag('ACS_Big_Boi')
									)
									{
										useKnockdown = false;
									}
									else
									{
										useKnockdown = true;
									}

									if ( CanUseSkill(S_Sword_s11) )
									{
										if( GetSkillLevel(S_Sword_s11) > 1 && RandRangeF(3,0) < GetWitcherPlayer().GetStat(BCS_Focus) )
										{
											duration = CalculateAttributeValue(GetSkillAttributeValue(S_Sword_s11, 'duration', false, true));
											useKnockdown = true;
										}
									}
								
									if(useKnockdown && (!npc.IsImmuneToBuff(EET_HeavyKnockdown) || !npc.IsImmuneToBuff(EET_Knockdown)))
									{
										if(!npc.IsImmuneToBuff(EET_HeavyKnockdown))
										{
											params.effectType = EET_HeavyKnockdown;
										}
										else
										{
											params.effectType = EET_Knockdown;
										}
										
										repelType = PRT_Random;
										params.creator = this;
										params.sourceName = "ReflexParryPerformed";

										if ( CanUseSkill(S_Sword_s11) )
										{
											params.duration = duration;
										}
										else
										{
											params.duration = 0.5;
										}
										
										if (counter_retaliate)
										{
											//npc.AddEffectCustom(params);

											if(!npc.IsImmuneToBuff(EET_HeavyKnockdown))
											{
												npc.AddTimer('ACS_AddHeavyKnockdownDelay', 0.3 , false );
											}
											else
											{
												npc.AddTimer('ACS_AddKnockdownDelay', 0.3 , false );
											}
										}
									}
									else
									{
										if (counter_retaliate)
										{
											//npc.AddEffectDefault(EET_Stagger, this, "ReflexParryPerformed");

											npc.AddTimer('ACS_AddStaggerDelay', 0.3 , false );
										}
									}
							
								break;

								case 1:
									acs_player_counter_index = RandDifferent(this.previous_acs_player_counter_index , 2);

									switch (acs_player_counter_index) 
									{
										case 1:
										repelType = PRT_SideStepSlash;
										break;

										case 0:
									
										if (((CMovingPhysicalAgentComponent)(npc.GetMovingAgentComponent())).GetCapsuleHeight() >= 2
										|| npc.GetRadius() >= 0.7
										|| npc.HasAbility('Boss')
										|| npc.HasTag('IsBoss')
										|| npc.HasTag('ACS_Big_Boi')
										)
										{
											useKnockdown = false;
										}
										else
										{
											useKnockdown = true;
										}

										if ( CanUseSkill(S_Sword_s11) )
										{
											if( GetSkillLevel(S_Sword_s11) > 1 && RandRangeF(3,0) < GetWitcherPlayer().GetStat(BCS_Focus) )
											{
												duration = CalculateAttributeValue(GetSkillAttributeValue(S_Sword_s11, 'duration', false, true));
												useKnockdown = true;
											}
										}
										
										if(useKnockdown && (!npc.IsImmuneToBuff(EET_HeavyKnockdown) || !npc.IsImmuneToBuff(EET_Knockdown)))
										{
											if(!npc.IsImmuneToBuff(EET_HeavyKnockdown))
											{
												params.effectType = EET_HeavyKnockdown;
											}
											else
											{
												params.effectType = EET_Knockdown;
											}
											
											repelType = PRT_Random;
											params.creator = this;
											params.sourceName = "ReflexParryPerformed";

											if ( CanUseSkill(S_Sword_s11) )
											{
												params.duration = duration;
											}
											else
											{
												params.duration = 0.5;
											}
												
											if (counter_retaliate)
											{
												//npc.AddEffectCustom(params);

												if(!npc.IsImmuneToBuff(EET_HeavyKnockdown))
												{
													npc.AddTimer('ACS_AddHeavyKnockdownDelay', 0.3 , false );
												}
												else
												{
													npc.AddTimer('ACS_AddKnockdownDelay', 0.3 , false );
												}
											}
										}
										else
										{
											if (counter_retaliate)
											{
												//npc.AddEffectDefault(EET_Stagger, this, "ReflexParryPerformed");

												npc.AddTimer('ACS_AddStaggerDelay', 0.3 , false );
											}
										}
										break;

										default:
									
										if (((CMovingPhysicalAgentComponent)(npc.GetMovingAgentComponent())).GetCapsuleHeight() >= 2
										|| npc.GetRadius() >= 0.7
										|| npc.HasAbility('Boss')
										|| npc.HasTag('IsBoss')
										|| npc.HasTag('ACS_Big_Boi')
										)
										{
											useKnockdown = false;
										}
										else
										{
											useKnockdown = true;
										}

										if ( CanUseSkill(S_Sword_s11) )
										{
											if( GetSkillLevel(S_Sword_s11) > 1 && RandRangeF(3,0) < GetWitcherPlayer().GetStat(BCS_Focus) )
											{
												duration = CalculateAttributeValue(GetSkillAttributeValue(S_Sword_s11, 'duration', false, true));
												useKnockdown = true;
											}
										}
										
										if(useKnockdown && (!npc.IsImmuneToBuff(EET_HeavyKnockdown) || !npc.IsImmuneToBuff(EET_Knockdown)))
										{
											if(!npc.IsImmuneToBuff(EET_HeavyKnockdown))
											{
												params.effectType = EET_HeavyKnockdown;
											}
											else
											{
												params.effectType = EET_Knockdown;
											}
											
											repelType = PRT_Random;
											params.creator = this;
											params.sourceName = "ReflexParryPerformed";

											if ( CanUseSkill(S_Sword_s11) )
											{
												params.duration = duration;
											}
											else
											{
												params.duration = 0.5;
											}
												
											if (counter_retaliate)
											{
												//npc.AddEffectCustom(params);

												if(!npc.IsImmuneToBuff(EET_HeavyKnockdown))
												{
													npc.AddTimer('ACS_AddHeavyKnockdownDelay', 0.3 , false );
												}
												else
												{
													npc.AddTimer('ACS_AddKnockdownDelay', 0.3 , false );
												}
											}
										}
										else
										{
											if (counter_retaliate)
											{
												//npc.AddEffectDefault(EET_Stagger, this, "ReflexParryPerformed");

												npc.AddTimer('ACS_AddStaggerDelay', 0.3 , false );
											}
										}
									
										break;
									}
									this.previous_acs_player_counter_index = acs_player_counter_index;
								break;

								case 2:
									repelType = PRT_SideStepSlash;
								break;

								default:
							
									if (((CMovingPhysicalAgentComponent)(npc.GetMovingAgentComponent())).GetCapsuleHeight() >= 2
									|| npc.GetRadius() >= 0.7
									|| npc.HasAbility('Boss')
									|| npc.HasTag('IsBoss')
									|| npc.HasTag('ACS_Big_Boi')
									)
									{
										useKnockdown = false;
									}
									else
									{
										useKnockdown = true;
									}

									if ( CanUseSkill(S_Sword_s11) )
									{
										if( GetSkillLevel(S_Sword_s11) > 1 && RandRangeF(3,0) < GetWitcherPlayer().GetStat(BCS_Focus) )
										{
											duration = CalculateAttributeValue(GetSkillAttributeValue(S_Sword_s11, 'duration', false, true));
											useKnockdown = true;
										}
									}
								
									if(useKnockdown && (!npc.IsImmuneToBuff(EET_HeavyKnockdown) || !npc.IsImmuneToBuff(EET_Knockdown)))
									{
										if(!npc.IsImmuneToBuff(EET_HeavyKnockdown))
										{
											params.effectType = EET_HeavyKnockdown;
										}
										else
										{
											params.effectType = EET_Knockdown;
										}
										
										repelType = PRT_Random;
										params.creator = this;
										params.sourceName = "ReflexParryPerformed";

										if ( CanUseSkill(S_Sword_s11) )
										{
											params.duration = duration;
										}
										else
										{
											params.duration = 0.5;
										}
										
										if (counter_retaliate)
										{
											//npc.AddEffectCustom(params);

											if(!npc.IsImmuneToBuff(EET_HeavyKnockdown))
											{
												npc.AddTimer('ACS_AddHeavyKnockdownDelay', 0.3 , false );
											}
											else
											{
												npc.AddTimer('ACS_AddKnockdownDelay', 0.3 , false );
											}
										}
									}
									else
									{
										if (counter_retaliate)
										{
											//npc.AddEffectDefault(EET_Stagger, this, "ReflexParryPerformed");

											npc.AddTimer('ACS_AddStaggerDelay', 0.3 , false );
										}
									}
							
								break;
							}
						}
					}
				}
			}
			
			if ( repelType == PRT_Random )
			{
				if (
				((CNewNPC)npc).HasTag('ACS_Big_Boi')
				|| ((CNewNPC)npc).HasAbility('mon_toad_base')
				|| ((CNewNPC)npc).HasAbility('mon_type_huge')
				|| ((CMovingPhysicalAgentComponent)((npc).GetMovingAgentComponent())).GetCapsuleHeight() >= 2
				|| ((CNewNPC)npc).GetRadius() >= 0.7
				|| ((CNewNPC)npc).IsFlying()
				|| npc.IsInAir()
				|| !thePlayer.WasVisibleInScaledFrame( npc, 1.f, 1.f )
				)
				{
					repelType = PRT_SideStepSlash;
				}
				else
				{
					if ( GetACSWatcher().Attack_Directional_Press_Check() )
					{
						repelType = PRT_Kick;
					}
					else
					{
						repelType = PRT_Bash;
					}
				}
					
			}

			ACS_CounterAction(parryInfo, repelType, counter_retaliate);

			theGame.GetGamerProfile().IncStat(ES_CounterattackChain);
			
		}
		else
		{
			ResetUninterruptedHitsCount();
		}

		return validCounter;
	}			
	
	return false;
}

@addMethod(CR4Player) function ACS_CounterAction(parryInfo: SParryInfo, repelType : EPlayerRepelType, counter_retaliate : bool)
{
	var mult 																												: float;
	var parryType																											: EParryType;
	var validCounter, useKnockdown, validCounterForMonsters, validCounterForHumans 											: bool;
	var slideDistance, duration 																							: float;
	var playerToTargetRot																									: EulerAngles;
	var zDifference, mutation8TriggerHP 																					: float;
	var effectType 																											: EEffectType;
	var params																												: SCustomEffectParams;
	var thisPos, attackerPos 																								: Vector;
	var isMutation8 																										: bool;
	var fistFightCounter 																									: bool;
	var attackerInventory																									: CInventoryComponent;
	var weaponId																											: SItemUniqueId;
	var weaponTags																											: array<name>;
	var playerToAttackerVector 																								: Vector;
	var tracePosStart																										: Vector;
	var tracePosEnd																											: Vector;
	var hitPos																												: Vector;
	var hitNormal																											: Vector;
	var min, max																											: SAbilityAttributeValue;
	var npc 																												: CNewNPC;
	var electric_fist																										: CACSElectricFist;
	var vfxEnt, parry_fx,  parry_fx_secondary, wound_fx																		: CEntity;
	var dmg																													: W3DamageAction;
	var targetDistance 																										: float;
	var counterAnimNames																									: array<name>;
	var chosenCounterAnim																									: name;
	var dist																												: float;
	var movementAdjustor 																									: CMovementAdjustor;
	var ticket	 																											: SMovementAdjustmentRequestTicket;	
	var hit_anim_names, sword_counter_names																					: array< name >;
	var counter_sound_names																									: array< string >;
	var damageMax, damageMin																								: float;
	var animatedComponentA 																									: CAnimatedComponent;
	var bPos 																												: Vector;
	var bRot 																												: EulerAngles;
	var boneIndex 																											: int;
	var morphedMM																											: CMorphedMeshManagerComponent;
	var counterPassedSecondsInGameTimeEssence, counterPassedSecondsInGameTimeVitality 										: float;
	
	npc = (CNewNPC)parryInfo.attacker;

	targetDistance = VecDistanceSquared2D( thePlayer.GetWorldPosition(), npc.GetWorldPosition() );

	npc.GetInventory().PlayItemEffect(parryInfo.attackerWeaponId, 'counterattack');

	GetACSWatcher().RemoveTimer('RemoveSignComboStuffRepeating');
	GetACSWatcher().RemoveTimer('RemoveSignComboStuff');
	GetACSWatcher().AddTimer('RemoveSignComboStuff', 20 , false );

	movementAdjustor = thePlayer.GetMovingAgentComponent().GetMovementAdjustor();

	ticket = movementAdjustor.GetRequest( 'ACSMovAdj');
	movementAdjustor.CancelByName( 'ACSMovAdj' );
	movementAdjustor.CancelAll();

	ticket = movementAdjustor.CreateNewRequest( 'ACSMovAdj' );
	movementAdjustor.MaxRotationAdjustmentSpeed( ticket, 50000 );
	movementAdjustor.RotateTowards( ticket, npc );

	counterPassedSecondsInGameTimeEssence = theGame.GetEngineTimeAsSeconds() - GetACSWatcher().waitStartTimeEssence;

	counterPassedSecondsInGameTimeVitality = theGame.GetEngineTimeAsSeconds() - GetACSWatcher().waitStartTimeVitality;
	
	if (
	counterPassedSecondsInGameTimeEssence <= 0.33
	|| counterPassedSecondsInGameTimeVitality <= 0.33
	)
	{
		if (npc.HasTag('ACS_In_Rage') 
		)
		{
			((CNewNPC)npc).ACS_DealPostureDamage(50);
		}
		else
		{
			((CNewNPC)npc).ACS_DealPostureDamage(40);
		}

		if (thePlayer.IsDeadlySwordHeld()
		&& !npc.HasTag('ACS_Final_Fear_Stack')
		)
		{
			thePlayer.SoundEvent('wall_a1_bb_acs');

			dmg = new W3DamageAction in theGame.damageMgr;

			dmg.Initialize(thePlayer, npc, NULL, thePlayer.GetName(), EHRT_Light, CPS_Undefined, false, false, true, false);

			dmg.SetIgnoreImmortalityMode(false);

			dmg.SetHitReactionType( EHRT_Light, true);

			dmg.SetHitAnimationPlayType(EAHA_ForceYes);

			dmg.SetCanPlayHitParticle(false);

			dmg.SetSuppressHitSounds(true);

			if (thePlayer.HasTag('ACS_Flammable_Oil_Enabled'))
			{
				if (ACS_GetItem_SwordHeldSwitchBasedUponStat('frost_sword'))
				{
					dmg.AddEffectInfo( EET_Frozen, 3 );
				}
				else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('poison_sword'))
				{
					dmg.AddEffectInfo( EET_Poison, 3 );
				}
				else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('bleed_sword'))
				{
					dmg.AddEffectInfo( EET_Bleeding, 3 );
				}
				else
				{
					dmg.AddEffectInfo( EET_Burning, 3 );
				}	

				dmg.AddDamage( theGame.params.DAMAGE_NAME_DIRECT, 1 );
			}
			
			theGame.damageMgr.ProcessAction( dmg );
		}
	}
	else
	{
		if (npc.HasTag('ACS_In_Rage') 
		)
		{
			((CNewNPC)npc).ACS_DealPostureDamage(30);
		}
		else
		{
			((CNewNPC)npc).ACS_DealPostureDamage(20);
		}
	}

	if (GetACSWatcher().playerContactWithNpc){movementAdjustor.MaxLocationAdjustmentDistance( ticket, 0 );} 

	if (thePlayer.IsAnyWeaponHeld()
	&& !thePlayer.IsWeaponHeld('fist')
	)
	{
		sword_counter_names.Clear();

		if(thePlayer.GetCombatIdleStance() > 0.f )
		{
			sword_counter_names.PushBack('ACS_SwordCounterAdditive01');
			sword_counter_names.PushBack('ACS_SwordCounterAdditive02');
			//sword_counter_names.PushBack('ACS_SwordCounterAdditive03');
			//sword_counter_names.PushBack('ACS_SwordCounterAdditive04');
			//sword_counter_names.PushBack('ACS_SwordCounterAdditive05');
			//sword_counter_names.PushBack('ACS_SwordCounterAdditive06');
			sword_counter_names.PushBack('ACS_SwordCounterAdditive07');
			sword_counter_names.PushBack('ACS_SwordCounterAdditive08');
		}
		else
		{
			sword_counter_names.PushBack('ACS_SwordCounterAdditive09');
			sword_counter_names.PushBack('ACS_SwordCounterAdditive10');
			//sword_counter_names.PushBack('ACS_SwordCounterAdditive11');
			//sword_counter_names.PushBack('ACS_SwordCounterAdditive12');
			//sword_counter_names.PushBack('ACS_SwordCounterAdditive13');
			//sword_counter_names.PushBack('ACS_SwordCounterAdditive14');
			sword_counter_names.PushBack('ACS_SwordCounterAdditive15');
			sword_counter_names.PushBack('ACS_SwordCounterAdditive16');
		}
		
		thePlayer.RaiseEvent( sword_counter_names[RandRange(sword_counter_names.Size())]);

		if (!thePlayer.HasTag('ACS_Counter_Initiated'))
		{
			thePlayer.AddTag('ACS_Counter_Initiated');
		}
	}

	if (counter_retaliate)
	{
		if (thePlayer.IsAnyWeaponHeld() 
		)
		{
			if (!thePlayer.IsWeaponHeld('fist'))
			{
				if (repelType == PRT_Kick)
				{
					if (thePlayer.HasTag('ACS_Counter_Initiated'))
					{
						thePlayer.RaiseEvent('ACS_SwordCounterAdditiveReset');

						thePlayer.RemoveTag('ACS_Counter_Initiated');
					}

					if(thePlayer.GetCombatIdleStance() <= 0.f )
					{
						GetACSWatcher().PlayerPlayAnimation( 'man_geralt_sword_repel_lp_kick_ACS');	
					}
					else
					{
						GetACSWatcher().PlayerPlayAnimation( 'man_geralt_sword_repel_rp_kick_ACS');	
					}
				}
				else if (repelType == PRT_Bash)
				{
					if (thePlayer.HasTag('ACS_Counter_Initiated'))
					{
						thePlayer.RaiseEvent('ACS_SwordCounterAdditiveReset');

						thePlayer.RemoveTag('ACS_Counter_Initiated');
					}

					npc.RemoveTimer('ACS_AddKnockdownDelay');
					npc.RemoveTimer('ACS_AddHeavyKnockdownDelay');

					counterAnimNames.Clear();

					if(thePlayer.GetCombatIdleStance() <= 0.f )
					{
						counterAnimNames.PushBack('man_geralt_sword_repel_lp_bash_ACS');

						counterAnimNames.PushBack('man_finisher_hilt_01_lp_ACS');

						if (RandF() < 0.25)
						{
							counterAnimNames.PushBack('man_finisher_head_01_lp_ACS');
						}
						else
						{
							counterAnimNames.PushBack('man_finisher_hilt_01_lp_ACS');
						}
					}
					else
					{
						counterAnimNames.PushBack('man_geralt_sword_repel_rp_bash_ACS');

						counterAnimNames.PushBack('man_finisher_hilt_01_rp_ACS');

						if (RandF() < 0.25)
						{
							counterAnimNames.PushBack('man_finisher_head_01_rp_ACS');
						}
						else
						{
							counterAnimNames.PushBack('man_finisher_hilt_01_rp_ACS');
						}
					}

					chosenCounterAnim = counterAnimNames[RandRange(counterAnimNames.Size())];

					if (chosenCounterAnim == 'man_finisher_hilt_01_lp_ACS'
					|| chosenCounterAnim == 'man_finisher_hilt_01_rp_ACS'
					)
					{
						npc.AddTimer('ACS_AddStaggerDelay', 0.4 , false );
					}
					else
					{
						npc.AddTimer('ACS_AddStaggerDelay', 0.3 , false );
					}

					GetACSWatcher().PlayerPlayAnimation(chosenCounterAnim);
				}
				else
				{
					GetACSWatcher().PerformCounter();
				}
			}
			else
			{
				if (thePlayer.HasTag('acs_vampire_claws_equipped')
				)
				{
					hit_anim_names.Clear();

					if ( RandF() < 0.5 )
					{
						hit_anim_names.PushBack('parry_left_01_ACS');
						hit_anim_names.PushBack('parry_left_back_01_ACS');
						hit_anim_names.PushBack('parry_left_back_02_ACS');

						GetWitcherPlayer().StopEffect('left_sparks');
						GetWitcherPlayer().PlayEffectSingle('left_sparks');
					}
					else
					{
						hit_anim_names.PushBack('parry_right_01_ACS');
						hit_anim_names.PushBack('parry_right_back_01_ACS');
						hit_anim_names.PushBack('parry_right_back_02_ACS');

						GetWitcherPlayer().StopEffect('right_sparks');
						GetWitcherPlayer().PlayEffectSingle('right_sparks');
					}
					
					thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( hit_anim_names[RandRange(hit_anim_names.Size())], 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.875f) );
				}
				else if (thePlayer.HasTag('acs_sorc_fists_equipped')
				)
				{
					if(thePlayer.GetCombatIdleStance() <= 0.f )
					{
						GetACSWatcher().PlayerPlayAnimation( 'woman_sorceress_attack_push_rp_ACS');	
					}
					else
					{
						GetACSWatcher().PlayerPlayAnimation( 'woman_sorceress_attack_push_lp_02_ACS');	
					}

					GetACSWatcher().sorcfxspawn('ACS_Sorc_Fire_Repel');
				}
			}
		}

		if (!thePlayer.HasTag('acs_vampire_claws_equipped')
		&& !thePlayer.HasTag('acs_sorc_fists_equipped')
		)
		{
			this.SetBehaviorVariable( 'repelType', (int)repelType );
			npc.SetBehaviorVariable( 'repelType', (int)repelType );

			SetParryTarget ( npc );
			SetSlideTarget( npc );

			if ( !IsActorLockedToTarget() )
			{
				SetMoveTarget( npc );
			}
			
			if ( RaiseForceEvent( 'PerformCounter' ) )
			{
				OnCombatActionStart();
			}
				
			
			SetCustomRotation( 'Counter', VecHeading( npc.GetWorldPosition() - this.GetWorldPosition() ), 0.0f, 0.2f, false );
			AddTimer( 'UpdateCounterRotation', 0.4f , true );
			AddTimer( 'SetCounterRotation', 0.2f  );
			
			IncreaseUninterruptedHitsCount();	
			
			
			if(IsHeavyAttack(parryInfo.attackActionName))
			{
				mult = theGame.params.HEAVY_STRIKE_COST_MULTIPLIER;
			}
		}

		DrainStamina(ESAT_Counterattack, 0, 0, '', 0, mult);

		dist = ((((CMovingPhysicalAgentComponent)(npc).GetMovingAgentComponent()).GetCapsuleRadius())
		+ (((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent()).GetCapsuleRadius()) ) * 1.25;

		if (((CMovingPhysicalAgentComponent)(npc.GetMovingAgentComponent())).GetCapsuleHeight() >= 2
		|| npc.GetRadius() >= 0.7
		|| npc.HasAbility('Boss')
		|| npc.HasTag('IsBoss')
		|| npc.HasTag('ACS_Big_Boi')
		)
		{
			movementAdjustor.AdjustmentDuration( ticket, 0.5f );

			thePlayer.RaiseEvent('ACS_AimAssistDodgeForwardR');

			movementAdjustor.SlideTo( ticket, thePlayer.GetWorldPosition() + thePlayer.GetWorldForward() * RandRangeF(-1, -3) ); 
		}
		else
		{
			movementAdjustor.AdjustmentDuration( ticket, 0.5f );

			movementAdjustor.SlideTowards( ticket, npc, dist, dist ); 

			movementAdjustor.Continuous( ticket );
			movementAdjustor.KeepActiveFor( ticket, 0.4f );	

			((CActor)npc).ACS_CharacterCollsionDisableTemp(0.75f);
		}

	}
	else
	{
		if (((CMovingPhysicalAgentComponent)(npc.GetMovingAgentComponent())).GetCapsuleHeight() >= 2
		|| npc.GetRadius() >= 0.7
		|| npc.HasAbility('Boss')
		|| npc.HasTag('IsBoss')
		|| npc.HasTag('ACS_Big_Boi')
		|| npc.HasTag('ACS_In_Rage') 
		|| npc.HasAbility('ablMagic')
		|| npc.HasAbility('ablTeleport')
		|| npc.HasAbility('mon_djinn')
		|| npc.HasAbility('SkillSorceress')
		)
		{
			if (RandF() < 0.5)
			{
				GetACSWatcher().PlayerPlayAnimation('tw2_npc_sword1h_31_ACS');
			}
			else
			{
				GetACSWatcher().PlayerPlayAnimation('tw2_npc_sword1h_17_ACS');
			}

			movementAdjustor.AdjustmentDuration( ticket, 0.5f );

			thePlayer.RaiseEvent('ACS_AimAssistDodgeForwardR');

			if(npc.HasTag('ACS_In_Rage') )
			{
				movementAdjustor.SlideTo( ticket, thePlayer.GetWorldPosition() + thePlayer.GetWorldForward() * -3 ); 
			}
			else
			{
				movementAdjustor.SlideTo( ticket, thePlayer.GetWorldPosition() + thePlayer.GetWorldForward() * RandRangeF(-1.5, -3) ); 
			}
		}
		else
		{
			hit_anim_names.Clear();

			if(thePlayer.GetCombatIdleStance() <= 0.f )
			{
				hit_anim_names.PushBack('man_geralt_sword_repel_lp');
				hit_anim_names.PushBack('man_npc_sword_1hand_guard_parry_2_lp_ACS');
				hit_anim_names.PushBack('man_npc_sword_1hand_guard_parry_1_lp_ACS');
				hit_anim_names.PushBack('man_npc_sword_1hand_guard_parry_1_left_ACS');
				hit_anim_names.PushBack('parry_combat_to_combat_down_l_001');
				hit_anim_names.PushBack('parry_combat_to_combat_middle_l_001');
				hit_anim_names.PushBack('parry_combat_to_combat_up_l_001');
				hit_anim_names.PushBack('parry_down_to_combat_l_001');
				hit_anim_names.PushBack('parry_forward_to_combat_l_001');
			}
			else
			{
				hit_anim_names.PushBack('man_geralt_sword_repel_rp');
				hit_anim_names.PushBack('man_npc_sword_1hand_guard_parry_2_rp_ACS');
				hit_anim_names.PushBack('man_npc_sword_1hand_guard_parry_1_rp_ACS');
				hit_anim_names.PushBack('man_npc_sword_1hand_guard_parry_1_right_ACS');
				hit_anim_names.PushBack('parry_combat_to_combat_down_r_001');
				hit_anim_names.PushBack('parry_combat_to_combat_middle_r_001');
				hit_anim_names.PushBack('parry_combat_to_combat_up_r_001');
				hit_anim_names.PushBack('parry_down_to_combat_r_001');
				hit_anim_names.PushBack('parry_forward_to_combat_r_001');
			}
			
			thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( hit_anim_names[RandRange(hit_anim_names.Size())], 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.875f) );

			GetACSWatcher().PlayerPlayAnimation(hit_anim_names[RandRange(hit_anim_names.Size())]);
		}
	}

	if ( npc.HasTag('ACS_In_Rage') 
	|| npc.HasAbility('ablMagic')
	|| npc.HasAbility('ablTeleport')
	|| npc.HasAbility('mon_djinn')
	|| npc.HasAbility('SkillSorceress')
	)
	{
		if (thePlayer.HasTag('ACS_Counter_Initiated'))
		{
			thePlayer.RaiseEvent('ACS_SwordCounterAdditiveReset');

			thePlayer.RemoveTag('ACS_Counter_Initiated');
		}
		
		parry_fx = theGame.CreateEntity( (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\fx\sign_icons.w2ent", true ), 
		(((thePlayer.GetWorldPosition() + npc.GetWorldPosition() ) * 0.5) + thePlayer.GetWorldPosition()) * 0.5 + Vector(0, 0, RandRangeF(1.5f,1.25f)), 
		thePlayer.GetWorldRotation() );

		parry_fx_secondary = theGame.CreateEntity( (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\fx\sign_icons.w2ent", true ), 
		parry_fx.GetWorldPosition(), 
		thePlayer.GetWorldRotation() );

		parry_fx.PlayEffectSingle('heliotrop_icon');
		parry_fx.ACS_StopEffectAfter('heliotrop_icon', 1.5);

		parry_fx.PlayEffectSingle('heliotrop_fx_01');
		parry_fx.PlayEffectSingle('heliotrop_fx_02');
		parry_fx.PlayEffectSingle('heliotrop_fx_03');
		parry_fx.PlayEffectSingle('heliotrop_explode_01');
		parry_fx.PlayEffectSingle('heliotrop_explode_02');

		//parry_fx.PlayEffectSingle('wave_attack_golem');
		//parry_fx.PlayEffectSingle('attack_special_golem');
		parry_fx_secondary.PlayEffectSingle('light_hit_parried_golem');
		parry_fx_secondary.PlayEffectSingle('heavy_hit_parried_golem');
		parry_fx_secondary.PlayEffectSingle('block_attack_fx_golem');

		parry_fx.DestroyAfter(10);

		parry_fx.CreateAttachment(thePlayer,'drain_energy', Vector(0,0.5,0), EulerAngles(0,0,0));

		//parry_fx.BreakAttachment();

		parry_fx_secondary.DestroyAfter(10);

		//thePlayer.SoundEvent("sprj_kill_chance_bb_acs");
		thePlayer.SoundEvent("deflect_large_01_sekiro_acs");
		thePlayer.SoundEvent("sign_quen_charge_loop");
		thePlayer.SoundEvent("sign_quen_charge_loop_start");
		thePlayer.SoundEvent("sign_quen_charge_loop_stop");
		thePlayer.SoundEvent("sign_quen_discharge_rebound");
		thePlayer.SoundEvent("sign_quen_force_discharge");
		thePlayer.SoundEvent("sign_quen_force_discharge_stop");

		thePlayer.RaiseEvent('ACS_CombatExtraHeliotrop');

		if (((CMovingPhysicalAgentComponent)((npc).GetMovingAgentComponent())).GetCapsuleHeight() >= 2
		|| (npc).GetRadius() >= 0.7
		|| (npc).HasAbility('Boss')
		|| (npc).HasTag('IsBoss')
		|| npc.HasTag('ACS_In_Rage') 
		|| npc.HasTag('ACS_Big_Boi')
		)
		{
			if (
			counterPassedSecondsInGameTimeEssence <= 0.125
			|| counterPassedSecondsInGameTimeVitality <= 0.125
			)
			{
				GetACSWatcher().ACS_SlowMoAdjustable(0.3,0.5);

				thePlayer.RaiseEvent('ACS_Backflip02');

				if (RandF() < 0.5)
				{
					thePlayer.RaiseEvent( 'ACS_CastAardLocomotion' );
				}
				else
				{
					thePlayer.RaiseEvent( 'ACS_CastIgniLocomotion' );
				}
			}
		}

		if (!GetACSWatcher().combatExtraActive)
		{
			GetACSWatcher().SetCombatExtraStatus(true);
		}

		GetACSWatcher().RemoveTimer('combatExtraReset');
		GetACSWatcher().AddTimer('combatExtraReset', 0.4 , false );

		if ( npc.HasTag('ACS_In_Rage') 
		)
		{
			ACSGetCEntityDestroyAll('ACS_Rage_Marker_1');

			ACSGetCEntityDestroyAll('ACS_Rage_Marker_2');

			ACSGetCEntityDestroyAll('ACS_Rage_Marker_Player_1');

			GetACSWatcher().RemoveTimer('ACS_Rage_Remove');
			GetACSWatcher().Rage_Remove_Actual();

			npc.RemoveTimer('ACS_AddParalyzedDelay');
			npc.AddTimer('ACS_AddParalyzedDelay', 0.125 , false );

			npc.RemoveBuffImmunity_AllNegative('ACS_Rage');

			npc.RemoveBuffImmunity_AllCritical('ACS_Rage');

			npc.SetImmortalityMode( AIM_None, AIC_Default, true ); 

			npc.SetCanPlayHitAnim(true); 
		}

		dmg = new W3DamageAction in theGame.damageMgr;
					
		dmg.Initialize(GetWitcherPlayer(), npc, NULL, GetWitcherPlayer().GetName(), EHRT_Heavy, CPS_Undefined, false, false, true, false);
		
		dmg.SetProcessBuffsIfNoDamage(true);
		
		dmg.SetHitReactionType( EHRT_Heavy, true );

		dmg.SetHitAnimationPlayType(EAHA_ForceYes);

		dmg.SetCanPlayHitParticle(false);

		dmg.SetSuppressHitSounds(true);

		dmg.SuppressHitSounds();

		if (npc.UsesVitality()) 
		{ 
			damageMax = npc.GetStat( BCS_Vitality ) * 0.1; 
		} 
		else if (npc.UsesEssence()) 
		{ 
			damageMax = npc.GetStat( BCS_Essence ) * 0.1; 
		} 

		dmg.AddDamage( theGame.params.DAMAGE_NAME_PHYSICAL, 50 + RandRangeF(damageMax) );

		dmg.AddDamage( theGame.params.DAMAGE_NAME_SILVER, 50 + RandRangeF(damageMax) );

		//dmg.AddEffectInfo( EET_Paralyzed, 3 );	

		dmg.SetCriticalHit(); 
		
		theGame.damageMgr.ProcessAction( dmg );
			
		delete dmg;
	}
	else
	{
		if (thePlayer.IsAnyWeaponHeld() 
		)
		{
			if (!thePlayer.IsWeaponHeld('fist')
			)
			{
				if (!thePlayer.IsSwordWooden()
				)
				{
					counter_sound_names.Clear();

					vfxEnt = theGame.CreateEntity( (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\fx\acs_sword_trail.w2ent", true ), 
					((npc.GetWorldPosition() + thePlayer.GetWorldPosition()) * 0.5) + Vector(0, 0, RandRangeF(1.5f,1.25f)), 
					npc.GetWorldRotation() );

					if (((CMovingPhysicalAgentComponent)((npc).GetMovingAgentComponent())).GetCapsuleHeight() >= 2
					|| (npc).GetRadius() >= 0.7
					|| (npc).HasAbility('Boss')
					|| (npc).HasTag('IsBoss')
					|| npc.HasTag('ACS_In_Rage') 
					|| npc.HasTag('ACS_Big_Boi')
					)
					{
						vfxEnt.PlayEffectSingle('light_block_large');
						vfxEnt.PlayEffectSingle('heavy_block_large');
						vfxEnt.PlayEffectSingle('counterattack_large');

						vfxEnt.PlayEffectSingle('parry_fx_large');
					}
					else
					{
						vfxEnt.PlayEffectSingle('light_block');
						vfxEnt.PlayEffectSingle('heavy_block');
						vfxEnt.PlayEffectSingle('counterattack');

						vfxEnt.PlayEffectSingle('parry_fx');
					}
					
					GetWitcherPlayer().SoundEvent("sword_x_sword_01_bb_acs");

					counter_sound_names.PushBack("deflect_01_sekiro_acs");
					counter_sound_names.PushBack("deflect_02_sekiro_acs");
					counter_sound_names.PushBack("deflect_03_sekiro_acs");
					counter_sound_names.PushBack("deflect_04_sekiro_acs");
					counter_sound_names.PushBack("deflect_05_sekiro_acs");
					counter_sound_names.PushBack("deflect_06_sekiro_acs");
					counter_sound_names.PushBack("deflect_07_sekiro_acs");
					counter_sound_names.PushBack("deflect_08_sekiro_acs");
					counter_sound_names.PushBack("deflect_09_sekiro_acs");

					GetWitcherPlayer().SoundEvent(counter_sound_names[RandRange(counter_sound_names.Size())]);

					vfxEnt.PlayEffectSingle('parry_fx_secondary');
					vfxEnt.DestroyAfter(3);
				}
			}
			else
			{
				if (thePlayer.HasTag('acs_vampire_claws_equipped')
				)
				{
					thePlayer.SoundEvent("cmb_play_parry");
					thePlayer.SoundEvent("monster_dettlaff_vampire_combat_claws_screech");
					thePlayer.SoundEvent("monster_dettlaff_vampire_combat_claws_shock");
					thePlayer.SoundEvent("monster_dettlaff_vampire_combat_claws_scrape_sparks_vfx");

					vfxEnt = theGame.CreateEntity( (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\fx\acs_sword_trail.w2ent", true ), 
					((npc.GetWorldPosition() + thePlayer.GetWorldPosition()) * 0.5) + Vector(0, 0, RandRangeF(1.5f,1.25f)), 
					npc.GetWorldRotation() );

					if (((CMovingPhysicalAgentComponent)((npc).GetMovingAgentComponent())).GetCapsuleHeight() >= 2
					|| (npc).GetRadius() >= 0.7
					|| (npc).HasAbility('Boss')
					|| (npc).HasTag('IsBoss')
					|| npc.HasTag('ACS_In_Rage') 
					|| npc.HasTag('ACS_Big_Boi')
					)
					{
						vfxEnt.PlayEffectSingle('light_block_large');
						vfxEnt.PlayEffectSingle('heavy_block_large');
						vfxEnt.PlayEffectSingle('counterattack_large');

						vfxEnt.PlayEffectSingle('parry_fx_large');
					}
					else
					{
						vfxEnt.PlayEffectSingle('light_block');
						vfxEnt.PlayEffectSingle('heavy_block');
						vfxEnt.PlayEffectSingle('counterattack');

						vfxEnt.PlayEffectSingle('parry_fx');
					}

					vfxEnt.PlayEffectSingle('parry_fx_secondary');
					vfxEnt.DestroyAfter(3);
				}
			}
		}
	}

	if (((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'wood_hollow'
	|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'wood_debris'
	|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'dirt_hard'
	|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'dirt_soil'
	|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'hay'
	|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'stone_debris'
	|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'stone_solid'
	|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'clay_tile'
	|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'gravel_large'
	|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'gravel_small'
	|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'sand'
	|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'water_shallow'
	|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'water_deep'
	|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'grass_short'
	|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'grass_long'
	|| ((CMovingPhysicalAgentComponent)thePlayer.GetMovingAgentComponent() ).GetMaterialName() == 'carpet'
	)
	{

		thePlayer.StopEffect('jump_ground_fx1');
		thePlayer.PlayEffect('jump_ground_fx1');
	}

	thePlayer.GainStat( BCS_Focus, (thePlayer.GetStatMax( BCS_Focus) - thePlayer.GetStat( BCS_Focus) ) * 0.33 );

	thePlayer.GainStat( BCS_Stamina, (thePlayer.GetStatMax( BCS_Stamina) - thePlayer.GetStat( BCS_Stamina)) * 0.5 );
}

@addField(CActor)
var	ACS_storedInteractionPri 		: EInteractionPriority;

@addMethod(CActor) function ACS_CharacterCollsionDisableTemp( time : float ) 
{
	if (!HasTag('ACS_DisableCharacterCollsionTemp'))
	{
		if ( GetInteractionPriority() != IP_Max_Unpushable )
		{
			ACS_storedInteractionPri = GetInteractionPriority();

			SetInteractionPriority( IP_Max_Unpushable );
		}

		RemoveTimer('ACS_RestoreCharacterCollisions');
		AddTimer('ACS_RestoreCharacterCollisions', time , false );

		AddTag('ACS_DisableCharacterCollsionTemp');
	}
	
}

@addMethod(CActor) timer function ACS_RestoreCharacterCollisions( time : float , id : int )
{
	if (HasTag('ACS_DisableCharacterCollsionTemp'))
	{
		if ( ACS_storedInteractionPri != IP_NotSet )
		{
			SetInteractionPriority( ACS_storedInteractionPri );
		}

		ACS_storedInteractionPri = IP_NotSet;

		RemoveTag('ACS_DisableCharacterCollsionTemp');
	}
}

@wrapMethod(CR4Player) function ShouldEnableCombat( out unableToPathFind : bool, forceCombatMode : bool ) : bool
{
	var shouldFindPathToNPCs 	: bool;
	var playerToTargetDist	 	: float;
	var canFindPathToTarget		: bool;
	var moveTargetNPC 			: CNewNPC;
	var currentTime				: float;
	var currentTime2			: float;
	var isReachableEnemyTooFar	: bool;
	var reachableEnemyWasTooFarTimeStampDelta	: float;
	var reachablilityFailedTimeStampDelta		: float;
	var currentTimeTemp 		: float;

	if(false) 
	{
		wrappedMethod(unableToPathFind, forceCombatMode);
	}

	if ( forceCombatMode && isSnappedToNavMesh )
		return true;

	if ( !IsThreatened() )
	{
		reachableEnemyWasTooFar = false;
		reachablilityFailed = false;		
		isInCombatReason = 0; 
		return false;
	}

	if( thePlayer.substateManager.GetStateCur() != 'CombatExploration' && !thePlayer.substateManager.CanChangeToState( 'CombatExploration' )
	&& thePlayer.substateManager.GetStateCur() != 'Ragdoll' ) 
	{
		reachableEnemyWasTooFar = false;
		reachablilityFailed = false;		
		isInCombatReason = 0;
		return false;
	}

	if ( moveTarget )
	{
		canFindPathToEnemy = CanFindPathToTarget( unableToPathFind, ((CNewNPC)moveTarget) );
		currentTimeTemp = EngineTimeToFloat( theGame.GetEngineTime() );
		
		if ( canFindPathToEnemy )
			isReachableEnemyTooFar = IsReachableEnemyTooFar();					
		
		if ( IsInCombat() )
		{
			if ( canFindPathToEnemy )
			{
				if ( forceCombatMode )
					return true;
			
				reachablilityFailed = false;
				reachablilityFailedTimeStamp = currentTimeTemp;						
			
				if ( reachableEnemyWasTooFar )
				{												
					if ( isReachableEnemyTooFar )
					{
						currentTime = currentTimeTemp;
						
						if ( GetIsSprinting() )
							reachableEnemyWasTooFarTimeStampDelta = 0.f;
						else
							reachableEnemyWasTooFarTimeStampDelta = 3.f;
							
						if ( currentTime > reachableEnemyWasTooFarTimeStamp + reachableEnemyWasTooFarTimeStampDelta )
						{							
							isInCombatReason = 0;
							unableToPathFind = true;
							return false;
						}
					}
					else
						reachableEnemyWasTooFar = false;
				}
				else
				{
					if ( isReachableEnemyTooFar )
					{
						reachableEnemyWasTooFar = true;
						reachableEnemyWasTooFarTimeStamp = currentTimeTemp;
					}
					else
						reachableEnemyWasTooFar = false;
				}	
		
				return true;
			}
			else
			{
				reachableEnemyWasTooFar = false;
				reachableEnemyWasTooFarTimeStamp = currentTimeTemp;
			
				if ( reachablilityFailed )
				{
					if ( IsEnemyTooHighToReach() )
						reachablilityFailedTimeStampDelta = 1.f;
					else
						reachablilityFailedTimeStampDelta = 5.f;
				
					currentTime2 = currentTimeTemp;
					if ( currentTime2 > reachablilityFailedTimeStamp + reachablilityFailedTimeStampDelta )
					{
						unableToPathFind = true;
						return false;
					}
				}
				else
				{
					reachablilityFailed = true;
					reachablilityFailedTimeStamp = currentTimeTemp;
				}
				
				return true;
			}
		}
		else if ( canFindPathToEnemy )
		{
			if ( forceCombatMode )
			{
				reachableEnemyWasTooFar = false;
				return true;
			}
		
			reachablilityFailed = false;
			reachablilityFailedTimeStamp = currentTimeTemp;
			
			moveTargetNPC = (CNewNPC)moveTarget;
			playerToTargetDist = VecDistance( moveTarget.GetWorldPosition(), this.GetWorldPosition() );

				if ( reachableEnemyWasTooFar 
				&& ( isReachableEnemyTooFar || !theGame.GetWorld().NavigationLineTest( this.GetWorldPosition(), moveTarget.GetWorldPosition(), 0.4f ) ) )
			{
				isInCombatReason = 0;
				return false;			
			}
			else if ( playerToTargetDist <= findMoveTargetDistMin )
				isInCombatReason = 1;
			else if ( ( moveTargetNPC.GetCurrentStance() == NS_Fly || moveTargetNPC.IsRanged() ) && hostileEnemies.Contains( moveTarget ) ) 
				isInCombatReason = 2;
			else
			{			 
				isInCombatReason = 0;
				return false;
			}
			
			reachableEnemyWasTooFar = false;
			return true;
		}						
	}
	else
	{
		reachableEnemyWasTooFar = false;
		reachablilityFailed = false;
	}
	
	isInCombatReason = 0;
	return false;
}
	
@wrapMethod(CR4Player) function FindMoveTarget()
{
	var moveTargetDists				: array<float>;
	var moveTargetCanPathFinds		: array<bool>;
	var aPotentialMoveTargetCanFindPath		: bool;
	
	var newMoveTarget				: CActor;
	var actors 						: array<CActor>;
	var currentHeading				: float;
	var size, i						: int;
	var playerToNewMoveTargetDist	: float;
	var playerToMoveTargetDist		: float;
	var confirmEmptyMoveTarget		: bool;
	var newEmptyMoveTargetTimer		: float;
	var wasVisibleInFullFrame		: bool;
	var setIsThreatened				: bool;
	
	var enemysTarget				: CActor;
	var isEnemyInCombat				: bool;
	var potentialMoveTargets		: array<CActor>;
	var onlyThreatTargets			: bool;

	if(false) 
	{
		wrappedMethod();
	}
	
	thePlayer.SetupEnemiesCollection( ACS_Settings_Main_Float('acs_target_settings','acs_target_distance_max', 50), ACS_Settings_Main_Float('acs_target_settings','acs_target_distance_max', 50), 10, 'None', FLAG_Attitude_Neutral + FLAG_Attitude_Hostile + FLAG_Attitude_Friendly + FLAG_OnlyAliveActors );

	
	if ( GetCurrentStateName() != 'PlayerDialogScene' && IsAlive() )
	{
		GetVisibleEnemies( actors );

		
		if ( hostileEnemies.Size() > 0 )
		{
			for( i=0; i < hostileEnemies.Size() ; i+=1 )
			{
				if ( !actors.Contains( hostileEnemies[i] ) )
					actors.PushBack( hostileEnemies[i] );
			}
		}
		
		
		if ( finishableEnemiesList.Size() > 0 )
		{
			for( i=0; i < finishableEnemiesList.Size() ; i+=1 )
			{
				if ( !actors.Contains( finishableEnemiesList[i] ) )
					actors.PushBack( finishableEnemiesList[i] );
			}
		}
		
		
		if ( moveTarget && !actors.Contains( moveTarget )  )
			actors.PushBack( moveTarget );			
		
		FilterActors( actors, onlyThreatTargets, false );
		
		
		if ( actors.Size() > 0 )
		{
			setIsThreatened = false;
		
			if ( onlyThreatTargets )
			{
				setIsThreatened = true;
			}
			else
			{
				for( i=0; i < actors.Size() ; i+=1 )
				{
					if ( IsThreat( actors[i] ) )
					{
						setIsThreatened = true;
						break;
					}
					else
					{
						enemysTarget = actors[i].GetTarget();
						isEnemyInCombat = actors[i].IsInCombat();
						if ( isEnemyInCombat && enemysTarget && GetAttitudeBetween( enemysTarget, this ) == AIA_Friendly && enemysTarget.isPlayerFollower )
						{
							setIsThreatened = true;
							break;
						}							
					}
				}
			}
			
			
			for( i = actors.Size()-1; i>=0; i-=1 )
			{			
				if ( ( !actors[i].IsAlive() && !finishableEnemiesList.Contains( actors[i] ) )
					|| actors[i].IsKnockedUnconscious()
					|| this.GetUsedVehicle() == actors[i]
					|| !actors[i].CanBeTargeted() )
				{
					actors.EraseFast(i);
				}
				else if ( !IsThreatened() )
				{
					if ( !WasVisibleInScaledFrame( actors[i], 1.f, 1.f ) )
						actors.EraseFast(i);
				}
			}
		}
		else if ( moveTarget && IsThreat( moveTarget ) )
			setIsThreatened = true;
			
		else
			setIsThreatened = false;
			

		if ( setIsThreatened )
		{				
			enemyCollectionDist = ACS_Settings_Main_Float('acs_target_settings','acs_target_distance_max', 50);
			SetIsThreatened( true );
		}
		else
		{
			if ( IsThreatened() )
				AddTimer( 'finishableEnemiesList', 1.f );
			
			enemyCollectionDist = ACS_Settings_Main_Float('acs_target_settings','acs_target_distance_max', 50);
			SetIsThreatened( false );
		}

		moveTargets = actors;
		potentialMoveTargets = moveTargets;
		
		
		if ( !moveTarget ) 
			enableStrafe = false;
			
		if ( potentialMoveTargets.Size() > 0 )
		{
			for ( i = 0; i < potentialMoveTargets.Size(); i += 1 )
			{	
				if ( potentialMoveTargets[i].CanBeStrafed() )
					enableStrafe = true;
				
				if ( !potentialMoveTargets[i].GetGameplayVisibility() )
					moveTargetDists.PushBack( 100.f ); 
				else
					moveTargetDists.PushBack( VecDistance( potentialMoveTargets[i].GetNearestPointInPersonalSpace( GetWorldPosition() ), GetWorldPosition() ) );

				if ( canFindPathEnemiesList.Contains( potentialMoveTargets[i] ) )
				{
					moveTargetCanPathFinds.PushBack( true );
					aPotentialMoveTargetCanFindPath = true;
				}
				else
				{
					moveTargetCanPathFinds.PushBack( false );
				}
			}					

			if ( aPotentialMoveTargetCanFindPath )
			{
				for ( i = moveTargetCanPathFinds.Size()-1 ; i >= 0; i-=1 )
				{
					if ( !moveTargetCanPathFinds[i] )
					{
						moveTargetCanPathFinds.EraseFast(i);
						potentialMoveTargets.EraseFast(i);
						moveTargetDists.EraseFast(i);
					}
				}
			}

			if ( moveTargetDists.Size() > 0 )
				newMoveTarget = potentialMoveTargets[ ArrayFindMinF( moveTargetDists ) ];
		}

		if ( newMoveTarget && newMoveTarget != moveTarget )
		{
			if ( moveTarget )
			{
				playerToNewMoveTargetDist =	VecDistance( newMoveTarget.GetNearestPointInPersonalSpace( GetWorldPosition() ), GetWorldPosition() );
				playerToMoveTargetDist = VecDistance( moveTarget.GetNearestPointInPersonalSpace( GetWorldPosition() ), GetWorldPosition() );
				wasVisibleInFullFrame = WasVisibleInScaledFrame( moveTarget, 1.f, 1.f ) ;
				
				if ( !IsThreat( moveTarget )
					|| !wasVisibleInFullFrame
					|| !IsEnemyVisible( moveTarget ) 
					|| ( !moveTarget.IsAlive() && !finishableEnemiesList.Contains( moveTarget ) )
					|| !moveTarget.GetGameplayVisibility()
					|| ( moveTarget.IsAlive() && moveTarget.IsKnockedUnconscious() ) 
					|| ( wasVisibleInFullFrame && IsEnemyVisible( moveTarget ) && playerToNewMoveTargetDist < playerToMoveTargetDist - 0.25f ) )
				{
					SetMoveTarget( newMoveTarget );
				}
			}
			else 
				SetMoveTarget( newMoveTarget );
		}


		if ( !IsThreatened() )
		{
			if ( moveTarget 
				&& ( ( !moveTarget.IsAlive() && !finishableEnemiesList.Contains( moveTarget ) ) || !WasVisibleInScaledFrame( moveTarget, 0.8f, 1.f ) || VecDistance( moveTarget.GetWorldPosition(), this.GetWorldPosition() ) > theGame.params.MAX_THROW_RANGE  )	)
			{
				confirmEmptyMoveTarget =  true;
				newEmptyMoveTargetTimer = 0.f;
			}
		}
			
		else if ( moveTarget && ( IsThreat( moveTarget ) || finishableEnemiesList.Contains( moveTarget ) ) )				
		{
			if ( !IsEnemyVisible( moveTarget ) )
			{
				confirmEmptyMoveTarget =  true;
				newEmptyMoveTargetTimer = 5.f;
			}
			else
				SetMoveTarget( moveTarget );
		}
		else if ( IsInCombat() )
		{
			confirmEmptyMoveTarget =  true;
			newEmptyMoveTargetTimer = 1.0f;
		}
		
		if ( confirmEmptyMoveTarget )
		{
			if ( newEmptyMoveTargetTimer < emptyMoveTargetTimer )
			{
				bIsConfirmingEmptyTarget = false;
				emptyMoveTargetTimer = newEmptyMoveTargetTimer;
			}
				
			ConfirmEmptyMoveTarget( newEmptyMoveTargetTimer );
		}
	}
	else
		SetIsThreatened( false );
		
	
	if ( IsThreatened() && !IsInFistFightMiniGame() )
		theGame.GetBehTreeReactionManager().CreateReactionEventIfPossible( this, 'CombatNearbyAction', 5.0, 18.0f, -1.f, -1, true ); 
	else
		theGame.GetBehTreeReactionManager().RemoveReactionEvent( this, 'CombatNearbyAction'); 
		
	
	theSound.SoundParameter( "monster_count", hostileMonsters.Size() );
}
	

@wrapMethod( CR4ScriptedHud ) function OnCutsceneStarted()
{
	var actors		    				: array<CActor>;
	var i								: int;

	wrappedMethod();

	if (thePlayer.inv.HasItem('Cup_01'))
	{
		thePlayer.inv.RemoveItemByName('Cup_01', 1);
	}

	if (GetACSWatcher().steel_scabbard_hidden
	|| GetACSWatcher().silver_scabbard_hidden
	|| GetACSWatcher().steel_sword_hidden
	|| GetACSWatcher().silver_sword_hidden
	|| GetACSWatcher().crossbow_hidden
	)
	{
		GetACSWatcher().RemoveTimer('SetScabbardFlag');
		GetACSWatcher().AddTimer('SetScabbardFlag', 0.125 , false );
	}

	//thePlayer.PlayEffectSingle('covered_blood_red_special_ACS');

	thePlayer.RaiseEvent('ACS_SwordWalkAdditiveEnd');

	thePlayer.RaiseEvent('ACS_CombatTauntEnd');

	thePlayer.RaiseEvent('ACS_SwordTauntEnd');

	ACSSignComboSystemRemoveTags();

	ACSGetCEntityDestroyAll('ACS_Sign_Combo_Icon');


	FactsRemove("ACS_Dummy_Swords_Enabled");

	GetACSWatcher().Remove_On_Hit_Tags();
}


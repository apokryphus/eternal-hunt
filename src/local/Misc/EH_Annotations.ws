		GetACSWatcher().SetStance('steel_strong_stance', false);
		GetACSWatcher().SetStance('steel_fast_stance', false);

		GetACSWatcher().SetStance('silver_group_stance', false);
		GetACSWatcher().SetStance('silver_strong_stance', false);
		GetACSWatcher().SetStance('silver_fast_stance', false);


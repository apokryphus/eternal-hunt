@wrapMethod(W3SyncAnimationManager) function SetupSimpleSyncAnim2( syncAction : name, master, slave : CEntity ) : bool
{
	if ( slave == thePlayer )
	{
		GetACSWatcher().action_interrupt();
	}

	return wrappedMethod(syncAction, master, slave);
}

@wrapMethod(CThrowable) function Initialize( ownr : CActor, optional id : SItemUniqueId )
{
	if (ownr == thePlayer)
	{
		thePlayer.AddTag('ACS_Throw_Bomb_Counter_Start');
		GetACSWatcher().RemoveTimer('ACS_Throw_Bomb_Counter_Tag_Remove');
		GetACSWatcher().AddTimer('ACS_Throw_Bomb_Counter_Tag_Remove', 0.33 , false );
	}
	
	wrappedMethod(ownr, id);
}

@wrapMethod(CThrowable) function StopAiming( flag : bool )
{
	GetACSWatcher().RemoveTimer('ACS_Throw_Bomb_Counter_Tag_Remove');

	thePlayer.RemoveTag('ACS_Throw_Bomb_Counter_Start');

	wrappedMethod(flag);
}

@wrapMethod(CombatSword) function OnSAHeavyStartComplete()
{
	var ent, ent_anchor       														: CEntity;

	GetACSWatcher().RemoveTimer('Rend_Projectile_Switch');

	GetACSWatcher().AddTimer('Rend_Projectile_Switch', 0.25 , false );

	GetWitcherPlayer().StopEffect('sword_ground_hit');
	GetWitcherPlayer().ACS_PlayEffectAfter('sword_ground_hit', 0.25);

	if (
	ACS_GetItem_Sword_IsEquipped('longsword_steel', 'steel') )
	{
		ent_anchor = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

		"dlc\dlc_acs\data\fx\fire_streams\fire_stream_alt.w2ent"

		, true ), thePlayer.GetWorldPosition());

		ent_anchor.CreateAttachment(thePlayer,'r_weapon', Vector(-0.25,0,2.25), EulerAngles(0,0,-90));

		ent_anchor.AddTag('ACS_SwordExtensionStreamAnchor');

		ent_anchor.SoundEvent("magic_sorceress_vfx_arcane_fire_fx_loop_start");

		ent_anchor.SoundEvent("magic_sorceress_vfx_fire_fx1_loop_start");

		ent_anchor.SoundEvent("magic_sorceress_vfx_fireball_fire_fx_loop_start");

		ent_anchor.SoundEvent("magic_sorceress_vfx_lightning_fx_loop_start");

		ent_anchor.DestroyAfter(5);




		ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

		"dlc\dlc_acs\data\fx\fire_streams\fire_stream_alt.w2ent"

		, true ), thePlayer.GetWorldPosition());

		ent.CreateAttachment(thePlayer,'r_weapon', Vector(0,0,0.25), EulerAngles(0,0,-90));

		ent.AddTag('ACS_SwordExtensionStream');

		ent.DestroyAfter(5);

		ent.SoundEvent("magic_sorceress_vfx_lightning_fx_loop_start");
	}
	else if (ACS_GetItem_Sword_IsEquipped('longsword_silver', 'silver'))
	{
		ent_anchor = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

		"dlc\dlc_acs\data\fx\fire_streams\fire_stream_alt.w2ent"

		, true ), thePlayer.GetWorldPosition());

		ent_anchor.CreateAttachment(thePlayer,'r_weapon', Vector(-0.25,0,2.25), EulerAngles(0,0,-90));

		ent_anchor.AddTag('ACS_SwordExtensionStreamAnchor');

		ent_anchor.SoundEvent("magic_sorceress_vfx_arcane_fire_fx_loop_start");

		ent_anchor.SoundEvent("magic_sorceress_vfx_fire_fx1_loop_start");

		ent_anchor.SoundEvent("magic_sorceress_vfx_fireball_fire_fx_loop_start");

		ent_anchor.SoundEvent("magic_sorceress_vfx_lightning_fx_loop_start");

		ent_anchor.DestroyAfter(5);




		ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

		"dlc\dlc_acs\data\fx\fire_streams\fire_stream_alt.w2ent"

		, true ), thePlayer.GetWorldPosition());

		ent.CreateAttachment(thePlayer,'r_weapon', Vector(0,0,0.25), EulerAngles(0,0,-90));

		ent.SoundEvent("magic_sorceress_vfx_lightning_fx_loop_start");

		ent.AddTag('ACS_SwordExtensionStream');

		ent.DestroyAfter(5);
	}
	

	wrappedMethod();
}

@wrapMethod(CR4Player) function CancelHoldAttacks()
{
	GetACSWatcher().RemoveTimer('Rend_Projectile_Switch');

	wrappedMethod();
}	

@addMethod(CR4HudModuleRadialMenu) function ACS_SetDescription( description : string ) : void
{
	m_fxSetDescription.InvokeSelfOneArg(FlashArgString(description));
}

@addMethod(CR4HudModuleRadialMenu) function ACS_RadialMenuCurrentSelection() : string
{
	return _currentSelection;
}

@wrapMethod(W3NewDoor) function OnInteraction( actionName : string, activator : CEntity )
{		
	wrappedMethod(actionName, activator);

	if ( activator == thePlayer 
	&& doorsCmp.IsTrapdoor()
	//&& !playerInsideTrapdoorTrigger
	)
	{
		thePlayer.RaiseEvent('ACS_CombatTauntEnd');

		thePlayer.RaiseEvent('ACS_IdleAdditiveReset');

		thePlayer.RaiseEvent('LootHerb');
		
		if (!thePlayer.IsSwimming()
		&& !thePlayer.IsDiving())
		{
			thePlayer.RaiseEvent('ACS_KneelFast');
		}

		thePlayer.RaiseEvent('ACS_TorsoBend'); 

		GetACSWatcher().IdleAdditiveBlockTemp();
	}	
}


	this.HasTag('ACS_Melusine')
	)
	{
		if (!this.IsAlive())
		{
			if(!this.HasTag('ACS_Melusine_Death'))
			{
				ACSGetCActor('ACS_Melusine_Cloud').Destroy();

				ACSGetCActor('ACS_Melusine_Bossbar').Destroy();


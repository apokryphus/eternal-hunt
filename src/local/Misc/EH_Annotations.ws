@wrapMethod( CR4Player ) function OnSpawned( spawnData : SEntitySpawnData )
{
	acs_player_posture 	= 0;

	acs_max_player_posture = 100;

	wrappedMethod(spawnData);

	acs_darkness_env = (CEnvironmentDefinition)LoadResource(

	"dlc\dlc_acs\data\env\darkness_upon_us.env"

	,true);

	acs_darkness_env2 = (CEnvironmentDefinition)LoadResource(

	"dlc\dlc_acs\data\env\darkness_upon_us.env"
	
	,true);

	//////////////////////////////////////////////////////////////

	acs_darkness_env_HBAO = (CEnvironmentDefinition)LoadResource(

	"dlc\dlc_acs\data\env\darkness_upon_us_alt.env"

	,true);

	acs_darkness_env2_HBAO = (CEnvironmentDefinition)LoadResource(

	"dlc\dlc_acs\data\env\darkness_upon_us_alt.env"
	
	,true);

	//////////////////////////////////////////////////////////////

	acs_darkness_env_bob = (CEnvironmentDefinition)LoadResource(

	"dlc\dlc_acs\data\env\darkness_upon_us_bob.env"

	,true);

	acs_darkness_env2_bob = (CEnvironmentDefinition)LoadResource(

	"dlc\dlc_acs\data\env\darkness_upon_us_bob.env"
	
	,true);

	//////////////////////////////////////////////////////////////

	acs_darkness_env_bob_HBAO = (CEnvironmentDefinition)LoadResource(

	"dlc\dlc_acs\data\env\darkness_upon_us_bob_alt.env"

	,true);

	acs_darkness_env2_bob_HBAO = (CEnvironmentDefinition)LoadResource(

	"dlc\dlc_acs\data\env\darkness_upon_us_bob_alt.env"
	
	,true);

	//////////////////////////////////////////////////////////////

	acs_darkness_env_red_moon = (CEnvironmentDefinition)LoadResource(

	"dlc\dlc_acs\data\env\darkness_upon_us_red_moon.env"

	,true);

	acs_darkness_env2_red_moon = (CEnvironmentDefinition)LoadResource(

	"dlc\dlc_acs\data\env\darkness_upon_us_red_moon.env"
	
	,true);

	//////////////////////////////////////////////////////////////

	acs_darkness_env_HBAO_red_moon = (CEnvironmentDefinition)LoadResource(

	"dlc\dlc_acs\data\env\darkness_upon_us_alt_red_moon.env"

	,true);

	acs_darkness_env2_HBAO_red_moon = (CEnvironmentDefinition)LoadResource(

	"dlc\dlc_acs\data\env\darkness_upon_us_alt_red_moon.env"
	
	,true);

	//////////////////////////////////////////////////////////////

	acs_darkness_env_bob_red_moon = (CEnvironmentDefinition)LoadResource(

	"dlc\dlc_acs\data\env\darkness_upon_us_bob_red_moon.env"

	,true);

	acs_darkness_env2_bob_red_moon = (CEnvironmentDefinition)LoadResource(

	"dlc\dlc_acs\data\env\darkness_upon_us_bob_red_moon.env"
	
	,true);

	//////////////////////////////////////////////////////////////

	acs_darkness_env_bob_HBAO_red_moon = (CEnvironmentDefinition)LoadResource(

	"dlc\dlc_acs\data\env\darkness_upon_us_bob_alt_red_moon.env"

	,true);

	acs_darkness_env2_bob_HBAO_red_moon = (CEnvironmentDefinition)LoadResource(

	"dlc\dlc_acs\data\env\darkness_upon_us_bob_alt_red_moon.env"
	
	,true);

	//////////////////////////////////////////////////////////////

	acs_darkness_envId = -1;
	acs_darkness_envId2 = -1;

	//////////////////////////////////////////////////////////////

	acs_darkness_justSpawned = true;

	ACS_InitDarkerNights();

	ACS_DarknessUpdateValues();

	acs_darkness_justSpawned = false;

	if (!theGame.GetDLCManager().IsDLCAvailable('dlc_eh') || !theGame.GetDLCManager().IsDLCEnabled('dlc_eh'))
	{
		AddTimer('ACS_DLC_Check', 0.1 , false );
	}
}

@addMethod( CR4Player ) timer function ACS_DLC_Check ( dt : float, id : int)
{
	var missingDLCPopupData : ACSNotifcationPopupMissingDlc;
	var disabledDLCPopupData : ACSNotifcationDisabledDlc;
	var testEnt : CEntity;
	var meshComponent : CMeshComponent;
	var boundingBox : Box;
	var range : float;

	testEnt = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource("dlc\dlc_acs\data\models\azkar\azkar_bow_appearance_01.w2ent" , true), GetWorldPosition() + Vector(0,0,-200), GetWorldRotation() );
	
	meshComponent = (CMeshComponent)testEnt.GetComponentByClassName('CMeshComponent');

	if( meshComponent )
	{
		boundingBox = meshComponent.GetBoundingBox();
	}

	range = GetBoxRange( boundingBox );

	if (range <= 0 )
	{
		missingDLCPopupData = new ACSNotifcationPopupMissingDlc in this;
		
		missingDLCPopupData.SetMessageTitle("ETERNAL HUNT DLC MISSING");		
		missingDLCPopupData.SetMessageText("The dlc_EH folder is currently missing from your DLC folder.<br/><br/>The game will now exit.");

		missingDLCPopupData.BlurBackground = true;
		missingDLCPopupData.PauseGame = true;

		theGame.RequestMenu('PopupMenu', missingDLCPopupData);
	}
	else
	{
		if (!theGame.GetDLCManager().IsDLCEnabled('dlc_eh')
		)
		{
			theGame.GetDLCManager().EnableDLC('dlc_eh', true);
		}

		disabledDLCPopupData = new ACSNotifcationDisabledDlc in this;
		
		disabledDLCPopupData.SetMessageTitle("ETERNAL HUNT DLC NOT ENABLED");		
		disabledDLCPopupData.SetMessageText("The option [MOD: Eternal Hunt] is currently not enabled in the Gameplay settings menu in the starting main menu.<br/><br/>The option is now enabled and the game will exit to the starting main menu for you to reload.");

		disabledDLCPopupData.BlurBackground = true;
		disabledDLCPopupData.PauseGame = true;

		theGame.RequestMenu('PopupMenu', disabledDLCPopupData);
	}
}

@addMethod( CR4Player ) function ACS_InitDarkerNights()
{
	var i : int;

	for(i = 0; i < 12; i+=1)
		acs_darkness_intensity.PushBack(0.75f);

	acs_darkness_areaNames.PushBack('acs_darkness_settings_main');
	acs_darkness_areaNames.PushBack('acs_darkness_settings_novigrad');
	acs_darkness_areaNames.PushBack('acs_darkness_settings_skellige');
	acs_darkness_areaNames.PushBack('acs_darkness_settings_kaer_morhen');
	acs_darkness_areaNames.PushBack('acs_darkness_settings_white_orchard');
	acs_darkness_areaNames.PushBack('acs_darkness_settings_wyzima');
	acs_darkness_areaNames.PushBack('acs_darkness_settings_mist_isle');
	acs_darkness_areaNames.PushBack('acs_darkness_settings_spiral');
	acs_darkness_areaNames.PushBack('acs_darkness_settings_winter_white_orchard');
	acs_darkness_areaNames.PushBack('');
	acs_darkness_areaNames.PushBack('');
	acs_darkness_areaNames.PushBack('acs_darkness_settings_toussaint');

	for (i = 0; i < 12; i+= 1)
	{
		acs_darkness_start.PushBack(1320);
		acs_darkness_startTime.PushBack(120);
		acs_darkness_end.PushBack(120);
		acs_darkness_endTime.PushBack(120);
	}

	acs_darkness_prevArea = -1;
}

@addMethod( CR4Player ) function ACS_DarknessUpdateValues()
{
	var i : int;
	var usingGlobal : int;
	var change : bool;
	var oldIntensity : float;
	var oldStart, oldStartTime, oldEnd, oldEndTime : int;
	var oldNightEnvEnabled : bool;
	var nightEnvEnabled : bool;

	if (ACS_Settings_Main_Bool('acs_darkness_settings_main','acs_darkness_global_enabled', true)) 
	{
		usingGlobal = 0;
	}
	else 
	{
		usingGlobal = 1;
	}
	
	change = false;

	for (i = 0; i < 12; i += 1)
	{
		oldNightEnvEnabled = nightEnvEnabled;

		oldIntensity 	= acs_darkness_intensity[i];
		oldStart 		= acs_darkness_start[i];
		oldStartTime 	= acs_darkness_startTime[i];
		oldEnd 			= acs_darkness_end[i];
		oldEndTime 		= acs_darkness_endTime[i];
		nightEnvEnabled = ACS_Settings_Main_Bool('acs_world_visual_settings','acs_spiral_sky_moon_enabled', true);

		acs_darkness_intensity[i]	= 				ACS_Settings_Main_Float(acs_darkness_areaNames[i * usingGlobal],'acs_darkness_intensity', 50) / 100.f;

		if (acs_darkness_intensity[i] >= 1.0)
		{
			acs_darkness_intensity[i] = 0.95;
		}

		acs_darkness_start[i] 		= (int) (60.f * ACS_Settings_Main_Float(acs_darkness_areaNames[i * usingGlobal],'acs_darkness_sunset_time', 20));
		acs_darkness_startTime[i]	= (int) (60.f * ACS_Settings_Main_Float(acs_darkness_areaNames[i * usingGlobal],'acs_hours_before_full_darkness', 4));
		acs_darkness_end[i] 		= (int) (60.f * ACS_Settings_Main_Float(acs_darkness_areaNames[i * usingGlobal],'acs_darkness_sunrise_time', 5));
		acs_darkness_endTime[i] 	= (int) (60.f * ACS_Settings_Main_Float(acs_darkness_areaNames[i * usingGlobal],'acs_hours_before_full_darkness_end', 4));

		if (oldIntensity 	!= acs_darkness_intensity[i] 	
		||  oldStart 		!= acs_darkness_start[i] 	
		||	oldStartTime 	!= acs_darkness_startTime[i] 	
		||	oldEnd 			!= acs_darkness_end[i] 		
		||	oldEndTime 		!= acs_darkness_endTime[i]	
		||	oldNightEnvEnabled != nightEnvEnabled 
		)
		{
			change = true;
		}
	}

	if ((change || acs_darkness_currArea != theGame.GetCommonMapManager().GetCurrentArea()) && !acs_darkness_justSpawned)
	{
		CheckDayNightCycle();
	}

	theGame.envMgr.ACS_SetDayStartAt(acs_darkness_end[acs_darkness_currArea]);
	theGame.envMgr.ACS_SetNightStart(acs_darkness_start[acs_darkness_currArea] + acs_darkness_startTime[acs_darkness_currArea]);
}

@wrapMethod( CR4Player ) function CheckDayNightCycle()
{
	var time : GameTime;
	var nextCallTime : int;
	var isNight, isDay, isAlmostNight, isStartingDay : bool;
	var currTime, targetTime, sec : int;

	if(false)
	{
		wrappedMethod();
	}

	acs_darkness_currArea = theGame.GetCommonMapManager().GetCurrentArea();

	if (acs_darkness_currArea != AN_NMLandNovigrad
	&& acs_darkness_currArea != AN_Skellige_ArdSkellig
	&& acs_darkness_currArea != AN_Kaer_Morhen
	&& acs_darkness_currArea != AN_Prologue_Village
	&& acs_darkness_currArea != AN_Wyzima
	&& acs_darkness_currArea != AN_Island_of_Myst
	&& acs_darkness_currArea != AN_Spiral
	&& acs_darkness_currArea != AN_Velen
	&& acs_darkness_currArea != AN_Bob
	)
	{
		acs_darkness_currArea = AN_Kaer_Morhen;
	}

	if (acs_darkness_currArea != acs_darkness_prevArea)
	{
		acs_darkness_prevArea = acs_darkness_currArea;

		theGame.envMgr.ACS_SetDayStartAt(acs_darkness_end[acs_darkness_currArea]);
		theGame.envMgr.ACS_SetNightStart(acs_darkness_start[acs_darkness_currArea] + acs_darkness_startTime[acs_darkness_currArea]);
	}

	isNight = theGame.envMgr.IsNight();

	isDay = theGame.envMgr.IsDay();

	isStartingDay = theGame.envMgr.ACS_IsStartingDay(acs_darkness_endTime[acs_darkness_currArea]);

	isAlmostNight = theGame.envMgr.ACS_IsAlmostNight(acs_darkness_startTime[acs_darkness_currArea]);

	if(isNight)
	{
		OnNightStarted();
		nextCallTime = acs_darkness_end[acs_darkness_currArea];
	}
	else if(isAlmostNight)
	{
		ACS_OnNightAlmostStarted();
		nextCallTime = (acs_darkness_start[acs_darkness_currArea] + acs_darkness_startTime[acs_darkness_currArea]);
	}
	else if(isStartingDay)
	{
		ACS_OnDayJustStarted();
		nextCallTime = (acs_darkness_end[acs_darkness_currArea] + acs_darkness_endTime[acs_darkness_currArea]);
	}
	else if(isDay)
	{
		OnDayStarted();
		nextCallTime = acs_darkness_start[acs_darkness_currArea];
	}

	if(nextCallTime < 0 || nextCallTime > 24 * 60)
	{
		nextCallTime = 1;
	}

	sec = GameTimeToSeconds(theGame.GetGameTime());

	currTime =  sec - (sec / (24 * 3600)) * (24 * 3600);

	targetTime = nextCallTime * 60;

	if (currTime > targetTime)
		targetTime += 24 * 3600;

	time = GameTimeCreateFromGameSeconds(targetTime - currTime);

	AddGameTimeTimer('DayNightCycle', time);
}

@addMethod( CR4Player ) function ACS_CheckDayNightCycle()
{
	CheckDayNightCycle();
}

@wrapMethod( CR4Player ) function OnNightStarted()
{
	var pam : W3PlayerAbilityManager;

	if(false)
	{
		wrappedMethod();
	}

	if(CanUseSkill(S_Perk_01))
	{
		pam = (W3PlayerAbilityManager)abilityManager;
		pam.SetPerk01Abilities(false, true);
	}

	if(acs_darkness_envId > -1)
	{
		DeactivateEnvironment( acs_darkness_envId,0.0f); 
	}
		
	if(acs_darkness_envId2 > -1)
	{
		DeactivateEnvironment( acs_darkness_envId2,0.0f);
	}

	acs_darkness_envId = -1;
	acs_darkness_envId2 = -1;

	if ((theGame.GetWorld().GetDepotPath() == "dlc\bob\data\levels\bob\bob.w2w"))
	{
		if (ACS_Settings_Main_Bool('acs_world_visual_settings','acs_spiral_sky_moon_enabled', true))
		{
			if (ACS_Settings_Main_Bool('acs_darkness_settings_main','acs_darkness_HBAO_enabled', true))
			{
				if(acs_darkness_env_bob_HBAO_red_moon)
				{
					acs_darkness_envId = ActivateEnvironmentDefinition( acs_darkness_env_bob_HBAO_red_moon,  99999, acs_darkness_intensity[acs_darkness_currArea], 0.0f );
				}
			}
			else
			{
				if(acs_darkness_env_bob_red_moon)
				{
					acs_darkness_envId = ActivateEnvironmentDefinition( acs_darkness_env_bob_red_moon,  99999, acs_darkness_intensity[acs_darkness_currArea], 0.0f );
				}
			}
		}
		else
		{
			if (ACS_Settings_Main_Bool('acs_darkness_settings_main','acs_darkness_HBAO_enabled', true))
			{
				if(acs_darkness_env_bob_HBAO)
				{
					acs_darkness_envId = ActivateEnvironmentDefinition( acs_darkness_env_bob_HBAO,  99999, acs_darkness_intensity[acs_darkness_currArea], 0.0f );
				}
			}
			else
			{
				if(acs_darkness_env_bob)
				{
					acs_darkness_envId = ActivateEnvironmentDefinition( acs_darkness_env_bob,  99999, acs_darkness_intensity[acs_darkness_currArea], 0.0f );
				}
			}
		}	
	}
	else
	{
		if (ACS_Settings_Main_Bool('acs_world_visual_settings','acs_spiral_sky_moon_enabled', true))
		{
			if (ACS_Settings_Main_Bool('acs_darkness_settings_main','acs_darkness_HBAO_enabled', true))
			{
				if(acs_darkness_env_HBAO_red_moon)
				{
					acs_darkness_envId = ActivateEnvironmentDefinition( acs_darkness_env_HBAO_red_moon,  99999, acs_darkness_intensity[acs_darkness_currArea], 0.0f );
				}
			}
			else
			{
				if(acs_darkness_env_red_moon)
				{
					acs_darkness_envId = ActivateEnvironmentDefinition( acs_darkness_env_red_moon,  99999, acs_darkness_intensity[acs_darkness_currArea], 0.0f );
				}
			}
		}
		else
		{
			if (ACS_Settings_Main_Bool('acs_darkness_settings_main','acs_darkness_HBAO_enabled', true))
			{
				if(acs_darkness_env_HBAO)
				{
					acs_darkness_envId = ActivateEnvironmentDefinition( acs_darkness_env_HBAO,  99999, acs_darkness_intensity[acs_darkness_currArea], 0.0f );
				}
			}
			else
			{
				if(acs_darkness_env)
				{
					acs_darkness_envId = ActivateEnvironmentDefinition( acs_darkness_env,  99999, acs_darkness_intensity[acs_darkness_currArea], 0.0f );
				}
			}
		}	
	}

	/////////////////////////////////////////////////////////////////////////////////////////////////////////////

	if (ACS_Settings_Main_Bool('acs_world_visual_settings','acs_spiral_sky_stars_enabled', true))
	{
		ACSGetCEntity('acs_spiral_star_entity').PlayEffectSingle('stars');

		//ACSGetCEntity('acs_spiral_star_entity').PlayEffectSingle('stars_red');

		//ACSGetCEntity('acs_spiral_star_entity').PlayEffectSingle('stars_mix');
	}

	if (ACS_Settings_Main_Bool('acs_world_visual_settings','acs_spiral_sky_planets_enabled', true))
	{
		ACSGetCEntity('acs_spiral_entity').PlayEffectSingle('spiral_sky_original_second_moon');
	}

	/////////////////////////////////////////////////////////////////////////////////////////////////////////////

	if ( FactsQuerySum("ACS_Darkness_Upon_Us") <= 0 )
	{
		FactsAdd("ACS_Darkness_Upon_Us", 1, -1);
	}
}

@addMethod( CR4Player ) function ACS_OnNightAlmostStarted()
{
	var hoursAndMins : float;
	var timeToBlend : float;
	
	var intensity1 : float;
	var intensity2 : float;

	var resumeFactor : float;
	var resumeI1 : float; 
	var resumeI2 : float;

	hoursAndMins = theGame.envMgr.ACS_GetTimeInMinutes() + (float) GameTimeSeconds(theGame.GetGameTime()) / 60.f; 

	timeToBlend = ( (float) (acs_darkness_start[acs_darkness_currArea] + acs_darkness_startTime[acs_darkness_currArea]) - hoursAndMins) * (1.0 / theGame.GetHoursPerMinute());

	if (timeToBlend < 0.f)
	{
		timeToBlend = 0.f;
	}

	GetACSWatcher().Custom_Env_Switch('day_env', false);

	if(acs_darkness_envId > -1)
	{
		DeactivateEnvironment( acs_darkness_envId,0.0f); 
	}
		
	if(acs_darkness_envId2 > -1)
	{
		DeactivateEnvironment( acs_darkness_envId2,0.0f);
	}
	
	acs_darkness_envId = -1;
	acs_darkness_envId2 = -1;

	/////////////////////////////////////////////////////////////////////////////////////////////////////////////
	
	resumeFactor = (hoursAndMins - (float) acs_darkness_start[acs_darkness_currArea]) / (float) acs_darkness_startTime[acs_darkness_currArea];

	resumeI1 = acs_darkness_intensity[acs_darkness_currArea] * resumeFactor;

	if(resumeI1 >= 1.0)
	{
		resumeI1 = 0.9;
	}

	if (resumeI1 < 1.0)
	{
		resumeI2 = (acs_darkness_intensity[acs_darkness_currArea] - resumeI1) / (1.0f - resumeI1);

		if(resumeI2 >= 1.0)
		{
			resumeI2 = 0.9;
		}
	}
	else
	{
		resumeI2 = 0.9;
	}
		
	/////////////////////////////////////////////////////////////////////////////////////////////////////////////

	if ((theGame.GetWorld().GetDepotPath() == "dlc\bob\data\levels\bob\bob.w2w"))
	{
		if (ACS_Settings_Main_Bool('acs_world_visual_settings','acs_spiral_sky_moon_enabled', true))
		{
			if (ACS_Settings_Main_Bool('acs_darkness_settings_main','acs_darkness_HBAO_enabled', true))
			{
				if (acs_darkness_envId2 < 0 && acs_darkness_env_bob_HBAO_red_moon)
				{
					acs_darkness_envId2 = ActivateEnvironmentDefinition( acs_darkness_env_bob_HBAO_red_moon,  99999, resumeI1, 0.0f);
				}

				if(acs_darkness_env_bob_HBAO_red_moon)
				{
					acs_darkness_envId = ActivateEnvironmentDefinition( acs_darkness_env_bob_HBAO_red_moon,  99999, resumeI2, timeToBlend );
				}
			}
			else
			{
				if (acs_darkness_envId2 < 0 && acs_darkness_env_bob_red_moon)
				{
					acs_darkness_envId2 = ActivateEnvironmentDefinition( acs_darkness_env_bob_red_moon,  99999, resumeI1, 0.0f);
				}

				if(acs_darkness_env_bob_red_moon)
				{
					acs_darkness_envId = ActivateEnvironmentDefinition( acs_darkness_env_bob_red_moon,  99999, resumeI2, timeToBlend );
				}
			}
		}
		else
		{
			if (ACS_Settings_Main_Bool('acs_darkness_settings_main','acs_darkness_HBAO_enabled', true))
			{
				if (acs_darkness_envId2 < 0 && acs_darkness_env_bob_HBAO)
				{
					acs_darkness_envId2 = ActivateEnvironmentDefinition( acs_darkness_env_bob_HBAO,  99999, resumeI1, 0.0f);
				}

				if(acs_darkness_env_bob_HBAO)
				{
					acs_darkness_envId = ActivateEnvironmentDefinition( acs_darkness_env_bob_HBAO,  99999, resumeI2, timeToBlend );
				}
			}
			else
			{
				if (acs_darkness_envId2 < 0 && acs_darkness_env_bob)
				{
					acs_darkness_envId2 = ActivateEnvironmentDefinition( acs_darkness_env_bob,  99999, resumeI1, 0.0f);
				}

				if(acs_darkness_env_bob)
				{
					acs_darkness_envId = ActivateEnvironmentDefinition( acs_darkness_env_bob,  99999, resumeI2, timeToBlend );
				}
			}
		}	
	}
	else
	{
		if (ACS_Settings_Main_Bool('acs_world_visual_settings','acs_spiral_sky_moon_enabled', true))
		{
			if (ACS_Settings_Main_Bool('acs_darkness_settings_main','acs_darkness_HBAO_enabled', true))
			{
				if (acs_darkness_envId2 < 0 && acs_darkness_env_HBAO_red_moon)
				{
					acs_darkness_envId2 = ActivateEnvironmentDefinition( acs_darkness_env_HBAO_red_moon,  99999, resumeI1, 0.0f);
				}

				if(acs_darkness_env_HBAO_red_moon)
				{
					acs_darkness_envId = ActivateEnvironmentDefinition( acs_darkness_env_HBAO_red_moon,  99999, resumeI2, timeToBlend );
				}
			}
			else
			{
				if (acs_darkness_envId2 < 0 && acs_darkness_env_red_moon)
				{
					acs_darkness_envId2 = ActivateEnvironmentDefinition( acs_darkness_env_red_moon,  99999, resumeI1, 0.0f);
				}

				if(acs_darkness_env_red_moon)
				{
					acs_darkness_envId = ActivateEnvironmentDefinition( acs_darkness_env_red_moon,  99999, resumeI2, timeToBlend );
				}
			}
		}
		else
		{
			if (ACS_Settings_Main_Bool('acs_darkness_settings_main','acs_darkness_HBAO_enabled', true))
			{
				if (acs_darkness_envId2 < 0 && acs_darkness_env_HBAO)
				{
					acs_darkness_envId2 = ActivateEnvironmentDefinition( acs_darkness_env_HBAO,  99999, resumeI1, 0.0f);
				}

				if(acs_darkness_env_HBAO)
				{
					acs_darkness_envId = ActivateEnvironmentDefinition( acs_darkness_env_HBAO,  99999, resumeI2, timeToBlend );
				}
			}
			else
			{
				if (acs_darkness_envId2 < 0 && acs_darkness_env)
				{
					acs_darkness_envId2 = ActivateEnvironmentDefinition( acs_darkness_env,  99999, resumeI1, 0.0f);
				}

				if(acs_darkness_env)
				{
					acs_darkness_envId = ActivateEnvironmentDefinition( acs_darkness_env,  99999, resumeI2, timeToBlend );
				}
			}
		}	
	}

	if ( FactsQuerySum("ACS_Darkness_Upon_Us") <= 0 )
	{
		FactsAdd("ACS_Darkness_Upon_Us", 1, -1);
	}
}

@wrapMethod( CR4Player ) function OnDayStarted()
{
	var pam : W3PlayerAbilityManager;
	var hoursAndMins : float;

	if(false)
	{
		wrappedMethod();
	}
	
	hoursAndMins = theGame.envMgr.ACS_GetTimeInMinutes() + (float) GameTimeSeconds(theGame.GetGameTime()) / 60.f;

	if(CanUseSkill(S_Perk_01))
	{
		pam = (W3PlayerAbilityManager)abilityManager;
		pam.SetPerk01Abilities(true, false);
	}

	if (hoursAndMins >= (float) (acs_darkness_end[acs_darkness_currArea] + acs_darkness_endTime[acs_darkness_currArea]))
	{
		if(acs_darkness_envId > -1)
		{
			DeactivateEnvironment( acs_darkness_envId,0.0f); 
		}
			
		if(acs_darkness_envId2 > -1)
		{
			DeactivateEnvironment( acs_darkness_envId2,0.0f);
		}

		acs_darkness_envId = -1;
		acs_darkness_envId2 = -1;
	}	

	GetACSWatcher().Custom_Env_Switch('day_env', true);

	ACSGetCEntity('acs_spiral_star_entity').StopEffect('stars');

	ACSGetCEntity('acs_spiral_star_entity').StopEffect('stars_red');

	ACSGetCEntity('acs_spiral_star_entity').StopEffect('stars_mix');

	ACSGetCEntity('acs_spiral_entity').DestroyEffect('spiral_sky_original_second_moon');

	if (FactsQuerySum("ACS_Darkness_Upon_Us") > 0)
	{
		FactsRemove("ACS_Darkness_Upon_Us");
	}		
}

@addMethod( CR4Player ) function ACS_OnDayJustStarted()
{
	var pam : W3PlayerAbilityManager;
	var hoursAndMins : float;
	var timeToBlend : float;
	var timeToDeBlend : float;
	var adaptFactor : float;
	var intensity1 : float;
	var resumeFactor : float;
	var resumeI1 : float;
	var resumeI2 : float;

	hoursAndMins = theGame.envMgr.ACS_GetTimeInMinutes() + (float) GameTimeSeconds(theGame.GetGameTime()) / 60.f;

	if(CanUseSkill(S_Perk_01))
	{
		pam = (W3PlayerAbilityManager)abilityManager;
		pam.SetPerk01Abilities(true, false);
	}

	timeToBlend = (acs_darkness_end[acs_darkness_currArea] + acs_darkness_endTime[acs_darkness_currArea] - hoursAndMins) * (1.0 / theGame.GetHoursPerMinute());

	if(acs_darkness_envId > -1)
	{
		DeactivateEnvironment( acs_darkness_envId,0.0f); 
	}
		
	if(acs_darkness_envId2 > -1)
	{
		DeactivateEnvironment( acs_darkness_envId2,0.0f);
	}

	acs_darkness_envId = -1;
	acs_darkness_envId2 = -1;

	/////////////////////////////////////////////////////////////////////////////////////////////////////////////

	resumeFactor = ( (float) (acs_darkness_end[acs_darkness_currArea] + acs_darkness_endTime[acs_darkness_currArea]) - hoursAndMins) / acs_darkness_endTime[acs_darkness_currArea];
	resumeI1 = acs_darkness_intensity[acs_darkness_currArea] * resumeFactor;

	if ((theGame.GetWorld().GetDepotPath() == "dlc\bob\data\levels\bob\bob.w2w"))
	{
		if (ACS_Settings_Main_Bool('acs_world_visual_settings','acs_spiral_sky_moon_enabled', true))
		{
			if (ACS_Settings_Main_Bool('acs_darkness_settings_main','acs_darkness_HBAO_enabled', true))
			{
				if(acs_darkness_env_bob_HBAO_red_moon)
				{
					acs_darkness_envId = ActivateEnvironmentDefinition( acs_darkness_env_bob_HBAO_red_moon,  99999, resumeI1, 0.0f );

					AddGameTimeTimer('ACS_DeactivateDarkness', GameTimeCreate(0, 0, 0, 0));
				}
			}
			else
			{
				if(acs_darkness_env_bob_red_moon)
				{
					acs_darkness_envId = ActivateEnvironmentDefinition( acs_darkness_env_bob_red_moon,  99999, resumeI1, 0.0f );

					AddGameTimeTimer('ACS_DeactivateDarkness', GameTimeCreate(0, 0, 0, 0));
				}
			}
		}
		else
		{
			if (ACS_Settings_Main_Bool('acs_darkness_settings_main','acs_darkness_HBAO_enabled', true))
			{
				if(acs_darkness_env_bob_HBAO)
				{
					acs_darkness_envId = ActivateEnvironmentDefinition( acs_darkness_env_bob_HBAO,  99999, resumeI1, 0.0f );

					AddGameTimeTimer('ACS_DeactivateDarkness', GameTimeCreate(0, 0, 0, 0));
				}
			}
			else
			{
				if(acs_darkness_env_bob)
				{
					acs_darkness_envId = ActivateEnvironmentDefinition( acs_darkness_env_bob,  99999, resumeI1, 0.0f );

					AddGameTimeTimer('ACS_DeactivateDarkness', GameTimeCreate(0, 0, 0, 0));
				}
			}
		}	
	}
	else
	{
		if (ACS_Settings_Main_Bool('acs_world_visual_settings','acs_spiral_sky_moon_enabled', true))
		{
			if (ACS_Settings_Main_Bool('acs_darkness_settings_main','acs_darkness_HBAO_enabled', true))
			{
				if(acs_darkness_env_HBAO_red_moon)
				{
					acs_darkness_envId = ActivateEnvironmentDefinition( acs_darkness_env_HBAO_red_moon,  99999, resumeI1, 0.0f );

					AddGameTimeTimer('ACS_DeactivateDarkness', GameTimeCreate(0, 0, 0, 0));
				}
			}
			else
			{
				if(acs_darkness_env_red_moon)
				{
					acs_darkness_envId = ActivateEnvironmentDefinition( acs_darkness_env_red_moon,  99999, resumeI1, 0.0f );

					AddGameTimeTimer('ACS_DeactivateDarkness', GameTimeCreate(0, 0, 0, 0));
				}
			}
		}
		else
		{
			if (ACS_Settings_Main_Bool('acs_darkness_settings_main','acs_darkness_HBAO_enabled', true))
			{
				if(acs_darkness_env_HBAO)
				{
					acs_darkness_envId = ActivateEnvironmentDefinition( acs_darkness_env_HBAO,  99999, resumeI1, 0.0f );

					AddGameTimeTimer('ACS_DeactivateDarkness', GameTimeCreate(0, 0, 0, 0));
				}
			}
			else
			{
				if(acs_darkness_env)
				{
					acs_darkness_envId = ActivateEnvironmentDefinition( acs_darkness_env,  99999, resumeI1, 0.0f );

					AddGameTimeTimer('ACS_DeactivateDarkness', GameTimeCreate(0, 0, 0, 0));
				}
			}
		}	
	}

	if (FactsQuerySum("ACS_Darkness_Upon_Us") > 0)
	{
		FactsRemove("ACS_Darkness_Upon_Us");
	}
}

@addMethod( CR4Player ) timer function ACS_DeactivateDarkness(dt : GameTime, id : int)
{
	var hoursAndMins : float;
	var timeToBlend : float;

	hoursAndMins = theGame.envMgr.ACS_GetTimeInMinutes();

	timeToBlend = ( (float) (acs_darkness_end[acs_darkness_currArea] + acs_darkness_endTime[acs_darkness_currArea]) - hoursAndMins) * (1.0 / theGame.GetHoursPerMinute());

	DeactivateEnvironment(acs_darkness_envId, timeToBlend);
}

@addMethod( CR4Player ) function ACS_OnMeditateStop(simulatedTime : float)
{
	GetWitcherPlayer().MeditationRestoring(simulatedTime);
	CheckDayNightCycle();
}

@addMethod( CR4Player ) function ACS_DeactivateDarknessGlobal()
{
	if(acs_darkness_envId > -1)
	{
		DeactivateEnvironment( acs_darkness_envId,0.0f); 
	}
		
	if(acs_darkness_envId2 > -1)
	{
		DeactivateEnvironment( acs_darkness_envId2,0.0f);
	}

	if (FactsQuerySum("ACS_Darkness_Upon_Us") > 0)
	{
		FactsRemove("ACS_Darkness_Upon_Us");
	}
}	

@wrapMethod( MeditationWaiting ) function MeditationWaiting_Loop()
{
	var blendInTime : float;

	if(false)
	{
		wrappedMethod();
	}

	blendInTime = BlendIn();
	
	if(!abortRequested)
	{
		KeepWaiting(theGame.GetGameTime() - waitStartTime);
	}

	BlendOut(2 * BLEND_TIME_SECONDS_REAL - blendInTime);
	
	theGame.SetHoursPerMinute(storedHoursPerMinute);
	
	if(!abortRequested)
	{
		theGame.SetGameTime(requestedTargetTime, false);
	}

	thePlayer.ACS_OnMeditateStop( FinalHack_GetSimulateBuffTime() );
	
	abortRequested = false;
	virtual_parent.PopState();
	virtual_parent.PushState('Meditation');	
}

@wrapMethod( Unconscious ) function TimeFlow()
{
	wrappedMethod();

	thePlayer.ACS_CheckDayNightCycle();
}

@wrapMethod( CR4MenuBase ) function showNotification( notificationText : string, optional duration : float, optional queue : bool ):void
{
	if(notificationText == GetLocStringByKeyExt("ui_cloud_gog_sign_in_success"))
	{
		return;
	}
	
	wrappedMethod(notificationText, duration, queue);
}

@wrapMethod( UseGenericVehicle ) function OnEnterState( prevStateName : name )
{
	if (false)
	{
		wrappedMethod(prevStateName);
	}

	super.OnEnterState(prevStateName);
	
	parent.SetOrientationTarget( OT_Camera );
	
	camera = (CCustomCamera)theCamera.GetTopmostCameraObject();
	
	if ( (W3ReplacerCiri)parent )
	{
		parent.SetBehaviorVariable( 'test_ciri_replacer', 1.0f );
	}
	else
	{
		signSlotNames.PushBack( 'Slot2' );
		signSlotNames.PushBack( 'Slot3' );
		signSlotNames.PushBack( 'Slot4' );
		signSlotNames.PushBack( 'Slot5' );
		((W3PlayerWitcher)parent).EnableRadialSlotsWithSource( true, signSlotNames, 'throwProjectileOnVehicle' );	
		signSlotNames.Clear();

		if ( (W3HorseComponent)vehicle )
		{
			signSlotNames.PushBack('Yrden');
			//signSlotNames.PushBack('Quen');
			//signSlotNames.PushBack('Igni');
			//signSlotNames.PushBack('Aard');
			//signSlotNames.PushBack( 'Slot4' );
			//signSlotNames.PushBack( 'Slot5' );
			if ( thePlayer.GetVehicleCachedSign() == ST_None )
				thePlayer.SetVehicleCachedSign( ((W3PlayerWitcher)parent).GetEquippedSign() );
			((W3PlayerWitcher)parent).SetEquippedSign(ST_Axii);
			((W3PlayerWitcher)parent).EnableRadialSlotsWithSource(false,signSlotNames, 'useVehicle');
		}
		else if ( (CBoatComponent)vehicle )
		{
			//signSlotNames.PushBack( 'Slot1' );
			//signSlotNames.PushBack( 'Slot2' );
			//signSlotNames.PushBack( 'Slot4' );
			//signSlotNames.PushBack( 'Slot5' );
			signSlotNames.PushBack('Yrden');
			signSlotNames.PushBack('Quen');
			signSlotNames.PushBack('Igni');
			signSlotNames.PushBack('Aard');
			signSlotNames.PushBack('Axii');	
			
			if ( thePlayer.GetVehicleCachedSign() == ST_None )
				thePlayer.SetVehicleCachedSign( ((W3PlayerWitcher)parent).GetEquippedSign() );
			((W3PlayerWitcher)parent).SelectQuickslotItem( EES_RangedWeapon );	
			((W3PlayerWitcher)parent).SetEquippedSign(ST_None);
			((W3PlayerWitcher)parent).EnableRadialSlotsWithSource(false,signSlotNames, 'useVehicle');
		}
	}
}

@wrapMethod( UseGenericVehicle ) function  OnPlayerTickTimer( deltaTime : float )
{
	var rightStickVector	: Vector;
	var rightStickLength	: float;

	if (false)
	{
		wrappedMethod(deltaTime);
	}
	
	if ( parent.IsHardLockEnabled() )
	{
		if ( parent.IsPCModeEnabled() )
		{
			rightStickVector.X = theInput.GetActionValue( 'GI_MouseDampX' ); 
			rightStickVector.Y = theInput.GetActionValue( 'GI_MouseDampY' ); 			
		}
		else
		{
			rightStickVector.X = theInput.GetActionValue( 'GI_AxisRightX' ); 
			rightStickVector.Y = theInput.GetActionValue( 'GI_AxisRightY' ); 
		}

		rightStickLength = VecLength( rightStickVector );
		
		if ( rightStickLength > 0 )
			parent.bRAxisReleased = false;
		else
			parent.bRAxisReleased = true;			
			
		if ( !parent.ProcessLockTargetSelectionInput( rightStickVector, rightStickLength ) )
			parent.ProcessLockTargetSelectionInput( rightStickVector, rightStickLength );
		
		if ( rightStickLength >= 0.3 )
			FindTarget();
	}
	else
	{
		FindTarget();
	}
		
	
}
	

@wrapMethod( UseGenericVehicle ) function OnLeaveState( nextStateName : name )
{
	if (false)
	{
		wrappedMethod(nextStateName);
	}

	if ( (W3PlayerWitcher)parent )
	{
		signSlotNames.Clear();

		signSlotNames.PushBack( 'Slot1' );
		signSlotNames.PushBack( 'Slot2' );
		signSlotNames.PushBack( 'Slot4' );
		signSlotNames.PushBack( 'Slot5' );
		signSlotNames.PushBack('Yrden');
		signSlotNames.PushBack('Quen');
		signSlotNames.PushBack('Igni');
		signSlotNames.PushBack('Aard');
		signSlotNames.PushBack('Axii');	

		((W3PlayerWitcher)parent).EnableRadialSlotsWithSource(true,signSlotNames, 'useVehicle');
		
		if ( thePlayer.GetVehicleCachedSign() != ST_None )
			((W3PlayerWitcher)parent).SetEquippedSign( thePlayer.GetVehicleCachedSign() );
	}
	
	signSlotNames.Clear();
	
	if ( nextStateName != 'None' )
		thePlayer.SetVehicleCachedSign( ST_None );
	
	if ( nextStateName != 'DismountHorse' )
		parent.OnRangedForceHolster( true, true );
		
	super.OnLeaveState(nextStateName);
}

@wrapMethod( CastSign ) function StartCastingSign()
{
	var ent, ent_2, ent_3, ent_4 		: CEntity;
	var bone_vec, attach_vec, pPos		: Vector;
	var bone_rot, attach_rot			: EulerAngles;
	var movementAdjustor				: CMovementAdjustor;
	var ticket 							: SMovementAdjustmentRequestTicket;

	if(false)
	{
		wrappedMethod();
	}

	if(witcher)
	{
		if(witcher.GetEquippedSign() == ST_Axii )
		{
			if( theInput.IsActionPressed( 'VehicleCastSign' ) )
			{
				if (RandF() < 0.25)
				{
					GetACSWatcher().HorseSpeakController('hocus_pocus');
				}

				ACSGetCEntity('ACS_Quen_Bubble').Destroy();

				ACSGetCEntity('ACS_Quen_Fx').Destroy();

				ACSGetCEntity('ACS_Sign_Icon').Destroy();

				ACSGetCEntity('ACS_Sign_Icon_Anchor').Destroy();

				ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
				"dlc\dlc_acs\data\fx\sign_icons.w2ent"
				, true ), witcher.GetWorldPosition(), witcher.GetWorldRotation() );

				ent_2 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
				"dlc\dlc_acs\data\fx\sign_icons.w2ent"
				, true ), witcher.GetWorldPosition(), witcher.GetWorldRotation() );

				witcher.GetBoneWorldPositionAndRotationByIndex( witcher.GetBoneIndex( 'l_handRoll' ), bone_vec, bone_rot );

				attach_rot.Roll = 0;
				attach_rot.Pitch = 0;
				attach_rot.Yaw = 0;
				attach_vec.X = 0.4;
				attach_vec.Y = 0.15;
				attach_vec.Z = 0;

				ent.CreateAttachmentAtBoneWS( GetWitcherPlayer(), 'l_handRoll', bone_vec, bone_rot );

				ent_2.CreateAttachment( ent, , attach_vec, attach_rot );

				ent.AddTag('ACS_Sign_Icon_Anchor');

				ent_2.AddTag('ACS_Sign_Icon');

				if ((ACS_Armor_Set_Check('forgotten_wolf', false) 
				|| ACS_Armor_Set_Check('acs_armor', false)
				|| ACS_Armor_Set_Check('volhikar', false)
				|| thePlayer.HasTag('acs_vampire_claws_equipped')
				|| ACS_Vampire_Claws_Access()
				))
				{
					ent_2.PlayEffectSingle('axii_icon_red');
				}
				else
				{
					ent_2.PlayEffectSingle('axii_icon');
				}
			}

			if( witcher.GetBehaviorVariable( 'actionType' ) != (int)EHCA_CastSign )
			{
				witcher.SetBehaviorVariable( 'IsCastingSign', 1.0 );
				witcher.SetBehaviorVariable( 'actionType', (int)EHCA_CastSign );
				witcher.WaitForBehaviorNodeActivation( 'castSignActionOn', 0.5f );
			}

			if( !witcher.CastSign() )
			{
				CastingSignFailed();
			}
			
			while( true )
			{
				SleepOneFrame();
				
				if( theInput.IsActionPressed( 'VehicleCastSign' )  )
				{
					ApplyEffectOnHorse( 0.1 );
				}
				else
				{
					break;
				}	
			}
		}
		else 
		{
			if( theInput.IsActionPressed( 'VehicleCastSign' ) 
			&& FactsQuerySum("ACS_Is_Casting_Horse_Sign") <= 0
			)
			{
				if (thePlayer.GetStat(BCS_Stamina) > thePlayer.GetStatMax(BCS_Stamina) * 0.01)
				{
					if(witcher.GetEquippedSign() == ST_Aard )
					{
						if( theInput.IsActionPressed( 'VehicleCastSign' )  )
						{
							GetACSWatcher().RemoveTimer('HorseRidingAard360DealDamage');
							
							thePlayer.RaiseEvent( 'ACS_CastAardLocomotion' );

							GetACSWatcher().AddTimer('HorseRidingAard360DealDamage', 0.5 , false );
						}
					}
					else if(witcher.GetEquippedSign() == ST_Igni )
					{
						if( theInput.IsActionPressed( 'VehicleCastSign' )  )
						{
							GetACSWatcher().RemoveTimer('HorseRidingIgni360DealDamage');
							
							thePlayer.RaiseEvent( 'ACS_CastIgniLocomotion' );

							GetACSWatcher().AddTimer('HorseRidingIgni360DealDamage', 0.5 , false );
						}
					}
					else if(witcher.GetEquippedSign() == ST_Quen )
					{
						if( theInput.IsActionPressed( 'VehicleCastSign' )  )
						{
							GetACSWatcher().RemoveTimer('HorseRidingQuen');

							thePlayer.RaiseEvent( 'ACS_CastQuenIdle' );

							GetACSWatcher().AddTimer('HorseRidingQuen', 0.5 , false );
						}
					}

					FactsAdd("ACS_Is_Casting_Horse_Sign", 1, -1);
				}
				else
				{
					thePlayer.SoundEvent("gui_no_stamina");
				}
			}
		}
		
		FinishCasting();
	}
}

@wrapMethod( CastSign ) function FinishCasting()
{
	if(false)
	{
		wrappedMethod();
	}

	if(GetWitcherPlayer().GetEquippedSign() == ST_Axii )
	{
		ACSGetCEntity('ACS_Sign_Icon').DestroyAfter(0.125);

		ACSGetCEntity('ACS_Sign_Icon_Anchor').DestroyAfter(0.125);

		witcher.RaiseEvent( 'actionFinished' );
		witcher.WaitForBehaviorNodeActivation( 'ActionOff', 1.0 );
	}

	parent.PopState( true );
}

@wrapMethod( CastSign ) function OnLeaveState( nexStateName : name )
{
	if(false)
	{
		wrappedMethod(nexStateName);
	}

	super.OnLeaveState( nexStateName );
	
	if(GetWitcherPlayer().GetEquippedSign() == ST_Axii )
	{
		theInput.ForceDeactivateAction( 'VehicleCastSign' );
		
		witcher.SetBehaviorVariable( 'IsCastingSign', 0.0 );
		witcher.CastSignAbort();
		witcher.SetCurrentlyCastSign( ST_None, NULL );
		
		if( horseComp.GetPanicPercent() > 0.05 )
		{
			horse.RemoveAbility( 'HorseAxiiBuff' );
		}
		else
		{
			horse.AddTimer( 'RemoveAxiiFromHorse', 5.0 );
			ApplyEffectOnHorse( 5.0 );
		}
	}
}

@wrapMethod( CR4HudModuleControlsFeedback ) function UpdateSwordDisplay()
{
	if(false)
	{
		wrappedMethod();
	}

	ACS_UpdateSwordDisplay();
}

@addMethod( CR4HudModuleControlsFeedback ) function ACS_UpdateSwordDisplay()
{
	switch( m_currentPlayerWeapon )
	{
		case PW_Silver :
			if (thePlayer.HasTag('ACS_Is_Sneaking')
			|| GetACSWatcher().ACS_IS_SNEAKING)
			{
				m_fxSetSwordTextSFF.InvokeSelfOneArg(FlashArgString(GetLocStringByKeyExt("panel_inventory_paperdoll_slotname_silver") +  ": " + GetLocStringById(2117035926)));
			}
			else
			{
				if (FactsQuerySum("ACS_Azkar_Active") > 0)
				{
					m_fxSetSwordTextSFF.InvokeSelfOneArg(FlashArgString(GetLocStringByKeyExt("panel_inventory_paperdoll_slotname_silver") +  ": " + GetLocStringById(2118449049)));
				}
				else
				{
					if (thePlayer.HasTag('ACS_Dual_Wield_Active'))
					{
						m_fxSetSwordTextSFF.InvokeSelfOneArg(FlashArgString(GetLocStringById(2118449866)));
					}
					else if (thePlayer.HasTag('ACS_Spear_Transform_Active'))
					{
						m_fxSetSwordTextSFF.InvokeSelfOneArg(FlashArgString(GetLocStringById(2116581049)));
					}
					else
					{
						if (!GetACSWatcher().silver_strong_stance 
						&& !GetACSWatcher().silver_group_stance
						&& !GetACSWatcher().silver_fast_stance
						)
						{
							m_fxSetSwordTextSFF.InvokeSelfOneArg(FlashArgString(GetLocStringByKeyExt("panel_inventory_paperdoll_slotname_silver") +  ": " + GetLocStringById(2116581198)));
						}
						else if ( !GetACSWatcher().silver_strong_stance 
						&& !GetACSWatcher().silver_group_stance
						&& GetACSWatcher().silver_fast_stance
						)
						{
							m_fxSetSwordTextSFF.InvokeSelfOneArg(FlashArgString(GetLocStringByKeyExt("panel_inventory_paperdoll_slotname_silver") +  ": " + GetLocStringById(2116581193)));
						}
						else if ( 
						GetACSWatcher().silver_group_stance 
						&& !GetACSWatcher().silver_strong_stance 
						&& !GetACSWatcher().silver_fast_stance
						)
						{
							m_fxSetSwordTextSFF.InvokeSelfOneArg(FlashArgString(GetLocStringByKeyExt("panel_inventory_paperdoll_slotname_silver") +  ": " + GetLocStringById(2116581194)));
						}
						else if ( 
						GetACSWatcher().silver_strong_stance 
						&& !GetACSWatcher().silver_group_stance 
						&& !GetACSWatcher().silver_fast_stance 
						)
						{
							m_fxSetSwordTextSFF.InvokeSelfOneArg(FlashArgString(GetLocStringByKeyExt("panel_inventory_paperdoll_slotname_silver") +  ": " + GetLocStringById(2116581195)));
						}
					}
				}
			}
		break;

		case PW_Steel :
			if (thePlayer.HasTag('ACS_Is_Sneaking')
			|| GetACSWatcher().ACS_IS_SNEAKING)
			{
				m_fxSetSwordTextSFF.InvokeSelfOneArg(FlashArgString(GetLocStringByKeyExt("panel_inventory_paperdoll_slotname_steel") +  ": " + GetLocStringById(2117035926)));
			}
			else
			{
				if (FactsQuerySum("ACS_Azkar_Active") > 0)
				{
					m_fxSetSwordTextSFF.InvokeSelfOneArg(FlashArgString(GetLocStringByKeyExt("panel_inventory_paperdoll_slotname_steel") +  ": " + GetLocStringById(2118449049)));
				}
				else
				{
					if (thePlayer.HasTag('ACS_Dual_Wield_Active'))
					{
						m_fxSetSwordTextSFF.InvokeSelfOneArg(FlashArgString(GetLocStringById(2118449866)));
					}
					else if (thePlayer.HasTag('ACS_Spear_Transform_Active'))
					{
						m_fxSetSwordTextSFF.InvokeSelfOneArg(FlashArgString(GetLocStringById(2116581049)));
					}
					else
					{
						if (!GetACSWatcher().steel_strong_stance 
						&& !GetACSWatcher().steel_group_stance
						&& !GetACSWatcher().steel_fast_stance
						)
						{
							m_fxSetSwordTextSFF.InvokeSelfOneArg(FlashArgString(GetLocStringByKeyExt("panel_inventory_paperdoll_slotname_steel") +  ": " + GetLocStringById(2116581198)));
						}
						else if ( !GetACSWatcher().steel_strong_stance 
						&& !GetACSWatcher().steel_group_stance
						&& GetACSWatcher().steel_fast_stance
						)
						{
							m_fxSetSwordTextSFF.InvokeSelfOneArg(FlashArgString(GetLocStringByKeyExt("panel_inventory_paperdoll_slotname_steel") +  ": " + GetLocStringById(2116581193)));
						}
						else if ( 
						GetACSWatcher().steel_group_stance 
						&& !GetACSWatcher().steel_strong_stance 
						&& !GetACSWatcher().steel_fast_stance
						)
						{
							m_fxSetSwordTextSFF.InvokeSelfOneArg(FlashArgString(GetLocStringByKeyExt("panel_inventory_paperdoll_slotname_steel") +  ": " + GetLocStringById(2116581194)));
						}
						else if ( 
						GetACSWatcher().steel_strong_stance 
						&& !GetACSWatcher().steel_group_stance 
						&& !GetACSWatcher().steel_fast_stance 
						)
						{
							m_fxSetSwordTextSFF.InvokeSelfOneArg(FlashArgString(GetLocStringByKeyExt("panel_inventory_paperdoll_slotname_steel") +  ": " + GetLocStringById(2116581195)));
						}
					}
				}
			}
		break;

		case PW_Fists :
			if (thePlayer.HasTag('ACS_Is_Sneaking')
			|| GetACSWatcher().ACS_IS_SNEAKING)
			{
				m_fxSetSwordTextSFF.InvokeSelfOneArg(FlashArgString(GetLocStringById(1063435) +  ": " + GetLocStringById(2117035926)));
			}
			else
			{
				if (thePlayer.HasTag('acs_vampire_claws_equipped'))
				{
					m_fxSetSwordTextSFF.InvokeSelfOneArg(FlashArgString(GetLocStringById(2117035020)));
				}
				else if (thePlayer.HasTag('acs_sorc_fists_equipped'))
				{
					m_fxSetSwordTextSFF.InvokeSelfOneArg(FlashArgString(GetLocStringById(2117035021)));
				} 
				else
				{
					m_fxSetSwordTextSFF.InvokeSelfOneArg(FlashArgString(GetLocStringById(2117035019)));
				}
			}
			
		break;

		case PW_None :
			if (thePlayer.HasTag('ACS_Is_Sneaking')
			|| GetACSWatcher().ACS_IS_SNEAKING)
			{
				m_fxSetSwordTextSFF.InvokeSelfOneArg(FlashArgString(GetLocStringById(1063435) +  ": " + GetLocStringById(2117035926)));
			}
			else
			{
				if (ACS_Vampire_Claws_Access())
				{
					m_fxSetSwordTextSFF.InvokeSelfOneArg(FlashArgString(GetLocStringById(2117035020)));
				}
				else if (thePlayer.HasTag('acs_sorc_fists_equipped'))
				{
					m_fxSetSwordTextSFF.InvokeSelfOneArg(FlashArgString(GetLocStringById(2117035021)));
				} 
				else
				{
					if (!ACS_CombatToExplorationCheck()
					|| thePlayer.IsInCombat()
					|| thePlayer.IsThreatened()
					)
					{
						m_fxSetSwordTextSFF.InvokeSelfOneArg(FlashArgString(GetLocStringById(2117035019)));
					}
					else
					{
						m_fxSetSwordTextSFF.InvokeSelfOneArg(FlashArgString(""));
					}
				}
			}
		break;

		default :
			if (thePlayer.HasTag('ACS_Is_Sneaking')
			|| GetACSWatcher().ACS_IS_SNEAKING)
			{
				m_fxSetSwordTextSFF.InvokeSelfOneArg(FlashArgString(GetLocStringById(1063435) +  ": " + GetLocStringById(2117035926)));
			}
			else
			{
				if (ACS_Vampire_Claws_Access())
				{
					m_fxSetSwordTextSFF.InvokeSelfOneArg(FlashArgString(GetLocStringById(2117035020)));
				}
				else if (thePlayer.HasTag('acs_sorc_fists_equipped'))
				{
					m_fxSetSwordTextSFF.InvokeSelfOneArg(FlashArgString(GetLocStringById(2117035021)));
				} 
				else
				{
					if (!ACS_CombatToExplorationCheck()
					|| thePlayer.IsInCombat()
					|| thePlayer.IsThreatened()
					)
					{
						m_fxSetSwordTextSFF.InvokeSelfOneArg(FlashArgString(GetLocStringById(2117035019)));
					}
					else
					{
						m_fxSetSwordTextSFF.InvokeSelfOneArg(FlashArgString(""));
					}
				}
			}
		break;
	}
}

@wrapMethod( CR4HudModuleControlsFeedback ) function SendInputContextActions( inputContextName :name, optional isForced : bool )
{
	var l_FlashArray			: CScriptedFlashArray;
	var l_DataFlashObject 		: CScriptedFlashObject;
	var bindingGFxData	 		: CScriptedFlashObject;
	var bindingGFxData2	 		: CScriptedFlashObject;
	var l_ActionsArray	 		: array <name>;
	var l_swimingSprint	 		: bool;
	var i	 					: int;
	var outKeys 				: array< EInputKey >;
	var outKeysPC 				: array< EInputKey >;
	var labelPrefix				: string;
	var curAction				: name;
	var bracketOpeningSymbol 	: string;
	var bracketClosingSymbol  	: string;
	var actionLabel			  	: string;
	var attackKeysPC 			: array< EInputKey >;
	var attackModKeysPC 	    : array< EInputKey >;
	var alterAttackKeysPC 	    : array< EInputKey >;
	var modifier				: EInputKey;
	var showCiriMinimap, showCiriObjective : bool;

	if(false)
	{
		wrappedMethod(inputContextName, isForced);
	}
	
	GetBracketSymbols(bracketOpeningSymbol, bracketClosingSymbol);
	
	l_FlashArray = m_flashValueStorage.CreateTempFlashArray();
	l_ActionsArray.Clear();
	l_swimingSprint = false;
	
	if( GetEnabled() )
	{
		if( !isForced && ( m_previousInputContext == m_currentInputContext || ( m_previousInputContext == 'JumpClimb' && m_currentInputContext == 'Exploration' ) || ( m_previousInputContext == 'Exploration' && m_currentInputContext == 'JumpClimb' ) ) )
		{
			return;
		}
		
		m_movementLockType 	= thePlayer.movementLockType;
		m_displaySprint 	= thePlayer.IsActionAllowed(EIAB_RunAndSprint);
		m_displayCallHorse 	= thePlayer.IsActionAllowed(EIAB_CallHorse);
		m_lastUsedPCInput 	= theInput.LastUsedPCInput();
		m_displayDiveDown 	= thePlayer.OnAllowedDiveDown();
		m_displayJump		= thePlayer.IsActionAllowed(EIAB_Jump);
		
		m_CurrentHorseComp = thePlayer.GetUsedHorseComponent();
		m_displayGallop 	= m_CurrentHorseComp.OnCanGallop();
		m_displayCanter 	= m_CurrentHorseComp.OnCanCanter();
		
		
		showCiriMinimap = minimapModule.GetMinimapDuringFocusCombat();
		showCiriObjective = objectiveModule.GetObjectiveDuringFocusCombat();
		
		
		switch(inputContextName)
		{
			case 'JumpClimb' :
				return;
			case 'Exploration' :  					
				if( m_displaySprint )	
				{
					
					if(m_lastUsedPCInput || !thePlayer.GetLeftStickSprint())
						l_ActionsArray.PushBack('Sprint');	
					else
						l_ActionsArray.PushBack('SprintToggle');	
					
				}
				if( m_displayJump )
				{
					l_ActionsArray.PushBack('Jump');
				}
				if( !thePlayer.IsCiri() )
				{
					l_ActionsArray.PushBack('Focus');
					if( m_displayCallHorse )
					{
						l_ActionsArray.PushBack('SpawnHorse');
					}
				}
				break;
			case 'Exploration_Replacer_Ciri' :
				if( m_displaySprint && !theGame.IsFocusModeActive() )	
				{
					
					if(m_lastUsedPCInput || !thePlayer.GetLeftStickSprint())
						l_ActionsArray.PushBack('Sprint');	
					else
						l_ActionsArray.PushBack('SprintToggle');	
					
				}
				if( m_displayJump )
				{
					l_ActionsArray.PushBack('Jump');
				}
				
				if( showCiriMinimap || showCiriObjective )
					l_ActionsArray.PushBack('Focus');
				
				break;
			case 'Horse' : 
			case 'Horse_Replacer_Ciri' : 
				if ( m_displayGallop || thePlayer.IsCiri() )
				{
					l_ActionsArray.PushBack('Gallop');
				}
				if ( m_displayCanter || thePlayer.IsCiri() )
				{
					l_ActionsArray.PushBack('Canter');
				}
				l_ActionsArray.PushBack('HorseDismount');
				break;			
			case 'Boat' : 
				l_ActionsArray.PushBack('GI_Accelerate');
				l_ActionsArray.PushBack('GI_Decelerate');
				l_ActionsArray.PushBack('BoatDismount');
				break;
			case 'BoatPassenger' :
				l_ActionsArray.PushBack('BoatDismount');
				break;
			case 'Swimming' : 
				l_ActionsArray.PushBack('DiveDown');
				if( m_displaySprint )
				{
					
					if(m_lastUsedPCInput || !thePlayer.GetLeftStickSprint())
						l_ActionsArray.PushBack('Sprint');	
					else
						l_ActionsArray.PushBack('SprintToggle');	
					
				}
				l_swimingSprint = true;
				break;		
			case 'Diving' :
				if ( m_displayDiveDown )
				{
					l_ActionsArray.PushBack('DiveDown');
				}
				l_ActionsArray.PushBack('DiveUp');
				if( m_displaySprint )
				{
					
					if(m_lastUsedPCInput || !thePlayer.GetLeftStickSprint())
						l_ActionsArray.PushBack('Sprint');	
					else
						l_ActionsArray.PushBack('SprintToggle');	
					
				}
				l_swimingSprint = true;
				break;
			case 'FistFight' : 
			case 'CombatFists' : 
			case 'Combat' : 
			if( thePlayer.IsInCombatFist() )
				{
					l_ActionsArray.PushBack('AttackLight');
					l_ActionsArray.PushBack('AttackHeavy');
					l_ActionsArray.PushBack('LockAndGuard'); 
					l_ActionsArray.PushBack('Dodge');
				}
				else
				{
					l_ActionsArray.PushBack('AttackLight');
					l_ActionsArray.PushBack('AttackHeavy');
					l_ActionsArray.PushBack('Dodge');
					l_ActionsArray.PushBack('CastSign');
				}
				break;
			case 'Combat_Replacer_Ciri' :
				l_ActionsArray.PushBack('AttackLight');
				l_ActionsArray.PushBack('CiriDodge');
				if ( thePlayer.HasAbility('CiriCharge') )
					l_ActionsArray.PushBack('CiriSpecialAttackHeavy'); 
				if ( thePlayer.HasAbility('CiriBlink') )
					l_ActionsArray.PushBack('CiriSpecialAttack'); 
				break;
			default:
				break;
		}
		
		
		if(m_altSignCasting)
		{				
			l_ActionsArray.Clear();
			l_ActionsArray.PushBack('CbtRoll');
			l_ActionsArray.PushBack('AttackLight');
			l_ActionsArray.PushBack('Dodge');
			l_ActionsArray.PushBack('AttackHeavy');
			l_ActionsArray.PushBack('LockAndGuard');
		}			
		
		
		for( i = 0; i < l_ActionsArray.Size(); i += 1 )
		{
			curAction = l_ActionsArray[i];
			outKeys.Clear();
			outKeysPC.Clear();
			theInput.GetPadKeysForAction(curAction, outKeys );
			
			
			
			if (m_lastUsedPCInput)
			{
				modifier = IK_None;
				
				attackModKeysPC.Clear();
				theInput.GetPCKeysForAction('PCAlternate', attackModKeysPC );
				
				switch (curAction)
				{
					
					
					
					
					
					case 'AttackLight' :
							
							attackKeysPC.Clear();
							theInput.GetPCKeysForAction('AttackWithAlternateLight', attackKeysPC );
							
							if (attackKeysPC.Size() > 0 && attackKeysPC[0] != IK_None)
							{
								outKeysPC.PushBack(attackKeysPC[0]);
							}
							else								
							{
								alterAttackKeysPC.Clear();
								theInput.GetPCKeysForAction('AttackWithAlternateHeavy', alterAttackKeysPC );
								
								if (attackModKeysPC.Size() > 0 && alterAttackKeysPC.Size() > 0 && attackModKeysPC[0] != IK_None && alterAttackKeysPC[0] != IK_None)
								{
									outKeysPC.PushBack(alterAttackKeysPC[0]);
									modifier = attackModKeysPC[0];
								}
							}
							
						break;
						
					case 'AttackHeavy' :
					case 'CiriSpecialAttackHeavy' :
							
							
							
							attackKeysPC.Clear();
							theInput.GetPCKeysForAction('AttackWithAlternateHeavy', attackKeysPC );
							
							if (attackKeysPC.Size() > 0 && attackKeysPC[0] != IK_None)
							{
								outKeysPC.PushBack(attackKeysPC[0]);
							}
							else								
							{
								alterAttackKeysPC.Clear();
								theInput.GetPCKeysForAction('AttackWithAlternateLight', alterAttackKeysPC );
								
								if (attackModKeysPC.Size() > 0 && alterAttackKeysPC.Size() > 0 && attackModKeysPC[0] != IK_None && alterAttackKeysPC[0] != IK_None)
								{
									outKeysPC.PushBack(alterAttackKeysPC[0]);
									modifier = attackModKeysPC[0];
								}
							}
							
						break;
					default:
						theInput.GetPCKeysForAction(curAction, outKeysPC );
						break;
				}
			}
			
			
			
			switch (curAction) 
			{
				case 'Sprint' :
					
					
					
					
					
					break;
				case 'HorseDismount':
					outKeys.PushBack(IK_Pad_B_CIRCLE);
					break;
					
				default:
					break;
			}
			
			
			if(m_altSignCasting)
			{
				if( curAction == 'CbtRoll')
				{					
					
					outKeys.PushBack(IK_Pad_A_CROSS);
				}
				else if ( curAction == 'AttackLight') 
				{
					outKeys.PushBack(IK_Pad_X_SQUARE);
				}
				else if ( curAction == 'Dodge') 
				{
					outKeys.PushBack(IK_Pad_B_CIRCLE);
				}
				else if ( curAction == 'AttackHeavy') 
				{
					outKeys.PushBack(IK_Pad_Y_TRIANGLE);
				}
				else if ( curAction == 'LockAndGuard') 
				{
					outKeys.PushBack(IK_Pad_RightTrigger);
				}
			}
			
			
			l_DataFlashObject = m_flashValueStorage.CreateTempFlashObject();
			bindingGFxData = l_DataFlashObject.CreateFlashObject("red.game.witcher3.data.KeyBindingData");
			bindingGFxData.SetMemberFlashInt("gamepad_keyCode", outKeys[0] );
			
			if (outKeysPC.Size() > 0)
			{
				bindingGFxData.SetMemberFlashInt("keyboard_keyCode", outKeysPC[0] );
			}
			else
			{
				bindingGFxData.SetMemberFlashInt("keyboard_keyCode", 0 );
			}
			if (modifier != IK_None)
			{
				bindingGFxData.SetMemberFlashInt("altKeyCode", modifier );
			}
			
			if( (curAction == 'Sprint' || curAction == 'SprintToggle') && ( m_currentInputContext != 'Swimming' && m_currentInputContext != 'Diving') )	
			{
				if( m_movementLockType != PMLT_Free )
				{
					curAction = 'Run';
				}
			}
			
			switch (curAction)
			{
				case 'Gallop':
					labelPrefix = "<font color=\"#FCAD36\">" + bracketOpeningSymbol + GetLocStringByKeyExt("ControlLayout_doubleTap") + bracketClosingSymbol + "</font>";
					break;
				case 'SpawnHorse':
					if ( !m_lastUsedPCInput )
						labelPrefix = "<font color=\"#FCAD36\">" + bracketOpeningSymbol + GetLocStringByKeyExt("ControlLayout_doubleTap") + bracketClosingSymbol + "</font>";
					else
						labelPrefix = "";
					break;
				case 'Sprint':
					if ( !theInput.IsToggleSprintBound() )
						labelPrefix = "<font color=\"#FCAD36\">" + bracketOpeningSymbol + GetLocStringByKeyExt("ControlLayout_hold") + bracketClosingSymbol + "</font>";						
					break;
				case 'SprintToggle':
					if ( !theInput.IsToggleSprintBound() )
						labelPrefix = "<font color=\"#FCAD36\">" + bracketOpeningSymbol + StrReplace(GetLocStringByKeyExt("ControlLayout_press")," -","") + bracketClosingSymbol + "</font>";						
					break;
				case 'HorseDismount':
					if ( m_lastUsedPCInput )
					{
						if (ACS_Is_DLC_Installed('dlc_spectre'))
						{
							labelPrefix = "<font color=\"#FCAD36\">" + bracketOpeningSymbol + GetLocStringByKeyExt("ControlLayout_doubleTap") + bracketClosingSymbol + "</font>";
						}
						else
						{
							labelPrefix = "";
						}
					}
					else
					{
						labelPrefix = "<font color=\"#FCAD36\">" + bracketOpeningSymbol + GetLocStringByKeyExt("ControlLayout_hold") + bracketClosingSymbol + "</font>";
					}
					break;
				case 'Run':
					
					if(m_lastUsedPCInput || !thePlayer.GetLeftStickSprint())
						labelPrefix = "<font color=\"#FCAD36\">" + bracketOpeningSymbol + GetLocStringByKeyExt("ControlLayout_hold") + bracketClosingSymbol + "</font>";
					else
						labelPrefix = "<font color=\"#FCAD36\">" + bracketOpeningSymbol + StrReplace(GetLocStringByKeyExt("ControlLayout_press")," -","") + bracketClosingSymbol + "</font>";
					
					break;
				case 'GI_Accelerate':
				case 'GI_Decelerate':
				case 'Canter':
					labelPrefix = "<font color=\"#FCAD36\">" + bracketOpeningSymbol + StrReplace(GetLocStringByKeyExt("ControlLayout_press")," -","") + bracketClosingSymbol + "</font>";	
				break;
				case 'Focus':
					if (!theGame.IsFocusModeActive())
					{
						labelPrefix = "<font color=\"#FCAD36\">" + bracketOpeningSymbol + GetLocStringByKeyExt("ControlLayout_hold") + bracketClosingSymbol + "</font>";
					}
					else
					{
						labelPrefix = "<font color=\"#FCAD36\">" + bracketOpeningSymbol + GetLocStringById(1059123) + bracketClosingSymbol + "</font>";
					}
					break;
				case 'Roll':
				case 'DiveUp':
				case 'DiveDown':
				case 'CiriSpecialAttackHeavy':
				case 'CiriSpecialAttack':
					labelPrefix = "<font color=\"#FCAD36\">" + bracketOpeningSymbol + GetLocStringByKeyExt("ControlLayout_hold") + bracketClosingSymbol + "</font>";
					break;
				default:
					labelPrefix = "";
					break;
			}
			
			if( curAction == 'Jump' )
			{
				actionLabel = GetLocStringByKeyExt("panel_button_common_jump");
			}
			else if( (curAction == 'Sprint' || curAction == 'SprintToggle') && ( m_currentInputContext == 'Swimming' || m_currentInputContext == 'Diving') )	
			{
				actionLabel = GetLocStringByKeyExt("panel_input_action_fast_swiming");
			}
			else if( curAction == 'SpawnHorse' )
			{
				if( (thePlayer.GetHorseWithInventory())
				&& (thePlayer.GetHorseWithInventory()).IsAlive()
				&& !thePlayer.IsSailing() 
				&& !thePlayer.IsUsingHorse() 
				&& !thePlayer.IsUsingVehicle() 
				)
				{
					if ( thePlayer.GetHorseWithInventory().HasTag('ACS_Roach_Is_Following') )
					{
						actionLabel = GetLocStringById(2116581009);
					}
					else
					{
						if( 
						VecDistanceSquared( thePlayer.GetWorldPosition(), (thePlayer.GetHorseWithInventory()).GetWorldPosition() ) <= 4 * 4 
						&& ((theInput.IsActionPressed('Sprint') || thePlayer.GetIsSprinting())
						&& (theInput.GetActionValue('GI_AxisLeftX') != 0 || theInput.GetActionValue('GI_AxisLeftY') != 0) )
						)
						{
							actionLabel = GetLocStringById(182503);
						}
						else
						{
							if( VecDistanceSquared( thePlayer.GetWorldPosition(), (thePlayer.GetHorseWithInventory()).GetWorldPosition() ) <= 2 * 2
							)
							{
								actionLabel = GetLocStringById(2116581006);
							}
							else if( VecDistanceSquared( thePlayer.GetWorldPosition(), (thePlayer.GetHorseWithInventory()).GetWorldPosition() ) > 2 * 2
							&& VecDistanceSquared( thePlayer.GetWorldPosition(), (thePlayer.GetHorseWithInventory()).GetWorldPosition() ) <= 3 * 3
							)
							{
								actionLabel = GetLocStringById(2116581008);
							}
							else
							{
								actionLabel = GetLocStringByKeyExt("ControlLayout_SummonHorse");
							}
						}
					}
				}
				else
				{
					actionLabel = GetLocStringByKeyExt("ControlLayout_SummonHorse");
				}
										
			}
			else if (curAction == 'BoatDismount' && inputContextName == 'Boat')
			{
				actionLabel = GetLocStringByKeyExt("panel_button_common_disembark");
			}
			else if ( curAction == 'CiriDodge' )
			{
				actionLabel = GetLocStringByKeyExt("ControlLayout_Dodge");
			}
			else if ( curAction == 'CiriSpecialAttackHeavy' )
			{
				actionLabel = GetLocStringByKeyExt("ControlLayout_CiriCharge");
			}
			else if ( curAction == 'CiriSpecialAttack' )
			{
				actionLabel = GetLocStringByKeyExt("ControlLayout_CiriBlink");
			}
			
			else if ( curAction == 'SprintToggle' )
			{
				actionLabel = GetLocStringByKeyExt("panel_input_action_sprint");
			}
			
			else if ( curAction == 'Focus' && thePlayer.IsCiri() )
			{
				if(showCiriMinimap && showCiriObjective)
					actionLabel = GetLocStringByKeyExt("option_Minimap") + "/" + GetLocStringByKeyExt("panel_journal_quest_objectives");
				else if (showCiriMinimap)
					actionLabel = GetLocStringByKeyExt("option_Minimap");
				else if (showCiriObjective)
					actionLabel = GetLocStringByKeyExt("panel_journal_quest_objectives");
			}
			else
			{					
				actionLabel = GetLocStringByKeyExt("panel_input_action_"+StrLower(curAction));
			}
			
			if(m_altSignCasting)
			{
				if( curAction == 'CbtRoll')				
				{		
					actionLabel = GetLocStringById(1061945);
					
				}
				else if ( curAction == 'AttackLight')	
				{
					actionLabel = GetLocStringById(1066290);
					
				}
				else if ( curAction == 'Dodge') 		
				{
					actionLabel = GetLocStringById(1066292);
					
				}
				else if ( curAction == 'AttackHeavy') 	
				{
					actionLabel = GetLocStringById(1066293);
					
				}
				else if ( curAction == 'LockAndGuard')	
				{
					actionLabel = GetLocStringById(1066291);
					
				}
			}
			
			
			if(theGame.IsLanguageArabic())
				bindingGFxData.SetMemberFlashString("label", labelPrefix + " <font color=\"#FFFFFF\">" + actionLabel + "</font>" );
			else
				bindingGFxData.SetMemberFlashString("label", " <font color=\"#FFFFFF\">" + actionLabel + "</font> " + labelPrefix );
			
			l_FlashArray.PushBackFlashObject(bindingGFxData);
		}
	}
	
	
	
	if( l_ActionsArray.Size() > 0 )
	{
		m_flashValueStorage.SetFlashArray( KEY_CONTROLS_FEEDBACK_LIST, l_FlashArray );
		
	}
	m_previousInputContext = m_currentInputContext;
}

@wrapMethod(W3ArrowProjectile) function OnProjectileCollision( pos, normal : Vector, collidingComponent : CComponent, hitCollisionsGroups : array< name >, actorIndex : int, shapeIndex : int )
{
	var actorVictim	: CActor;
	var casterPos 	: Vector;
	var parryInfo 	: SParryInfo;
	var arrowHitPos : Vector;
	var bounce		: bool;
	var abs 		: array<name>;
	var isRolling	: bool;
	var template 	: CEntityTemplate;
	var meshComponent 	: CMeshComponent;
	var boundingBox 	: Box;
	var arrowSize 		: Vector;
	var hitPos 			: Vector;
	var parry_fx_temp	: CEntityTemplate;
	var parry_fx		: CEntity;
	
	if(collidingComponent)
		victim = (CGameplayEntity)collidingComponent.GetEntity();
	
	//super.OnProjectileCollision(pos, normal, collidingComponent, hitCollisionsGroups, actorIndex, shapeIndex);

	if (victim == thePlayer)
	{
		super.OnProjectileCollision(pos, normal, collidingComponent, hitCollisionsGroups, actorIndex, shapeIndex);

		if ( (thePlayer.HasTag('ACS_Player_Is_Attacking') 
		|| thePlayer.HasTag('ACS_Player_Is_Attacking_Bounce_Arrow') 
		|| thePlayer.IsDoingSpecialAttack(false)
		|| (GetWitcherPlayer().IsCastingSign() && !GetWitcherPlayer().IsCurrentSignChanneled()))
		&& ACS_Settings_Main_Bool('acs_parry_skills_settings','acs_active_counter_system_enabled', true)
		)
		{
			ACS_Tutorial_Display_Check('ACS_Active_Counter_Tutorial_Shown');

			thePlayer.SoundEvent("cmb_play_parry");

			if(ACS_Settings_Main_Bool('acs_parry_skills_settings','acs_active_counter_system_slow_motion_enabled', false))
			{
				GetACSWatcher().ACS_SlowMoAdjustable(0.3,0.3);
			}

			GCameraShake( ACS_Settings_Main_Float('acs_hud_camera_settings_main','acs_attack_countered_camera_shake_strength', 0.5), true, thePlayer.GetWorldPosition(), 30 );

			parry_fx_temp = (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\fx\acs_sword_trail.w2ent" , true );

			parry_fx = (CEntity)theGame.CreateEntity( parry_fx_temp, GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetWorldForward() + Vector( 0, 0, 1 ) );

			parry_fx.PlayEffectSingle('light_block');
			parry_fx.PlayEffectSingle('heavy_block');
			parry_fx.PlayEffectSingle('counterattack');
			parry_fx.PlayEffectSingle('parry_fx');
			parry_fx.PlayEffectSingle('parry_fx_secondary');

			parry_fx.DestroyAfter(3);

			this.PlayEffect('sparks');

			//ActivateTrail('arrow_trail_red');

			theSound.SoundEvent("wall_a1_bb_acs");

			isBouncedArrow = true;

			casterPos = caster.GetWorldPosition();

			casterPos.Z += 1.5;

			this.Init(thePlayer);

			this.ShootProjectileAtPosition(RandRangeF(45,15),projSpeed*0.7,casterPos);

			//thePlayer.RemoveTag('ACS_Player_Is_Attacking');

			//thePlayer.RemoveTag('ACS_Player_Is_Attacking_Bounce_Arrow');

			return true;
		}
	}

	wrappedMethod(pos, normal, collidingComponent, hitCollisionsGroups, actorIndex, shapeIndex);
}

@addMethod(CR4OverlayPopup) function ACS_ShowLogo(show: bool, fadeInterval: float, x: int, y: int) 
{
	var path: string;

	if (show) 
	{
		path = "img://logos/eh_logo.png";
	}

	this.m_fxShowEP2Logo.InvokeSelfFiveArgs(FlashArgBool(show), FlashArgNumber(fadeInterval), FlashArgInt(x), FlashArgInt(y), FlashArgString(path));
}


function ACS_ShowLogo(show: bool, fadeInterval: float, x: int, y: int) 
{
	var overlayPopupRef: CR4OverlayPopup;

	overlayPopupRef = (CR4OverlayPopup)(theGame.GetGuiManager().GetPopup('OverlayPopup'));

	if (overlayPopupRef) 
	{
		overlayPopupRef.ACS_ShowLogo(show, fadeInterval, x, y);
	}
}

@wrapMethod( CPlayer ) function SprintingTimer(dt : float, id : int)
{
	if (false)
	{
		wrappedMethod(dt, id);
	}

	if ( !thePlayer.modifyPlayerSpeed )
	{
		sprintingTime	+= dt;
		
		
		if ( ShouldDrainStaminaWhileSprinting() )
		{
			DrainStamina(ESAT_Sprint, 0, 1, '', dt);
		}
	}
}

@wrapMethod( CR4Player ) function ShouldDrainStaminaWhileSprinting() : bool
{
	if(thePlayer.HasTag('ACS_Air_Time')
	|| thePlayer.HasTag('ACS_Feainnewedd_Dance')
	|| thePlayer.IsUsingHorse()
	|| thePlayer.IsUsingVehicle()
	)
	{
		return false;
	}

	if ((thePlayer.IsInCombat() 
	|| thePlayer.IsThreatened())
	&& thePlayer.IsAlive()
	)
	{
		return true;
	}
	
	return wrappedMethod();
}

@wrapMethod( CR4HudModuleDialog ) function OnDialogChoicesSet( choices : array< SSceneChoice >, alternativeUI : bool )
{
	var i : int;
	
	if( 
	FactsQuerySum("q001_nightmare_ended") <= 0
	&& FactsQuerySum("q001_unlocked_door") > 0
	)
	{
		for ( i = 0; i < choices.Size(); i += 1 )
		{
			if ( choices[ i ].description == GetLocStringById(1058683) 
			)
			{
				if(!ACS_Settings_Main_Bool('acs_misc_main_settings','acs_prologue_vanilla_tut_dialog_option_enabled', false))
				{
					choices[ i ].disabled = true;

					if (ACS_Is_DLC_Installed('dlcvhud'))
					{
						choices[ i ].description = "";
					}
					else
					{
						choices[ i ].description = GetLocStringById(2118449689);
					}
				}
				else
				{
					choices[ i ].description = "<FONT COLOR='#CC0000'>" + GetLocStringById(2118449690) + "</FONT>";
				}
			}

			if ( choices[ i ].description == GetLocStringById(1058679) 
			&& !ACS_Settings_Main_Bool('acs_misc_main_settings','acs_prologue_vanilla_tut_dialog_option_enabled', false)
			)
			{
				choices[ i ].disabled = true;

				if (ACS_Is_DLC_Installed('dlcvhud'))
				{
					choices[ i ].description = "";
				}
				else
				{
					choices[ i ].description = GetLocStringById(2118449689);
				}
			}
		}
	}

	wrappedMethod(choices, alternativeUI);
}


@addField(W3Boat)
var acs_boat_lampStern	: CEntity;

@addField(W3Boat)
var acs_boat_lampBow		: CEntity;

@addField(W3Boat)
var acs_boat_lamp_anchor		: CEntity;


@wrapMethod( W3Boat ) function OnAreaEnter( area : CTriggerAreaComponent, activator : CComponent )
{
	var player : CR4Player;

	wrappedMethod(area, activator);

	player = (CR4Player)activator.GetEntity();

	if( player )	
	{
		if ( FactsQuerySum("ACS_Lantern_Stowed_On_Boat") > 0 
		)
		{
			ACS_AttachBoatLantern();
		}
	}
}

@addMethod( W3Boat ) function ACS_AttachBoatLantern()
{
	var gameplayLightComp, pointLightComp : CComponent;

	if (!acs_boat_lamp_anchor)
	{
		acs_boat_lamp_anchor = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource("dlc\dlc_acs\data\entities\other\fx_ent.w2ent", true), this.GetWorldPosition(), this.GetWorldRotation() );
		
		acs_boat_lamp_anchor.AddTag('ACS_Boat_Oil_Lamp_Anchor');

		acs_boat_lamp_anchor.CreateAttachment(this);
	}

	if (!acs_boat_lampBow)
	{
		acs_boat_lampBow = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource(
		
		"dlc\dlc_acs\data\entities\other\boat_lantern.w2ent"
		
		, true), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );

		acs_boat_lampBow.AddTag('ACS_Boat_Oil_Lamp_Bow');
		
		acs_boat_lampBow.CreateAttachment(acs_boat_lamp_anchor, , Vector( 0, 3.85, 1.45 ), EulerAngles(0,90,0));

		gameplayLightComp = acs_boat_lampBow.GetComponentByClassName('CGameplayLightComponent');

		pointLightComp = acs_boat_lampBow.GetComponentByClassName('CPointLightComponent');

		if(gameplayLightComp)
		{
			((CGameplayLightComponent)gameplayLightComp).SetInteractive(true);
			
			((CGameplayLightComponent)gameplayLightComp).SetFadeLight(false);

			//((CGameplayLightComponent)gameplayLightComp).SetFadeLight(true);
		}

		if (pointLightComp)
		{
			//acs_boat_lampBow.PlayEffectSingle('fire');

			((CPointLightComponent)pointLightComp).SetEnabled(false);

			//((CPointLightComponent)pointLightComp).SetEnabled(true);
		}
	}

	if (!acs_boat_lampStern)
	{
		acs_boat_lampStern = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource(
			
		"dlc\dlc_acs\data\entities\other\boat_lantern.w2ent"
		
		, true), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation() );

		acs_boat_lampStern.AddTag('ACS_Boat_Oil_Lamp_Stern');

		acs_boat_lampStern.CreateAttachment(acs_boat_lamp_anchor, , Vector( 0, 0.55, 1.85 ), EulerAngles(0,90,0));

		gameplayLightComp = acs_boat_lampStern.GetComponentByClassName('CGameplayLightComponent');

		pointLightComp = acs_boat_lampStern.GetComponentByClassName('CPointLightComponent');

		if(gameplayLightComp)
		{
			((CGameplayLightComponent)gameplayLightComp).SetInteractive(true);

			((CGameplayLightComponent)gameplayLightComp).SetFadeLight(false);

			//((CGameplayLightComponent)gameplayLightComp).SetFadeLight(true);
		}

		if (pointLightComp)
		{
			//acs_boat_lampStern.PlayEffectSingle('fire');
			
			((CPointLightComponent)pointLightComp).SetEnabled(false);

			//((CPointLightComponent)pointLightComp).SetEnabled(true);
		}
	}

	RemoveTimer('ACS_Boat_Lantern_Ignite');
	AddTimer('ACS_Boat_Lantern_Ignite', 1 , true);
}

@addMethod( W3Boat ) timer function ACS_Boat_Lantern_Ignite( dt : float, id : int )
{
	var gameplayLightComp, pointLightComp : CComponent;

	if (GetACSWatcher().ACS_IsInDarkPlace() || FactsQuerySum("ACS_Darkness_Upon_Us") > 0)
	{
		if (acs_boat_lampBow)
		{
			gameplayLightComp = acs_boat_lampBow.GetComponentByClassName('CGameplayLightComponent');

			pointLightComp = acs_boat_lampBow.GetComponentByClassName('CPointLightComponent');

			if(gameplayLightComp)
			{
				if (!((CGameplayLightComponent)gameplayLightComp).IsLightOn())
				{
					((CGameplayLightComponent)gameplayLightComp).SetFadeLight(true);
				}
			}

			if (pointLightComp)
			{
				acs_boat_lampBow.PlayEffectSingle('fire');

				((CPointLightComponent)pointLightComp).SetEnabled(true);
			}
		}

		if (acs_boat_lampStern)
		{
			gameplayLightComp = acs_boat_lampStern.GetComponentByClassName('CGameplayLightComponent');

			pointLightComp = acs_boat_lampStern.GetComponentByClassName('CPointLightComponent');

			if(gameplayLightComp)
			{
				if (!((CGameplayLightComponent)gameplayLightComp).IsLightOn())
				{
					((CGameplayLightComponent)gameplayLightComp).SetFadeLight(true);
				}
			}

			if (pointLightComp)
			{
				acs_boat_lampStern.PlayEffectSingle('fire');

				((CPointLightComponent)pointLightComp).SetEnabled(true);
			}
		}
	}
}

@wrapMethod( CMajorPlaceOfPowerEntity ) function OnInteraction( actionName : string, activator : CEntity )
{
	var playerPos : Vector;
	var ent	: CACSMonsterSpawner;
	var fx_ent : CEntity;
	var spawn_witch : bool;

	if(false)
	{
		wrappedMethod(actionName, activator);
	}

	if( activator != thePlayer || !thePlayer.CanPerformPlayerAction())
		return false;
	
	GetACSWatcher().RemoveTimer('PrayDelay');

	GetACSWatcher().AddTimer('PrayDelay', 0.5 , false );

	((CMajorPlaceOfPowerEntityStatePlaceOfPower_Activated)GetState('PlaceOfPower_Activated')).OnEnterState('PlaceOfPower_Channeling');
	
	if (theGame.GetWorld().GetDepotPath() == "levels\novigrad\novigrad.w2w")
	{
		playerPos = thePlayer.GetWorldPosition();

		if (playerPos.Y < 1350 )
		{
			fx_ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

			"dlc\dlc_acs\data\fx\witch_of_the_wood\witch_of_the_wood_slashes.w2ent"

			, true ), this.GetWorldPosition() );

			fx_ent.PlayEffectSingle('spawn_disappear_acs');

			fx_ent.PlayEffectSingle('death_dissapear_acs');

			spawn_witch = false;

			if ( FactsQuerySum("ACS_Lady_Of_The_Wood_First_Place_Of_Power_Warning") <= 0 
			&& FactsQuerySum("ACS_Lady_Of_The_Wood_Second_Place_Of_Power_Warning") <= 0
			)
			{
				fx_ent.PlayEffectSingle('down');

				fx_ent.PlayEffectSingle('up');

				fx_ent.PlayEffectSingle('right');

				fx_ent.PlayEffectSingle('left');

				GetWitcherPlayer().DisplayHudMessage( GetLocStringById(2116581303) );

				if (RandF() < 0.033)
				{
					spawn_witch = true;
				}
				else
				{
					FactsAdd("ACS_Lady_Of_The_Wood_First_Place_Of_Power_Warning", 1, -1);
				}
			}
			else if ( 
			FactsQuerySum("ACS_Lady_Of_The_Wood_First_Place_Of_Power_Warning") > 0
			&& FactsQuerySum("ACS_Lady_Of_The_Wood_Second_Place_Of_Power_Warning") <= 0 )
			{
				fx_ent.PlayEffectSingle('diagonal_up_left');

				fx_ent.PlayEffectSingle('diagonal_down_left');

				fx_ent.PlayEffectSingle('diagonal_up_right');

				fx_ent.PlayEffectSingle('diagonal_down_right');

				GetWitcherPlayer().DisplayHudMessage( GetLocStringById(2116581304) );

				if (RandF() < 0.33)
				{
					spawn_witch = true;
				}
				else
				{
					FactsAdd("ACS_Lady_Of_The_Wood_Second_Place_Of_Power_Warning", 1, -1);
				}
			}
			else if ( 
			FactsQuerySum("ACS_Lady_Of_The_Wood_First_Place_Of_Power_Warning") > 0
			&& FactsQuerySum("ACS_Lady_Of_The_Wood_Second_Place_Of_Power_Warning") > 0 )
			{
				fx_ent.PlayEffectSingle('down');

				fx_ent.PlayEffectSingle('up');

				fx_ent.PlayEffectSingle('right');

				fx_ent.PlayEffectSingle('left');

				fx_ent.PlayEffectSingle('diagonal_up_left');

				fx_ent.PlayEffectSingle('diagonal_down_left');

				fx_ent.PlayEffectSingle('diagonal_up_right');

				fx_ent.PlayEffectSingle('diagonal_down_right');

				GetWitcherPlayer().DisplayHudMessage( GetLocStringById(2116581305) );

				spawn_witch = true;
			}

			if (spawn_witch)
			{
				ent = (CACSMonsterSpawner)theGame.CreateEntity( 

				(CEntityTemplate)LoadResource( "dlc\dlc_acs\data\entities\other\acs_monster_spawner.w2ent", true ), 

				this.GetWorldPosition() + Vector(RandRangeF(7, -7), RandRangeF(7, -7), 0), thePlayer.GetWorldRotation() );

				ent.AddTag('ACS_MonsterSpawner_WitchOfTheWood');

				ent.AddTag('ACS_MonsterSpawner_Spawn_In_Frame');

				ent.AddTag('ACS_MonsterSpawner_Spawn_In_Combat');

				FactsRemove("ACS_Lady_Of_The_Wood_Second_Place_Of_Power_Warning");
				FactsRemove("ACS_Lady_Of_The_Wood_First_Place_Of_Power_Warning");
			}
		}
	}

	GotoState( 'PlaceOfPower_Recharging' );
}

@addMethod( CActor ) function ACS_IsImmuneToNegativeBuffs(): bool
{
	return isImmuneToNegativeBuffs;
}

@wrapMethod( DismountHorse ) function OnEnterState( prevStateName : name )
{
	wrappedMethod(prevStateName);

	GetACSWatcher().ResetHorseMotionLeaningExternal();

	if (thePlayer.HasTag('ACS_IsSwordWalking'))
	{
		thePlayer.RaiseEvent('ACS_SwordWalkAdditiveEnd');thePlayer.RaiseEvent('ACS_CombatTauntEnd');GetACSWatcher().RemoveTimer('CombatTauntDelay');thePlayer.RaiseEvent('ACS_SwordTauntEnd');

		thePlayer.RemoveTag('ACS_IsSwordWalking');
	}

	if (thePlayer.IsAnyWeaponHeld()
	&& !thePlayer.IsWeaponHeld('fist')
	)
	{
		GetACSWatcher().RemoveTimer('CombatTauntDelay');
		GetACSWatcher().RemoveTimer('SwordTauntRunningSwitchSecondary'); 
		GetACSWatcher().RemoveTimer('SwordTauntRunningSwitchSecondaryWeaponBlood'); 
		GetACSWatcher().AddTimer('SwordTauntRunningSwitchSecondary', 0.01 , false); 
	}
}


state ACS_DismountHorse in CR4Player extends DismountTheVehicle
{
	public var horseComp : W3HorseComponent;

	event OnEnterState( prevStateName : name )
	{
		super.OnEnterState( prevStateName );
		
		horseComp = (W3HorseComponent)vehicle;
		
		//parent.AddAnimEventCallback( 'SlideBack', 'OnAnimEvent_SlideBack' );

		GetACSWatcher().ResetHorseMotionLeaningExternal();
		
		this.ACS_ProcessDismountHorse();
	}
	
	cleanup function DismountCleanup() 
	{
		super.DismountCleanup();
		
		parent.SignalGameplayEventParamInt( 'RidingManagerDismountHorse', DT_instant | DT_fromScript );
	}

	entry function ACS_ProcessDismountHorse()
	{
		var riderData : CAIStorageRiderData;
		var weaponType	: EPlayerWeapon;
		var target : CActor;
		var position : Vector;
		var movementAdjustor : CMovementAdjustor;
		var ticket : SMovementAdjustmentRequestTicket;
		var mounted_attack_dismount_process : bool;
		
		riderData = thePlayer.GetRiderData();
		parent.SetCleanupFunction( 'DismountCleanup' );
		
		parent.SignalGameplayEventParamInt( 'RidingManagerDismountHorse', 0 );

		if(thePlayer.HasTag('ACS_MountedAttackDismountProcessStart'))
		{
			GetACSWatcher().dodge_timer_actual();

			thePlayer.TeleportWithRotation(thePlayer.GetWorldPosition() + Vector(0,0,2), thePlayer.GetWorldRotation());

			GetACSWatcher().dodge_timer_actual();

			movementAdjustor = thePlayer.GetMovingAgentComponent().GetMovementAdjustor();
			movementAdjustor.CancelAll();

			ticket = movementAdjustor.CreateNewRequest( 'ACS_Manual_Combat_Control_Rotate' );
						
			movementAdjustor.AdjustmentDuration( ticket, 0.5 );

			movementAdjustor.MaxRotationAdjustmentSpeed( ticket, 5000000 );
			movementAdjustor.MaxLocationAdjustmentSpeed( ticket, 5000000 );

			movementAdjustor.AdjustLocationVertically( ticket, true );

			movementAdjustor.ScaleAnimationLocationVertically( ticket, true );

			movementAdjustor.SlideTo(ticket, thePlayer.GetWorldPosition() + thePlayer.GetWorldForward() * -5);

			if (thePlayer.GetTarget())
			{
				movementAdjustor.RotateTowards( ticket, thePlayer.GetTarget() );
			}
		}
		
		parent.AddTimer( 'CheckSwimmingOnDismount', 0.f, true );
		
		SleepOneFrame();
		
		parent.OnRangedForceHolster( true, true );

		theInput.SetContext( thePlayer.GetExplorationInputContext() );

		while( true )
		{
			if (thePlayer.GetPlayerCombatStance() != PCS_AlertNear)
			{
				thePlayer.SetPlayerCombatStance(PCS_AlertNear, true);
				thePlayer.SetPlayerCombatStance(PCS_AlertNear, true);
				thePlayer.SetPlayerCombatStance(PCS_AlertNear, true);
			}

			if ( riderData.GetRidingManagerCurrentTask() == RMT_None && riderData.sharedParams.mountStatus == VMS_dismounted )
			{
				break;
			}

			if ( riderData.ridingManagerMountError == true )
			{
				if ( !theGame.IsDialogOrCutscenePlaying() )
				{
					parent.GotoState('Combat');
				}
				else
				{
					parent.PopState();
				}

				break;
			}

			SleepOneFrame();
		}
		
		parent.ClearCleanupFunction();

		parent.PopState();

		if (thePlayer.GetPlayerCombatStance() != PCS_AlertNear)
		{
			thePlayer.SetPlayerCombatStance(PCS_AlertNear, true);
			thePlayer.SetPlayerCombatStance(PCS_AlertNear, true);
			thePlayer.SetPlayerCombatStance(PCS_AlertNear, true);
		}
	}
}

@wrapMethod(CInventoryComponent) function OnItemAdded(data : SItemChangedData)
{
	var ent	: CGameplayEntity;
	var witcher : W3PlayerWitcher;

	ent = (CGameplayEntity)GetEntity();

	witcher = GetWitcherPlayer();

	if(ent == witcher
	&& ACS_Settings_Main_Bool('acs_item_management_settings','acs_auto_read_enabled', false)
	&& !theGame.IsDialogOrCutscenePlaying() 
	&& thePlayer.IsAlive()
	&& !thePlayer.IsInCutsceneIntro()
	&& !theGame.HasBlackscreenRequested()
	&& !theGame.IsCurrentlyPlayingNonGameplayScene()
	&& !theGame.GetGuiManager().IsAnyMenu()
	&& !theGame.GetTutorialSystem().HasActiveTutorial()
	&& !theGame.GetPhotomodeEnabled() 
	&& !theGame.IsFading()
	&& !theGame.IsBlackscreen()
	)
	{
		GetACSStorage().GetBookItemsToBeRead(data.ids[0]);

		GetACSStorage().RemoveTimer('AutoReadDelay');

		GetACSStorage().AddTimer('AutoReadDelay', 0.125f , false );
	}

	wrappedMethod( data );
}

@wrapMethod(CExplorationStateStartFalling) function StateCanEnter( curStateName : name ) : bool
{
	if (FactsQuerySum("ACS_Has_Double_Jumped") > 0 
	|| FactsQuerySum("ACS_Has_Air_Dashed") > 0 
	|| FactsQuerySum("ACS_Is_Gliding") > 0 
	|| FactsQuerySum("acs_transformation_activated") > 0 
	|| GetWitcherPlayer().HasTag('ACS_Feainnewedd_Dance')
	|| GetWitcherPlayer().HasTag('acs_in_wraith') 
	|| GetWitcherPlayer().HasTag('ACS_Air_Time')
	|| ACSGetCEntity('ACS_Bruxa_Bite_Finisher_Vampire_Head')
	)
	{
		m_ExplorationO.m_OwnerE.SetBehaviorVariable( 'FallType', ( float ) ( int ) FT_Sprint );

		return false;
	}

	return wrappedMethod(curStateName);
}

@wrapMethod(CExplorationStateClimb) function StateCanEnter( curStateName : name ) : bool
{	
	if (false)
	{
		wrappedMethod(curStateName);
	}

	if (FactsQuerySum("ACS_Has_Double_Jumped") > 0 
	|| FactsQuerySum("ACS_Has_Air_Dashed") > 0 
	|| FactsQuerySum("ACS_Is_Gliding") > 0 
	|| FactsQuerySum("acs_transformation_activated") > 0 
	|| GetWitcherPlayer().HasTag('acs_in_wraith') 
	|| GetWitcherPlayer().HasTag('ACS_Air_Time')
	|| GetWitcherPlayer().HasTag('ACS_Feainnewedd_Dance')
	|| ACSGetCEntity('ACS_Bruxa_Bite_Finisher_Vampire_Head')
	)
	{
		return false;
	}

	if( !InputWantsToEnter() )
	{
		return false;
	}
	
	if( 
	!thePlayer.IsActionAllowed( EIAB_Climb ) 
	|| !thePlayer.IsActionAllowed( EIAB_Movement ) 
	|| !thePlayer.IsActionAllowed( EIAB_Jump ) 
	)
	{
		return false;
	}

	return true;
}

@wrapMethod(CExplorationStateClimb) function OracleWantsToEnter() : bool
{
	if (FactsQuerySum("ACS_Has_Double_Jumped") > 0 
	|| FactsQuerySum("ACS_Has_Air_Dashed") > 0 
	|| FactsQuerySum("ACS_Is_Gliding") > 0 
	|| FactsQuerySum("acs_transformation_activated") > 0 
	|| GetWitcherPlayer().HasTag('acs_in_wraith') 
	|| GetWitcherPlayer().HasTag('ACS_Air_Time')
	|| GetWitcherPlayer().HasTag('ACS_Feainnewedd_Dance')
	|| ACSGetCEntity('ACS_Bruxa_Bite_Finisher_Vampire_Head')
	)
	{
		return false;
	}

	return wrappedMethod();
}

@wrapMethod(CActor) function GetWoundNameFromWoundType( woundType : int ) : name
{
	if (false)
	{
		wrappedMethod(woundType);
	}

	switch ( woundType )
	{
		case DWT_Head: return 'cut_head';
		case DWT_Torso:	return 'cut_torso';
		case DWT_TorsoLeft: return 'cut_torso_left';
		case DWT_TorsoRight: return 'cut_torso_right';
		case DWT_ArmLeft: return 'cut_arm_left';
		case DWT_ArmRight: return 'cut_arm_right';
		case DWT_LegLeft: return 'cut_leg_left';
		case DWT_LegRight: return 'cut_leg_right';
		
		case DWT_Morph_Head: return 'morph_cut_head';
		case DWT_Morph_Torso: return 'morph_cut_torso';
		case DWT_Morph_TorsoLeft: return 'morph_cut_torso_left';
		case DWT_Morph_TorsoRight: return 'morph_cut_torso_right';
		case DWT_Morph_ArmLeft:	return 'morph_cut_arm_left';
		case DWT_Morph_ArmRight: return 'morph_cut_arm_right';
		case DWT_Morph_LegLeft:	return 'morph_cut_leg_left';
		case DWT_Morph_LegRight: return 'morph_cut_leg_right';
		
		case DWT_DLC_Defined: return 'none';			
	}
}

@wrapMethod(CActor) function TurnOnRagdoll()
{
	if (false)
	{
		wrappedMethod();
	}

	if (HasAbility('mon_drowner_base')
	|| HasTag('ACS_Giant_Troll')
	|| HasTag('ACS_Bullvore')
	|| HasAbility('mon_lessog_base')
	|| HasAbility('mon_sprigan_base')
	)
	{
		return;
	}

	SetBehaviorVariable( 'Ragdoll_Weight', 1.f );
	RaiseEvent( 'Ragdoll' );
	ACS_ApplyForce((CNewNPC)this);
}

@wrapMethod(CActor) function OnEnumAnimEvent( animEventName : name, variant : SEnumVariant, animEventType : EAnimationEventType, animEventDuration : float, animInfo : SAnimationEventAnimInfo )
{
	var movementAdjustor 				: CMovementAdjustor;
	var ticket 							: SMovementAdjustmentRequestTicket;
	var rotationRate 					: ERotationRate;
	var loopShake						: bool;	
	var shakeStrength					: float;
	var animName						: name;	
	var	player							: CR4Player;
	var woundName						: name;
	var params 							: SCustomEffectParams;

	var dismembermentComp 				: CDismembermentComponent;
	var wounds							: array< name >;
	var usedWound						: name;
	var i 								: int;
	var electric_fist					: CACSElectricFist;
	var vfxEnt							: CEntity;

	var ticket_rotate					: SMovementAdjustmentRequestTicket;

	var torsoBoneIndex					: int;
	var bone_vec						: Vector;

	var bone_rot						: EulerAngles;

	var playerSpitProjectile			: CACSPlayerSpitProjectile;

	var toe_blade_r, toe_blade_l		: CACSCatSchoolToeBlade;

	var actortarget						: CActor;
	var victims			 				: array<CActor>;
	var k								: int;

	var animatedComponentPlayer			: CAnimatedComponent;

	var bloodsmokeEnt         			: CEntity;

	var sword_slash_ent					: CEntity;

	var tmpBool 						: bool;
	var mc 								: EMonsterCategory;
	var tmpName 						: name;

	var attAction						: W3Action_Attack;
	var soundeventstring				: array<string>;

	var dmg								: W3DamageAction;

	var template 						: CEntityTemplate;
	var entPhysics                  	: CEntity;
	var rot									: EulerAngles;
    var pos								: Vector;

	var ent, ent_2, ent_3, ent_4 		: CEntity;
	var attach_vec, pPos				: Vector;
	var attach_rot						: EulerAngles;

	var animatedComponentB				: CAnimatedComponent;

	var movementAdjustorFinisher		: CMovementAdjustor;
	var ticketFinisher 					: SMovementAdjustmentRequestTicket;
	var dist							: float;

	
	if (false)
	{
		wrappedMethod(animEventName, variant, animEventType, animEventDuration, animInfo);
	}

	animatedComponentPlayer = (CAnimatedComponent)thePlayer.GetComponentByClassName( 'CAnimatedComponent' );

	movementAdjustor = GetMovingAgentComponent().GetMovementAdjustor();

	switch( animEventName )
	{
		case 'RotateEvent':
		case 'RotateAwayEvent':
			
			rotationRate = GetRotationRateFromAnimEvent( variant.enumValue );

			if ( animEventType == AET_DurationStart || animEventType == AET_DurationStartInTheMiddle )
			{
				movementAdjustor.Cancel( movementAdjustor.GetRequest( 'RotateEvent' ) );
				
				ticket = movementAdjustor.CreateNewRequest( 'RotateEvent' );
				
				movementAdjustor.Continuous( ticket );
				movementAdjustor.KeepActiveFor( ticket, animEventDuration );
				if ((int)rotationRate >= 0)
				{
					movementAdjustor.MaxRotationAdjustmentSpeed( ticket, (float)((int)rotationRate) );
				}
				movementAdjustor.MatchMoveRotation( ticket );
				movementAdjustor.UpdateSourceAnimation( ticket, animInfo );
				movementAdjustor.CancelIfSourceAnimationUpdateIsNotUpdated( ticket ); 
				movementAdjustor.SteeringMayOverrideMaxRotationAdjustmentSpeed( ticket ); 
				if ( (CNewNPC)this )
				{
					if ( animEventName == 'RotateAwayEvent' )
						SignalGameplayEvent( 'RotateAwayEventStart');
					else
						SignalGameplayEvent( 'RotateEventStart');
				}
			}
			else if ( animEventType == AET_DurationEnd )
			{
				
				SignalGameplayEvent( 'RotateEventEnd');
			}
			else
			{
				ticket = movementAdjustor.GetRequest( 'RotateEvent' );
				movementAdjustor.UpdateSourceAnimation( ticket, animInfo );
				SignalGameplayEvent( 'RotateEventSync');
			}
		break;
		
		case 'InteractionPriority':
			if ( animEventType == AET_DurationStart )
			{
				if (this.IsMonster())
				{
					SetInteractionPriority( IP_Max_Unpushable );
				}
				else
				{
					SetInteractionPriority( (EInteractionPriority) variant.enumValue );
					
					RemoveTimer( 'RestoreOriginalInteractionPriorityTimer' );
					AddTimer( 'RestoreOriginalInteractionPriorityTimer', animEventDuration, false, , , true ) ;
				}
			}
		break;
		
		case 'Dismemberment':
			if ( animEventType == AET_DurationStart )
			{
				theSound.SoundEvent("kill_pre_bb_acs");
			}

			else if ( animEventType == AET_DurationEnd )
			{
				if (thePlayer.HasTag('ACS_Flammable_Oil_Enabled') 
				&& ACS_GetItem_SwordHeldSwitchBasedUponStat('bleed_sword')
				&& !ACSGetCEntity('ACS_Bloodsmoke_Ent')
				)
				{
					bloodsmokeEnt = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

					"dlc\dlc_acs\data\fx\acs_bloodsmoke_entity.w2ent"

					, true ), GetWorldPosition() + Vector(0,0,1.25), GetWorldRotation() );

					bloodsmokeEnt.AddTag('ACS_Bloodsmoke_Ent');
				}
				
				if( variant.enumValue == DWT_DLC_Defined )
				{			
					woundName = GetWoundNameFromDLCForAnim( animInfo );			
				}
				else 
				{
					woundName = GetWoundNameFromWoundType( variant.enumValue );
				}

				SetDismembermentInfo( woundName, this.GetWorldPosition() - thePlayer.GetWorldPosition(), false );

				if (!this.IsHuman())
				{
					dismemberForceRagdoll = true;
				}

				thePlayer.DestroyEffect('hit_screen');
				thePlayer.PlayEffectSingle('hit_screen');

				Dismember();

				if (ACS_Settings_Main_Bool('acs_custom_finishers_settings','acs_extra_sfx_on_dismember', true))
				{
					theSound.SoundEvent("kill_chance_bb_acs");

					soundeventstring.Clear();
					soundeventstring.PushBack("z000001059_bb_acs");
					soundeventstring.PushBack("z000001059b_bb_acs");
					soundeventstring.PushBack("z000001059c_bb_acs");
					soundeventstring.PushBack("z000001068_bb_acs");

					theSound.SoundEvent(soundeventstring[RandRange(soundeventstring.Size())]);
				}

				ACS_ApplyForce((CNewNPC)this);

				if (ACS_Settings_Main_Bool('acs_custom_finishers_settings','acs_extra_vfx_on_dismember', true))
				{
					GetACSWatcher().CreateCounterWoundSwordFX((CNewNPC)this);

					sword_slash_ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\fx\acs_sword_slashes.w2ent", true ), this.GetWorldPosition() + Vector( 0, 0, RandRangeF(1.5,1.25) ), EulerAngles(RandRangeF(360,0),RandRangeF(360,0),RandRangeF(360,0)));

					sword_slash_ent.DestroyAfter(0.5);

					if (((CMovingPhysicalAgentComponent)(this.GetMovingAgentComponent())).GetCapsuleHeight() >= 2
					|| this.GetRadius() >= 0.7
					|| this.HasAbility('Boss')
					|| this.HasTag('IsBoss')
					|| this.HasTag('ACS_Big_Boi')
					)
					{
						sword_slash_ent.PlayEffectSingle('sword_slash_finisher_large');
					}
					else
					{
						sword_slash_ent.PlayEffectSingle('sword_slash_finisher');
					}

					sword_slash_ent.PlayEffectSingle('sword_slash_finisher_secondary');
				}

				if (HasTag('ACS_man_finisher_dlc_arm_lp_combat_dismember')
				|| HasTag('ACS_man_finisher_dlc_arm_rp_combat_dismember')
				|| HasTag('ACS_man_finisher_dlc_legs_lp_combat_dismember')
				|| HasTag('ACS_man_finisher_dlc_legs_rp_combat_dismember')
				)
				{
					if (ACS_Settings_Main_Float('acs_custom_finishers_settings','acs_dismember_slow_mo_scale', 0.33) > 0)
					{
						GetACSWatcher().ACS_SlowMoAdjustable(ACS_Settings_Main_Float('acs_custom_finishers_settings','acs_dismember_slow_mo_scale', 0.33), 0.1);
					}

					theSound.SoundEvent("cmb_play_dismemberment_gore");

					theSound.SoundEvent("monster_dettlaff_monster_vein_hit_blood");

					theSound.SoundEvent("cmb_play_hit_heavy");

					params.effectType = EET_Bleeding;
					params.creator = GetWitcherPlayer();
					params.sourceName = "ACS_Combat_Dismember";
					params.duration = 999;

					this.AddEffectCustom( params );	

					if (HasTag('ACS_man_finisher_dlc_arm_lp_combat_dismember')
					)
					{
						DropItemFromSlot( 'r_weapon', true );

						params.effectType = EET_Blindness;
						params.creator = GetWitcherPlayer();
						params.sourceName = "ACS_Combat_Dismember";
						params.duration = 999;

						this.AddEffectCustom( params );	
					}
					else if (HasTag('ACS_man_finisher_dlc_arm_rp_combat_dismember')
					)
					{
						DropItemFromSlot( 'l_weapon', true );
					}
					else
					{
						//DropItemFromSlot( 'r_weapon', true );
						//DropItemFromSlot( 'l_weapon', true );
						AddTag('ACS_Final_Fear_Stack');
						AddTag('ACS_Scared_On_Ground');
						AddTag('ACS_Scared_On_Ground_Loop');

						AddEffectDefault( EET_Blindness, this, 'ACS_NPC_Fear' );

						((CAnimatedComponent)this.GetComponentByClassName( 'CAnimatedComponent' )).PlaySlotAnimationAsync ( 'man_ex_scared_ground_loop_1', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.125f, 1.f));
					}
				}
				else
				{
					if (ACS_Settings_Main_Float('acs_custom_finishers_settings','acs_dismember_slow_mo_scale', 0.33) > 0)
					{
						GetACSWatcher().ACS_SlowMoAdjustable(ACS_Settings_Main_Float('acs_custom_finishers_settings','acs_dismember_slow_mo_scale', 0.33), 0.1);
					}

					if (GetWitcherPlayer().IsAnyQuenActive()
					&& ACS_Settings_Main_Bool('acs_signs_settings','acs_quen_electric_discharge_enabled', true)
					)
					{
						electric_fist = (CACSElectricFist)theGame.CreateEntity((CEntityTemplate)LoadResource("dlc\dlc_acs\data\fx\electric_fist\acs_electric_fist.w2ent",true), this.GetWorldPosition(), this.GetWorldRotation());

						electric_fist.CreateAttachment(this,, Vector( 0, 0, RandRangeF(1.5,1.25) ), EulerAngles(RandRangeF(360,0),RandRangeF(360,0),RandRangeF(360,0)));

						electric_fist.DestroyAfter(3);
					}

					DropItemFromSlot( 'r_weapon', true );
					DropItemFromSlot( 'l_weapon', true );
				}
			}
		break;

		case 'Shake':
			if( animEventType == AET_Duration || animEventType == AET_DurationEnd )
			{
				return false;
			}
			loopShake = ( animEventType == AET_DurationStart );
			
			animName = '';
			if( loopShake )
			{
				animName = 'camera_shake_loop_lvl1_1';
				player = thePlayer;
				player.loopingCameraShakeAnimName = animName;
				thePlayer.AddTimer( 'RemoveQuestCameraShakeTimer', animEventDuration );
			}
			
			shakeStrength  	=  (int) variant.enumValue;
			shakeStrength	= ( shakeStrength / 10 ) * 1.9f + 0.1f ;
			GCameraShake( shakeStrength, true, this.GetWorldPosition(), 30.0f, loopShake, animName);
			
		break;

		case 'NoDismemberment':
			
			if ( animEventType == AET_DurationStart )
			{
				ACSGetCEntity('acs_finisher_dagger').StopEffect('fast_trail_blood_fx');
				ACSGetCEntity('acs_finisher_dagger').StopEffect('default_blood_trail');
				ACSGetCEntity('acs_finisher_dagger').StopEffect('cutscene_blood_trail');
				ACSGetCEntity('acs_finisher_dagger').StopEffect('cutscene_blood_trail_02');
				ACSGetCEntity('acs_finisher_dagger').StopEffect('blood_trail_horseriding');
				ACSGetCEntity('acs_finisher_dagger').StopEffect('blood_trail_finisher');

				ACSGetCEntity('acs_finisher_dagger').PlayEffect('fast_trail_blood_fx');
				ACSGetCEntity('acs_finisher_dagger').PlayEffect('default_blood_trail');
				ACSGetCEntity('acs_finisher_dagger').PlayEffect('cutscene_blood_trail');
				ACSGetCEntity('acs_finisher_dagger').PlayEffect('cutscene_blood_trail_02');
				ACSGetCEntity('acs_finisher_dagger').PlayEffect('blood_trail_horseriding');
				ACSGetCEntity('acs_finisher_dagger').PlayEffect('blood_trail_finisher');
				
				SoundEvent("cmb_play_ger_stab_in");

				GetMovingAgentComponent().GetMovementAdjustor().CancelAll();
			}
			else if ( animEventType == AET_DurationEnd )
			{
				dismembermentComp = (CDismembermentComponent)(this.GetComponentByClassName( 'CDismembermentComponent' ));

				dismembermentComp.GetWoundsNames( wounds );

				for( i=wounds.Size()-1; i>=0; i-=1 )
				{
					if( !StrContains( wounds[ i ], "gash" ) 
					)
					{
						wounds.EraseFast( i );
					}
				}
				
				if ( wounds.Size() > 0 )
				{
					usedWound = wounds[ RandRange( wounds.Size() ) ];
				}

				SetDismembermentInfo( usedWound, GetWorldPosition() - GetWorldPosition(), false, DETF_Igni );

				if (!this.IsHuman())
				{
					dismemberForceRagdoll = true;
				}

				thePlayer.DestroyEffect('hit_screen');
				thePlayer.PlayEffectSingle('hit_screen');

				Dismember();

				ACS_ApplyForce((CNewNPC)this);

				if (ACS_Settings_Main_Float('acs_custom_finishers_settings','acs_dismember_slow_mo_scale', 0.33) > 0)
				{
					GetACSWatcher().ACS_SlowMoAdjustable(ACS_Settings_Main_Float('acs_custom_finishers_settings','acs_dismember_slow_mo_scale', 0.33), 0.1);
				}

				if (ACS_Settings_Main_Bool('acs_custom_finishers_settings','acs_extra_vfx_on_dismember', true)
				)
				{
					GetACSWatcher().CreateCounterWoundSwordFX((CNewNPC)this);

					sword_slash_ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\fx\acs_sword_slashes.w2ent", true ), this.GetWorldPosition() + Vector( 0, 0, RandRangeF(1.5,1.25) ), EulerAngles(RandRangeF(360,0),RandRangeF(360,0),RandRangeF(360,0)));

					sword_slash_ent.DestroyAfter(0.5);

					if (((CMovingPhysicalAgentComponent)(this.GetMovingAgentComponent())).GetCapsuleHeight() >= 2
					|| this.GetRadius() >= 0.7
					|| this.HasAbility('Boss')
					|| this.HasTag('IsBoss')
					|| this.HasTag('ACS_Big_Boi')
					)
					{
						sword_slash_ent.PlayEffectSingle('sword_slash_finisher_large');
					}
					else
					{
						sword_slash_ent.PlayEffectSingle('sword_slash_finisher');
					}

					sword_slash_ent.PlayEffectSingle('sword_slash_finisher_secondary');
				}

				if (GetWitcherPlayer().IsAnyQuenActive()
				&& ACS_Settings_Main_Bool('acs_signs_settings','acs_quen_electric_discharge_enabled', true)
				)
				{
					electric_fist = (CACSElectricFist)theGame.CreateEntity((CEntityTemplate)LoadResource("dlc\dlc_acs\data\fx\electric_fist\acs_electric_fist.w2ent",true), this.GetWorldPosition(), this.GetWorldRotation());

					electric_fist.CreateAttachment(this,, Vector( 0, 0, RandRangeF(1.5,1.25) ), EulerAngles(RandRangeF(360,0),RandRangeF(360,0),RandRangeF(360,0)));

					electric_fist.DestroyAfter(3);
				}

				ACSGetCEntity('acs_finisher_dagger').StopEffect('fast_trail_blood_fx');
				ACSGetCEntity('acs_finisher_dagger').StopEffect('default_blood_trail');
				ACSGetCEntity('acs_finisher_dagger').StopEffect('cutscene_blood_trail');
				ACSGetCEntity('acs_finisher_dagger').StopEffect('cutscene_blood_trail_02');
				ACSGetCEntity('acs_finisher_dagger').StopEffect('blood_trail_horseriding');
				ACSGetCEntity('acs_finisher_dagger').StopEffect('blood_trail_finisher');

				ACSGetCEntity('acs_finisher_dagger').PlayEffect('fast_trail_blood_fx');
				ACSGetCEntity('acs_finisher_dagger').PlayEffect('default_blood_trail');
				ACSGetCEntity('acs_finisher_dagger').PlayEffect('cutscene_blood_trail');
				ACSGetCEntity('acs_finisher_dagger').PlayEffect('cutscene_blood_trail_02');
				ACSGetCEntity('acs_finisher_dagger').PlayEffect('blood_trail_horseriding');
				ACSGetCEntity('acs_finisher_dagger').PlayEffect('blood_trail_finisher');
				
				SoundEvent("cmb_play_dismemberment_gore");

				SoundEvent("monster_dettlaff_monster_vein_hit_blood");

				SoundEvent("cmb_play_ger_stab_out");

				StopEffect('blood');
				StopEffect('death_blood');
				StopEffect('heavy_hit');
				StopEffect('blood_spill');
				StopEffect('death_hit');
				StopEffect('critical_bleeding'); 

				PlayEffectSingle('blood');
				PlayEffectSingle('death_blood');
				PlayEffectSingle('heavy_hit');
				PlayEffectSingle('blood_spill');
				PlayEffectSingle('death_hit');
				PlayEffectSingle('critical_bleeding'); 

				Kill( 'ACS_Finisher', false, thePlayer );
				RemoveTimer('ACS_RagdollTimer');
				AddTimer('ACS_RagdollTimer', 0.75 , false );
			}

		break;

		case 'aard_360_event_acs':

			if ( animEventType == AET_DurationStart )
			{
				ACSGetCEntity('ACS_Sign_Physics_Ent').Destroy();

				rot = GetWitcherPlayer().GetWorldRotation();

				pos = GetWitcherPlayer().GetWorldPosition();

				pos.Z += 0.5;

				template = (CEntityTemplate)LoadResource("dlc\dlc_acs\data\fx\pc_aard.w2ent", true);


				entPhysics = theGame.CreateEntity( template, pos, rot );

				//ent.CreateAttachment( thePlayer, , Vector( 0, 1, 1 ), EulerAngles(0,0,0) );

				//ent.PlayEffectSingle('blast_lv1');
				//ent.PlayEffectSingle('blast_lv2');
				//ent.PlayEffectSingle('blast_lv3_damage');
				//ent.PlayEffectSingle('blast_lv3_power');

				if (ACS_Armor_Set_Check('acs_armor', false)
				&& ACS_Settings_Main_Bool('acs_signs_settings','acs_aard_extra_effects_enabled', true)
				)
				{
					GetACSWatcher().Red_Blade_Projectile_AOE_Spawner();
				}

				if ((ACS_Armor_Set_Check('forgotten_wolf', false) 
				|| ACS_Armor_Set_Check('acs_armor', false)
				|| ACS_Armor_Set_Check('volhikar', false)
				|| thePlayer.HasTag('acs_vampire_claws_equipped')
				|| ACS_Vampire_Claws_Access()) 
				&& ACS_Settings_Main_Bool('acs_signs_settings','acs_aard_extra_effects_enabled', true)
				)
				{
					entPhysics.PlayEffectSingle('blast_lv3_red');
				}
				else
				{
					entPhysics.PlayEffectSingle('blast_lv3');
				}

				if 
				(
					GetWitcherPlayer().IsAnyQuenActive()
					&& ACS_Settings_Main_Bool('acs_signs_settings','acs_quen_extra_effects_enabled', true)
				)
				{
					thePlayer.SoundEvent("magic_sorceress_vfx_hit_electric");
					thePlayer.SoundEvent("magic_sorceress_vfx_lightning_bolt");

					if (ACS_Is_DLC_Installed('dlcquen')
					|| ACS_Armor_Set_Check('acs_armor', false)
					|| ACS_Armor_Set_Check('wh_armor', false)
					|| ACS_Armor_Set_Check('eredin_armor', false)
					|| ACS_Armor_Set_Check('imlerith_armor', false)
					|| ACS_Armor_Set_Check('caranthir_armor', false)
					|| ACS_Armor_Set_Check('vgx_eredin_armor', false)
					)
					{
						entPhysics.PlayEffectSingle('blast_lv2_electric_blue');
						entPhysics.PlayEffectSingle('blast_lv1_electric_blue');
						entPhysics.PlayEffectSingle('blast_lv0_electric_blue');
					}
					else
					{
						entPhysics.PlayEffectSingle('blast_lv2_electric_normal');
						entPhysics.PlayEffectSingle('blast_lv1_electric_normal');
						entPhysics.PlayEffectSingle('blast_lv0_electric_normal');
					}
				}

				entPhysics.AddTag('ACS_Sign_Physics_Ent');

				entPhysics.DestroyAfter(3);

				if (ACS_Settings_Main_Bool('acs_signs_settings','acs_enhanced_aard_enabled', true))
				{
					ACSGetCEntity('ACS_Quen_Bubble').Destroy();
					
					ACSGetCEntity('ACS_Quen_Fx').Destroy();

					ACSGetCEntity('ACS_Sign_Icon').Destroy();

					ACSGetCEntity('ACS_Sign_Icon_Anchor').Destroy();

					ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
					"dlc\dlc_acs\data\fx\sign_icons.w2ent"
					, true ), GetWitcherPlayer().GetWorldPosition(), GetWitcherPlayer().GetWorldRotation() );

					ent_2 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 
					"dlc\dlc_acs\data\fx\sign_icons.w2ent"
					, true ), GetWitcherPlayer().GetWorldPosition(), GetWitcherPlayer().GetWorldRotation() );

					GetWitcherPlayer().GetBoneWorldPositionAndRotationByIndex( GetWitcherPlayer().GetBoneIndex( 'l_handRoll' ), bone_vec, bone_rot );

					if ( GetWitcherPlayer().GetEquippedSign() == ST_Aard)
					{
						attach_rot.Roll = 0;
						attach_rot.Pitch = 0;
						attach_rot.Yaw = 0;
						attach_vec.X = 0.4;
						attach_vec.Y = 0;
						attach_vec.Z = -0.025;

						ent.CreateAttachmentAtBoneWS( GetWitcherPlayer(), 'l_handRoll', bone_vec, bone_rot );

						ent_2.CreateAttachment( ent, , attach_vec, attach_rot );

						if ((ACS_Armor_Set_Check('forgotten_wolf', false) 
						|| ACS_Armor_Set_Check('acs_armor', false)
						|| ACS_Armor_Set_Check('volhikar', false)
						|| thePlayer.HasTag('acs_vampire_claws_equipped')
						|| ACS_Vampire_Claws_Access()
						))
						{
							ent_2.PlayEffectSingle('aard_icon_red');
						}
						else
						{
							ent_2.PlayEffectSingle('aard_icon');
						}

						ent_2.PlayEffectSingle('critical_aard');

						ent.DestroyAfter(0.5);
						ent_2.DestroyAfter(0.5);
					}

					ent.AddTag('ACS_Sign_Icon_Anchor');

					ent_2.AddTag('ACS_Sign_Icon');

					if ( !theSound.SoundIsBankLoaded("sign_aard.bnk") )
					{
						theSound.SoundLoadBank( "sign_aard.bnk", false );
					}

					thePlayer.SoundEvent("sign_aard_blast");
				}

				GetACSWatcher().Aard360DealDamage();

				GetACSWatcher().DestroyNestDelay();

				GetACSWatcher().ACS_KillHorsesTimer();

				GetACSWatcher().ToggleLockDelay();
			}

		break;
		
		default:
		break;
	}
			
	ACS_OnEnumAnimEventAdd_01(animEventName, variant, animEventType, animEventDuration, animInfo);

	ACS_OnEnumAnimEventAdd_02(animEventName, variant, animEventType, animEventDuration, animInfo);

	if (thePlayer.HasTag('ACS_IsPerformingFinisher')
	&& (
	this.HasTag('ACS_man_finisher_05_rp')
	|| this.HasTag('ACS_man_finisher_04_lp')
	|| this.HasTag('ACS_man_finisher_06_lp')
	|| this.HasTag('ACS_man_finisher_03_rp')
	)
	)
	{
		ticket_rotate = movementAdjustor.GetRequest( 'ACS_Actor_Finisher_Rotate');
		movementAdjustor.CancelByName( 'ACS_Actor_Finisher_Rotate' );
		
		ticket_rotate = movementAdjustor.CreateNewRequest( 'ACS_Actor_Finisher_Rotate');
		movementAdjustor.MaxRotationAdjustmentSpeed( ticket_rotate, 5000000 );
		movementAdjustor.MaxLocationAdjustmentSpeed( ticket_rotate, 5000000 );
		movementAdjustor.AdjustmentDuration( ticket_rotate, 0.125f );
		movementAdjustor.RotateTowards( ticket_rotate, thePlayer );
		movementAdjustor.Continuous(ticket_rotate);

		EnableCharacterCollisions(false);
	}
	else
	{
		ticket_rotate = movementAdjustor.GetRequest( 'ACS_Actor_Finisher_Rotate');
		movementAdjustor.CancelByName( 'ACS_Actor_Finisher_Rotate' );
	}
}

@addMethod(CActor) function ACS_OnEnumAnimEventAdd_01( animEventName : name, variant : SEnumVariant, animEventType : EAnimationEventType, animEventDuration : float, animInfo : SAnimationEventAnimInfo )
{
	var movementAdjustor 				: CMovementAdjustor;
	var ticket 							: SMovementAdjustmentRequestTicket;
	var rotationRate 					: ERotationRate;
	var loopShake						: bool;	
	var shakeStrength					: float;
	var animName						: name;	
	var	player							: CR4Player;
	var woundName						: name;
	var params 							: SCustomEffectParams;

	var dismembermentComp 				: CDismembermentComponent;
	var wounds							: array< name >;
	var usedWound						: name;
	var i 								: int;
	var electric_fist					: CACSElectricFist;
	var vfxEnt							: CEntity;

	var ticket_rotate					: SMovementAdjustmentRequestTicket;

	var torsoBoneIndex					: int;
	var bone_vec						: Vector;

	var bone_rot						: EulerAngles;

	var playerSpitProjectile			: CACSPlayerSpitProjectile;

	var toe_blade_r, toe_blade_l		: CACSCatSchoolToeBlade;

	var actortarget						: CActor;
	var victims			 				: array<CActor>;
	var k								: int;

	var animatedComponentPlayer			: CAnimatedComponent;

	var bloodsmokeEnt         			: CEntity;

	var sword_slash_ent					: CEntity;

	var tmpBool 						: bool;
	var mc 								: EMonsterCategory;
	var tmpName 						: name;

	var attAction						: W3Action_Attack;
	var soundeventstring				: array<string>;

	var dmg								: W3DamageAction;

	var template 						: CEntityTemplate;
	var entPhysics                  	: CEntity;
	var rot									: EulerAngles;
    var pos								: Vector;

	var ent, ent_2, ent_3, ent_4 		: CEntity;
	var attach_vec, pPos				: Vector;
	var attach_rot						: EulerAngles;

	var animatedComponentB				: CAnimatedComponent;

	var movementAdjustorFinisher		: CMovementAdjustor;
	var ticketFinisher 					: SMovementAdjustmentRequestTicket;
	var dist							: float;

	var actors    						: array<CActor>;

	var targetPos 										: Vector;

	var maxTargetVitality, maxTargetEssence, damageMax, damageMin			: float;

	var range, knockdownDur, reset_kinematic_duration					: float;



	switch( animEventName )
	{
		case 'tw2_grapple_event_acs':

			if ( animEventType == AET_DurationStart )
			{
				ACSGetCActor('ACS_Grapple_Target').BreakAttachment();

				rot = ACSGetCActor('ACS_Grapple_Target').GetWorldRotation();

				rot.Pitch = 0;

				rot.Roll = 0;

				ACSGetCActor('ACS_Grapple_Target').TeleportWithRotation(TraceFloor(ACSGetCActor('ACS_Grapple_Target').GetWorldPosition()), rot);

				ACSGetCEntity('ACS_Grapple_Dummy').Destroy();

				((CAnimatedComponent)(thePlayer.GetComponentByClassName( 'CAnimatedComponent' ))).FreezePose();

				((CAnimatedComponent)(thePlayer.GetComponentByClassName( 'CAnimatedComponent' ))).UnfreezePoseFadeOut(5);

				thePlayer.SoundEvent("sign_aard_blast");
				thePlayer.SoundEvent("sign_aard_blast");
				thePlayer.SoundEvent("sign_aard_blast");
				thePlayer.SoundEvent("sign_aard_blast");

				if(ACSGetCActor('ACS_Grapple_Target').IsAlive())
				{
					if (ACSGetCActor('ACS_Grapple_Target').GetHealth() <= ACSGetCActor('ACS_Grapple_Target').GetMaxHealth() * 0.15)
					{
						ACSGetCActor('ACS_Grapple_Target').SetKinematic(false);

						GetACSWatcher().Fear_Stack();

						thePlayer.SoundEvent("bone_break_bb_acs");
								
						thePlayer.SoundEvent("breach_bb_acs");

						dismembermentComp = (CDismembermentComponent)(ACSGetCActor('ACS_Grapple_Target').GetComponentByClassName( 'CDismembermentComponent' ));

						dismembermentComp.GetWoundsNames( wounds );

						for( i=wounds.Size()-1; i>=0; i-=1 )
						{
							if( !StrContains( wounds[ i ], "explode" ) 
							)
							{
								wounds.EraseFast( i );
							}
						}
						
						if ( wounds.Size() > 0 )
						{
							usedWound = wounds[ RandRange( wounds.Size() ) ];
						}

						ACSGetCActor('ACS_Grapple_Target').SetDismembermentInfo( usedWound, ACSGetCActor('ACS_Grapple_Target').GetWorldPosition() - ACSGetCActor('ACS_Grapple_Target').GetWorldPosition(), false );

						thePlayer.DestroyEffect('hit_screen');
						thePlayer.PlayEffectSingle('hit_screen');

						ACSGetCActor('ACS_Grapple_Target').Dismember();
					}

					ACSGetCActor('ACS_Grapple_Target').AddTag('ACS_Currently_In_Grapple_Anim');

					//animatedComponentB = (CAnimatedComponent)(ACSGetCActor('ACS_Grapple_Target').GetComponentByClassName( 'CAnimatedComponent' ));

					//animatedComponentB.FreezePoseFadeIn(0.125f);

					ACSGetCActor('ACS_Grapple_Target').ACS_GrappleVictimAnim();

					//ACSGetCActor('ACS_Grapple_Target').SetKinematic(false);

					ACSGetCActor('ACS_Grapple_Target').RemoveTimer('ACS_ResetKinematic');

					if (ACSGetCActor('ACS_Grapple_Target').UsesVitality()) 
					{ 
						ACSGetCActor('ACS_Grapple_Target').DrainVitality( 50 + ACSGetCActor('ACS_Grapple_Target').GetStat( BCS_Vitality ) * 0.25 );
					} 
					else if (ACSGetCActor('ACS_Grapple_Target').UsesEssence()) 
					{ 
						ACSGetCActor('ACS_Grapple_Target').DrainEssence( 50 + ACSGetCActor('ACS_Grapple_Target').GetStat( BCS_Essence ) * 0.25 );
					}
				
					ACSGetCActor('ACS_Grapple_Target').AddTimer('ACS_ResetKinematic', 4, false);
				}
				else
				{
					ACSGetCActor('ACS_Grapple_Target').SetKinematic(false);

					GetACSWatcher().Fear_Stack();

					thePlayer.SoundEvent("bone_break_bb_acs");
							
					thePlayer.SoundEvent("breach_bb_acs");

					
					dismembermentComp = (CDismembermentComponent)(ACSGetCActor('ACS_Grapple_Target').GetComponentByClassName( 'CDismembermentComponent' ));

					dismembermentComp.GetWoundsNames( wounds );

					for( i=wounds.Size()-1; i>=0; i-=1 )
					{
						if( !StrContains( wounds[ i ], "explode" ) 
						)
						{
							wounds.EraseFast( i );
						}
					}
					
					if ( wounds.Size() > 0 )
					{
						usedWound = wounds[ RandRange( wounds.Size() ) ];
					}

					ACSGetCActor('ACS_Grapple_Target').SetDismembermentInfo( usedWound, ACSGetCActor('ACS_Grapple_Target').GetWorldPosition() - ACSGetCActor('ACS_Grapple_Target').GetWorldPosition(), false );

					thePlayer.DestroyEffect('hit_screen');
					thePlayer.PlayEffectSingle('hit_screen');

					ACSGetCActor('ACS_Grapple_Target').Dismember();
				
				}

				if (GetWitcherPlayer().IsAnyQuenActive()
				&& ACS_Settings_Main_Bool('acs_signs_settings','acs_quen_electric_discharge_enabled', true)
				)
				{
					electric_fist = (CACSElectricFist)theGame.CreateEntity((CEntityTemplate)LoadResource("dlc\dlc_acs\data\fx\electric_fist\acs_electric_fist.w2ent",true), ACSGetCActor('ACS_Grapple_Target').GetWorldPosition(), ACSGetCActor('ACS_Grapple_Target').GetWorldRotation());

					electric_fist.CreateAttachment(ACSGetCActor('ACS_Grapple_Target'),, Vector( 0, 0, 1 ), EulerAngles(RandRangeF(360,0),RandRangeF(360,0),RandRangeF(360,0)));

					electric_fist.DestroyAfter(3);
				}
				else
				{
					torsoBoneIndex = ACSGetCActor('ACS_Grapple_Target').GetTorsoBoneIndex();

					if ( torsoBoneIndex != -1 )
					{
						bone_vec = MatrixGetTranslation( ACSGetCActor('ACS_Grapple_Target').GetBoneWorldMatrixByIndex( torsoBoneIndex ) );

						vfxEnt = theGame.CreateEntity( (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\fx\blood_fx.w2ent", true ), bone_vec, ACSGetCActor('ACS_Grapple_Target').GetWorldRotation() );
					}

					vfxEnt.PlayEffectSingle('fist_hit_indicator');
					vfxEnt.PlayEffectSingle('hit_refraction_red');
					vfxEnt.DestroyAfter(1.5);
				}
				
				thePlayer.SoundEvent("scene_cmb_fist_hit");

				ACSGetCActor('ACS_Grapple_Target').PlayEffectSingle('heavy_hit');
				ACSGetCActor('ACS_Grapple_Target').StopEffect('heavy_hit');

				ACSGetCActor('ACS_Grapple_Target').PlayEffectSingle('light_hit');
				ACSGetCActor('ACS_Grapple_Target').StopEffect('light_hit');

				rot = ACSGetCActor('ACS_Grapple_Target').GetWorldRotation();

				pos = ACSGetCActor('ACS_Grapple_Target').GetWorldPosition();

				thePlayer.SoundEvent("monster_nazair_guard_combat_hits_ground");

				thePlayer.SoundEvent("monster_cloud_giant_fx_rumble_crack");

				pos.Z += 1;

				if (thePlayer.HasTag('ACS_Flammable_Oil_Enabled')
				)
				{
					if (ACS_GetItem_SwordHeldSwitchBasedUponStat('frost_sword'))
					{
						theGame.GetSurfacePostFX().AddSurfacePostFXGroup( TraceFloor( pos ), 0.125f, 3, 0.125f, 10.f, 0);

						template = (CEntityTemplate)LoadResource("dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent", true);

						entPhysics = theGame.CreateEntity( template, pos, rot );

						entPhysics.PlayEffect('blast_lv2_aard');

						entPhysics.PlayEffect('blast_ground_mutation_6_aard');

						entPhysics.PlayEffect('blast_lv2_damage_aard');

						entPhysics.PlayEffect('blast_lv2_power_aard');
					}
					else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('poison_sword'))
					{
						ACS_Poison_Cloud();
					}
					else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('bleed_sword'))
					{
						GetACSWatcher().ACS_Blood_Arc();
					}
					else
					{
						theGame.GetSurfacePostFX().AddSurfacePostFXGroup( TraceFloor( pos ), 0.125f, 3, 0.125f, 10.f, 1);

						template = (CEntityTemplate)LoadResource("dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent", true);

						entPhysics = theGame.CreateEntity( template, pos, rot );

						//entPhysics.PlayEffect('blast_lv2_aard_fire');

						//entPhysics.PlayEffect('blast_lv1_aard_fire');
						
						entPhysics.PlayEffect('attack_special_fire_ACS');

						entPhysics.PlayEffect('leaf_fx_aard_fire');

						entPhysics.PlayEffect('attack_fx1_fire_ACS');

						entPhysics.PlayEffect('blast_fire_ACS');

						GetACSWatcher().Rock_Pillar('horse_leap');
					}
				}
				else
				{
					template = (CEntityTemplate)LoadResource("dlc\dlc_acs\data\fx\pc_aard.w2ent", true);

					entPhysics = theGame.CreateEntity( template, pos, rot );

					entPhysics.PlayEffectSingle('earthquake_fx_small');

					entPhysics.PlayEffectSingle('sword_ground_hit');

					if (ACS_Armor_Set_Check('forgotten_wolf', false) 
					|| ACS_Armor_Set_Check('acs_armor', false)
					|| ACS_Armor_Set_Check('volhikar', false)
					|| thePlayer.HasTag('acs_vampire_claws_equipped')
					|| ACS_Vampire_Claws_Access()
					)
					{
						entPhysics.PlayEffectSingle('blast_lv3_red');
					}
					else
					{
						entPhysics.PlayEffectSingle('blast_lv3');
					}

					GetACSWatcher().Rock_Pillar('horse_leap');
				}

				entPhysics.DestroyAfter(20);

				actors.Clear();

				actors = thePlayer.GetNPCsAndPlayersInCone(5, VecHeading(thePlayer.GetHeadingVector()), 360, 5, , FLAG_ExcludePlayer + FLAG_Attitude_Hostile + FLAG_OnlyAliveActors );

				if( actors.Size() > 0 )
				{
					for( i = 0; i < actors.Size(); i += 1 )
					{
						targetPos = actors[i].GetWorldPosition();

						actortarget = (CActor)actors[i];

						dmg = new W3DamageAction in theGame.damageMgr;
						
						dmg.Initialize(thePlayer, actortarget, NULL, thePlayer.GetName(), EHRT_Heavy, CPS_Undefined, false, false, true, false);

						dmg.SetHitAnimationPlayType(EAHA_ForceYes);
						
						//dmg.AddDamage( theGame.params.DAMAGE_NAME_DIRECT, RandRangeF(damageMax,damageMin) );

						if (((CMovingPhysicalAgentComponent)(actortarget.GetMovingAgentComponent())).GetCapsuleHeight() >= 2
						|| actortarget.GetRadius() >= 0.7
						|| actortarget.HasAbility('Boss')
						|| actortarget.HasTag('IsBoss')
						|| actortarget.HasTag('ACS_Big_Boi')
						|| actortarget.HasTag('ACS_Swapped_To_Shield') 
						|| ((CNewNPC)actortarget).IsShielded( NULL ) 
						)
						{
							if (actortarget.UsesVitality()) 
							{ 
								maxTargetVitality = actortarget.GetStat( BCS_Vitality );

								damageMax = maxTargetVitality * 0.125; 

								damageMin = maxTargetVitality * 0.0625; 
							} 
							else if (actortarget.UsesEssence()) 
							{ 
								maxTargetEssence = actortarget.GetStat( BCS_Essence );
								
								damageMax = maxTargetEssence * 0.125; 
								
								damageMin = maxTargetEssence * 0.0625; 
							}
						}
						else
						{
							if (actortarget.UsesVitality()) 
							{ 
								maxTargetVitality = actortarget.GetStatMax( BCS_Vitality ) - actortarget.GetStat( BCS_Vitality );

								damageMax = maxTargetVitality * 0.125; 

								damageMin = maxTargetVitality * 0.0625; 
							} 
							else if (actortarget.UsesEssence()) 
							{ 
								maxTargetEssence = actortarget.GetStatMax( BCS_Essence ) - actortarget.GetStat( BCS_Essence );
								
								damageMax = maxTargetEssence * 0.125; 
								
								damageMin = maxTargetEssence * 0.0625; 
							}
						}

						dmg.AddDamage( theGame.params.DAMAGE_NAME_PHYSICAL, RandRangeF(50 + damageMax,50 + damageMin) );

						dmg.AddDamage( theGame.params.DAMAGE_NAME_SILVER, RandRangeF(50 + damageMax,50 + damageMin) );

						//thePlayer.SoundEvent("cmb_fistfight_parry");

						dmg.SetHitReactionType( EHRT_Heavy, true);

						if (actortarget != ACSGetCActor('ACS_Grapple_Target'))
						{
							movementAdjustorFinisher = actortarget.GetMovingAgentComponent().GetMovementAdjustor();

							ticketFinisher = movementAdjustorFinisher.GetRequest( 'ACS_NPC_Kick_Attacked_Rotate');
							movementAdjustorFinisher.CancelByName( 'ACS_NPC_Kick_Attacked_Rotate' );
							movementAdjustorFinisher.CancelAll();

							ticketFinisher = movementAdjustorFinisher.CreateNewRequest( 'ACS_NPC_Kick_Attacked_Rotate' );
							movementAdjustorFinisher.AdjustmentDuration( ticketFinisher, 0.1 );
							movementAdjustorFinisher.MaxRotationAdjustmentSpeed( ticketFinisher, 50000 );

							movementAdjustorFinisher.RotateTowards( ticketFinisher, thePlayer );
						}

						
						knockdownDur = 2;

						if(!actortarget.IsImmuneToBuff(EET_HeavyKnockdown) || !actortarget.IsImmuneToBuff(EET_HeavyKnockdown) )
						{
							if(!actortarget.IsImmuneToBuff(EET_HeavyKnockdown) )
							{
								dmg.AddEffectInfo( EET_HeavyKnockdown, knockdownDur );
							}
							else
							{
								dmg.AddEffectInfo( EET_Knockdown, knockdownDur );
							}
						}
					

						if (thePlayer.HasTag('ACS_Flammable_Oil_Enabled')
						)
						{
							if (ACS_GetItem_SwordHeldSwitchBasedUponStat('frost_sword'))
							{
								dmg.AddEffectInfo( EET_Frozen, 3 );
							}
							else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('poison_sword'))
							{
								dmg.AddEffectInfo( EET_Poison, 3 );
							}
							else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('bleed_sword'))
							{
								dmg.AddEffectInfo( EET_Bleeding, 3 );
							} 
							else
							{
								dmg.AddEffectInfo( EET_Burning, 3 );
							}
						}

						//thePlayer.SoundEvent("scene_cmb_fist_hit");

						dmg.SetCriticalHit(); theGame.damageMgr.ProcessAction( dmg );
							
						delete dmg;	

						if(thePlayer.IsOnGround() && actortarget.IsOnGround() && actortarget.GetCurrentHealth() <= 0)
						{
							thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( 'man_ger_crawl_finish_vampire', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0.125f, 0.125f) );
						}
					}
				}

				ACSGetCActor('ACS_Grapple_Target').RemoveTag('ACS_Grapple_Target');
			}
		break;

		case 'acs_counter_wound_slice':
			if ( animEventType == AET_DurationStart )
			{
				GetACSWatcher().CreateCounterWoundSwordFX(GetACSWatcher().counter_wound_target);

				thePlayer.ACS_SetAnimationSpeedMultiplier(2);

				GetACSWatcher().RemoveTimer('ACS_ResetAnimation'); 
					
				GetACSWatcher().AddTimer('ACS_ResetAnimation', 0.5   , false );

				(GetACSWatcher().counter_wound_target).ACS_SetAnimationSpeedMultiplier(1);

				thePlayer.DestroyEffect('hit_screen');
				thePlayer.PlayEffectSingle('hit_screen');

				if ((GetACSWatcher().counter_wound_target).IsAlive())
				{

		parent.UpdateRealWeapon();
	
		Unlock();		
		parent.SetCurrentMeleWeapon( weapontype );	

		ACSSwordSummonEffect('igni');

		GetACSWatcher().SetStance('steel_group_stance', false);
		GetACSWatcher().SetStance('steel_strong_stance', false);
		GetACSWatcher().SetStance('steel_fast_stance', false);

		GetACSWatcher().SetStance('silver_group_stance', false);
		GetACSWatcher().SetStance('silver_strong_stance', false);
		GetACSWatcher().SetStance('silver_fast_stance', false);

		GetACSWatcher().RemoveTimer('SwordSheatheManagement');
		GetACSWatcher().AddTimer('SwordSheatheManagement', 1 , false );

		GetACSWatcher().RemoveTimer('SetScabbardFlag');
		GetACSWatcher().AddTimer('SetScabbardFlag', 0.5 , false );

		GetACSWatcher().RemoveTimer('ForceControlModuleHudUpdate');
		GetACSWatcher().AddTimer('ForceControlModuleHudUpdate', 0.25f , false);

		return;
	}
	
	if ( (ACS_CloakEquippedCheck() 
	&& (ACS_Settings_Main_Int ('acs_player_equipment_visual_settings','acs_swords_positioning_when_cloaked', 0, true) == 1 
	|| FactsQuerySum("ACS_Force_Weapons_On_Hips") > 0) ) 
	)
	{ 
		switch( weapontype )
		{
			case PW_None :
				if ( thePlayer.GetInventory().IsItemHeld(steelid) )
				{
					if ( ACS_DoNotCreateMeshCheck('steel', steelid) )
					{
						ACS_MeleeWeaponEquipSwordFlair(false);

						Sleep( 0.25 );

						//thePlayer.RaiseEvent('ACS_SwordTauntEnd');

						thePlayer.RaiseEvent('ACS_HolsterSwordAlt');

						Sleep( 1.25 );

						thePlayer.GetInventory().UnmountItem( steelid, true );

						Sleep(0.0125);

						if( GetWitcherPlayer().GetItemEquippedOnSlot( EES_SteelSword, item) )
						{
							if (item == steelid)
							{
								thePlayer.GetInventory().MountItem( steelid, false );
							}
						}

						OnWeaponHolsterReady();
					}
					else
					{
						ACS_MeleeWeaponEquipSwordFlair(false);

						Sleep( 0.25 );

						//thePlayer.RaiseEvent('ACS_SwordTauntEnd');
						
						thePlayer.RaiseEvent('ACS_HolsterSwordHip');
						
						Sleep(0.125);

						OnWeaponHolsterReady();

						GetACSWatcher().CreateSteelDummySwordOnHip(false);
					}
				}
				else if ( thePlayer.GetInventory().IsItemHeld(silverid) )
				{
					if ( ACS_DoNotCreateMeshCheck('silver', silverid) )
					{
						ACS_MeleeWeaponEquipSwordFlair(false);

						Sleep( 0.25 );

						//thePlayer.RaiseEvent('ACS_SwordTauntEnd');

						thePlayer.RaiseEvent('ACS_HolsterSwordAlt');

						Sleep( 1.25 );

						thePlayer.GetInventory().UnmountItem( silverid, true );

						Sleep(0.0125);

						if( GetWitcherPlayer().GetItemEquippedOnSlot( EES_SilverSword, item) )
						{
							if (item == silverid)
							{
								thePlayer.GetInventory().MountItem( silverid, false );
							}
						}

						OnWeaponHolsterReady();
					}
					else
					{
						ACS_MeleeWeaponEquipSwordFlair(false);

						Sleep( 0.25 );

						//thePlayer.RaiseEvent('ACS_SwordTauntEnd');

						thePlayer.RaiseEvent('ACS_HolsterSwordHip');

						Sleep(0.125);

						OnWeaponHolsterReady();

						GetACSWatcher().CreateSilverDummySwordOnHip(false);
					}
				}
			break;

			case PW_Fists : 
				if ( thePlayer.GetInventory().IsItemHeld(steelid) )
				{ 
					if ( !ACS_DoNotCreateMeshCheck('steel', steelid) )
					{
						ACS_MeleeWeaponEquipSwordFlair(false);

						Sleep( 0.25 );

						//thePlayer.RaiseEvent('ACS_SwordTauntEnd');

						thePlayer.RaiseEvent('ACS_HolsterSwordHip');

						OnWeaponHolsterReady();

						GetACSWatcher().CreateSteelDummySwordOnHip(false);
					}
					else
					{
						ACS_MeleeWeaponEquipSwordFlair(false);

						Sleep( 0.25 );

						//thePlayer.RaiseEvent('ACS_SwordTauntEnd');

						thePlayer.RaiseEvent('ACS_HolsterSwordAlt');

						Sleep( 1.25 );

						thePlayer.GetInventory().UnmountItem( steelid, true );

						Sleep(0.0125);

						if( GetWitcherPlayer().GetItemEquippedOnSlot( EES_SteelSword, item) )
						{
							if (item == steelid)
							{
								thePlayer.GetInventory().MountItem( steelid, false );
							}
						}

						OnWeaponHolsterReady();
					}	
				}
				else if ( thePlayer.GetInventory().IsItemHeld(silverid) )
				{ 
					if ( !ACS_DoNotCreateMeshCheck('silver', silverid) )
					{
						ACS_MeleeWeaponEquipSwordFlair(false);

						Sleep( 0.25 );

						//thePlayer.RaiseEvent('ACS_SwordTauntEnd');

						thePlayer.RaiseEvent('ACS_HolsterSwordHip');

						OnWeaponHolsterReady();

						GetACSWatcher().CreateSilverDummySwordOnHip(false);
					}
					else
					{
						ACS_MeleeWeaponEquipSwordFlair(false);

						Sleep( 0.25 );

						//thePlayer.RaiseEvent('ACS_SwordTauntEnd');

						thePlayer.RaiseEvent('ACS_HolsterSwordAlt');

						Sleep( 1.25 );

						thePlayer.GetInventory().UnmountItem( silverid, true );

						Sleep(0.0125);

						if( GetWitcherPlayer().GetItemEquippedOnSlot( EES_SilverSword, item) )
						{
							if (item == silverid)
							{
								thePlayer.GetInventory().MountItem( silverid, false );
							}
						}

						OnWeaponHolsterReady();
					}
				}
			
				if ( !thePlayer.inv.HasItem('Geralt fists') && !thePlayer.IsFistFightMinigameEnabled() )
				{
					thePlayer.inv.AddAnItem( 'Geralt fists', 1, true, true, false );
				}

				thePlayer.SetRequiredItems('Any', 'fist' );
				thePlayer.ProcessRequiredItems();
			break;

			case PW_Steel:
				if( GetWitcherPlayer().GetItemEquippedOnSlot(EES_SteelSword, item) )
				{
					if( thePlayer.GetInventory().IsItemHeld(silverid) )
					{
						if (ACS_DoNotCreateMeshCheck('silver', silverid))
						{
							ACS_MeleeWeaponEquipSwordFlair(false);

							Sleep( 0.25 );

							//thePlayer.RaiseEvent('ACS_SwordTauntEnd');

							thePlayer.RaiseEvent('ACS_HolsterSwordAlt');

							Sleep( 1.25 );

							ACSGetCEntity('ACS_SwordOnHip_Silver_Sword_Dummy').BreakAttachment();

							ACSGetCEntity('ACS_SwordOnHip_Silver_Sword_Dummy').Teleport(thePlayer.GetWorldPosition() + Vector(0,0,-200));

							ACSGetCEntity('ACS_SwordOnHip_Silver_Sword_Dummy').DestroyAfter(0.125f);

							ACSGetCEntity('ACS_SwordOnHip_Silver_Sword_Dummy').RemoveTag('ACS_SwordOnHip_Silver_Sword_Dummy');

							thePlayer.GetInventory().UnmountItem( silverid, true );

							Sleep(0.0125);

							if( GetWitcherPlayer().GetItemEquippedOnSlot( EES_SilverSword, item) )
							{
								if (item == silverid)
								{
									thePlayer.GetInventory().MountItem( silverid, false );
								}
							}

							OnWeaponHolsterReady();

							Sleep( 0.75 );
						}
						else
						{
							ACS_MeleeWeaponEquipSwordFlair(false);

							Sleep( 0.25 );

							//thePlayer.RaiseEvent('ACS_SwordTauntEnd');

							thePlayer.RaiseEvent('ACS_HolsterSwordHip');

							GetACSWatcher().CreateSilverDummySwordOnHip(false);

							OnWeaponHolsterReady();

							Sleep( 0.5 );
						}
					}

					if (ACS_DoNotCreateMeshCheck('steel', steelid))
					{
						//Sleep( 0.3 );

						//ACS_MeleeWeaponEquipSwordFlair(false);

						if (thePlayer.HasTag('ACS_IsSwordWalking') )
						{
							thePlayer.RemoveTag('ACS_IsSwordWalking');
						}


@wrapMethod(CNewNPC) function OnDeath( damageAction : W3DamageAction  )
{
	wrappedMethod(damageAction);

	MuteHeadAudio(true);
						
	SetBehaviorMimicVariable( 'gameplayMimicsMode', (float)(int)GMM_Tpose );
}

state ACS_TalkingAnimalsControl in CNewNPC 
{
	var talkingAnimalsInteractionEnt 		: CEntity;
	var talkingAnimalsInteractionTemplate 	: CEntityTemplate;
	var talkingAnimalsEnabled				: bool;
	default talkingAnimalsEnabled = false;

	event OnEnterState(previous_state_name: name) 
	{
    	super.OnEnterState(previous_state_name);
	
    	ACS_TalkingAnimalsControl_ENTRY();
	}

	entry function ACS_TalkingAnimalsControl_ENTRY() 
	{
		while (true) 
		{
			ACS_TalkingAnimalsControl_LATENT();

      		SleepOneFrame();
    	}
	}

	latent function ACS_TalkingAnimalsControl_LATENT() 
	{
		var temp_names							: array<string>;
		var meshcomp							: CComponent;
		var animcomp 							: CAnimatedComponent;
		var h 									: float;

		if(!thePlayer.HasTag('ACS_TalkingAnimalsEnabled'))
		{
			if(talkingAnimalsEnabled)
			{
				((CNewNPC)parent).SetVisibility(true);

				((CNewNPC)parent).EnableCollisions(true);

				((CNewNPC)parent).EnableCharacterCollisions(true);

				((CNewNPC)parent).SetImmortalityMode( AIM_None, AIC_Default, true ); 

				((CNewNPC)parent).SetCanPlayHitAnim(true); 

				((CNewNPC)parent).RemoveBuffImmunity_AllNegative('acs_talking_animal'); 

				((CNewNPC)parent).RemoveBuffImmunity_AllCritical('acs_talking_animal'); 

				parent.BreakAttachment();

				parent.Teleport(ACSFixZAxis(parent.GetWorldPosition()));

				talkingAnimalsEnabled = false;
			}

			if(talkingAnimalsInteractionEnt)
			{
				talkingAnimalsInteractionEnt.Destroy();
			}

			return;
		}

		if(!talkingAnimalsEnabled)
		{
			temp_names.Clear();

			temp_names.PushBack("dlc\dlc_acs\data\entities\other\talking_animals\talking_cat.w2ent");
			temp_names.PushBack("dlc\dlc_acs\data\entities\other\talking_animals\talking_chicken.w2ent");
			temp_names.PushBack("dlc\dlc_acs\data\entities\other\talking_animals\talking_cow.w2ent");
			temp_names.PushBack("dlc\bob\data\quests\minor_quests\quest_files\mq7017_talking_horse\characters\mq7017_dog.w2ent");
			temp_names.PushBack("dlc\bob\data\quests\minor_quests\quest_files\mq7017_talking_horse\characters\mq7017_wolf.w2ent");
			temp_names.PushBack("dlc\dlc_acs\data\entities\other\talking_animals\talking_goat.w2ent");
			//temp_names.PushBack("dlc\dlc_acs\data\entities\other\talking_animals\talking_goose.w2ent");
			temp_names.PushBack("dlc\dlc_acs\data\entities\other\talking_animals\talking_goose_leader.w2ent");
			temp_names.PushBack("dlc\dlc_acs\data\entities\other\talking_animals\talking_mountain_goat.w2ent");
			temp_names.PushBack("dlc\dlc_acs\data\entities\other\talking_animals\talking_pig.w2ent");
			//temp_names.PushBack("dlc\dlc_acs\data\entities\other\talking_animals\talking_ram.w2ent");
			temp_names.PushBack("dlc\dlc_acs\data\entities\other\talking_animals\talking_rooster.w2ent");
			temp_names.PushBack("dlc\dlc_acs\data\entities\other\talking_animals\talking_sheep.w2ent");

			//temp_names.PushBack("quests\secondary_npcs\bart_the_troll.w2ent");
			//temp_names.PushBack("quests\secondary_npcs\borys_the_troll.w2ent");

			talkingAnimalsInteractionTemplate = (CEntityTemplate)LoadResourceAsync(temp_names[RandRange(temp_names.Size())], true);

			talkingAnimalsInteractionEnt = (CEntity)theGame.CreateEntity( talkingAnimalsInteractionTemplate, parent.GetWorldPosition(), parent.GetWorldRotation() );

			((CNewNPC)talkingAnimalsInteractionEnt).SetImmortalityMode( AIM_Invulnerable, AIC_Default, true ); 

			((CNewNPC)talkingAnimalsInteractionEnt).SetCanPlayHitAnim(false); 

			((CNewNPC)talkingAnimalsInteractionEnt).AddBuffImmunity_AllNegative('acs_talking_animal', true); 

			((CNewNPC)talkingAnimalsInteractionEnt).AddBuffImmunity_AllCritical('acs_talking_animal', true); 

			animcomp = (CAnimatedComponent)talkingAnimalsInteractionEnt.GetComponentByClassName('CAnimatedComponent');
			meshcomp = talkingAnimalsInteractionEnt.GetComponentByClassName('CMeshComponent');
			h = RandRangeF(1.5,0.75);
			animcomp.SetScale(Vector(h,h,h,1));
			meshcomp.SetScale(Vector(h,h,h,1));	

			talkingAnimalsInteractionEnt.AddTag('ACS_Talking_Animal');

			talkingAnimalsEnabled = true;
		}
		else
		{
			parent.BreakAttachment();

			parent.CreateAttachment(talkingAnimalsInteractionEnt,, Vector(0,0,2));

			((CNewNPC)parent).SetVisibility(false);

			((CNewNPC)parent).SetGameplayVisibility( false );

			((CNewNPC)parent).EnableCollisions(false);

			((CNewNPC)parent).EnableCharacterCollisions(false);

			((CNewNPC)parent).SetImmortalityMode( AIM_Invulnerable, AIC_Default, true ); 

			((CNewNPC)parent).SetCanPlayHitAnim(false); 

			((CNewNPC)parent).AddBuffImmunity_AllNegative('acs_talking_animal', true); 

			((CNewNPC)parent).AddBuffImmunity_AllCritical('acs_talking_animal', true); 
		}
	}
}


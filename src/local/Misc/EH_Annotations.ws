					case 'dirt_hard':
					case 'dirt_soil':
					case 'hay':
						m_CollisionEffect.PlayEffect('fist');
					break;
					case 'stone_debris':
					case 'stone_solid':
					case 'clay_tile':
					case 'gravel_large':
					case 'gravel_small':
					case 'metal':
					case 'custom_sword':

@wrapMethod(CMonsterNestEntity) function OnSpawned( spawnData : SEntitySpawnData )
{
	wrappedMethod(spawnData);

	RemoveTimer('ACS_Monster_Nest_Spawn');
	AddTimer('ACS_Monster_Nest_Spawn', 0.5 , false );
}

@addMethod( CMonsterNestEntity ) timer function ACS_Monster_Nest_Spawn(dt:float,id:int)
{
	var ent	: CACSMonsterSpawner;

	if (ACS_AdditionalWorldEncountersSpawnChance('acs_bullvore_encounter_enabled',1) > 0)
	{
		if (monsterNestType == EN_Rotfiend
		|| monsterNestType == EN_Ghoul
		)
		{
			if (RandF() < ACS_AdditionalWorldEncountersSpawnChance('acs_bullvore_encounter_enabled',1))
			{
				ent = (CACSMonsterSpawner)theGame.CreateEntity( 

				(CEntityTemplate)LoadResource( "dlc\dlc_acs\data\entities\other\acs_monster_spawner.w2ent", true ), 

				this.GetWorldPosition(), 

				this.GetWorldRotation() );

				ent.AddTag('ACS_MonsterSpawner_Bullvore');

				ent.AddTag('ACS_MonsterSpawner_Spawn_In_Combat');
			}
		}
	}
	
	if (ACS_AdditionalWorldEncountersSpawnChance('acs_arachne_encounter_enabled',1) > 0)
	{
		if (monsterNestType == EN_BlackSpider
		|| monsterNestType == EN_Kikimora
		|| monsterNestType == EN_Endriaga
		|| monsterNestType == EN_Scolopendromorph
		)
		{
			if (RandF() < ACS_AdditionalWorldEncountersSpawnChance('acs_arachne_encounter_enabled',1))
			{
				ent = (CACSMonsterSpawner)theGame.CreateEntity( 

				(CEntityTemplate)LoadResource( "dlc\dlc_acs\data\entities\other\acs_monster_spawner.w2ent", true ), 

				this.GetWorldPosition(), 

				this.GetWorldRotation() );

				ent.AddTag('ACS_MonsterSpawner_Arachne');

				ent.AddTag('ACS_MonsterSpawner_Spawn_In_Combat');
			}
		}
	}

}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

@wrapMethod(CRiftEntity) function ActivateRift( optional dontActivateEncounter : bool )
{
	var ent	: CACSMonsterSpawner;

	wrappedMethod(dontActivateEncounter);

	if (ACS_AdditionalWorldEncountersSpawnChance('acs_wild_hunt_minion_alpha_encounter_enabled',1) > 0
	&& isIntact
	)
	{
		ent = (CACSMonsterSpawner)theGame.CreateEntity( 

		(CEntityTemplate)LoadResource( "dlc\dlc_acs\data\entities\other\acs_monster_spawner.w2ent", true ), 

		this.GetWorldPosition(), 

		this.GetWorldRotation() );

		ent.AddTag('ACS_MonsterSpawner_WildhuntMinionAlpha');

		ent.AddTag('ACS_MonsterSpawner_Spawn_In_Combat');
	}
}


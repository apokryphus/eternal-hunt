			{
				ACS_Cultist_Boss_Siren_Spawn();

				if (!thePlayer.inv.HasItem('lore_acs_fucusya_1')
				&& !thePlayer.inv.HasItem('lore_acs_fucusya_2')
				&& !thePlayer.inv.HasItem('lore_acs_fucusya_3')
				&& !thePlayer.inv.HasItem('lore_acs_fucusya_4')
				&& !thePlayer.inv.HasItem('lore_acs_fucusya_5')
				&& !thePlayer.inv.HasItem('lore_acs_fucusya_6')
				&& !thePlayer.inv.HasItem('lore_acs_fucusya_7')
				)
				{
					thePlayer.inv.AddAnItem('lore_acs_fucusya_1', 1);
				}
				else if (thePlayer.inv.HasItem('lore_acs_fucusya_1')
				&& !thePlayer.inv.HasItem('lore_acs_fucusya_2')
				&& !thePlayer.inv.HasItem('lore_acs_fucusya_3')
				&& !thePlayer.inv.HasItem('lore_acs_fucusya_4')
				&& !thePlayer.inv.HasItem('lore_acs_fucusya_5')
				&& !thePlayer.inv.HasItem('lore_acs_fucusya_6')
				&& !thePlayer.inv.HasItem('lore_acs_fucusya_7')
				)
				{
					thePlayer.inv.AddAnItem('lore_acs_fucusya_2', 1);
				}
				else if (thePlayer.inv.HasItem('lore_acs_fucusya_1')
				&& thePlayer.inv.HasItem('lore_acs_fucusya_2')
				&& !thePlayer.inv.HasItem('lore_acs_fucusya_3')
				&& !thePlayer.inv.HasItem('lore_acs_fucusya_4')
				&& !thePlayer.inv.HasItem('lore_acs_fucusya_5')
				&& !thePlayer.inv.HasItem('lore_acs_fucusya_6')
				&& !thePlayer.inv.HasItem('lore_acs_fucusya_7')
				)
				{
					thePlayer.inv.AddAnItem('lore_acs_fucusya_3', 1);
				}
				else if (thePlayer.inv.HasItem('lore_acs_fucusya_1')
				&& thePlayer.inv.HasItem('lore_acs_fucusya_2')
				&& thePlayer.inv.HasItem('lore_acs_fucusya_3')
				&& !thePlayer.inv.HasItem('lore_acs_fucusya_4')
				&& !thePlayer.inv.HasItem('lore_acs_fucusya_5')
				&& !thePlayer.inv.HasItem('lore_acs_fucusya_6')
				&& !thePlayer.inv.HasItem('lore_acs_fucusya_7')
				)
				{
					thePlayer.inv.AddAnItem('lore_acs_fucusya_4', 1);
				}
				else if (thePlayer.inv.HasItem('lore_acs_fucusya_1')
				&& thePlayer.inv.HasItem('lore_acs_fucusya_2')
				&& thePlayer.inv.HasItem('lore_acs_fucusya_3')
				&& thePlayer.inv.HasItem('lore_acs_fucusya_4')
				&& !thePlayer.inv.HasItem('lore_acs_fucusya_5')
				&& !thePlayer.inv.HasItem('lore_acs_fucusya_6')
				&& !thePlayer.inv.HasItem('lore_acs_fucusya_7')
				)
				{
					thePlayer.inv.AddAnItem('lore_acs_fucusya_5', 1);
				}
				else if (thePlayer.inv.HasItem('lore_acs_fucusya_1')
				&& thePlayer.inv.HasItem('lore_acs_fucusya_2')
				&& thePlayer.inv.HasItem('lore_acs_fucusya_3')
				&& thePlayer.inv.HasItem('lore_acs_fucusya_4')
				&& thePlayer.inv.HasItem('lore_acs_fucusya_5')
				&& !thePlayer.inv.HasItem('lore_acs_fucusya_6')
				&& !thePlayer.inv.HasItem('lore_acs_fucusya_7')
				)
				{
					thePlayer.inv.AddAnItem('lore_acs_fucusya_6', 1);
				}
				else if (thePlayer.inv.HasItem('lore_acs_fucusya_1')
				&& thePlayer.inv.HasItem('lore_acs_fucusya_2')
				&& thePlayer.inv.HasItem('lore_acs_fucusya_3')
				&& thePlayer.inv.HasItem('lore_acs_fucusya_4')
				&& thePlayer.inv.HasItem('lore_acs_fucusya_5')
				&& thePlayer.inv.HasItem('lore_acs_fucusya_6')
				&& !thePlayer.inv.HasItem('lore_acs_fucusya_7')
				)
				{
					thePlayer.inv.AddAnItem('lore_acs_fucusya_7', 1);
				}

				this.AddTag('ACS_Cultist_Boss_Death');
			}
		}
	}
	else if(
	this.HasTag('ACS_Cultist')
	)
	{
		if (!this.IsAlive())
		{
			if(!this.HasTag('ACS_Cultist_Singer_Death'))
			{
				ACS_Cultist_Siren_Spawn();

				this.AddTag('ACS_Cultist_Singer_Death');
			}
		}
	}
	else if(
	this.HasTag('ACS_Cultist_Singer')
	)
	{
		if (!this.IsAlive())
		{
			if(!this.HasTag('ACS_Cultist_Death'))
			{
				animatedComponentA = (CAnimatedComponent)this.GetComponentByClassName( 'CAnimatedComponent' );

				anim_names.Clear();

				anim_names.PushBack('woman_sorceress_death_front_01');
				anim_names.PushBack('woman_sorceress_death_front_02');

				animatedComponentA.PlaySlotAnimationAsync ( anim_names[RandRange(anim_names.Size())], 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));

				animatedComponentA.FreezePoseFadeIn(2);

				this.AddTag('ACS_Cultist_Death');
			}
		}
	}
	else if(
	this.HasTag('ACS_Pirate_Zombie')
	)
	{
		if (!this.IsAlive())
		{
			if(!this.HasTag('ACS_Pirate_Zombie_Despawn'))
			{
				PlayEffectSingle('ethereal_buff');
				PlayEffectSingle('ethereal_debuff');

				SetVisibility(false);

				ACSGetCEntity('ACS_Pirate_Zombie_Trail').Destroy();

				ACSGetCEntity('ACS_Pirate_Zombie_Chest_Bone_1').Destroy();

				ACSGetCEntity('ACS_Pirate_Zombie_Chest_Bone_2').Destroy();

				ACSGetCEntity('ACS_Pirate_Zombie_Chest_Bone_3').Destroy();

				ACSGetCEntity('ACS_Pirate_Zombie_Chest_Bone_4').Destroy();

				this.AddTag('ACS_Pirate_Zombie_Despawn');
			}
		}
	}
	else if(
	this.HasTag('ACS_Incubus')
	)
	{
		if (!this.IsAlive())
		{
			if(!this.HasTag('ACS_Incubus_Despawn'))
			{
				StopAllEffects();

				PlayEffect('teleport_in');

				PlayEffect('teleport_out');

				DestroyAfter(5);

				this.AddTag('ACS_Incubus_Despawn');
			}
		}
	}
	else if(
	this.HasTag('ACS_Mage')
	)
	{
		if (!this.IsAlive())
		{
			if(!this.HasTag('ACS_Mage_Despawn'))
			{
				StopAllEffects();

				PlayEffect('teleport_in');

				PlayEffect('teleport_out');

				DestroyAfter(10);

				this.AddTag('ACS_Mage_Despawn');
			}
		}
	}
	else if(
	this.HasTag('ACS_Shades_Rogue')
	)
	{
		if (!this.IsAlive())
		{
			if(!this.HasTag('ACS_Shades_Rogue_Despawn'))
			{
				GetInventory().RemoveAllItems();

				this.AddTag('ACS_Shades_Rogue_Despawn');
			}
		}
	}
	else if(
	this.HasTag('ACS_Draug')
	)
	{
		if (!this.IsAlive())
		{
			if(!this.HasTag('ACS_Draug_Death'))
			{
				animatedComponentA = (CAnimatedComponent)this.GetComponentByClassName( 'CAnimatedComponent' );

				GetACSWatcher().RemoveTimer('ACS_Draug_Anchor_Respawn');

				ACSGetCEntity('ACS_Draug_Fake_Anchor').BreakAttachment();

				ACSGetCEntity('ACS_Draug_Fake_Anchor').Teleport(ACSGetCActor('ACS_Draug').GetWorldPosition() + Vector(0,0,-200));

				ACSGetCEntity('ACS_Draug_Fake_Anchor').DestroyAfter(0.001);

				l_comp = ((CActor)ACSGetCActor('ACS_Draug')).GetComponentsByClassName( 'CMorphedMeshManagerComponent' );
				size = l_comp.Size();

				for ( j=0; j<size; j+= 1 )
				{
					((CMorphedMeshManagerComponent)l_comp[ j ]).SetMorphBlend( 0, 0.001 );
				}

				animatedComponentA.PlaySlotAnimationAsync ( 'giant_death_from_lightning_ACS', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));

				animatedComponentA.FreezePoseFadeIn(25);

				this.AddTag('ACS_Draug_Death');
			}
		}
	}
	else if(
	this.HasTag('ACS_Draugir')
	)
	{
		if (!this.IsAlive())
		{
			if(!this.HasTag('ACS_Draugir_Death'))
			{
				StopAllEffects();

				//((CNewNPC)npc).SetVisibility(false);

				PlayEffectSingle('explode');

				PlayEffectSingle('fire_hit');

				PlayEffectSingle('fire_blowing');

				PlayEffectSingle('fire_blowing_2');

				StopAllEffects();

				this.AddTag('ACS_Draugir_Death');
			}
		}
	}
	else if(
	this.HasTag('ACS_MegaWraith')
	)
	{
		if (!this.IsAlive())
		{
			if(!this.HasTag('ACS_Megawraith_Death'))
			{
				ACSGetCEntity('ACS_MegaWraith_R_Weapon').Destroy();

				ACSGetCEntity('ACS_MegaWraith_L_Weapon').Destroy();

				StopEffect('demonic_possession');

				DestroyEffect('critical_burning_green_ex');

				DestroyEffect('critical_burning_green_ex_r');

				this.AddTag('ACS_Megawraith_Death');
			}
		}
	}
	else if(
	this.HasTag('ACS_Fire_Gryphon')
	)
	{
		if (!this.IsAlive())
		{
			if(!this.HasTag('ACS_Fire_Gryphon_Death'))
			{

				this.AddTag('ACS_Fire_Gryphon_Death');
			}
		}
	}
	else if(
	this.HasTag('ACS_Big_Hym')
	)
	{
		if (!this.IsAlive())
		{
			if(!this.HasTag('ACS_Big_Hym_Death'))
			{
				StopAllEffects();

				PlayEffect('avatar_death_swollen');

				SetVisibility(false);

				this.AddTag('ACS_Big_Hym_Death');
			}
		}
	}
	else if(
	this.HasTag('ACS_Guardian_Blood_Hym_Small')
	|| this.HasTag('ACS_Guardian_Blood_Hym_Large')
	)
	{
		if (!this.IsAlive())
		{
			if(!this.HasTag('ACS_Guardian_Hym_Death'))
			{
				bloodtentacle_proj_1 = (W3ACSBloodTentacles)theGame.CreateEntity( 
				(CEntityTemplate)LoadResource( "dlc\dlc_acs\data\entities\projectiles\blood_tentacles.w2ent", true ), ACSFixZAxis(this.GetWorldPosition()) );
				bloodtentacle_proj_1.DestroyAfter(10);	

				DestroyAfter(0.5);

				this.AddTag('ACS_Guardian_Hym_Death');
			}
		}
	}
	else if(
	this.HasTag('ACS_Viy_Of_Maribor')
	)
	{
		if (!this.IsAlive())
		{
			if(!this.HasTag('ACS_Viy_Death'))
			{
				StopAllEffects();

				this.AddTag('ACS_Viy_Death');
			}
		}
	}
	else if(
	this.HasTag('ACS_Giant_Troll')
	)
	{
		if (!this.IsAlive())
		{
			if(!this.HasTag('ACS_Giant_Troll_Death'))
			{
				ACS_Alghoul_Explode(this, this.GetWorldPosition());
				
				animatedComponentA = (CAnimatedComponent)this.GetComponentByClassName( 'CAnimatedComponent' );

				animatedComponentA.PlaySlotAnimationAsync ( 'monster_cave_troll_death_2', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));

				animatedComponentA.FreezePoseFadeIn(5.7f);

				ACS_LootDrop(this);

				this.AddTag('ACS_Giant_Troll_Death');
			}
		}
	}
	else if(
	this.HasTag('ACS_Acorn_Wraith')
	)
	{
		if (!this.IsAlive())
		{
			if(!this.HasTag('ACS_Acorn_Wraith_Death'))
			{
				StopEffect('critical_burning_red_ex');
				StopEffect('critical_burning_red_ex_r');
				StopEffect('demonic_possession_ex');

				this.AddTag('ACS_Acorn_Wraith_Death');
			}
		}
	}
	else if(
	this.HasTag('ACS_Dark_Knight')
	)
	{
		if (!this.IsAlive())
		{
			if(!this.HasTag('ACS_Dark_Knight_Death'))
			{
				DestroyEffect('ghost');
				DestroyEffect('him_smoke_red');
				DestroyEffect('shadow_form');
				DestroyEffect('smoke_effect_1');
				DestroyEffect('smoke_effect_2');

				PlayEffect('death_vision');

				SetVisibility(false);

				this.AddTag('ACS_Dark_Knight_Death');
			}
		}
	}
	else if(
	this.HasTag('ACS_Dark_Knight_Calidus')
	)
	{
		if (!this.IsAlive())
		{
			if(!this.HasTag('ACS_Dark_Knight_Calidus_Death'))
			{
				DestroyEffect('lugos_vision_burning_mat');
				DestroyEffect('burning_body');
				DestroyEffect('him_smoke_red');
				DestroyEffect('shadow_form');
				DestroyEffect('lugos_vision_burning');
				DestroyEffect('smoke_effect_1');
				DestroyEffect('smoke_effect_2');

				PlayEffect('death_vision');

				SetVisibility(false);

				this.AddTag('ACS_Dark_Knight_Calidus_Death');
			}
		}
	}
	else if(
	this.HasTag('ACS_Dwarf')
	)
	{
		if (!this.IsAlive())
		{
			if(!this.HasTag('ACS_Dwarf_End_Stage'))
			{
				DisableAgony();

				SetKinematic(false);

				DropItemFromSlot( 'l_weapon', true );
				DropItemFromSlot( 'r_weapon', true );

				AddTimer( 'DelayedDismemberTimer', 0.05f , false );

				this.AddTag('ACS_Dwarf_End_Stage');
			}
		}
	}
	else if(
	this.HasTag('ACS_Swarm_Mother')
	)
	{
		if (!this.IsAlive())
		{
			if(!this.HasTag('ACS_Swarm_Mother_End_Stage'))
			{
				ACSGetCEntityDestroyAll('ACS_Swarm_Mother_Hive');

				this.AddTag('ACS_Swarm_Mother_End_Stage');
			}
		}
	}

	if( isHorse )
	{
		GetHorseComponent().OnKillHorse();
	}

	if (ACS_ActionDealsDamageType(damageAction, 'fire')
	|| ((W3IgniEntity)damageAction.causer) 
	|| ((W3IgniProjectile)damageAction.causer)
	|| (W3Effect_Burning)damageAction.causer
	|| (ACS_Armor_Set_Check('acs_armor', false) && (CPlayer)damageAction.attacker)
	)
	{
		this.AddTag('ACS_Killed_By_Fire');

		ACSCreateBurningFX(this);
		
		RemoveTimer('ACS_Critical_Burning_Delay');
		AddTimer('ACS_Critical_Burning_Delay', 0.5 , false );

		if (this.GetAttitude( thePlayer ) != AIA_Hostile)
		{
			RemoveTimer('ACS_Critical_Burning_Remove_Delay');
			AddTimer('ACS_Critical_Burning_Remove_Delay', 7 , false );
		}
		else
		{
			RemoveTimer('ACS_Critical_Burning_Remove_Delay');
			AddTimer('ACS_Critical_Burning_Remove_Delay', 300 , false );
		}
	}

	if (ACS_ActionDealsDamageType(damageAction, 'frost')
	|| (W3Effect_SlowdownFrost)damageAction.causer
	|| (W3Effect_Frozen)damageAction.causer
	)
	{
		this.AddTag('ACS_Killed_By_Ice');
		
		RemoveTimer('ACS_Critical_Frozen_Delay');
		AddTimer('ACS_Critical_Frozen_Delay', 0.5 , false );
	}

	if (thePlayer.HasTag('ACS_Flammable_Oil_Enabled') && (CPlayer)damageAction.attacker && damageAction.IsActionMelee())
	{
		if (ACS_GetItem_SwordHeldSwitchBasedUponStat('frost_sword'))
		{
			this.AddTag('ACS_Killed_By_Ice');
		
			RemoveTimer('ACS_Critical_Frozen_Delay');
			AddTimer('ACS_Critical_Frozen_Delay', 0.5 , false );
		}
		else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('poison_sword'))
		{
			ACS_Poison_Cloud();
		}
		else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('bleed_sword'))
		{
			GetACSWatcher().ACS_Blood_Arc();
		}
		else
		{
			this.AddTag('ACS_Killed_By_Fire');

			ACSCreateBurningFX(this);
			
			RemoveTimer('ACS_Critical_Burning_Delay');
			AddTimer('ACS_Critical_Burning_Delay', 0.5 , false );

			if (this.GetAttitude( thePlayer ) != AIA_Hostile)
			{
				RemoveTimer('ACS_Critical_Burning_Remove_Delay');
				AddTimer('ACS_Critical_Burning_Remove_Delay', 7 , false );
			}
			else
			{
				RemoveTimer('ACS_Critical_Burning_Remove_Delay');
				AddTimer('ACS_Critical_Burning_Remove_Delay', 300 , false );
			}
		}	
	}

	RemoveTimer('ACS_Set_Kinematic_False_Delay');

	if (!IsAnimal())
	{
		if (IsHuman())
		{
			AddTimer('ACS_Set_Kinematic_False_Delay', 3 , false );
		}
		else
		{
			if (
			!HasAbility('mon_bear_base')
			&& GetSfxTag() != 'sfx_bear'
			&& !HasTag('ACS_Dracogryph')
			&& !HasTag('ACS_Vigilosaur')
			&& !HasTag('ACS_Vigilosaur_Alpha')
			&& !HasTag('ACS_Giant_Troll')
			&& !HasTag('ACS_Plumard')
			&& !HasTag('ACS_Plumard_Elder')
			&& !HasTag('ACS_Phooca')
			&& !HasTag('ACS_Nekker_Guardian')
			&& GetSfxTag() != 'sfx_elemental_dao' 
			&& GetSfxTag() != 'sfx_golem'
			&& GetSfxTag() != 'sfx_elemental_ifryt'
			&& !HasAbility('mon_ice_golem')
			&& !HasAbility('mon_barbegazi')
			&& !HasAbility('mon_sharley')
			&& !HasTag('ACS_Bullvore')
			&& !HasAbility('mon_arachas_base')
			&& !HasAbility('mon_poison_arachas')
			&& !HasAbility('mon_black_spider_base')
			&& !HasAbility('mon_endriaga_soldier_tailed')
			&& !HasAbility('mon_endriaga_worker')
			&& !HasAbility('mon_scolopendromorph_base')
			&& !HasAbility('mon_kikimora_warrior')
			&& !HasAbility('mon_kikimora_worker')
			&& !HasAbility('mon_black_spider_ep2_base')
			&& GetSfxTag() != 'sfx_arachas'
			&& GetSfxTag() != 'sfx_endriaga'
			&& !HasTag('mq7023_pale_widow')
			&& !HasAbility('mon_lessog_base')
			&& !HasAbility('mon_sprigan_base')
			)
			{
				AddTimer('ACS_Set_Kinematic_False_Delay', 1.5 , false );
			}
		}
	}
}

@addMethod( CR4Player ) timer function ACS_PlayerUnfreezePose( dt : float, id : int )
{
	var animatedComponentA					: CAnimatedComponent;

	if (this.HasTag('ACS_Player_Hit_Lag'))
	{
		animatedComponentA = (CAnimatedComponent)this.GetComponentByClassName( 'CAnimatedComponent' );

		animatedComponentA.UnfreezePose();

		animatedComponentA.UnfreezePoseFadeOut(0.1);

		this.RemoveTag('ACS_Player_Hit_Lag');
	}
}

@addMethod( CNewNPC ) timer function ACS_UnfreezePose( dt : float, id : int )
{
	var animatedComponentA					: CAnimatedComponent;

	if (this.HasTag('ACS_Hit_Lag'))
	{
		animatedComponentA = (CAnimatedComponent)this.GetComponentByClassName( 'CAnimatedComponent' );

		animatedComponentA.UnfreezePose();

		animatedComponentA.UnfreezePoseFadeOut(0.1);

		this.RemoveTag('ACS_Hit_Lag');
	}
}

@addMethod( CNewNPC ) function ACS_LootDrop( actorTarget : CNewNPC )
{
	var tags 				: array< name >;
	var inventory 			: CInventoryComponent;
	var lootEntity 			: CEntity;
	var lootContainer 		: W3Container;
	var i 					: int;
	var loot 				: W3ActorRemains;
	var commonMapManager 	: CCommonMapManager;
	var lootPos				: Vector;
	var l_pos 				: Vector;
	var l_groundZ			: float;
	var waterLevel 			: float;
	var submersionLevel 	: float;
	var world				: CWorld;
	
	
	world = theGame.GetWorld();
	l_pos = actorTarget.GetWorldPosition();
	waterLevel = world.GetWaterLevel ( l_pos, true );
	
	submersionLevel = waterLevel - l_pos.Z;
	
	inventory = actorTarget.GetInventory();
	inventory.UpdateLoot();
	lootEntity = inventory.ThrowAwayLootableItems( true );
	
	loot = (W3ActorRemains)lootEntity;
	if ( lootEntity && loot )
	{
		loot.LootDropped(actorTarget);
		
		
		if ( actorTarget.RemainsTags.Size() > 0 )
		{
			tags = loot.GetTags();	
			for ( i = 0; i < actorTarget.RemainsTags.Size(); i+=1 )
			{
				tags.PushBack( actorTarget.RemainsTags[i] );					
			}
			loot.SetTags( tags );
		}
		
		
		lootPos = actorTarget.GetWorldPosition();
		
		if( !world.NavigationFindSafeSpot( lootPos, 0.45, 10, lootPos ) )
		{
			if ( world.NavigationComputeZ( lootPos, lootPos.Z - 128.0, lootPos.Z + 1.0, l_groundZ ) )
			{
				lootPos.Z = l_groundZ;
				
				world.NavigationFindSafeSpot( lootPos, 0.45, 10, lootPos );
			}
		}
		
		if ( world.PhysicsCorrectZ( lootPos, l_groundZ ) )
		{
			lootPos.Z = l_groundZ;
		}
		
		loot.Teleport( lootPos );
	}
}

@addMethod( CNewNPC ) timer function ACS_Set_Kinematic_False_Delay( dt : float, id : int )
{
	AddTag('ACS_Allow_For_Ragdoll_On_Collision_On_Death');
}

@addMethod( CNewNPC ) timer function ACS_Critical_Burning_Delay( dt : float, id : int )
{
	DestroyEffect('critical_burning');
	PlayEffect('critical_burning');
}

@addMethod( CNewNPC ) timer function ACS_Critical_Burning_Remove_Delay( dt : float, id : int )
{
	DestroyEffect('critical_burning');
}

@addMethod( CNewNPC ) timer function ACS_Critical_Frozen_Delay( dt : float, id : int )
{
	DestroyEffect('critical_frozen');
	PlayEffect('critical_frozen');
}

/////////////////////////////////////////////////////////////////////////////////////////////////////////////////

@addMethod( CNewNPC ) timer function ACS_Finisher_Slice_Delay( dt : float, id : int )
{
	var vfxEnt					: CEntity;
	var tmpBool 				: bool;
	var mc 						: EMonsterCategory;
	var tmpName 				: name;
	var torsoBoneIndex			: int;
	var pos 					: Vector;
	var sound_names				: array<string>;


	torsoBoneIndex = ((CActor)this).GetTorsoBoneIndex();

	if ( torsoBoneIndex != -1 )
	{
		pos = MatrixGetTranslation( ((CActor)this).GetBoneWorldMatrixByIndex( torsoBoneIndex ) );
	}
	else
	{
		pos = this.GetWorldPosition();
	}

	vfxEnt = theGame.CreateEntity( (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\fx\blood_fx.w2ent", true ), pos );
	vfxEnt.DestroyAfter(1.5);

	theGame.GetMonsterParamsForActor(this, mc, tmpName, tmpBool, tmpBool, tmpBool);

	if( this.GetBloodType() == BT_Red) 
	{
		if (HasAbility('mon_lessog_base')
		|| HasAbility('mon_sprigan_base')
		)
		{						
			vfxEnt.PlayEffectSingle('blood_explode_black');

			vfxEnt.PlayEffectSingle('blood_spatter_black');
		} 
		else 
		{
			vfxEnt.PlayEffectSingle('blood_explode_red');

			vfxEnt.PlayEffectSingle('blood_spatter_red');
		}
	}
	else if( this.GetBloodType() == BT_Green) 
	{
		if (HasAbility('mon_kikimore_base')
		|| HasAbility('mon_black_spider_base')
		|| HasAbility('mon_black_spider_ep2_base')
		|| HasTag('ACS_Ungoliant')
		)
		{						
			vfxEnt.PlayEffectSingle('blood_explode_black');

			vfxEnt.PlayEffectSingle('blood_spatter_black');
		} 
		else 

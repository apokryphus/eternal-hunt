@addField(CNewNPC)
public var acs_2h_weapon_destruction_counter : int;

@addField(CNewNPC)
public var acs_2h_weapon_destruction_type : CName;

@addMethod(CNewNPC) function ACS_Manage2HWeaponDestructionCounter ( b : bool )
{
	spear = GetInventory().GetItemEntityUnsafe( GetInventory().GetItemFromSlot( 'r_weapon' ) );
	spear.DestroyEffect('wood_break');
	spear.PlayEffectSingle('wood_break');

	if (b)
	{
		this.SoundEvent("phx_wood_break_huge");
		this.SoundEvent("phx_wood_break_big");
		this.SoundEvent("phx_wood_break_huge");
		this.SoundEvent("phx_wood_break_big");
		this.SoundEvent("phx_wood_break_huge");
		this.SoundEvent("phx_wood_break_big");

		acs_2h_weapon_destruction_counter -= acs_2h_weapon_destruction_counter;
	}
	else
	{
		switch(acs_2h_weapon_destruction_counter)
		{
			case 3:
				this.SoundEvent("phx_wood_break_big");
				this.SoundEvent("phx_wood_break_big");
				this.SoundEvent("phx_wood_break_big");
			break;

			case 2:
				this.SoundEvent("phx_wood_break_medium");
				this.SoundEvent("phx_wood_break_medium");
				this.SoundEvent("phx_wood_break_medium");
			break;

			case 1:
				this.SoundEvent("phx_wood_break_small");
				this.SoundEvent("phx_wood_break_small");
				this.SoundEvent("phx_wood_break_small");
			break;

			default:
				this.SoundEvent("phx_wood_break_tiny");
				this.SoundEvent("phx_wood_break_tiny");
				this.SoundEvent("phx_wood_break_tiny");
			break;
		}

		acs_2h_weapon_destruction_counter += 1;
	}
}

@wrapMethod( CNewNPC ) function SpearImpulse(dt : float, id : int)
{
	var ids : array<SItemUniqueId>;
	var item_name : CName;

	if(false) 
	{
		wrappedMethod(dt, id);
	}

	DropItemFromSlot('r_weapon', true);

	switch(acs_2h_weapon_destruction_type)
	{
		case 'hammer':
			item_name = 'ACS_Q1_brokenHammer';
		break;

		case 'axe':
			item_name = 'ACS_Q1_brokenAxe';
		break;

		case 'halberd':
			item_name = 'ACS_Q1_brokenHalberd';
		break;

		case 'spear':
			item_name = 'Q1_brokenSpear';
		break;

		default:
			item_name = 'Q1_brokenSpear';
		break;
	}

	ids = GetInventory().GetItemsByName(item_name);

	if(ids.Size() <= 0)
	{
		ids = GetInventory().AddAnItem( item_name , 1, true, true, false );
	}
		
	GetInventory().MountItem(ids[0], true);
}

@wrapMethod( CNewNPC ) function ProcessSpearDestruction() : bool 
{
	var appearanceName 																: name;
	var weaponTags																	: array<name>;
	var weaponId 																	: SItemUniqueId;
	
	if(false) 
	{
		wrappedMethod();
	}

	spear = GetInventory().GetItemEntityUnsafe( GetInventory().GetItemFromSlot( 'r_weapon' ) );
	appearanceName = 'broken';
	spear.ApplyAppearance( appearanceName );

	spear.DestroyEffect('wood_break');
	spear.PlayEffectSingle('wood_break');

	weaponId = GetInventory().GetItemFromSlot('r_weapon');
	GetInventory().GetItemTags( weaponId , weaponTags );

	if (weaponTags.Contains('axe2h')
	)
	{
		acs_2h_weapon_destruction_type = 'axe';
	}
	else if ( weaponTags.Contains('hammer2h')
	)
	{
		acs_2h_weapon_destruction_type = 'hammer';
	}
	else if (weaponTags.Contains('halberd2h')
	)
	{
		acs_2h_weapon_destruction_type = 'halberd';
	}
	else
	{
		acs_2h_weapon_destruction_type = 'spear';
	}

	AddTimer('SpearImpulse', 0.05f, false);
	
	return true;
}

@wrapMethod( CR4HudModuleSubtitles ) function OnSubtitleAdded( id : int, speakerNameDisplayText : string, htmlString : string, alternativeUI : bool )
{
	var audio, subtitles : string;

	theGame.GetGameLanguageName( audio, subtitles );

	if (subtitles == "EN")
	{
		if (StrContains( speakerNameDisplayText, "Geralt" )
		)
		{
			speakerNameDisplayText = "Gerry";
		}

		if (StrContains( htmlString, "Geralt" )
		)
		{
			htmlString = StrReplace(htmlString, "Geralt", "Gerry");
		}
	}

	wrappedMethod(id, speakerNameDisplayText, htmlString, alternativeUI);
}

@wrapMethod( CR4HudModuleDialog ) function OnDialogSentenceSet( text : string, optional alternativeUI : bool )
{
	var audio, subtitles : string;

	theGame.GetGameLanguageName( audio, subtitles );

	if (subtitles == "EN")
	{
		if (StrContains( text, "Geralt" 
		&& RandF() < 0.01
		)
		)
		{
			text = StrReplace(text, "Geralt", "Gerry");
		}

		if (StrContains( text, "Vesemir" 
		&& RandF() < 0.01
		)
		)
		{
			text = StrReplace(text, "Vesemir", "Papa Vesemir");
		}
	}

	wrappedMethod(text, alternativeUI);
}

@wrapMethod( CR4HudModuleDialog ) function OnDialogPreviousSentenceSet( text : string )
{
	var audio, subtitles : string;

	theGame.GetGameLanguageName( audio, subtitles );

	if (subtitles == "EN")
	{
		if (StrContains( text, "Geralt" 
		&& RandF() < 0.01
		)
		)
		{
			text = StrReplace(text, "Geralt", "Gerry");
		}

		if (StrContains( text, "Vesemir" 
		&& RandF() < 0.01
		)
		)
		{
			text = StrReplace(text, "Vesemir", "Papa Vesemir");
		}
	}
	
	wrappedMethod(text);
}

@wrapMethod( CR4ScriptedHud ) function UpdateScaleformStageSize()
{
	var currentWidth, currentHeight : int;
	var ratio : float;
	var horizontalFactor, verticalFactor : float;

	if (false)
	{
		wrappedMethod();
	}
	
	theGame.GetCurrentViewportResolution( currentWidth, currentHeight );
	ratio = ( (float)currentWidth ) / currentHeight;

	if (currentWidth > 0 && currentHeight > 0)
	{
		horizontalFactor = currentWidth / 1920.0f;
		verticalFactor = currentHeight / 1080.0f;

		if (horizontalFactor > verticalFactor)
		{
			m_scaleformWidth   = RoundF(currentWidth / verticalFactor);
			m_scaleformHeight  = 1080;
			m_scaleformOffsetX = RoundF((m_scaleformWidth - 1920) * -0.5);
			m_scaleformOffsetY = 0;
		}
		else
		{
			m_scaleformWidth   = 1920;
			m_scaleformHeight  = RoundF(currentHeight / horizontalFactor);
			m_scaleformOffsetX = 0;
			m_scaleformOffsetY = RoundF((m_scaleformHeight - 1080) * -0.5);
		}
	}
	else
	{
		m_scaleformWidth   = 1920;
		m_scaleformHeight  = 1080;
		m_scaleformOffsetX = 0;
		m_scaleformOffsetY = 0;
	}
}


@wrapMethod(W3Container) function TakeAllItems()
{
	var targetInv : CInventoryComponent;
	var allItems	: array< SItemUniqueId >;
	var ciriEntity  : W3ReplacerCiri;
	var i : int;
	var itemsCategories : array< name >;
	var category : name;
	
	if (false
    )
    {
		wrappedMethod();
    }
	
	targetInv = thePlayer.inv;
	
	if( !inv || !targetInv )
	{
		return;
	}
	
	inv.GetAllItems( allItems );

	LogChannel( 'ITEMS___', ">>>>>>>>>>>>>> TakeAllItems " + allItems.Size() );
	
	for(i=0; i<allItems.Size(); i+=1)
	{						
		if( inv.ItemHasTag(allItems[i], 'Lootable' ) 
		|| !inv.ItemHasTag(allItems[i], 'NoDrop') && !inv.ItemHasTag(allItems[i], theGame.params.TAG_DONT_SHOW)
		)
		{
			if (
			ACS_FilterCheck(inv, allItems[i])
			)
			{
				allItems.Erase( i );
			}
			else
			{
				inv.NotifyItemLooted( allItems[ i ] );
				
				if( inv.ItemHasTag(allItems[i], 'HerbGameplay') )
				{
					category = 'herb';
				}
				else
				{
					category = inv.GetItemCategory(allItems[i]);
				}
				
				if( itemsCategories.FindFirst( category ) == -1 )
				{
					itemsCategories.PushBack( category );
				}

				inv.GiveItemTo(targetInv, allItems[i], inv.GetItemQuantity(allItems[i]), true, false, true );
			}
		}
	}

	/*
	if (ACS_Settings_Main_Bool('acs_container_settings','acs_extended_remains_looting_anim_enabled', false)
	&& FactsQuerySum("ACS_Player_Extended_Remains_Looting_Start") <= 0
	&& theInput.GetActionValue('Take') > 0.1f
	)
	{

	}
	else
	{
	*/
		if (FactsQuerySum("ACS_Player_Remains_Looting_Start") > 0)
		{
			if (FactsQuerySum("ACS_Player_Looting_Sound_Singular") <= 0)
			{
				GetWitcherPlayer().SoundEvent("cmb_play_dismemberment_gore");

				GetWitcherPlayer().SoundEvent("monster_dettlaff_monster_vein_hit_blood");

				GetWitcherPlayer().SoundEvent("monster_dettlaff_monster_combat_geralt_hit_claws");

				FactsAdd("ACS_Player_Looting_Sound_Singular", 1, 1);
			}

			FactsRemove("ACS_Player_Remains_Looting_Start");
		}
		else
		{
			if (FactsQuerySum("ACS_Player_Looting_Sound_Singular") <= 0)
			{
				if( itemsCategories.Size() == 1 )
				{
					PlayItemEquipSound(itemsCategories[0]);
				}
				else
				{
					PlayItemEquipSound('generic');
				}

				FactsAdd("ACS_Player_Looting_Sound_Singular", 1, 1);
			}
		}
	//}
	
	LogChannel( 'ITEMS___', "<<<<<<<<<<<<<< TakeAllItems");
	
	InformClueStash();
}

function ACS_ContaineHasSpecialItem(cont : W3Container) : bool
{
	var allItems		: array< SItemUniqueId >;
	var i				: int;
	var contInv			: CInventoryComponent;
	
	if(!cont)
	{
		return false;
	}
		
	if(cont.HasQuestItem())
	{
		return true; 
	}
	
	contInv = cont.GetInventory();

	allItems = contInv.GetItemsByCategory('gwint');

	for ( i=0; i<allItems.Size(); i+=1 )
	{
		if(!contInv.ItemHasTag(allItems[i], theGame.params.TAG_DONT_SHOW)) 
		{
			return true;
		}
	}

	allItems = contInv.GetItemsByTag('ReadableItem'); 

	for ( i=0; i<allItems.Size(); i+=1 )
	{	
		if(!contInv.ItemHasTag(allItems[i], theGame.params.TAG_DONT_SHOW) && !contInv.IsBookRead(allItems[i])) 
		{
			return true;
		}
	}

	allItems = contInv.GetItemsByTag('Weapon');

	for ( i=0; i<allItems.Size(); i+=1 )
	{	
		//Item Quality: 4 = Relic, 5 = Witcher
		if(!contInv.ItemHasTag(allItems[i], theGame.params.TAG_DONT_SHOW) && contInv.GetItemQuality(allItems[i])>3 && !FactsDoesExist('modNoDuplicates'+NameToString(contInv.GetItemName(allItems[i])))) 
		{
			return true;
		}
	}

	allItems = contInv.GetItemsByTag('Armor');

	for ( i=0; i<allItems.Size(); i+=1 )
	{	
		//Item Quality: 4 = Relic, 5 = Witcher
		if(!contInv.ItemHasTag(allItems[i], theGame.params.TAG_DONT_SHOW) && contInv.GetItemQuality(allItems[i])>3 && !FactsDoesExist('modNoDuplicates'+NameToString(contInv.GetItemName(allItems[i])))) 
		{
			return true;
		}
	}
	
	allItems = contInv.GetItemsByTag('mod_horse');

	for ( i=0; i<allItems.Size(); i+=1 )
	{	
		if(!contInv.ItemHasTag(allItems[i], theGame.params.TAG_DONT_SHOW) && !FactsDoesExist('modNoDuplicates'+StrReplace(NameToString(contInv.GetItemName(allItems[i])),'_crafted',"")))
		{
			return true;
		}
	}
	
	return false;
}

@wrapMethod(W3Container) function OnInteraction( actionName : string, activator : CEntity )
{
	var template 						: CEntityTemplate;
	var ent_1, container_dupe           : CEntity;
	var rot             				: EulerAngles;
    var pos								: Vector;
	var interactionComponentFailsafe	: CInteractionComponent;
	var inventoryComponentFailsafe		: CInventoryComponent;
	var owner 							: CActor;
	var containerPos, playerPos 		: Vector;

	if ( activator == GetWitcherPlayer() 
	&& !isInteractionBlocked 
	&& !IsEmpty() 
	&& activator != (W3ReplacerCiri)thePlayer
	&& !((W3Herb)this)
	&& !((W3RefillableContainer)this)
	&& !((W3ActorRemains)this)
	//|| ACS_Settings_Main_Bool('acs_container_settings','acs_skip_container_popup_enabled', false)
	&& actionName == "Container"
	&& ((RandF() < ACS_AdditionalWorldEncountersSpawnChance('acs_mimic_encounter_enabled',0.05)) || theGame.envMgr.IsRedMoon())
	&& ACS_Settings_Main_Bool('acs_hud_settings_markers','acs_3D_loot_popups_enabled', true)
	&& !ACS_Settings_Main_Bool('acs_container_settings','acs_skip_container_popup_enabled', false)
	&& VecDistanceSquared2D(GetWorldPosition(), ACSGetCEntity('ACS_Guiding_Light_POI_Marker').GetWorldPosition()) > 35 * 35
	&& GetWitcherPlayer().IsActionAllowed( EIAB_OpenInventory )
	&& GetWitcherPlayer().IsActionAllowed(EIAB_SwordAttack)
	&& GetWitcherPlayer().IsActionAllowed(EIAB_Movement)
	&& GetWitcherPlayer().IsActionAllowed(EIAB_Fists)
	&& GetWitcherPlayer()
	&& !ACS_Player_Near_Quest_Marker()
	&& !ACS_ContaineHasSpecialItem(this)
	&& !thePlayer.IsInGameplayScene()
	&& !thePlayer.IsDiving()
	&& !thePlayer.IsSwimming()
	)
	{
		template = (CEntityTemplate)LoadResource("dlc\dlc_acs\data\entities\monsters\acs_loot_mimc.w2ent", true);

		rot = thePlayer.GetWorldRotation();

		rot.Yaw -= 180;

		pos = this.GetWorldPosition();

		pos.Z += 0.125;

		ent_1 = theGame.CreateEntity( template, TraceFloor(pos), rot );

		ent_1.AddTag('ACS_Custom_Monster');

		container_dupe = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource(this.GetReadableName(), true ), this.GetWorldPosition(), this.GetWorldRotation() );

		container_dupe.CreateAttachment(ent_1, 'attach_slot', Vector(0,0,0), EulerAngles(0,90,0));

		((W3Container)(container_dupe)).GetInventory().RemoveAllItems();

		((W3ActorRemains)(container_dupe)).GetInventory().RemoveAllItems();

		((W3AnimatedContainer)(container_dupe)).GetInventory().RemoveAllItems();

		((W3RefillableContainer)(container_dupe)).GetInventory().RemoveAllItems();

		interactionComponentFailsafe = (CInteractionComponent)container_dupe.GetComponentByClassName( 'CInteractionComponent' );
		interactionComponentFailsafe.SetEnabled(false);

		inventoryComponentFailsafe = (CInventoryComponent)container_dupe.GetComponentByClassName( 'CInventoryComponent' );
		inventoryComponentFailsafe.SetEnabled(false);

		this.GetInventory().GiveAllItemsTo(((CActor)ent_1).GetInventory(), true, false);

		this.CreateAttachment(ent_1,, Vector(0,0,-200));

		//this.Teleport(this.GetWorldPosition() + Vector(0,0,-200));
	}
	else
	{
		owner = ( ( W3ActorRemains )this ).GetOwner();	

		containerPos = this.GetWorldPosition();

		playerPos = thePlayer.GetWorldPosition();

		if ( activator == thePlayer 
		&& !isInteractionBlocked 
		&& !IsEmpty() 
		&& activator != (W3ReplacerCiri)thePlayer
		&& ((W3ActorRemains)this)
		&& (!((W3ActorRemains)this).HasTrophyItems() || owner.HasTag('RandomEncountersReworked_Entity'))
		&& (owner.IsMonster() || owner.IsAnimal())
		&& !owner.IsHuman()
		&& !this.HasTag('lootbag')
		&& containerPos.Z <= playerPos.Z + 1.25
		&& (!HasQuestItem() || owner.HasTag('RandomEncountersReworked_Entity'))
		&& !thePlayer.IsUsingHorse()
		&& !thePlayer.IsUsingVehicle()
		)
		{
			if ( thePlayer.inv.IsItemCrossbow( thePlayer.inv.GetItemFromSlot( 'l_weapon' ) ) )
			{
				thePlayer.OnRangedForceHolster(false, true, false);
			}

			if (!thePlayer.IsUsingHorse()
			&& !thePlayer.IsUsingVehicle()
			)
			{
				if (ACS_Settings_Main_Bool('acs_container_settings','acs_extended_remains_looting_anim_enabled', false)
				&& FactsQuerySum("ACS_Player_Extended_Remains_Looting_Start") <= 0
				&& theInput.GetActionValue('Take') > 0.1f
				)
				{
					GetACSWatcher().RemoveTimer('Gerry_Take_Trophy_Scene');

					GetACSWatcher().AddTimer('Gerry_Take_Trophy_Scene', 0.25f , false );
				}
			
				if( FactsQuerySum("ACS_Player_Remains_Looting_Start") <= 0)
				{
					FactsAdd("ACS_Player_Remains_Looting_Start", 1, -1);

					GetACSWatcher().RemoveTimer('remains_looting_remove_fact');
					GetACSWatcher().AddTimer('remains_looting_remove_fact', 1 , false );
				}
			}
		}

		wrappedMethod(actionName, activator);
	}
}


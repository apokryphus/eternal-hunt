			vfxEnt.PlayEffectSingle('blood_explode_green');

			vfxEnt.PlayEffectSingle('blood_spatter_green');
		}
	}
	else if( this.GetBloodType() == BT_Yellow) 
	{
		if (HasAbility('mon_archespor_base'))
		{
			vfxEnt.PlayEffectSingle('blood_explode_yellow');

			vfxEnt.PlayEffectSingle('blood_spatter_yellow');
		} 
		else 
		{
			vfxEnt.PlayEffectSingle('blood_explode_red');

			vfxEnt.PlayEffectSingle('blood_spatter_red');
		}
	}
	else if	( this.GetBloodType() == BT_Black) 
	{
		if ( mc == MC_Vampire ) 
		{
			vfxEnt.PlayEffectSingle('blood_explode_red');

			vfxEnt.PlayEffectSingle('blood_spatter_red');
		}
		else if ( mc == MC_Magicals ) 
		{
			if (HasAbility('mon_golem_base')
			|| HasAbility('mon_djinn')
			|| HasAbility('mon_gargoyle')
			)
			{
				vfxEnt.PlayEffectSingle('blood_explode_black');

				vfxEnt.PlayEffectSingle('blood_spatter_black');
			}
			else
			{
				vfxEnt.PlayEffectSingle('blood_explode_red');

				vfxEnt.PlayEffectSingle('blood_spatter_red');
			}
		}
		else
		{
			vfxEnt.PlayEffectSingle('blood_explode_black');

			vfxEnt.PlayEffectSingle('blood_spatter_black');
		}
	}
}

@addMethod( CNewNPC ) timer function ACS_Counter_Wound_Remove( dt : float, id : int )
{
	if(this.HasTag('ACS_Counter_Wound_Ready')
	)
	{
		this.RemoveTag('ACS_Counter_Wound_Ready');

		GetACSStorage().acs_deleteOnelinerByTag("ACS_Counter_Wound_Indicator");

		acs_wound_fx.Destroy();
	}
}


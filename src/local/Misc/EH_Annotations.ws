		if ((ACS_Armor_Set_Check('forgotten_wolf', false) 
		|| ACS_Armor_Set_Check('acs_armor', false)
		|| ACS_Armor_Set_Check('volhikar', false)
		|| thePlayer.HasTag('acs_vampire_claws_equipped')
		|| ACS_Vampire_Claws_Access())
		&& ACS_Settings_Main_Bool('acs_signs_settings','acs_yrden_extra_effects_enabled', true)
		)
		{
			ent_2.PlayEffectSingle('yrden_icon_red');

			GetACSWatcher().Red_Yrden_Slow();
		}
		else
		{
			ent_2.PlayEffectSingle('yrden_icon');
		}

		ent_2.PlayEffectSingle('critical_yrden');

		ent.DestroyAfter(2);
		ent_2.DestroyAfter(2);

		ent.AddTag('ACS_Sign_Icon_Anchor');

		ent_2.AddTag('ACS_Sign_Icon');
	}
}

/////////////////////////////// NPC START

@wrapMethod( CNewNPC ) function OnSpawned( spawnData : SEntitySpawnData )
{
	var mCategory									: EMonsterCategory;
	var tmpName										: name;
	var tmpBool										: bool;
	var mName										: string;
	var i, j 										: int;
	var drawableComponents 							: array < CComponent >;
	var drawableComponent 							: CDrawableComponent;

	wrappedMethod(spawnData);

	if (this == thePlayer
	|| this.IsHorse()
	)
	{
		return false;
	}

	AddTimer('ACS_Calculate_Posture', 0.1 , false);

	if(this.HasTag('ACS_Dullahan'))
	{
		return false;
	}

	if (this == thePlayer.GetHorseWithInventory())
	{
		this.TeleportWithRotation(this.GetWorldPosition(), EulerAngles(0,0,0));
	}

	if (HasTag('ice_troll')
	|| GetSfxTag() == 'sfx_troll_cave'
	|| HasAbility('mon_arachas_base')
	|| HasAbility('mon_poison_arachas')
	|| GetSfxTag() == 'sfx_arachas')
	{
		AddTag('ACS_Big_Boi');
	}

	if (
	GetNPCType() == ENGT_Commoner
	|| IsAnimal()
	)
	{
		SetIsUsingTooltip(false);
	}

	AddTimer('ACS_NPC_Collision_Manager', 0.01, true);

	AddTimer('ACS_Ice_Breath_Controller_Check', RandRangeF(4,2) , true);

	AddTimer('ACS_Sneaking_Controller', 0.01 , true);

	if(StrContains( this.GetReadableName(), "community_npc" ))
	{
		return false;
	}

	if(StrContains( this.GetReadableName(), "mq7007" ))
	{
		SetTatgetableByPlayer(true);
	}

	if (this.IsMonster())
	{
		SetInteractionPriority( IP_Max_Unpushable );
	}

	if (RandF() < 0.5)
	{
		if (!HasAbility('IsNotScaredOfMonsters'))
		{
			AddAbility('IsNotScaredOfMonsters');
		}
	}

	if (this.IsHuman())
	{
		if (!HasAbility('DisableCounterAttack'))
		{
			AddAbility('DisableCounterAttack');
		}
	}

	if (HasAbility('ReflectOnBeingParried'))
	{
		RemoveAbility('ReflectOnBeingParried');
	}

	if (!HasTag('dettlaff_construct'))
	{
		if (!HasAbility('ResistFinisher'))
		{
			AddAbility('ResistFinisher');
		}
	}

	AddTimer('ACS_Animal_Controller', 0.5 , true);

	AddTimer('ACS_Werewolf_Spawn_Adds', 0.5 , true);

	AddTimer('ACS_Vendigo_Spawn_Adds', 0.5 , true);

	AddTimer('ACS_NPC_Idle_Action', 0.75f , false);
	
	AddTimer('ACS_DelayedWolfAttitudeSet', 0.1 , false);

	AddTimer('ACS_Crawl_Controller_Delay_Spawn', 0.1 , false);

	if ( this.HasAbility('mh106_HAG') 
	) 
	{
		if (!thePlayer.inv.HasItem('ACS_Mourntart_Steel')
		&& !GetWitcherPlayer().GetHorseManager().GetInventoryComponent().HasItem( 'ACS_Mourntart_Steel' )
		)
		{
			this.GetInventory().AddAnItem( 'ACS_Mourntart_Steel', 1 );
		}

		if (!thePlayer.inv.HasItem('ACS_Mourntart_Silver')
		&& !GetWitcherPlayer().GetHorseManager().GetInventoryComponent().HasItem( 'ACS_Mourntart_Silver' )
		)
		{
			this.GetInventory().AddAnItem( 'ACS_Mourntart_Silver', 1 );
		}
	}

	if ( this.HasAbility('mon_gravehag') 
	) 
	{
		if (RandF () < 0.33)
		{
			if (RandF () < 0.5)
			{
				if (!thePlayer.inv.HasItem('ACS_Gravehag_Tongue_Steel')
				&& !GetWitcherPlayer().GetHorseManager().GetInventoryComponent().HasItem( 'ACS_Gravehag_Tongue_Steel' )
				)
				{
					this.GetInventory().AddAnItem( 'ACS_Gravehag_Tongue_Steel', 1 );
				}
			}
			else
			{
				if (!thePlayer.inv.HasItem('ACS_Gravehag_Tongue_Silver')
				&& !GetWitcherPlayer().GetHorseManager().GetInventoryComponent().HasItem( 'ACS_Gravehag_Tongue_Silver' )
				)
				{
					this.GetInventory().AddAnItem( 'ACS_Gravehag_Tongue_Silver', 1 );
				}
			}
		}
	}

	if (StrContains( this.GetReadableName(), "stjepan_innkeeper" )
	)
	{
		AddTimer('ACS_mh304_sjepan_tox_fix', 0.1 , true);
	}

	AddTimer('ACS_DelayStateInit', 2 , false);

	mName = GetReadableName(); 
	theGame.GetMonsterParamsForActor(this, mCategory, tmpName, tmpBool, tmpBool, tmpBool);

	if ( mCategory == MC_Specter 
	||  mCategory == MC_Vampire 
	|| StrContains(mName, "ghost") 
	|| StrContains(mName, "wraith") 
	|| StrContains(mName, "barghest") 
	|| StrContains(mName, "vampire")
	|| StrContains(mName, "katakan")
	|| StrContains(mName, "ekimma")
	|| StrContains(mName, "ekkima")
	|| StrContains(mName, "bruxa") 
	|| StrContains(mName, "alp") 
	|| StrContains(mName, "fleder") 
	|| StrContains(mName, "garkain")
	|| StrContains(mName, "gravier") 
	|| StrContains(mName, "graveir") 
	|| StrContains(mName, "coroner")
	|| StrContains(mName, "dettlaff") 
	|| StrContains(mName, "detlaf") 
	|| StrContains(mName, "regis")
	|| StrContains(mName, "oriana") 
	|| StrContains(mName, "cloak") 
	)
	{
		SetGroupShadows( false );

		drawableComponents =  GetComponentsByClassName ( 'CDrawableComponent' );
			
		for ( i = 0; i < drawableComponents.Size(); i+=1 )
		{
			drawableComponent = ( CDrawableComponent)drawableComponents[i];
			drawableComponent.SetCastingShadows ( false );
		}
	}
}

@addMethod( CNewNPC ) timer function ACS_NpcResetAnimation( dt : float, id : int )
{
	ACS_ClearAnimationSpeedMultipliers();
}

@addMethod( CNewNPC ) timer function ACS_NPC_Collision_Manager( dt : float, id : int )
{
	var npc								: CNewNPC;
	var mac								: CMovingPhysicalAgentComponent;
	var collidedWithRider 				: bool;
	var collisionData 					: SCollisionData;
	var collisionNum 					: int;
	var i 								: int;
	var params 							: SCustomEffectParams;
	var dmg								: W3DamageAction;

	mac	= (CMovingPhysicalAgentComponent)this.GetMovingAgentComponent();

	if( !thePlayer.IsInCombat()
	&& !thePlayer.IsThreatened()
	)
	{
		return;
	}

	if( !mac 
	|| IsUsingHorse()
	|| IsUsingVehicle()
	|| GetAttitude( thePlayer ) != AIA_Hostile
	|| IsHorse()
	)
	{
		return;
	}

	if (HasBuff(EET_Knockdown)
	|| HasBuff(EET_KnockdownTypeApplicator)
	|| HasBuff(EET_HeavyKnockdown)
	|| HasBuff(EET_Ragdoll)
	|| HasBuff(EET_Stagger)
	|| HasBuff(EET_LongStagger)
	|| HasBuff(EET_Burning)
	|| HasBuff(EET_Poison)
	|| HasBuff(EET_Swarm)
	|| HasBuff(EET_Paralyzed)
	|| IsInHitAnim()
	|| HasTag('ACS_man_finisher_dlc_arm_rp')
	|| HasTag('ACS_man_finisher_dlc_arm_lp')
	)
	{
		collisionNum = mac.GetCollisionCharacterDataCount();

		if (collisionNum > 0)
		{
			for( i = 0; i < collisionNum; i += 1 )
			{
				collisionData	= mac.GetCollisionCharacterData( i );

				npc	= ( CNewNPC ) collisionData.entity;

				if( npc 
				&& npc.GetAttitude( thePlayer ) == AIA_Hostile 
				) 
				{
					if (IsInHitAnim()
					&& !npc.IsInHitAnim()
					&& !HasBuff(EET_Knockdown)
					&& !HasBuff(EET_KnockdownTypeApplicator)
					&& !HasBuff(EET_HeavyKnockdown)
					&& !HasBuff(EET_Ragdoll)
					&& !HasBuff(EET_Stagger)
					&& !HasBuff(EET_LongStagger)
					&& !HasBuff(EET_Burning)
					&& !HasBuff(EET_Poison)
					&& !HasBuff(EET_Swarm)
					&& !HasBuff(EET_Paralyzed)
					)
					{
						dmg = new W3DamageAction in theGame.damageMgr;

						dmg.Initialize(thePlayer, npc, NULL, thePlayer.GetName(), EHRT_Light, CPS_Undefined, false, false, true, false);

						dmg.SetIgnoreImmortalityMode(false);

						dmg.SetHitReactionType( EHRT_Light, true);

						dmg.SetHitAnimationPlayType(EAHA_ForceYes);

						dmg.SetCanPlayHitParticle(false);

						dmg.SetSuppressHitSounds(true);
						
						theGame.damageMgr.ProcessAction( dmg );
					}
					else
					{
						if (HasBuff(EET_Knockdown)
						&& !npc.IsImmuneToBuff(EET_Knockdown)
						&& !npc.HasBuff(EET_Knockdown)
						)
						{
							params.effectType = EET_Knockdown;
						}
						else if (HasBuff(EET_KnockdownTypeApplicator)
						&& !npc.IsImmuneToBuff(EET_KnockdownTypeApplicator)
						&& !npc.HasBuff(EET_KnockdownTypeApplicator)
						)
						{
							params.effectType = EET_KnockdownTypeApplicator;
						}
						else if (HasBuff(EET_HeavyKnockdown)
						&& !npc.IsImmuneToBuff(EET_HeavyKnockdown)
						&& !npc.HasBuff(EET_HeavyKnockdown)
						)
						{
							params.effectType = EET_HeavyKnockdown;
						}
						else if (HasBuff(EET_Ragdoll)
						&& !npc.IsImmuneToBuff(EET_Ragdoll)
						&& !npc.HasBuff(EET_Ragdoll)
						)
						{
							params.effectType = EET_Ragdoll;
						}
						else if (HasBuff(EET_Stagger)
						&& !npc.IsImmuneToBuff(EET_Stagger)
						&& !npc.HasBuff(EET_Stagger)
						)
						{
							params.effectType = EET_Stagger;
						}
						else if (HasBuff(EET_LongStagger)
						&& !npc.IsImmuneToBuff(EET_LongStagger)
						&& !npc.HasBuff(EET_LongStagger)
						)
						{
							params.effectType = EET_LongStagger;
						}
						else if (HasBuff(EET_Burning)
						&& !npc.IsImmuneToBuff(EET_Burning)
						&& !npc.HasBuff(EET_Burning)
						)
						{
							params.effectType = EET_Burning;
						}
						else if (HasBuff(EET_Poison)
						&& !npc.IsImmuneToBuff(EET_Poison)
						&& !npc.HasBuff(EET_Poison)
						)
						{
							params.effectType = EET_Poison;
						}
						else if (HasBuff(EET_Swarm)
						&& !npc.IsImmuneToBuff(EET_Swarm)
						&& !npc.HasBuff(EET_Swarm)
						)
						{
							params.effectType = EET_Swarm;
						}
						else if (HasBuff(EET_Paralyzed)
						&& !npc.IsImmuneToBuff(EET_Paralyzed)
						&& !npc.HasBuff(EET_Paralyzed)
						)
						{
							params.effectType = EET_Paralyzed;
						}

						params.creator = thePlayer;
						params.sourceName = "ACS_Debuff_Chain";
						params.duration = 1;

						npc.AddEffectCustom( params );	
					}
				}
			}
		}
	}
}


@addMethod( CNewNPC ) timer function ACS_mh304_sjepan_tox_fix( dt : float, id : int )
{
	if (FactsQuerySum("mh304_done") > 0
	|| FactsQuerySum("mh304_job_taken") <= 0
	)
	{
		RemoveTimer('ACS_mh304_sjepan_tox_fix');

		return;
	}

	if (FactsQuerySum("mh304_job_taken") > 0
	&& FactsQuerySum("mh304_done") <= 0
	)
	{
		if ( VecDistanceSquared2D( this.GetWorldPosition(), thePlayer.GetWorldPosition() ) <= 5 * 5)
		{
			if(thePlayer.GetStat(BCS_Toxicity) > 0 )
			{
				GetACSWatcher().ACS_RemovePotionEffects();
			}
		}
	}
}

@addMethod( CNewNPC ) timer function ACS_MountedAttackAttachmentWatcher( dt : float, id : int )
{
	var ent       												: CACSMountedAttackAttachment;
	var anchor													: CEntity;
	var bonePosition, attach_vec								: Vector;
	var boneRotation, attach_rot								: EulerAngles;
	var movementAdjustor										: CMovementAdjustor;

	if (
	!this.IsAlive()
	|| !this.HasTag('ACS_NPC_Ready_For_Mounted_Attack_Attachment')
	)
	{
		if (anchor)
		{
			anchor.Destroy();
		}

		if (ent)
		{
			ent.Destroy();
		}
		
		return;
	}

	if (
	this.HasTag('ACS_NPC_Ready_For_Mounted_Attack_Attachment')
	)
	{
		if (thePlayer.GetStat(BCS_Focus) < thePlayer.GetStatMax( BCS_Focus ) * 0.9875)
		{
			if (anchor)
			{
				anchor.Destroy();
			}

			if (ent)
			{
				ent.Destroy();
			}

			this.RemoveTag('ACS_NPC_Ready_For_Mounted_Attack_Attachment');

			return;
		}
	}

	if (!ent
	&& !ACSGetMountedAttackAttachment('ACS_MountedAttackAttachmentActive')
	&& thePlayer.GetStat(BCS_Focus) >= thePlayer.GetStatMax( BCS_Focus ) * 0.9875
	)
	{
		ACSGetCEntity('ACS_MountedAttackAttachmentAnchor').Destroy();

		ACSGetCActor('ACS_MountedAttackTarget').RemoveTag('ACS_MountedAttackTarget');

		this.AddTag('ACS_MountedAttackTarget');

		ent = (CACSMountedAttackAttachment)theGame.CreateEntity( (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\entities\other\acs_mounted_attack_attachment.w2ent", true ), this.GetWorldPosition(), this.GetWorldRotation() );

		anchor = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResource(  "dlc\dlc_acs\data\entities\other\fx_ent.w2ent", true ), this.GetWorldPosition(), this.GetWorldRotation() );

		anchor.AddTag('ACS_MountedAttackAttachmentAnchor');
	}

	movementAdjustor = this.GetMovingAgentComponent().GetMovementAdjustor();
		
	movementAdjustor.CancelAll();

	anchor.BreakAttachment();

	if ( this.GetBoneIndex('pelvis') != -1 )
	{
		this.GetBoneWorldPositionAndRotationByIndex( this.GetBoneIndex( 'pelvis' ), bonePosition, boneRotation );

		anchor.CreateAttachmentAtBoneWS(this, 'pelvis', bonePosition, boneRotation);
	}
	else
	{
		if ( this.GetBoneIndex('k_pelvis_g') != -1 )
		{
			this.GetBoneWorldPositionAndRotationByIndex( this.GetBoneIndex( 'k_pelvis_g' ), bonePosition, boneRotation );

			anchor.CreateAttachmentAtBoneWS(this, 'k_pelvis_g', bonePosition, boneRotation);
		}
		else
		{
			anchor.CreateAttachment(this, , Vector(0,0,2), this.GetWorldRotation());
		}
	}

	ent.BreakAttachment();

	if 
	(
		GetSfxTag() == 'sfx_gryphon'
		|| HasAbility('mon_basilisk')
		|| GetSfxTag() == 'sfx_cockatrice'
		|| HasAbility('mon_mq7018_basilisk')
	)
	{
		attach_rot.Roll = 90;
		attach_rot.Pitch = 0;
		attach_rot.Yaw = -60;

		attach_vec.X = -0.625; // -back +forward 
		attach_vec.Y = 0.875; // -up +down
		attach_vec.Z = 0.0; // -right +left
	}
	else if 
	(
		HasAbility('mon_czart')
		|| GetSfxTag() == 'sfx_bies'
	)
	{
		attach_rot.Roll = 90;
		attach_rot.Pitch = 0;
		attach_rot.Yaw = 45;

		attach_vec.X = -0.25; // -forward +back 
		attach_vec.Y = -0.5; // -up +down
		attach_vec.Z = 0.0; // -right +left
	}
	else if 
	(
		HasAbility('mon_bear_base')
		|| GetSfxTag() == 'sfx_bear'
	)
	{
		attach_rot.Roll = -90;
		attach_rot.Pitch = 0;
		attach_rot.Yaw = -110;

		attach_vec.X = 0.0; // -back +forward 
		attach_vec.Y = -0.75; // -up +down
		attach_vec.Z = 0.0; // -right +left
	}
	else if 
	(
		HasTag('ice_troll')
		|| GetSfxTag() == 'sfx_troll_cave'
	)
	{
		attach_rot.Roll = -90;
		attach_rot.Pitch = 0;
		attach_rot.Yaw = 110;

		attach_vec.X = 0.325; // -back +forward 
		attach_vec.Y = 0.625; // -up +down
		attach_vec.Z = 0.0; // -right +left
	}
	else if 
	(
		GetSfxTag() == 'sfx_ice_giant'
		|| HasAbility('mon_cyclops')
	)
	{
		attach_rot.Roll = -90;
		attach_rot.Pitch = 0;
		attach_rot.Yaw = 110;

		attach_vec.X = 0; // -back +forward 
		attach_vec.Y = 0; // -up +down
		attach_vec.Z = 0.0; // -right +left
	}
	else if 
	(
		HasAbility('mon_knight_giant')
		|| HasAbility('mon_cloud_giant')
	)
	{
		attach_rot.Roll = -90;
		attach_rot.Pitch = 0;
		attach_rot.Yaw = 110;

		attach_vec.X = 0; // -back +forward 
		attach_vec.Y = 0; // -up +down
		attach_vec.Z = 0.0; // -right +left
	}
	else if 
	(
		HasAbility('mon_gargoyle')
		|| GetSfxTag() == 'sfx_fugas'
	)
	{
		attach_rot.Roll = -90;
		attach_rot.Pitch = 0;
		attach_rot.Yaw = 157.5;

		attach_vec.X = -0.5; // -back +forward 
		attach_vec.Y = 0.5; // -up +down
		attach_vec.Z = 0.0; // -right +left
	}
	else if 
	(
		GetSfxTag() == 'sfx_golem'
		|| GetSfxTag() == 'sfx_elemental_ifryt'
		|| HasAbility('mon_ice_golem')
	)
	{
		attach_rot.Roll = 90;
		attach_rot.Pitch = 0;
		attach_rot.Yaw = -22.5;

		attach_vec.X = -0.75; // -back +forward 
		attach_vec.Y = 0.125; // -up +down
		attach_vec.Z = 0.0; // -right +left
	}
	else if 
	(
		HasAbility('mon_forktail')
		|| HasAbility('mon_forktail_mh')
		|| GetSfxTag() == 'sfx_wyvern'
		|| HasAbility('mon_mq7010_dracolizard')
		|| HasAbility('mon_draco_base')
	)
	{
		attach_rot.Roll = 90;
		attach_rot.Pitch = 0;
		attach_rot.Yaw = -60;

		attach_vec.X = -0.625; // -back +forward 
		attach_vec.Y = 0.875; // -up +down
		attach_vec.Z = 0.0; // -right +left
	}
	else if 
	(
		HasAbility('mon_arachas_base')
		|| HasAbility('mon_poison_arachas')
		|| GetSfxTag() == 'sfx_arachas'
	)
	{
		attach_rot.Roll = 0;
		attach_rot.Pitch = 30;
		attach_rot.Yaw = 90;

		attach_vec.X = 0.25; // -back +forward 
		attach_vec.Y = 0.0; 
		attach_vec.Z = -0.75; // -down +up
	}

	else if 
	(
		HasAbility('mon_endriaga_worker')
		|| HasAbility('mon_endriaga_soldier_tailed')
		|| GetSfxTag() == 'sfx_endriaga'
	)
	{
		attach_rot.Roll = 0;
		attach_rot.Pitch = 0;
		attach_rot.Yaw = 90;

		attach_vec.X = 0.75; // -back +forward 
		attach_vec.Y = 0.0; 
		attach_vec.Z = -1; // -down +up
	}
	else
	{
		attach_rot.Roll = 90;
		attach_rot.Pitch = 0;
		attach_rot.Yaw = -60;

		attach_vec.X = 0.0; // -back +forward 
		attach_vec.Y = 0.0; // -up +down
		attach_vec.Z = 0.0; // -right +left
	}

	ent.CreateAttachment(anchor, , attach_vec, attach_rot);
}

@addMethod( CNewNPC ) timer function ACS_DelayStateInit( dt : float, id : int )
{
	var bone_vec																											: Vector;
	var bone_rot																											: EulerAngles;
	var anchor_temp																											: CEntityTemplate;

	if 
	(
		// griffin base
		(
		GetSfxTag() == 'sfx_gryphon'
		|| HasAbility('mon_basilisk')
		|| GetSfxTag() == 'sfx_cockatrice'
		|| HasAbility('mon_mq7018_basilisk')

		// fiend base
		|| HasAbility('mon_czart')
		|| GetSfxTag() == 'sfx_bies'
		
		//bear base
		|| HasAbility('mon_bear_base')
		|| GetSfxTag() == 'sfx_bear'
		
		//troll base
		|| HasTag('ice_troll')
		|| GetSfxTag() == 'sfx_troll_cave'

		//giant base
		|| GetSfxTag() == 'sfx_ice_giant'
		|| HasAbility('mon_cyclops')
		|| HasAbility('mon_knight_giant')
		|| HasAbility('mon_cloud_giant')
		
		//gargoyle base
		|| HasAbility('mon_gargoyle')
		|| GetSfxTag() == 'sfx_fugas'
		
		//golem base
		|| GetSfxTag() == 'sfx_golem'
		|| GetSfxTag() == 'sfx_elemental_ifryt'
		|| HasAbility('mon_ice_golem')

		//wyvern base
		|| HasAbility('mon_forktail')
		|| HasAbility('mon_forktail_mh')
		|| GetSfxTag() == 'sfx_wyvern'
		|| HasAbility('mon_mq7010_dracolizard')
		|| HasAbility('mon_draco_base')

		//arachas base
		|| HasAbility('mon_arachas_base')
		|| HasAbility('mon_poison_arachas')
		|| GetSfxTag() == 'sfx_arachas'

		//endriaga base
		|| HasAbility('mon_endriaga_worker')
		|| HasAbility('mon_endriaga_soldier_tailed')
		|| GetSfxTag() == 'sfx_endriaga'
		)
		&& !HasTag('ACS_Custom_Monster')
	)
	{
		AddTimer('ACS_MountedAttackAttachmentWatcher', 0.1 , true);
	}

	if 
	(
		// griffin base
		(
		GetSfxTag() == 'sfx_gryphon'
		|| HasAbility('mon_basilisk')
		|| GetSfxTag() == 'sfx_cockatrice'
		|| HasAbility('mon_mq7018_basilisk')
		)
	)
	{
		AddTimer('ACS_Gryphon_Abduction_Running', 0.1, true);
	}

	if (
	IsAnimal()
	&& !HasTag('ACS_Talking_Animal')
	&& !HasTag('ACS_Guiding_Wind_Ent')
	&& !HasTag('ACS_Guiding_Wind_Ent_Secondary')
	&& !IsHorse()
	)
	{
		this.PushState('ACS_TalkingAnimalsControl');
	}

	if (
	HasAbility('mon_ghoul_base')
	&& !HasTag('ACS_Stryzga')
	)
	{
		this.PushState('ACS_GhoulVenomState');
	}

	if (
	HasAbility('mon_lessog_base')
	|| HasAbility('mon_sprigan_base')
	|| GetSfxTag() == 'sfx_lessog'
	)
	{
		this.PushState('ACS_LeshenCrowSummonState');
	}

	if (
	IsHuman()
	&& IsMan()
	)
	{
		this.PushState('ACS_HumanThrowBombState');
	}

	if (
	HasAbility('mon_drowner_base')
	&& !HasTag('ACS_Necrofiend_Adds')
	&& !HasTag('ACS_Bullvore_Adds')
	&& !HasTag('ACS_Necrofiend')
	)
	{
		this.PushState('ACS_DrownerTentacleState');
	}

	if(this.HasTag('novigrad_underground_vampire'))
	{
		this.PushState('ACS_KatakanSummonState');
	}
}

/////////////////////////////////////////////////////////////////////////////////////////////////

@addMethod( CNewNPC ) timer function ACS_Gryphon_Abduction_Running( deltaTime : float , id : int)	
{
	var actor																				: CActor; 
	var actors		    																	: array<CActor>;
	var i 																					: int;

	var has_abducted_victim 																: bool;

	var abduction_victim 																	: CActor;

	var secondary_target																	: CActor;

	if (thePlayer.IsCiri()
	|| thePlayer.IsInCutsceneIntro()
	|| theGame.IsDialogOrCutscenePlaying() 
	|| theGame.GetPhotomodeEnabled() 
	|| theGame.IsFading()
	|| theGame.IsBlackscreen()
	)
	{
		return;
	}
	
	if (has_abducted_victim)
	{
		if (((CActor)this).acs_gryphon_abduction_process)
		{
			actors.Clear();

			actors = this.GetNPCsAndPlayersInRange( 100, 20, , FLAG_OnlyAliveActors);

			if( actors.Size() > 0 )
			{
				for( i = 0; i < actors.Size(); i += 1 )
				{
					if (!actors[i].IsOnGround()
					|| ((CNewNPC)actors[i]).IsInInterior()
					|| actors[i].IsAnimal()
					)
					{
						continue;	
					}

					this.SignalGameplayEventParamObject( 'ForceTarget', actors[i] );
				}
			}

			((CAnimatedComponent)((CNewNPC)this).GetComponentByClassName( 'CAnimatedComponent' )).RaiseBehaviorForceEvent('Land');

			has_abducted_victim = false;
		}
	}
	else if (!has_abducted_victim)
	{
		if (this.IsFlying()
		&& !((CActor)this).acs_gryphon_abduction_process
		&& this.GetHealth() <= this.GetMaxHealth() * 0.75
		)
		{
			actors.Clear();

			actors = this.GetNPCsAndPlayersInRange( 100, 20, , FLAG_ExcludePlayer + FLAG_OnlyAliveActors);

			if( actors.Size() > 0 )
			{
				for( i = 0; i < actors.Size(); i += 1 )
				{
					if (!actors[i].IsOnGround()
					|| ((CNewNPC)actors[i]).IsInInterior()
					|| !actors[i].IsAnimal()
					)
					{
						continue;	
					}

					if (actors[i].HasTag('cow')
					|| StrContains( actors[i].GetReadableName(), "deer" )
					|| StrContains( actors[i].GetReadableName(), "pig" )
					|| StrContains( actors[i].GetReadableName(), "sheep" )
					|| StrContains( actors[i].GetReadableName(), "ram" )
					|| StrContains( actors[i].GetReadableName(), "goat" )
					|| StrContains( actors[i].GetReadableName(), "dog" )
					)
					{
						abduction_victim = actors[i];

						this.SignalGameplayEventParamObject( 'ForceTarget', abduction_victim );

						has_abducted_victim = true;
					}
				}
			}
		}
	}
}

/////////////////////////////////////////////////////////////////////////////////////////////////

state ACS_KatakanSummonState in CNewNPC
{
	private var actors, victims																		: array<CActor>;
	private var i, ii 																				: int;
	private var npc 																				: CNewNPC;
	private var actor, actortarget 																	: CActor;
	private var proj_1, proj_2, proj_3	 															: DebuffProjectile;
	private var initpos, targetPosition																: Vector;
	private var movementAdjustor																	: CMovementAdjustor;
	private var ticket 																				: SMovementAdjustmentRequestTicket;
	private var targetDistance																		: float;
	private var ent, anchor  																		: CEntity;
	private var rot, attach_rot																		: EulerAngles;
   	private var pos, attach_vec																		: Vector;
	private var meshcomp																			: CComponent;
	private var animcomp 																			: CAnimatedComponent;
	private var h 																					: float;
	private var bone_vec																			: Vector;
	private var bone_rot																			: EulerAngles;
	private var temp, anchorTemplate																: CEntityTemplate;

	private var dmg																					: W3DamageAction;
	private var randAngle, randRange																: float;
	private var playerPos, spawnPos																	: Vector;
	
	event OnEnterState(prevStateName : name)
	{
		super.OnEnterState(prevStateName);

		ACS_Katakan_Summon_Start_Entry();
	}

	entry function ACS_Katakan_Summon_Start_Entry() 
	{
		while (true) 
		{
			ACS_Katakan_Summon_Start_LATENT();

      		SleepOneFrame();
    	}
	}

	entry function ACS_Katakan_Summon_Start_LATENT()
	{
		if (
		parent.IsAlive()
		&& parent.HasTag('novigrad_underground_vampire')
		&& !parent.ACS_IsInDimeritiumCloud()
		&& !thePlayer.HasTag('ACS_Is_Sneaking')
		)			
		{
			if (!ACSGetCActor('ACS_Summoned_Katakan') 
			|| !ACSGetCActor('ACS_Summoned_Katakan').IsAlive())
			{
				temp = (CEntityTemplate)LoadResourceAsync( 

				"characters\npc_entities\monsters\vampire_katakan_lvl1.w2ent"
				
				, true );

				playerPos = GetWitcherPlayer().GetWorldPosition() + GetWitcherPlayer().GetWorldForward() * 2.5;

				ent = theGame.CreateEntity( temp, playerPos, parent.GetWorldRotation() );

				animcomp = (CAnimatedComponent)ent.GetComponentByClassName('CAnimatedComponent');
				meshcomp = ent.GetComponentByClassName('CMeshComponent');
				h = 1;
				//animcomp.SetScale(Vector(h,h,h,1));
				//meshcomp.SetScale(Vector(h,h,h,1));

				((CActor)ent).ACS_SetAnimationSpeedMultiplier(0.75);

				((CNewNPC)ent).SetAttitude(GetWitcherPlayer(), AIA_Hostile);

				((CNewNPC)ent).SetAttitude(parent, AIA_Friendly);

				//((CNewNPC)ent).SetTemporaryAttitudeGroup( 'hostile_to_player', AGP_Default );

				ent.AddTag( 'ACS_Summoned_Katakan' );
			}

			parent.SetAttitude(ACSGetCActor('ACS_Katakan'), AIA_Friendly);

		}
	}
	
	event OnLeaveState( nextStateName : name ) 
	{
		super.OnLeaveState(nextStateName);
	}
}

state ACS_LeshenCrowSummonState in CNewNPC
{
	private var playerRot, adjustedRot																							: EulerAngles;
	private var markerNPC																										: CEntity;
	private var playerPos, spawnPos																								: Vector;
	private var i, markerCount																									: int;
	private var randRange, randAngle, dist																						: float;
	private var actortarget																										: CActor;
	private var actors    																										: array<CActor>;
	private var movementAdjustor																								: CMovementAdjustor;
	private var ticket																											: SMovementAdjustmentRequestTicket;
	private var bat_template_names																								: array< string >;
	private var crow_sound_activated																							: bool;
	private var targetDistance 																									: float;
	private var bat_projectile 																									: W3BatSwarmAttack;
	private var targetPosition																									: Vector;
	private var markerNPC_1																										: CEntity;

	event OnEnterState(prevStateName : name)
	{
		ACS_LeshenCrowSummonState_ENTRY();
	}

	entry function ACS_LeshenCrowSummonState_ENTRY() 
	{
		while (true) 
		{
			ACS_LeshenCrowSummonState_LATENT();

      		Sleep(0.5);
    	}
	}

	var last_projectile_time : float;
		
	latent function ACS_LeshenCrowSummonState_LATENT()
	{
		if (!parent.GetGameplayVisibility()
		|| !parent.IsAlive()
		)
		{
			parent.SoundEvent("animals_crow_swarm_end");

			if (crow_sound_activated)
			{
				crow_sound_activated = false;
			}

			return;
		}

		targetDistance = VecDistanceSquared2D( thePlayer.GetWorldPosition(), parent.GetWorldPosition() ) ;

		if (targetDistance <= 10 * 10)
		{
			thePlayer.AddEffectDefault( EET_Bleeding, parent, 'ACS_Leshen_Bleed' );
		}

		if (!crow_sound_activated)
		{
			parent.SoundEvent("animals_crow_swarm");
			crow_sound_activated = true;
		}

		playerPos = parent.GetWorldPosition();

		playerRot = parent.GetWorldRotation();

		adjustedRot = EulerAngles(0,0,0);
	
		markerCount = 2;

		for( i = 0; i < markerCount; i += 1 )
		{
			randRange = 3 + 3 * RandF();
			randAngle = 3 * Pi() * RandF();
			
			spawnPos.X = randRange * CosF( randAngle ) + playerPos.X;
			spawnPos.Y = randRange * SinF( randAngle ) + playerPos.Y;
			spawnPos.Z = playerPos.Z;
			spawnPos.Z += RandRangeF(3,1);

			adjustedRot.Yaw = RandRangeF(360,1);
			adjustedRot.Pitch = RandRangeF(45,-45);
			adjustedRot.Roll = RandRangeF(45,-45);

			bat_template_names.Clear();

			bat_template_names.PushBack("dlc\dlc_acs\data\fx\crow_swarm\crow_swarm_01.w2ent");
			bat_template_names.PushBack("dlc\dlc_acs\data\fx\crow_swarm\crow_swarm_02.w2ent");
			bat_template_names.PushBack("dlc\dlc_acs\data\fx\crow_swarm\crow_swarm_03.w2ent");
			bat_template_names.PushBack("dlc\dlc_acs\data\fx\crow_swarm\crow_swarm_04.w2ent");
			bat_template_names.PushBack("dlc\dlc_acs\data\fx\crow_swarm\crow_swarm_05.w2ent");
			bat_template_names.PushBack("dlc\dlc_acs\data\fx\crow_swarm\crow_swarm_06.w2ent");


			markerNPC = theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync( 

			bat_template_names[RandRange(bat_template_names.Size())]
			
			, true ), spawnPos, adjustedRot );

			markerNPC.PlayEffectSingle('crow_swarm');
			markerNPC.DestroyAfter(3);
			markerNPC.SoundEvent("animals_crow_swarm");

			if ( theGame.GetEngineTimeAsSeconds() - last_projectile_time > 3
			)
			{
				last_projectile_time = theGame.GetEngineTimeAsSeconds();

				if (targetDistance > 5 * 5 && targetDistance <= 30 * 30)
				{
					SleepOneFrame();
			
					targetPosition = (parent.GetTarget()).PredictWorldPosition( 0.7 );

					spawnPos += RandRangeF(6,3);

					markerNPC_1 = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync( 
							
					"dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent"

					, true ), spawnPos );

					markerNPC_1.PlayEffectSingle('mutation_7_buff');

					markerNPC_1.DestroyAfter(1);
					
					bat_projectile = (W3BatSwarmAttack)theGame.CreateEntity( 
					(CEntityTemplate)LoadResourceAsync( "dlc\dlc_acs\data\entities\projectiles\acs_crow_swarm_attack.w2ent", true ), spawnPos, parent.GetWorldRotation() );
					bat_projectile.Init(parent);
					bat_projectile.PlayEffectSingle( 'venom' );
					bat_projectile.ShootProjectileAtPosition( RandRangeF(30,15), 10, targetPosition, 500 );
					bat_projectile.DestroyAfter(10);
					bat_projectile.SoundEvent("animals_crow_swarm");

				}
			}

			SleepOneFrame();
		}
	}

	event OnLeaveState( nextStateName : name ) 
	{
		super.OnLeaveState(nextStateName);
	}
}

state ACS_GhoulVenomState in CNewNPC 
{
	private var last_ghoul_proj_spawn_time : float;
	private var actors																				: array<CActor>;
	private var i, num 																				: int;
	private var npc 																				: CNewNPC;
	private var actor 																				: CActor;
	private var movementAdjustor																	: CMovementAdjustor;
	private var ticket 																				: SMovementAdjustmentRequestTicket;
	private var targetDistance																		: float;
	private var ghoulAnimatedComponent 																: CAnimatedComponent;

	private var proj_1, proj_2, proj_3	 															: W3ACSPoisonProjectile;
	private var ice_proj_1, ice_proj_2, ice_proj_3  												: W3WHMinionProjectile;
	private var initpos, targetPosition																: Vector;

	private	var	m_storedInteractionPri 																: EInteractionPriority; 

	private var checkLineOfSight																	: bool;
	
	default	m_storedInteractionPri 																	= IP_NotSet;

	var markerNPC_1																					: CEntity;

	var cooldown																					: float;

	var morphedMM																					: CMorphedMeshManagerComponent;

	default cooldown 																				= 15;

	var npcStorage 																					: CBaseAICombatStorage;

	var masterDef																					: SAnimationSequenceDefinition;
	var masterSequencePart																			: SAnimationSequencePartDefinition;
	var syncInstance																				: CAnimationManualSlotSyncInstance;
	
	var instanceIndex																				: int;
	var sequenceIndex																				: int;

	var syncAnimName																				: name;
	
	var masterAnim 																					: name;
	var syncAnimIndex																				: int;
	var currentAnimInstance																			: CAnimationManualSlotSyncInstance;

	var bipedal_ghoul_ent																			: CEntity;

	var bipedal_ghoul_temp																			: CEntityTemplate;

	var meshcomp																					: CComponent;
	var animcomp 																					: CAnimatedComponent;
	var h 																							: float;

	event OnEnterState(previous_state_name: name) 
	{
    	super.OnEnterState(previous_state_name);
	
    	ACS_GhoulVenomState_ENTRY();
	}

	entry function ACS_GhoulVenomState_ENTRY() 
	{
		/*
		if (!parent.HasTag('ACS_Bipedal_Ghoul')
		&& RandF() < 0.5
		)
		{
			if ( parent.HasAbility('mon_ghoul_lesser')
			|| parent.HasAbility('mon_ghoul')
			|| parent.HasAbility('mon_ghoul_stronger')
			|| parent.HasAbility('mon_EP2_ghouls')
			|| parent.HasAbility('ghoul_hardcore')
			)
			{ 	
				bipedal_ghoul_temp = (CEntityTemplate)LoadResourceAsync("dlc\dlc_acs\data\entities\monsters\ghoul_bipedal.w2ent",true);
			}
			else if ( 
			parent.HasAbility('mon_alghoul')
			)
			{
				bipedal_ghoul_temp = (CEntityTemplate)LoadResourceAsync("dlc\dlc_acs\data\entities\monsters\alghoul_bipedal.w2ent",true);
			}

			bipedal_ghoul_ent = theGame.CreateEntity( bipedal_ghoul_temp, TraceFloor(parent.GetWorldPosition() + Vector(RandRangeF(5,-5),RandRangeF(5,-5),0 )), parent.GetWorldRotation() );

			animcomp = (CAnimatedComponent)bipedal_ghoul_ent.GetComponentByClassName('CAnimatedComponent');
			meshcomp = bipedal_ghoul_ent.GetComponentByClassName('CMeshComponent');
			h = 1.125;
			animcomp.SetScale(Vector(h,h,h,1));
			meshcomp.SetScale(Vector(h,h,h,1));	

			bipedal_ghoul_ent.AddTag('ACS_Bipedal_Ghoul');

			bipedal_ghoul_ent.AddTag('ACS_Custom_Monster');
		}
		*/
		
		while (true) 
		{
			ACS_GhoulVenomState_LATENT();

      		SleepOneFrame();
    	}
	}

	latent function ACS_GhoulVenomState_LATENT() 
	{
		checkLineOfSight = theGame.GetWorld().NavigationLineTest(parent.GetWorldPosition(), (parent.GetTarget()).GetWorldPosition(), parent.GetRadius());

		npcStorage = (CBaseAICombatStorage)parent.GetScriptStorageObject('CombatData');

		if (
		parent.HasBuff(EET_Knockdown)
		|| parent.HasBuff(EET_HeavyKnockdown)
		|| parent.HasBuff(EET_Ragdoll)
		|| parent.HasBuff(EET_Burning)
		|| parent.HasBuff(EET_Frozen)
		|| parent.HasBuff(EET_LongStagger)
		|| parent.HasBuff(EET_Stagger)
		|| parent.HasBuff(EET_Weaken)
		|| parent.HasBuff(EET_Confusion)
		|| parent.HasBuff(EET_AxiiGuardMe)
		|| parent.HasBuff(EET_Hypnotized)
		|| parent.HasBuff(EET_Immobilized)
		|| parent.HasBuff(EET_Paralyzed)
		|| parent.HasBuff(EET_Blindness)
		|| parent.HasBuff(EET_Choking)
		|| parent.HasBuff(EET_Swarm)
		|| !parent.IsAlive()
		|| parent.HasTag('ACS_Canaris_Minion')
		|| parent.HasTag('ACS_Pre_Rage')
		|| !thePlayer.WasVisibleInScaledFrame( parent, 1.f, 1.f )
		|| parent.HasTag( 'ACS_Bomb_Planted' )
		|| parent.ACS_IsInDimeritiumCloud()
		|| thePlayer.HasTag('ACS_In_Dance_Of_Wrath')
		|| thePlayer.HasTag('ACS_Ghost_Stance_Active')
		|| thePlayer.IsPerformingFinisher()
		|| thePlayer.HasTag('ACS_IsPerformingFinisher')
		|| thePlayer.HasTag('ACS_IsPerformingCombatDismember')
		|| thePlayer.HasTag('ACS_Bruxa_Bite_Process')
		|| parent.HasTag('ACS_Hit_Lag')
		|| FactsQuerySum("ACS_Bloodsmoke_Active") > 0
		|| ((CActor)((parent.GetTarget()))).IsGuarded()
		|| ((CActor)((parent.GetTarget()))).IsCurrentlyDodging()
		|| (parent.GetTarget()).HasTag('ACS_Is_Currently_Dodging')
		|| (parent.GetTarget()).HasTag('ACS_Air_Time')
		|| (parent.GetTarget()).HasTag('ACS_Feainnewedd_Dance')
		|| (parent.GetTarget()).HasTag('ACS_Sneaking_Lure')
		|| thePlayer.GetPlayerAction() != PEA_None
		|| !checkLineOfSight
		|| parent.HasTag('acs_wildhunt_minion_alpha')
		|| !ACS_Settings_Main_Bool('acs_encounters_enhanced_abilities_settings','acs_ghoul_venom_enabled', true)
		|| npcStorage.GetIsInImportantAnim()
		|| npcStorage.GetIsAttacking()
		|| npcStorage.GetIsCharging()
		|| npcStorage.GetIsTaunting()
		|| npcStorage.GetIsShooting()
		|| npcStorage.GetIsAiming()
		|| parent.HasTag('ACS_Stryzga')
		|| thePlayer.HasTag('ACS_Is_Sneaking')
		)			
		{
			return;
		}

		if( parent.HasAbility('mon_alghoul') && parent.HasAbility('RageActive') )
		{
			return;
		}
		
		if (theGame.GetEngineTimeAsSeconds() - last_ghoul_proj_spawn_time > cooldown)
		{
			last_ghoul_proj_spawn_time = theGame.GetEngineTimeAsSeconds();

			cooldown = RandRangeF(30,15);
	
			targetDistance = VecDistanceSquared2D( (parent.GetTarget()).GetWorldPosition(), parent.GetWorldPosition() ) ;
			
			if( targetDistance >= 4.5 * 4.5 ) 
			{
				if ( !theSound.SoundIsBankLoaded("monster_toad.bnk") )
				{
					theSound.SoundLoadBank( "monster_toad.bnk", false );
				}

				if ( !theSound.SoundIsBankLoaded("monster_golem_ice.bnk") )
				{
					theSound.SoundLoadBank( "monster_golem_ice.bnk", false );
				}

				if ( !theSound.SoundIsBankLoaded("monster_golem_dao.bnk") )
				{
					theSound.SoundLoadBank( "monster_golem_dao.bnk", false );
				}

				parent.AddTag('ACS_Ghoul_Firing_Projectile');

				movementAdjustor = parent.GetMovingAgentComponent().GetMovementAdjustor();

				ghoulAnimatedComponent = (CAnimatedComponent)parent.GetComponentByClassName( 'CAnimatedComponent' );	

				ticket = movementAdjustor.GetRequest( 'ACS_Ghoul_Proj_Rotate_1');
				movementAdjustor.CancelByName( 'ACS_Ghoul_Proj_Rotate_1' );
				movementAdjustor.CancelAll();
				ticket = movementAdjustor.CreateNewRequest( 'ACS_Ghoul_Proj_Rotate_1' );
				movementAdjustor.AdjustmentDuration( ticket, 1 );
				movementAdjustor.Continuous(ticket);
				movementAdjustor.MaxRotationAdjustmentSpeed( ticket, 50000 );

				movementAdjustor.RotateTowards( ticket, parent.GetTarget() );

				ghoulAnimatedComponent.PlaySlotAnimationAsync ( 'rage', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.75f));

				/*
				syncInstance 										= theGame.GetSyncAnimManager().CreateNewSyncInstance( instanceIndex );
				syncAnimIndex 										= instanceIndex;
				currentAnimInstance 								= syncInstance;

				masterSequencePart.animation						= 'rage';
				masterSequencePart.syncType							= AMST_SyncBeginning;
				masterSequencePart.useRefBone						= 'Reference';
				masterSequencePart.rotationTypeUsingRefBone 		= SRT_TowardsOtherEntity;
				masterSequencePart.shouldSlide						= false;
				masterSequencePart.shouldRotate						= false;

				masterSequencePart.blendInTime						= 0.5f;
				masterSequencePart.blendOutTime						= 1.5f;
				masterSequencePart.sequenceIndex					= 0;


				masterDef.parts.PushBack( masterSequencePart );


				masterDef.entity									= parent;
				
				masterDef.manualSlotName							= 'GAMEPLAY_SLOT';

				masterDef.freezeAtEnd								= false;

				sequenceIndex 										= syncInstance.RegisterMaster( masterDef );
				*/

				parent.SignalGameplayEventParamInt( 'SetupSyncInstance', instanceIndex );
				parent.SignalGameplayEventParamInt( 'SetupSequenceIndex', sequenceIndex );
				parent.SignalGameplayEvent( 'PlaySyncedAnim' );
		
				parent.AddBuffImmunity(EET_Poison, 'ACS_Ghoul_Proj_Poison_Negate', true);

				parent.AddBuffImmunity(EET_PoisonCritical , 'ACS_Ghoul_Proj_Poison_Negate', true);

				//parent.AddTag('ACS_Ghoul_Venom_Init');

				parent.PlayEffectSingle('morph_fx');
				parent.StopEffect('morph_fx');

				theSound.SoundEvent("monster_ghoul_morph_loop_stop");

				parent.DrainStamina( ESAT_FixedValue, npc.GetStatMax( BCS_Stamina ) * 0.25, 0.25 );

				//parent.SetImmortalityMode( AIM_Invulnerable, AIC_Default, true ); 
				parent.SetCanPlayHitAnim(false); 
				//parent.AddBuffImmunity_AllNegative('acs_ghoul_immune', true); 

				m_storedInteractionPri = parent.GetInteractionPriority();
				parent.SetInteractionPriority( IP_Max_Unpushable );

				markerNPC_1 = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync( 
							
				"dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent"

				, true ), parent.GetWorldPosition() );

				markerNPC_1.CreateAttachment( parent,, Vector(0,0,1.25) );
				
				markerNPC_1.PlayEffectSingle('mutation_7_buff');

				markerNPC_1.DestroyAfter(1);

				Sleep(2);

				ticket = movementAdjustor.GetRequest( 'ACS_Ghoul_Proj_Rotate_2');
				movementAdjustor.CancelByName( 'ACS_Ghoul_Proj_Rotate_2' );
				movementAdjustor.CancelAll();
				ticket = movementAdjustor.CreateNewRequest( 'ACS_Ghoul_Proj_Rotate_2' );
				movementAdjustor.AdjustmentDuration( ticket, 1 );
				movementAdjustor.MaxRotationAdjustmentSpeed( ticket, 50000 );

				movementAdjustor.RotateTowards( ticket, parent.GetTarget() );

				//initpos = npc.GetWorldPosition() + npc.GetWorldForward() * 0.5 ;

				initpos = parent.GetBoneWorldPosition('head') + parent.GetWorldForward();	
	
				targetPosition = (parent.GetTarget()).GetWorldPosition();

				if ( parent.HasAbility('mon_ghoul_lesser')
				|| parent.HasAbility('mon_ghoul')
				|| parent.HasAbility('mon_ghoul_stronger')
				|| parent.HasAbility('mon_EP2_ghouls')
				|| parent.HasAbility('ghoul_hardcore')
				)
				{ 	
					proj_1 = (W3ACSPoisonProjectile)theGame.CreateEntity( 
					(CEntityTemplate)LoadResourceAsync( 

						"dlc\dlc_acs\data\entities\projectiles\ghoul_projectile.w2ent"
						
						, true ), initpos );
									
					proj_1.Init(parent);

					theSound.SoundEvent("monster_toad_fx_mucus_spit");

					//proj_1.PlayEffectSingle('spit_travel');

					proj_1.ShootProjectileAtPosition( proj_1.projAngle, 10 + RandRangeF(10 , 5), targetPosition, 500 );
					proj_1.DestroyAfter(10);
				}
				else if ( 
				parent.HasAbility('mon_alghoul')
				)
				{ 	
					proj_1 = (W3ACSPoisonProjectile)theGame.CreateEntity( 
					(CEntityTemplate)LoadResourceAsync( 

						"dlc\dlc_acs\data\entities\projectiles\ghoul_projectile.w2ent"
						
						, true ), initpos );
									
					proj_1.Init(parent);

					theSound.SoundEvent("monster_toad_fx_mucus_spit");

					//proj_1.PlayEffectSingle('spit_travel');

					proj_1.ShootProjectileAtPosition( proj_1.projAngle, 10 + RandRangeF(10 , 5), targetPosition, 500 );
					proj_1.DestroyAfter(10);

					SleepOneFrame();

					proj_2 = (W3ACSPoisonProjectile)theGame.CreateEntity( 
					(CEntityTemplate)LoadResourceAsync( 

						"dlc\dlc_acs\data\entities\projectiles\ghoul_projectile.w2ent"
						
						, true ), initpos );
									
					proj_2.Init(parent);

					theSound.SoundEvent("monster_toad_fx_mucus_spit");

					//proj_2.PlayEffectSingle('spit_travel');

					proj_2.ShootProjectileAtPosition( proj_1.projAngle, 10 + RandRangeF(10 , 5), targetPosition, 500 );
					proj_2.DestroyAfter(10);

					SleepOneFrame();

					proj_3 = (W3ACSPoisonProjectile)theGame.CreateEntity( 
					(CEntityTemplate)LoadResourceAsync( 

						"dlc\dlc_acs\data\entities\projectiles\ghoul_projectile.w2ent"
						
						, true ), initpos );
									
					proj_3.Init(parent);

					theSound.SoundEvent("monster_toad_fx_mucus_spit");

					proj_3.ShootProjectileAtPosition( proj_1.projAngle, 10 + RandRangeF(10 , 5), targetPosition, 500 );
					proj_3.DestroyAfter(10);
				}
				else if (
				parent.HasAbility('mon_greater_miscreant')
				)
				{ 	
					proj_1 = (W3ACSPoisonProjectile)theGame.CreateEntity( 
					(CEntityTemplate)LoadResourceAsync( 

						"dlc\dlc_acs\data\entities\projectiles\ghoul_projectile.w2ent"
						
						, true ), initpos );
									
					proj_1.Init(parent);
					theSound.SoundEvent("monster_toad_fx_mucus_spit");

					//proj_1.PlayEffectSingle('spit_travel');

					proj_1.ShootProjectileAtPosition( proj_1.projAngle, 10 + RandRangeF(10 , 5), targetPosition, 500 );
					proj_1.DestroyAfter(10);

					SleepOneFrame();

					proj_2 = (W3ACSPoisonProjectile)theGame.CreateEntity( 
					(CEntityTemplate)LoadResourceAsync( 

						"dlc\dlc_acs\data\entities\projectiles\ghoul_projectile.w2ent"
						
						, true ), initpos );
									
					proj_2.Init(parent);

					//proj_2.PlayEffectSingle('spit_travel');

					proj_2.ShootProjectileAtPosition( proj_2.projAngle, 10 + RandRangeF(10 , 5), targetPosition + (parent.GetTarget()).GetWorldRight() * 1.5, 500 );
					proj_2.DestroyAfter(10);

					SleepOneFrame();

					proj_3 = (W3ACSPoisonProjectile)theGame.CreateEntity( 
					(CEntityTemplate)LoadResourceAsync( 

						"dlc\dlc_acs\data\entities\projectiles\ghoul_projectile.w2ent"
						
						, true ), initpos );
									
					proj_3.Init(parent);

					//proj_3.PlayEffectSingle('spit_travel');

					//proj_3.PlayEffectSingle('spit_hit');
					proj_3.ShootProjectileAtPosition( proj_3.projAngle, 10 + RandRangeF(10 , 5), targetPosition + (parent.GetTarget()).GetWorldRight() * -1.5, 500 );
					proj_3.DestroyAfter(10);
				}
				else if (
				parent.HasAbility('mon_wild_hunt_minionMH')
				)
				{
					parent.PlayEffectSingle('rift_fx_special');
					parent.PlayEffectSingle('rift_fx_special');
					parent.PlayEffectSingle('rift_fx_special');
					parent.StopEffect('rift_fx_special');

					parent.PlayEffectSingle('morph_fx_copy');
					parent.PlayEffectSingle('morph_fx_copy');
					parent.PlayEffectSingle('morph_fx_copy');
					parent.StopEffect('morph_fx_copy');

					parent.StopEffect('r_trail_snow');
					parent.PlayEffectSingle('r_trail_snow');
					parent.PlayEffectSingle('r_trail_snow');
					parent.PlayEffectSingle('r_trail_snow');

					parent.StopEffect('l_trail_snow');
					parent.PlayEffectSingle('l_trail_snow');
					parent.PlayEffectSingle('l_trail_snow');
					parent.PlayEffectSingle('l_trail_snow');

					parent.StopEffect('ice_armor');
					parent.PlayEffectSingle('ice_armor');
					parent.PlayEffectSingle('ice_armor');
					parent.PlayEffectSingle('ice_armor');
					parent.PlayEffectSingle('ice_armor');
					parent.PlayEffectSingle('ice_armor');
					parent.PlayEffectSingle('ice_armor');
					parent.PlayEffectSingle('ice_armor');

					parent.PlayEffectSingle('marker');
					parent.PlayEffectSingle('marker');
					parent.PlayEffectSingle('marker');
					parent.StopEffect('marker');

					theSound.SoundEvent("monster_wildhunt_minion_ice_spike_out");
					GetWitcherPlayer().SoundEvent("monster_wildhunt_minion_ice_spike_out");

					ice_proj_1 = (W3WHMinionProjectile)theGame.CreateEntity( 
					(CEntityTemplate)LoadResourceAsync( 

						"dlc\dlc_acs\data\entities\projectiles\wh_minion_projectile.w2ent"
						
						, true ), initpos );
									
					ice_proj_1.Init(parent);
					ice_proj_1.PlayEffectSingle('fire_line');
					ice_proj_1.ShootProjectileAtPosition( 0, 10 + RandRangeF(10 , 5), targetPosition, 500 );
					ice_proj_1.DestroyAfter(10);

					SleepOneFrame();

					ice_proj_2 = (W3WHMinionProjectile)theGame.CreateEntity( 
					(CEntityTemplate)LoadResourceAsync( 

						"dlc\dlc_acs\data\entities\projectiles\wh_minion_projectile.w2ent"
						
						, true ), initpos );
									
					ice_proj_2.Init(parent);
					ice_proj_2.PlayEffectSingle('fire_line');
					ice_proj_2.ShootProjectileAtPosition( 0, 10 + RandRangeF(10 , 5), targetPosition + (parent.GetTarget()).GetWorldRight() * 3, 500 );
					ice_proj_2.DestroyAfter(10);

					SleepOneFrame();

					ice_proj_3 = (W3WHMinionProjectile)theGame.CreateEntity( 
					(CEntityTemplate)LoadResourceAsync( 

						"dlc\dlc_acs\data\entities\projectiles\wh_minion_projectile.w2ent"
						
						, true ), initpos );
									
					ice_proj_3.Init(parent);
					ice_proj_3.PlayEffectSingle('fire_line');
					ice_proj_3.ShootProjectileAtPosition( 0, 10 + RandRangeF(10 , 5), targetPosition + (parent.GetTarget()).GetWorldRight() * -3, 500 );
					ice_proj_3.DestroyAfter(10);
				}
				else if (
				parent.HasAbility('mon_wild_hunt_minion')
				)
				{
					parent.PlayEffectSingle('rift_fx_special');
					parent.StopEffect('rift_fx_special');

					parent.PlayEffectSingle('morph_fx_copy');
					parent.StopEffect('morph_fx_copy');

					parent.StopEffect('r_trail_snow');
					parent.PlayEffectSingle('r_trail_snow');

					parent.StopEffect('l_trail_snow');
					parent.PlayEffectSingle('l_trail_snow');

					parent.PlayEffectSingle('marker');
					parent.StopEffect('marker');

					theSound.SoundEvent("monster_wildhunt_minion_ice_spike_out");
					GetWitcherPlayer().SoundEvent("monster_wildhunt_minion_ice_spike_out");

					ice_proj_1 = (W3WHMinionProjectile)theGame.CreateEntity( 
					(CEntityTemplate)LoadResourceAsync( 

						"dlc\dlc_acs\data\entities\projectiles\wh_minion_projectile.w2ent"
						
						, true ), initpos );
									
					ice_proj_1.Init(parent);
					ice_proj_1.PlayEffectSingle('fire_line');
					ice_proj_1.ShootProjectileAtPosition( 0, 10 + RandRangeF(10 , 5), targetPosition, 500 );
					ice_proj_1.DestroyAfter(10);
				}

				Sleep(1);

				parent.RemoveTag('ACS_Ghoul_Firing_Projectile');

				//parent.SetImmortalityMode( AIM_None, AIC_Default, true ); 
				//parent.SetCanPlayHitAnim(true); 
				//parent.RemoveBuffImmunity_AllNegative('acs_ghoul_immune'); 

				if ( m_storedInteractionPri != IP_NotSet )
				{
					parent.SetInteractionPriority( m_storedInteractionPri );
				}

				m_storedInteractionPri = IP_NotSet;

				parent.PlayEffectSingle('morph_fx');
				parent.StopEffect('morph_fx');

				theSound.SoundEvent("monster_ghoul_morph_loop_stop");

			}
		}	
	}
}

state ACS_HumanThrowBombState in CNewNPC 
{
	private var actors															: array<CActor>;
	private var i 																: int;
	private var npc 															: CNewNPC;
	private var actor 															: CActor;
	private var proj_1															: W3Dimeritium;
	private var initpos, targetPosition											: Vector;
	private var movementAdjustor												: CMovementAdjustor;
	private var ticket 															: SMovementAdjustmentRequestTicket;
	private var targetDistance, chance											: float;
	private var witchHunterAnimatedComponent, animatedComponentA 				: CAnimatedComponent;
	private var voiceTagName 													: name;
	private var voiceTagStr														: string;

	private var num 															: int;
	private var proj_Dimeritium													: W3ACSEnemyDimeritium;
	private var proj_Shrapnel													: W3ACSPetard;
	private var proj_knife														: W3ACSEnemyKnifeProjectile;
	private var blade_temp														: CEntityTemplate;

	private	var	m_storedInteractionPri 											: EInteractionPriority; 

	private var checkLineOfSight												: bool;
	
	default	m_storedInteractionPri 												= IP_NotSet;

	var last_witch_hunter_throw_bomb_time 										: float;

	var markerNPC_1																: CEntity;
	var npcStorage 																: CBaseAICombatStorage;


	var masterDef																: SAnimationSequenceDefinition;
	var masterSequencePart														: SAnimationSequencePartDefinition;
	var syncInstance															: CAnimationManualSlotSyncInstance;
	
	var instanceIndex															: int;
	var sequenceIndex															: int;

	var syncAnimName															: name;
	
	var masterAnim 																: name;
	var syncAnimIndex															: int;
	var currentAnimInstance														: CAnimationManualSlotSyncInstance;


	event OnEnterState(previous_state_name: name) 
	{
    	super.OnEnterState(previous_state_name);
	
    	ACS_HumanThrowBombState_ENTRY();
	}

	entry function ACS_HumanThrowBombState_ENTRY() 
	{
		while (true) 
		{
			ACS_HumanThrowBombState_LATENT();

      		SleepOneFrame();
    	}
	}

	latent function ACS_HumanThrowBombState_LATENT() 
	{
		animatedComponentA = (CAnimatedComponent)parent.GetComponentByClassName( 'CAnimatedComponent' );

		checkLineOfSight = theGame.GetWorld().NavigationLineTest(parent.GetWorldPosition(), (parent.GetTarget()).GetWorldPosition(), parent.GetRadius());

		npcStorage = (CBaseAICombatStorage)parent.GetScriptStorageObject('CombatData');

		if (
		parent.HasBuff(EET_Knockdown)
		|| parent.HasBuff(EET_HeavyKnockdown)
		|| parent.HasBuff(EET_Ragdoll)
		|| parent.HasBuff(EET_Burning)
		|| parent.HasBuff(EET_Frozen)
		|| parent.HasBuff(EET_LongStagger)
		|| parent.HasBuff(EET_Stagger)
		|| parent.HasBuff(EET_Weaken)
		|| parent.HasBuff(EET_Confusion)
		|| parent.HasBuff(EET_AxiiGuardMe)
		|| parent.HasBuff(EET_Hypnotized)
		|| parent.HasBuff(EET_Immobilized)
		|| parent.HasBuff(EET_Paralyzed)
		|| parent.HasBuff(EET_Blindness)
		|| parent.HasBuff(EET_Choking)
		|| parent.HasBuff(EET_Swarm)
		|| parent.IsInHitAnim()
		|| !thePlayer.WasVisibleInScaledFrame( parent, 1.f, 1.f )
		|| parent.ACS_IsInDimeritiumCloud()
		|| !parent.IsAnyWeaponHeld()
		|| !parent.IsInCombat()
		|| ((CNewNPC)parent).GetNPCType() == ENGT_Quest
		|| parent.IsUsingHorse()
		|| parent.IsUsingVehicle()
		|| parent.GetInventory().HasItem('crossbow')
		|| parent.GetInventory().HasItem('bow')
		|| parent.GetInventory().HasItemByTag('crossbow')
		|| parent.GetInventory().HasItemByTag('bow')
		|| parent.HasAbility( 'q604_shades' )
		|| animatedComponentA.HasFrozenPose()
		|| parent.GetIsRecoveringFromKnockdown()
		|| StrFindFirst(voiceTagStr, "REINALD") > 0
		|| StrContains( npc.GetReadableName(), "sq209" )
		|| parent.HasAbility( 'Boss' )
		|| parent.HasTag( 'ethereal' )
		|| parent.HasTag('ACS_Final_Bomb_Thrown')
		|| parent.HasTag('ACS_Final_Fear_Stack')
		|| parent.HasTag('ACS_Shades_Crusader')
		|| parent.HasTag('acs_dual_wield_enemy')
		|| parent.HasTag('mq1060_witcher')
		|| parent.HasTag( 'IsBoss' )
		|| parent.HasTag( 'ACS_Bomb_Planted' )
		|| parent.HasTag( 'ACS_Bomber' )
		|| parent.HasTag('ACS_man_finisher_dlc_arm_lp_combat_dismember')
		|| parent.HasTag('ACS_man_finisher_dlc_arm_rp_combat_dismember')
		|| parent.HasTag('ACS_man_finisher_dlc_legs_lp_combat_dismember')
		|| parent.HasTag('ACS_man_finisher_dlc_legs_rp_combat_dismember')
		|| parent.HasTag('ACS_2HandWeaponDestroyed')
		|| parent.HasTag('ACS_Currently_In_Grapple_Anim')
		|| parent.HasTag('ACS_Currently_In_Beh_Switch_Anim')
		|| parent.IsRagdolled()
		|| ((CHumanAICombatStorage)parent.GetScriptStorageObject('CombatData')).GetActiveCombatStyle() == EBG_Combat_Fists
		|| ((CHumanAICombatStorage)parent.GetScriptStorageObject('CombatData')).GetActiveCombatStyle() == EBG_Combat_Undefined
		|| ((CHumanAICombatStorage)parent.GetScriptStorageObject('CombatData')).GetActiveCombatStyle() == EBG_Combat_Crossbow
		|| ((CHumanAICombatStorage)parent.GetScriptStorageObject('CombatData')).GetActiveCombatStyle() == EBG_Combat_Bow
		|| ((CHumanAICombatStorage)parent.GetScriptStorageObject('CombatData')).GetActiveCombatStyle() == EBG_None
		|| GetACSWatcher().ACS_Rage_Process == true
		|| thePlayer.HasTag('ACS_In_Dance_Of_Wrath')
		|| thePlayer.HasTag('ACS_Ghost_Stance_Active')
		|| thePlayer.IsPerformingFinisher()
		|| thePlayer.HasTag('ACS_IsPerformingFinisher')
		|| thePlayer.HasTag('ACS_IsPerformingCombatDismember')
		|| thePlayer.HasTag('ACS_Bruxa_Bite_Process')
		|| thePlayer.HasTag('ACS_Transformation_Bruxa_Cloaked')
		|| parent.HasTag('ACS_Pre_Rage')
		|| parent.HasTag('ACS_Hit_Lag')
		|| FactsQuerySum("ACS_Bloodsmoke_Active") > 0
		|| !parent.IsInCombat()
		|| !parent.IsAlive()
		|| ((CActor)((parent.GetTarget()))).IsGuarded()
		|| ((CActor)((parent.GetTarget()))).IsCurrentlyDodging()
		|| (parent.GetTarget()).HasTag('ACS_Is_Currently_Dodging')
		|| (parent.GetTarget()).HasTag('ACS_Air_Time')
		|| (parent.GetTarget()).HasTag('ACS_Feainnewedd_Dance')
		|| (parent.GetTarget()).HasTag('ACS_Sneaking_Lure')
		|| StrContains( parent.GetReadableName(), "sq209" ) 
		|| thePlayer.GetPlayerAction() != PEA_None
		|| !checkLineOfSight
		|| !ACS_Settings_Main_Bool('acs_encounters_enhanced_abilities_settings','acs_one_handed_sword_bombs_enabled', true)
		|| npcStorage.GetIsInImportantAnim()
		//|| npcStorage.GetIsAttacking()
		|| npcStorage.GetIsCharging()
		|| npcStorage.GetIsTaunting()
		|| npcStorage.GetIsShooting()
		|| npcStorage.GetIsAiming()
		|| thePlayer.HasTag('ACS_Is_Sneaking')
		)			
		{
			return;
		}
		
		if (theGame.GetEngineTimeAsSeconds() - last_witch_hunter_throw_bomb_time > RandRangeF(14,7)
		)
		{
			last_witch_hunter_throw_bomb_time = theGame.GetEngineTimeAsSeconds();
	
			targetDistance = VecDistanceSquared2D( (parent.GetTarget()).GetWorldPosition(), parent.GetWorldPosition() ) ;
			
			if( targetDistance >= 5.5 * 5.5 ) 
			{
				if ( parent.HasTag('ACS_Shades_Hunter')
				)
				{
					chance = 0.99;
				}
				else
				{
					if (StrContains( parent.GetReadableName(), "witch_hunter" ) 
					|| StrContains( parent.GetReadableName(), "inq_" )
					)
					{
						if (theGame.GetDifficultyLevel() == EDM_Easy)
						{
							chance = 0.15;
						}
						else if (theGame.GetDifficultyLevel() == EDM_Medium)
						{
							chance = 0.2;
						}
						else if (theGame.GetDifficultyLevel() == EDM_Hard)
						{
							chance = 0.25;
						}
						else if (theGame.GetDifficultyLevel() == EDM_Hardcore)
						{
							chance = 0.375;
						}
						else
						{
							chance = 0.375;
						}
					}
					else
					{
						if (theGame.GetDifficultyLevel() == EDM_Easy)
						{
							chance = 0.1;
						}
						else if (theGame.GetDifficultyLevel() == EDM_Medium)
						{
							chance = 0.15;
						}
						else if (theGame.GetDifficultyLevel() == EDM_Hard)
						{
							chance = 0.2;
						}
						else if (theGame.GetDifficultyLevel() == EDM_Hardcore)
						{
							chance = 0.25;
						}
						else
						{
							chance = 0.25;
						}
					}
				}

				if( RandF() < chance ) 
				{
					if (RandF() < 0.25)
					{
						if (!parent.GetInventory().HasItem('ACS_Knife'))
						{
							parent.GetInventory().AddAnItem('ACS_Knife', 1);
						}
					}

					if (!parent.HasTag('ACS_Bomber'))
					{ 
						parent.AddTag('ACS_Bomber');
					}

					parent.AddBuffImmunity_AllNegative('ACS_Bomber', true); 

					parent.AddBuffImmunity_AllCritical('ACS_Bomber', true); 

					parent.SetCanPlayHitAnim(false); 

					markerNPC_1 = (CEntity)theGame.CreateEntity( (CEntityTemplate)LoadResourceAsync( 
							
					"dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent"

					, true ), parent.GetWorldPosition() );

					markerNPC_1.CreateAttachment( parent,, Vector(0,0,1.25) );

					markerNPC_1.PlayEffectSingle('mutation_7_buff');

					markerNPC_1.DestroyAfter(1);

					Sleep(0.5f);

					movementAdjustor = parent.GetMovingAgentComponent().GetMovementAdjustor();

					ticket = movementAdjustor.GetRequest( 'ACS_Witch_Hunter_Proj_Rotate_1');
					movementAdjustor.CancelByName( 'ACS_Witch_Hunter_Proj_Rotate_1' );
					movementAdjustor.CancelAll();
					ticket = movementAdjustor.CreateNewRequest( 'ACS_Witch_Hunter_Proj_Rotate_1' );
					movementAdjustor.AdjustmentDuration( ticket, 0.5 );
					movementAdjustor.MaxRotationAdjustmentSpeed( ticket, 500000 );

					movementAdjustor.RotateTowards( ticket, (parent.GetTarget()) );

					witchHunterAnimatedComponent = (CAnimatedComponent)parent.GetComponentByClassName( 'CAnimatedComponent' );

					//witchHunterAnimatedComponent.PlaySlotAnimationAsync ( 'man_npc_sword_1hand_throw_bomb_01_rp_ACS', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0.25f, 0.25f));

					syncInstance 										= theGame.GetSyncAnimManager().CreateNewSyncInstance( instanceIndex );
					syncAnimIndex 										= instanceIndex;
					currentAnimInstance 								= syncInstance;

					masterSequencePart.animation						= 'man_npc_sword_1hand_throw_bomb_01_rp_ACS';
					masterSequencePart.syncType							= AMST_SyncBeginning;
					masterSequencePart.useRefBone						= 'Reference';
					masterSequencePart.rotationTypeUsingRefBone 		= SRT_TowardsOtherEntity;
					masterSequencePart.shouldSlide						= false;
					masterSequencePart.shouldRotate						= false;

					masterSequencePart.blendInTime						= 0;
					masterSequencePart.blendOutTime						= 0.75f;
					masterSequencePart.sequenceIndex					= 0;


					masterDef.parts.PushBack( masterSequencePart );


					masterDef.entity									= parent;
					
					masterDef.manualSlotName							= 'GAMEPLAY_SLOT';

					masterDef.freezeAtEnd								= false;

					sequenceIndex 										= syncInstance.RegisterMaster( masterDef );

					parent.SignalGameplayEventParamInt( 'SetupSyncInstance', instanceIndex );
					parent.SignalGameplayEventParamInt( 'SetupSequenceIndex', sequenceIndex );
					parent.SignalGameplayEvent( 'PlaySyncedAnim' );

					//npc.SetImmortalityMode( AIM_Invulnerable, AIC_Default, true ); 
					//npc.SetCanPlayHitAnim(false); 

					Sleep(0.5f);

					initpos = parent.GetWorldPosition() + parent.GetHeadingVector() * 1.1 + parent.GetWorldForward() * 1.1;	
					initpos.Z += 1.1;
					//initpos.X -= 1;

					if (parent.GetInventory().HasItem('ACS_Knife'))
					{
						blade_temp = (CEntityTemplate)LoadResourceAsync( "dlc\dlc_acs\data\entities\projectiles\acs_enemy_knife_projectile.w2ent", true );

						proj_knife = (W3ACSEnemyKnifeProjectile)theGame.CreateEntity( blade_temp, initpos );
												
						proj_knife.Init(parent);

						targetPosition = (parent.GetTarget()).PredictWorldPosition(0.3f);
						targetPosition.Z += RandRangeF(1.1, 0.75);

						parent.GetInventory().RemoveItemByName('ACS_Knife', 1);

						proj_knife.ShootProjectileAtPosition( 15, 40, targetPosition, 500 );
					}
					else
					{
						//initpos.Y += 0.25;

						targetPosition = (parent.GetTarget()).PredictWorldPosition(0.7f);

						if (StrContains( parent.GetReadableName(), "witch_hunter" ) 
						|| StrContains( parent.GetReadableName(), "inq_" )
						|| parent.HasTag('ACS_Shades_Hunter')
						)
						{
							if (!parent.HasTag('ACS_1st_Bomb_Thrown')
							&& !parent.HasTag('ACS_2nd_Bomb_Thrown')
							&& !parent.HasTag('ACS_3rd_Bomb_Thrown')	
							)
							{
								chance = 0.25;
							}
							else if (parent.HasTag('ACS_1st_Bomb_Thrown')
							&& !parent.HasTag('ACS_2nd_Bomb_Thrown')
							&& !parent.HasTag('ACS_3rd_Bomb_Thrown')	
							)
							{
								chance = 0.5;
							}
							else if (parent.HasTag('ACS_1st_Bomb_Thrown')
							&& parent.HasTag('ACS_2nd_Bomb_Thrown')	
							&& !parent.HasTag('ACS_3rd_Bomb_Thrown')	
							)
							{
								chance = 0.75;
							}
							else if (parent.HasTag('ACS_1st_Bomb_Thrown')
							&& parent.HasTag('ACS_2nd_Bomb_Thrown')	
							&& parent.HasTag('ACS_3rd_Bomb_Thrown')	
							)
							{
								chance = 0.95;
							}
							
							if( RandF() < chance ) 
							{
								proj_Dimeritium = (W3ACSEnemyDimeritium)theGame.CreateEntity( 
								(CEntityTemplate)LoadResourceAsync( 

								"dlc\dlc_acs\data\entities\enemy_bombs\enemy_petard_dimeritium_bomb.w2ent"
								
								, true ), initpos );
												
								proj_Dimeritium.Init(parent);

								proj_Dimeritium.Initialize(parent);

								proj_Dimeritium.PlayEffectSingle('activate');

								proj_Dimeritium.PlayEffectSingle('activate_cluster');

								proj_Dimeritium.ThrowProjectile(targetPosition);
							}
							else
							{
								proj_Shrapnel = (W3ACSPetard)theGame.CreateEntity( 
								(CEntityTemplate)LoadResourceAsync( 

								"dlc\dlc_acs\data\entities\enemy_bombs\enemy_petard_shrapnel_bomb.w2ent"
								
								, true ), initpos );
												
								proj_Shrapnel.Init(parent);

								proj_Shrapnel.Initialize(parent);

								proj_Shrapnel.ThrowProjectile(targetPosition);

								/*
								proj_Shrapnel = (W3ACSPetard)theGame.CreateEntity( 
								(CEntityTemplate)LoadResourceAsync( 

								"dlc\dlc_acs\data\entities\enemy_bombs\enemy_petard_grapeshot.w2ent"
								
								, true ), initpos );
												
								proj_Shrapnel.Init(parent);

								proj_Shrapnel.Initialize(parent);

								proj_Shrapnel.ThrowProjectile(targetPosition);
								*/
							}
						}
						else
						{
							proj_Shrapnel = (W3ACSPetard)theGame.CreateEntity( 
							(CEntityTemplate)LoadResourceAsync( 

							"dlc\dlc_acs\data\entities\enemy_bombs\enemy_petard_shrapnel_bomb.w2ent"

							, true ), initpos );
											
							proj_Shrapnel.Init(parent);

							proj_Shrapnel.Initialize(parent);

							proj_Shrapnel.ThrowProjectile(targetPosition);

							/*
							proj_Shrapnel = (W3ACSPetard)theGame.CreateEntity( 
							(CEntityTemplate)LoadResourceAsync( 

							"dlc\dlc_acs\data\entities\enemy_bombs\enemy_petard_grapeshot.w2ent"
							
							, true ), initpos );
											
							proj_Shrapnel.Init(parent);

							proj_Shrapnel.Initialize(parent);

							proj_Shrapnel.ThrowProjectile(targetPosition);
							*/
						}

						if (!parent.HasTag('ACS_1st_Bomb_Thrown')
						&& !parent.HasTag('ACS_2nd_Bomb_Thrown')
						&& !parent.HasTag('ACS_3rd_Bomb_Thrown')	
						)
						{
							parent.AddTag('ACS_1st_Bomb_Thrown');
						}
						else if (parent.HasTag('ACS_1st_Bomb_Thrown')
						&& !parent.HasTag('ACS_2nd_Bomb_Thrown')
						&& !parent.HasTag('ACS_3rd_Bomb_Thrown')	
						)
						{
							parent.AddTag('ACS_2nd_Bomb_Thrown');
						}
						else if (parent.HasTag('ACS_1st_Bomb_Thrown')
						&& parent.HasTag('ACS_2nd_Bomb_Thrown')	
						&& !parent.HasTag('ACS_3rd_Bomb_Thrown')	
						)
						{
							parent.AddTag('ACS_3rd_Bomb_Thrown');
						}
						else if (parent.HasTag('ACS_1st_Bomb_Thrown')
						&& parent.HasTag('ACS_2nd_Bomb_Thrown')	
						&& parent.HasTag('ACS_3rd_Bomb_Thrown')	
						)
						{
							if (!parent.HasTag('ACS_Final_Bomb_Thrown'))
							{
								parent.AddTag('ACS_Final_Bomb_Thrown');
							}
						}
					}

					Sleep(0.75f);

					//witchHunterAnimatedComponent.PlaySlotAnimationAsync ( '', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(1, 1));

					parent.RemoveTag('ACS_Bomber');

					parent.RemoveTag('ACS_Throw_Bomb_Init');

					parent.RemoveBuffImmunity_AllNegative('ACS_Bomber'); 

					parent.RemoveBuffImmunity_AllCritical('ACS_Bomber'); 

					parent.SetCanPlayHitAnim(true); 
				}
			}
		}	
	}
}

state ACS_DrownerTentacleState in CNewNPC 
{
	private var actors, victims																		: array<CActor>;
	private var i 																					: int;
	private var npc 																				: CNewNPC;
	private var actor, actortarget 																	: CActor;
	private var proj_1, proj_2, proj_3	 															: DebuffProjectile;
	private var initpos, targetPosition																: Vector;
	private var movementAdjustor																	: CMovementAdjustor;
	private var ticket 																				: SMovementAdjustmentRequestTicket;
	private var targetDistance																		: float;
	private var drownerAnimatedComponent 															: CAnimatedComponent;
	private var ent_1, ent_2, ent_3, ent_4, ent_5, ent_6, ent_7, anchor    							: CEntity;
	private var rot, attach_rot																		: EulerAngles;
   	private var pos, attach_vec																		: Vector;
	private var meshcomp																			: CComponent;
	private var animcomp 																			: CAnimatedComponent;
	private var h 																					: float;
	private var bone_vec																			: Vector;
	private var bone_rot																			: EulerAngles;
	private var anchor_temp, ent_1_temp, ent_2_temp													: CEntityTemplate;

	private var dmg																					: W3DamageAction;

	private var damageMax, damageMin																: float;

	private var l_aiTree																			: CAIExecuteAttackAction;

	private var last_tentacle_proj_spawn_time 														: float;

	private var params 																				: SCustomEffectParams;

	private var checkLineOfSight																	: bool;

	private var parry_sound_names																	: array< string >;

	private var npcStorage 																			: CBaseAICombatStorage;

	event OnEnterState(previous_state_name: name) 
	{
    	super.OnEnterState(previous_state_name);
	
    	ACS_DrownerTentacleState_ENTRY();
	}

	entry function ACS_DrownerTentacleState_ENTRY() 
	{
		while (true) 
		{
			ACS_DrownerTentacleState_LATENT();

      		SleepOneFrame();
    	}
	}

	latent function ACS_DrownerTentacleState_LATENT() 
	{
		checkLineOfSight = theGame.GetWorld().NavigationLineTest(parent.GetWorldPosition(), (parent.GetTarget()).GetWorldPosition(), parent.GetRadius());

		npcStorage = (CBaseAICombatStorage)parent.GetScriptStorageObject('CombatData');

		if (
		parent.HasBuff(EET_Knockdown)
		|| parent.HasBuff(EET_HeavyKnockdown)
		|| parent.HasBuff(EET_Ragdoll)
		|| parent.HasBuff(EET_Burning)
		|| parent.HasBuff(EET_Frozen)
		|| parent.HasBuff(EET_LongStagger)
		|| parent.HasBuff(EET_Stagger)
		|| parent.HasBuff(EET_Weaken)
		|| parent.HasBuff(EET_Confusion)
		|| parent.HasBuff(EET_AxiiGuardMe)
		|| parent.HasBuff(EET_Hypnotized)
		|| parent.HasBuff(EET_Immobilized)
		|| parent.HasBuff(EET_Paralyzed)
		|| parent.HasBuff(EET_Blindness)
		|| parent.HasBuff(EET_Choking)
		|| parent.HasBuff(EET_Swarm)
		|| parent.HasTag('ACS_Hit_Lag')
		|| !thePlayer.WasVisibleInScaledFrame( parent, 1.f, 1.f )
		|| parent.HasTag( 'ACS_Bomb_Planted' )
		|| parent.ACS_IsInDimeritiumCloud()
		|| thePlayer.HasTag('ACS_In_Dance_Of_Wrath')
		|| thePlayer.HasTag('ACS_Ghost_Stance_Active')
		|| thePlayer.IsPerformingFinisher()
		|| thePlayer.HasTag('ACS_IsPerformingFinisher')
		|| thePlayer.HasTag('ACS_IsPerformingCombatDismember')
		|| thePlayer.HasTag('ACS_Bruxa_Bite_Process')
		|| FactsQuerySum("ACS_Bloodsmoke_Active") > 0
		|| parent.HasTag('ACS_Pre_Rage')
		|| !parent.IsAlive()
		|| ((CActor)((parent.GetTarget()))).IsGuarded()
		|| ((CActor)((parent.GetTarget()))).IsCurrentlyDodging()
		|| (parent.GetTarget()).HasTag('ACS_Is_Currently_Dodging')
		|| (parent.GetTarget()).HasTag('ACS_Air_Time')
		|| (parent.GetTarget()).HasTag('ACS_Feainnewedd_Dance')
		|| (parent.GetTarget()).HasTag('ACS_Sneaking_Lure')
		|| thePlayer.GetPlayerAction() != PEA_None
		|| !checkLineOfSight
		|| !ACS_Settings_Main_Bool('acs_encounters_enhanced_abilities_settings','acs_necrophage_tentacles_enabled', true)
		|| npcStorage.GetIsInImportantAnim()
		//|| npcStorage.GetIsAttacking()
		|| npcStorage.GetIsCharging()
		|| npcStorage.GetIsTaunting()
		|| npcStorage.GetIsShooting()
		|| npcStorage.GetIsAiming()
		|| thePlayer.HasTag('ACS_Is_Sneaking')
		)			
		{
			return;
		}
		
		if (theGame.GetEngineTimeAsSeconds() - last_tentacle_proj_spawn_time > RandRangeF(14,7))
		{
			last_tentacle_proj_spawn_time = theGame.GetEngineTimeAsSeconds();
	
			targetDistance = VecDistanceSquared2D( (parent.GetTarget()).GetWorldPosition(), parent.GetWorldPosition() ) ;
			
			if( targetDistance <= 10 * 10 
			&& RandF() < 0.25
			) 
			{
				if ( !theSound.SoundIsBankLoaded("monster_toad.bnk") )
				{
					theSound.SoundLoadBank( "monster_toad.bnk", false );
				}

				rot = parent.GetWorldRotation();

				pos = parent.GetWorldPosition() + parent.GetWorldForward() * 5;

				anchor_temp = (CEntityTemplate)LoadResourceAsync( 
					
				"dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent"
				
				, true );


				parent.GetBoneWorldPositionAndRotationByIndex( parent.GetBoneIndex( 'head' ), bone_vec, bone_rot );

				anchor = (CEntity)theGame.CreateEntity( anchor_temp, parent.GetWorldPosition() + Vector( 0, 0, -10 ) );

				anchor.DestroyAfter(10);

				anchor.PlayEffectSingle('mutation_7_buff');

				anchor.CreateAttachmentAtBoneWS( parent, 'head', bone_vec, bone_rot );

				((CActor)anchor).EnableCollisions(false);
				((CActor)anchor).EnableCharacterCollisions(false);

				ent_1_temp = (CEntityTemplate)LoadResourceAsync( 

					"dlc\dlc_acs\data\entities\other\custom_toad_tentacles\custom_toad_tentacles.w2ent"
					
					, true );

				ent_2_temp = (CEntityTemplate)LoadResourceAsync( 
					
					"dlc\dlc_acs\data\entities\other\custom_toad_tentacles\custom_toad_tentacles.w2ent"
					
					, true );

				ent_1 = theGame.CreateEntity( ent_1_temp, pos, rot );

				ent_1.DestroyAfter(10);

				((CNewNPC)ent_1).SetTemporaryAttitudeGroup( 'q104_avallach_friendly_to_all', AGP_Default );	
				((CNewNPC)ent_1).EnableCharacterCollisions(false);
				((CNewNPC)ent_1).EnableCollisions(false);
				((CNewNPC)ent_1).SetImmortalityMode( AIM_Invulnerable, AIC_Default, true );
				((CActor)ent_1).SetTemporaryAttitudeGroup( 'q104_avallach_friendly_to_all', AGP_Default );
				((CActor)ent_1).EnableCollisions(false);
				((CActor)ent_1).EnableCharacterCollisions(false);
				((CActor)ent_1).SetImmortalityMode( AIM_Invulnerable, AIC_Default, true );

				//parent.EnableCharacterCollisions(false);

				animcomp = (CAnimatedComponent)ent_1.GetComponentByClassName('CAnimatedComponent');
				meshcomp = ent_1.GetComponentByClassName('CMeshComponent');

				animcomp.SetScale(Vector( 0.25, 0.25, 0.25, 1 ));

				meshcomp.SetScale(Vector( 0.25, 0.25, 0.25, 1 ));	

				attach_rot.Roll = 90;
				attach_rot.Pitch = 0;
				attach_rot.Yaw = 180;
				attach_vec.X = 0.4;
				attach_vec.Y = 0.15;
				attach_vec.Z = 0;

				ent_1.CreateAttachment( anchor, , attach_vec, attach_rot );
				
				animcomp.PlaySlotAnimationAsync ( 'monster_toad_attack_tongue_10m', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0, 0.5f));

				//animcomp.FreezePoseFadeIn(7.5f);

				ent_2 = theGame.CreateEntity( ent_2_temp, pos, rot );

				ent_2.DestroyAfter(10);

				((CNewNPC)ent_2).SetTemporaryAttitudeGroup( 'q104_avallach_friendly_to_all', AGP_Default );	
				((CNewNPC)ent_2).EnableCharacterCollisions(false);
				((CNewNPC)ent_2).EnableCollisions(false);
				((CNewNPC)ent_2).SetImmortalityMode( AIM_Invulnerable, AIC_Default, true );
				((CActor)ent_2).SetTemporaryAttitudeGroup( 'q104_avallach_friendly_to_all', AGP_Default );
				((CActor)ent_2).EnableCollisions(false);
				((CActor)ent_2).EnableCharacterCollisions(false);
				((CActor)ent_2).SetImmortalityMode( AIM_Invulnerable, AIC_Default, true );

				animcomp = (CAnimatedComponent)ent_2.GetComponentByClassName('CAnimatedComponent');
				meshcomp = ent_2.GetComponentByClassName('CMeshComponent');

				animcomp.SetScale(Vector( 0.25, 0.25, 0.25, 1 ));

				meshcomp.SetScale(Vector( 0.25, 0.25, 0.25, 1 ));	

				attach_rot.Roll = -30;
				attach_rot.Pitch = 0;
				attach_rot.Yaw = 180;
				attach_vec.X = -0.3;
				attach_vec.Y = 0.15;
				attach_vec.Z = -0.35;

				ent_2.CreateAttachment( anchor, , attach_vec, attach_rot );

				animcomp.PlaySlotAnimationAsync ( 'monster_toad_attack_tongue_10m', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0, 0.5f));

				//animcomp.FreezePoseFadeIn(7.5f);

				ent_3 = theGame.CreateEntity( ent_2_temp, pos, rot );

				ent_3.DestroyAfter(10);

				((CNewNPC)ent_3).SetTemporaryAttitudeGroup( 'q104_avallach_friendly_to_all', AGP_Default );	
				((CNewNPC)ent_3).EnableCharacterCollisions(false);
				((CNewNPC)ent_3).EnableCollisions(false);
				((CNewNPC)ent_3).SetImmortalityMode( AIM_Invulnerable, AIC_Default, true );
				((CActor)ent_3).SetTemporaryAttitudeGroup( 'q104_avallach_friendly_to_all', AGP_Default );
				((CActor)ent_3).EnableCollisions(false);
				((CActor)ent_3).EnableCharacterCollisions(false);
				((CActor)ent_3).SetImmortalityMode( AIM_Invulnerable, AIC_Default, true );

				animcomp = (CAnimatedComponent)ent_3.GetComponentByClassName('CAnimatedComponent');
				meshcomp = ent_3.GetComponentByClassName('CMeshComponent');

				animcomp.SetScale(Vector( 0.25, 0.25, 0.25, 1 ));

				meshcomp.SetScale(Vector( 0.25, 0.25, 0.25, 1 ));	

				attach_rot.Roll = -150;
				attach_rot.Pitch = 0;
				attach_rot.Yaw = 180;
				attach_vec.X = -0.3;
				attach_vec.Y = 0.15;
				attach_vec.Z = 0.35;

				ent_3.CreateAttachment( anchor, , attach_vec, attach_rot );

				animcomp.PlaySlotAnimationAsync ( 'monster_toad_attack_tongue_10m', 'NPC_ANIM_SLOT', SAnimatedComponentSlotAnimationSettings(0, 0.5f));

				Sleep(1);

				if ( parent.GetCurrentHealth() <= 0 
				|| !parent.IsAlive())
				{
					anchor.BreakAttachment(); 
					anchor.Teleport( parent.GetWorldPosition() + Vector( 0, 0, -200 ) );
					anchor.DestroyAfter(0.0125);

					ent_1.BreakAttachment(); 
					ent_1.Teleport( parent.GetWorldPosition() + Vector( 0, 0, -200 ) );
					ent_1.DestroyAfter(0.0125);

					ent_2.BreakAttachment(); 
					ent_2.Teleport( parent.GetWorldPosition() + Vector( 0, 0, -200 ) );
					ent_2.DestroyAfter(0.0125);

					ent_3.BreakAttachment(); 
					ent_3.Teleport( parent.GetWorldPosition() + Vector( 0, 0, -200 ) );
					ent_3.DestroyAfter(0.0125);

					parent.RemoveTag('ACS_Tentacle_Init');

					//parent.EnableCharacterCollisions(true);

					return;
				}

				victims.Clear();

				victims = parent.GetNPCsAndPlayersInCone(3, VecHeading(parent.GetHeadingVector()), 30, 20, , FLAG_OnlyAliveActors );

				if( victims.Size() > 0)
				{
					for( i = 0; i < victims.Size(); i += 1 )
					{
						actortarget = (CActor)victims[i];

						if (actortarget != parent
						&& actortarget != (CActor)ent_1
						&& actortarget != (CActor)ent_2
						&& actortarget != (CActor)ent_3
						&& !actortarget.HasAbility('mon_drowner_base')
						)
						{
							if 
							(
								actortarget.IsCurrentlyDodging()
								|| actortarget.IsGuarded()
							)
							{
								if (actortarget == thePlayer && thePlayer.IsGuarded())
								{
									if (thePlayer.IsDeadlySwordHeld())
									{
										ACSGetCEntity('acs_sword_trail_3').StopEffect('light_block');
										ACSGetCEntity('acs_sword_trail_3').StopEffect('heavy_block');
										ACSGetCEntity('acs_sword_trail_3').StopEffect('counterattack');
										ACSGetCEntity('acs_sword_trail_3').PlayEffectSingle('light_block');
										ACSGetCEntity('acs_sword_trail_3').PlayEffectSingle('heavy_block');
										ACSGetCEntity('acs_sword_trail_3').PlayEffectSingle('counterattack');

										parry_sound_names.Clear();
										parry_sound_names.PushBack("block_01_sekiro_acs");
										parry_sound_names.PushBack("block_02_sekiro_acs");
										parry_sound_names.PushBack("block_03_sekiro_acs");
										parry_sound_names.PushBack("block_04_sekiro_acs");

										GetWitcherPlayer().SoundEvent(parry_sound_names[RandRange(parry_sound_names.Size())]);
									}

									GetACSWatcher().action_interrupt();
						
									thePlayer.SetBehaviorVariable( 'parryType', RandRange(9) );
									thePlayer.RaiseForceEvent( 'PerformParry' );
								}
							}
							else
							{
								dmg = new W3DamageAction in theGame.damageMgr;

								dmg.Initialize(parent, actortarget, NULL, parent.GetName(), EHRT_Light, CPS_Undefined, false, false, true, false);
			
								dmg.SetProcessBuffsIfNoDamage(true);
								
								dmg.SetHitReactionType( EHRT_Light, true);

								if (actortarget.UsesVitality()) 
								{ 
									damageMax = actortarget.GetStat( BCS_Vitality ) * 0.025; 
									
									damageMin = actortarget.GetStat( BCS_Vitality ) * 0.0125; 
								} 
								else if (actor.UsesEssence()) 
								{ 
									damageMax = actortarget.GetStat( BCS_Essence ) * 0.025; 
									
									damageMin = actortarget.GetStat( BCS_Essence ) * 0.0125; 
								} 

								dmg.AddDamage( theGame.params.DAMAGE_NAME_POISON, RandRangeF(damageMax,damageMin) );

								dmg.AddEffectInfo( EET_Bleeding, 3 );

								dmg.AddEffectInfo( EET_Poison, 3 );
									
								dmg.SetCriticalHit(); theGame.damageMgr.ProcessAction( dmg );
									
								delete dmg;
							}
						}
					}
				}

				Sleep(0.5);

				anchor.BreakAttachment(); 
				anchor.Teleport( parent.GetWorldPosition() + Vector( 0, 0, -200 ) );
				anchor.DestroyAfter(0.0125);

				ent_1.BreakAttachment(); 
				ent_1.Teleport( parent.GetWorldPosition() + Vector( 0, 0, -200 ) );
				ent_1.DestroyAfter(0.0125);

				ent_2.BreakAttachment(); 
				ent_2.Teleport( parent.GetWorldPosition() + Vector( 0, 0, -200 ) );
				ent_2.DestroyAfter(0.0125);

				ent_3.BreakAttachment(); 
				ent_3.Teleport( parent.GetWorldPosition() + Vector( 0, 0, -200 ) );
				ent_3.DestroyAfter(0.0125);

				parent.RemoveTag('ACS_Tentacle_Init');

				//parent.EnableCharacterCollisions(true);

			}
		}	
	}
}

/////////////////////////////////////////////////////////////////////////////////////////////////

@addMethod( CNewNPC ) timer function ACS_Werewolf_Spawn_Adds( dt : float, id : int )
{
	var actors, victims																												: array<CActor>;
	var i, count, j 																												: int;
	var npc 																														: CNewNPC;
	var actor, actortarget 																											: CActor;
	var spawnPos, playerPos, newPlayerPos																							: Vector;
	var movementAdjustor																											: CMovementAdjustor;
	var ticket 																														: SMovementAdjustmentRequestTicket;
	var targetDistance																												: float;
	var ent_1, ent_2, ent_3, vfxEnt_1, vfxEnt_2, skull_ent_1, skull_ent_2, skull_ent_3												: CEntity;
	var rot, attach_rot																												: EulerAngles;
   	var pos, attach_vec																												: Vector;
	var meshcomp																													: CComponent;
	var animcomp 																													: CAnimatedComponent;
	var playerRot, adjustedRot																										: EulerAngles;
	var temp, ent_1_temp, ent_2_temp																								: CEntityTemplate;
	var randAngle, randRange																										: float;
	var animatedComponentA																											: CAnimatedComponent;
	
	if (!this.IsAlive()
	|| (!this.HasAbility('mon_werewolf_lesser') && !this.HasAbility('mon_werewolf') && !this.HasAbility('mon_lycanthrope'))
	|| StrContains( this.GetReadableName(), "sq201" )
	|| !ACS_Settings_Main_Bool('acs_encounters_enhanced_abilities_settings','acs_werewolf_spawn_adds_enabled', true)
	)
	{
		RemoveTimer('ACS_Werewolf_Spawn_Adds');

		return;
	}

	if(
	(
	(this.HasAbility('mon_werewolf_lesser')
	|| this.HasAbility('mon_werewolf')
	|| this.HasAbility('mon_lycanthrope')
	)
	&& this.GetCurrentHealth() <= this.GetMaxHealth() * 0.5
	&& this.IsAlive()
	&& !this.HasTag('ACS_Shades_Kara_Shadow_Werewolf')
	&& !StrContains( this.GetReadableName(), "sq201" )
	&& !this.IsInInterior()
	)
	)
	{
		targetDistance = VecDistanceSquared2D( this.GetWorldPosition(), GetWitcherPlayer().GetWorldPosition() );

		if (targetDistance > 2.5 * 2.5 && targetDistance <= 20 * 20)
		{
			if (!this.HasTag('ACS_Werewolf_Has_Summoned_Adds'))
			{
				if ( !theSound.SoundIsBankLoaded("animals_wolf.bnk") )
				{
					theSound.SoundLoadBank( "animals_wolf.bnk", false );
				}

				if ( !theSound.SoundIsBankLoaded("monster_wild_dog.bnk") )
				{
					theSound.SoundLoadBank( "monster_wild_dog.bnk", false );
				}

				vfxEnt_1 = theGame.CreateEntity( (CEntityTemplate)LoadResource(
				"dlc\bob\data\fx\gameplay\mutation\mutation_7\mutation_7.w2ent"
				, true ), this.GetWorldPosition(), this.GetWorldRotation() );

				vfxEnt_1.CreateAttachment( this, , Vector( 0, 0, 0 ), EulerAngles(0,0,0) );

				vfxEnt_1.PlayEffectSingle('sonar_mesh');

				vfxEnt_1.PlayEffectSingle('sonar');

				vfxEnt_1.PlayEffectSingle('fx_sonar');

				vfxEnt_1.DestroyAfter(2);



				vfxEnt_2 = theGame.CreateEntity( (CEntityTemplate)LoadResource(
					"dlc\dlc_acs\data\fx\acs_sonar.w2ent"
					, true ), this.GetWorldPosition(), this.GetWorldRotation() );

				vfxEnt_2.CreateAttachment( this, , Vector( 0, 0, 0 ), EulerAngles(0,0,0) );


				vfxEnt_2.PlayEffectSingle('sonar_mesh');

				vfxEnt_2.PlayEffectSingle('sonar');

				vfxEnt_2.PlayEffectSingle('fx_sonar');

				vfxEnt_2.DestroyAfter(2);




				movementAdjustor = ((CActor)this).GetMovingAgentComponent().GetMovementAdjustor();

				ticket = movementAdjustor.GetRequest( 'ACS_Werewolf_Smmmon_Rotate');
				movementAdjustor.CancelByName( 'ACS_Werewolf_Smmmon_Rotate' );
				movementAdjustor.CancelAll();

				ticket = movementAdjustor.CreateNewRequest( 'ACS_Werewolf_Smmmon_Rotate' );
				movementAdjustor.AdjustmentDuration( ticket, 0.5 );
				movementAdjustor.MaxRotationAdjustmentSpeed( ticket, 500000 );

				movementAdjustor.RotateTowards(ticket, ((CActor)(this.GetTarget())));

				((CAnimatedComponent)((CNewNPC)this).GetComponentByClassName( 'CAnimatedComponent' )).RaiseBehaviorForceEvent('Howl');

				
				theSound.SoundEvent("animals_wolf_howl");

				theSound.SoundEvent("monster_wild_dog_howl");

				temp = (CEntityTemplate)LoadResource( 

				"characters\npc_entities\monsters\wolf_lvl1__summon.w2ent"
					
				, true );

				playerPos = theCamera.GetCameraPosition() + theCamera.GetCameraDirection() * -10;

				if( !theGame.GetWorld().NavigationFindSafeSpot( playerPos, 0.3, 0.3 , newPlayerPos ) )
				{
					theGame.GetWorld().NavigationFindSafeSpot( playerPos, 0.5f, 10 , newPlayerPos );
					playerPos = newPlayerPos;
				}

				playerRot = thePlayer.GetWorldRotation();

				adjustedRot = EulerAngles(0,0,0);

				adjustedRot.Yaw = playerRot.Yaw;

				ent_1 = theGame.CreateEntity( temp, ACSFixZAxis(playerPos), adjustedRot );

				((CNewNPC)ent_1).SetAttitude(this, AIA_Friendly);

				((CNewNPC)ent_1).SetLevel(1);

				((CNewNPC)ent_1).SetAttitude(((CActor)(this.GetTarget())), AIA_Hostile);

				ent_2 = theGame.CreateEntity( temp, ACSFixZAxis(playerPos), adjustedRot );

				((CNewNPC)ent_2).SetAttitude(this, AIA_Friendly);

				((CNewNPC)ent_2).SetLevel( 1 );

				((CNewNPC)ent_2).SetAttitude(((CActor)(this.GetTarget())), AIA_Hostile);

				ent_3 = theGame.CreateEntity( temp, ACSFixZAxis(playerPos), adjustedRot );

				((CNewNPC)ent_3).SetAttitude(this, AIA_Friendly);

				((CNewNPC)ent_3).SetLevel(1);

				((CNewNPC)ent_3).SetAttitude(((CActor)(this.GetTarget())), AIA_Hostile);

				RemoveTimer('ACS_Werewolf_Spawn_Adds');
			

				this.AddTag('ACS_Werewolf_Has_Summoned_Adds');
			}

			RemoveTimer('ACS_Werewolf_Spawn_Adds');
		}
	}
}

@addMethod( CNewNPC ) timer function ACS_Vendigo_Spawn_Adds( dt : float, id : int )
{
	var actors, victims																												: array<CActor>;
	var i, count, j 																												: int;
	var npc 																														: CNewNPC;
	var actor, actortarget 																											: CActor;
	var spawnPos, playerPos, newPlayerPos																							: Vector;
	var movementAdjustor																											: CMovementAdjustor;
	var ticket 																														: SMovementAdjustmentRequestTicket;
	var targetDistance																												: float;
	var ent_1, ent_2, ent_3, vfxEnt_1, vfxEnt_2, skull_ent_1, skull_ent_2, skull_ent_3												: CEntity;
	var rot, attach_rot																												: EulerAngles;
   	var pos, attach_vec																												: Vector;
	var meshcomp																													: CComponent;
	var animcomp 																													: CAnimatedComponent;
	var playerRot, adjustedRot																										: EulerAngles;
	var temp, ent_1_temp, ent_2_temp																								: CEntityTemplate;
	var randAngle, randRange																										: float;
	var animatedComponentA																											: CAnimatedComponent;
	
	if (!this.IsAlive() || !this.HasTag('ACS_Vendigo'))
	{
		RemoveTimer('ACS_Vendigo_Spawn_Adds');

		return;
	}

	 if (
	(
	this.GetCurrentHealth() <= this.GetMaxHealth() * 0.5
	&& this.IsAlive()
	)
	)			
	{
		targetDistance = VecDistanceSquared2D( this.GetWorldPosition(), thePlayer.GetWorldPosition() ) ;

		if (targetDistance > 2.5 * 2.5 && targetDistance <= 20 * 20)
		{
			if ( !theSound.SoundIsBankLoaded("animals_deer.bnk") )
			{
				theSound.SoundLoadBank( "animals_deer.bnk", false );
			}

			if (!this.HasTag('ACS_Vendigo_Has_Summoned_Adds'))
			{
				this.AddTag('ACS_Vendigo_Has_Summoned_Adds');


				this.PlayEffect('sonar');
				this.PlayEffect('pre_sonar');
				this.PlayEffect('sonar_ready');
				this.PlayEffect('scream_01');
				this.PlayEffect('scream_02');

				this.StopEffect('sonar');
				this.StopEffect('pre_sonar');
				this.StopEffect('sonar_ready');
				this.StopEffect('scream_01');
				this.StopEffect('scream_02');


				vfxEnt_1 = theGame.CreateEntity( (CEntityTemplate)LoadResource(
				"dlc\bob\data\fx\gameplay\mutation\mutation_7\mutation_7.w2ent"
				, true ), this.GetWorldPosition(), this.GetWorldRotation() );

				vfxEnt_1.CreateAttachment( this, , Vector( 0, 0, 0 ), EulerAngles(0,0,0) );

				vfxEnt_1.PlayEffectSingle('sonar_mesh');

				vfxEnt_1.PlayEffectSingle('sonar');

				vfxEnt_1.PlayEffectSingle('fx_sonar');

				vfxEnt_1.DestroyAfter(2);



				vfxEnt_2 = theGame.CreateEntity( (CEntityTemplate)LoadResource(
					"dlc\dlc_acs\data\fx\acs_sonar.w2ent"
					, true ), this.GetWorldPosition(), this.GetWorldRotation() );

				vfxEnt_2.CreateAttachment( this, , Vector( 0, 0, 0 ), EulerAngles(0,0,0) );


				vfxEnt_2.PlayEffectSingle('sonar_mesh');

				vfxEnt_2.PlayEffectSingle('sonar');

				vfxEnt_2.PlayEffectSingle('fx_sonar');

				vfxEnt_2.DestroyAfter(2);




				movementAdjustor = ((CActor)this).GetMovingAgentComponent().GetMovementAdjustor();

				ticket = movementAdjustor.GetRequest( 'ACS_Vendigo_Smmmon_Rotate');
				movementAdjustor.CancelByName( 'ACS_Vendigo_Smmmon_Rotate' );
				movementAdjustor.CancelAll();

				ticket = movementAdjustor.CreateNewRequest( 'ACS_Vendigo_Smmmon_Rotate' );
				movementAdjustor.AdjustmentDuration( ticket, 0.5 );
				movementAdjustor.MaxRotationAdjustmentSpeed( ticket, 500000 );

				movementAdjustor.RotateTowards(ticket, ((CActor)(this.GetTarget())));

				((CAnimatedComponent)((CNewNPC)this).GetComponentByClassName( 'CAnimatedComponent' )).RaiseBehaviorForceEvent('Howl');

				if ( this.IsInInterior() )
				{
					((CActor)this).SetCanPlayHitAnim(false); 

					this.AddBuffImmunity(EET_Stagger, 'acs_vendigo_howl_interior', true);

					this.AddBuffImmunity(EET_LongStagger, 'acs_vendigo_howl_interior', true);

					this.AddBuffImmunity(EET_Knockdown , 'acs_vendigo_howl_interior', true);

					this.AddBuffImmunity(EET_HeavyKnockdown , 'acs_vendigo_howl_interior', true);
				}
				else
				{
					theSound.SoundEvent("animals_deer_die");
					theSound.SoundEvent("animals_deer_die");
					theSound.SoundEvent("animals_deer_die");
					theSound.SoundEvent("animals_deer_die");
					theSound.SoundEvent("animals_deer_die");
					theSound.SoundEvent("animals_deer_die");

					thePlayer.SoundEvent("animals_deer_die");
					thePlayer.SoundEvent("animals_deer_die");
					thePlayer.SoundEvent("animals_deer_die");
					thePlayer.SoundEvent("animals_deer_die");
					thePlayer.SoundEvent("animals_deer_die");
					thePlayer.SoundEvent("animals_deer_die");

					ent_1_temp = (CEntityTemplate)LoadResource( 

					"dlc\dlc_acs\data\entities\monsters\vendigo_spawn_melee.w2ent"
						
					, true );

					ent_2_temp = (CEntityTemplate)LoadResource( 

					"dlc\dlc_acs\data\entities\monsters\vendigo_spawn_melee_spear.w2ent"
						
					, true );

					playerPos = theCamera.GetCameraPosition() + theCamera.GetCameraDirection() * -10;

					if( !theGame.GetWorld().NavigationFindSafeSpot( playerPos, 0.3, 0.3 , newPlayerPos ) )
					{
						theGame.GetWorld().NavigationFindSafeSpot( playerPos, 0.5f, 10 , newPlayerPos );
						playerPos = newPlayerPos;
					}

					playerRot = thePlayer.GetWorldRotation();

					adjustedRot = EulerAngles(0,0,0);

					adjustedRot.Yaw = playerRot.Yaw;

					ent_1 = theGame.CreateEntity( ent_1_temp, ACSFixZAxis(playerPos), adjustedRot );

					((CNewNPC)ent_1).SetAttitude(this, AIA_Friendly);

					((CNewNPC)ent_1).SetLevel(this.GetLevel() - 3);

					((CNewNPC)ent_1).SetAttitude(((CActor)(this.GetTarget())), AIA_Hostile);


					((CActor)ent_1).AddBuffImmunity(EET_Confusion , 'ACS_Vendigo_Spawn_Buff', true);

					((CActor)ent_1).AddBuffImmunity(EET_Swarm , 'ACS_Vendigo_Spawn_Buff', true);

					((CActor)ent_1).AddBuffImmunity(EET_AxiiGuardMe , 'ACS_Vendigo_Spawn_Buff', true);

					((CActor)ent_1).AddBuffImmunity(EET_Blindness , 'ACS_Vendigo_Spawn_Buff', true);

					((CActor)ent_1).AddBuffImmunity(EET_Paralyzed , 'ACS_Vendigo_Spawn_Buff', true);

					((CActor)ent_1).AddTag('IsBoss');

					((CActor)ent_1).AddAbility('Boss');

					((CActor)ent_1).AddAbility('InstantKillImmune');

					((CActor)ent_1).AddAbility('DisableFinishers');

					((CActor)ent_1).AddAbility('MonsterMHBoss');

					((CActor)ent_1).AddAbility('BounceBoltsWildhunt');

					ent_1.AddTag('ACS_Vendigo_Spawn');




					ent_2 = theGame.CreateEntity( ent_2_temp, ACSFixZAxis(playerPos), adjustedRot );

					((CNewNPC)ent_2).SetAttitude(this, AIA_Friendly);

					((CNewNPC)ent_2).SetLevel( this.GetLevel() - 3 );

					((CNewNPC)ent_2).SetAttitude(((CActor)(this.GetTarget())), AIA_Hostile);


					((CActor)ent_2).AddBuffImmunity(EET_Confusion , 'ACS_Vendigo_Spawn_Buff', true);

					((CActor)ent_2).AddBuffImmunity(EET_Swarm , 'ACS_Vendigo_Spawn_Buff', true);

					((CActor)ent_2).AddBuffImmunity(EET_AxiiGuardMe , 'ACS_Vendigo_Spawn_Buff', true);

					((CActor)ent_2).AddBuffImmunity(EET_Blindness , 'ACS_Vendigo_Spawn_Buff', true);

					((CActor)ent_2).AddBuffImmunity(EET_Paralyzed , 'ACS_Vendigo_Spawn_Buff', true);

					((CActor)ent_2).AddTag('IsBoss');

					((CActor)ent_2).AddAbility('Boss');

					((CActor)ent_2).AddAbility('InstantKillImmune');

					((CActor)ent_2).AddAbility('DisableFinishers');

					((CActor)ent_2).AddAbility('MonsterMHBoss');

					((CActor)ent_2).AddAbility('BounceBoltsWildhunt');

					ent_2.AddTag('ACS_Vendigo_Spawn');


					if (RandF() < 0.5)
					{
						ent_3 = theGame.CreateEntity( ent_1_temp, ACSFixZAxis(playerPos), adjustedRot );
					}
					else
					{
						ent_3 = theGame.CreateEntity( ent_2_temp, ACSFixZAxis(playerPos), adjustedRot );
					}
					
					((CNewNPC)ent_3).SetAttitude(this, AIA_Friendly);

					((CNewNPC)ent_3).SetLevel(this.GetLevel() - 3);

					((CNewNPC)ent_3).SetAttitude(((CActor)(this.GetTarget())), AIA_Hostile);


					((CActor)ent_3).AddBuffImmunity(EET_Confusion , 'ACS_Vendigo_Spawn_Buff', true);

					((CActor)ent_3).AddBuffImmunity(EET_Swarm , 'ACS_Vendigo_Spawn_Buff', true);

					((CActor)ent_3).AddBuffImmunity(EET_AxiiGuardMe , 'ACS_Vendigo_Spawn_Buff', true);

					((CActor)ent_3).AddBuffImmunity(EET_Blindness , 'ACS_Vendigo_Spawn_Buff', true);

					((CActor)ent_3).AddBuffImmunity(EET_Paralyzed , 'ACS_Vendigo_Spawn_Buff', true);

					((CActor)ent_3).AddTag('IsBoss');

					((CActor)ent_3).AddAbility('Boss');

					((CActor)ent_3).AddAbility('InstantKillImmune');

					((CActor)ent_3).AddAbility('DisableFinishers');

					((CActor)ent_3).AddAbility('MonsterMHBoss');

					((CActor)ent_3).AddAbility('BounceBoltsWildhunt');

					ent_3.AddTag('ACS_Vendigo_Spawn');



					if (!((CNewNPC)ent_1).HasAbility('IsNotScaredOfMonsters'))
					{
						((CNewNPC)ent_1).AddAbility('IsNotScaredOfMonsters');
					}

					if (!((CNewNPC)ent_2).HasAbility('IsNotScaredOfMonsters'))
					{
						((CNewNPC)ent_2).AddAbility('IsNotScaredOfMonsters');
					}

					if (!((CNewNPC)ent_3).HasAbility('IsNotScaredOfMonsters'))
					{
						((CNewNPC)ent_3).AddAbility('IsNotScaredOfMonsters');
					}

					ent_1.PlayEffect('axii_hipnotize');
					ent_1.PlayEffect('axii_confusion');
					ent_1.PlayEffect('axii_guardian');
					ent_1.PlayEffect('axii_slowdown');
					ent_1.PlayEffect('demonic_possession');
					//ent_1.PlayEffect('ice');

					ent_2.PlayEffect('axii_hipnotize');
					ent_2.PlayEffect('axii_confusion');
					ent_2.PlayEffect('axii_guardian');
					ent_2.PlayEffect('axii_slowdown');
					ent_2.PlayEffect('demonic_possession');
					//ent_2.PlayEffect('ice');

					ent_3.PlayEffect('axii_hipnotize');
					ent_3.PlayEffect('axii_confusion');
					ent_3.PlayEffect('axii_guardian');
					ent_3.PlayEffect('axii_slowdown');
					ent_3.PlayEffect('demonic_possession');
					//ent_3.PlayEffect('ice');

					skull_ent_1 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

					"dlc\dlc_acs\data\models\vendigo\vendigo_spawn_skull.w2ent"

					, true ), playerPos, adjustedRot );

					skull_ent_1.CreateAttachment( ent_1, 'head', Vector( 0, 0.15, 0.4 ), EulerAngles(-45,180,0) );

					skull_ent_1.AddTag('ACS_Vendigo_Spawn_Skull');


					skull_ent_2 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

					"dlc\dlc_acs\data\models\vendigo\vendigo_spawn_skull.w2ent"

					, true ), playerPos, adjustedRot );

					skull_ent_2.CreateAttachment( ent_2, 'head', Vector( 0, 0.15, 0.4 ), EulerAngles(-45,180,0) );

					skull_ent_2.AddTag('ACS_Vendigo_Spawn_Skull');


					skull_ent_3 = theGame.CreateEntity( (CEntityTemplate)LoadResource( 

					"dlc\dlc_acs\data\models\vendigo\vendigo_spawn_skull.w2ent"

					, true ), playerPos, adjustedRot );

					skull_ent_3.CreateAttachment( ent_3, 'head', Vector( 0, 0.15, 0.4 ), EulerAngles(-45,180,0) );

					skull_ent_3.AddTag('ACS_Vendigo_Spawn_Skull');

					RemoveTimer('ACS_Werewolf_Spawn_Adds');
				}
			}
		}
	}
}

@wrapMethod( CActor ) function SetGuarded( flag : bool )
{
	var animatedComponentB																		: CAnimatedComponent;

	if (this.HasTag('ACS_Hit_Lag'))
	{
		animatedComponentB = (CAnimatedComponent)this.GetComponentByClassName( 'CAnimatedComponent' );

		animatedComponentB.UnfreezePose();

		animatedComponentB.UnfreezePoseFadeOut(0.1);

		this.RemoveTag('ACS_Hit_Lag');
	}

	wrappedMethod(flag);
}

@wrapMethod( CNewNPC ) function OnDeath( damageAction : W3DamageAction  )
{
	var droppeditemID, droppeditemIDVampireMonsterRing											: SItemUniqueId;
	var animatedComponentA																		: CAnimatedComponent;
	var actors, actors2 																		: array<CActor>;
	var i, j																					: int;
	var actor, actor2																			: CActor;
	var npc, npc_1																				: CNewNPC;
	var movementAdjustor, movementAdjustorNPC, movementAdjustorBigWraith						: CMovementAdjustor;
	var ticket, ticketNPC, ticket_1																: SMovementAdjustmentRequestTicket;
	var targetDistance, targetDistance_1														: float;
	var dmg																						: W3DamageAction;
	var anim_names																				: array< name >;
	var l_comp 																					: array< CComponent >;
	var size 																					: int;
	var bloodtentacle_proj_1																	: W3ACSBloodTentacles;
	var despawn_fx																				: CEntity;
	var animatedComponentB																		: CAnimatedComponent;

	wrappedMethod(damageAction);
	
	if (this.HasTag('ACS_Hit_Lag'))
	{
		animatedComponentB = (CAnimatedComponent)this.GetComponentByClassName( 'CAnimatedComponent' );

		animatedComponentB.UnfreezePose();

		animatedComponentB.UnfreezePoseFadeOut(0.1);

		this.RemoveTag('ACS_Hit_Lag');
	}

	//((CActor)this).FreezeCloth(true);

	RemoveTimers();

	ACS_Ghoul_Base_On_Take_Damage(damageAction);

	ACS_Siren_Base_On_Take_Damage(damageAction);

	ACS_Bruxa_On_Take_Damage(damageAction);

	ACS_Red_Blood_Death_On_Take_Damage(damageAction);

	if (HasTag('ACS_man_finisher_dlc_arm_lp_combat_dismember')
	|| HasTag('ACS_man_finisher_dlc_arm_rp_combat_dismember')
	|| HasTag('ACS_man_finisher_dlc_legs_lp_combat_dismember')
	|| HasTag('ACS_man_finisher_dlc_legs_rp_combat_dismember')
	|| HasTag('ACS_2HandWeaponDestroyed')
	//|| HasTag('ACS_Final_Fear_Stack')
	)
	{
		AddEffectDefault( EET_Stagger, GetWitcherPlayer(), 'ACS_Combat_Dismember_Debuff' );	
	}

	if(
	this.HasTag('ACS_Ice_Titan')
	)
	{
		if (!this.IsAlive())
		{
			if(!this.HasTag('acs_ice_titan_despawn'))
			{
				despawn_fx = (CEntity)theGame.CreateEntity( 
				(CEntityTemplate)LoadResource( 
					"dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent"
					, true ), ACSFixZAxis(this.GetWorldPosition()) );

				despawn_fx.DestroyAfter(10);	

				despawn_fx.SoundEvent("magic_eredin_icespike_tell_explosion");

				despawn_fx.PlayEffect('ice_line');

				despawn_fx.PlayEffect('ice_spikes');

				despawn_fx.PlayEffect('ice_explode');

				despawn_fx.PlayEffect('ice_explode_2');

				despawn_fx.PlayEffect('blast_ground_mutation_6_aard');

				despawn_fx.PlayEffect('cone_ground_mutation_6_aard');

				if (
				RandF() < 0.5
				&& !thePlayer.inv.HasItem('acs_frost_giant_item')
				&& !GetWitcherPlayer().GetHorseManager().GetInventoryComponent().HasItem( 'acs_frost_giant_item' )
				)
				{
					this.GetInventory().AddAnItem( 'acs_frost_giant_item' , 1 );

					droppeditemID = this.GetInventory().GetItemId('acs_frost_giant_item');

					this.GetInventory().DropItemInBag(droppeditemID, 1);
				}

				this.DestroyAfter(3);


				this.AddTag('acs_ice_titan_despawn');		
			}
		}
	}
	else if(
	this.HasTag('ACS_Blade_Of_The_Unseen')
	)
	{
		if (!this.IsAlive())
		{
			if(!this.HasTag('acs_unseen_blade_despawn'))
			{
				ACSGetCEntity('ACS_Blade_Of_The_Unseen_L_Blade').Destroy();

				ACSGetCEntity('ACS_Unseen_Blade_L_Anchor').Destroy();

				ACSGetCEntity('ACS_Blade_Of_The_Unseen_R_Blade').Destroy();

				ACSGetCEntity('ACS_Unseen_Blade_R_Anchor').Destroy();

				ACS_VampireBatsSpawnEffect(this.GetWorldPosition());

				RemoveTimer('unseen_blade_spawn_delay');

				RemoveTimer('unseen_blade_hunt_delay');

				this.SetVisibility(false);

				this.StopAllEffects();

				this.DestroyAfter(1);

				if (GetACSStorage().unseen_blade_death_count == 0)
				{
					GetWitcherPlayer().DisplayHudMessage( GetLocStringById(2118449944) );
				}
				else if (GetACSStorage().unseen_blade_death_count == 1)
				{
					GetWitcherPlayer().DisplayHudMessage( GetLocStringById(2118449945) );
				}
				else if (GetACSStorage().unseen_blade_death_count == 2)
				{
					GetWitcherPlayer().DisplayHudMessage( GetLocStringById(2118449946) );

					GetACSWatcher().AddTimer('Unseen_Monster_Summon', 5 , false );
				}

				GetACSStorage().acs_Number_Of_Unseen_Blade_Slain_Manage(false);

				

				this.AddTag('acs_unseen_blade_despawn');

				
			}
		}
	}
	else if(
	this.HasTag('novigrad_underground_vampire')
	)
	{
		if (!this.IsAlive())
		{
			if(!this.HasTag('novigrad_underground_vampire_despawn'))
			{
				GetWitcherPlayer().DisplayHudMessage( GetLocStringById(2118449947) );

				ACS_VampireBatsSpawnEffect(this.GetWorldPosition());

				if (!thePlayer.inv.HasItem('acs_quen_monster_item')
				&& !GetWitcherPlayer().GetHorseManager().GetInventoryComponent().HasItem( 'acs_quen_monster_item' )
				)
				{

					this.GetInventory().AddAnItem( 'acs_quen_monster_item', 1 );
				}

				droppeditemID = this.GetInventory().GetItemId('acs_quen_monster_item');

				this.GetInventory().DropItemInBag(droppeditemID, 1);

				this.SetVisibility(false);

				this.StopAllEffects();

				

				this.AddTag('novigrad_underground_vampire_despawn');

				
			}
		}

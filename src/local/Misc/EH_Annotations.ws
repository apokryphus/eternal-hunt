@wrapMethod( CR4InventoryMenu ) function OnConsumeItem( itemId : SItemUniqueId)
{
	wrappedMethod(itemId);

	if (
	GetWitcherPlayer().inv.GetItemCategory(itemId) == 'potion'
	|| GetWitcherPlayer().inv.ItemHasTag(itemId, 'Potion')
	|| (GetWitcherPlayer().inv.ItemHasTag(itemId, 'Edibles') && GetWitcherPlayer().inv.ItemHasTag(itemId, 'Drinks'))
	|| (GetWitcherPlayer().inv.GetItemCategory(itemId) == 'alchemy_ingredient' && GetWitcherPlayer().inv.ItemHasTag(itemId, 'StrongAlcohol'))
	)
	{
		m_player.RaiseEvent('ACS_DrinkPotion');
	}
	else
	{
		m_player.RaiseEvent('ACS_EatEdible');
	}
}

@wrapMethod( CBTTaskCollideWithCharacter ) function OnListenedGameplayEvent( eventName : name ) : bool
{
	if ((GetACSWatcher().ACS_IS_SNEAKING
	|| thePlayer.HasTag('ACS_Is_Sneaking'))
	&& !thePlayer.HasTag('ACS_IsPerformingCounterWound')
	&& !thePlayer.HasTag('ACS_IsPerformingFinisher')
	&& GetActor().IsAlive()
	&& GetActor().GetAttitude( thePlayer ) == AIA_Hostile
	&& !ACSGetCActor('ACS_Stab_Hostage')
	)
	{
		GetACSWatcher().RemoveTimer('PlayEnemyAlertSound');

		GetACSWatcher().AddTimer('PlayEnemyAlertSound', 0.125, false);

		GetACSWatcher().RemoveSneaking(true);
	}

	return wrappedMethod(eventName);
}

@addField(W3Potion_Blizzard)
private var acsBlizzardActive				: bool;

@addField(W3Potion_Blizzard)
private var acs_blizzard_switch_cooldown				: float;

@wrapMethod(W3Potion_Blizzard) function OnTimeUpdated(dt : float)
{
	if(false) 
	{
		wrappedMethod(dt);
	}
		
	if( thePlayer.IsInCombat() )
	{
		if
		(
			theInput.GetActionValue('HighlightObjective') > 0.1f 
			&& (theInput.GetActionValue('LockAndGuard') > 0.1f 
			|| theInput.GetActionValue('Guard') > 0.1f)
		)	
		{
			if (theGame.GetEngineTimeAsSeconds() - acs_blizzard_switch_cooldown > 0.5)
			{
				acs_blizzard_switch_cooldown = theGame.GetEngineTimeAsSeconds();

				if (!acsBlizzardActive)
				{
					GetACSStorage().acs_deleteOnelinerByTag("ACS_BlizzardEnabledNotification");

					ACS_Oneliner(
					(new ACS_Oneliner_TagBuilder in theGame)
					.tag("font")
					.attr("size", "27")
					.attr("color", "#00a2ff")
					.text(GetLocStringById(368877) + "<br/>" + GetLocStringById(2118449902))
					, thePlayer, "ACS_BlizzardEnabledNotification", Vector(0,0,1.25), 1);

					GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_BlizzardEnabledNotification", 100);

					GetACSStorage().acs_setScaleForOnelinerByTag("ACS_BlizzardEnabledNotification", 100, 100, 100);

					theGame.SetTimeScale( slowdownFactor, theGame.GetTimescaleSource(ETS_PotionBlizzard), theGame.GetTimescalePriority(ETS_PotionBlizzard) );

					if(!isScreenFxActive)
					{
						EnableScreenFx(true);
					}

					acsBlizzardActive = true;
				}
				else
				{
					RemoveSlowMo();
				}
			}
		}
	}
	else
	{
		RemoveSlowMo();
	}

	ACS_Tutorial_Display_Check('ACS_Blizzard_Tutorial_Shown');
	
	super.OnTimeUpdated(dt);
}

@wrapMethod(W3Potion_Blizzard) function RemoveSlowMo()
{
	if (acsBlizzardActive)
	{

		GetACSStorage().acs_deleteOnelinerByTag("ACS_BlizzardEnabledNotification");

		ACS_Oneliner(
		(new ACS_Oneliner_TagBuilder in theGame)
		.tag("font")
		.attr("size", "27")
		.attr("color", "#00a2ff")
		.text(GetLocStringById(368877) + "<br/>" + GetLocStringById(2118449903))
		, thePlayer, "ACS_BlizzardEnabledNotification", Vector(0,0,1.25), 1.5);

		GetACSStorage().acs_setAlphaForOnelinerByTag("ACS_BlizzardEnabledNotification", 100);

		GetACSStorage().acs_setScaleForOnelinerByTag("ACS_BlizzardEnabledNotification", 100, 100, 100);
	}

	acsBlizzardActive = false;

	//target.ACS_SetAnimationSpeedMultiplier(1);

	//target.ACS_ClearAnimationSpeedMultipliers();

	wrappedMethod();
}

@wrapMethod(W3Potion_Blizzard) function IsSlowMoActive() : bool
{
	if(false) 
	{
		wrappedMethod();
	}

	if( thePlayer.IsInCombat() )
	{
		return true;
	}

	return false;
}

@wrapMethod(CR4HudModuleRadialMenu) function OnRadialMenu( action : SInputAction )
{
	var altSignCasting 						: bool;

	if(false) 
	{
		wrappedMethod(action);
	}

	if(theGame.GetInGameConfigWrapper().GetVarValue('Gameplay', 'EnableAlternateSignCasting') == "1")
	{
		altSignCasting = true;
	}	
	else
	{
		altSignCasting = false;
	}
	
	if( altSignCasting && !theInput.LastUsedPCInput() && theInput.IsActionPressed('CastSign'))
	{
		return false;
	}


	if( IsPressed(action) )
	{
		if( m_shown )
		{
			
			
			return true;
		}
		if(!thePlayer.IsActionAllowed(EIAB_RadialMenu))
		{
			thePlayer.DisplayActionDisallowedHudMessage(EIAB_RadialMenu);
			return false;
		}
	
		if ( theGame.IsDialogOrCutscenePlaying() || theGame.IsBlackscreenOrFading() || (!thePlayer.GetBIsInputAllowed() && !GetWitcherPlayer().IsUITakeInput()) )
			return false;
			
		ShowRadialMenu();
		
	}
}

@wrapMethod(W3SignOwnerPlayer) function ChangeAspect( signEntity : W3SignEntity, newSkill : ESkill ) : bool
{
	var newTarget : CActor;
	var ret : bool;
	var shouldAltCast : bool;
	var altInputHeld : bool;

	if (ACS_Is_DLC_Installed('dlc_spectre'))
	{
		return wrappedMethod(signEntity, newSkill);
	}
	
	if(!theInput.LastUsedPCInput() && thePlayer.GetInputHandler().GetIsAltSignCasting())
	{
		if( ((W3AardEntity)signEntity) && (theInput.IsActionPressed('Sprint') || theInput.IsActionPressed('CbtRoll') || theInput.IsActionPressed('ACSAltAard')) )
		{
			shouldAltCast = true;
		} 
		else if( ((W3IgniEntity)signEntity) && (theInput.IsActionPressed('LockAndGuard') || theInput.IsActionPressed('Focus') || theInput.IsActionPressed('ACSAltIgni')) )
		{
			shouldAltCast = true;
		}
		else if( ((W3YrdenEntity)signEntity) && (theInput.IsActionPressed('AttackHeavy') || theInput.IsActionPressed('ACSAltYrden')))
		{
			shouldAltCast = true;
		}
		else if( ((W3QuenEntity)signEntity) && (theInput.IsActionPressed('AltQuenCasting') || theInput.IsActionPressed('Dodge') || theInput.IsActionPressed('ACSAltQuen')) )
		{
			shouldAltCast = true;
		}
		else if( ((W3AxiiEntity)signEntity) && (theInput.IsActionPressed('AttackLight') || theInput.IsActionPressed('ACSAltAxii')) )
		{
			shouldAltCast = true;
		}
	}
	else if(theInput.LastUsedPCInput() && thePlayer.GetInputHandler().GetIsAltSignCasting())
	{
		if( ((W3AardEntity)signEntity) && (theInput.IsActionPressed('SelectAard') || theInput.IsActionPressed( 'CastSign' )) )
		{
			shouldAltCast = true;
			altInputHeld = true;
		} 
		else if( ((W3IgniEntity)signEntity) && (theInput.IsActionPressed('SelectIgni') || theInput.IsActionPressed( 'CastSign' )) )
		{
			shouldAltCast = true;
			altInputHeld = true;
		}
		else if( ((W3YrdenEntity)signEntity) && (theInput.IsActionPressed('SelectYrden') || theInput.IsActionPressed( 'CastSign' )) )
		{
			shouldAltCast = true;
			altInputHeld = true;
		}
		else if( ((W3QuenEntity)signEntity) && (theInput.IsActionPressed('SelectQuen') || theInput.IsActionPressed( 'CastSign' )) )
		{
			shouldAltCast = true;
			altInputHeld = true;
		}
		else if( ((W3AxiiEntity)signEntity) && (theInput.IsActionPressed('SelectAxii') || theInput.IsActionPressed( 'CastSign' )) )
		{
			shouldAltCast = true;
			altInputHeld = true;
		}
	}
	else
	{
		shouldAltCast = true;
	}
	

	if ( !player.CanUseSkill( newSkill ) )
	{
		ret = false;
	}	
	else if ( (theInput.IsActionPressed( 'CastSign' ) || theInput.GetActionValue( 'CastSignHold' ) > 0.f || altInputHeld) && shouldAltCast ) 
	{
		if ( !player.IsCombatMusicEnabled() && !player.CanAttackWhenNotInCombat( EBAT_CastSign, true, newTarget ) )
		{
			ret = false;
		}
		else if( player.HasBuff( EET_GryphonSetBonus ) && player.GetStatPercents( BCS_Stamina ) < 1.f )
		{
			ret = false;
		}
		else
		{
			signEntity.SetAlternateCast( newSkill );
			player.SetBehaviorVariable( 'alternateSignCast', 1 );
			ret = true;
		}
	}
	else 
	{
		ret = false;
	}
	
	if(!ret)
		signEntity.OnNormalCast();
	
	return ret;
}


@wrapMethod( CR4Player) function GoToCombatIfNeeded( optional enemy : CActor ) : bool
{
	if (thePlayer.IsActionAllowed(EIAB_Movement)
	&& ACS_Settings_Main_Bool('acs_movement_main_settings','acs_auto_climb_enabled', true)
	)
	{
		if (
		thePlayer.substateManager.GetStateCur() == 'Jump' 
		|| thePlayer.substateManager.GetStateCur() == 'Interaction' 
		|| thePlayer.substateManager.GetStateCur() == 'Climb'
		|| thePlayer.substateManager.GetStateCur() == 'Slide'
		)
		{
			return false;
		}
		
		if (
		(theInput.IsActionPressed('Sprint') || thePlayer.GetIsSprinting())
		&& (theInput.GetActionValue('GI_AxisLeftX') != 0 || theInput.GetActionValue('GI_AxisLeftY') != 0) 
		)
		{
			return false;
		}
	}

	return wrappedMethod(enemy);
}


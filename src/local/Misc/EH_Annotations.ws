@wrapMethod(W3PlayerAbilityManager) function GainStat( stat : EBaseCharacterStats, amount : float )
{
	
	if(stat == BCS_Focus)
	{
		if (owner.HasTag('ACS_In_Combat_Art')
		|| owner.HasTag('ACS_In_Heavenly_Strike')
		|| owner.HasTag('ACS_In_Dance_Of_Wrath')
		|| owner.HasTag('ACS_Ghost_Stance_Active')
		|| owner.HasTag('ACS_Flammable_Oil_Enabled')
		)
		{
			return;
		}
	}

	wrappedMethod(stat, amount);
}

@wrapMethod(CR4DeathScreenMenu) function PopulateData()
{
	var l_FlashArray			: CScriptedFlashArray;
	var l_DataFlashObject 		: CScriptedFlashObject;	
	var itemIds 				: array<SItemUniqueId>;
	var acorn_count 			: int;

	if (false)
	{
		wrappedMethod();
	}

	theSound.EnterGameState(ESGS_Default);
	theSound.SoundEvent( 'thrudeath_bb_acs' );
	
	l_FlashArray = m_flashValueStorage.CreateTempFlashArray();
			
	hasSaveData = hasSaveDataToLoad();

	if( hasSaveData )
	{
		l_DataFlashObject = m_flashValueStorage.CreateTempFlashObject();	
		l_DataFlashObject.SetMemberFlashString	( "label", GetLocStringByKeyExt("panel_button_deathscreen_respawn") );
		l_DataFlashObject.SetMemberFlashUInt	( "tag", NameToFlashUInt('Respawn') );
		l_FlashArray.PushBackFlashObject( l_DataFlashObject );
		
		l_DataFlashObject = m_flashValueStorage.CreateTempFlashObject();	
		l_DataFlashObject.SetMemberFlashString( "label", GetPlatformLocString("panel_button_deathscreen_load" ) );
		l_DataFlashObject.SetMemberFlashUInt	( "tag", NameToFlashUInt('Load') );
		l_FlashArray.PushBackFlashObject( l_DataFlashObject );
	}
	
	l_DataFlashObject = m_flashValueStorage.CreateTempFlashObject();	
	l_DataFlashObject.SetMemberFlashString	( "label", GetLocStringByKeyExt("panel_button_common_quittomainmenu") );
	l_DataFlashObject.SetMemberFlashUInt	( "tag", NameToFlashUInt('Quit') );
	l_FlashArray.PushBackFlashObject( l_DataFlashObject );
	
	if (FactsQuerySum("ACS_Allow_Resurrection") > 0 )
	{
		itemIds.Clear();

		itemIds = thePlayer.inv.GetItemsByName('q111_imlerith_acorn');

		if (itemIds.Size() > 0)
		{
			acorn_count = thePlayer.inv.GetItemQuantityByName('q111_imlerith_acorn');
		}

		l_DataFlashObject = m_flashValueStorage.CreateTempFlashObject();
		l_DataFlashObject.SetMemberFlashString	( "label", GetLocStringByKeyExt("panel_button_deathscreen_resurrect") + " [" + GetLocStringById(2116581048) + " " + IntToString(acorn_count) + "]");
		l_DataFlashObject.SetMemberFlashUInt	( "tag", NameToFlashUInt('DebugResurrect') );
		l_FlashArray.PushBackFlashObject( l_DataFlashObject );
	}

	m_flashValueStorage.SetFlashArray( "hud.deathscreen.list", l_FlashArray );
}

@wrapMethod(CR4Player) function CheatResurrect()
{
	var music_array										: array<string>;

	if (false)
	{
		wrappedMethod();
	}

	if(IsAlive())
	{
		return;
	}

	if ( !theGame.GetGuiManager().GetRootMenu() )
	{
		Log(" *** Call this function after DeathScreen appears *** ");
		return;
	}

	theGame.CloseMenu('DeathScreenMenu');

	theSound.SoundEvent("play_music_nomansgrad");

	if (FactsQuerySum("ACS_Resurrection_Music_Switch") <= 0 )
	{
		theSound.SoundEvent("mus_q103_blood_ritual");

		FactsAdd("ACS_Resurrection_Music_Switch", 1, -1);
	}
	else
	{
		theSound.SoundEvent("mus_mq1060_14_geralt_dead");

		FactsRemove("ACS_Resurrection_Music_Switch");
	}

	if (FactsQuerySum("ACS_Killed_By_Gaunter") > 0 )
	{
		FactsRemove("ACS_Killed_By_Gaunter");
	}

	if (FactsQuerySum("ACS_Killed_By_Blade_Of_The_Unseen") > 0 )
	{
		FactsRemove("ACS_Killed_By_Blade_Of_The_Unseen");
	}

	if (FactsQuerySum("ACS_Allow_Resurrection") > 0 )
	{
		thePlayer.inv.RemoveItemByName('q111_imlerith_acorn', 1);

		FactsRemove("ACS_Allow_Resurrection");
	}

	thePlayer.BlockAllActions( 'ACS_Death_Scene', false );

	theSound.SoundEvent("gui_gwint_resurrect");
	theSound.SoundEvent("monster_caretaker_fx_black_exhale");

	thePlayer.StopAllEffects();

	thePlayer.DestroyEffect('death_glow');
	thePlayer.DestroyEffect('demon_dark_line_cs');

	thePlayer.PlayEffect('death_glow');
	thePlayer.PlayEffect('demon_dark_line_cs');

	RemoveTimer('ACS_CheatRessurectFadeEarly');
	AddTimer('ACS_CheatRessurectFadeEarly', 7 , false );

	RemoveTimer('ACS_CheatRessurectTimerDetection');
	AddTimer('ACS_CheatRessurectTimerDetection', 0.00001 , true);
}

@addMethod(CR4Player) timer function ACS_CheatRessurectFadeEarly( detlaTime : float , id : int)
{
	theGame.FadeOutAsync( 0.5 , Color(0,0,0) );
}

@addMethod(CR4Player) timer function ACS_CheatRessurectTimerDetection( detlaTime : float , id : int)
{
	var items 		: array< SItemUniqueId >;
	var i, size, itemLevel, maxPrice, itemPrice 	: int;
	var itemToEquip : SItemUniqueId;

	if ( !theGame.IsDialogOrCutscenePlaying() 
	&& !theGame.IsPaused() 
	&& !theGame.GetPhotomodeEnabled() 
	&& !thePlayer.IsInCutsceneIntro() 
	&& !theGame.IsCurrentlyPlayingNonGameplayScene() 
	&& !IsAlive()
	)
	{
		RemoveTimer('ACS_CheatRessurectFadeEarly');

		thePlayer.StopEffect('demon_dark_line_cs');

		DeactivateEnvironment(GetACSWatcher().deathEnvID, 1);

		FactsRemove("ACS_Killed_By_Blade_Of_The_Unseen");
		
		((CAnimatedComponent)thePlayer.GetComponentByClassName('CAnimatedComponent')).UnfreezePose();

		thePlayer.StopEffect('blood');
		thePlayer.StopEffect('death_blood');
		thePlayer.StopEffect('heavy_hit');
		thePlayer.StopEffect('light_hit');
		thePlayer.StopEffect('blood_spill');
		thePlayer.StopEffect('fistfight_heavy_hit');
		thePlayer.StopEffect('heavy_hit_horseriding');
		thePlayer.StopEffect('fistfight_hit');
		thePlayer.StopEffect('critical hit');
		thePlayer.StopEffect('death_hit');
		thePlayer.StopEffect('blood_throat_cut');
		thePlayer.StopEffect('hit_back');
		thePlayer.StopEffect('standard_hit');
		thePlayer.StopEffect('critical_bleeding'); 
		thePlayer.StopEffect('fistfight_hit_back'); 
		thePlayer.StopEffect('heavy_hit_back'); 
		thePlayer.StopEffect('light_hit_back'); 

		theGame.RemoveTimeScale( theGame.GetTimescaleSource(ETS_DebugInput) );
		
		SetAlive(true);
		
		SetKinematic(true);

		EnableFindTarget( true );
		SetBehaviorVariable( 'Ragdoll_Weight', 0.f );
		RaiseForceEvent( 'RecoverFromRagdoll' );
		SetCanPlayHitAnim( true );
		SetBehaviorVariable( 'CriticalStateType', (int)ECST_None );		
		GoToStateIfNew('Exploration');	

		( (CDismembermentComponent)this.GetComponent( 'Dismemberment' ) ).ClearVisibleWound();
		
		SetIsInAir(false);	
		
		theInput.SetContext('Exploration');
		
		ResetDeathType();
		
		ForceUnlockAllInputActions(false);

		abilityManager.ForceSetStat(BCS_Vitality, GetStatMax(BCS_Vitality) * 0.25f);
		effectManager.StopVitalityRegen();
		abilityManager.ForceSetStat( BCS_Air , 100.f );
		effectManager.StopAirRegen();
		abilityManager.ForceSetStat( BCS_Stamina , 100.f );
		effectManager.StopStaminaRegen();
		abilityManager.ForceSetStat( BCS_Toxicity , 0.f );
		abilityManager.ForceSetStat( BCS_Focus , 100.f );
		GetWitcherPlayer().UpdateEncumbrance();

		
		if ( !inv.IsThereItemOnSlot( EES_SteelSword ) )
		{
			items = inv.GetItemsByCategory( 'steelsword' );
		}
		else if ( !inv.IsThereItemOnSlot( EES_SilverSword ) )
		{
			items = inv.GetItemsByCategory( 'silversword' );
		}
		
		size = items.Size();
		maxPrice = -1;
		for ( i = 0; i < size; i += 1 )
		{
			itemPrice = inv.GetItemPrice(items[i]);
			itemLevel = inv.GetItemLevel(items[i]);
			if ( itemLevel <= GetLevel() && itemPrice > maxPrice )
			{
				maxPrice = itemPrice;
				itemToEquip = items[i];
			}
		}
		if( inv.IsIdValid( itemToEquip ) )
		{
			EquipItem( itemToEquip , , true );
		}

		theSound.InitializeAreaMusic( theGame.GetCommonMapManager().GetCurrentArea() );

		thePlayer.PlayEffectSingle('ethereal_appear');
		thePlayer.StopEffect('ethereal_appear');

		thePlayer.PlayEffectSingle('ethereal_buff');
		thePlayer.StopEffect('ethereal_buff');

		RemoveTimer('ACS_CheatRessurectDelay');
		AddTimer('ACS_CheatRessurectDelay', 0.5 , false );

		thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( 'locomotion_man_geralt_back_getup_normal', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0, 0) );

		RemoveTimer('ACS_CheatRessurectTimerDetection');
	}
}

@addMethod( CR4Player ) timer function ACS_CheatRessurectDelay(deltaTime : float , id : int)
{
	theGame.FadeInAsync( 0.5 );

	theGame.ReleaseNoSaveLock(deathNoSaveLock);

	GetACSWatcher().Fear_Stack();

	thePlayer.SetImmortalityMode( AIM_None, AIC_Default, true );

	thePlayer.RemoveBuffImmunity_AllNegative('ACS_Death'); 

	thePlayer.RemoveBuffImmunity_AllCritical('ACS_Death'); 

	thePlayer.BlockAllActions( 'ACS_Death_Scene', false );

	GetACSWatcher().DeathSceneEnabled(false);
}

@wrapMethod(Crossbow) function PlayOwnerReloadAnim() : bool
{
	if (thePlayer.HasTag('ACS_SkipCrossbowAnim'))
	{
		thePlayer.RemoveTag('ACS_SkipCrossbowAnim');

		return false;
	}

	return wrappedMethod();
}

@wrapMethod(RangedWeapon) function OnForceHolster( optional forceUpperBodyAnim, instant, dropItem : bool ) 
{
	if (!thePlayer.HasTag('ACS_SkipCrossbowAnim'))
	{
		thePlayer.AddTag('ACS_SkipCrossbowAnim');
	}

	wrappedMethod(forceUpperBodyAnim, instant, dropItem);
}


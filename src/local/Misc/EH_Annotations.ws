					else 
					{
						GetACSWatcher().weapon_blood_fx('green');

						vfxEnt.PlayEffectSingle('blood_spatter_green');
					}
				}
				else if( (GetACSWatcher().counter_wound_target).GetBloodType() == BT_Yellow) 
				{
					if ((GetACSWatcher().counter_wound_target).HasAbility('mon_archespor_base'))
					{
						GetACSWatcher().weapon_blood_fx('yellow');

						vfxEnt.PlayEffectSingle('blood_spatter_yellow');
					} 
					else 
					{
						GetACSWatcher().weapon_blood_fx('red');

						vfxEnt.PlayEffectSingle('blood_spatter_red');
					}
				}
				else if	( (GetACSWatcher().counter_wound_target).GetBloodType() == BT_Black) 
				{
					if ( mc == MC_Vampire ) 
					{
						GetACSWatcher().weapon_blood_fx('red');

						vfxEnt.PlayEffectSingle('blood_spatter_red');
					}
					else if ( mc == MC_Magicals ) 
					{
						if ((GetACSWatcher().counter_wound_target).HasAbility('mon_golem_base')
						|| (GetACSWatcher().counter_wound_target).HasAbility('mon_djinn')
						|| (GetACSWatcher().counter_wound_target).HasAbility('mon_gargoyle')
						)
						{
							GetACSWatcher().weapon_blood_fx('black');

							vfxEnt.PlayEffectSingle('blood_spatter_black');
						}
						else
						{
							GetACSWatcher().weapon_blood_fx('red');

							vfxEnt.PlayEffectSingle('blood_spatter_red');
						}
					}
					else
					{
						GetACSWatcher().weapon_blood_fx('black');

						vfxEnt.PlayEffectSingle('blood_spatter_black');
					}
				}

				SoundEvent("damage_01_bb_acs");

				SoundEvent("damage_02_bb_acs");

				SoundEvent("cmb_play_dismemberment_gore");

				SoundEvent("monster_dettlaff_monster_vein_hit_blood");

				SoundEvent("cmb_play_hit_heavy");
			}

			if ( animEventType == AET_DurationEnd )
			{
				movementAdjustorFinisher = thePlayer.GetMovingAgentComponent().GetMovementAdjustor();

				movementAdjustorFinisher.CancelAll();
				
				ticketFinisher = movementAdjustorFinisher.CreateNewRequest( 'ACS_Finisher_Rotate' );
					
				movementAdjustorFinisher.AdjustmentDuration( ticketFinisher, 0.5 );

				movementAdjustorFinisher.ShouldStartAt(ticketFinisher,thePlayer.GetWorldPosition());
				movementAdjustorFinisher.MaxRotationAdjustmentSpeed( ticketFinisher, 5000000 );
				movementAdjustorFinisher.MaxLocationAdjustmentSpeed( ticketFinisher, 5000000 );

				movementAdjustorFinisher.RotateTowards( ticketFinisher, (GetACSWatcher().counter_wound_target) );

				movementAdjustorFinisher.SlideTo(ticketFinisher, thePlayer.GetWorldPosition() + thePlayer.GetWorldForward() * -3);

				if (thePlayer.IsLastEnemyKilled())
				{
					thePlayer.ACS_SetAnimationSpeedMultiplier(1);

					GetACSWatcher().CounterWoundEndAnimationSwitch();
				}
				else
				{
					thePlayer.RaiseEvent('ACS_AimAssistDodgeForwardR');

					thePlayer.ACS_SetAnimationSpeedMultiplier(2);

					GetACSWatcher().RemoveTimer('ACS_ResetAnimation'); 
					
					GetACSWatcher().AddTimer('ACS_ResetAnimation', 0.5   , false );
				}
				

				thePlayer.RaiseEvent('ACS_AimAssistDodgeForwardR');
			
				thePlayer.StopEffect('jump_ground_fx1');
				thePlayer.PlayEffect('jump_ground_fx1');

				thePlayer.PlayEffectSingle('acs_fast_sprint_trail');
				thePlayer.StopEffect('acs_fast_sprint_trail');
			}
		break;

		case 'acs_counter_wound_stab':
			if ( animEventType == AET_DurationStart )
			{
				(GetACSWatcher().counter_wound_target).ACS_SetAnimationSpeedMultiplier(1);

				thePlayer.DestroyEffect('hit_screen');
				thePlayer.PlayEffectSingle('hit_screen');

				if ((GetACSWatcher().counter_wound_target).IsAlive())
				{
					GetACSWatcher().CreateCounterWoundSwordFX(GetACSWatcher().counter_wound_target);

					((CAnimatedComponent)thePlayer.GetComponentByClassName( 'CAnimatedComponent' )).UnfreezePose();

					((CAnimatedComponent)thePlayer.GetComponentByClassName( 'CAnimatedComponent' )).FreezePoseFadeIn(0.5);

					thePlayer.AddTag('ACS_Player_Hit_Lag');

					thePlayer.RemoveTimer('ACS_PlayerUnfreezePose');

					thePlayer.AddTimer('ACS_PlayerUnfreezePose', 0.25f, false );

					dmg = new W3DamageAction in theGame.damageMgr;
			
					dmg.Initialize(thePlayer, GetACSWatcher().counter_wound_target, NULL, thePlayer.GetName(), EHRT_Heavy, CPS_Undefined, false, false, true, false);
					
					dmg.SetHitReactionType(EHRT_Heavy, true);

					dmg.SetHitAnimationPlayType(EAHA_ForceYes);
					
					if (thePlayer.IsDeadlySwordHeld())
					{
						dmg.SetForceExplosionDismemberment();
					}

					if ( ((CNewNPC)GetACSWatcher().counter_wound_target).acs_backstab_wound_fx
					&& ((CNewNPC)GetACSWatcher().counter_wound_target).acs_backstab_wound_fx.HasTag('ACS_Counter_Wound_Disable') 
					&& thePlayer.HasTag('ACS_Is_Sneaking')
					&& GetACSWatcher().ACS_IS_SNEAKING
					)
					{
						if (((CMovingPhysicalAgentComponent)(((CNewNPC)GetACSWatcher().counter_wound_target).GetMovingAgentComponent())).GetCapsuleHeight() >= 2
						|| ((CNewNPC)GetACSWatcher().counter_wound_target).GetRadius() >= 0.7
						|| ((CNewNPC)GetACSWatcher().counter_wound_target).HasAbility('Boss')
						|| ((CNewNPC)GetACSWatcher().counter_wound_target).HasTag('IsBoss')
						|| ((CNewNPC)GetACSWatcher().counter_wound_target).HasTag('ACS_Big_Boi')
						|| GetACSWatcher().sneaking_initiated_in_combat
						)
						{
							if (thePlayer.IsDeadlySwordHeld())
							{
								if ((GetACSWatcher().counter_wound_target).UsesEssence()
								)
								{
									dmg.AddDamage( theGame.params.DAMAGE_NAME_SILVER, (GetACSWatcher().counter_wound_target).GetCurrentHealth() * 0.25 );
								}
								else if ((GetACSWatcher().counter_wound_target).UsesVitality()
								)
								{
									dmg.AddDamage( theGame.params.DAMAGE_NAME_PHYSICAL, (GetACSWatcher().counter_wound_target).GetCurrentHealth() * 0.25 );
								}
							}
							else
							{
								if ((GetACSWatcher().counter_wound_target).UsesEssence()
								)
								{
									dmg.AddDamage( theGame.params.DAMAGE_NAME_SILVER, (GetACSWatcher().counter_wound_target).GetCurrentHealth() * 0.125 );
								}
								else if ((GetACSWatcher().counter_wound_target).UsesVitality()
								)
								{
									dmg.AddDamage( theGame.params.DAMAGE_NAME_PHYSICAL, (GetACSWatcher().counter_wound_target).GetCurrentHealth() * 0.125 );
								}
							}
						}
						else
						{
							if ((GetACSWatcher().counter_wound_target).UsesEssence()
							)
							{
								dmg.AddDamage( theGame.params.DAMAGE_NAME_SILVER, (GetACSWatcher().counter_wound_target).GetCurrentHealth() * 0.5 );
							}
							else if ((GetACSWatcher().counter_wound_target).UsesVitality()
							)
							{
								dmg.AddDamage( theGame.params.DAMAGE_NAME_PHYSICAL, (GetACSWatcher().counter_wound_target).GetCurrentHealth() * 0.5 );
							}
						}
					}
					else
					{
						if ((GetACSWatcher().counter_wound_target).UsesEssence()
						)
						{
							dmg.AddDamage( theGame.params.DAMAGE_NAME_SILVER, (GetACSWatcher().counter_wound_target).GetCurrentHealth() * 0.0625 );
						}
						else if ((GetACSWatcher().counter_wound_target).UsesVitality()
						)
						{
							dmg.AddDamage( theGame.params.DAMAGE_NAME_PHYSICAL, (GetACSWatcher().counter_wound_target).GetCurrentHealth() * 0.0625 );
						}
					}

					if ( thePlayer.CanUseSkill(S_Sword_s11) )
					{
						if ((GetACSWatcher().counter_wound_target).UsesEssence()
						)
						{
							dmg.AddDamage( theGame.params.DAMAGE_NAME_SILVER, (GetACSWatcher().counter_wound_target).GetMaxHealth() * (thePlayer.GetSkillLevel(S_Sword_s11) * 0.025) );
						}
						else if ((GetACSWatcher().counter_wound_target).UsesVitality()
						)
						{
							dmg.AddDamage( theGame.params.DAMAGE_NAME_PHYSICAL, (GetACSWatcher().counter_wound_target).GetMaxHealth() * (thePlayer.GetSkillLevel(S_Sword_s11) * 0.025) );
						}
					}
					
					dmg.SetCriticalHit(); theGame.damageMgr.ProcessAction( dmg );	
					
					if ( (GetACSWatcher().counter_wound_target).IsShielded( NULL ) )
					{
						(GetACSWatcher().counter_wound_target).ProcessShieldDestruction();
					}

					delete dmg;
				}

				if (ACS_Settings_Main_Float('acs_custom_finishers_settings','acs_dismember_slow_mo_scale', 0.33) > 0)
				{
					GetACSWatcher().ACS_SlowMoAdjustable(ACS_Settings_Main_Float('acs_custom_finishers_settings','acs_dismember_slow_mo_scale', 0.33), 0.1);
				}
				
				if (ACS_Settings_Main_Bool('acs_visual_main_settings','acs_directional_slash_effects_enabled', true)
				&& thePlayer.IsDeadlySwordHeld()
				)
				{
					sword_slash_ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\fx\acs_sword_slashes.w2ent", true ), (GetACSWatcher().counter_wound_target).GetWorldPosition() + Vector( 0, 0, 1.25 ), EulerAngles(RandRangeF(105,75),0,0));

					sword_slash_ent.DestroyAfter(0.5);

					if (((CMovingPhysicalAgentComponent)((GetACSWatcher().counter_wound_target).GetMovingAgentComponent())).GetCapsuleHeight() >= 2
					|| (GetACSWatcher().counter_wound_target).GetRadius() >= 0.7
					|| (GetACSWatcher().counter_wound_target).HasAbility('Boss')
					|| (GetACSWatcher().counter_wound_target).HasTag('IsBoss')
					|| (GetACSWatcher().counter_wound_target).HasTag('ACS_Big_Boi')
					)
					{
						sword_slash_ent.PlayEffectSingle('sword_slash_finisher_large');
					}
					else
					{
						sword_slash_ent.PlayEffectSingle('sword_slash_finisher');
					}

					sword_slash_ent.PlayEffectSingle('sword_slash_finisher_secondary');
				}

				vfxEnt = theGame.CreateEntity( (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\fx\blood_fx.w2ent", true ), thePlayer.GetWorldPosition() );
				vfxEnt.DestroyAfter(1.5);

				vfxEnt.CreateAttachment(thePlayer,'r_weapon', Vector(0,0,2));

				theGame.GetMonsterParamsForActor((GetACSWatcher().counter_wound_target), mc, tmpName, tmpBool, tmpBool, tmpBool);

				if( (GetACSWatcher().counter_wound_target).GetBloodType() == BT_Red) 
				{
					if ((GetACSWatcher().counter_wound_target).HasAbility('mon_lessog_base')
					|| (GetACSWatcher().counter_wound_target).HasAbility('mon_sprigan_base')
					)
					{	
						GetACSWatcher().weapon_blood_fx('black');

						vfxEnt.PlayEffectSingle('blood_spatter_black');
					} 
					else 
					{
						GetACSWatcher().weapon_blood_fx('red');

						vfxEnt.PlayEffectSingle('blood_spatter_red');
					}
				}
				else if( (GetACSWatcher().counter_wound_target).GetBloodType() == BT_Green) 
				{
					if ((GetACSWatcher().counter_wound_target).HasAbility('mon_kikimore_base')
					||(GetACSWatcher().counter_wound_target). HasAbility('mon_black_spider_base')
					|| (GetACSWatcher().counter_wound_target).HasAbility('mon_black_spider_ep2_base')
					|| (GetACSWatcher().counter_wound_target).HasTag('ACS_Ungoliant')
					)
					{				
						GetACSWatcher().weapon_blood_fx('black');

						vfxEnt.PlayEffectSingle('blood_spatter_black');
					} 
					else 
					{
						GetACSWatcher().weapon_blood_fx('green');

						vfxEnt.PlayEffectSingle('blood_spatter_green');
					}
				}
				else if( (GetACSWatcher().counter_wound_target).GetBloodType() == BT_Yellow) 
				{
					if ((GetACSWatcher().counter_wound_target).HasAbility('mon_archespor_base'))
					{
						GetACSWatcher().weapon_blood_fx('yellow');

						vfxEnt.PlayEffectSingle('blood_spatter_yellow');
					} 
					else 
					{
						GetACSWatcher().weapon_blood_fx('red');

						vfxEnt.PlayEffectSingle('blood_spatter_red');
					}
				}
				else if	( (GetACSWatcher().counter_wound_target).GetBloodType() == BT_Black) 
				{
					if ( mc == MC_Vampire ) 
					{
						GetACSWatcher().weapon_blood_fx('red');

						vfxEnt.PlayEffectSingle('blood_spatter_red');
					}
					else if ( mc == MC_Magicals ) 
					{
						if ((GetACSWatcher().counter_wound_target).HasAbility('mon_golem_base')
						|| (GetACSWatcher().counter_wound_target).HasAbility('mon_djinn')
						|| (GetACSWatcher().counter_wound_target).HasAbility('mon_gargoyle')
						)
						{
							GetACSWatcher().weapon_blood_fx('black');

							vfxEnt.PlayEffectSingle('blood_spatter_black');
						}
						else
						{
							GetACSWatcher().weapon_blood_fx('red');

							vfxEnt.PlayEffectSingle('blood_spatter_red');
						}
					}
					else
					{
						GetACSWatcher().weapon_blood_fx('black');

						vfxEnt.PlayEffectSingle('blood_spatter_black');
					}
				}

				SoundEvent("damage_01_bb_acs");

				SoundEvent("damage_02_bb_acs");

				SoundEvent("cmb_play_dismemberment_gore");

				SoundEvent("monster_dettlaff_monster_vein_hit_blood");

				SoundEvent("cmb_play_ger_stab_in");
			}
		break;

		case 'acs_counter_wound_secondary':
			if ( animEventType == AET_DurationStart )
			{
				thePlayer.DestroyEffect('hit_screen');
				thePlayer.PlayEffectSingle('hit_screen');
				
				GetACSWatcher().Counter_Wound_Secdonary_Delay_Deal_Damage();
			}
		break;
		
		default:
		break;
	}
}

@addMethod(CActor) function ACS_OnEnumAnimEventAdd_02( animEventName : name, variant : SEnumVariant, animEventType : EAnimationEventType, animEventDuration : float, animInfo : SAnimationEventAnimInfo )
{
	var movementAdjustor 				: CMovementAdjustor;
	var ticket 							: SMovementAdjustmentRequestTicket;
	var rotationRate 					: ERotationRate;
	var loopShake						: bool;	
	var shakeStrength					: float;
	var animName						: name;	
	var	player							: CR4Player;
	var woundName						: name;
	var params 							: SCustomEffectParams;

	var dismembermentComp 				: CDismembermentComponent;
	var wounds							: array< name >;
	var usedWound						: name;
	var i 								: int;
	var electric_fist					: CACSElectricFist;
	var vfxEnt							: CEntity;

	var ticket_rotate					: SMovementAdjustmentRequestTicket;

	var torsoBoneIndex					: int;
	var bone_vec						: Vector;

	var bone_rot						: EulerAngles;

	var playerSpitProjectile			: CACSPlayerSpitProjectile;

	var toe_blade_r, toe_blade_l		: CACSCatSchoolToeBlade;

	var actortarget						: CActor;
	var victims			 				: array<CActor>;
	var k								: int;

	var animatedComponentPlayer			: CAnimatedComponent;

	var bloodsmokeEnt         			: CEntity;

	var sword_slash_ent					: CEntity;

	var tmpBool 						: bool;
	var mc 								: EMonsterCategory;
	var tmpName 						: name;

	var attAction						: W3Action_Attack;
	var soundeventstring				: array<string>;

	var dmg								: W3DamageAction;

	var template 						: CEntityTemplate;
	var entPhysics                  	: CEntity;
	var rot									: EulerAngles;
    var pos								: Vector;

	var ent, ent_2, ent_3, ent_4 		: CEntity;
	var attach_vec, pPos				: Vector;
	var attach_rot						: EulerAngles;

	var animatedComponentB				: CAnimatedComponent;

	var movementAdjustorFinisher		: CMovementAdjustor;
	var ticketFinisher 					: SMovementAdjustmentRequestTicket;
	var dist							: float;

	var actors    						: array<CActor>;

	var targetPos 										: Vector;

	var maxTargetVitality, maxTargetEssence, damageMax, damageMin			: float;

	var range, knockdownDur, reset_kinematic_duration					: float;



	switch( animEventName )
	{
		case 'HitSoundACS':
			if ( animEventType == AET_DurationStart )
			{
				if (thePlayer.IsWeaponHeld('fist'))
				{
					if (GetWitcherPlayer().IsAnyQuenActive()
					&& ACS_Settings_Main_Bool('acs_signs_settings','acs_quen_electric_discharge_enabled', true)
					)
					{
						electric_fist = (CACSElectricFist)theGame.CreateEntity((CEntityTemplate)LoadResource("dlc\dlc_acs\data\fx\electric_fist\acs_electric_fist.w2ent",true), this.GetWorldPosition(), this.GetWorldRotation());

						electric_fist.CreateAttachment(this,, Vector( 0, 0, 1 ), EulerAngles(RandRangeF(360,0),RandRangeF(360,0),RandRangeF(360,0)));

						electric_fist.DestroyAfter(3);
					}
					else
					{
						torsoBoneIndex = this.GetTorsoBoneIndex();

						if ( torsoBoneIndex != -1 )
						{
							bone_vec = MatrixGetTranslation( this.GetBoneWorldMatrixByIndex( torsoBoneIndex ) );

							vfxEnt = theGame.CreateEntity( (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\fx\blood_fx.w2ent", true ), bone_vec, this.GetWorldRotation() );
						}

						vfxEnt.PlayEffectSingle('fist_hit_indicator');
						vfxEnt.PlayEffectSingle('hit_refraction_red');
						vfxEnt.DestroyAfter(1.5);
					}
					

					thePlayer.SoundEvent("scene_cmb_fist_hit");
				}

				PlayEffectSingle('blood');
				StopEffect('blood');

				PlayEffectSingle('death_blood');
				StopEffect('death_blood');

				PlayEffectSingle('heavy_hit');
				StopEffect('heavy_hit');

				PlayEffectSingle('light_hit');
				StopEffect('light_hit');

				PlayEffectSingle('blood_spill');
				StopEffect('blood_spill');
			}
			else if ( animEventType == AET_DurationEnd )
			{
				
			}
		break;

		case 'GrappleVictimACS':

			if ( animEventType == AET_DurationStart )
			{
				movementAdjustorFinisher = this.GetMovingAgentComponent().GetMovementAdjustor();

				ticketFinisher = movementAdjustorFinisher.GetRequest( 'ACS_NPC_Rotate');
				movementAdjustorFinisher.CancelByName( 'ACS_NPC_Rotate' );
				movementAdjustorFinisher.CancelAll();

				ticketFinisher = movementAdjustorFinisher.CreateNewRequest( 'ACS_NPC_Rotate' );
				movementAdjustorFinisher.AdjustmentDuration( ticketFinisher, 0.1 );
				movementAdjustorFinisher.MaxRotationAdjustmentSpeed( ticketFinisher, 50000 );

				movementAdjustorFinisher.RotateTowards( ticketFinisher, thePlayer, RandRangeF(225,135) );

				rot = GetWorldRotation();

				rot.Pitch = 0;

				rot.Roll = 0;

				//TeleportWithRotation(TraceFloor(GetWorldPosition()), rot);

				TeleportWithRotation(TraceFloor(thePlayer.GetWorldPosition() - thePlayer.GetWorldForward() * (1.3)), rot);

				if (GetWitcherPlayer().IsAnyQuenActive()
				&& ACS_Settings_Main_Bool('acs_signs_settings','acs_quen_electric_discharge_enabled', true)
				)
				{
					electric_fist = (CACSElectricFist)theGame.CreateEntity((CEntityTemplate)LoadResource("dlc\dlc_acs\data\fx\electric_fist\acs_electric_fist.w2ent",true), this.GetWorldPosition(), this.GetWorldRotation());

					electric_fist.CreateAttachment(this,, Vector( 0, 0, 1 ), EulerAngles(RandRangeF(360,0),RandRangeF(360,0),RandRangeF(360,0)));

					electric_fist.DestroyAfter(3);
				}
				else
				{
					torsoBoneIndex = this.GetTorsoBoneIndex();

					if ( torsoBoneIndex != -1 )
					{
						bone_vec = MatrixGetTranslation( this.GetBoneWorldMatrixByIndex( torsoBoneIndex ) );

						vfxEnt = theGame.CreateEntity( (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\fx\blood_fx.w2ent", true ), bone_vec, this.GetWorldRotation() );
					}

					vfxEnt.PlayEffectSingle('fist_hit_indicator');
					vfxEnt.PlayEffectSingle('hit_refraction_red');
					vfxEnt.DestroyAfter(1.5);
				}
				
				thePlayer.SoundEvent("scene_cmb_fist_hit");

				PlayEffectSingle('heavy_hit');
				StopEffect('heavy_hit');

				PlayEffectSingle('light_hit');
				StopEffect('light_hit');

				if(IsAlive())
				{
					AddTag('ACS_Currently_In_Grapple_Anim');

					animatedComponentB = (CAnimatedComponent)(this.GetComponentByClassName( 'CAnimatedComponent' ));

					animatedComponentB.FreezePoseFadeIn(0.125f);

					//SetKinematic(false);

					RemoveTimer('ACS_ResetKinematic');

					if (UsesVitality()) 
					{ 
						DrainVitality( GetStat( BCS_Vitality ) * 0.25 );
					} 
					else if (UsesEssence()) 
					{ 
						DrainEssence( GetStat( BCS_Essence ) * 0.25 );
					}

					reset_kinematic_duration = 3;

					AddTimer('ACS_ResetKinematic', reset_kinematic_duration, false);
				}

				rot = GetWorldRotation();

				pos = GetWorldPosition();

				thePlayer.SoundEvent("monster_nazair_guard_combat_hits_ground");

				thePlayer.SoundEvent("monster_cloud_giant_fx_rumble_crack");

				pos.Z += 1;

				if (thePlayer.HasTag('ACS_Flammable_Oil_Enabled')
				)
				{
					if (ACS_GetItem_SwordHeldSwitchBasedUponStat('frost_sword'))
					{
						theGame.GetSurfacePostFX().AddSurfacePostFXGroup( TraceFloor( pos ), 0.125f, 3, 0.125f, 10.f, 0);

						template = (CEntityTemplate)LoadResource("dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent", true);

						entPhysics = theGame.CreateEntity( template, pos, rot );

						entPhysics.PlayEffect('blast_lv2_aard');

						entPhysics.PlayEffect('blast_ground_mutation_6_aard');

						entPhysics.PlayEffect('blast_lv2_damage_aard');

						entPhysics.PlayEffect('blast_lv2_power_aard');
					}
					else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('poison_sword'))
					{
						ACS_Poison_Cloud();
					}
					else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('bleed_sword'))
					{
						GetACSWatcher().ACS_Blood_Arc();
					}
					else
					{
						theGame.GetSurfacePostFX().AddSurfacePostFXGroup( TraceFloor( pos ), 0.125f, 3, 0.125f, 10.f, 1);

						template = (CEntityTemplate)LoadResource("dlc\dlc_acs\data\fx\acs_ice_breathe_old.w2ent", true);

						entPhysics = theGame.CreateEntity( template, pos, rot );

						//entPhysics.PlayEffect('blast_lv2_aard_fire');

						//entPhysics.PlayEffect('blast_lv1_aard_fire');

						entPhysics.PlayEffect('attack_special_fire_ACS');

						entPhysics.PlayEffect('leaf_fx_aard_fire');

						entPhysics.PlayEffect('attack_fx1_fire_ACS');
					}
				}
				else
				{
					template = (CEntityTemplate)LoadResource("dlc\dlc_acs\data\fx\pc_aard.w2ent", true);

					entPhysics = theGame.CreateEntity( template, pos, rot );

					entPhysics.PlayEffectSingle('earthquake_fx_small');

					entPhysics.PlayEffectSingle('sword_ground_hit');
				}

				entPhysics.DestroyAfter(20);

				actors.Clear();

				range = 3;

				actors = thePlayer.GetNPCsAndPlayersInCone(3, VecHeading(thePlayer.GetHeadingVector()), 360, 5, , FLAG_ExcludePlayer + FLAG_Attitude_Hostile + FLAG_OnlyAliveActors );

				if( actors.Size() > 0 )
				{
					for( i = 0; i < actors.Size(); i += 1 )
					{
						targetPos = actors[i].GetWorldPosition();

						actortarget = (CActor)actors[i];

						dmg = new W3DamageAction in theGame.damageMgr;
						
						dmg.Initialize(thePlayer, actortarget, NULL, thePlayer.GetName(), EHRT_Heavy, CPS_Undefined, false, false, true, false);

						dmg.SetHitAnimationPlayType(EAHA_ForceYes);
						
						//dmg.AddDamage( theGame.params.DAMAGE_NAME_DIRECT, RandRangeF(damageMax,damageMin) );

						if (((CMovingPhysicalAgentComponent)(actortarget.GetMovingAgentComponent())).GetCapsuleHeight() >= 2
						|| actortarget.GetRadius() >= 0.7
						|| actortarget.HasAbility('Boss')
						|| actortarget.HasTag('IsBoss')
						|| actortarget.HasTag('ACS_Big_Boi')
						|| actortarget.HasTag('ACS_Swapped_To_Shield') 
						|| ((CNewNPC)actortarget).IsShielded( NULL ) 
						)
						{
							if (actortarget.UsesVitality()) 
							{ 
								maxTargetVitality = actortarget.GetStat( BCS_Vitality );

								damageMax = maxTargetVitality * 0.125; 

								damageMin = maxTargetVitality * 0.0625; 
							} 
							else if (actortarget.UsesEssence()) 
							{ 
								maxTargetEssence = actortarget.GetStat( BCS_Essence );
								
								damageMax = maxTargetEssence * 0.125; 
								
								damageMin = maxTargetEssence * 0.0625; 
							}
						}
						else
						{
							if (actortarget.UsesVitality()) 
							{ 
								maxTargetVitality = actortarget.GetStatMax( BCS_Vitality ) - actortarget.GetStat( BCS_Vitality );

								damageMax = maxTargetVitality * 0.125; 

								damageMin = maxTargetVitality * 0.0625; 
							} 
							else if (actortarget.UsesEssence()) 
							{ 
								maxTargetEssence = actortarget.GetStatMax( BCS_Essence ) - actortarget.GetStat( BCS_Essence );
								
								damageMax = maxTargetEssence * 0.125; 
								
								damageMin = maxTargetEssence * 0.0625; 
							}
						}

						dmg.AddDamage( theGame.params.DAMAGE_NAME_PHYSICAL, RandRangeF(50 + damageMax,50 + damageMin) );

						dmg.AddDamage( theGame.params.DAMAGE_NAME_SILVER, RandRangeF(50 + damageMax,50 + damageMin) );

						//thePlayer.SoundEvent("cmb_fistfight_parry");

						dmg.SetHitReactionType( EHRT_Heavy, true);

						if (actortarget != this)
						{
							movementAdjustorFinisher = actortarget.GetMovingAgentComponent().GetMovementAdjustor();

							ticketFinisher = movementAdjustorFinisher.GetRequest( 'ACS_NPC_Kick_Attacked_Rotate');
							movementAdjustorFinisher.CancelByName( 'ACS_NPC_Kick_Attacked_Rotate' );
							movementAdjustorFinisher.CancelAll();

							ticketFinisher = movementAdjustorFinisher.CreateNewRequest( 'ACS_NPC_Kick_Attacked_Rotate' );
							movementAdjustorFinisher.AdjustmentDuration( ticketFinisher, 0.1 );
							movementAdjustorFinisher.MaxRotationAdjustmentSpeed( ticketFinisher, 50000 );

							movementAdjustorFinisher.RotateTowards( ticketFinisher, thePlayer );
						}

						knockdownDur = 1.5;

						if(!actortarget.IsImmuneToBuff(EET_HeavyKnockdown) || !actortarget.IsImmuneToBuff(EET_HeavyKnockdown) )
						{
							if(!actortarget.IsImmuneToBuff(EET_HeavyKnockdown) )
							{
								dmg.AddEffectInfo( EET_HeavyKnockdown, knockdownDur );
							}
							else
							{
								dmg.AddEffectInfo( EET_Knockdown, knockdownDur );
							}
						}

						if (thePlayer.HasTag('ACS_Flammable_Oil_Enabled')
						)
						{
							if (ACS_GetItem_SwordHeldSwitchBasedUponStat('frost_sword'))
							{
								dmg.AddEffectInfo( EET_Frozen, 3 );
							}
							else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('poison_sword'))
							{
								dmg.AddEffectInfo( EET_Poison, 3 );
							}
							else if (ACS_GetItem_SwordHeldSwitchBasedUponStat('bleed_sword'))
							{
								dmg.AddEffectInfo( EET_Bleeding, 3 );
							} 
							else
							{
								dmg.AddEffectInfo( EET_Burning, 3 );
							}
						}

						//thePlayer.SoundEvent("scene_cmb_fist_hit");

						dmg.SetCriticalHit(); theGame.damageMgr.ProcessAction( dmg );
							
						delete dmg;	

						if(thePlayer.IsOnGround() && actortarget.IsOnGround() && actortarget.GetCurrentHealth() <= 0)
						{
							thePlayer.GetRootAnimatedComponent().PlaySlotAnimationAsync( 'man_ger_crawl_finish_vampire', 'PLAYER_SLOT', SAnimatedComponentSlotAnimationSettings(0.125f, 0.125f) );
						}
					}
				}


			}
			else if ( animEventType == AET_DurationEnd )
			{
				
				movementAdjustorFinisher = this.GetMovingAgentComponent().GetMovementAdjustor();

				ticketFinisher = movementAdjustorFinisher.GetRequest( 'ACS_NPC_Rotate');
				movementAdjustorFinisher.CancelByName( 'ACS_NPC_Rotate' );
				movementAdjustorFinisher.CancelAll();

				ticketFinisher = movementAdjustorFinisher.CreateNewRequest( 'ACS_NPC_Rotate' );
				movementAdjustorFinisher.AdjustmentDuration( ticketFinisher, 0.1 );
				movementAdjustorFinisher.MaxRotationAdjustmentSpeed( ticketFinisher, 50000 );

				movementAdjustorFinisher.RotateTowards( ticketFinisher, thePlayer,RandRangeF(225,135) );

				rot = thePlayer.GetWorldRotation();

				rot.Yaw -= 180;

				//TeleportWithRotation(this.GetWorldPosition(), rot);
			}
		break;

		case 'ACSSpawnPlayerSpitProjectile':
			if ( animEventType == AET_DurationStart )
			{
				playerSpitProjectile = (CACSPlayerSpitProjectile)theGame.GetEntityByTag( 'ACS_Player_Spit_Projectile' );

				playerSpitProjectile.BreakAttachment();

				if ( thePlayer.IsHardLockEnabled() && thePlayer.GetDisplayTarget() )
				{
					playerSpitProjectile.ShootProjectileAtPosition( 0, 30, ((CActor)(thePlayer.GetDisplayTarget())).PredictWorldPosition(0.35) + Vector(0,0,RandRangeF(1.25f,0)), 500 );
				}
				else
				{
					victims.Clear();

					victims = thePlayer.GetNPCsAndPlayersInCone(10, VecHeading(thePlayer.GetHeadingVector()), 45, 1, , FLAG_ExcludePlayer );

					if( victims.Size() > 0)
					{
						for( k = 0; k < victims.Size(); k += 1 )
						{
							actortarget = (CActor)victims[k];

							playerSpitProjectile.ShootProjectileAtPosition( 0, 30, actortarget.PredictWorldPosition(0.35) + Vector(0,0,RandRangeF(1.25f,0)), 500 );
						}
					}
					else
					{
						playerSpitProjectile.ShootProjectileAtPosition( 0, 30, thePlayer.PredictWorldPosition(0.35) + thePlayer.GetWorldRight() * RandRangeF(0.5,-0.5) + thePlayer.GetWorldForward() * RandRangeF(5,2), 500 );
					}
				}

				
				playerSpitProjectile.RemoveTag('ACS_Player_Spit_Projectile');

				playerSpitProjectile.DestroyAfter(3);


			}
			else if ( animEventType == AET_DurationEnd )
			{
				thePlayer.RaiseEvent('ACS_RudenessEnd');
			}
		break;
		
		case 'ACS_Kick_Attachment_Event_R':
			if ( animEventType == AET_DurationStart )
			{
				if (ACS_Armor_Set_Check('cat', true) && thePlayer.IsDeadlySwordHeld())
				{
					if (!toe_blade_r)
					{
						toe_blade_r = (CACSCatSchoolToeBlade)theGame.CreateEntity((CEntityTemplate)LoadResource(
						"dlc\dlc_acs\data\entities\other\acs_cat_school_toe_blade.w2ent"
						
						,true), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation());

						thePlayer.GetBoneWorldPositionAndRotationByIndex( thePlayer.GetBoneIndex( 'r_toe' ), bone_vec, bone_rot );

						toe_blade_r.CreateAttachmentAtBoneWS( GetWitcherPlayer(), 'r_toe', bone_vec, bone_rot );

						toe_blade_r.AddTimer('CatSchoolToeBladeDestroyProcess', 2 , false );
					}
					else
					{
						toe_blade_r.RemoveTimer('CatSchoolToeBladeDestroyActual');
						toe_blade_r.RemoveTimer('CatSchoolToeBladeDestroyProcess');
						toe_blade_r.AddTimer('CatSchoolToeBladeDestroyProcess', 2 , false );
					}
				}
			}
		break;

		case 'ACS_Kick_Attachment_Event_L':
			if ( animEventType == AET_DurationStart )
			{
				if (ACS_Armor_Set_Check('cat', true) && thePlayer.IsDeadlySwordHeld())
				{
					if (!toe_blade_l)
					{
						toe_blade_l = (CACSCatSchoolToeBlade)theGame.CreateEntity((CEntityTemplate)LoadResource(
						"dlc\dlc_acs\data\entities\other\acs_cat_school_toe_blade.w2ent"
						
						,true), thePlayer.GetWorldPosition(), thePlayer.GetWorldRotation());

						thePlayer.GetBoneWorldPositionAndRotationByIndex( thePlayer.GetBoneIndex( 'l_toe' ), bone_vec, bone_rot );

						toe_blade_l.CreateAttachmentAtBoneWS( GetWitcherPlayer(), 'l_toe', bone_vec, bone_rot );

						toe_blade_l.AddTimer('CatSchoolToeBladeDestroyProcess', 2 , false );
					}
					else
					{
						toe_blade_l.RemoveTimer('CatSchoolToeBladeDestroyActual');
						toe_blade_l.RemoveTimer('CatSchoolToeBladeDestroyProcess');
						toe_blade_l.AddTimer('CatSchoolToeBladeDestroyProcess', 2 , false );
					}
				}
			}
		break;

		case 'man_finisher_05_rp_stab_hostage_enter_ACS':
		
			GetACSWatcher().StabHostageInit();
			
		break;
		
		default:
		break;
	}
}

@addMethod(CActor) function ACS_GrappleVictimAnim()
{
	var masterDef															: SAnimationSequenceDefinition;
	var masterSequencePart													: SAnimationSequencePartDefinition;
	var syncInstance														: CAnimationManualSlotSyncInstance;
	
	var instanceIndex														: int;
	var sequenceIndex														: int;

	var syncAnimName														: name;
	
	var masterAnim 															: name;
	var syncAnimIndex														: int;
	var currentAnimInstance													: CAnimationManualSlotSyncInstance;
	

	((CAnimatedComponent)(this.GetComponentByClassName( 'CAnimatedComponent' ))).FreezePoseFadeIn(0.5f);

	syncInstance 										= theGame.GetSyncAnimManager().CreateNewSyncInstance( instanceIndex );
	syncAnimIndex 										= instanceIndex;
	currentAnimInstance 								= syncInstance;

	if (IsHuman())
	{
		masterSequencePart.animation						= 'exploration_effect_knockdown_loop';
	}
	else
	{
		if (((CNewNPC)this).GetSfxTag() == 'sfx_drowner'
		|| ((CNewNPC)this).HasAbility('mon_rotfiend')
		|| ((CNewNPC)this).HasAbility('mon_rotfiend_large')
		|| ((CNewNPC)this).HasAbility('mon_gravier')
		)
		{
			masterSequencePart.animation				= 'monster_drowner_knockdown_loop';
		}
		else if (((CNewNPC)this).GetSfxTag() == 'sfx_nekker')
		{
			masterSequencePart.animation				= 'c_knockdown_loop';	
		}
		else if (((CNewNPC)this).HasAbility('mon_ghoul')
		)
		{
			masterSequencePart.animation				= 'effect_knockdown_start';	
		}
		else if (((CNewNPC)this).GetSfxTag() == 'sfx_fogling'
		|| ((CNewNPC)this).GetSfxTag() == 'sfx_gravehag'
		|| ((CNewNPC)this).GetSfxTag() == 'sfx_waterhag'
		)
		{
			masterSequencePart.animation				= 'effect_knockdown_loop';	
		}
		else if (((CNewNPC)this).HasAbility('mon_erynia')
		|| ((CNewNPC)this).GetSfxTag() == 'sfx_harpy')
		{
			masterSequencePart.animation				= 'monster_harpy_effect_knockdown_loop';	
		}
		else if (((CNewNPC)this).GetSfxTag() == 'sfx_siren')
		{
			masterSequencePart.animation				= 'monster_siren_crawl_death';	
		}
		else if (((CNewNPC)this).HasAbility('mon_panther_base'))
		{
			masterSequencePart.animation				= 'mcat_death';	
		}
		else if (((CNewNPC)this).GetSfxTag() == 'sfx_wild_dog'
		|| ((CNewNPC)this).GetSfxTag() == 'sfx_wolf'
		)
		{
			masterSequencePart.animation				= 'wolf_knockdown_loop';	
		}
		else if (((CNewNPC)this).HasAbility('mon_bruxa'))
		{
			masterSequencePart.animation				= 'bruxa_knockdown_loop';	
		}
		else if (((CNewNPC)this).HasAbility('mon_boar_base'))
		{
			masterSequencePart.animation				= 'boar_knockdown_loop';	
		}
	}
	
	masterSequencePart.syncType							= AMST_SyncBeginning;
	masterSequencePart.useRefBone						= 'Reference';
	masterSequencePart.rotationTypeUsingRefBone 		= SRT_TowardsOtherEntity;
	masterSequencePart.shouldSlide						= false;
	masterSequencePart.shouldRotate						= false;

	masterSequencePart.blendInTime						= 0;
	masterSequencePart.blendOutTime						= 0;
	masterSequencePart.sequenceIndex					= 0;


	masterDef.parts.PushBack( masterSequencePart );


	masterDef.entity									= this;
	
	masterDef.manualSlotName							= 'GAMEPLAY_SLOT';

	masterDef.freezeAtEnd								= true;

	sequenceIndex 										= syncInstance.RegisterMaster( masterDef );

	SignalGameplayEventParamInt( 'SetupSyncInstance', instanceIndex );
	SignalGameplayEventParamInt( 'SetupSequenceIndex', sequenceIndex );
	SignalGameplayEvent( 'PlaySyncedAnim' );
}

@addMethod(CActor) timer function ACS_ResetKinematic( time : float , id : int)
{
	var masterDef															: SAnimationSequenceDefinition;
	var masterSequencePart													: SAnimationSequencePartDefinition;
	var syncInstance														: CAnimationManualSlotSyncInstance;
	
	var instanceIndex														: int;
	var sequenceIndex														: int;

	var syncAnimName														: name;
	
	var masterAnim 															: name;
	var syncAnimIndex														: int;
	var currentAnimInstance													: CAnimationManualSlotSyncInstance;

	((CAnimatedComponent)(this.GetComponentByClassName( 'CAnimatedComponent' ))).UnfreezePose();

	((CAnimatedComponent)(this.GetComponentByClassName( 'CAnimatedComponent' ))).UnfreezePoseFadeOut(0.125f);

	//SetKinematic(true);

	ACS_RemoveTagAfter('ACS_Currently_In_Grapple_Anim', 0.5);

	syncInstance 										= theGame.GetSyncAnimManager().CreateNewSyncInstance( instanceIndex );
	syncAnimIndex 										= instanceIndex;
	currentAnimInstance 								= syncInstance;

	if (GetHealth() <= GetMaxHealth() * 0.15)
	{
		if (UsesVitality()) 
		{ 
			DrainVitality( GetStat( BCS_Vitality ) );
		} 
		else if (UsesEssence()) 
		{ 
			DrainEssence( GetStat( BCS_Essence ) );
		}

		SetAlive(false);

		SetKinematic(false);
	}

	if (IsHuman())
	{
		masterSequencePart.animation						= 'man_geralt_back_getup_l';
	}
	else
	{
		if (((CNewNPC)this).GetSfxTag() == 'sfx_drowner'
		|| ((CNewNPC)this).HasAbility('mon_rotfiend')
		|| ((CNewNPC)this).HasAbility('mon_rotfiend_large')
		|| ((CNewNPC)this).HasAbility('mon_gravier')
		)
		{
			masterSequencePart.animation				= 'monster_drowner_knockdown_stop';
		}
		else if (((CNewNPC)this).GetSfxTag() == 'sfx_nekker')
		{
			masterSequencePart.animation				= 'c_knockdown_stop';	
		}
		else if (((CNewNPC)this).HasAbility('mon_ghoul')
		)
		{
			masterSequencePart.animation				= 'effect_knockdown_stop';	
		}
		else if (((CNewNPC)this).GetSfxTag() == 'sfx_fogling'
		|| ((CNewNPC)this).GetSfxTag() == 'sfx_gravehag'
		|| ((CNewNPC)this).GetSfxTag() == 'sfx_waterhag'
		)
		{
			masterSequencePart.animation				= 'effect_knockdown_end';	
		}
		else if (((CNewNPC)this).HasAbility('mon_erynia')
		|| ((CNewNPC)this).GetSfxTag() == 'sfx_harpy')
		{
			masterSequencePart.animation				= 'monster_harpy_effect_knockdown_end';	
		}
		else if (((CNewNPC)this).GetSfxTag() == 'sfx_siren')
		{
			masterSequencePart.animation				= 'monster_siren_knockdown_stop';	
		}
		else if (((CNewNPC)this).HasAbility('mon_panther_base'))
		{
			masterSequencePart.animation				= 'mcat_knockdown_stop';	
		}
		else if (((CNewNPC)this).GetSfxTag() == 'sfx_wild_dog'
		|| ((CNewNPC)this).GetSfxTag() == 'sfx_wolf'
		)
		{
			masterSequencePart.animation				= 'wolf_knockdown_stop';	
		}
		else if (((CNewNPC)this).HasAbility('mon_bruxa'))
		{
			masterSequencePart.animation				= 'bruxa_knockdown_stop';	
		}
		else if (((CNewNPC)this).HasAbility('mon_boar_base'))
		{
			masterSequencePart.animation				= 'boar_knockdown_end';	
		}
	}
	
	masterSequencePart.syncType							= AMST_SyncBeginning;
	masterSequencePart.useRefBone						= 'Reference';
	masterSequencePart.rotationTypeUsingRefBone 		= SRT_TowardsOtherEntity;
	masterSequencePart.shouldSlide						= false;
	masterSequencePart.shouldRotate						= false;

	masterSequencePart.blendInTime						= 0;
	masterSequencePart.blendOutTime						= 1.5f;
	masterSequencePart.sequenceIndex					= 0;


	masterDef.parts.PushBack( masterSequencePart );


	masterDef.entity									= this;
	
	masterDef.manualSlotName							= 'GAMEPLAY_SLOT';

	masterDef.freezeAtEnd								= false;

	sequenceIndex 										= syncInstance.RegisterMaster( masterDef );

	SignalGameplayEventParamInt( 'SetupSyncInstance', instanceIndex );
	SignalGameplayEventParamInt( 'SetupSequenceIndex', sequenceIndex );
	SignalGameplayEvent( 'PlaySyncedAnim' );
}

@addMethod(CActor) timer function ACS_DelayedDismemberTimer( time : float , id : int)
{
	var sword_slash_ent					: CEntity;
	var soundeventstring				: array<string>;

	if (ACS_Settings_Main_Bool('acs_custom_finishers_settings','acs_extra_sfx_on_dismember', true)
	)
	{
		theSound.SoundEvent("cmb_play_dismemberment_gore");

		theSound.SoundEvent("monster_dettlaff_monster_vein_hit_blood");

		theSound.SoundEvent("monster_dettlaff_monster_combat_geralt_hit_claws");

		if (this.IsMonster())
		{
			theSound.SoundEvent("kill_chance_bb_acs");
		}
		else
		{
			theSound.SoundEvent("kill_pre_bb_acs");
		}

		soundeventstring.Clear();
		soundeventstring.PushBack("z000001059_bb_acs");
		soundeventstring.PushBack("z000001059b_bb_acs");
		soundeventstring.PushBack("z000001059c_bb_acs");
		soundeventstring.PushBack("z000001068_bb_acs");

		theSound.SoundEvent(soundeventstring[RandRange(soundeventstring.Size())]);
	}

	if (!this.IsHuman())
	{
		dismemberForceRagdoll = true;
	}

	thePlayer.DestroyEffect('hit_screen');
	thePlayer.PlayEffectSingle('hit_screen');
	
	Dismember();

	if (ACS_Settings_Main_Float('acs_custom_finishers_settings','acs_dismember_slow_mo_scale', 0.33) > 0)
	{
		GetACSWatcher().ACS_SlowMoAdjustable(ACS_Settings_Main_Float('acs_custom_finishers_settings','acs_dismember_slow_mo_scale', 0.33), 0.1);
	}

	if (ACS_Settings_Main_Bool('acs_custom_finishers_settings','acs_extra_vfx_on_dismember', true)
	)
	{
		GetACSWatcher().CreateCounterWoundSwordFX((CNewNPC)this);

		sword_slash_ent = theGame.CreateEntity( (CEntityTemplate)LoadResource( "dlc\dlc_acs\data\fx\acs_sword_slashes.w2ent", true ), this.GetWorldPosition() + Vector( 0, 0, RandRangeF(1.5,1.25) ), EulerAngles(RandRangeF(360,0),RandRangeF(360,0),RandRangeF(360,0)));

		if (((CMovingPhysicalAgentComponent)(this.GetMovingAgentComponent())).GetCapsuleHeight() >= 2
		|| this.GetRadius() >= 0.7
		|| this.HasAbility('Boss')
		|| this.HasTag('IsBoss')
		|| this.HasTag('ACS_Big_Boi')
		)
		{
			sword_slash_ent.PlayEffectSingle('sword_slash_finisher_large');
		}
		else
		{
			sword_slash_ent.PlayEffectSingle('sword_slash_finisher');
		}

		sword_slash_ent.PlayEffectSingle('sword_slash_finisher_secondary');
		
		sword_slash_ent.DestroyAfter(0.5);
	}

	ACS_ApplyForce((CNewNPC)this);
}

@wrapMethod(CR4Player) function OnEnumAnimEvent( animEventName : name, variant : SEnumVariant, animEventType : EAnimationEventType, animEventDuration : float, animInfo : SAnimationEventAnimInfo )
{
	var movementAdjustor : CMovementAdjustor;
	var ticket : SMovementAdjustmentRequestTicket;
	var rotationRate : ERotationRate;

	if (false)
	{
		wrappedMethod(animEventName, variant, animEventType, animEventDuration, animInfo);
	}
	
	if ( animEventName == 'RotateToTarget'
	&& !thePlayer.HasTag('ACS_IsPerformingFinisher')
	&& !thePlayer.HasTag('ACS_In_Combat_Art')
	&& FactsQuerySum("ACS_Mounted_Attack_Attachment_Active") <= 0
	&& !GetACSWatcher().horseLeapStrikeProcess
	&& !thePlayer.IsInAir()
	&& !thePlayer.IsFalling()
	)
	{
		rotationRate = GetRotationRateFromAnimEvent( variant.enumValue );

		movementAdjustor = GetMovingAgentComponent().GetMovementAdjustor();

		if ( animEventType == AET_DurationStart || animEventType == AET_DurationStartInTheMiddle )
		{
			if (! movementAdjustor.IsRequestActive( movementAdjustor.GetRequest( 'RotateToTarget' ) ) )
			{
				
				ticket = movementAdjustor.CreateNewRequest( 'RotateToTarget' );
				
				
				if ((int)rotationRate == 0)
					movementAdjustor.AdjustmentDuration( ticket, animEventDuration );
				else
				{
					movementAdjustor.Continuous( ticket );
					movementAdjustor.BindToEvent( ticket, 'RotateToTarget' );
				}	
				
				movementAdjustor.DontUseSourceAnimation( ticket ); 
				movementAdjustor.ReplaceRotation( ticket );
			}
			else
			{
				
				ticket = movementAdjustor.GetRequest( 'RotateToTarget' );
			}
			MovAdjRotateToTarget( ticket );
			
			if ((int)rotationRate > 0)
			{
				movementAdjustor.MaxRotationAdjustmentSpeed( ticket, (float)((int)rotationRate) );
			}
		}
		else if ( animEventType == AET_DurationEnd )
		{
			
			
		}
		else
		{
			
			ticket = movementAdjustor.GetRequest( 'RotateToTarget' );
			MovAdjRotateToTarget( ticket );
		}
	}

	super.OnEnumAnimEvent(animEventName, variant, animEventType, animEventDuration, animInfo);
}	

@addMethod( CActor ) timer function ACS_RagdollTimer(dt:float,id:int)
{
	SetKinematic( false );
	TurnOnRagdoll();
	SetBehaviorVariable( 'Ragdoll_Weight', 1.f );
	ACS_ApplyForce((CNewNPC)this);
}

@wrapMethod(CR4HudModuleConsole) function OnTick( timeDelta : float )
{
	if (false)
	{
		wrappedMethod(timeDelta);
	}

	if( _iDuringDisplay < MAX_CONSOLE_MESSEGES_DISPLAYED )
	{		
		displayTime += timeDelta;

		if( theGame.IsDialogOrCutscenePlaying() 
		|| !thePlayer.IsAlive()
		|| thePlayer.IsInCutsceneIntro()
		|| theGame.HasBlackscreenRequested()
		|| theGame.IsCurrentlyPlayingNonGameplayScene()
		|| theGame.GetGuiManager().IsAnyMenu()
		)
		{		
			_iDuringDisplay = 0;
		}
		else
		{
			if( CheckPendingMessages() && displayTime > NEW_ITEM_DELAY )
			{
				DisplayConsoleMsg(pendingMessages[0]);
				_iDuringDisplay += 1;
				displayTime = 0;
				LogChannel('HUD_CONSOLE',"_iDuringDisplay "+_iDuringDisplay +" " + pendingMessages[0]);
				pendingMessages.Erase(0);
			}
			else
			{
				_iDuringDisplay = 0;
			}
		}
	}
}		

@wrapMethod( Combat ) function ProcessPlayerCombatStance()
{	
	var targetCapsuleHeight		: float;
	var stance					: EPlayerCombatStance;
	var playerToTargetVector	: Vector;
	var playerToTargetDist		: float;
	var wasVisibleInCam 		: bool;
	var moveTargetNPC			: CNewNPC;

	if (false)
	{
		wrappedMethod();
	}
	
	if( GetWitcherPlayer() && GetWitcherPlayer().HasBuff( EET_Mutation11Buff ) )
	{
		return;
	}

	parent.findMoveTargetDistMin = 30.f;
	parent.findMoveTargetDistMax = 40.f;

	moveTargetNPC = (CNewNPC)(parent.moveTarget);
	if ( virtual_parent.GetPlayerCombatStance() == PCS_AlertNear || virtual_parent.GetPlayerCombatStance() == PCS_Guarded )
		parent.findMoveTargetDist = parent.findMoveTargetDistMax;
	else
		parent.findMoveTargetDist = parent.findMoveTargetDistMin;

	if ( parent.moveTarget 
		&& moveTargetNPC.GetCurrentStance() != NS_Fly 
		&& parent.enableStrafe 
		&& parent.IsThreat( parent.moveTarget ) )
	{
		playerToTargetVector = parent.moveTarget.GetNearestPointInPersonalSpace( parent.GetWorldPosition() ) - parent.GetWorldPosition();
		playerToTargetDist = VecLength( playerToTargetVector );
		if (  playerToTargetDist <= parent.findMoveTargetDist )
			stance = PCS_AlertNear;
		else 
		{
			if ( parent.findMoveTargetDist <= parent.findMoveTargetDistMin ) 
			{
				targetCapsuleHeight = ( (CMovingPhysicalAgentComponent)parent.moveTarget.GetMovingAgentComponent() ).GetCapsuleHeight();
				if ( targetCapsuleHeight > 2.f )  
				{
					parent.findMoveTargetDistMin = 30.f;
					parent.findMoveTargetDist = parent.findMoveTargetDistMin;
					
					if ( playerToTargetDist <= parent.findMoveTargetDist )
						stance = PCS_AlertNear;
					else
						stance = PCS_AlertNear;
				}
				else
					stance = PCS_AlertNear;
			}				
			else	
				stance = PCS_AlertNear;
		}
	}
	else if ( moveTargetNPC && moveTargetNPC.GetCurrentStance() == NS_Fly )
	{
		if ( AbsF( playerToTargetVector.Z ) < 25 && VecLength2D( playerToTargetVector ) < parent.findMoveTargetDist * 2.f )
			stance = PCS_AlertNear;
		else	
			stance = PCS_AlertNear;				
	}
	else if ( parent.IsCastingSign() && !parent.IsInCombat() )
		stance = PCS_Normal;
	else
		stance = virtual_parent.GetPlayerCombatStance();

	
	
	
	if ( !parent.IsEnemyVisible( parent.moveTarget ) )
	{
		if ( virtual_parent.GetPlayerCombatStance() == PCS_AlertNear || parent.IsInCombat() )
			stance = PCS_AlertNear;
	}

	
	if ( thePlayer.GetFlyingBossCamera() )
		stance = PCS_AlertNear;
	
	if ( parent.IsGuarded() )
		stance = PCS_Guarded;
	else if ( stance == PCS_Guarded )
		stance = PCS_AlertNear;
		
	if ( !parent.IsThreatened() )	
		stance = PCS_Normal;	
	
	if( FactsQuerySum("force_stance_normal") > 0 )
	{
		stance = PCS_Normal;
	}
	
	if ( virtual_parent.GetPlayerCombatStance() == PCS_AlertNear && stance != PCS_AlertNear && stance != PCS_Guarded )
	{
		if ( !parent.IsEnemyVisible( parent.moveTarget ) &&  playerToTargetDist <= parent.findMoveTargetDist )
			DisableCombatStance( 5.f, stance );
		else 
			SetStance( stance ); 
	}
	else
		SetStance( stance );
}

@wrapMethod( W3DamageManagerProcessor ) function CanPerformFinisher( actorVictim : CActor ) : bool
{
	if (actorVictim.HasTag('dettlaff_construct'))
	{
		return wrappedMethod(actorVictim);
	}

	return false;
}

@wrapMethod( W3DamageManagerProcessor ) function CanDismember( wasFrozen : bool, out dismemberExplosion : bool, out weaponName : name ) : bool
{
	if (attackAction.IsActionMelee())
	{
		dismemberExplosion = false;
		
		return false;
	}

	if (
	(
	((W3AardProjectile)action.causer && ACS_Settings_Main_Bool('acs_custom_finishers_settings','acs_sign_dismemberment_enabled', false))
	//|| ((W3IgniEntity)action.causer && ACS_Settings_Main_Bool('acs_custom_finishers_settings','acs_fist_dismemberment_enabled', false))
	|| ((W3QuenEntity)action.causer && ACS_Settings_Main_Bool('acs_custom_finishers_settings','acs_sign_dismemberment_enabled', false))
	|| ((W3YrdenEntity)action.causer && ACS_Settings_Main_Bool('acs_custom_finishers_settings','acs_sign_dismemberment_enabled', false))
	|| ((W3BoltProjectile)action.causer && ACS_Settings_Main_Bool('acs_custom_finishers_settings','acs_bolt_dismemberment_enabled', false))
	|| action.GetBuffSourceName() == "riderHit"
	)
	&& ((CActor)(action.victim)).GetHealth() <= ((CActor)(action.victim)).GetMaxHealth() * 0.05
	)
	{
		dismemberExplosion = true;

		return true;
	}

	if ((W3Petard)action.causer
	//|| (W3BoltProjectile)action.causer
	|| (W3ArrowProjectile)action.causer
	|| (W3ToxicCloud)action.causer
	|| action.HasForceExplosionDismemberment()
	|| wasFrozen
	|| (W3Effect_YrdenHealthDrain)action.causer
	)
	{
		return wrappedMethod(wasFrozen, dismemberExplosion, weaponName);
	}

	dismemberExplosion = false;

	return false;
}


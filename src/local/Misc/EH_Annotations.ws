@addMethod( CNewNPC ) function ACS_HorseTrophyVisibility( b : bool, out trophy_name : string )
{
	var items : array< SItemUniqueId >;
	var itemEntity : CItemEntity;
	var i, k : int;
	var drawableComp : CDrawableComponent;
	var drawableComps : array<CComponent>;
	var inv : CInventoryComponent;

	inv = GetInventory();

	inv.GetAllItems( items );

	for( i=0; i<items.Size(); i+=1 )
	{
		itemEntity = inv.GetItemEntityUnsafe( items[ i ] );

		if( itemEntity && inv.IsItemTrophy(items[i]))
		{
			trophy_name = inv.GetItemName(items[i]);

			drawableComps = itemEntity.GetComponentsByClassName( 'CDrawableComponent' );
			
			for( k = 0; k < drawableComps.Size(); k += 1 )
			{
				drawableComp = ( CDrawableComponent )drawableComps[ k ];
				if( drawableComp )
				{
					drawableComp.SetVisible( b );
				}
			}
		}
	}
}

@wrapMethod(W3ActorRemains) function OnItemTaken(itemId : SItemUniqueId, quantity : int)
{
	var itemName : name;

	if ( inv.IsItemTrophy ( itemId ) )
	{
		itemName = inv.GetItemName ( itemId );

		GetACSWatcher().SetTrophyNameToUse(itemName);

		GetACSWatcher().AddTimer('DelayTrophyEquip', 0.0001, true);
	}

	wrappedMethod(itemId, quantity);
}
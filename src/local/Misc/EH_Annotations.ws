@addMethod(CR4MapMenu) function ACS_addCustomPin( out flashArray : CScriptedFlashArray)
{
	var mhc_flashObject		: CScriptedFlashObject;	
	var current_area 		: int;
	var huntStatus			: ACSHuntStatus;
	var huntArea			: ACSHuntArea;

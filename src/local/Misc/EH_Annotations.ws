				{
					if (GetWeatherConditionName() != 'WT_Rain_Storm')
					{
						RequestWeatherChangeTo('WT_Rain_Storm', 5.0, false);
					}

					GetACSWatcher().Lightning_Strike_No_Condition();

					GetACSWatcher().RemoveTimer('MelusineSpawnDelay');

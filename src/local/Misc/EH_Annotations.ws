			vfxEnt.PlayEffectSingle('blood_spatter_green');
		}
	}
	else if( this.GetBloodType() == BT_Yellow) 
	{
		if (HasAbility('mon_archespor_base'))
		{
			vfxEnt.PlayEffectSingle('blood_explode_yellow');

			vfxEnt.PlayEffectSingle('blood_spatter_yellow');
		} 
		else 
		{
			vfxEnt.PlayEffectSingle('blood_explode_red');

			vfxEnt.PlayEffectSingle('blood_spatter_red');
		}
	}
	else if	( this.GetBloodType() == BT_Black) 
	{
		if ( mc == MC_Vampire ) 
		{
			vfxEnt.PlayEffectSingle('blood_explode_red');

			vfxEnt.PlayEffectSingle('blood_spatter_red');
		}
		else if ( mc == MC_Magicals ) 
		{
			if (HasAbility('mon_golem_base')
			|| HasAbility('mon_djinn')
			|| HasAbility('mon_gargoyle')
			)
			{
				vfxEnt.PlayEffectSingle('blood_explode_black');

				vfxEnt.PlayEffectSingle('blood_spatter_black');
			}
			else
			{
				vfxEnt.PlayEffectSingle('blood_explode_red');

				vfxEnt.PlayEffectSingle('blood_spatter_red');
			}
		}
		else
		{
			vfxEnt.PlayEffectSingle('blood_explode_black');

			vfxEnt.PlayEffectSingle('blood_spatter_black');
		}
	}

	actors.Clear();

	actors = thePlayer.GetNPCsAndPlayersInCone(4, VecHeading(thePlayer.GetHeadingVector()), 60, 20, , FLAG_OnlyAliveActors + FLAG_Attitude_Hostile + FLAG_ExcludePlayer );

	if( actors.Size() > 0 )
	{
		if (thePlayer.GetStat(BCS_Focus) >= thePlayer.GetStatMax( BCS_Focus ) * 0.33)
		{
			thePlayer.DrainFocus(thePlayer.GetStatMax( BCS_Focus ) * 0.33);

			for (i = 0; i < actors.Size(); i += 1) 
			{
				params.effectType = EET_Stagger;
				params.creator = thePlayer;
				params.sourceName = "ACS_Aard_Finisher";
				params.duration = 3;

				(((CNewNPC)actors[i])).AddEffectCustom( params );	
			}
		}
	}
}


////////////////////////////////////////////////////////////////////////////////////////////////////////

function ACS_OnGameCameraTick(out moveData: SCameraMovementData, dt : float )
{		
	var v											: Vector;
	var x_offset, y_offset, z_offset				: float;
	var x_offsetAdjusted							: float;
	var y_offsetAdjusted							: float;
	var z_offsetAdjusted							: float;
	var y_offsetSprint								: float;
	var y_offsetDodge								: float;
	var y_offsetFacingCamera						: float;
	var y_offsetLargeTarget							: float;
	var y_offsetBigBoat								: float;
	var z_offsetLargeTarget							: float;
	var headingDiff									: float;
	var pos 										: Vector;
	var combat_check, horse_check, focus_mode_check	: bool;
	var blendMultiplier								: float;
	var rotation									: EulerAngles;
	var tilt_inversion, combat_tilt_strength		: float;

	moveData.pivotRotationController.minPitch = -80.f;
	moveData.pivotRotationController.maxPitch = 80.f;

	if ( !ACS_Settings_Main_Bool('acs_hud_camera_settings_main','acs_custom_camera_positioning_enabled', true) 
	//|| thePlayer.rangedWeapon.GetCurrentStateName() == 'State_WeaponAim'
	//|| thePlayer.IsThrowingItemWithAim()
	//|| thePlayer.IsThrowHold()
	)
	{
		if ( theGame.GetInGameConfigWrapper().GetVarValue('Gameplay', 'EnableAlternateExplorationCamera') == "0" )
		{
			if (thePlayer.GetExplCamera())
			{
				thePlayer.SetExplCamera(true);
			}
		}
		else if ( theGame.GetInGameConfigWrapper().GetVarValue('Gameplay', 'EnableAlternateExplorationCamera') == "1" )
		{
			if (!thePlayer.GetExplCamera())
			{
				thePlayer.SetExplCamera(false);
			}
		}

		if ( theGame.GetInGameConfigWrapper().GetVarValue('Gameplay', 'EnableAlternateCombatCamera') == "0" )
		{
			if (thePlayer.GetCmbtCamera())
			{
				thePlayer.SetCmbtCamera(false);
			}
		}
		else if ( theGame.GetInGameConfigWrapper().GetVarValue('Gameplay', 'EnableAlternateCombatCamera') == "1" )
		{
			if (!thePlayer.GetCmbtCamera())
			{
				thePlayer.SetCmbtCamera(true);
			}
		}

		if ( theGame.GetInGameConfigWrapper().GetVarValue('Gameplay', 'EnableAlternateHorseCamera') == "0" )
		{
			if (thePlayer.GetHorseCamera())
			{
				thePlayer.SetHorseCamera(false);
			}
		}
		else if ( theGame.GetInGameConfigWrapper().GetVarValue('Gameplay', 'EnableAlternateHorseCamera') == "1" )
		{
			if (!thePlayer.GetHorseCamera())
			{
				thePlayer.SetHorseCamera(true);
			}
		}

		return;
	}

	if (thePlayer.GetExplCamera())
	{
		thePlayer.SetExplCamera(false);
	}

	if (thePlayer.GetCmbtCamera())
	{
		thePlayer.SetCmbtCamera(false);
	}

	if (thePlayer.GetHorseCamera())
	{
		thePlayer.SetHorseCamera(false);
	}

	if ( theGame.IsFocusModeActive() && !thePlayer.IsThreatened() && !thePlayer.IsInCombat() )
	{
		focus_mode_check = true;
	}
	else
	{
		focus_mode_check = false;
	}

	if (
	thePlayer.IsUsingHorse()
	)
	{
		if (ACS_Settings_Main_Bool('acs_hud_camera_settings_main','acs_custom_horse_camera_positioning_enabled', true) )
		{
			horse_check = true;
		}
		else
		{
			horse_check = false;
		}

		combat_check = false;

		focus_mode_check = false;
	}
	else
	{
		horse_check = false;

		if ( theGame.IsFocusModeActive() )
		{
			focus_mode_check = true;
		}
		else
		{
			focus_mode_check = false;

			if (
			thePlayer.IsInCombat() 
			|| thePlayer.IsThreatened()
			|| !ACS_CombatToExplorationCheck()
			|| thePlayer.HasTag('ACS_IsPerformingFinisher')
			|| thePlayer.HasTag('ACS_IsPerformingCombatDismember')
			|| thePlayer.IsPerformingFinisher()
			|| !ACS_CombatToExplorationCheck()
			)
			{
				if (ACS_Settings_Main_Bool('acs_hud_camera_settings_main','acs_custom_combat_camera_positioning_enabled', true) )
				{
					combat_check = true;
				}
				else
				{
					combat_check = false;
				}
			}
			else
			{
				combat_check = false;
			}
		}
	}

	headingDiff = AngleDistance( VecHeading( theCamera.GetCameraDirection() ), VecHeading( thePlayer.GetHeadingVector() ) );

	theGame.GetGameCamera().ChangePivotRotationController( 'Exploration' );
	theGame.GetGameCamera().ChangePivotDistanceController( 'Default' );
	theGame.GetGameCamera().ChangePivotPositionController( 'Default' );

	moveData.pivotRotationController = theGame.GetGameCamera().GetActivePivotRotationController();
	moveData.pivotDistanceController = theGame.GetGameCamera().GetActivePivotDistanceController();
	moveData.pivotPositionController = theGame.GetGameCamera().GetActivePivotPositionController();

	if (ACSGetCEntity('ACS_Camera_Target')
	&& ACS_Settings_Main_Bool('acs_hud_camera_settings_main','acs_dynamic_camera_positioning_enabled', true)
	&& !theGame.IsFocusModeActive()
	) 
	{
		pos = ACSGetCEntity('ACS_Camera_Target').GetWorldPosition();
	}
	else
	{
		pos = thePlayer.GetBoneWorldPosition( 'pelvis' );
	}

	moveData.pivotPositionController.SetDesiredPosition( pos );

	moveData.pivotRotationController.SetDesiredPitch( -10.0f );
	moveData.pivotRotationController.maxPitch = 50.0;

	moveData.pivotDistanceController.SetDesiredDistance( 4.f );

	if (headingDiff >= 90 )
	{
		tilt_inversion = -1;
	}
	else if (headingDiff < -90 )
	{
		tilt_inversion = -1;
	}
	else
	{
		tilt_inversion = 1;
	}

	if (focus_mode_check && ACS_Settings_Main_Bool('acs_hud_settings_focus_mode','acs_custom_focus_mode_camera_enabled', true))
	{
		if (thePlayer.IsSwimming() || thePlayer.IsDiving())
		{
			rotation = GetACSWatcher().sLean;
		}
		else
		{
			rotation = GetACSWatcher().pLean;
		}
		
		moveData.pivotRotationValue.Roll = LerpAngleF( dt, moveData.pivotRotationValue.Roll, tilt_inversion * rotation.Roll * ACS_Settings_Main_Float('acs_hud_camera_settings_main','acs_custom_camera_tilt_strength', 0.25f) );

		if ( theGame.GetInGameConfigWrapper().GetVarValue('Gameplay', 'EnableAlternateExplorationCamera') == "0" )
		{
			x_offset = 0 + ACS_Settings_Main_Float('acs_hud_settings_focus_mode','acs_custom_focus_mode_camera_positioning_default_x', 0);

			y_offset = 0.6 + ACS_Settings_Main_Float('acs_hud_settings_focus_mode','acs_custom_focus_mode_camera_positioning_default_y', 0);

			z_offset = 0.2 + ACS_Settings_Main_Float('acs_hud_settings_focus_mode','acs_custom_focus_mode_camera_positioning_default_z', 0);
		}
		else if ( theGame.GetInGameConfigWrapper().GetVarValue('Gameplay', 'EnableAlternateExplorationCamera') == "1" )
		{
			x_offset = 1.00 + ACS_Settings_Main_Float('acs_hud_settings_focus_mode','acs_custom_focus_mode_camera_positioning_close_x', 0);

			y_offset = 2.65 + ACS_Settings_Main_Float('acs_hud_settings_focus_mode','acs_custom_focus_mode_camera_positioning_close_y', 0);

			z_offset = 0.00 + ACS_Settings_Main_Float('acs_hud_settings_focus_mode','acs_custom_focus_mode_camera_positioning_close_z', 0);
		}
	}
	else
	{
		if (horse_check)
		{
			moveData.pivotPositionController.offsetZ = 2.25f;

			rotation = GetACSWatcher().hLean;

			moveData.pivotRotationValue.Roll = LerpAngleF( dt, moveData.pivotRotationValue.Roll, tilt_inversion * rotation.Roll * ACS_Settings_Main_Float('acs_hud_camera_settings_main','acs_custom_camera_tilt_strength', 0.25f) );

			if ( theGame.GetInGameConfigWrapper().GetVarValue('Gameplay', 'EnableAlternateHorseCamera') == "0" )
			{
				x_offset = 0 + ACS_Settings_Main_Float('acs_hud_camera_settings_main','acs_custom_camera_positioning_horse_camera_default_x', 0);

				y_offset = -0.6 + ACS_Settings_Main_Float('acs_hud_camera_settings_main','acs_custom_camera_positioning_horse_camera_default_y', 0);

				z_offset = 0.2 + ACS_Settings_Main_Float('acs_hud_camera_settings_main','acs_custom_camera_positioning_horse_camera_default_z', 0);
			}
			else if ( theGame.GetInGameConfigWrapper().GetVarValue('Gameplay', 'EnableAlternateHorseCamera') == "1" )
			{
				x_offset = 0 + ACS_Settings_Main_Float('acs_hud_camera_settings_main','acs_custom_camera_positioning_horse_camera_close_x', 0);

				y_offset = 0 + ACS_Settings_Main_Float('acs_hud_camera_settings_main','acs_custom_camera_positioning_horse_camera_close_y', 0);

				z_offset = 0.2 + ACS_Settings_Main_Float('acs_hud_camera_settings_main','acs_custom_camera_positioning_horse_camera_close_z', 0);
			}
		}
		else
		{
			moveData.pivotPositionController.offsetZ = 1.5f;

			if (combat_check)
			{
				rotation = GetACSWatcher().cLean;

				if (GetACSWatcher().combatLeanCheck)
				{
					combat_tilt_strength = 1;
				}
				else
				{
					combat_tilt_strength = 0.5;
				}

				moveData.pivotRotationValue.Roll = LerpAngleF( dt, moveData.pivotRotationValue.Roll, tilt_inversion * rotation.Roll * ACS_Settings_Main_Float('acs_hud_camera_settings_main','acs_custom_camera_tilt_strength', 0.25f) * combat_tilt_strength );

				if ( theGame.GetInGameConfigWrapper().GetVarValue('Gameplay', 'EnableAlternateCombatCamera') == "0" )
				{
					x_offset = 0 + ACS_Settings_Main_Float('acs_hud_camera_settings_main','acs_custom_camera_positioning_combat_camera_default_x', 0);

					if (ACS_Settings_Main_Bool('acs_hud_camera_settings_main','acs_dynamic_camera_positioning_enabled', true)
					) 
					{
						y_offset = -0.3 + ACS_Settings_Main_Float('acs_hud_camera_settings_main','acs_custom_camera_positioning_combat_camera_default_y', 0);
					}
					else
					{
						y_offset = 0.6 + ACS_Settings_Main_Float('acs_hud_camera_settings_main','acs_custom_camera_positioning_combat_camera_default_y', 0);
					}

					z_offset = 0.2 + ACS_Settings_Main_Float('acs_hud_camera_settings_main','acs_custom_camera_positioning_combat_camera_default_z', 0);
				}
				else if ( theGame.GetInGameConfigWrapper().GetVarValue('Gameplay', 'EnableAlternateCombatCamera') == "1" )
				{
					x_offset = 0.5 + ACS_Settings_Main_Float('acs_hud_camera_settings_main','acs_custom_camera_positioning_combat_camera_close_x', 0);

					if (ACS_Settings_Main_Bool('acs_hud_camera_settings_main','acs_dynamic_camera_positioning_enabled', true)
					) 
					{
						y_offset = 0.4875 + ACS_Settings_Main_Float('acs_hud_camera_settings_main','acs_custom_camera_positioning_combat_camera_close_y', 0);
					}
					else
					{
						y_offset = 0.65 + ACS_Settings_Main_Float('acs_hud_camera_settings_main','acs_custom_camera_positioning_combat_camera_close_y', 0);
					}

					z_offset = 0.00 + ACS_Settings_Main_Float('acs_hud_camera_settings_main','acs_custom_camera_positioning_combat_camera_close_z', 0);
				}
			}
			else
			{
				if (thePlayer.IsSwimming() || thePlayer.IsDiving())
				{
					rotation = GetACSWatcher().sLean;
				}
				else
				{
					rotation = GetACSWatcher().pLean;
				}
				
				moveData.pivotRotationValue.Roll = LerpAngleF( dt, moveData.pivotRotationValue.Roll, tilt_inversion * rotation.Roll * ACS_Settings_Main_Float('acs_hud_camera_settings_main','acs_custom_camera_tilt_strength', 0.25f) );

				if ( theGame.GetInGameConfigWrapper().GetVarValue('Gameplay', 'EnableAlternateExplorationCamera') == "0" )
				{
					x_offset = 0 + ACS_Settings_Main_Float('acs_hud_camera_settings_main','acs_custom_camera_positioning_camera_default_x', 0);

					y_offset = 0.6 + ACS_Settings_Main_Float('acs_hud_camera_settings_main','acs_custom_camera_positioning_camera_default_y', 0);

					z_offset = 0.2 + ACS_Settings_Main_Float('acs_hud_camera_settings_main','acs_custom_camera_positioning_camera_default_z', 0);
				}
				else if ( theGame.GetInGameConfigWrapper().GetVarValue('Gameplay', 'EnableAlternateExplorationCamera') == "1" )
				{
					x_offset = 1.00 + ACS_Settings_Main_Float('acs_hud_camera_settings_main','acs_custom_camera_positioning_camera_close_x', 0);

					y_offset = 2.65 + ACS_Settings_Main_Float('acs_hud_camera_settings_main','acs_custom_camera_positioning_camera_close_y', 0);

					z_offset = 0.00 + ACS_Settings_Main_Float('acs_hud_camera_settings_main','acs_custom_camera_positioning_camera_close_z', 0);
				}
			}
		}
	}

	if (focus_mode_check && ACS_Settings_Main_Bool('acs_hud_settings_focus_mode','acs_custom_focus_mode_camera_enabled', true))
	{
		if (x_offset != 0 && (ACS_Settings_Main_Float('acs_hud_settings_focus_mode','acs_custom_focus_mode_camera_x_offset_adjust_strength', 0) > 0))
		{
			if (x_offset > 0 )
			{
				if (headingDiff > 0)
				{
					if (headingDiff > 140)
					{
						x_offsetAdjusted = x_offset;
					}
					else
					{
						if (headingDiff > 55)
						{
							x_offsetAdjusted = 0 - x_offset;
						}
						else
						{
							x_offsetAdjusted = x_offset - (headingDiff * (ACS_Settings_Main_Float('acs_hud_settings_focus_mode','acs_custom_focus_mode_camera_x_offset_adjust_strength', 0) * 0.0625));
						}
					}
				}
				else
				{
					x_offsetAdjusted = x_offset;
				}
			}
			else if (x_offset < 0 )
			{
				if (headingDiff < 0)
				{
					if (headingDiff < -140)
					{
						x_offsetAdjusted = x_offset;
					}
					else
					{
						if (headingDiff < -55)
						{
							x_offsetAdjusted = 0 - x_offset;
						}
						else
						{
							x_offsetAdjusted = x_offset - (headingDiff * (ACS_Settings_Main_Float('acs_hud_settings_focus_mode','acs_custom_focus_mode_camera_x_offset_adjust_strength', 0) * 0.0625));
						}
					}
				}
				else
				{
					x_offsetAdjusted = x_offset;
				}
			}
		}
		else
		{
			x_offsetAdjusted = x_offset;
		}
	}
	else
	{
		if (x_offset != 0 && (ACS_Settings_Main_Float('acs_hud_camera_settings_main','acs_custom_camera_x_offset_adjust_strength', 0) > 0))
		{
			if (x_offset > 0 )
			{
				if (headingDiff > 0)
				{
					if (headingDiff > 140)
					{
						x_offsetAdjusted = x_offset;
					}
					else
					{
						if (headingDiff > 55)
						{
							x_offsetAdjusted = 0 - x_offset;
						}
						else
						{
							x_offsetAdjusted = x_offset - (headingDiff * (ACS_Settings_Main_Float('acs_hud_camera_settings_main','acs_custom_camera_x_offset_adjust_strength', 0) * 0.0625));
						}
					}
				}
				else
				{
					x_offsetAdjusted = x_offset;
				}
			}
			else if (x_offset < 0 )
			{
				if (headingDiff < 0)
				{
					if (headingDiff < -140)
					{
						x_offsetAdjusted = x_offset;
					}
					else
					{
						if (headingDiff < -55)
						{
							x_offsetAdjusted = 0 - x_offset;
						}
						else
						{
							x_offsetAdjusted = x_offset - (headingDiff * (ACS_Settings_Main_Float('acs_hud_camera_settings_main','acs_custom_camera_x_offset_adjust_strength', 0) * 0.0625));
						}
					}
				}
				else
				{
					x_offsetAdjusted = x_offset;
				}
			}
		}
		else
		{
			x_offsetAdjusted = x_offset;
		}
	}

	if ((((CNewNPC)thePlayer.GetTarget()
	&& ACS_AttitudeCheck ( ((CActor)thePlayer.GetTarget()) ) 
	)
	&& 
	( ((CNewNPC)thePlayer.GetTarget()).HasTag('ACS_Big_Boi')
	|| ((CNewNPC)thePlayer.GetTarget()).HasAbility('mon_toad_base')
	|| ((CNewNPC)thePlayer.GetTarget()).HasAbility('mon_type_huge')
	|| ((CMovingPhysicalAgentComponent)(((CNewNPC)thePlayer.GetTarget()).GetMovingAgentComponent())).GetCapsuleHeight() >= 2
	|| ((CNewNPC)thePlayer.GetTarget()).GetRadius() >= 0.7
	|| ((CNewNPC)thePlayer.GetTarget()).IsFlying()
	//|| !((CNewNPC)thePlayer.GetTarget()).IsOnGround()
	//|| ((CNewNPC)thePlayer.GetTarget()).IsInAir()
	|| thePlayer.IsInAir()
	|| !thePlayer.WasVisibleInScaledFrame( ((CNewNPC)thePlayer.GetTarget()), 0.9f, 0.9f )
	)
	)
	)
	{
		if (((CNewNPC)thePlayer.GetTarget()).IsFlying())
		{
			y_offsetLargeTarget = 1.75;
		}
		else
		{
			y_offsetLargeTarget = 0.5;
		}

		if (thePlayer.IsInAir())
		{
			z_offsetLargeTarget = 0;
		}
		else
		{
			if 
			(
				((CNewNPC)thePlayer.GetTarget()).GetSfxTag() == 'sfx_ice_giant'
				|| ((CNewNPC)thePlayer.GetTarget()).HasAbility('mon_cyclops')
				|| ((CNewNPC)thePlayer.GetTarget()).HasAbility('mon_knight_giant')
				|| ((CNewNPC)thePlayer.GetTarget()).HasAbility('mon_cloud_giant')
			)
			{
				z_offsetLargeTarget = 0.7;
			}
			else
			{
				z_offsetLargeTarget = 0.2;
			}
		}
	}
	else
	{
		y_offsetLargeTarget = 0;

		z_offsetLargeTarget = 0;
	}
		
	if (headingDiff >= 135 )
	{
		y_offsetFacingCamera = 1;
	}
	else if (headingDiff < -135 )
	{
		y_offsetFacingCamera = 1;
	}
	else
	{
		y_offsetFacingCamera = 0;
	}

	if ( thePlayer.playerMoveType == PMT_Run 
	|| thePlayer.playerMoveType == PMT_Sprint 
	)
	{
		y_offsetSprint = 0.25;
	}
	else
	{
		y_offsetSprint = 0;
	}

	if ( thePlayer.IsDodgeTimerRunning()
	|| thePlayer.IsCurrentlyDodging() 
	|| thePlayer.HasTag('ACS_Is_Currently_Dodging')
	)
	{
		if (
		theInput.GetActionValue('GI_AxisLeftY') == 0 
		&& theInput.GetActionValue('GI_AxisLeftX') == 0 
		)
		{
			y_offsetDodge = 0.75;
		}
		else
		{
			if (theInput.GetActionValue('GI_AxisLeftY') < 0)
			{
				y_offsetDodge = 0.75;
			}
			else
			{
				y_offsetDodge = 0.25;
			}
		}
	}
	else
	{
		y_offsetDodge = 0;
	}

	if (!ACS_Settings_Main_Bool('acs_hud_camera_settings_main','acs_dynamic_camera_positioning_enabled', true))
	{
		y_offsetDodge = 0;

		y_offsetFacingCamera = 0;

		//y_offsetLargeTarget = 0;
	}

	y_offsetAdjusted =  y_offset - y_offsetDodge - y_offsetLargeTarget - y_offsetFacingCamera - y_offsetSprint - GetACSWatcher().y_offsetHeadbone;

	z_offsetAdjusted = z_offset - z_offsetLargeTarget;

	blendMultiplier = 1;

	v = Vector(
		x_offsetAdjusted * (blendMultiplier * 2),
		y_offsetAdjusted * (blendMultiplier * 2),
		z_offsetAdjusted * (blendMultiplier * 2)
	);

	DampVectorSpring( moveData.cameraLocalSpaceOffset, moveData.cameraLocalSpaceOffsetVel, v, blendMultiplier, dt );
}


@addField(CR4Player)
private var acs_fovVel : float;


@wrapMethod( CR4Player ) function OnGameCameraTick( out moveData : SCameraMovementData, dt : float )
{
	var targetRotation								: EulerAngles;
	var dist 										: float;
	var v, bone_pos									: Vector;
	var x_offset, y_offset, z_offset				: float;
	var x_offsetAdjusted							: float;
	var y_offsetAdjusted							: float;
	var z_offsetAdjusted							: float;
	var y_offsetSprint								: float;
	var y_offsetDodge								: float;
	var y_offsetFacingCamera						: float;
	var y_offsetLargeTarget							: float;
	var z_offsetLargeTarget							: float;
	var headingDiff									: float;
	var camera 										: CCustomCamera;
	var fov											: float;
	var rotation									: EulerAngles;
	var tilt_inversion								: float;

	if (false)
	{
		wrappedMethod(moveData, dt);
	}

	if( thePlayer.IsInCombat() )
	{
		dist = VecDistance2D( thePlayer.GetWorldPosition(), thePlayer.GetTarget().GetWorldPosition() );
		thePlayer.GetVisualDebug().AddText( 'dbg', dist, thePlayer.GetWorldPosition() + Vector( 0.f,0.f,2.f ), true, , Color( 0, 255, 0 ) );
	}
	
	if ( isStartingFistFightMinigame )
	{
		moveData.pivotRotationValue = fistFightTeleportNode.GetWorldRotation();
		isStartingFistFightMinigame = false;
	}
	
	if( substateManager.UpdateCameraIfNeeded( moveData, dt ) )
	{
		return true;
	}

	if( customCameraStack.Size() > 0 )
	{
	
	}



	camera = theGame.GetGameCamera();

	if (camera)
	{
		if ( theGame.IsFocusModeActive() )
		{
			fov = ACS_Settings_Main_Float('acs_hud_settings_focus_mode','acs_focus_mode_fov', 75);
		}
		else
		{
			if (
			thePlayer.IsUsingHorse()
			|| thePlayer.IsUsingVehicle()
			)
			{
				if (
				thePlayer.IsUsingHorse()
				)
				{
					fov = ACS_Settings_Main_Float('acs_hud_camera_settings_main','acs_horse_fov', 75);
				}
				else
				{
					fov = ACS_Settings_Main_Float('acs_hud_camera_settings_main','acs_vehicle_fov', 75);
				}
			}
			else
			{
				if (
				thePlayer.IsInCombat() 
				|| thePlayer.IsThreatened()
				|| !ACS_CombatToExplorationCheck()
				)
				{
					fov = ACS_Settings_Main_Float('acs_hud_camera_settings_main','acs_combat_fov', 75);
				}
				else
				{
					fov = ACS_Settings_Main_Float('acs_hud_camera_settings_main','acs_exploration_fov', 75);
				}
			}
		}
			
		DampFloatSpring( camera.fov, acs_fovVel, fov, 1.0, dt );
	}
	
	if (FactsQuerySum("ACS_In_Meditation") > 0 
	|| GetACSWatcher().meditation_block 
	)
	{
		if (GetExplCamera())
		{
			SetExplCamera(false);
		}

		headingDiff = AngleDistance( VecHeading( theCamera.GetCameraDirection() ), VecHeading( thePlayer.GetHeadingVector() ) );

		moveData.pivotPositionController.SetDesiredPosition( thePlayer.GetWorldPosition());
		
		x_offset = 0 + ACS_Settings_Main_Float('acs_meditation_settings','acs_meditation_camera_positioning_x', 0);

		y_offset = 0 + ACS_Settings_Main_Float('acs_meditation_settings','acs_meditation_camera_positioning_y', 0);

		z_offset = 0 + ACS_Settings_Main_Float('acs_meditation_settings','acs_meditation_camera_positioning_z', 0);

		if (x_offset != 0 && (ACS_Settings_Main_Float('acs_meditation_settings','acs_meditation_camera_x_offset_adjust_strength', 0) > 0))
		{
			if (x_offset > 0 )
			{
				if (headingDiff > 0)
				{
					if (headingDiff > 140)
					{
						x_offsetAdjusted = x_offset;
					}
					else
					{
						if (headingDiff > 55)
						{
							x_offsetAdjusted = 0 - x_offset;
						}
						else
						{
							x_offsetAdjusted = x_offset - (headingDiff * (ACS_Settings_Main_Float('acs_meditation_settings','acs_meditation_camera_x_offset_adjust_strength', 0) * 0.0625));
						}
					}
				}
				else
				{
					x_offsetAdjusted = x_offset;
				}
			}
			else if (x_offset < 0 )
			{
				if (headingDiff < 0)
				{
					if (headingDiff < -140)
					{
						x_offsetAdjusted = x_offset;
					}
					else
					{
						if (headingDiff < -55)
						{
							x_offsetAdjusted = 0 - x_offset;
						}
						else
						{
							x_offsetAdjusted = x_offset - (headingDiff * (ACS_Settings_Main_Float('acs_meditation_settings','acs_meditation_camera_x_offset_adjust_strength', 0) * 0.0625));
						}
					}
				}
				else
				{
					x_offsetAdjusted = x_offset;
				}
			}
		}
		else
		{
			x_offsetAdjusted = x_offset;
		}

		if ((((CNewNPC)thePlayer.GetTarget()
		&& ACS_AttitudeCheck ( ((CActor)thePlayer.GetTarget()) ) 
		)
		&& 
		( ((CNewNPC)thePlayer.GetTarget()).HasTag('ACS_Big_Boi')
		|| ((CNewNPC)thePlayer.GetTarget()).HasAbility('mon_toad_base')
		|| ((CNewNPC)thePlayer.GetTarget()).HasAbility('mon_type_huge')
		|| ((CMovingPhysicalAgentComponent)(((CNewNPC)thePlayer.GetTarget()).GetMovingAgentComponent())).GetCapsuleHeight() >= 2
		|| ((CNewNPC)thePlayer.GetTarget()).GetRadius() >= 0.7
		|| ((CNewNPC)thePlayer.GetTarget()).IsFlying()
		//|| !((CNewNPC)thePlayer.GetTarget()).IsOnGround()
		//|| ((CNewNPC)thePlayer.GetTarget()).IsInAir()
		|| thePlayer.IsInAir()
		|| !thePlayer.WasVisibleInScaledFrame( ((CNewNPC)thePlayer.GetTarget()), 0.9f, 0.9f )
		)
		)
		)
		{
			if (((CNewNPC)thePlayer.GetTarget()).IsFlying())
			{
				y_offsetLargeTarget = 1.75;
			}
			else
			{
				y_offsetLargeTarget = 0.5;
			}

			if (thePlayer.IsInAir())
			{
				z_offsetLargeTarget = 0;
			}
			else
			{
				if 
				(
					((CNewNPC)thePlayer.GetTarget()).GetSfxTag() == 'sfx_ice_giant'
					|| ((CNewNPC)thePlayer.GetTarget()).HasAbility('mon_cyclops')
					|| ((CNewNPC)thePlayer.GetTarget()).HasAbility('mon_knight_giant')
					|| ((CNewNPC)thePlayer.GetTarget()).HasAbility('mon_cloud_giant')
				)
				{
					z_offsetLargeTarget = 0.7;
				}
				else
				{
					z_offsetLargeTarget = 0.2;
				}
			}
		}
		else
		{
			y_offsetLargeTarget = 0;

			z_offsetLargeTarget = 0;
		}

		if (headingDiff >= 135 )
		{
			y_offsetFacingCamera = 1;
		}
		else if (headingDiff < -135 )
		{
			y_offsetFacingCamera = 1;
		}
		else
		{
			y_offsetFacingCamera = 0;
		}

		if ( thePlayer.playerMoveType == PMT_Run 
		|| thePlayer.playerMoveType == PMT_Sprint 
		)
		{
			y_offsetSprint = 0.25;
		}
		else
		{
			y_offsetSprint = 0;
		}

		if ( thePlayer.IsDodgeTimerRunning()
		|| thePlayer.IsCurrentlyDodging() 
		|| thePlayer.HasTag('ACS_Is_Currently_Dodging')
		)
		{
			if (
			theInput.GetActionValue('GI_AxisLeftY') == 0 
			&& theInput.GetActionValue('GI_AxisLeftX') == 0 
			)
			{
				y_offsetDodge = 0.75;
			}
			else
			{
				if (theInput.GetActionValue('GI_AxisLeftY') < 0)
				{
					y_offsetDodge = 0.75;
				}
				else
				{
					y_offsetDodge = 0.25;
				}
			}
		}
		else
		{
			y_offsetDodge = 0;
		}

		if (!ACS_Settings_Main_Bool('acs_hud_camera_settings_main','acs_dynamic_camera_positioning_enabled', true))
		{
			y_offsetDodge = 0;

			y_offsetFacingCamera = 0;

			//y_offsetLargeTarget = 0;
		}

		y_offsetAdjusted =  y_offset - y_offsetDodge - y_offsetLargeTarget - y_offsetFacingCamera - y_offsetSprint;

		z_offsetAdjusted = z_offset - z_offsetLargeTarget;

		v = Vector(
			x_offsetAdjusted,
			y_offsetAdjusted,
			z_offsetAdjusted
		);

		DampVectorSpring( moveData.cameraLocalSpaceOffset, moveData.cameraLocalSpaceOffsetVel, v, 0.5f, dt );

		return true;
	}

	if ( !ACS_Settings_Main_Bool('acs_hud_camera_settings_main','acs_custom_camera_positioning_enabled', true) )
	{
		if ( theGame.GetInGameConfigWrapper().GetVarValue('Gameplay', 'EnableAlternateExplorationCamera') == "0" )
		{
			if (GetExplCamera())
			{
				SetExplCamera(false);
			}
		}

		else if ( theGame.GetInGameConfigWrapper().GetVarValue('Gameplay', 'EnableAlternateExplorationCamera') == "1" )
		{
			if (!GetExplCamera())
			{
				SetExplCamera(true);
			}
		}
	}

	ACS_OnGameCameraTick(moveData, dt);
	
	if (
	thePlayer.IsInCombat() 
	|| thePlayer.IsThreatened()
	|| !ACS_CombatToExplorationCheck()
	)
	{
		if (ACS_Settings_Main_Bool('acs_hud_camera_settings_main','acs_custom_combat_camera_positioning_enabled', true) 
		&& ACS_Settings_Main_Bool('acs_hud_camera_settings_main','acs_custom_camera_positioning_enabled', true) )
		{
			return true;
		}
		
		return false;
	}

	if (
	thePlayer.IsUsingHorse()
	)
	{
		if (ACS_Settings_Main_Bool('acs_hud_camera_settings_main','acs_custom_horse_camera_positioning_enabled', true) 
		&& ACS_Settings_Main_Bool('acs_hud_camera_settings_main','acs_custom_camera_positioning_enabled', true) )
		{
			return true;
		}

		return false;
	}

	return false;
}

@wrapMethod( CR4Player ) function GetCameraPadding() : float
{
	if (false)
	{
		wrappedMethod();
	}

	return 0.02f; 
}

@wrapMethod( Swimming ) function OnGameCameraPostTick( out moveData : SCameraMovementData, dt : float )
{
	var cameraRotation : EulerAngles;
	var cameraPosition : Vector;
	var waterLevel : float;
	var diff : float;
	
	var divePitch : float;
	var angleDistBetweenPlayerAndCamera : float;
	var playerToTargetVector : Vector;
	var playerToTargetAngles : EulerAngles;
	var playerToTargetPitch : float;

	if (false)
	{
		wrappedMethod(moveData, dt);
	}
	
	
	lerpAmount += dt/2;
	lerpAmount = ClampF(lerpAmount,0,1);
	
	
	cameraPosition = theCamera.GetCameraPosition();
	waterLevel = theGame.GetWorld().GetWaterLevel(cameraPosition, true);
	diff = cameraPosition.Z - waterLevel;
	
	
	UpdateDivingPitch();
	
	if ( cameraIsUnderwater && diff >= 0 )
	{
		parent.PlayEffect('water_effect_surfacing');
		cameraIsUnderwater = false;
		theSound.SoundEvent("fx_underwater_off");
	}
	else if ( !cameraIsUnderwater && diff < 0 )
	{
		cameraIsUnderwater = true;
		theSound.SoundEvent("fx_underwater_on");
	}
	
	
	{
		cameraRotation = theCamera.GetCameraRotation();
		cameraPitch = AngleNormalize180(cameraRotation.Pitch);
		
		angleDistBetweenPlayerAndCamera = AbsF(AngleDistance(parent.GetHeading(),VecHeading(theCamera.GetCameraDirection())));
		
		if ( ( cameraPitch < 0 && !OnAllowedDiveDown() ) || angleDistBetweenPlayerAndCamera > 135 )
			parent.SetBehaviorVariable( 'cameraPitch', 0.f);
		else
			parent.SetBehaviorVariable( 'cameraPitch', cameraPitch);
	}
	
	
	
	
	
	if ( parent.IsCameraLockedToTarget() )
	{
		playerToTargetVector = parent.GetDisplayTarget().GetWorldPosition() - parent.GetWorldPosition();
		
		moveData.pivotRotationController.SetDesiredHeading( VecHeading( playerToTargetVector ), 0.5f );
		
		playerToTargetAngles = VecToRotation( playerToTargetVector );
		playerToTargetPitch = playerToTargetAngles.Pitch + 10;
		moveData.pivotRotationController.SetDesiredPitch( playerToTargetPitch * -1, 0.5f );
	}
	else if ( moveData.pivotRotationController.controllerName == 'Diving' )
	{
		divePitch = parent.GetBehaviorVariable('divePitch');
		
		if ( divePitch <= -1.f )
		{
			moveData.pivotRotationController.SetDesiredPitch(-89.f);
			moveData.pivotRotationController.minPitch = -80.f;
			moveData.pivotRotationController.maxPitch = 80.f;
		}
		else if ( divePitch >= 1.f )
		{ 
			moveData.pivotRotationController.SetDesiredPitch(89.f);
			moveData.pivotRotationController.maxPitch = 80.f;
			moveData.pivotRotationController.minPitch = -80.f;
		}
		else
		{
			if ( !thePlayer.GetIsSprinting() )
				moveData.pivotRotationController.SetDesiredPitch(0.0);
				
			if ( isCiri )
			{
				moveData.pivotRotationController.minPitch = -80.f;
				moveData.pivotRotationController.maxPitch = 80.f;
			}
			else
			{
				moveData.pivotRotationController.minPitch = -80.f;
				moveData.pivotRotationController.maxPitch = 80.f;
			}
		}
		
		
	}
	else if ( divingEnd )
	{
		
		moveData.pivotRotationController.SetDesiredPitch(-10.0, 3.f);
		theGame.GetGameCamera().ForceManualControlHorTimeout();
	}
	else if ( moveData.pivotRotationController.controllerName == 'Swimming' )
	{
		moveData.pivotRotationController.SetDesiredPitch(-10.0);
	}
	
	if ( moveData.pivotPositionController.controllerName == 'Diving' )
	{
		if ( parent.rawPlayerSpeed == 0 )
		{
			moveData.pivotPositionController.offsetZ = 1.75f;
		}
		else
		{
			moveData.pivotPositionController.offsetZ = 1.15f;
		}
	}
	
	else if ( moveData.pivotDistanceController.controllerName == 'Diving' )
	{
		if ( cameraPitch < 0 && diff >= -0.25 )
		{
			moveData.pivotDistanceController.SetDesiredDistance(0);
		}
		else if ( parent.rawPlayerSpeed == 0 )
		{
			moveData.pivotDistanceController.SetDesiredDistance(2.25);
		}
		else
		{
			moveData.pivotDistanceController.SetDesiredDistance(2.75);
		}
	}
	
	
	if(parent.GetExplCamera())
	{	
		moveData.pivotPositionController.SetDesiredPosition( parent.GetWorldPosition(), 15.f );
		moveData.pivotDistanceController.SetDesiredDistance( 2.25f );
	
		moveData.pivotPositionController.offsetZ = 1.15f;

		moveData.cameraLocalSpaceOffset = LerpV(moveData.cameraLocalSpaceOffset, Vector(0.74,-0.38,0.345), lerpAmount);
		moveData.cameraLocalSpaceOffsetVel = Vector(0,0,0);	
	}
	
	
	super.OnGameCameraPostTick( moveData, dt );
}

@wrapMethod( HorseRiding ) function OnGameCameraTick( out moveData : SCameraMovementData, dt : float )
{
	if (
	thePlayer.IsUsingHorse()
	)
	{
		if (ACS_Settings_Main_Bool('acs_hud_camera_settings_main','acs_custom_horse_camera_positioning_enabled', true) )
		{
			ACS_OnGameCameraTick(moveData, dt);

			return true;
		}
	}

	return wrappedMethod(moveData, dt);
}


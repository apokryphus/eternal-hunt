@addField(W3POI_BanditCampEntity)
protected var acs_has_spawned_bandit_camp_poi    : bool;

@wrapMethod(W3POI_BanditCampEntity) function OnAreaEnter( area : CTriggerAreaComponent, activator : CComponent )
{
	var ent	: CACSMonsterSpawner;
	var component : CComponent;

	if ( activator.GetEntity() == thePlayer )
	{
		component = GetComponent( "FirstDiscoveryTrigger" );

		if( area == component )
		{
			if ( GetWitcherPlayer()
			&& !ACS_Player_Near_Quest_Marker()
			&& !thePlayer.IsInGameplayScene()
			&& !theGame.IsCurrentlyPlayingNonGameplayScene()
			&& !theGame.IsDialogOrCutscenePlaying() 
			&& !thePlayer.IsInNonGameplayCutscene() 
			)
			{
				if (!acs_has_spawned_bandit_camp_poi)
				{
					switch (RandRange(4, 1))
					{
						case 4:
							if (RandF() < ACS_AdditionalWorldEncountersSpawnChance('acs_shade_encounter_enabled',1))
							{
								ent = (CACSMonsterSpawner)theGame.CreateEntity( 

								(CEntityTemplate)LoadResource( "dlc\dlc_acs\data\entities\other\acs_monster_spawner.w2ent", true ), 

								this.GetWorldPosition(), 

								this.GetWorldRotation() );

								ent.AddTag('ACS_MonsterSpawner_Shade');

								ent.AddTag('ACS_MonsterSpawner_Spawn_In_Combat');
							}
						break;
						
						case 3:
							if (RandF() < ACS_AdditionalWorldEncountersSpawnChance('acs_dual_wield_elves_encounter_enabled',1)
							&& theGame.GetWorld().GetDepotPath() == "levels\novigrad\novigrad.w2w"
							)
							{
								ent = (CACSMonsterSpawner)theGame.CreateEntity( 

								(CEntityTemplate)LoadResource( "dlc\dlc_acs\data\entities\other\acs_monster_spawner.w2ent", true ), 

								ACSFixZAxis(this.GetWorldPosition()), 

								this.GetWorldRotation() );

								ent.AddTag('ACS_MonsterSpawner_DualWieldElves');

								ent.AddTag('ACS_MonsterSpawner_Spawn_In_Combat');
							}
						break;

						case 2:
							if (RandF() < ACS_AdditionalWorldEncountersSpawnChance('acs_dracogryph_encounter_enabled',0.5))
							{
								ent = (CACSMonsterSpawner)theGame.CreateEntity( 

								(CEntityTemplate)LoadResource( "dlc\dlc_acs\data\entities\other\acs_monster_spawner.w2ent", true ), 

								ACSFixZAxis(this.GetWorldPosition()), 

								this.GetWorldRotation() );

								ent.AddTag('ACS_MonsterSpawner_Dracogryph');

								ent.AddTag('ACS_MonsterSpawner_Spawn_In_Combat');
							}
						break;

						case 1:
							if (ACS_AdditionalWorldEncountersSpawnChance('acs_night_witch_encounter_enabled',0.5) > 0)
							{
								if (RandF() < ACS_AdditionalWorldEncountersSpawnChance('acs_night_witch_encounter_enabled',0.5))
								{
									ent = (CACSMonsterSpawner)theGame.CreateEntity( 

									(CEntityTemplate)LoadResource( "dlc\dlc_acs\data\entities\other\acs_monster_spawner.w2ent", true ), 

									ACSFixZAxis(this.GetWorldPosition()), 

									this.GetWorldRotation() );

									ent.AddTag('ACS_MonsterSpawner_Devourer');

									ent.AddTag('ACS_MonsterSpawner_Spawn_In_Combat');
								}
							}
						break;

						default:
							if (ACS_AdditionalWorldEncountersSpawnChance('acs_night_witch_encounter_enabled',0.5) > 0)
							{
								if (RandF() < ACS_AdditionalWorldEncountersSpawnChance('acs_night_witch_encounter_enabled',0.5))
								{
									ent = (CACSMonsterSpawner)theGame.CreateEntity( 

									(CEntityTemplate)LoadResource( "dlc\dlc_acs\data\entities\other\acs_monster_spawner.w2ent", true ), 

									ACSFixZAxis(this.GetWorldPosition()), 

									this.GetWorldRotation() );

									ent.AddTag('ACS_MonsterSpawner_Devourer');

									ent.AddTag('ACS_MonsterSpawner_Spawn_In_Combat');
								}
							}
						break;
					}

					acs_has_spawned_bandit_camp_poi = true;
				}
			}
		}
	}

	wrappedMethod(area, activator);
}


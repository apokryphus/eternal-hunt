@addField( CEntity ) 
var ACS_delayedPlayEffectName : name;

@addField( CEntity ) 
var ACS_delayedStopEffectName : name;

@addField( CEntity ) 
var ACS_delayedPlayEffectTarget : CNode;

@addField( CEntity ) 
var ACS_TagToRemove : name;

@addMethod( CEntity ) function ACS_PlayEffectAfter(effectName : name, delay : float, optional target : CNode)
{
	ACS_delayedPlayEffectName = effectName;

	if (target)
	{
		ACS_delayedPlayEffectTarget = target;
	}
	
	AddTimer('ACS_PlayEffectAfterTimer',delay,false, , , true);
}

@addMethod( CEntity ) timer function ACS_PlayEffectAfterTimer(dt:float,id:int)
{
	PlayEffect( ACS_delayedPlayEffectName, ACS_delayedPlayEffectTarget  );
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

@addMethod( CEntity ) function ACS_StopEffectAfter(effectName : name, delay : float, optional target : CNode)
{
	ACS_delayedStopEffectName = effectName;
	
	AddTimer('ACS_StopEffectAfterTimer',delay,false, , , true);
}

@addMethod( CEntity ) timer function ACS_StopEffectAfterTimer(dt:float,id:int)
{
	StopEffect( ACS_delayedStopEffectName);
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

@addMethod( CEntity ) function ACS_RemoveTagAfter(tag : name, delay : float)
{
	ACS_TagToRemove = tag;
	
	AddTimer('ACS_RemoveTagAfterTimer',delay,false, , , true);
}

@addMethod( CEntity ) timer function ACS_RemoveTagAfterTimer(dt:float,id:int)
{
	RemoveTag( ACS_TagToRemove );
}


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

@addMethod( W3Petard ) timer function ACS_DetonationTimer( detlaTime : float , id : int)
{
	var targets, additionalTargets : array< CGameplayEntity >;
	var i, j, clusterNbr : int;
	var victimTags, attackerTags : array<name>;
	var dist, camShakeStr, camShakeStrFrac : float;
	var temp, isPerk16Active : bool;
	var phantom : CPhantomComponent;
	var meshes : array<CComponent>;
	var mesh : CMeshComponent;
	var npc : CNewNPC;
	var explosionPosition : Vector;
	var dmg				: W3DamageAction;

	var clusterBomb : W3Petard;
	var targetPosCluster, clusterInitPos : Vector;
	var angle, velocity, distLen : float;
	var clusterTemplate : CEntityTemplate;
	var dmgRaw : SRawDamage;
	var cachedDamages : array<SRawDamage>;
	var atts : array<name>;
	var distanceToTarget : float;
	var projectileFlightTime : float;
	var collisionGroups : array<name>;

	stopCollisions = true;

	meshes = GetComponentsByClassName('CMeshComponent');
	for(i=0; i<meshes.Size(); i+=1)
	{
		mesh = (CMeshComponent)meshes[i];
		if( !mesh )
		{
			continue;
		}
		
		mesh.SetVisible(false);
		mesh.SetEnabled(false);
	}
	
	if ( explosionPosition == Vector( 0, 0, 0 ) )
	{
		explosionPosition = this.GetWorldPosition();
	}
	
	
	explosionPosition = explosionPosition + Vector( 0.0f, 0.0f, 0.1f );

	FindGameplayEntitiesInSphere(targets, explosionPosition, impactParams.range, 1000);	

	for ( i = 0 ; i < targets.Size() ; i += 1 )
	{
		npc = (CNewNPC)targets[i];

		if (npc 
		&& npc != thePlayer
		&& GetAttitudeBetween( npc, GetWitcherPlayer() ) == AIA_Hostile
		)
		{
			dmg = new W3DamageAction in theGame.damageMgr;
			
			dmg.Initialize(GetWitcherPlayer(), npc, NULL, GetWitcherPlayer().GetName(), EHRT_Heavy, CPS_Undefined, false, false, true, false);
			
			dmg.SetProcessBuffsIfNoDamage(true);
			
			dmg.SetHitReactionType( EHRT_Heavy, true);

			dmg.SetHitAnimationPlayType(EAHA_ForceYes);

			if (HasTag('ACS_Is_Cluster_Bomb'))
			{
				if (npc.UsesVitality()) 
				{ 
					dmg.AddDamage( theGame.params.DAMAGE_NAME_PHYSICAL, 100 );
				} 
				else if (npc.UsesEssence()) 
				{ 
					dmg.AddDamage( theGame.params.DAMAGE_NAME_SILVER, 100 );
				} 
			}
			else
			{
				if (npc.GetCurrentHealth() >= npc.GetMaxHealth() * 0.5) 
				{ 
					if (npc.UsesVitality()) 
					{ 
						dmg.AddDamage( theGame.params.DAMAGE_NAME_PHYSICAL, npc.GetStat( BCS_Vitality ) * 0.25 );
					} 
					else if (npc.UsesEssence()) 
					{ 
						dmg.AddDamage( theGame.params.DAMAGE_NAME_SILVER, npc.GetStat( BCS_Essence ) * 0.25 );
					} 
				}
				else
				{
					if (npc.UsesVitality()) 
					{ 
						dmg.AddDamage( theGame.params.DAMAGE_NAME_PHYSICAL, (npc.GetStatMax( BCS_Vitality ) - npc.GetStat( BCS_Vitality )) * 0.25 );
					} 
					else if (npc.UsesEssence()) 
					{ 
						dmg.AddDamage( theGame.params.DAMAGE_NAME_SILVER, (npc.GetStatMax( BCS_Essence ) - npc.GetStat( BCS_Essence )) * 0.25 );
					} 
				}
			}

			((CNewNPC)npc).ACS_DealPostureDamage(30);

			if (this.HasTag('ACS_Bomb_Add_Frozen'))
			{
				dmg.AddEffectInfo(EET_Frozen, 3);
			}
			else if (this.HasTag('ACS_Bomb_Add_Poison'))
			{
				dmg.AddEffectInfo(EET_Poison, 10);
			}
			else if (this.HasTag('ACS_Bomb_Add_Knockdown'))
			{
				dmg.AddEffectInfo(EET_Knockdown, 1);
			}
			else if (this.HasTag('ACS_Bomb_Add_Blindness'))
			{
				dmg.AddEffectInfo(EET_Blindness, 3);
			}
			else
			{
				dmg.AddEffectInfo(EET_Stagger, 3);
			}

			dmg.SetForceExplosionDismemberment();

			dmg.SetCriticalHit(); theGame.damageMgr.ProcessAction( dmg );
				
			delete dmg;
		}
	}

	
	SnapComponents(true);
			
	if (this.HasTag('ACS_Mounted_Attack_Bomb'))
	{
		ProcessMechanicalEffect(targets, true);
		
		PlayEffectSingle('explode_physx_grapeshot');

		PlayEffectSingle('fragmentation_grapeshot');

		//PlayEffectSingle('explosion_grapeshot');

		PlayEffectSingle('explosion_cluster_grapeshot');

		PlayEffectSingle('explosion_dancing_star');

		PlayEffectSingle('fire1_dancing_star');

		PlayEffectSingle('fx_cluster_cleave');

		PlayEffectSingle('explode_glyphword');
	}

	if (!HasTag('ACS_Is_Cluster_Bomb') && GetWitcherPlayer().CanUseSkill(S_Alchemy_s11) && !HasTag('Snowball'))
	{
		for(j=0; j<3; j+=1)
		{			
			targetPosCluster.X = SgnF(RandF()-0.5) * (1+RandF()*3);
			targetPosCluster.Y = SgnF(RandF()-0.5) * (1+RandF()*3);
			targetPosCluster.Z = 0;
			
			distLen = VecLength2D(targetPosCluster);	
			
			targetPosCluster += GetWorldPosition();		

			targetPosCluster.Z += RandRangeF(1,-1);

			clusterBomb = (W3Petard)theGame.CreateEntity( (CEntityTemplate)LoadResource( 
			"dlc\dlc_acs\data\entities\projectiles\acs_shrapnel_bomb.w2ent"
			, true ), targetPosCluster, GetWorldRotation() );

			clusterBomb.Init(thePlayer);
			
			angle = (9 - distLen) * 10;					
			velocity = 4 + distLen/2;					
			
			collisionGroups.PushBack('Ragdoll');
			collisionGroups.PushBack('Terrain');
			collisionGroups.PushBack('Static');
			collisionGroups.PushBack('Water');
			collisionGroups.PushBack('Destructible');
			//clusterBomb.ShootProjectileAtPosition( angle, velocity, targetPosCluster, theGame.params.MAX_THROW_RANGE * 0.5, collisionGroups );

			clusterBomb.RemoveTimer('ACS_DetonationTimer');
			clusterBomb.AddTimer('ACS_DetonationTimer', RandRangeF(0.5, 0.1) , false );

			if (this.HasTag('ACS_Bomb_Add_Frozen'))
			{
				clusterBomb.AddTag('ACS_Bomb_Add_Frozen');
			}
			else if (this.HasTag('ACS_Bomb_Add_Poison'))
			{
				clusterBomb.AddTag('ACS_Bomb_Add_Poison');
			}
			else if (this.HasTag('ACS_Bomb_Add_Knockdown'))
			{
				clusterBomb.AddTag('ACS_Bomb_Add_Knockdown');
			}
			else if (this.HasTag('ACS_Bomb_Add_Blindness'))
			{
				clusterBomb.AddTag('ACS_Bomb_Add_Blindness');
			}
		
			clusterBomb.AddTag('ACS_Is_Cluster_Bomb');

			clusterBomb.PlayEffectSingle(FX_TRAIL);
		}
	}

	if(cameraShakeStrMin + cameraShakeStrMax > 0)	
	{
		dist = VecDistance(GetOwner().GetWorldPosition(), GetWorldPosition());
		
		if(dist <= cameraShakeRange)
		{
			camShakeStrFrac = (cameraShakeRange - dist) / cameraShakeRange;
			camShakeStr = cameraShakeStrMin + camShakeStrFrac * (cameraShakeStrMax - cameraShakeStrMin);
			
			
			GCameraShake(camShakeStr, true, GetWorldPosition(), impactParams.range * 2);
		}
	}
	
	
	theGame.GetBehTreeReactionManager().CreateReactionEventIfPossible( this, 'BombExplosionAction', 10.0, 50.0f, -1, -1, true); 
	
	
	ProcessEffectPlayFXs(true);

	OnTimeEndedFunction(0);
}


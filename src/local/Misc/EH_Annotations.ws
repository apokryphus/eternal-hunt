@wrapMethod(CBTTaskAttack) function IsAvailable(): bool 
{
	if (GetNPC().HasTag( 'ACS_In_Rage' ) 
	&& !GetNPC().IsRagdolled()
	&& !GetNPC().HasBuff( EET_HeavyKnockdown ) 
	&& !GetNPC().HasBuff( EET_Knockdown ) 
	&& !GetNPC().HasBuff( EET_Ragdoll ) 
	)
	{
		return super.IsAvailable();
	}

    if (ACS_ShouldBlockAttackTaskByDimeritium(attackType, GetNPC())
	|| thePlayer.IsPerformingFinisher()
	|| thePlayer.HasTag('ACS_IsPerformingFinisher')
	|| thePlayer.HasTag('ACS_IsPerformingCombatDismember')
	|| thePlayer.HasTag('ACS_Bruxa_Bite_Process')
	|| thePlayer.HasTag('ACS_Transformation_Bruxa_Cloaked')
	|| thePlayer.HasTag('ACS_Ghost_Stance_Active')
	|| thePlayer.HasTag('ACS_Is_Sneaking')
	|| thePlayer.HasTag('ACS_Neutral_Flip')
	|| thePlayer.HasTag('ACS_In_Heavenly_Strike')
	|| thePlayer.HasTag('ACS_In_Dance_Of_Wrath')
	|| thePlayer.HasTag('ACS_In_Combat_Art')
	|| GetNPC().HasTag('ACS_Final_Fear_Stack')
	|| GetNPC().HasTag('ACS_Bomber')
	|| GetNPC().HasTag('ACS_Ghoul_Firing_Projectile')
	|| GetNPC().HasBuff( EET_HeavyKnockdown ) 
	|| GetNPC().HasBuff( EET_Knockdown ) 
	|| GetNPC().HasBuff( EET_Ragdoll ) 
	|| GetNPC().HasBuff( EET_Stagger )
	|| GetNPC().HasBuff( EET_LongStagger )
	|| GetNPC().HasBuff( EET_Pull )
	|| GetNPC().HasBuff( EET_Hypnotized )
	|| GetNPC().HasBuff( EET_WitchHypnotized )
	|| GetNPC().HasBuff( EET_Blindness )
	|| GetNPC().HasBuff( EET_WraithBlindness )
	|| GetNPC().HasBuff( EET_Frozen )
	|| GetNPC().HasBuff( EET_Paralyzed )
	|| GetNPC().HasBuff( EET_Confusion )
	|| GetNPC().HasBuff( EET_Tangled )
	|| GetNPC().HasBuff( EET_Tornado ) 
	|| GetNPC().HasBuff( EET_Swarm ) 
	|| GetNPC().HasTag('ACS_Currently_In_Grapple_Anim')
	|| GetNPC().HasTag('ACS_Currently_In_Beh_Switch_Anim')
	)
	{
		return false;
	}

    return wrappedMethod();
}


		FactsRemove("ACS_Slot_02_Samum_Equipped");
	}

	if (FactsQuerySum("ACS_Slot_02_Salt_Bomb_Equipped") > 0)
	{
		ACSGetCEntityDestroyAll('ACS_Slot_02_Salt_Bomb_Prop');

		FactsRemove("ACS_Slot_02_Salt_Bomb_Equipped");
